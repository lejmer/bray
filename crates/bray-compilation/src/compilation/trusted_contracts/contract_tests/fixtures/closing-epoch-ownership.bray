trusted internal module bray.runtime.bootstrap.host;

using std.memory;

func probe_closing_epoch_selected(pos mut selected: AttachmentExit)
    requires(trusted attachment_exit_selected(owner = &selected))
{
    _ = complete_attachment_exit(selected);
}

func probe_closing_epoch_moved(pos mut selected: AttachmentExit)
    requires(trusted attachment_exit_selected(owner = &selected))
{
    let moved = selected;
    _ = complete_attachment_exit(moved);
}

func probe_closing_epoch_mutated(pos mut selected: AttachmentExit)
    requires(trusted attachment_exit_selected(owner = &selected))
{
    selected.cleanup = none;
    _ = complete_attachment_exit(selected);
}

func probe_closing_epoch_fabricated_exit(pos mut selected: AttachmentExit)
    requires(trusted attachment_exit_selected(owner = &selected))
{
    let fake: AttachmentExit =
    {
        identity = selected.identity,
        native_thread = selected.native_thread,
        cleanup = none,
    };

    _ = complete_attachment_exit(fake);
}

func probe_closing_epoch_fabricated_retirement(pos mut selected: AttachmentExit)
    requires(trusted attachment_exit_selected(owner = &selected))
{
    let own_lease = trusted host_access();

    let fake: AttachmentRetirement =
    {
        lease = own_lease,
        identity = selected.identity,
        native_thread = selected.native_thread,
        record = std.memory.null<Attachment>(),
        active = std.memory.null<usize>(),
        remaining_active = 0,
    };

    let pointer = completed_attachment_pointer(&fake);
}
