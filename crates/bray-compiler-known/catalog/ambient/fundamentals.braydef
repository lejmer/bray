catalog compiler_known;

scope Ambient at ambient {
    declaration Bool {
        representation ScalarBool;

        surface { struct bool {} }
    }

    declaration Char {
        representation ScalarChar;

        surface { struct char {} }
    }

    declaration I8 {
        representation ScalarI8;

        surface { struct i8 {} }
    }

    declaration I16 {
        representation ScalarI16;

        surface { struct i16 {} }
    }

    declaration I32 {
        representation ScalarI32;

        surface { struct i32 {} }
    }

    declaration I64 {
        representation ScalarI64;

        surface { struct i64 {} }
    }

    declaration I128 {
        representation ScalarI128;

        surface { struct i128 {} }
    }

    declaration U8 {
        representation ScalarU8;

        surface { struct u8 {} }
    }

    declaration U16 {
        representation ScalarU16;

        surface { struct u16 {} }
    }

    declaration U32 {
        representation ScalarU32;

        surface { struct u32 {} }
    }

    declaration U64 {
        representation ScalarU64;

        surface { struct u64 {} }
    }

    declaration U128 {
        representation ScalarU128;

        surface { struct u128 {} }
    }

    declaration Isize {
        representation ScalarIsize;

        surface { struct isize {} }
    }

    declaration Usize {
        representation ScalarUsize;

        surface { struct usize {} }
    }

    declaration R32 {
        representation ScalarR32;

        surface { struct r32 {} }
    }

    declaration R64 {
        representation ScalarR64;

        surface { struct r64 {} }
    }

    declaration C64 {
        representation ScalarC64;

        surface { struct c64 {} }
    }

    declaration C128 {
        representation ScalarC128;

        surface { struct c128 {} }
    }

    declaration Unit {
        representation Unit;

        surface { internal struct Unit {} }
    }

    declaration Never {
        representation Never;

        surface { struct never {} }
    }

    declaration String {
        representation String;

        surface { struct string {} }
    }

    declaration RawPointer {
        representation RawPointer;

        surface { struct RawPointer<T> with(true) {} }
    }

    declaration RawPointerElement {
        owner RawPointer;

        surface { element: T; }
    }

    declaration Heap {
        surface { struct Heap {} }
    }

    declaration Result {
        representation Result;

        surface { union Result<T, E> {} }
    }

    value True {
        spelling true;
        type { bool }
        representation BooleanTrue;
    }

    value False {
        spelling false;
        type { bool }
        representation BooleanFalse;
    }

    value None {
        spelling none;
        type { bool? }
        representation NoneValue;
    }
}
