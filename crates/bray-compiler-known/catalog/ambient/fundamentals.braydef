catalog compiler_known;

scope Ambient at ambient {
    declaration Bool {
        representation ScalarBool;

        surface { struct bool {} }
    }

    declaration Char {
        representation ScalarChar;

        surface { struct char {} }
    }

    declaration I32 {
        representation ScalarI32;

        surface { struct i32 {} }
    }

    declaration R64 {
        representation ScalarR64;

        surface { struct r64 {} }
    }

    declaration C128 {
        representation ScalarC128;

        surface { struct c128 {} }
    }

    declaration Unit {
        representation Unit;

        surface { internal struct Unit {} }
    }

    declaration Never {
        representation Never;

        surface { struct never {} }
    }

    declaration U8 {
        representation ScalarU8;

        surface { struct u8 {} }
    }

    declaration Usize {
        representation ScalarUsize;

        surface { struct usize {} }
    }

    declaration String {
        representation String;

        surface { struct string {} }
    }

    declaration RawPointer {
        representation RawPointer;

        surface { struct RawPointer<T> with(true) {} }
    }

    declaration RawPointerElement {
        owner RawPointer;

        surface { element: T; }
    }

    declaration Heap {
        surface { struct Heap {} }
    }

    declaration Result {
        representation Result;

        surface { union Result<T, E> {} }
    }

    value True {
        spelling true;
        type { bool }
        representation BooleanTrue;
    }

    value False {
        spelling false;
        type { bool }
        representation BooleanFalse;
    }

    value None {
        spelling none;
        type { bool? }
        representation NoneValue;
    }
}
