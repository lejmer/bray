catalog compiler_known revision 1;

scope CoreMemory at core.memory {
    declaration AddressOf {
        availability RawMemory;
        implementation AddressOf;

        surface { func address_of<T>(pos value: &T) -> RawPointer<T>; }
    }

    declaration AddressOfMut {
        availability RawMemory;
        implementation AddressOfMut;

        surface { func address_of_mut<T>(pos value: &mut T) -> RawPointer<T>; }
    }

    declaration RawPointerNull {
        availability RawMemory;
        implementation RawPointerNull;

        surface { func null<T>() -> RawPointer<T>; }
    }

    declaration RawPointerIsNull {
        availability RawMemory;
        implementation RawPointerIsNull;

        surface { func is_null<T>(pos pointer: RawPointer<T>) -> bool; }
    }

    declaration RawPointerOffset {
        availability RawMemory;
        implementation RawPointerOffset;

        surface {
            func offset<T>(
                pos pointer: RawPointer<T>,
                elements: isize,
            ) -> RawPointer<T>;
        }
    }

    declaration RawPointerByteOffset {
        availability RawMemory;
        implementation RawPointerByteOffset;

        surface {
            func byte_offset<T>(
                pos pointer: RawPointer<T>,
                bytes: isize,
            ) -> RawPointer<T>;
        }
    }

    declaration RawPointerReinterpret {
        availability RawMemory;
        implementation RawPointerReinterpret;

        surface {
            trusted func reinterpret<Target, Source>(
                pos pointer: RawPointer<Source>,
            ) -> RawPointer<Target>
                uses(layout_reinterpret);
        }
    }

    declaration CallableAddressValid {
        availability RawMemory;

        surface {
            trusted predicate callable_address_valid<F>(pointer: RawPointer<F>);
        }
    }

    declaration CallableFromPointer {
        availability RawMemory;
        implementation CallableFromPointer;

        surface {
            trusted func callable_from_pointer<F>(pos pointer: RawPointer<F>) -> F
                requires(
                    trusted core.memory.callable_address_valid<F>(pointer = pointer),
                )
                uses(layout_reinterpret);
        }
    }

    declaration PointerFromCallable {
        availability RawMemory;
        implementation PointerFromCallable;

        surface {
            trusted func pointer_from_callable<F>(pos value: F) -> RawPointer<F>
                uses(layout_reinterpret);
        }
    }

    declaration RawPointerRead {
        availability RawMemory;
        implementation RawPointerRead;

        surface {
            trusted func read<T>(pos pointer: RawPointer<T>) -> T
                requires(
                    trusted core.memory.valid_read(pointer = pointer, count = 1),
                    trusted core.memory.aligned_for<T>(pointer = pointer),
                    trusted core.memory.initialized_as<T>(pointer = pointer),
                )
                uses(raw_memory);
        }
    }

    declaration RawPointerWrite {
        availability RawMemory;
        implementation RawPointerWrite;

        surface {
            trusted func write<T>(
                pos pointer: RawPointer<T>,
                pos value: T,
            ) -> unit
                requires(
                    trusted core.memory.valid_write(pointer = pointer, count = 1),
                    trusted core.memory.aligned_for<T>(pointer = pointer),
                )
                ensures(
                    trusted core.memory.initialized_as<T>(pointer = pointer),
                )
                uses(raw_memory, unchecked_init);
        }
    }

    declaration MemoryCopy {
        availability RawMemory;
        implementation MemoryCopy;

        surface {
            trusted func copy<T>(
                pos source: RawPointer<T>,
                pos destination: RawPointer<T>,
                count: usize,
            ) -> unit
                requires(
                    trusted core.memory.valid_read(pointer = source, count = count),
                    trusted core.memory.valid_write(pointer = destination, count = count),
                    trusted core.memory.initialized_range_as<T>(
                        pointer = source,
                        count = count,
                    ),
                    trusted core.memory.non_overlapping(
                        left = source,
                        left_count = count,
                        right = destination,
                        right_count = count,
                    ),
                )
                ensures(
                    trusted core.memory.initialized_range_as<T>(
                        pointer = destination,
                        count = count,
                    ),
                )
                uses(raw_memory, unchecked_init);
        }
    }

    declaration MemoryCopyOverlapping {
        availability RawMemory;
        implementation MemoryCopyOverlapping;

        surface {
            trusted func copy_overlapping<T>(
                pos source: RawPointer<T>,
                pos destination: RawPointer<T>,
                count: usize,
            ) -> unit
                requires(
                    trusted core.memory.valid_read(pointer = source, count = count),
                    trusted core.memory.valid_write(pointer = destination, count = count),
                    trusted core.memory.initialized_range_as<T>(
                        pointer = source,
                        count = count,
                    ),
                )
                ensures(
                    trusted core.memory.initialized_range_as<T>(
                        pointer = destination,
                        count = count,
                    ),
                )
                uses(raw_memory, unchecked_init);
        }
    }

    declaration UninitNew {
        availability RawMemory;
        implementation UninitNew;

        surface { const func uninit<T>() -> Uninit<T>; }
    }

    declaration UninitPointer {
        availability RawMemory;
        implementation UninitPointer;

        surface { func uninit_pointer<T>(pos storage: &Uninit<T>) -> RawPointer<T> executes(pure, total); }
    }

    declaration UninitPointerMut {
        availability RawMemory;
        implementation UninitPointerMut;

        surface { func uninit_pointer_mut<T>(pos storage: &mut Uninit<T>) -> RawPointer<T> executes(pure, total); }
    }

    declaration UninitWrite {
        availability RawMemory;
        implementation UninitWrite;

        surface {
            func uninit_write<T>(
                pos storage: &mut Uninit<T>,
                pos value: T,
            ) -> &mut T
                ensures(trusted core.memory.uninit_initialized<T>(storage = storage));
        }
    }

    declaration UninitAssumeInitialized {
        availability RawMemory;
        implementation UninitAssumeInitialized;

        surface {
            trusted func assume_initialized<T>(pos mut storage: Uninit<T>) -> T
                requires(trusted core.memory.uninit_initialized<T>(storage = &mut storage))
                uses(unchecked_init);
        }
    }

    declaration UninitMove {
        availability RawMemory;
        implementation UninitMove;

        surface {
            trusted func move_initialized<T>(pos storage: &mut Uninit<T>) -> T
                requires(trusted core.memory.uninit_initialized<T>(storage = storage))
                uses(unchecked_init);
        }
    }

    declaration BorrowFrom {
        availability RawMemory;
        implementation BorrowFrom;

        surface {
            trusted func borrow_from<T, Owner>(
                pos owner: &Owner,
                pos pointer: RawPointer<T>,
            ) -> &T
                requires(
                    trusted core.memory.valid_read(pointer = pointer, count = 1),
                    trusted core.memory.aligned_for<T>(pointer = pointer),
                    trusted core.memory.initialized_as<T>(pointer = pointer),
                    trusted core.memory.shared_alias_valid(pointer = pointer),
                    trusted core.memory.epoch_current(pointer = pointer),
                    trusted core.memory.synchronized_access(pointer = pointer),
                    trusted core.memory.movement_stable(pointer = pointer),
                    trusted core.memory.finalization_pending(pointer = pointer),
                )
                executes(pure, total)
                uses(raw_memory, unchecked_alias);
        }
    }

    declaration BorrowMutFrom {
        availability RawMemory;
        implementation BorrowMutFrom;

        surface {
            trusted func borrow_mut_from<T, Capability>(
                pos capability: &mut Capability,
                pos pointer: RawPointer<T>,
            ) -> &mut T
                requires(
                    trusted core.memory.valid_write(pointer = pointer, count = 1),
                    trusted core.memory.aligned_for<T>(pointer = pointer),
                    trusted core.memory.initialized_as<T>(pointer = pointer),
                    trusted core.memory.exclusive_alias_valid(pointer = pointer),
                    trusted core.memory.epoch_current(pointer = pointer),
                    trusted core.memory.synchronized_access(pointer = pointer),
                    trusted core.memory.movement_stable(pointer = pointer),
                    trusted core.memory.finalization_pending(pointer = pointer),
                )
                executes(pure, total)
                uses(raw_memory, unchecked_alias);
        }
    }

    declaration Allocate {
        availability Allocation;
        implementation RawAllocate;

        surface {
            trusted func allocate(bytes: usize, align: usize) -> RawPointer<u8>
                ensures(
                    trusted core.memory.owned_allocation(
                        pointer = result,
                        bytes = bytes,
                        align = align,
                    ),
                    trusted core.memory.valid_write(pointer = result, count = bytes),
                )
                uses(manual_alloc);
        }
    }

    declaration Deallocate {
        availability Allocation;
        implementation RawDeallocate;

        surface {
            trusted func deallocate(
                pos pointer: RawPointer<u8>,
                bytes: usize,
                align: usize,
            ) -> unit
                requires(
                    trusted core.memory.owned_allocation(
                        pointer = pointer,
                        bytes = bytes,
                        align = align,
                    ),
                )
                uses(manual_alloc);
        }
    }

