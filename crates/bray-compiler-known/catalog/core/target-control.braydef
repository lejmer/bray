catalog compiler_known revision 1;

scope CoreTargetControl at core.target {
    declaration DeviceValidRead {
        availability AddressSpaces;

        surface {
            trusted predicate device_valid_read<T>(
                pointer: DevicePointer<T>,
                count: usize,
            );
        }
    }

    declaration DeviceValidWrite {
        availability AddressSpaces;

        surface {
            trusted predicate device_valid_write<T>(
                pointer: DevicePointer<T>,
                count: usize,
