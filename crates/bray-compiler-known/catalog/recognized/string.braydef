catalog recognized_standard_library;

scope StandardString at std.string {
    declaration StandardUtf8Error {
        identity name Utf8Error;

        surface { union Utf8Error {} }
    }

    declaration StandardUtf8ErrorVariant0InvalidEncoding {
        owner StandardUtf8Error;
        identity ordinal 0;

        surface { InvalidEncoding; }
    }

    declaration StandardStringScalarCount {
        identity name scalar_count;
        implementation StringScalarCount;

        surface { extern func scalar_count(pos value: &string) -> usize; }
    }

    declaration StandardStringIsEmpty {
        identity name is_empty;
        implementation StringIsEmpty;

        surface { extern func is_empty(pos value: &string) -> bool; }
    }

    declaration StandardStringEquals {
        identity name equals;
        implementation StringEquals;

        surface {
            extern func equals(pos left: &string, pos right: &string) -> bool;
        }
    }

    declaration StandardStringScalarAt {
        identity name scalar_at;
        implementation StringScalarAt;

        surface {
            extern func scalar_at(pos value: &string, index: usize) -> char?;
        }
    }

    declaration StandardStringScalarSlice {
        identity name scalar_slice;
        implementation StringScalarSlice;

        surface {
            extern func scalar_slice(
                pos value: &string,
                start: usize,
                end: usize,
            ) -> string;
        }
    }

    declaration StandardStringUtf8 {
        identity name utf8;
        implementation StringUtf8;

        surface { extern func utf8(pos value: &string) -> &[u8]; }
    }

    declaration StandardStringFromUtf8 {
        identity name from_utf8;
        implementation StringFromUtf8;

        surface {
            extern func from_utf8(pos bytes: &[u8]) -> Result<string, Utf8Error>;
        }
    }

    declaration StandardScalarCursor {
        identity name ScalarCursor;

        surface { struct ScalarCursor {} }
    }

    declaration StandardStringScalars {
        identity name scalars;

        surface { func scalars(pos value: &string) -> ScalarCursor; }
    }

    declaration StandardScalarCursorIterator {
        identity name ScalarCursorIterator;

        surface { impl ScalarCursorIterator = ScalarCursor(Iterator) {} }
    }

    declaration StandardScalarCursorIteratorNext {
        owner StandardScalarCursorIterator;
        identity name next;

        surface { mut func next() -> char? {} }
    }
}
