catalog recognized_standard_library revision 1;

scope StandardRun at std.run {
    declaration StandardRunCancellationObservation {
        identity name observe_cancellation;
        implementation CurrentRunCancellationObservation;

        surface { internal func observe_cancellation() -> bool; }
    }

    declaration StandardRunCancellationPropagation {
        identity name propagate_cancellation;
        implementation CurrentRunCancellationPropagation;

        surface { internal func propagate_cancellation(); }
    }

}

scope StandardTask at std.task {
    declaration StandardTaskYield {
        identity name yield_current_task;
        implementation TaskYield;

        surface { internal func yield_current_task(); }
    }
}
