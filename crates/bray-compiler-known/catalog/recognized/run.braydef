catalog recognized_standard_library;

scope StandardRun at std.run {
    declaration StandardRunCancellationRequestedSupport {
        identity name support_cancellation_requested;
        implementation CurrentRunCancellationObservation;

        surface { internal func support_cancellation_requested() -> bool; }
    }

    declaration StandardRunEnterCancellationSupport {
        identity name support_enter_cancellation;
        implementation CurrentRunCancellationEntry;

        surface { internal func support_enter_cancellation(); }
    }

}

scope StandardTask at std.task {
    declaration StandardTaskYieldSupport {
        identity name support_yield;
        implementation TaskYield;

        surface { internal func support_yield(); }
    }
}
