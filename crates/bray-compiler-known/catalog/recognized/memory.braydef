    declaration StandardMemoryAllocateBuffer {
        identity name allocate_buffer;
        availability Allocation;
        implementation RawBufferAllocate;

        surface {
            trusted internal func allocate_buffer<T>(capacity: usize, bytes: usize, align: usize) -> RawBuffer<T>
                requires(bytes == stride_of<T>() * capacity, align == align_of<T>())
                ensures(result.capacity == capacity, result.initialized == 0)
                uses(manual_alloc);
        }
    }

    declaration StandardMemoryCapacity {
        identity name capacity;
        availability Allocation;
        implementation RawBufferCapacity;

        surface {
            func capacity<T>(pos buffer: &RawBuffer<T>) -> usize
                ensures(result == buffer.capacity);
        }
    }

    declaration StandardMemoryInitializedCount {
        identity name initialized_count;
        availability Allocation;
        implementation RawBufferInitializedCount;

        surface {
            func initialized_count<T>(pos buffer: &RawBuffer<T>) -> usize
                ensures(
                    result == buffer.initialized,
                    result <= buffer.capacity,
                    trusted core.memory.initialized_range_as<T>(pointer = buffer.pointer, count = result),
                );
        }
    }

