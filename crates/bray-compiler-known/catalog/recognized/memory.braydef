    declaration StandardMemorySparePointer {
        identity name spare_pointer;
        availability Allocation;
        implementation RawBufferSparePointer;

        surface {
            trusted func spare_pointer<T>(
                pos buffer: &mut RawBuffer<T>,
            ) -> DataPointer<T>
                ensures(
                    trusted core.memory.valid_write(
                        pointer = result,
                        count = buffer.capacity - buffer.initialized,
                    ),
                    trusted core.memory.aligned_for<T>(pointer = result),
                )
                uses(raw_memory);
        }
    }

    declaration StandardMemorySetInitializedCount {
        identity name set_initialized_count;
        availability Allocation;
        implementation RawBufferSetInitializedCount;

        surface {
            trusted func set_initialized_count<T>(
                pos buffer: &mut RawBuffer<T>,
                count: usize,
            ) -> unit
                requires(
                    count <= buffer.capacity,
                    trusted core.memory.initialized_range_as<T>(
                        pointer = buffer.pointer,
                        count = count,
                    ),
                )
                ensures(
                    buffer.initialized == count,
                )
                uses(unchecked_init);
        }
    }

    declaration StandardMemoryByteBufferFill {
        identity name byte_buffer_fill;
        availability Allocation;
        implementation ByteBufferFill;

        surface {
            trusted internal func byte_buffer_fill(
                pos destination: DataPointer<u8>,
                value: u8,
                count: usize,
            ) -> unit
                requires(trusted core.memory.valid_write<u8>(pointer = destination, count = count))
                ensures(trusted core.memory.initialized_range_as<u8>(pointer = destination, count = count))
                uses(raw_memory, unchecked_init);
        }
    }

    declaration StandardMemoryRawBufferRelease {
        identity name raw_buffer_release;
        availability Allocation;
        implementation RawBufferRelease;

        surface {
            trusted internal func raw_buffer_release<T>(
                pos buffer: &mut RawBuffer<T>,
            ) -> unit
                uses(manual_alloc);
        }
    }

    declaration StandardMemoryRawBufferReplace {
        identity name raw_buffer_replace;
        availability Allocation;
        implementation RawBufferReplace;

        surface {
            trusted internal func raw_buffer_replace<T>(
                pos destination: &mut RawBuffer<T>,
                pos source: &mut RawBuffer<T>,
            ) -> unit
                uses(manual_alloc);
        }
    }

    declaration StandardMemoryRawBufferRelocate {
        identity name raw_buffer_relocate;
        availability Allocation;
        implementation RawBufferRelocate;

        surface {
            trusted internal func raw_buffer_relocate<T>(
                pos source: &mut RawBuffer<T>,
                pos destination: &mut RawBuffer<T>,
            ) -> unit
                requires(
                    destination.initialized == 0,
                    source.initialized <= destination.capacity,
                    trusted core.memory.non_overlapping<T>(
                        left = source.pointer,
                        left_count = source.initialized,
                        right = destination.pointer,
                        right_count = source.initialized,
                    ),
                )
                uses(raw_memory, unchecked_init);
        }
    }

    declaration StandardMemoryByteBufferRead {
        identity name byte_buffer_read;
        availability Allocation;
        implementation ByteBufferRead;

        surface {
            trusted internal func byte_buffer_read(
                pos pointer: DataPointer<u8>,
                index: usize,
            ) -> u8
                requires(
                    index != std.numeric.USIZE_MAX &&
                        (trusted core.memory.valid_read<u8>(pointer = pointer, count = index + 1)) &&
                        (trusted core.memory.initialized_range_as<u8>(pointer = pointer, count = index + 1)),
                )
                uses(raw_memory);
        }
    }

