module composition.cleanup;

static COUNT: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

static DEFAULTS: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

func default_observation() -> usize
{
    let previous = core.atomic.load<usize, 1>(&DEFAULTS);

    core.atomic.store<usize, 4>(&DEFAULTS, previous + 1);
    return previous;
}

struct Guard
{
    id: usize;
    observation: usize = default_observation();

    finalize()
        executes(pure, total) {}

    destruct()
    {
        let previous = core.atomic.load<usize, 1>(&COUNT);

        core.atomic.store<usize, 4>(&COUNT, previous * 10 + self.id);
    }
}

@test
func run()
{
    {
        let mut guard: box Guard = box(
            Guard
            {
                id = 1
            }
        );

        assert(guard_id(&guard) == 1);

        guard = box(
            Guard
            {
                id = 2
            }
        );

        assert(guard_id(&guard) == 2);
        assert(core.atomic.load<usize, 1>(&COUNT) == 1);
    };

    assert(core.atomic.load<usize, 1>(&COUNT) == 12);
    assert(core.atomic.load<usize, 1>(&DEFAULTS) == 2);
    nested_cleanup();
    nested_replacement();
    construction_default_cleanup();
    parameter_default_cleanup();
    evaluated_call_input_cleanup();
    async_parameter_default_cleanup();
    destructor_receiver_transfer();
}

struct FailingGuard
{
    id: usize;

    destruct()
    {
        let previous = core.atomic.load<usize, 1>(&COUNT);

        core.atomic.store<usize, 4>(&COUNT, previous * 10 + self.id);

        if self.id == 2
        {
            panic("nested cleanup");
        }
    }
}

struct Bundle
{
    guards: [[FailingGuard; 2]; 2];

    finalize()
        executes(pure, total) {}
}

func make_guard(pos id: usize) -> FailingGuard
{
    return FailingGuard
    {
        id = id
    };
}

func pending_result() -> usize
{
    let bundle = Bundle
    {
        guards = [[make_guard(1), make_guard(2)], [make_guard(3), make_guard(4)]]
    };

    return 99;
}

func nested_cleanup()
{
    core.atomic.store<usize, 4>(&COUNT, 0);

    let result = catch
    {
        pending_result();
        yield unit;
    };

    assert(result matches Error(_));
    assert(core.atomic.load<usize, 1>(&COUNT) == 4321);
}

func nested_replacement()
{
    core.atomic.store<usize, 4>(&COUNT, 0);

    {
        let mut guards = box(
            Bundle
            {
                guards = [[make_guard(1), make_guard(2)], [make_guard(3), make_guard(4)]]
            }
        );

        let result = catch
        {
            guards = box(
                Bundle
                {
                    guards = [[make_guard(5), make_guard(6)], [make_guard(7), make_guard(8)]]
                }
            );

            yield unit;
        };

        assert(result matches Error(_));
        assert(core.atomic.load<usize, 1>(&COUNT) == 4321);
    };

    assert(core.atomic.load<usize, 1>(&COUNT) == 43218765);
}

func guard_id(pos value: &box Guard) -> usize
    executes(pure, total)
{
    return match value
    {
        case box(guard) { yield guard.id; }
    };
}

struct PendingConstruction
{
    guard: Guard;
    value: usize = rejected_default();
}

func rejected_default() -> usize
{
    panic("construction default");
}

func construction_default_cleanup()
{
    core.atomic.store<usize, 4>(&COUNT, 0);

    let result = catch
    {
        let value = PendingConstruction
        {
            guard = Guard
            {
                id = 7
            }
        };

        yield unit;
    };

    assert(result matches Error(_));
    assert(core.atomic.load<usize, 1>(&COUNT) == 7);
}

struct Forwarded
{
    mut again: bool;
    guard: Guard;

    destruct()
    {
        let previous = core.atomic.load<usize, 1>(&COUNT);

        core.atomic.store<usize, 4>(&COUNT, previous + 1);

        if self.again
        {
            self.again = false;
            take_forwarded(self);

            self = Forwarded
            {
                again = false,
                guard = Guard
                {
                    id = 4
                }
            };

            take_forwarded(self);
        }
    }
}

func take_forwarded(pos value: Forwarded) {}

func destructor_receiver_transfer()
{
    core.atomic.store<usize, 4>(&COUNT, 0);

    {
        let value = Forwarded
        {
            again = true,
            guard = Guard
            {
                id = 9
            }
        };
    };

    assert(core.atomic.load<usize, 1>(&COUNT) == 304);
}

func take_with_default(pos guard: Guard, value: usize = rejected_default()) {}

func parameter_default_cleanup()
{
    core.atomic.store<usize, 4>(&COUNT, 0);

    let result = catch
    {
        take_with_default(
            Guard
            {
                id = 6
            }
        );

        yield unit;
    };

    assert(result matches Error(_));
    assert(core.atomic.load<usize, 1>(&COUNT) == 6);
}

func take_explicit_inputs(pos guard: Guard, pos value: usize) {}

func take_default_inputs(
    first: Guard = (Guard
    {
        id = 2
    }
    ),
    second: Guard = (Guard
    {
        id = 3
    }
    ),
    value: usize = rejected_default(),
)
{
}

func evaluated_call_input_cleanup()
{
    core.atomic.store<usize, 4>(&COUNT, 0);

    let explicit_result = catch
    {
        take_explicit_inputs(
            Guard
            {
                id = 8
            },
            rejected_default()
        );

        yield unit;
    };

    assert(explicit_result matches Error(_));
    assert(core.atomic.load<usize, 1>(&COUNT) == 8);

    core.atomic.store<usize, 4>(&COUNT, 0);

    let default_result = catch
    {
        take_default_inputs();
        yield unit;
    };

    assert(default_result matches Error(_));
    assert(core.atomic.load<usize, 1>(&COUNT) == 32);
}

async func take_async_default(pos guard: Guard, value: usize = rejected_default()) {}

func async_parameter_default_cleanup()
{
    core.atomic.store<usize, 4>(&COUNT, 0);

    let result = catch
    {
        let pending = take_async_default(
            Guard
            {
                id = 4
            }
        );

        yield unit;
    };

    assert(result matches Error(_));
    assert(core.atomic.load<usize, 1>(&COUNT) == 4);
}
