module composition.synchronous;

using composition.api;

@test
func run()
{
    assert(composition.api.answer() == 42);
    runtime_default_storage();
    assert(identity(true));
    assert(conditional_completion());
    replace_owner();
    assert(failure() matches Error(false));
    assert(branch_result(true));
    assert(!branch_result(false));
    assert(match_result(false));
    assert(!caught_cleanup_result());
    assert(transferred_cleanup_result());
    assert(nested_cleanup_result());
}

struct PanickingGuard
{
    destruct()
    {
        panic("cleanup");
    }
}

func caught_cleanup_result() -> bool
{
    let result = catch
    {
        let guard = PanickingGuard
        {
        };

        return true;
    };

    return false;
}

func transferred_cleanup_result() -> bool
{
    let mut transferred = false;

    let result = catch
    {
        let guard = transfer_guard(
            transfer_packet(
                GuardPacket
                {
                    guard = PanickingGuard
                    {
                    },
                    flag = true,
                }
            )
        );

        transferred = true;
    };

    return transferred;
}

func transfer_guard(pos value: PanickingGuard) -> PanickingGuard
{
    let result = catch
    {
        let guard = value;

        return guard;
    };
}

struct GuardPacket
{
    guard: PanickingGuard;
    flag: bool;
}

func transfer_packet(pos value: GuardPacket) -> PanickingGuard
{
    let result = catch
    {
        let packet = value;

        let guard = if true
        {
            yield packet.guard;
        }
        else
        {
            yield PanickingGuard
            {
            };
        };

        return guard;
    };
}

func branch_result(pos value: bool) -> bool
{
    if value
    {
        return true;
    }
    else
    {
        return false;
    }
}

func match_result(pos value: bool) -> bool
{
    match value
    {
        case true { return false; }

        case false
        {
            return true;
        }
    };
}

func identity(pos value: bool) -> bool
    executes(pure, total)
{
    return value;
}

func failure() -> Result<bool, bool>
    executes(pure, total)
{
    return Error(false);
}

struct TotalOwner
{
    destruct()
        executes(total) {}
}

func replace_owner()
    executes(total)
{
    let mut owner = TotalOwner
    {
    };

    owner = TotalOwner
    {
    };
}

func nested_cleanup_result() -> bool
{
    let mut transferred = false;

    let result = catch
    {
        let guards = nested_transfer(
            GuardPacket
            {
                guard = PanickingGuard
                {
                },
                flag = true,
            }
        );

        transferred = guards matches Ok(_);
    };

    return transferred;
}

func nested_transfer(pos value: GuardPacket) -> Result<(PanickingGuard, PanickingGuard), PanicReport>
{
    let outer = catch
    {
        let packet = value;

        let inner = catch
        {
            let first =
            {
                let source = GuardPacket
                {
                    guard = PanickingGuard
                    {
                    },
                    flag = false,
                };

                let taken = if true
                {
                    yield source.guard;
                }
                else
                {
                    yield PanickingGuard
                    {
                    };
                };

                yield taken;
            };

            yield(first, packet.guard);
        };

        return inner;
    };
}

func conditional_identity(pos value: bool) -> bool
    when(value)
    {
        executes(pure, total)
        ensures(result)
    }
{
    if value
    {
        return value;
    }

    panic("outside promised domain");
}

func conditional_completion() -> bool
    executes(pure, total)
    when(true)
    {
        ensures(result)
    }
{
    let original = conditional_identity(true);
    let moved = original;

    return moved;
}
