module api;

public struct DefaultFlag
{
    mut value: bool;
}

public struct DefaultFlagHolder
{
    flag: DefaultFlag;
}

@copy
public struct DefaultFlagReference
{
    holder: &DefaultFlagHolder;
}

impl DefaultFlagReference
{
    public consume func selected(flag: &DefaultFlag = &self.holder.flag) -> &DefaultFlag
    {
        return flag;
    }
}

public func projected_default(
    pos reference: DefaultFlagReference,
    flag: &DefaultFlag = &reference.holder.flag,
) -> &DefaultFlag
{
    return flag;
}

public func read_default_storage(
    pos first: DefaultFlag,
    borrowed: &DefaultFlag = &first,
    snapshot: bool = borrowed.value,
) -> bool
{
    return borrowed.value == first.value && snapshot == first.value;
}

func set_default_flag(pos flag: &mut DefaultFlag) -> bool
{
    flag.value = true;

    return true;
}

public func mutate_default_storage(
    pos mut first: DefaultFlag,
    borrowed: &mut DefaultFlag = &mut first,
    changed: bool = set_default_flag(borrowed),
) -> bool
{
    return first.value && changed;
}

public func forward_default<T>(pos value: &T, selected: &T = value) -> &T
{
    return selected;
}

public func indexed_default(pos flags: &[DefaultFlag; 1], selected: &DefaultFlag = &flags[0]) -> &DefaultFlag
{
    return selected;
}

public func sliced_default(pos flags: &[DefaultFlag; 1], selected: &[DefaultFlag] = &flags[..]) -> &[DefaultFlag]
{
    return selected;
}

public struct IndexedFlags
{
    mut flag: DefaultFlag;
}

impl IndexedFlags(ElementIndex<i32>)
{
    type Output = DefaultFlag;

    func index(pos selector: &i32) -> &DefaultFlag
    {
        return &self.flag;
    }
}

impl IndexedFlags(MutableElementIndex<i32>)
{
    type Output = DefaultFlag;

    mut func index(pos selector: &i32) -> &mut DefaultFlag
    {
        return &mut self.flag;
    }
}

impl IndexedFlags(SliceIndex<i32>)
{
    type Output = DefaultFlag;

    func slice(pos start: i32?, pos end: i32?) -> &DefaultFlag
    {
        return &self.flag;
    }
}

public func custom_indexed_default(
    pos flags: &IndexedFlags,
    pos selector: i32,
    selected: &DefaultFlag = &flags[selector]
) -> &DefaultFlag
{
    return selected;
}

public func custom_sliced_default(
    pos flags: &IndexedFlags,
    pos start: i32,
    selected: &DefaultFlag = &flags[start..]
) -> &DefaultFlag
{
    return selected;
}

public func custom_mutable_default(
    pos flags: &mut IndexedFlags,
    pos selector: i32,
    selected: &mut DefaultFlag = &mut flags[selector]
) -> &mut DefaultFlag
{
    return selected;
}

public func bounded_slice_default(
    pos flags: &[DefaultFlag; 2],
    selected: &[DefaultFlag] = &flags[1..2]
) -> &[DefaultFlag]
{
    return selected;
}
