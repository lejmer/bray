    { "name": "closed hook inventory", "test": "memory_operation_inventory_partitions_the_closed_hook_set" },
    { "name": "checker classification", "test": "hooks_classify_without_source_name_matching" },
    { "name": "lowering coverage", "test": "lowering_replaces_every_checked_memory_family_with_explicit_mir" },
    { "name": "code generation coverage", "test": "every_memory_operation_family_generates_verified_llvm" },
    { "name": "unavailable target rejection", "test": "unavailable_memory_operations_publish_structured_target_diagnostics" },
    { "name": "atomic ordering rejection", "test": "invalid_atomic_orders_publish_structured_diagnostics_before_lowering" },
    { "name": "atomic representation rejection", "test": "unavailable_atomic_representations_fail_before_lowering" },
    { "name": "invalid obligation rejection", "test": "invalid_memory_obligations_publish_structured_semantic_diagnostics" },
    { "name": "same-name isolation", "test": "same_named_source_callables_are_not_memory_operations" }
  ]
}
