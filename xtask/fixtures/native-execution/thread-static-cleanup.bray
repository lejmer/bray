module thread_static_cleanup_execution;

internal struct Provider
{
    mut value: i32;

    finalize()
    {
        self.value = 0;
    }
}

internal struct Consumer
{
    provider: &Provider;

    destruct()
    {
        assert(self.provider.value == 17);
    }
}

@thread_local internal static PROVIDER: Provider =
{
    value = 17
};

@thread_local internal static CONSUMER: Consumer =
{
    provider = &PROVIDER
};

func main() -> i32
{
    // Access the provider first so dependency order must override registration order.
    if PROVIDER.value == 17 && CONSUMER.provider.value == 17
    {
        return 42;
    }

    return 1;
}
