@link(name = "bray_allocation_probe")
trusted module scoped_cleanup;

using std.memory;
using std.task;
using std.testing;

@abi(c)
@symbol(name = "bray_allocation_probe_begin")
extern trusted func deny_allocation() -> u32
    uses(foreign_call);

@abi(c)
@symbol(name = "bray_allocation_probe_end")
extern trusted func restore_allocation(pos before: u32) -> u32
    uses(foreign_call);

internal static ENTRIES: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

internal static EXITS: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

internal static ERRORS: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

internal static CAPTURES: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

internal static FINALIZERS: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

internal static INVALID_ORDER: core.atomic.Atomic<bool> = core.atomic.initialize<bool>(false);

internal static ENTERED_INACTIVE: core.atomic.Atomic<bool> = core.atomic.initialize<bool>(false);

internal static ALLOCATIONS: core.atomic.Atomic<u32> = core.atomic.initialize<u32>(0);

struct Capture
{
    destruct()
    {
        core.atomic.fetch_add<usize, 0>(&CAPTURES, value = 1);
    }
}

async func inactive(pos capture: Capture)
{
    core.atomic.store<bool, 4>(&ENTERED_INACTIVE, true);
    panic("scoped error quiescence entered an inactive body");
}

@layout(stable, align = 2048)
struct Failure
{
    marker: usize;
    pending: Future<unit>;

    finalize()
    {
        core.atomic.fetch_add<usize, 0>(&FINALIZERS, value = 1);
    }

    destruct()
    {
        assert(self.marker == 619, "scoped error payload was not retained");

        core.atomic.fetch_add<usize, 0>(&ERRORS, value = 1);
    }
}

struct BodyLocal
{
    previous_exits: usize;

    destruct()
    {
        if core.atomic.load<usize, 1>(&EXITS) != self.previous_exits + 1
        {
            core.atomic.store<bool, 4>(&INVALID_ORDER, true);
        }
    }
}

struct State
{
    fail_entry: bool;
    fail_exit: bool;
    mut panic_exit: bool = false;
    mut pending: Future<unit>?;
}

struct Capability
{
    state: &mut State;
}

func prepare(pos fail_entry: bool, pos fail_exit: bool) -> State
{
    return State
    {
        fail_entry = fail_entry,
        fail_exit = fail_exit,
        pending = inactive(
            Capture
            {
            }
        )
    };
}

func failure(pos state: &mut State) -> Failure
{
    let stored = std.memory.replace_value(&mut state.pending, none);

    match consume stored
    {
        case ?pending
        {
            return Failure
            {
                marker = 619,
                pending = pending
            };
        }
        case none { panic("scoped state was consumed twice"); }
    }
}

func begin(pos state: &mut State) -> Result<Capability, Failure>
{
    core.atomic.fetch_add<usize, 0>(&ENTRIES, value = 1);

    if state.fail_entry
    {
        return Error(failure(state));
    }

    return Ok(
        Capability
        {
            state = state
        }
    );
}

func finish(pos capability: Capability) -> Result<unit, Failure>
{
    core.atomic.fetch_add<usize, 0>(&EXITS, value = 1);

    if capability.state.panic_exit
    {
        panic("");
    }

    if capability.state.fail_exit
    {
        return Error(failure(capability.state));
    }

    return Ok(unit);
}

struct Scope
{
    mut state: State;

    mut enter() -> Result<Capability, Failure>
    {
        return begin(&mut self.state);
    }

    exit(pos capability: Capability) -> Result<unit, Failure>
    {
        return finish(capability);
    }
}

struct AsyncScope
{
    mut state: State;

    async mut enter() -> Result<Capability, Failure>
    {
        await std.task.yield_now();

        return begin(&mut self.state);
    }

    async exit(pos capability: Capability) -> Result<unit, Failure>
    {
        await std.task.yield_now();

        return finish(capability);
    }
}

async func normal(pos asynchronous: bool, pos fail_entry: bool, pos fail_exit: bool)
{
    let state = prepare(fail_entry, fail_exit);
    let mut body = false;

    let result: Result<i32, Failure> = if asynchronous
    {
        let mut scope = AsyncScope
        {
            state = state
        };

        yield with capability = scope
        {
            let local = BodyLocal
            {
                previous_exits = core.atomic.load<usize, 1>(&EXITS)
            };

            body = true;
            yield 42;
        };
    }
    else
    {
        let mut scope = Scope
        {
            state = state
        };

        yield with capability = scope
        {
            let local = BodyLocal
            {
                previous_exits = core.atomic.load<usize, 1>(&EXITS)
            };

            body = true;
            yield 42;
        };
    };

    assert(body == !fail_entry, "failed scoped entry ran the body");

    match consume result
    {
        case Ok(value) { assert(!fail_entry && !fail_exit && value == 42); }
        case Error(error) { assert(fail_entry || fail_exit); }
    }
}

trusted async func transfer_sync(pos mode: usize) -> Result<i32, Failure>
    uses(foreign_call)
{
    let mut iteration: usize = 0;
    let mut value: i32 = 41;

    while iteration < 1
    {
        iteration += 1;

        let mut scope = Scope
        {
            state = prepare(false, true)
        };

        core.atomic.store<u32, 4>(&ALLOCATIONS, trusted deny_allocation());

        let _ = with capability = scope
        {
            let local = BodyLocal
            {
                previous_exits = core.atomic.load<usize, 1>(&EXITS)
            };

            if mode == 0
            {
                return Ok(73);
            }

            if mode == 1
            {
                value = 29;
                break;
            }

            continue;
        };
    }

    return Ok(value);
}

trusted async func transfer_async(pos mode: usize) -> Result<i32, Failure>
    uses(foreign_call)
{
    let mut iteration: usize = 0;
    let mut value: i32 = 41;

    while iteration < 1
    {
        iteration += 1;

        let mut scope = AsyncScope
        {
            state = prepare(false, true)
        };

        core.atomic.store<u32, 4>(&ALLOCATIONS, trusted deny_allocation());

        let _ = with capability = scope
        {
            let local = BodyLocal
            {
                previous_exits = core.atomic.load<usize, 1>(&EXITS)
            };

            if mode == 0
            {
                return Ok(73);
            }

            if mode == 1
            {
                value = 29;
                break;
            }

            continue;
        };
    }

    return Ok(value);
}

async func normal_unit()
{
    let mut scope = AsyncScope
    {
        state = prepare(false, true)
    };

    let outcome: Result<unit, Failure> = with capability = scope {};
    let _ = std.testing.assert_error<unit, Failure>(outcome);
}

async func nullable() -> Result<unit, Failure>?
{
    let mut scope = AsyncScope
    {
        state = prepare(false, true)
    };

    let absent: i32? = none;

    let _ = with capability = scope
    {
        absent?;
        yield unit;
    };

    return none;
}

async func propagate_error() -> Result<unit, Failure>
{
    let mut scope = AsyncScope
    {
        state = prepare(false, true)
    };

    let mut state = prepare(false, false);
    let failed: Result<unit, Failure> = Error(failure(&mut state));

    let _ = with capability = scope
    {
        try failed;
        yield unit;
    };

    return Ok(unit);
}

async func panic_scope(pos forward: bool)
{
    let mut scope = AsyncScope
    {
        state = prepare(false, true)
    };

    let _ = with capability = scope
    {
        if forward
        {
            let report = std.testing.assert_error<unit, PanicReport>(
                catch
                {
                    panic("");
                    yield unit;
                }
            );

            let outcome: RunResult<unit> = Panicked(report);

            try outcome;
        }

        panic("");
    };
}

async func cancel_scope(pos panic_exit: bool)
{
    let mut state = prepare(false, true);

    state.panic_exit = panic_exit;

    let mut scope = AsyncScope
    {
        state = state
    };

    let _ = with capability = scope
    {
        let outcome: RunResult<unit> = Cancelled;

        try outcome;
    };
}

trusted async func main()
    uses(foreign_call)
{
    await normal(false, false, false);
    await normal(false, false, true);
    await normal(false, true, false);
    await normal(false, true, true);
    await normal(true, false, false);
    await normal(true, false, true);
    await normal(true, true, false);
    await normal(true, true, true);

    assert(core.atomic.load<usize, 1>(&ENTRIES) == 8);
    assert(core.atomic.load<usize, 1>(&EXITS) == 4);
    assert(core.atomic.load<usize, 1>(&ERRORS) == 6);
    assert(core.atomic.load<usize, 1>(&CAPTURES) == 8);
    assert(core.atomic.load<usize, 1>(&FINALIZERS) == 6);

    await normal_unit();

    let mut variant: usize = 0;

    while variant < 2
    {
        let asynchronous = variant == 1;
        let mut mode: usize = 0;

        variant += 1;

        while mode < 3
        {
            let mut checked = false;

            let _ = catch
            {
                let value = if asynchronous
                {
                    yield std.testing.assert_ok<i32, Failure>(await trusted transfer_async(mode));
                }
                else
                {
                    yield std.testing.assert_ok<i32, Failure>(await trusted transfer_sync(mode));
                };

                let attempts = trusted restore_allocation(core.atomic.load<u32, 1>(&ALLOCATIONS));

                assert(attempts == 0, "scoped cleanup allocated after admission");

                let expected = if mode == 0
                {
                    yield 73;
                }
                else if mode == 1
                {
                    yield 29;
                }
                else
                {
                    yield 41;
                };

                assert(value == expected, "exit error replaced the pending transfer");
                checked = true;
                panic("");

                yield unit;
            };

            assert(checked, "pending transfer or allocation check failed inside catch");
            mode += 1;
        }
    }

    let mut nullable_checked = false;

    let _ = catch
    {
        match consume await nullable()
        {
            case none {}
            case ?unexpected { panic("nullable propagation was replaced by the exit error"); }
        }

        nullable_checked = true;
        panic("");

        yield unit;
    };

    assert(nullable_checked, "nullable transfer was not preserved");

    let mut result_checked = false;

    let _ = catch
    {
        let error = std.testing.assert_error<unit, Failure>(await propagate_error());

        assert(error.marker == 619);

        result_checked = true;
        panic("");

        yield unit;
    };

    assert(result_checked, "result transfer was not preserved");

    let mut panics: usize = 0;

    while panics < 2
    {
        let forward = panics == 1;

        panics += 1;

        let _ = std.testing.assert_error<unit, PanicReport>(
            catch
            {
                await panic_scope(forward);
                yield unit;
            }
        );
    }

    std.testing.assert_cancelled<unit>(await cancel_scope(false).start().join());

    let _ = std.testing.assert_panicked<unit>(await cancel_scope(true).start().join());

    assert(!core.atomic.load<bool, 1>(&INVALID_ORDER), "body locals ended before their selected exit");
    assert(!core.atomic.load<bool, 1>(&ENTERED_INACTIVE), "quiescence entered an inactive Future body");
    assert(core.atomic.load<usize, 1>(&ENTRIES) == 21);
    assert(core.atomic.load<usize, 1>(&EXITS) == 17);
    assert(core.atomic.load<usize, 1>(&ERRORS) == 19);
    assert(core.atomic.load<usize, 1>(&CAPTURES) == 22);
    assert(core.atomic.load<usize, 1>(&FINALIZERS) == 8, "suppressed error finalization was replayed");
}
