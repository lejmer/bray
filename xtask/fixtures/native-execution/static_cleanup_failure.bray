module static_cleanup_failure;

@layout(stable, align = 64)
struct Failure
{
    value: i32;

    destruct()
    {
        assert(self.value == 7);
    }
}

struct Resource<T>
{
    value: T;

    finalize() -> Result<unit, Failure>
    {
        return Error(
            Failure
            {
                value = 7
            }
        );
    }

    destruct() {}
}

static RESOURCE: Resource<i32> =
{
    value = 42
};

struct BorrowedFailure
{
    value: &i32;

    trusted destruct()
        uses(intrinsic)
    {
        if self.value != 73
        {
            trusted core.target.abort();
        }
    }
}

struct BorrowingResource
{
    mut value: i32;

    finalize() -> Result<unit, BorrowedFailure>
    {
        return Error(
            BorrowedFailure
            {
                value = &self.value
            }
        );
    }

    destruct()
    {
        self.value = 0;
    }
}

static BORROWING: BorrowingResource =
{
    value = 73
};

@thread_local static THREAD_BORROWING: BorrowingResource =
{
    value = 73
};

func main() -> i32
{
    assert(RESOURCE.value == 42);
    assert(BORROWING.value == 73);
    assert(THREAD_BORROWING.value == 73);
    return 0;
}
