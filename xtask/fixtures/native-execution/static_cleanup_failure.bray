module static_cleanup_failure;

@layout(stable, align = 64)
struct Failure
{
    value: i32;

    destruct()
    {
        assert(self.value == 7);
    }
}

struct Resource<T>
{
    value: T;

    finalize() -> Result<unit, Failure>
    {
        return Error(
            Failure
            {
                value = 7
            }
        );
    }

    destruct() {}
}

static RESOURCE: Resource<i32> =
{
    value = 42
};

func main() -> i32
{
    assert(RESOURCE.value == 42);
    return 0;
}
