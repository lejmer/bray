trusted module guarded_part_cleanup;

using core.atomic;
using core.memory;

internal static RELEASES: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

internal static CLEANUP_ORDER: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

internal static CONSTRUCTION_OPTIONS: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

internal static FINALIZATIONS: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

internal static FAIL_FINALIZATION: core.atomic.Atomic<i32> = core.atomic.initialize<i32>(0);

struct Counter
{
    mut value: i32;
}

struct Guard
{
    mut counter: &mut Counter;
    digit: usize = 0;
    fail: bool = false;

    destruct()
    {
        self.counter.value += 1;

        if self.digit != 0
        {
            let current = core.atomic.load<usize, 1>(&CLEANUP_ORDER);

            core.atomic.store<usize, 4>(&CLEANUP_ORDER, current * 10 + self.digit);
        }

        if self.fail
        {
            panic("old custom-policy replacement destructor");
        }
    }
}

struct Pair
{
    mut left: Guard;
    right: Guard;
}

internal static DESTRUCTIONS: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

struct FinalizedChild
{
    finalize()
    {
        let count = core.atomic.load<usize, 1>(&FINALIZATIONS);

        core.atomic.store<usize, 4>(&FINALIZATIONS, count + 1);
    }

    destruct()
    {
        let count = core.atomic.load<usize, 1>(&DESTRUCTIONS);

        core.atomic.store<usize, 4>(&DESTRUCTIONS, count + 1);
    }
}

struct FinalizingPair
{
    parts: (FinalizedChild, FinalizedChild);

    finalize()
    {
        if core.atomic.load<i32, 1>(&FAIL_FINALIZATION) != 0
        {
            panic("stored target finalization");
        }
    }
}

struct InlineStorage<T>
{
    mut value: Uninit<T>;
}

impl InlineStorage<T>(Storage<T>)
{
    trusted static func create(pos value: T, options: usize = 7) -> Self
    {
        let previous = core.atomic.load<usize, 1>(&CONSTRUCTION_OPTIONS);

        core.atomic.store<usize, 4>(&CONSTRUCTION_OPTIONS, previous + options);

        let mut storage: Uninit<T> = core.memory.uninit<T>();
        let _: &mut T = core.memory.uninit_write<T>(&mut storage, value);

        return
        {
            value = storage
        };
    }

    static func borrow(pos storage: &Self) -> &T
        executes(pure, total)
    {
        return borrow_stored<T>(storage);
    }

    static func borrow_mut(pos storage: &mut Self) -> &mut T
        executes(pure, total)
    {
        return borrow_stored_mut<T>(storage);
    }

    trusted static func release(pos storage: Self)
    {
        let count = core.atomic.load<usize, 1>(&RELEASES);

        core.atomic.store<usize, 4>(&RELEASES, count + 1);

        let order = core.atomic.load<usize, 1>(&CLEANUP_ORDER);

        if order != 0
        {
            core.atomic.store<usize, 4>(&CLEANUP_ORDER, order * 10 + 3);
        }
    }
}

// These projections expose the invariant established by InlineStorage<T>.create. The storage protocol
// supplies a live initialized target until compiler-owned destruction.
// The borrow retains the storage capability.
trusted func stored_pointer<T>(pos storage: &InlineStorage<T>) -> RawPointer<T>
    executes(pure, total)
    ensures(
        trusted core.memory.valid_read<T>(pointer = result, count = 1),
        trusted core.memory.aligned_for<T>(pointer = result),
        trusted core.memory.initialized_as<T>(pointer = result),
        trusted core.memory.shared_alias_valid<T>(pointer = result),
        trusted core.memory.epoch_current<T>(pointer = result),
        trusted core.memory.synchronized_access<T>(pointer = result),
        trusted core.memory.movement_stable<T>(pointer = result),
        trusted core.memory.finalization_pending<T>(pointer = result),
    )
{
    return core.memory.uninit_pointer<T>(&storage.value);
}

trusted func stored_pointer_mut<T>(pos storage: &mut InlineStorage<T>) -> RawPointer<T>
    executes(pure, total)
    ensures(
        trusted core.memory.valid_write<T>(pointer = result, count = 1),
        trusted core.memory.aligned_for<T>(pointer = result),
        trusted core.memory.initialized_as<T>(pointer = result),
        trusted core.memory.exclusive_alias_valid<T>(pointer = result),
        trusted core.memory.epoch_current<T>(pointer = result),
        trusted core.memory.synchronized_access<T>(pointer = result),
        trusted core.memory.movement_stable<T>(pointer = result),
        trusted core.memory.finalization_pending<T>(pointer = result),
    )
{
    return core.memory.uninit_pointer_mut<T>(&mut storage.value);
}

trusted func borrow_stored<T>(pos storage: &InlineStorage<T>) -> &T
    executes(pure, total)
    uses(raw_memory, unchecked_alias)
{
    let pointer = stored_pointer<T>(storage);

    return trusted core.memory.borrow_from<T, InlineStorage<T>>(storage, pointer);
}

trusted func borrow_stored_mut<T>(pos storage: &mut InlineStorage<T>) -> &mut T
    executes(pure, total)
    uses(raw_memory, unchecked_alias)
{
    let pointer = stored_pointer_mut<T>(storage);

    return trusted core.memory.borrow_mut_from<T, InlineStorage<T>>(storage, pointer);
}

union Choice
{
    Pair(pos left: Guard, pos right: Guard);
    Empty;
}

union GuardChoice
{
    First(pos item: Guard);
    Second(pos item: Guard);
}

struct ConsumingPair
{
    left: Guard;
    right: Guard;

    destruct()
    {
        take(self.left);
    }
}

func destructed(pos pair: ConsumingPair) {}

func dispose_box(pos pair: box[InlineStorage<FinalizingPair>] FinalizingPair) {}

func boxed(pos pair: box[InlineStorage<Pair>] Pair)
{
    let box(Pair
    {
        left,..
    }) = pair;

    take(left);
}

func take(pos guard: Guard) {}

func boxed_panic(pos pair: box[InlineStorage<Pair>] Pair)
{
    let box(Pair
    {
        left,..
    }) = pair;

    take(left);
    panic("partial owned cleanup");
}

func observe_box(pos pair: box[InlineStorage<Pair>] Pair) -> i32
{
    match pair
    {
        case box(Pair
        {
            left,..
        })
        {
            return left.counter.value;
        }
    }
}

func move_box_target(pos pair: box[InlineStorage<Pair>] Pair)
{
    let box(value) = pair;

    consume_pair(value);
}

func consume_pair(pos pair: Pair) {}

func observe_borrowed_box(pos pair: &box[InlineStorage<Pair>] Pair) -> i32
{
    match pair
    {
        case box(Pair
        {
            left,..
        })
        {
            return left.counter.value;
        }
    }
}

func indexed<const Count: usize>(pos values: [Guard; Count], pos index: usize)
{
    take(values[index]);
}

func indexed_return<const Count: usize>(pos values: [Guard; Count], pos index: usize) -> Guard
{
    return values[index + 0];
}

func nested_indexed(pos values: [[Guard; 1]; 2], pos index: usize)
{
    take(values[index][0]);
}

func indexed_repaired(pos mut values: [Guard; 2], pos index: usize, pos replacement: Guard)
{
    take(values[index]);
    values[index] = replacement;
}

func guarded(pos pair: Pair, pos flag: bool)
{
    match consume pair
    {
        case Pair
        {
            left,..
        }
        when left.counter.value >= 0 && flag
        {
            take(left);
        }
        case Pair
        {
            right,..
        }
        {
            take(right);
        }
    };
}

func guarded_alternative(pos choice: GuardChoice, pos flag: bool)
{
    match consume choice
    {
        case First(item) | Second(item) when item.counter.value >= 0 && flag { take(item); }
        case First(item) | Second(item) { take(item); }
    };
}

func fields(pos flag: bool, pos first: &mut Counter, pos second: &mut Counter) -> i32
{
    let pair: Pair = Pair
    {
        left = Guard
        {
            counter = first
        },
        right = Guard
        {
            counter = second
        },
    };

    if flag
    {
        take(pair.left);
    }

    return 7;
}

func tupled(pos first: &mut Counter, pos second: &mut Counter) -> Guard
{
    let pair: (Guard, Guard) = (
        Guard
        {
            counter = first
        },
        Guard
        {
            counter = second
        }
    );

    return pair.0;
}

func payload(pos choice: Choice)
{
    match consume choice
    {
        case Pair(left,..) { take(left); }
        case Empty {}
    };
}

func nullable(pos pair: Pair?)
{
    match consume pair
    {
        case ?Pair
        {
            left,..
        }
        {
            take(left);
        }
        case none {}
    };
}

func replacement(pos fails: bool)
{
    let mut first: Counter = Counter
    {
        value = 0
    };

    let mut second: Counter = Counter
    {
        value = 0
    };

    let mut third: Counter = Counter
    {
        value = 0
    };

    let mut fourth: Counter = Counter
    {
        value = 0
    };

    let releases = core.atomic.load<usize, 1>(&RELEASES);

    let outcome = catch
    {
        let mut value: box[InlineStorage<Pair>] Pair = box(
            Pair
            {
                left = Guard
                {
                    counter = &mut first
                },
                right = Guard
                {
                    counter = &mut second,
                    fail = fails
                }
            }
        );

        value = box(
            Pair
            {
                left = Guard
                {
                    counter = &mut third
                },
                right = Guard
                {
                    counter = &mut fourth
                }
            }
        );

        assert(core.atomic.load<usize, 1>(&RELEASES) == releases + 1);
        yield unit;
    };

    assert((outcome matches Error(_)) == fails);
    assert(first.value == 1 && second.value == 1);
    assert(third.value == 1 && fourth.value == 1);
    assert(core.atomic.load<usize, 1>(&RELEASES) == releases + 2);
}

func main() -> i32
{
    let mut first: Counter = Counter
    {
        value = 0
    };

    let mut second: Counter = Counter
    {
        value = 0
    };

    if fields(false, &mut first, &mut second) != 7 || first.value != 1 || second.value != 1
    {
        return 1;
    }

    if fields(true, &mut first, &mut second) != 7 || first.value != 2 || second.value != 2
    {
        return 2;
    }

    take(tupled(&mut first, &mut second));

    if first.value != 3 || second.value != 3
    {
        return 3;
    }

    payload(
        Choice.Pair(
            Guard
            {
                counter = &mut first
            },
            Guard
            {
                counter = &mut second
            }
        )
    );

    payload(Choice.Empty);

    if first.value != 4 || second.value != 4
    {
        return 4;
    }

    nullable(
        Pair
        {
            left = Guard
            {
                counter = &mut first
            },
            right = Guard
            {
                counter = &mut second
            }
        }
    );

    nullable(none);

    if first.value != 5 || second.value != 5
    {
        return 5;
    }

    destructed(
        ConsumingPair
        {
            left = Guard
            {
                counter = &mut first
            },
            right = Guard
            {
                counter = &mut second
            }
        }
    );

    if first.value != 6 || second.value != 6
    {
        return 6;
    }

    indexed<2>(
        [
            Guard
            {
                counter = &mut first
            },
            Guard
            {
                counter = &mut second
            }
        ],
        1
    );

    if first.value != 7 || second.value != 7
    {
        return 7;
    }

    indexed<2>(
        [
            Guard
            {
                counter = &mut first
            },
            Guard
            {
                counter = &mut second
            }
        ],
        0
    );

    if first.value != 8 || second.value != 8
    {
        return 8;
    }

    take(
        indexed_return<2>(
            [
                Guard
                {
                    counter = &mut first
                },
                Guard
                {
                    counter = &mut second
                }
            ],
            1
        )
    );

    if first.value != 9 || second.value != 9
    {
        return 9;
    }

    nested_indexed(
        [
            [
                Guard
                {
                    counter = &mut first
                }
            ],
            [
                Guard
                {
                    counter = &mut second
                }
            ]
        ],
        1
    );

    if first.value != 10 || second.value != 10
    {
        return 10;
    }

    let mut replacement_counter: Counter = Counter
    {
        value = 0
    };

    indexed_repaired(
        [
            Guard
            {
                counter = &mut first
            },
            Guard
            {
                counter = &mut second
            }
        ],
        0,
        Guard
        {
            counter = &mut replacement_counter
        }
    );

    if first.value != 11 || second.value != 11 || replacement_counter.value != 1
    {
        return 11;
    }

    guarded(
        Pair
        {
            left = Guard
            {
                counter = &mut first
            },
            right = Guard
            {
                counter = &mut second
            }
        },
        false
    );

    if first.value != 12 || second.value != 12
    {
        return 12;
    }

    guarded(
        Pair
        {
            left = Guard
            {
                counter = &mut first
            },
            right = Guard
            {
                counter = &mut second
            }
        },
        true
    );

    if first.value != 13 || second.value != 13
    {
        return 13;
    }

    guarded_alternative(
        GuardChoice.First(
            Guard
            {
                counter = &mut first
            }
        ),
        false
    );

    guarded_alternative(
        GuardChoice.Second(
            Guard
            {
                counter = &mut second
            }
        ),
        true
    );

    if first.value != 14 || second.value != 14
    {
        return 14;
    }

    let owned = box[InlineStorage<Pair>](
        Pair
        {
            left = Guard
            {
                counter = &mut first
            },
            right = Guard
            {
                counter = &mut second
            }
        },
        options = 9
    );

    boxed(owned);

    if first.value != 15 || second.value != 15
    {
        return 15;
    }

    let observed: box[InlineStorage<Pair>] Pair = box(
        Pair
        {
            left = Guard
            {
                counter = &mut first
            },
            right = Guard
            {
                counter = &mut second
            },
        }
    );

    if observe_borrowed_box(&observed) != 15
    {
        return 18;
    }

    if observe_box(observed) != 15 || first.value != 16 || second.value != 16
    {
        return 16;
    }

    let transferred: box[InlineStorage<Pair>] Pair = box(
        Pair
        {
            left = Guard
            {
                counter = &mut first
            },
            right = Guard
            {
                counter = &mut second
            },
        }
    );

    move_box_target(transferred);

    if first.value != 17 || second.value != 17
    {
        return 17;
    }

    if core.atomic.load<usize, 1>(&RELEASES) != 3
    {
        return 19;
    }

    let ordered: box[InlineStorage<Pair>] Pair = box(
        Pair
        {
            left = Guard
            {
                counter = &mut first,
                digit = 1
            },
            right = Guard
            {
                counter = &mut second,
                digit = 2
            },
        }
    );

    boxed(ordered);

    if first.value != 18 || second.value != 18 || core.atomic.load<usize, 1>(&RELEASES) != 4 || core.atomic.load<
        usize,
        1
    >(&CLEANUP_ORDER) != 123
    {
        return 20;
    }

    core.atomic.store<usize, 4>(&CLEANUP_ORDER, 0);

    let caught: Result<unit, PanicReport> = catch
    {
        let partial: box[InlineStorage<Pair>] Pair = box(
            Pair
            {
                left = Guard
                {
                    counter = &mut first,
                    digit = 1
                },
                right = Guard
                {
                    counter = &mut second,
                    digit = 2
                },
            }
        );

        boxed_panic(partial);
        yield unit;
    };

    let failed: bool = match consume caught
    {
        case Ok(_) { yield false; }
        case Error(_) { yield true; }
    };

    if !failed || first.value != 19 || second.value != 19 || core.atomic.load<usize, 1>(&RELEASES) != 5 ||
        core.atomic.load<usize, 1>(&CLEANUP_ORDER) != 123
    {
        return 21;
    }

    if core.atomic.load<usize, 1>(&CONSTRUCTION_OPTIONS) != 37
    {
        return 22;
    }

    replacement(false);
    replacement(true);

    let ordinary = check_finalization(false);

    if ordinary != 0
    {
        return ordinary;
    }

    return check_finalization(true);
}

func check_finalization(pos fails: bool) -> i32
{
    core.atomic.store<usize, 4>(&FINALIZATIONS, 0);
    core.atomic.store<usize, 4>(&DESTRUCTIONS, 0);

    if fails
    {
        core.atomic.store<i32, 4>(&FAIL_FINALIZATION, 1);
    }

    let before = core.atomic.load<usize, 1>(&RELEASES);

    let result: Result<unit, PanicReport> = catch
    {
        let finalizing: box[InlineStorage<FinalizingPair>] FinalizingPair = box(
            FinalizingPair
            {
                parts = (
                    FinalizedChild
                    {
                    },
                    FinalizedChild
                    {
                    }
                ),
            }
        );

        dispose_box(finalizing);
        yield unit;
    };

    let failed = match consume result
    {
        case Ok(_) { yield false; }
        case Error(_) { yield true; }
    };

    core.atomic.store<i32, 4>(&FAIL_FINALIZATION, 0);

    if failed != fails || core.atomic.load<usize, 1>(&RELEASES) != before + 1 || core.atomic.load<usize, 1>(
        &DESTRUCTIONS
    ) != 2
    {
        return 23;
    }

    let expected: usize = if fails
    {
        yield 0;
    }
    else
    {
        yield 2;
    };

    if core.atomic.load<usize, 1>(&FINALIZATIONS) != expected
    {
        return 24;
    }

    return 0;
}
