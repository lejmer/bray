module async_tasks;

using std.task;
using std.testing;

internal static RELEASE: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

async func gated(pos gate: usize)
{
    while core.atomic.load<usize, 1>(&RELEASE) < gate
    {
        await std.task.yield_now();
    }
}

async func returned_task(pos gate: usize) -> Task<unit>
{
    return gated(gate).start();
}

struct TaskOwner
{
    task: Task<unit>;
}

async func returned_owner(pos gate: usize) -> TaskOwner
{
    return TaskOwner
    {
        task = await returned_task(gate)
    };
}

async func complete()
{
    return unit;
}

async func produce() -> Result<i32, i32>
{
    return Ok(42);
}

async func fail()
{
    panic("independent task panic");
}

async func await_cancellation()
{
    loop
    {
        await std.task.yield_now();
    }
}

async func main()
{
    // The gate keeps each returned task live until its new owner releases it.
    let direct: Task<unit> = await returned_task(1);

    core.atomic.store<usize, 4>(&RELEASE, 1);
    std.testing.assert_completed<unit>(await direct.join());

    let owner: TaskOwner = std.testing.assert_completed<TaskOwner>(await returned_owner(2).start().join());

    core.atomic.store<usize, 4>(&RELEASE, 2);
    std.testing.assert_completed<unit>(await owner.task.join());

    let first: Task<unit> = complete().start();
    let second: Task<unit> = complete().start();
    let result_task: Task<Result<i32, i32>> = produce().start();
    let failed: Task<unit> = fail().start();
    let cancelled: Task<unit> = await_cancellation().start();

    try await first.join();
    try await second.join();

    let value: i32 = std.testing.assert_ok<i32, i32>(try await result_task.join());

    assert(value == 42);

    let _: PanicReport = std.testing.assert_panicked<unit>(await failed.join());

    std.testing.assert_cancelled<unit>(await cancelled.cancel());
}
