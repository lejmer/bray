trusted module ownership_transitions;

struct Marker
{
}

trusted predicate retained(marker: &Marker);

struct Owner
{
    marker: Marker;
    value: u32;

    trusted destruct()
        requires(trusted retained(marker = &self.marker))
        executes(pure, total) {}
}

struct State
{
    owner: Owner;
    mut progress: u32;
}

union Selection
{
    Active(pos state: State);
    Empty;
}

trusted func acquire() -> Owner
    ensures(trusted retained(marker = &result.marker))
{
    return
    {
        marker = Marker
        {
        },
        value = 7
    };
}

func observe(pos owner: &Owner)
    requires(trusted retained(marker = &owner.marker))
{
    assert(owner.value == 7);
}

func exercise(pos callback: func() -> unit, pos active: bool)
{
    let mut state: State =
    {
        owner = acquire(),
        progress = 0
    };

    while state.progress != 3
    {
        callback();
        state.progress += 1;
        callback();
        observe(&state.owner);
    }

    let selected = if active
    {
        yield Selection.Active(state);
    }
    else
    {
        yield Selection.Empty;
    };

    callback();

    match consume selected
    {
        case Selection.Active(value) { observe(&value.owner); }
        case Selection.Empty {}
    }
}

func update_state(pos mut state: State, pos choose_high: bool) -> State
    requires(trusted retained(marker = &state.owner.marker))
{
    if choose_high
    {
        state.progress = 9;
        return state;
    }

    state.progress = 4;
    return state;
}

func exercise_return(pos callback: func() -> unit, pos choose_high: bool)
{
    let initial_state: State =
    {
        owner = acquire(),
        progress = 0
    };

    let returned_state = update_state(initial_state, choose_high);
    let expected_progress: u32 = if choose_high
    {
        yield 9;
    }
    else
    {
        yield 4;
    };

    callback();
    assert(returned_state.progress == expected_progress);
    assert(returned_state.owner.value == 7);
    observe(&returned_state.owner);
}

struct ScopedOwner
{
    state: State;

    consume enter() -> State
        requires(trusted retained(marker = &self.state.owner.marker))
        ensures(trusted retained(marker = &result.owner.marker))
    {
        return self.state;
    }

    exit(pos entered_state: State)
        requires(trusted retained(marker = &entered_state.owner.marker))
    {
        observe(&entered_state.owner);
    }
}

func exercise_scope(pos callback: func() -> unit, pos early_exit: bool)
{
    let scoped_owner: ScopedOwner =
    {
        state =
        {
            owner = acquire(),
            progress = 0
        }
    };

    _ = with entered_state = scoped_owner
    {
        callback();
        observe(&entered_state.owner);

        if early_exit
        {
            return;
        }
    };
}

func progress() {}

func main() -> i32
{
    exercise(progress, true);
    exercise(progress, false);
    exercise_return(progress, false);
    exercise_return(progress, true);
    exercise_scope(progress, false);
    exercise_scope(progress, true);
    return 0;
}
