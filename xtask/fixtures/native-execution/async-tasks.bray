module async_tasks;

using core.atomic;
using std.task;
using std.testing;
using std.memory;
using std.run;

internal static RELEASE: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

internal static BUFFER_STARTED: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

internal static BUFFER_CLEANUPS: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

internal static BUFFER_DESTRUCTIONS: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

async func gated(pos gate: usize)
{
    while core.atomic.load<usize, 1>(&RELEASE) < gate
    {
        await std.task.yield_now();
    }
}

async func returned_task(pos gate: usize) -> Task<unit>
{
    return gated(gate).start();
}

struct TaskOwner
{
    task: Task<unit>;
}

async func returned_owner(pos gate: usize) -> TaskOwner
{
    return TaskOwner
    {
        task = await returned_task(gate)
    };
}

async func complete()
{
    return unit;
}

async func produce() -> Result<i32, i32>
{
    return Ok(42);
}

async func fail()
{
    panic("independent task panic");
}

async func await_cancellation()
{
    loop
    {
        await std.task.yield_now();
    }
}

struct BufferTaskParticipant
{
    async finalize()
    {
        assert(std.run.cancellation_requested());
        await std.task.yield_now();

        _ = core.atomic.fetch_add<usize, 3>(&BUFFER_CLEANUPS, 1);
    }

    destruct()
    {
        _ = core.atomic.fetch_add<usize, 3>(&BUFFER_DESTRUCTIONS, 1);
    }
}

async func buffer_task()
{
    let participant = BufferTaskParticipant
    {
    };

    _ = core.atomic.fetch_add<usize, 3>(&BUFFER_STARTED, 1);

    loop
    {
        await std.task.yield_now();
    }
}

trusted async func represented_tasks()
    uses(raw_memory, unchecked_init)
{
    let mut owners: std.memory.RawBuffer<TaskOwner> = match trusted std.memory.RawBuffer<TaskOwner>(capacity = 3)
    {
        case Ok(value) { yield value; }
        case Error(_) { panic("buffer layout"); }
    };

    trusted internal std.memory.raw_buffer_push<TaskOwner>(
        &mut owners,
        TaskOwner
        {
            task = buffer_task().start()
        }
    );

    trusted internal std.memory.raw_buffer_push<TaskOwner>(
        &mut owners,
        TaskOwner
        {
            task = buffer_task().start()
        }
    );

    while core.atomic.load<usize, 1>(&BUFFER_STARTED) != 2
    {
        await std.task.yield_now();
    }
}

trusted async func main()
{
    // The gate keeps each returned task live until its new owner releases it.
    let direct: Task<unit> = await returned_task(1);

    core.atomic.store<usize, 4>(&RELEASE, 1);
    std.testing.assert_completed<unit>(await direct.join());

    let owner: TaskOwner = std.testing.assert_completed<TaskOwner>(await returned_owner(2).start().join());

    core.atomic.store<usize, 4>(&RELEASE, 2);
    std.testing.assert_completed<unit>(await owner.task.join());

    let first: Task<unit> = complete().start();
    let second: Task<unit> = complete().start();
    let result_task: Task<Result<i32, i32>> = produce().start();
    let failed: Task<unit> = fail().start();
    let cancelled: Task<unit> = await_cancellation().start();

    try await first.join();
    try await second.join();

    let value: i32 = std.testing.assert_ok<i32, i32>(try await result_task.join());

    assert(value == 42);

    _ = std.testing.assert_panicked<unit>(await failed.join());

    std.testing.assert_cancelled<unit>(await cancelled.cancel());

    await trusted represented_tasks();

    assert(core.atomic.load<usize, 1>(&BUFFER_CLEANUPS) == 2);
    assert(core.atomic.load<usize, 1>(&BUFFER_DESTRUCTIONS) == 2);
}
