module std.memory;

trusted func main() -> Result<unit, MemoryLayoutError>
    uses(layout_reinterpret, manual_alloc, raw_memory, unchecked_init)
{
    let buffer: RawBuffer<u8> = try trusted RawBuffer<u8>(capacity = 5);

    assert(initialized_count<u8>(&buffer) == 0);
    assert(capacity<u8>(&buffer) == 5);

    return Ok(unit);
}
