module std.character;

func exercise_character_operations(value: char, scalar: u32)
{
    let scalar_code: u32 = value.code_point();
    let character: char? = char.from_code_point(scalar);
    let encoding: Utf8Encoding = value.encode_utf8();
    let encoded: &[u8] = encoding.as_slice();
    let observed_alphabetic: bool = value.is_alphabetic();
    let observed_numeric: bool = value.is_numeric();
    let observed_whitespace: bool = value.is_whitespace();
}
