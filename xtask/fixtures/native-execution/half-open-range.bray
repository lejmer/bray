module range_execution;

func main() -> i32
{
    let mut signed_index: i32 = 0;

    for value in 0..4
    {
        if value != signed_index
        {
            return 1;
        }

        signed_index += 1;
    }

    if signed_index != 4
    {
        return 2;
    }

    for _ in 4..4
    {
        return 3;
    }

    for _ in 4..0
    {
        return 4;
    }

    let mut unsigned_index: u32 = 0;
    let unsigned_start: u32 = 0;
    let unsigned_end: u32 = 4;

    for value in unsigned_start..unsigned_end
    {
        if value != unsigned_index
        {
            return 5;
        }

        unsigned_index += 1;
    }

    if unsigned_index != unsigned_end
    {
        return 6;
    }

    for _ in unsigned_end..unsigned_end
    {
        return 7;
    }

    for _ in unsigned_end..unsigned_start
    {
        return 8;
    }

    return 0;
}
