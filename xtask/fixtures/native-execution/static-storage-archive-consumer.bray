module archive_consumer;

using fixture.storage.static_storage_execution;

func exercise_storage() -> i32
{
    return fixture.storage.static_storage_execution.main() +
        fixture.storage.static_storage_execution.thread_cleanup_value();
}

func borrowed_counter() -> &i32
{
    return fixture.storage.static_storage_execution.contribution_counter_alias();
}

func imported_generic_counter() -> i32
{
    return fixture.storage.static_storage_execution.contribution_generic_counter<19>();
}

@abi(c)
@symbol(name = "bray_archive_provider_probe_read")
func provider_probe_read(pos value: i32) -> i32
{
    return value + fixture.storage.static_storage_execution.read_counter() + imported_generic_counter() - 61;
}
