module owned_entry_error;

using std.task;

struct Failure
{
    mut complete: bool;

    async finalize()
    {
        await std.task.yield_now();
        self.complete = true;
    }

    destruct()
    {
        assert(self.complete);
    }
}

async func main() -> Result<unit, Failure>
{
    return Error(
        Failure
        {
            complete = false
        }
    );
}
