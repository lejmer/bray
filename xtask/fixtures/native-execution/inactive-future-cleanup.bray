module inactive_future_cleanup;

using std.atomic;
using std.task;

struct Counter
{
    mut value: i32;
}

struct Completion
{
    mut continued: bool;

    destruct()
    {
        assert(self.continued);
    }
}

async func cancelled_guard(pos guard: Guard)
{
    loop
    {
        await std.task.yield_now();
    }
}

async func discard_task(pos counter: &mut Counter)
{
    let task = cancelled_guard(
        Guard
        {
            counter = counter
        }
    ).start();
}

async func complete() {}

struct Guard
{
    mut counter: &mut Counter;

    async finalize()
    {
        self.counter.value += 1;
        await complete();
        self.counter.value += 10;
    }

    destruct()
    {
        self.counter.value += 100;
    }
}

async func forbidden_body(pos guard: Guard)
{
    panic("discarded future entered its body");
}

async func return_guard(pos guard: Guard) -> Guard
{
    return guard;
}

async func discard_inactive(pos counter: &mut Counter)
{
    let pending = forbidden_body(
        Guard
        {
            counter = counter
        }
    );
}

async func discard_join(pos counter: &mut Counter)
{
    let task = return_guard(
        Guard
        {
            counter = counter
        }
    ).start();

    let pending = task.join();
}

async func discard_result_task(pos counter: &mut Counter)
{
    let task = return_guard(
        Guard
        {
            counter = counter
        }
    ).start();

    await std.task.yield_now();
}

async func discard_cancellation(pos counter: &mut Counter)
{
    let task = return_guard(
        Guard
        {
            counter = counter
        }
    ).start();

    let pending = task.cancel();
}

func record(pos trace: &std.atomic.Atomic<usize>, pos value: usize)
{
    let previous = trace.load(order = std.atomic.LoadOrder.Acquire);

    trace.store(previous * 10 + value, order = std.atomic.StoreOrder.Release);
}

struct FailingCapture
{
    trace: &std.atomic.Atomic<usize>;

    async finalize()
    {
        record(self.trace, 1);
        await complete();
        panic("capture finalization failed");
    }

    destruct()
    {
        record(self.trace, 2);
    }
}

struct RemainingCapture
{
    trace: &std.atomic.Atomic<usize>;

    destruct()
    {
        record(self.trace, 3);
    }
}

struct Bundle
{
    remaining: RemainingCapture;
    pending: Future<unit>;
}

async func inactive_failure(pos capture: FailingCapture)
{
    panic("discarded failing future entered its body");
}

async func discard_bundle(pos trace: &std.atomic.Atomic<usize>)
{
    let bundle = Bundle
    {
        remaining = RemainingCapture
        {
            trace = trace
        },
        pending = inactive_failure(
            FailingCapture
            {
                trace = trace
            }
        ),
    };
}

async func dispose<T>(pos value: T) {}

async func discard_generic(pos trace: &std.atomic.Atomic<usize>)
{
    let remaining = RemainingCapture
    {
        trace = trace,
    };

    await dispose<Future<unit>>(
        inactive_failure(
            FailingCapture
            {
                trace = trace,
            }
        )
    );
}

async func discard_generic_task(pos trace: &std.atomic.Atomic<usize>)
{
    let remaining = RemainingCapture
    {
        trace = trace,
    };

    await dispose<Task<unit>>(
        inactive_failure(
            FailingCapture
            {
                trace = trace,
            }
        ).start()
    );
}

async func main() -> i32
{
    let mut completion = Completion
    {
        continued = false
    };

    let mut counter = Counter
    {
        value = 0
    };

    await discard_inactive(&mut counter);

    if counter.value != 111
    {
        return 1;
    }

    await discard_join(&mut counter);

    if counter.value != 222
    {
        return 2;
    }

    await discard_cancellation(&mut counter);

    if counter.value != 333
    {
        return 3;
    }

    let trace = std.atomic.Atomic<usize>(0);
    let result = catch await discard_bundle(&trace);

    if !(result matches Error(_))
    {
        return 4;
    }

    if trace.load(order = std.atomic.LoadOrder.Acquire) != 123
    {
        return 5;
    }

    let generic_trace = std.atomic.Atomic<usize>(0);
    let generic_result = catch await discard_generic(&generic_trace);

    if !(generic_result matches Error(_))
    {
        return 6;
    }

    if generic_trace.load(order = std.atomic.LoadOrder.Acquire) != 123
    {
        return 7;
    }

    await discard_task(&mut counter);

    if counter.value != 444
    {
        return 8;
    }

    await discard_result_task(&mut counter);

    if counter.value != 555
    {
        return 9;
    }

    await dispose<Task<unit>>(
        cancelled_guard(
            Guard
            {
                counter = &mut counter
            }
        ).start()
    );

    if counter.value != 666
    {
        return 10;
    }

    await dispose<Task<Guard>>(
        return_guard(
            Guard
            {
                counter = &mut counter
            }
        ).start()
    );

    if counter.value != 777
    {
        return 11;
    }

    let task_trace = std.atomic.Atomic<usize>(0);
    let task_result = catch await discard_generic_task(&task_trace);

    if !(task_result matches Error(_))
    {
        return 12;
    }

    if task_trace.load(order = std.atomic.LoadOrder.Acquire) != 123
    {
        return 13;
    }

    completion.continued = true;

    return 0;
}
