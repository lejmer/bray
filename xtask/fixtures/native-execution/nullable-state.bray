module nullable_state;

struct OwnedValue
{
    value: i32;
}

struct Counter
{
    mut calls: i32;
}

struct GenericCounter<T>
{
    mut calls: i32;
    value: T;

    mut func take() -> T?
        with(T: Copyable)
    {
        self.calls += 1;

        return self.value;
    }

    mut func remove() -> bool
        with(T: Copyable)
    {
        return self.take().is_present();
    }
}

func next_value(pos counter: &mut Counter) -> i32?
{
    counter.calls += 1;

    return 42;
}

func borrowed_state<T>(pos value: &(T?)) -> (bool, bool)
{
    return (value.is_present(), value.is_absent());
}

func yielded_value() -> i32?
{
    return
    {
        yield 43;
    };
}

func broken_value() -> i32?
{
    return loop
    {
        break 44;
    };
}

func main() -> i32
{
    let mut generic: GenericCounter<i32> =
    {
        calls = 0,
        value = 42
    };

    let removed: bool = generic.remove();

    if generic.calls != 1 || !removed
    {
        return 10;
    }

    let present: OwnedValue? = OwnedValue
    {
        value = 7
    };

    let absent: OwnedValue? = none;
    let present_is_present: bool = present.is_present();
    let present_is_absent: bool = present.is_absent();
    let absent_is_present: bool = absent.is_present();
    let absent_is_absent: bool = absent.is_absent();
    let (borrowed_present, borrowed_absent) = borrowed_state<OwnedValue>(&present);
    let (empty_present, empty_absent) = borrowed_state<OwnedValue>(&absent);

    let integer: i32? = 7;
    let (integer_present, integer_absent) = borrowed_state<i32>(&integer);

    if !present_is_present || present_is_absent
    {
        return 1;
    }

    if absent_is_present || !absent_is_absent
    {
        return 2;
    }

    if !borrowed_present || borrowed_absent
    {
        return 3;
    }

    let mut counter: Counter = Counter
    {
        calls = 0
    };

    let next_is_present: bool = (next_value(&mut counter)).is_present();

    if !next_is_present
    {
        return 4;
    }

    if counter.calls != 1
    {
        return 5;
    }

    if(yielded_value()).is_absent()
    {
        return 6;
    }

    if(broken_value()).is_absent()
    {
        return 7;
    }

    if empty_present || !empty_absent
    {
        return 8;
    }

    if !integer_present || integer_absent
    {
        return 9;
    }

    return 0;
}
