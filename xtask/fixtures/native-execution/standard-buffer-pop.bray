module std.bytes;

func main() -> Result<unit, std.memory.MemoryLayoutError>
{
    let first: u8 = 1;
    let second: u8 = 2;
    let third: u8 = 3;
    let bytes: bytes<3> = [first, second, third];
    let mut buffer: Buffer = try Buffer.from_slice(&bytes[..]);

    pop(&mut buffer);

    let values: &[u8] = buffer.as_slice();

    assert(length(&buffer) == 2);
    assert(values[0] == 1);
    assert(values[1] == 2);

    return Ok(unit);
}
