@link(name = "bray_allocation_probe")
trusted module operation_cleanup;

@abi(c)
@symbol(name = "bray_allocation_probe_begin")
extern trusted func deny_allocation() -> u32
    uses(foreign_call);

@abi(c)
@symbol(name = "bray_allocation_probe_end")
extern trusted func restore_allocation(pos before: u32) -> u32
    uses(foreign_call);

using core.atomic;

internal static SOURCES: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

internal static TARGETS: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

internal static EXITS: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

internal static INCIDENTS: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

struct Incident
{
    value: usize;

    destruct()
    {
        assert(self.value == 619, "operation cleanup lost its incident payload");

        _ = core.atomic.fetch_add<usize, 0>(&INCIDENTS, value = 1);
    }
}

struct Resource
{
    enter() -> unit {}

    exit(pos lease: unit) -> Result<unit, Incident>
    {
        _ = core.atomic.fetch_add<usize, 0>(&EXITS, value = 1);

        return Error(
            Incident
            {
                value = 619
            }
        );
    }
}

struct Source
{
    value: usize;

    destruct()
    {
        _ = core.atomic.fetch_add<usize, 0>(&SOURCES, value = 1);
    }
}

struct Target
{
    value: usize;

    destruct()
    {
        _ = core.atomic.fetch_add<usize, 0>(&TARGETS, value = 1);
    }
}

impl SourceConversion = Source(ConvertTo<Target>)
{
    consume func convert() -> Target
    {
        if self.value == 0
        {
            panic("conversion stops before the next owner is initialized");
        }

        let resource = Resource
        {
        };

        _ = with lease = resource
        {
            return Target
            {
                value = self.value
            };
        };

        return Target
        {
            value = self.value
        };
    }
}

struct MutableValue
{
    mut active: bool;
}

struct MutationSource
{
    value: &mut MutableValue;
}

struct MutationTarget
{
}

impl MutationConversion = MutationSource(ConvertTo<MutationTarget>)
{
    consume func convert() -> MutationTarget
    {
        let mut reference = self.value;

        reference.active = true;

        return MutationTarget
        {
        };
    }
}

struct Doomed
{
}

impl DoomedConversion = Doomed(ConvertTo<Target>)
{
    consume func convert() -> Target
    {
        panic("an absent conversion payload must never be invoked");
    }
}

func default_value() -> usize
{
    let resource = Resource
    {
    };

    _ = with lease = resource
    {
        return 619;
    };

    return 619;
}

struct Constructed
{
    value: usize;

    construct(pos value: usize, extra: usize = default_value()) -> Self
    {
        assert(extra == 619, "type-form default lost its value");

        let resource = Resource
        {
        };

        _ = with lease = resource
        {
            return
            {
                value = value
            };
        };

        return
        {
            value = value
        };
    }

    destruct()
    {
        _ = core.atomic.fetch_add<usize, 0>(&TARGETS, value = 1);
    }
}

struct Defaulted
{
    value: usize = default_value();
}

union DefaultUnion
{
    Value(value: usize = default_value());
}

struct Indexed
{
    value: usize;
}

impl ElementAccess = Indexed(ElementIndex<usize>)
{
    type Output = usize;

    func index(pos selector: &usize) -> &usize
    {
        let resource = Resource
        {
        };

        _ = with lease = resource
        {
            return &self.value;
        };

        return &self.value;
    }
}

impl SliceAccess = Indexed(SliceIndex<usize>)
{
    type Output = usize;

    func slice(pos start: usize?, pos end: usize?) -> &usize
    {
        let resource = Resource
        {
        };

        _ = with lease = resource
        {
            return &self.value;
        };

        return &self.value;
    }
}

trusted func main() -> i32
    uses(foreign_call)
{
    let mut first = MutableValue
    {
        active = false
    };

    let mut second = MutableValue
    {
        active = false
    };

    let mut third = MutableValue
    {
        active = false
    };

    let mut fourth = MutableValue
    {
        active = false
    };

    let mutation_pair = (
        MutationSource
        {
            value = &mut first
        },
        MutationSource
        {
            value = &mut second
        }
    ) as(MutationTarget, MutationTarget);

    let mutation_present: MutationSource? = MutationSource
    {
        value = &mut third
    };

    let mutation_nullable = mutation_present as MutationTarget?;

    let mutation_array = [
        MutationSource
        {
            value = &mut fourth
        }
    ] as[MutationTarget; 1];

    assert(
        first.active && second.active && third.active && fourth.active,
        "composite conversion lost its reference mutation"
    );

    let never_present: Doomed? = none;
    let absent_target = never_present as Target?;

    let empty: [Doomed; 0] = [
        Doomed
        {
        }; 0
    ];

    let empty_targets = empty as[Target; 0];

    {
        _ = catch
        {
            let pair = (
                Source
                {
                    value = 1
                },
                Source
                {
                    value = 2
                }
            ) as(Target, Target);

            let values = [
                Source
                {
                    value = 3
                },
                Source
                {
                    value = 4
                },
                Source
                {
                    value = 5
                }
            ] as[Target; 3];

            let present: Source? = Source
            {
                value = 6
            };

            let converted = present as Target?;
            let absent: Source? = none;
            let converted_absent = absent as Target?;
            let constructed = Constructed(619);

            let defaulted = Defaulted
            {
            };

            let variant: DefaultUnion = Value();

            let indexed = Indexed
            {
                value = 619
            };

            let selector: usize = 0;
            let lower_bound: usize = 1;
            let upper_bound: usize = 2;
            let element = indexed[selector];
            let complete = indexed.slice(none, none);
            let lower = indexed[lower_bound..];
            let upper = indexed[..upper_bound];
            let bounded = indexed[default_value()..default_value()];

            assert(core.atomic.load<usize, 1>(&SOURCES) == 6, "conversion failed to consume each source once");
            assert(core.atomic.load<usize, 1>(&INCIDENTS) == 0, "operation report was destroyed before its owner");
            assert(core.atomic.load<usize, 1>(&EXITS) == 17, "an operation skipped its selected exit");
            assert(element == 619 && lower == 619 && upper == 619 && bounded == 619, "indexing lost its result");
            assert(defaulted.value == 619 && constructed.value == 619, "construction lost its result");

            panic("consume the retained operation reports");

            yield unit;
        };
    }

    assert(core.atomic.load<usize, 1>(&SOURCES) == 6, "conversion destroyed a source twice");
    assert(core.atomic.load<usize, 1>(&TARGETS) == 7, "conversion or construction lost a target owner");

    assert(core.atomic.load<usize, 1>(&INCIDENTS) == 17, "operation composition lost a retained exit report");

    {
        _ = catch
        {
            let values = (
                Source
                {
                    value = 1
                },
                Source
                {
                    value = 0
                },
                Source
                {
                    value = 3
                }
            ) as(Target, Target, Target);

            yield unit;
        };
    }

    assert_cleanup_counts(9, 8, 18);

    {
        _ = catch
        {
            let values = [
                Source
                {
                    value = 1
                },
                Source
                {
                    value = 0
                },
                Source
                {
                    value = 3
                }
            ] as[Target; 3];

            yield unit;
        };
    }

    assert_cleanup_counts(12, 9, 19);

    {
        _ = catch
        {
            let present: Source? = Source
            {
                value = 0
            };

            let converted = present as Target?;

            yield unit;
        };
    }

    assert_cleanup_counts(13, 9, 19);

    {
        let values: [Source; 3] = [
            each item in 0..3
            {
                yield Source
                {
                    value = 1
                };
            }
        ];
    }

    assert_cleanup_counts(16, 9, 19);

    {
        _ = catch
        {
            let values: [Source; 3] = [
                each item in 0..3
                {
                    if item == 2
                    {
                        panic("stop after two initialized elements");
                    }

                    yield Source
                    {
                        value = 1
                    };
                }
            ];

            yield unit;
        };
    }

    assert_cleanup_counts(18, 9, 19);

    {
        let values =
        {
            each item in 0..6
            {
                yield Source
                {
                    value = 1
                };

                yield Source
                {
                    value = 1
                };
            }
        };
    }

    assert_cleanup_counts(30, 9, 19);

    {
        let values =
        {
            each item in 0..0
            {
                yield Source
                {
                    value = 1
                };
            }
        };
    }

    assert_cleanup_counts(30, 9, 19);

    {
        _ = catch
        {
            let values =
            {
                each item in 0..8
                {
                    if item == 5
                    {
                        panic("stop after growing the initialized prefix");
                    }

                    yield Source
                    {
                        value = 1
                    };
                }
            };

            yield unit;
        };
    }

    assert_cleanup_counts(35, 9, 19);
    verify_generator_iteration();
    verify_nested_generator_cleanup();
    trusted verify_denied_generator_growth(0);
    trusted verify_denied_generator_growth(4);
    verify_generator_predicates(0);
    verify_generator_predicates(1);

    let allocation_state = trusted deny_allocation();

    verify_generator_predicates(observed_count());

    assert(
        trusted restore_allocation(allocation_state) == 0,
        "predicate generator observation allocated collection storage"
    );

    return 0;
}

func assert_cleanup_counts(pos sources: usize, pos targets: usize, pos incidents: usize)
{
    assert(core.atomic.load<usize, 1>(&SOURCES) == sources, "failed conversion lost or repeated source destruction");
    assert(core.atomic.load<usize, 1>(&TARGETS) == targets, "failed conversion lost or repeated target destruction");
    assert(core.atomic.load<usize, 1>(&EXITS) == incidents, "failed conversion ran an unexpected exit");
    assert(core.atomic.load<usize, 1>(&INCIDENTS) == incidents, "failed conversion lost a retained exit report");
}

func verify_generator_iteration()
{
    let values =
    {
        each item in 0..9
        {
            yield item;
        }
    };

    let mut expected: i32 = 0;

    for value in values
    {
        assert(value == expected, "shared iteration changes production order");
        expected += 1;
    }

    assert(expected == 9);

    let flags =
    {
        each item in 0..9
        {
            yield item < 5;
        }
    };

    assert(!all(flags));
    assert(any(flags));

    let mut produced: i32 = 0;

    let result = all(
        {
            each item in 0..9
            {
                produced += 1;
                yield false;
            }
        }
    );

    assert(!result && produced == 9, "a fold stops eager production");

    produced = 0;

    let any_result = any(
        {
            each item in 0..9
            {
                produced += 1;
                yield true;
            }
        }
    );

    assert(any_result && produced == 9, "an any fold stops eager production");

    let start: usize = 0;
    let end: usize = 9;
    let owned_source = start..end;

    let owned =
    {
        each item in owned_source
        {
            yield Source
            {
                value = item
            };
        }
    };

    let mut expected_owner: usize = 0;

    for value in move owned
    {
        assert(value.value == expected_owner, "consuming iteration changes production order");
        expected_owner += 1;

        if expected_owner == 5
        {
            break;
        }
    }

    assert(expected_owner == 5);
    assert_cleanup_counts(44, 9, 19);

    let mut cursor = (&values)(Iterable).iterate();

    assert(cursor(Iterator).next() matches ?0);
    assert(cursor(Iterator).next() matches ?1);

    let shared =
    {
        each item in 0..9
        {
            yield item;
        }
    };

    assert(count_cursor(make_cursor(&shared)) == 9);
    assert(count_cursor(make_cursor(shared)) == 9);
}

func verify_nested_generator_cleanup()
{
    let before = core.atomic.load<usize, 1>(&SOURCES);

    {
        let empty: [Source; 0] = [
            each item in 0..0
            {
                yield Source
                {
                    value = 1
                };
            }
        ];

        let nested =
        {
            each outer in 0..3
            {
                yield
                {
                    each inner in 0..2
                    {
                        yield Source
                        {
                            value = 1
                        };
                    }
                };
            }
        };

        for inner in move nested
        {
            for value in move inner
            {
                break;
            }

            break;
        }
    }

    assert(
        core.atomic.load<usize, 1>(&SOURCES) == before + 6,
        "nested consuming iteration loses an initialized prefix"
    );

    {
        let partial =
        {
            each item in 0..8
            {
                if item == 3
                {
                    break;
                }

                yield Source
                {
                    value = 1
                };
            }
        };
    }

    assert(core.atomic.load<usize, 1>(&SOURCES) == before + 9, "early production exit loses an initialized prefix");
}

trusted func verify_denied_generator_growth(pos completed: usize)
    uses(foreign_call)
{
    let before: usize = core.atomic.load<usize, 1>(&SOURCES);
    let mut allocation_state: u32 = 0;
    let start: usize = 0;
    let end: usize = 8;
    let source = start..end;

    _ = catch
    {
        let values =
        {
            each item in source
            {
                let value = Source
                {
                    value = item
                };

                if item == completed
                {
                    allocation_state = trusted deny_allocation();
                }

                yield value;
            }
        };

        yield unit;
    };

    let attempts = trusted restore_allocation(allocation_state);

    assert(attempts > 0, "generator growth did not reach the denied allocator");

    assert(
        core.atomic.load<usize, 1>(&SOURCES) == before + completed + 1,
        "denied growth lost a committed element or unresolved yielded owner"
    );
}

func count_cursor<I>(pos mut cursor: I) -> usize
    with(I: Iterator)
{
    let mut count: usize = 0;

    loop
    {
        let value = cursor(Iterator).next();

        if value matches none
        {
            break;
        }

        count += 1;
    }

    return count;
}

func make_cursor<S>(pos source: S) -> S(Iterable).Cursor
    with(S: Iterable)
{
    return source(Iterable).iterate();
}

predicate all_generated(count: i32) = all(
    {
        each item in 0..count
        {
            yield if item == 0
            {
                yield true;
            }
            else
            {
                yield item < count;
            };
        }
    }
);

predicate any_generated(count: i32) = any(
    {
        each item in 0..count
        {
            yield item > 0;
        }
    }
);

const func complete_production(pos flag: bool) -> bool
{
    let mut finished: bool = false;

    let values =
    {
        each item in 0..3
        {
            yield false;
            finished = item == 2;
            yield flag;
        }
    };

    return finished && !all(values) && (any(values) == flag);
}

const func complete_default(
    pos count: i32,
    complete: bool = all(
        {
            each item in 0..count
            {
                yield item < count;
            }
        }
    )
) -> bool
    {
        return complete;
    }

    func verify_generator_predicates(pos count: i32)
        requires(count >= 0, all_generated(count = count), complete_production(count > 0), complete_default(count))
    {
        if count > 1
        {
            verify_positive_generator(count);
        }
    }

    func observed_count() -> i32
    {
        return 3;
    }

    func verify_positive_generator(pos count: i32)
        requires(any_generated(count = count)) {}
