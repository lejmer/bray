module std.bytes;

func main() -> Result<unit, std.memory.MemoryLayoutError>
{
    let first: u8 = 1;
    let second: u8 = 2;
    let third: u8 = 3;
    let bytes: [u8; 3] = [first, second, third];
    let copied: Buffer = try Buffer.from_slice(&bytes[..]);
    let values: &[u8] = as_slice(&copied);

    assert(length(&copied) == 3);
    assert(values[0] == 1);
    assert(values[1] == 2);
    assert(values[2] == 3);

    let different: [u8; 3] = [first, second, first];
    let shorter: [u8; 2] = [first, second];

    assert(equals(values, &bytes[..]));
    assert(!equals(values, &different[..]));
    assert(!equals(values, &shorter[..]));

    return Ok(unit);
}
