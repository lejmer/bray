@link(name = "bray_allocation_probe")
trusted module ordinary_finalization;

@abi(c)
@symbol(name = "bray_allocation_probe_begin")
extern trusted func deny_allocation() -> u32
    uses(foreign_call);

@abi(c)
@symbol(name = "bray_allocation_probe_end")
extern trusted func restore_allocation(pos before: u32) -> u32
    uses(foreign_call);

using std.task;

internal static COUNT: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

internal static ALLOCATIONS: core.atomic.Atomic<u32> = core.atomic.initialize<u32>(0);

internal static ERRORS: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

async func record()
{
    await std.task.yield_now();

    let previous = core.atomic.load<usize, 1>(&COUNT);

    core.atomic.store<usize, 4>(&COUNT, previous + 1);
}

struct Owner
{
    value: usize;

    async finalize()
    {
        await record();
    }
}

func rejected() -> usize
{
    panic("later input");
}

async func accept(pos owner: Owner, number: usize = rejected()) {}

async func completed() -> Owner
{
    return Owner
    {
        value = 3
    };
}

async func ordinary()
{
    let mut owner = Owner
    {
        value = 1
    };

    owner = Owner
    {
        value = 2
    };

    let result = await completed();

    let _ = catch
    {
        await accept(
            Owner
            {
                value = 4
            }
        );

        yield unit;
    };
}

async func child(pos owner: Owner) -> [u64; 1024]
{
    panic("inactive body entered");
}

async func inactive()
{
    let mut pending = child(
        Owner
        {
            value = 5
        }
    );

    pending = child(
        Owner
        {
            value = 6
        }
    );

    child(
        Owner
        {
            value = 7
        }
    );
}

@layout(stable, align = 2048)
struct Failure
{
    value: u64;

    finalize()
    {
        panic("retained error must abandon finalization");
    }

    destruct()
    {
        assert(self.value == 17, "retained error payload changed");
        assert(core.atomic.load<usize, 1>(&ERRORS) == 1, "error destroyed before its owner or more than once");
        core.atomic.store<usize, 4>(&ERRORS, 2);
    }
}

struct FailingOwner
{
    async finalize() -> Result<unit, Failure>
    {
        await std.task.yield_now();

        return Error(
            Failure
            {
                value = 17
            }
        );
    }

    destruct()
    {
        assert(core.atomic.load<usize, 1>(&ERRORS) == 0, "failed owner destroyed more than once");
        core.atomic.store<usize, 4>(&ERRORS, 1);
    }
}

trusted async func fail()
    uses(foreign_call)
{
    let owner = FailingOwner
    {
    };

    core.atomic.store<u32, 4>(&ALLOCATIONS, trusted deny_allocation());
    panic("");
}

trusted async func handle_failure()
{
    let _ = catch
    {
        await trusted fail();
        yield unit;
    };
}

trusted async func main()
    uses(foreign_call)
{
    await ordinary();
    assert(core.atomic.load<usize, 1>(&COUNT) == 4, "ordinary ownership ends did not finalize exactly once");

    await inactive();
    assert(core.atomic.load<usize, 1>(&COUNT) == 7, "inactive captures did not finalize exactly once");

    await trusted handle_failure();

    let attempts = trusted restore_allocation(core.atomic.load<u32, 1>(&ALLOCATIONS));

    assert(attempts == 0, "mandatory cleanup requested fresh backing after admission");
    assert(core.atomic.load<usize, 1>(&ERRORS) == 2, "retained error was not destroyed");
}
