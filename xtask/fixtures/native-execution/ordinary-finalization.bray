@link(name = "bray_allocation_probe")
trusted module ordinary_finalization;

using core.atomic;

@abi(c)
@symbol(name = "bray_allocation_probe_begin")
extern trusted func deny_allocation() -> u32
    uses(foreign_call);

@abi(c)
@symbol(name = "bray_allocation_probe_end")
extern trusted func restore_allocation(pos before: u32) -> u32
    uses(foreign_call);

using std.memory;
using std.task;

internal static COUNT: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

internal static ALLOCATIONS: core.atomic.Atomic<u32> = core.atomic.initialize<u32>(0);

internal static ERRORS: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

async func record()
{
    await std.task.yield_now();

    let previous = core.atomic.load<usize, 1>(&COUNT);

    core.atomic.store<usize, 4>(&COUNT, previous + 1);
}

struct Owner
{
    value: usize;

    async finalize()
    {
        await record();
    }
}

func rejected() -> usize
{
    panic("later input");
}

async func accept(pos owner: Owner, number: usize = rejected()) {}

async func completed() -> Owner
{
    return Owner
    {
        value = 3
    };
}

async func ordinary()
{
    let mut owner = Owner
    {
        value = 1
    };

    owner = Owner
    {
        value = 2
    };

    let result = await completed();

    _ = catch
    {
        await accept(
            Owner
            {
                value = 4
            }
        );

        yield unit;
    };
}

struct OptionalOwner
{
    first: Owner?;
    second: usize;
}

async func partial()
{
    _ = catch
    {
        let owner = OptionalOwner
        {
            first = Owner
            {
                value = 8
            },
            second = rejected()
        };

        yield unit;
    };
}

async func child(pos owner: Owner) -> [u64; 1024]
{
    panic("inactive body entered");
}

async func inactive()
{
    let mut pending = child(
        Owner
        {
            value = 5
        }
    );

    pending = child(
        Owner
        {
            value = 6
        }
    );

    _ = child(
        Owner
        {
            value = 7
        }
    );
}

struct RetainedCapture
{
    destruct()
    {
        let errors = core.atomic.load<usize, 1>(&ERRORS);

        assert(errors == 2, "capture destroyed before its retained error or more than once");
        core.atomic.store<usize, 4>(&ERRORS, 3);
    }
}

async func retained_body(pos capture: RetainedCapture)
{
    panic("quiescence entered an inactive body");
}

@layout(stable, align = 2048)
struct Failure
{
    value: u64;
    pending: Future<unit>;

    finalize()
    {
        panic("retained error must abandon finalization");
    }

    destruct()
    {
        assert(self.value == 17, "retained error payload changed");
        assert(core.atomic.load<usize, 1>(&ERRORS) == 1, "error destroyed before its owner or more than once");
        core.atomic.store<usize, 4>(&ERRORS, 2);
    }
}

struct FailingOwner
{
    mut pending: Future<unit>?;

    async finalize() -> Result<unit, Failure>
    {
        await std.task.yield_now();

        let stored: Future<unit>? = std.memory.replace_value(&mut self.pending, none);

        match consume stored
        {
            case ?pending
            {
                return Error(
                    Failure
                    {
                        value = 17,
                        pending = pending
                    }
                );
            }
            case none { panic("finalizer consumed its prepared capture twice"); }
        }
    }

    destruct()
    {
        assert(core.atomic.load<usize, 1>(&ERRORS) == 0, "failed owner destroyed more than once");
        core.atomic.store<usize, 4>(&ERRORS, 1);
    }
}

trusted async func fail()
    uses(foreign_call)
{
    let owner = FailingOwner
    {
        pending = retained_body(
            RetainedCapture
            {
            }
        )
    };

    core.atomic.store<u32, 4>(&ALLOCATIONS, trusted deny_allocation());
    panic("");
}

trusted async func handle_failure()
{
    _ = catch
    {
        await trusted fail();
        yield unit;
    };
}

internal static BUFFER_FINALIZATIONS: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

internal static BUFFER_DESTRUCTIONS: core.atomic.Atomic<usize> = core.atomic.initialize<usize>(0);

struct BufferOwner
{
    digit: usize;

    async finalize()
    {
        // Suspend in the admitted finalizer frame without constructing a new future.
        internal std.task.yield_current_task();

        let previous = core.atomic.load<usize, 1>(&BUFFER_FINALIZATIONS);

        core.atomic.store<usize, 4>(&BUFFER_FINALIZATIONS, previous * 10 + self.digit);
    }

    destruct()
    {
        let previous = core.atomic.load<usize, 1>(&BUFFER_DESTRUCTIONS);

        core.atomic.store<usize, 4>(&BUFFER_DESTRUCTIONS, previous * 10 + self.digit);
    }
}

struct FirstAdmissionOwner
{
    async finalize()
    {
        internal std.task.yield_current_task();
    }
}

async func reject_generator_admission()
{
    _ = catch
    {
        let owners =
        {
            each item in 0..0
            {
                yield FirstAdmissionOwner
                {
                };
            }
        };

        yield unit;
    };
}

trusted async func represented_buffer()
    uses(foreign_call, raw_memory, unchecked_init)
{
    let mut owners: std.memory.RawBuffer<BufferOwner> = match trusted std.memory.RawBuffer<BufferOwner>(capacity = 4)
    {
        case Ok(value) { yield value; }
        case Error(_) { panic("buffer layout"); }
    };

    trusted internal std.memory.raw_buffer_push<BufferOwner>(
        &mut owners,
        BufferOwner
        {
            digit = 1
        }
    );

    trusted internal std.memory.raw_buffer_push<BufferOwner>(
        &mut owners,
        BufferOwner
        {
            digit = 2
        }
    );

    trusted internal std.memory.raw_buffer_push<BufferOwner>(
        &mut owners,
        BufferOwner
        {
            digit = 3
        }
    );

    // Only the initialized prefix is owned; its three child allowances are already secured.
    core.atomic.store<u32, 4>(&ALLOCATIONS, trusted deny_allocation());
}

trusted async func main()
    uses(foreign_call)
{
    await ordinary();
    assert(core.atomic.load<usize, 1>(&COUNT) == 4, "ordinary ownership ends did not finalize exactly once");

    await partial();
    assert(core.atomic.load<usize, 1>(&COUNT) == 5, "converted partial input did not finalize exactly once");

    await inactive();
    assert(core.atomic.load<usize, 1>(&COUNT) == 8, "inactive captures did not finalize exactly once");

    await trusted handle_failure();

    let attempts = trusted restore_allocation(core.atomic.load<u32, 1>(&ALLOCATIONS));

    assert(attempts == 0, "mandatory cleanup requested fresh backing after admission");
    assert(core.atomic.load<usize, 1>(&ERRORS) == 3, "retained error and its inactive capture were not destroyed");

    // The future is admitted before denial; the empty generator's distinct
    // element type has not registered its local cleanup storage yet.
    let initial = reject_generator_admission();

    core.atomic.store<u32, 4>(&ALLOCATIONS, trusted deny_allocation());
    await initial;

    let initial_attempts = trusted restore_allocation(core.atomic.load<u32, 1>(&ALLOCATIONS));

    assert(initial_attempts > 0, "initial generator admission did not encounter denied allocation");

    await trusted represented_buffer();

    let buffer_attempts = trusted restore_allocation(core.atomic.load<u32, 1>(&ALLOCATIONS));

    assert(buffer_attempts == 0, "represented cleanup requested fresh backing after admission");

    assert(
        core.atomic.load<usize, 1>(&BUFFER_FINALIZATIONS) == 321,
        "buffer finalization order or initialized prefix is invalid"
    );

    assert(
        core.atomic.load<usize, 1>(&BUFFER_DESTRUCTIONS) == 321,
        "buffer destruction did not resolve each initialized element once"
    );

    core.atomic.store<usize, 4>(&BUFFER_FINALIZATIONS, 0);
    core.atomic.store<usize, 4>(&BUFFER_DESTRUCTIONS, 0);
    await trusted represented_generator();
    assert(trusted restore_allocation(core.atomic.load<u32, 1>(&ALLOCATIONS)) == 0);
    assert(core.atomic.load<usize, 1>(&BUFFER_FINALIZATIONS) == 987654321);
    assert(core.atomic.load<usize, 1>(&BUFFER_DESTRUCTIONS) == 987654321);

    core.atomic.store<usize, 4>(&BUFFER_FINALIZATIONS, 0);
    core.atomic.store<usize, 4>(&BUFFER_DESTRUCTIONS, 0);
    await trusted partial_generator();
    assert(trusted restore_allocation(core.atomic.load<u32, 1>(&ALLOCATIONS)) == 0);
    assert(core.atomic.load<usize, 1>(&BUFFER_FINALIZATIONS) == 21);
    assert(core.atomic.load<usize, 1>(&BUFFER_DESTRUCTIONS) == 21);

    core.atomic.store<usize, 4>(&BUFFER_FINALIZATIONS, 0);
    core.atomic.store<usize, 4>(&BUFFER_DESTRUCTIONS, 0);
    await trusted failed_generator_growth();
    assert(trusted restore_allocation(core.atomic.load<u32, 1>(&ALLOCATIONS)) > 0);
    assert(core.atomic.load<usize, 1>(&BUFFER_FINALIZATIONS) == 54321);
    assert(core.atomic.load<usize, 1>(&BUFFER_DESTRUCTIONS) == 54321);

    core.atomic.store<usize, 4>(&BUFFER_FINALIZATIONS, 0);
    core.atomic.store<usize, 4>(&BUFFER_DESTRUCTIONS, 0);
    await trusted consumed_generator();
    assert(trusted restore_allocation(core.atomic.load<u32, 1>(&ALLOCATIONS)) == 0);
    assert(core.atomic.load<usize, 1>(&BUFFER_FINALIZATIONS) == 123);
    assert(core.atomic.load<usize, 1>(&BUFFER_DESTRUCTIONS) == 123);

    core.atomic.store<usize, 4>(&BUFFER_FINALIZATIONS, 0);
    core.atomic.store<usize, 4>(&BUFFER_DESTRUCTIONS, 0);
    await trusted generator_iteration_result();
    assert(trusted restore_allocation(core.atomic.load<u32, 1>(&ALLOCATIONS)) == 0);
    assert(core.atomic.load<usize, 1>(&BUFFER_FINALIZATIONS) == 231);
    assert(core.atomic.load<usize, 1>(&BUFFER_DESTRUCTIONS) == 231);

    core.atomic.store<usize, 4>(&ERRORS, 0);
    await trusted generator_failure();
    assert(trusted restore_allocation(core.atomic.load<u32, 1>(&ALLOCATIONS)) == 0);

    assert(
        core.atomic.load<usize, 1>(&ERRORS) == 3,
        "generator finalization lost a retained error or inactive capture"
    );
}

trusted async func represented_generator()
    uses(foreign_call)
{
    let start: usize = 1;
    let end: usize = 10;
    let source = start..end;

    let owners =
    {
        each digit in source
        {
            yield BufferOwner
            {
                digit = digit
            };
        }
    };

    core.atomic.store<u32, 4>(&ALLOCATIONS, trusted deny_allocation());
}

trusted async func partial_generator()
    uses(foreign_call)
{
    let start: usize = 1;
    let end: usize = 4;
    let source = start..end;

    _ = catch
    {
        let owners =
        {
            each digit in source
            {
                if digit == 3
                {
                    core.atomic.store<u32, 4>(&ALLOCATIONS, trusted deny_allocation());
                    panic("");
                }

                yield BufferOwner
                {
                    digit = digit
                };
            }
        };

        yield unit;
    };
}

trusted async func failed_generator_growth()
    uses(foreign_call)
{
    let start: usize = 1;
    let end: usize = 6;
    let source = start..end;

    _ = catch
    {
        let owners =
        {
            each digit in source
            {
                let owner = BufferOwner
                {
                    digit = digit
                };

                if digit == 5
                {
                    core.atomic.store<u32, 4>(&ALLOCATIONS, trusted deny_allocation());
                }

                yield owner;
            }
        };

        yield unit;
    };
}

trusted async func generator_failure()
    uses(foreign_call)
{
    _ = catch
    {
        let owners =
        {
            each item in 0..1
            {
                yield FailingOwner
                {
                    pending = retained_body(
                        RetainedCapture
                        {
                        }
                    )
                };
            }
        };

        core.atomic.store<u32, 4>(&ALLOCATIONS, trusted deny_allocation());
        panic("");
        yield unit;
    };
}

trusted async func consumed_generator()
    uses(foreign_call)
{
    let start: usize = 1;
    let end: usize = 4;
    let source = start..end;

    let owners =
    {
        each digit in source
        {
            yield BufferOwner
            {
                digit = digit
            };
        }
    };

    core.atomic.store<u32, 4>(&ALLOCATIONS, trusted deny_allocation());

    for owner in move owners
    {
        if owner.digit == 2
        {
            break;
        }
    }

    assert(core.atomic.load<usize, 1>(&BUFFER_FINALIZATIONS) == 123);
    assert(core.atomic.load<usize, 1>(&BUFFER_DESTRUCTIONS) == 123);
}

trusted async func generator_iteration_result()
    uses(foreign_call)
{
    let start: usize = 1;
    let end: usize = 4;
    let source = start..end;

    let owners =
    {
        each digit in source
        {
            yield BufferOwner
            {
                digit = digit
            };
        }
    };

    core.atomic.store<u32, 4>(&ALLOCATIONS, trusted deny_allocation());

    let owner: BufferOwner = for item in move owners
    {
        break item;
    }
    else
    {
        panic("");
    };

    assert(owner.digit == 1);
    assert(core.atomic.load<usize, 1>(&BUFFER_FINALIZATIONS) == 23);
    assert(core.atomic.load<usize, 1>(&BUFFER_DESTRUCTIONS) == 23);
}
