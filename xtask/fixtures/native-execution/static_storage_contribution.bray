module static_storage_execution;

static SHARED_ALIAS: &i32 = &SHARED_COUNTER;

func contribution_counter_value() -> i32
{
    return SHARED_COUNTER;
}

func thread_cleanup_value() -> i32
{
    return ASYNC_THREAD_CLEANUP_PROBE.state;
}

func thread_answer_value() -> i32
{
    return THREAD_ANSWER;
}

func contribution_counter_alias() -> &i32
{
    return SHARED_ALIAS;
}

func contribution_generic_counter<const N: i32>() -> i32
{
    return GENERIC_VALUE<N>;
}

@abi(c)
@symbol(name = "bray_provider_probe_read")
func provider_probe_read(pos value: i32) -> i32
{
    return value + SHARED_COUNTER - 42;
}
