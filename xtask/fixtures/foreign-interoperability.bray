@link(name = "bray_foreign_fixture")
module interoperability;

using std.dynamic;
using std.ffi;
using std.ffi.c;
using std.memory;
using std.path;
using std.testing;

__TARGET_HANDLE_AUDIT__

@copy
@layout(c)
struct NativeRecord
{
    narrow: i8;
    unsigned_narrow: u8;
    signed_value: i32;
    wide: u64;
}

@symbol(name = "bray_foreign_counter")
extern trusted static FOREIGN_COUNTER: i32;

@symbol(name = "bray_exported_value")
static EXPORTED_VALUE: i32 = 41;

@symbol(name = "bray_foreign_read_exported_value")
@abi(c)
extern trusted func native_read_exported_value() -> i32
    uses(foreign_call);

@symbol(name = "bray_foreign_read_counter")
@abi(c)
extern trusted func native_read_counter(pos value: RawPointer<i32>) -> i32
    uses(foreign_call);

@symbol(name = "bray_foreign_sum_variadic")
@abi(c)
extern trusted func native_sum_variadic(pos count: i32, ...) -> i32
    uses(foreign_call);

@symbol(name = "bray_foreign_transform_record")
@abi(c)
extern trusted func transform_record(pos value: NativeRecord) -> NativeRecord
    uses(foreign_call);

@symbol(name = "bray_foreign_validate_record")
@abi(c)
extern trusted func validate_record(pos value: NativeRecord) -> i32
    uses(foreign_call);

@symbol(name = "bray_foreign_record_size")
@abi(c)
extern trusted func native_record_size() -> u64
    uses(foreign_call);

@symbol(name = "bray_foreign_record_alignment")
@abi(c)
extern trusted func native_record_alignment() -> u64
    uses(foreign_call);

@symbol(name = "bray_foreign_narrow_length")
@abi(c)
extern trusted func native_narrow_length(pos value: RawPointer<u8>) -> u64
    uses(foreign_call);

@symbol(name = "bray_foreign_wide_length")
@abi(c)
extern trusted func native_wide_length(pos value: RawPointer<std.ffi.c.WideChar>) -> u64
    uses(foreign_call);

@symbol(name = "bray_foreign_resource_acquire")
@abi(c)
extern trusted func native_resource_acquire(pos succeed: bool) -> u64
    uses(foreign_call);

@symbol(name = "bray_foreign_resource_duplicate")
@abi(c)
extern trusted func native_resource_duplicate(pos handle: u64) -> u64
    uses(foreign_call);

@symbol(name = "bray_foreign_resource_release")
@abi(c)
extern trusted func native_resource_release(pos handle: u64, fail: bool) -> i32
    uses(foreign_call);

@symbol(name = "bray_foreign_resource_live_count")
@abi(c)
extern trusted func native_resource_live_count() -> u64
    uses(foreign_call);

@copy
union NativeResourceError
{
    Invalid;
    Release;
}

struct NativeResource
{
    internal handle_value: u64;
    internal mut is_owned_value: bool;

    trusted construct(pos succeed: bool) -> Result<Self, NativeResourceError>
        uses(foreign_call)
    {
        let handle: u64 = trusted native_resource_acquire(succeed);

        if handle == 0
        {
            return Error(NativeResourceError.Invalid);
        }

        return Ok(
            {
                handle_value = handle,
                is_owned_value = true,
            }
        );
    }

    trusted finalize() -> Result<unit, NativeResourceError>
    {
        return trusted release_native_resource(&mut self, fail = false);
    }

    trusted destruct()
        uses(foreign_call)
    {
        if self.is_owned_value
        {
            let _: i32 = trusted native_resource_release(self.handle_value, fail = false);
        }
    }

    func is_owned() -> bool
    {
        return self.is_owned_value;
    }

    func handle() -> &u64
    {
        return &self.handle_value;
    }

    trusted func duplicate() -> Result<NativeResource, NativeResourceError>
        uses(foreign_call)
    {
        let handle: u64 = trusted native_resource_duplicate(self.handle_value);

        if handle == 0
        {
            return Error(NativeResourceError.Invalid);
        }

        return Ok(
            {
                handle_value = handle,
                is_owned_value = true,
            }
        );
    }

    trusted consume mut func transfer() -> Result<u64, NativeResourceError>
    {
        if !self.is_owned_value
        {
            return Error(NativeResourceError.Invalid);
        }

        self.is_owned_value = false;

        return Ok(self.handle_value);
    }

    trusted consume mut func close(pos fail: bool) -> Result<unit, NativeResourceError>
    {
        return trusted release_native_resource(&mut self, fail = fail);
    }
}

trusted func release_native_resource(
    pos resource: &mut NativeResource,
    pos fail: bool,
) -> Result<unit, NativeResourceError>
    uses(foreign_call)
{
    if !resource.is_owned_value
    {
        return Error(NativeResourceError.Invalid);
    }

    let status: i32 = trusted native_resource_release(resource.handle_value, fail = fail);

    if status != 0
    {
        return Error(NativeResourceError.Release);
    }

    resource.is_owned_value = false;

    return Ok(unit);
}

@symbol(name = "bray_foreign_invoke_plain")
@abi(c)
extern trusted func native_invoke_plain(
    pos callback: @abi(c)
    trusted func(pos value: i32) -> i32,
    pos value: i32,
) -> i32
    uses(foreign_call);

@symbol(name = "bray_foreign_invoke")
@abi(c)
extern trusted func native_invoke(
    pos callback: @abi(c)
    trusted func(pos context: RawPointer<i32>, pos value: i32) -> i32
        uses(raw_memory),
    pos context: RawPointer<i32>,
    pos value: i32,
) -> i32
    uses(foreign_call);

@symbol(name = "bray_foreign_invoke_on_thread")
@abi(c)
extern trusted func native_invoke_on_thread(
    pos callback: @abi(c)
    trusted func(pos context: RawPointer<i32>, pos value: i32) -> i32
        uses(raw_memory),
    pos context: RawPointer<i32>,
    pos value: i32,
) -> i32
    uses(foreign_call);

@symbol(name = "bray_foreign_invoke_concurrently")
@abi(c)
extern trusted func native_invoke_concurrently(
    pos callback: @abi(c)
    trusted func(pos context: RawPointer<i32>, pos value: i32) -> i32
        uses(raw_memory),
    pos context: RawPointer<i32>,
    pos first_value: i32,
    pos second_value: i32,
) -> i32
    uses(foreign_call);

@symbol(name = "bray_foreign_plain_callback")
@abi(c)
trusted func plain_callback(pos value: i32) -> i32
{
    return value + 1;
}

@symbol(name = "bray_foreign_stateful_callback")
@abi(c)
trusted func stateful_callback(pos context: RawPointer<i32>, pos value: i32) -> i32
    uses(raw_memory)
{
    let state: &i32 = trusted std.ffi.callback_state<i32>(context);

    if state == 40
    {
        return value + 40;
    }

    return 0;
}

@symbol(name = "bray_foreign_invoke_reentrant")
@abi(c)
extern trusted func native_invoke_reentrant(
    pos callback: @abi(c)
    trusted func(pos context: RawPointer<i32>, pos value: i32) -> i32
        uses(foreign_call),
    pos context: RawPointer<i32>,
    pos value: i32,
) -> i32
    uses(foreign_call);

@symbol(name = "bray_foreign_reentrant_callback")
@abi(c)
trusted func reentrant_callback(pos context: RawPointer<i32>, pos value: i32) -> i32
    uses(foreign_call)
{
    if value == 0
    {
        return 1;
    }

    let entry: @abi(c)
    trusted func(pos context: RawPointer<i32>, pos value: i32) -> i32
        uses(foreign_call) = reentrant_callback;

    return trusted native_invoke_reentrant(entry, context, value = 0);
}

trusted func audit_record_calls()
    uses(foreign_call)
{
    let input: NativeRecord =
    {
        narrow = 5,
        unsigned_narrow = 7,
        signed_value = 41,
        wide = 100,
    };

    assert(trusted validate_record(input) == 1);

    let output: NativeRecord = trusted transform_record(input);

    assert(output.narrow == 4);
    assert(output.unsigned_narrow == 8);
    assert(output.signed_value == 43);
    assert(output.wide == 103);
    assert(trusted native_record_size() == std.memory.size_of<NativeRecord>() as u64);
    assert(trusted native_record_alignment() == std.memory.align_of<NativeRecord>() as u64);
}

trusted func audit_strings()
    uses(foreign_call)
{
    let narrow_bytes: bytes = b"bray";

    let narrow: std.ffi.c.OwnedNarrowString = std.testing.assert_ok<
        std.ffi.c.OwnedNarrowString,
        std.ffi.c.StringError
    >(trusted std.ffi.c.OwnedNarrowString.from_bytes(&narrow_bytes[..]));

    assert(trusted native_narrow_length(narrow.as_borrowed().pointer()) == 4);

    let wide_units: [std.ffi.c.WideChar; 4] = [
        std.ffi.c.wide_char_wrapping(98),
        std.ffi.c.wide_char_wrapping(114),
        std.ffi.c.wide_char_wrapping(97),
        std.ffi.c.wide_char_wrapping(121),
    ];

    let wide: std.ffi.c.OwnedWideString = std.testing.assert_ok<
        std.ffi.c.OwnedWideString,
        std.ffi.c.StringError
    >(trusted std.ffi.c.OwnedWideString.from_units(&wide_units[..]));

    assert(trusted native_wide_length(wide.as_borrowed().pointer()) == 4);
}

trusted func audit_resources()
    uses(foreign_call)
{
    assert(trusted native_resource_live_count() == 0);

    match std.testing.assert_error<NativeResource, NativeResourceError>(trusted NativeResource(succeed = false))
    {
        case NativeResourceError.Invalid {}
        case _ { assert(false); }
    }

    let mut owner: NativeResource = std.testing.assert_ok<NativeResource, NativeResourceError>(
        trusted NativeResource(succeed = true),
    );

    assert(owner.is_owned());
    assert(owner.handle() != 0);
    assert(trusted native_resource_live_count() == 1);

    let mut duplicate: NativeResource = std.testing.assert_ok<NativeResource, NativeResourceError>(
        trusted owner.duplicate(),
    );

    assert(trusted native_resource_live_count() == 2);

    let transferred: u64 = std.testing.assert_ok<u64, NativeResourceError>(trusted duplicate.transfer());

    assert(trusted native_resource_live_count() == 2);
    assert(trusted native_resource_release(transferred, fail = false) == 0);
    assert(trusted native_resource_live_count() == 1);

    {
        let mut failed: NativeResource = std.testing.assert_ok<NativeResource, NativeResourceError>(
            trusted NativeResource(succeed = true),
        );

        assert(trusted native_resource_live_count() == 2);

        let _: NativeResourceError = std.testing.assert_error<unit, NativeResourceError>(
            trusted failed.close(fail = true),
        );
    }

    assert(trusted native_resource_live_count() == 1);

    std.testing.assert_ok<unit, NativeResourceError>(trusted owner.close(fail = false));

    assert(trusted native_resource_live_count() == 0);
}

trusted func audit_callbacks()
    uses(foreign_call, manual_alloc, raw_memory, unchecked_init)
{
    let plain: @abi(c)
    trusted func(pos value: i32) -> i32 = plain_callback;

    assert(trusted native_invoke_plain(plain, 41) == 42);

    let context: std.ffi.CallbackContext<i32> = std.testing.assert_ok<
        std.ffi.CallbackContext<i32>,
        std.memory.MemoryLayoutError
    >(trusted std.ffi.CallbackContext<i32>(40));

    let entry: @abi(c)
    trusted func(pos context: RawPointer<i32>, pos value: i32) -> i32
        uses(raw_memory) = stateful_callback;

    let callback = trusted std.ffi.borrow_callback(&context, entry);

    assert(trusted native_invoke(callback.entry(), callback.context(), 2) == 42);
    assert(trusted native_invoke_on_thread(callback.entry(), callback.context(), 2) == 42);
    assert(trusted native_invoke_concurrently(callback.entry(), callback.context(), 1, 2) == 83);

    let reentrant_entry: @abi(c)
    trusted func(pos context: RawPointer<i32>, pos value: i32) -> i32
        uses(foreign_call) = reentrant_callback;

    let reentrant = trusted std.ffi.borrow_callback(&context, reentrant_entry);

    assert(trusted native_invoke_reentrant(reentrant.entry(), reentrant.context(), 1) == 1);
}

trusted func audit_dynamic_library()
    requires(blocking_execution())
    uses(foreign_call, layout_reinterpret)
{
    let path: std.path.Path = std.testing.assert_ok<std.path.Path, std.path.PathError>(
        std.path.Path.from_string(&"__SHARED_LIBRARY_PATH__"),
    );

    let mut library: std.dynamic.DynamicLibrary = std.testing.assert_ok<
        std.dynamic.DynamicLibrary,
        std.ffi.ForeignError
    >(
        std.dynamic.DynamicLibrary.open_path(&path, policy = std.dynamic.LoadPolicy.PlatformDefault),
    );

    {
        let name: bytes = b"bray_foreign_transform_record";

        let symbol: std.dynamic.DynamicSymbol<
            @abi(c)
            trusted func(pos value: NativeRecord) -> NativeRecord
        > = std.testing.assert_ok<
            std.dynamic.DynamicSymbol<
                @abi(c)
                trusted func(pos value: NativeRecord) -> NativeRecord
            >,
            std.ffi.ForeignError
        >(
            trusted library.symbol<
                @abi(c)
                trusted func(pos value: NativeRecord) -> NativeRecord
            >(&name[..]),
        );

        let _: &std.dynamic.DynamicLibrary = symbol.library();
    }

    {
        let missing_name: bytes = b"bray_missing_fixture";

        let error: std.ffi.ForeignError = std.testing.assert_error<
            std.dynamic.DynamicSymbol<u8>,
            std.ffi.ForeignError
        >(trusted library.symbol<u8>(&missing_name[..]));

        match error.kind()
        {
            case std.ffi.ForeignErrorKind.UnavailableSymbol {}
            case _ { assert(false); }
        }
    }

    std.testing.assert_ok<unit, std.ffi.ForeignError>(library.close());
}

trusted func audit_native_data()
    uses(foreign_call)
{
    let signed_byte: i8 = 10;
    let unsigned_short: u16 = 12;

    assert(!std.memory.is_null<i32>(FOREIGN_COUNTER));
    assert(trusted native_read_counter(FOREIGN_COUNTER) == 40);
    assert(trusted native_read_exported_value() == 41);
    assert(trusted native_sum_variadic(3, signed_byte, unsigned_short, true) == 23);
}

trusted func main() -> i32
{
    trusted audit_target_handle();
    trusted audit_record_calls();
    trusted audit_strings();
    trusted audit_resources();
    trusted audit_callbacks();
    trusted audit_dynamic_library();
    trusted audit_native_data();

    return 0;
}
