module std.order;

trait OrderedSequence
{
    type Element;

    func order_length() -> usize;

    func compare_indices(pos left: usize, pos right: usize) -> Ordering;

    func compare_value(pos index: usize, pos value: &Element) -> Ordering;

    mut func swap_indices(pos left: usize, pos right: usize) -> unit;
}

impl OrderingEquatable = Ordering(Equatable<Ordering>)
{
    func equals(pos rhs: &Ordering) -> bool
    {
        return match self
        {
            case Ordering.Less
            {
                yield match rhs
                {
                    case Ordering.Less { yield true; }
                    case Ordering.Equal { yield false; }
                    case Ordering.Greater { yield false; }
                };
            }
            case Ordering.Equal
            {
                yield match rhs
                {
                    case Ordering.Less { yield false; }
                    case Ordering.Equal { yield true; }
                    case Ordering.Greater { yield false; }
                };
            }
            case Ordering.Greater
            {
                yield match rhs
                {
                    case Ordering.Less { yield false; }
                    case Ordering.Equal { yield false; }
                    case Ordering.Greater { yield true; }
                };
            }
        };
    }
}

func reverse(pos ordering: Ordering) -> Ordering
{
    return match ordering
    {
        case Ordering.Less { yield Ordering.Greater; }
        case Ordering.Equal { yield Ordering.Equal; }
        case Ordering.Greater { yield Ordering.Less; }
    };
}

func then(pos first: Ordering, pos second: Ordering) -> Ordering
{
    return match first
    {
        case Ordering.Less { yield Ordering.Less; }
        case Ordering.Equal { yield second; }
        case Ordering.Greater { yield Ordering.Greater; }
    };
}

func minimum<Value>(pos left: Value, pos right: Value) -> Value
    with(Value: Comparable<Value>)
{
    if left <= right
    {
        return left;
    }

    return right;
}

func maximum<Value>(pos left: Value, pos right: Value) -> Value
    with(Value: Comparable<Value>)
{
    if left >= right
    {
        return left;
    }

    return right;
}

func clamp<Value>(pos value: Value, pos minimum: Value, pos maximum: Value) -> Value
    with(Value: Comparable<Value>)
{
    if value < minimum
    {
        return minimum;
    }

    if value > maximum
    {
        return maximum;
    }

    return value;
}

func find<Sequence>(pos values: &Sequence, pos value: &Sequence(OrderedSequence).Element) -> usize?
    with(Sequence: OrderedSequence)
{
    let count: usize = values.order_length();
    let mut index: usize = 0;

    while index < count
    {
        if values.compare_value(index, value) == Ordering.Equal
        {
            let mut result: usize? = none;

            result = index;

            return result;
        }

        index = index + 1;
    }

    return none;
}

func binary_search<Sequence>(pos values: &Sequence, pos value: &Sequence(OrderedSequence).Element) -> usize?
    with(Sequence: OrderedSequence)
{
    let mut start: usize = 0;
    let mut end: usize = values.order_length();

    while start < end
    {
        let middle: usize = start + (end - start) / 2;

        match values.compare_value(middle, value)
        {
            case Ordering.Less { start = middle + 1; }
            case Ordering.Equal
            {
                let mut result: usize? = none;

                result = middle;

                return result;
            }
            case Ordering.Greater { end = middle; }
        }
    }

    return none;
}

func sort_stable<Sequence>(pos values: &mut Sequence) -> unit
    with(Sequence: OrderedSequence)
{
    let count: usize = values.order_length();
    let mut index: usize = 1;

    while index < count
    {
        let mut current: usize = index;

        while current > 0
        {
            if values.compare_indices(current - 1, current) != Ordering.Greater
            {
                break;
            }

            values.swap_indices(current - 1, current);
            current = current - 1;
        }

        index = index + 1;
    }
}

func sort_unstable<Sequence>(pos values: &mut Sequence) -> unit
    with(Sequence: OrderedSequence)
{
    let count: usize = values.order_length();
    let mut index: usize = 0;

    while index < count
    {
        let mut minimum_index: usize = index;
        let mut candidate: usize = index + 1;

        while candidate < count
        {
            if values.compare_indices(candidate, minimum_index) == Ordering.Less
            {
                minimum_index = candidate;
            }

            candidate = candidate + 1;
        }

        if minimum_index != index
        {
            values.swap_indices(index, minimum_index);
        }

        index = index + 1;
    }
}
