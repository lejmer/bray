module std.testing;

// Retain rejected owners until fail starts abnormal cleanup.

/// Returns the successful value or fails the current test when the result is an error.
func assert_ok<T, E>(pos result: Result<T, E>) -> T
    when(result matches Error(_))
    {
        ensures(false)
    }
{
    match consume result
    {
        case Ok(value) { return value; }
        case Error(error) { fail(&"expected Result.Ok"); }
    }
}

/// Returns the error value or fails the current test when the result is successful.
func assert_error<T, E>(pos result: Result<T, E>) -> E
    when(result matches Ok(_))
    {
        ensures(false)
    }
{
    match consume result
    {
        case Ok(value) { fail(&"expected Result.Error"); }
        case Error(error) { return error; }
    }
}

/// Returns the contained value or fails the current test when the nullable value is absent.
func assert_present<T>(pos value: T?) -> T
{
    match consume value
    {
        case ?present { return present; }
        case none { fail(&"expected a present nullable value"); }
    }
}

/// Fails the current test when the nullable value is present.
func assert_absent<T>(pos value: T?)
{
    match consume value
    {
        case ?present { fail(&"expected an absent nullable value"); }
        case none {}
    }
}

/// Returns the completed value or fails the current test when the run panicked or was cancelled.
func assert_completed<T>(pos result: RunResult<T>) -> T
{
    match consume result
    {
        case Completed(value) { return value; }
        case Panicked(report) { fail(&"expected RunResult.Completed"); }
        case Cancelled { fail(&"expected RunResult.Completed"); }
    }
}

/// Returns the panic report or fails the current test when the run completed or was cancelled.
func assert_panicked<T>(pos result: RunResult<T>) -> PanicReport
{
    match consume result
    {
        case Panicked(report) { return report; }
        case unexpected { fail(&"expected RunResult.Panicked"); }
    }
}

/// Fails the current test unless the run was cancelled.
func assert_cancelled<T>(pos result: RunResult<T>)
{
    match consume result
    {
        case Cancelled {}
        case unexpected { fail(&"expected RunResult.Cancelled"); }
    }
}

/// Fails the current test when the run completed successfully.
func assert_not_completed<T>(pos result: RunResult<T>)
{
    match consume result
    {
        case Completed(value) { fail(&"expected RunResult.Panicked or RunResult.Cancelled"); }
        case Panicked(_) | Cancelled {}
    }
}

extern func fail(pos message: &string) -> never;
