@target(target.platform.native_threads && target.identity.SYSTEM == "linux")
trusted module std.thread;

trusted internal func platform_set_native_thread_name(pos name: RawPointer<u8>) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.pthread_setname_np(trusted std.os.linux.pthread_self(), name = name);
}
