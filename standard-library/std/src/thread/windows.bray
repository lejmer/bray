@target(target.platform.native_threads && target.identity.SYSTEM == "windows")
trusted module std.thread;

using core.target;
using core.memory;
using std.numeric;
using std.path;
using internal std.platform;
using std.memory;
using std.os.windows;

/// Returns the current native thread's opaque platform identity.
/// Only equality comparisons are portable across targets.
trusted func current_platform_identity() -> u64
    uses(foreign_call)
{
    return trusted std.os.windows.get_current_thread_id() as u64;
}

trusted internal func platform_set_current_thread_name(pos name: &string) -> Result<unit, ThreadNameError>
    uses(foreign_call)
{
    let native: std.path.NativeText = match consume std.path.NativeText.from_string(name)
    {
        case Ok(value) { yield value; }
        case Error(std.path.PathError.MemoryLayout) { return Error(ThreadNameError.Allocation); }
        case Error(_) { return Error(ThreadNameError.Invalid); }
    };

    let bytes: &[u8] = internal std.path.native_bytes(&native);

    let terminated: std.memory.RawBuffer<u16> = match trusted internal std.platform.owned_windows_text(
        bytes,
        terminate = true,
    )
    {
        case Ok(value) { yield value; }
        case Error(_) { return Error(ThreadNameError.Allocation); }
    };

    let description: DataPointer<u16> = std.memory.pointer<u16>(&terminated);

    let status: i32 = trusted std.os.windows.set_thread_description(
        trusted std.os.windows.get_current_thread(),
        description = description,
    );

    if status < 0
    {
        return Error(
            ThreadNameError.Platform(
                {
                    code = status as i64,
                    has_code = true,
                },
            )
        );
    }

    return Ok(unit);
}

@abi(system)
trusted internal func windows_thread_entry(pos context: DataPointer<u8>) -> u32
    requires(blocking_execution(), compute_execution())
{
    trusted internal run_native_thread_start(context);

    return 0;
}

trusted internal func native_thread_entry() -> FunctionPointer<std.os.windows.BeginThreadRoutine>
    ensures(trusted core.memory.callable_address_valid<std.os.windows.BeginThreadRoutine>(pointer = result))
    uses(layout_reinterpret)
{
    let entry: std.os.windows.BeginThreadRoutine = windows_thread_entry;
    let pointer: FunctionPointer<std.os.windows.BeginThreadRoutine> = trusted std.memory.function_address(entry);

    return pointer;
}

@abi(c)
trusted internal func platform_thread_create(
    pos entry: FunctionPointer<std.os.windows.BeginThreadRoutine>,
    pos context: DataPointer<u8>,
    pos owner: DataPointer<u64>,
    pos native_error: DataPointer<i64>,
) -> std.platform.PlatformStatus
    requires(
        trusted core.memory.valid_write<u64>(pointer = owner, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = owner),
        trusted core.memory.exclusive_alias_valid<u64>(pointer = owner),
        trusted core.memory.epoch_current<u64>(pointer = owner),
        trusted core.memory.synchronized_access<u64>(pointer = owner),
        trusted core.memory.movement_stable<u64>(pointer = owner),
        trusted core.memory.finalization_pending<u64>(pointer = owner),
        trusted core.memory.valid_write<i64>(pointer = native_error, count = 1),
        trusted core.memory.aligned_for<i64>(pointer = native_error),
        trusted core.memory.exclusive_alias_valid<i64>(pointer = native_error),
        trusted core.memory.epoch_current<i64>(pointer = native_error),
        trusted core.memory.synchronized_access<i64>(pointer = native_error),
        trusted core.memory.movement_stable<i64>(pointer = native_error),
        trusted core.memory.finalization_pending<i64>(pointer = native_error),
        trusted core.memory.callable_address_valid<std.os.windows.BeginThreadRoutine>(pointer = entry),
    )
    uses(raw_memory, unchecked_init)
{
    let observed: (std.platform.PlatformStatus, u64, i64) = trusted internal prepare_thread_create(
        entry,
        context,
        owner,
        native_error,
    );

    if internal std.platform.successful_status(observed.0)
    {
        trusted std.memory.write<u64>(owner, observed.1);
    }
    else
    {
        trusted std.memory.write<i64>(native_error, observed.2);
    }

    return observed.0;
}

trusted internal func prepare_thread_create(
    pos entry: FunctionPointer<std.os.windows.BeginThreadRoutine>,
    pos context: DataPointer<u8>,
    pos owner: DataPointer<u64>,
    pos native_error: DataPointer<i64>,
) -> (std.platform.PlatformStatus, u64, i64)
    requires(
        trusted core.memory.valid_write<u64>(pointer = owner, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = owner),
        trusted core.memory.exclusive_alias_valid<u64>(pointer = owner),
        trusted core.memory.epoch_current<u64>(pointer = owner),
        trusted core.memory.synchronized_access<u64>(pointer = owner),
        trusted core.memory.movement_stable<u64>(pointer = owner),
        trusted core.memory.finalization_pending<u64>(pointer = owner),
        trusted core.memory.valid_write<i64>(pointer = native_error, count = 1),
        trusted core.memory.aligned_for<i64>(pointer = native_error),
        trusted core.memory.exclusive_alias_valid<i64>(pointer = native_error),
        trusted core.memory.epoch_current<i64>(pointer = native_error),
        trusted core.memory.synchronized_access<i64>(pointer = native_error),
        trusted core.memory.movement_stable<i64>(pointer = native_error),
        trusted core.memory.finalization_pending<i64>(pointer = native_error),
        trusted core.memory.callable_address_valid<std.os.windows.BeginThreadRoutine>(pointer = entry),
    )
    ensures(
        trusted core.memory.valid_write<u64>(pointer = owner, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = owner),
        trusted core.memory.valid_write<i64>(pointer = native_error, count = 1),
        trusted core.memory.aligned_for<i64>(pointer = native_error),
    )
    uses(foreign_call, intrinsic)
{
    let native_handle: usize = trusted std.os.windows.begin_thread_ex(
        std.memory.null<u8>(),
        stack_size = 0,
        entry = entry,
        context = context,
        creation_flags = 0,
        thread_identifier = std.memory.null<u32>(),
    );

    if native_handle == 0
    {
        let code: i32 = trusted internal std.platform.read_native_i32(trusted std.os.windows.errno_location());

        let status: std.platform.PlatformStatus = internal std.platform.windows_errno_status_from(code);

        return (status, 0, status.native_code);
    }

    let handle: DataPointer<u8> = trusted core.target.from_exposed_address<u8>(address = native_handle);

    return (internal std.platform.success_status(), trusted internal std.platform.pointer_handle(handle), 0);
}

@abi(c)
trusted internal func platform_thread_join(pos owner: u64) -> std.platform.PlatformStatus
    requires(blocking_execution())
    uses(foreign_call)
{
    let handle: DataPointer<u8> = trusted internal std.platform.handle_pointer(owner);
    let waited: u32 = trusted std.os.windows.wait_for_single_object(handle, std.os.windows.INFINITE);

    if waited != std.os.windows.WAIT_OBJECT_0
    {
        return trusted internal std.platform.windows_error_status();
    }

    if trusted std.os.windows.close_handle(handle) == 0
    {
        return trusted internal std.platform.windows_error_status();
    }

    return internal std.platform.success_status();
}

@abi(c)
trusted internal func platform_thread_detach(pos owner: u64) -> std.platform.PlatformStatus
    uses(foreign_call)
{
    let handle: DataPointer<u8> = trusted internal std.platform.handle_pointer(owner);

    if trusted std.os.windows.close_handle(handle) == 0
    {
        return trusted internal std.platform.windows_error_status();
    }

    return internal std.platform.success_status();
}

@abi(c)
trusted internal func platform_thread_storage_create(
    pos destructor: FunctionPointer<std.os.windows.ThreadStorageDestructor>,
    pos key: DataPointer<u64>,
) -> std.platform.PlatformStatus
    executes(total)
    requires(
        trusted core.memory.callable_address_valid<std.os.windows.ThreadStorageDestructor>(pointer = destructor),
        trusted core.memory.valid_write<u64>(pointer = key, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = key),
    )
    uses(raw_memory, unchecked_init)
{
    let observed: Result<u64, std.platform.PlatformStatus> = trusted internal prepare_thread_storage_create(
        destructor,
        key,
    );

    match consume observed
    {
        case Ok(native_key)
        {
            trusted std.memory.write<u64>(key, native_key);

            return internal std.platform.success_status();
        }
        case Error(status) { return status; }
    }
}

trusted internal func prepare_thread_storage_create(
    pos destructor: FunctionPointer<std.os.windows.ThreadStorageDestructor>,
    pos key: DataPointer<u64>,
) -> Result<u64, std.platform.PlatformStatus>
    executes(total)
    uses(foreign_call, layout_reinterpret)
    requires(
        trusted core.memory.callable_address_valid<std.os.windows.ThreadStorageDestructor>(pointer = destructor),
        trusted core.memory.valid_write<u64>(pointer = key, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = key),
    )
    ensures(
        trusted core.memory.valid_write<u64>(pointer = key, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = key),
    )
{
    let callback: std.os.windows.ThreadStorageDestructor = trusted std.memory.callable_from_pointer(destructor);
    let native_key: u32 = trusted std.os.windows.fls_alloc(callback);

    if native_key == std.os.windows.FLS_OUT_OF_INDEXES
    {
        return Error(trusted internal std.platform.windows_error_status());
    }

    return Ok(native_key as u64);
}

trusted internal func prepare_thread_storage_load(
    pos key: u64,
    pos value: DataPointer<DataPointer<u8>>,
) -> Result<DataPointer<u8>, std.platform.PlatformStatus>
    executes(total)
    requires(
        trusted core.memory.valid_write<DataPointer<u8>>(pointer = value, count = 1),
        trusted core.memory.aligned_for<DataPointer<u8>>(pointer = value),
    )
    uses(foreign_call)
    ensures(
        trusted core.memory.valid_write<DataPointer<u8>>(pointer = value, count = 1),
        trusted core.memory.aligned_for<DataPointer<u8>>(pointer = value),
    )
{
    if key > (std.numeric.U32_MAX as u64)
    {
        return Error(internal std.platform.invalid_input_status());
    }

    trusted std.os.windows.set_last_error(0);

    let stored: DataPointer<u8> = trusted std.os.windows.fls_get_value(std.numeric.truncate_to<u32>(key));

    if std.memory.is_null<u8>(stored) && trusted std.os.windows.get_last_error() != 0
    {
        return Error(trusted internal std.platform.windows_error_status());
    }

    return Ok(stored);
}

@abi(c)
trusted internal func platform_thread_storage_store(
    pos key: u64,
    pos value: DataPointer<u8>,
) -> std.platform.PlatformStatus
    executes(total)
    uses(foreign_call)
{
    if key > (std.numeric.U32_MAX as u64)
    {
        return internal std.platform.invalid_input_status();
    }

    if trusted std.os.windows.fls_set_value(std.numeric.truncate_to<u32>(key), value) == 0
    {
        return trusted internal std.platform.windows_error_status();
    }

    return internal std.platform.success_status();
}

@abi(c)
trusted internal func platform_thread_storage_destroy(pos key: u64) -> std.platform.PlatformStatus
    uses(foreign_call)
{
    if key > (std.numeric.U32_MAX as u64)
    {
        return internal std.platform.invalid_input_status();
    }

    if trusted std.os.windows.fls_free(std.numeric.truncate_to<u32>(key)) == 0
    {
        return trusted internal std.platform.windows_error_status();
    }

    return internal std.platform.success_status();
}
