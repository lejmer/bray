module std.iteration;

/// Provides derived consuming operations for every iterator.
trait IteratorOperations
{
    type Element;

    /// Returns the first item, or `none` when the iterator is empty.
    consume mut func first() -> Element?
        with(Self: Iterator, Self(Iterator).Element == Element)
    {
        let item: Element? = self(Iterator).next();

        return item;
    }

    /// Returns the item at the supplied zero-based position.
    consume mut func nth(index: usize) -> Element?
        with(Self: Iterator, Self(Iterator).Element == Element)
    {
        let mut current: usize = 0;

        while current < index
        {
            let skipped: Element? = self(Iterator).next();

            let _: Element = skipped?;

            current += 1;
        }

        let item: Element? = self(Iterator).next();

        return item;
    }

    /// Limits iteration to at most the supplied item count.
    consume func take(count: usize) -> Take<Self, Element>
    {
        return
        {
            source = self,
            remaining = count,
        };
    }

    /// Discards at most the supplied number of leading items.
    consume func skip(count: usize) -> Skip<Self, Element>
    {
        return
        {
            source = self,
            remaining = count,
        };
    }

    /// Pairs every item with its zero-based position.
    consume func enumerate() -> Enumerate<Self, Element>
    {
        return
        {
            source = self,
        };
    }
}

impl IteratorDefaultOperations = Source(IteratorOperations)
    with(Source: Iterator)
{
    type Element = Source(Iterator).Element;
}
