@target(target.c.CHAR == "i8")
trusted module std.ffi.c;

@copy
@layout(transparent)
/// Target-exact wrapper for C `char` when `target.c.CHAR` selects `i8`.
struct Char
{
    internal raw: i8;

    /// Returns the selected `i8` representation.
    func value() -> i8
    {
        return self.raw;
    }
}

/// Creates a C `char` wrapper from its exact `i8` representation.
const func char_exact(pos raw: i8) -> Char
{
    return
    {
        raw = raw
    };
}

/// Converts an integer to C `char` and reports `ConversionError.OutOfRange` when it does not fit.
func char_checked(pos value: i128) -> Result<Char, ConversionError>
{
    if value < std.numeric.I8_MIN as i128 || value > std.numeric.I8_MAX as i128
    {
        return Error(ConversionError.OutOfRange);
    }

    return Ok(
        {
            raw = std.truncate_to<i8>(value)
        }
    );
}

/// Converts an integer to C `char` by wrapping it to the selected `i8` representation.
func char_wrapping(pos value: i128) -> Char
{
    return
    {
        raw = std.truncate_to<i8>(value)
    };
}
