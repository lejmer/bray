@target(target.c.WCHAR == "u16" || target.c.WCHAR == "i32")
module std.ffi.c;

@copy
struct BorrowedWideString
{
    internal units_value: &[WideChar];

    /// Borrows the target-width wide units without the terminating NUL.
    func as_units() -> &[WideChar]
    {
        let count: usize = self.units_value.length();

        return &self.units_value[0..count - 1];
    }

    /// Borrows the target-width wide units including the terminating NUL.
    func as_units_with_nul() -> &[WideChar]
    {
        return self.units_value;
    }

    func pointer() -> RawPointer<WideChar>
    {
        return std.memory.address_of<WideChar>(&self.units_value[0]);
    }

    /// Interprets the target-width wide units and copies them into owned Bray text.
    ///
    /// Returns `StringError.InvalidEncoding` for an invalid UTF-16 surrogate sequence or UTF-32 scalar value. Returns
    /// `StringError.Allocation` when the Bray string cannot be allocated.
    trusted func to_string() -> Result<string, StringError>
    {
        return trusted decode_wide_string(&self);
    }
}

internal func borrow_wide_string(pos units: &[WideChar]) -> Result<BorrowedWideString, StringError>
{
    let count: usize = units.length();

    if count == 0 || !wide_unit_is_nul(&units[count - 1])
    {
        return Error(StringError.MissingTerminator);
    }

    let mut index: usize = 0;

    while index + 1 < count
    {
        if wide_unit_is_nul(&units[index])
        {
            return Error(StringError.InteriorNul);
        }

        index += 1;
    }

    return Ok(
        {
            units_value = units,
        }
    );
}

struct OwnedWideString
{
    internal storage: std.collection.List<WideChar>;

    /// Encodes Bray text as an owned NUL-terminated target C wide string.
    ///
    /// Returns `StringError.InteriorNul` when the text contains NUL and `StringError.Allocation` when the owned string
    /// cannot be allocated.
    trusted construct from_string(pos value: &string) -> Result<Self, StringError>
    {
        return trusted encode_wide_string(value);
    }

    trusted construct from_units(pos units: &[WideChar]) -> Result<Self, StringError>
    {
        if wide_contains_nul(units)
        {
            return Error(StringError.InteriorNul);
        }

        let count: usize = units.length();

        let created: Result<std.collection.List<WideChar>, std.memory.MemoryLayoutError> = trusted std.collection.List<
            WideChar
        >(capacity = count);

        let mut storage: std.collection.List<WideChar> = match consume created
        {
            case Ok(list) { yield list; }
            case Error(_) { return Error(StringError.Allocation); }
        };

        let mut index: usize = 0;

        while index < count
        {
            match trusted std.collection.push<WideChar>(&mut storage, units[index])
            {
                case Ok(_) {}
                case Error(_) { return Error(StringError.Allocation); }
            }

            index += 1;
        }

        match trusted std.collection.push<WideChar>(&mut storage, wide_char_exact(0))
        {
            case Ok(_) {}
            case Error(_) { return Error(StringError.Allocation); }
        }

        return Ok(
            {
                storage = storage,
            }
        );
    }

    /// Borrows this owned string as a NUL-terminated target C wide string.
    func as_borrowed() -> BorrowedWideString
    {
        return
        {
            units_value = self.storage.as_slice(),
        };
    }
}

internal func wide_contains_nul(pos units: &[WideChar]) -> bool
{
    let count: usize = units.length();
    let mut index: usize = 0;

    while index < count
    {
        if wide_unit_is_nul(&units[index])
        {
            return true;
        }

        index += 1;
    }

    return false;
}

internal func wide_unit_is_nul(pos value: &WideChar) -> bool
{
    return value.value() == 0;
}

trusted internal func append_wide_decoded_scalar(
    pos bytes: &mut std.bytes.Buffer,
    scalar: u32,
) -> Result<unit, StringError>
{
    let character: char = match char.from_code_point(scalar)
    {
        case ?value { yield value; }
        case none { return Error(StringError.InvalidEncoding); }
    };

    let encoding: std.character.Utf8Encoding = character.encode_utf8();

    match trusted std.bytes.append(&mut bytes, bytes = encoding.as_slice())
    {
        case Ok(_) {}
        case Error(_) { return Error(StringError.Allocation); }
    }

    return Ok(unit);
}

internal func decoded_wide_string(pos bytes: &std.bytes.Buffer) -> Result<string, StringError>
{
    match string.from_utf8(bytes.as_slice())
    {
        case Ok(value) { return Ok(value); }
        case Error(_) { return Error(StringError.InvalidEncoding); }
    }
}
