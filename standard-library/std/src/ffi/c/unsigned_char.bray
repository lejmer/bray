@target(target.c.UNSIGNED_CHAR == "u8")
module std.ffi.c;

@copy
@layout(transparent)
struct UnsignedChar
{
    internal raw: u8;

    func value() -> u8
    {
        return self.raw;
    }
}

const func unsigned_char_exact(pos raw: u8) -> UnsignedChar
{
    return
    {
        raw = raw
    };
}

func unsigned_char_checked(pos value: u128) -> Result<UnsignedChar, ConversionError>
{
    if value > std.numeric.U8_MAX as u128
    {
        return Error(ConversionError.OutOfRange);
    }

    return Ok(
        {
            raw = std.truncate_to<u8>(value)
        }
    );
}

func unsigned_char_wrapping(pos value: u128) -> UnsignedChar
{
    return
    {
        raw = std.truncate_to<u8>(value)
    };
}
