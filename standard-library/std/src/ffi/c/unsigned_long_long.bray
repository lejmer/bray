@target(target.c.UNSIGNED_LONG_LONG == "u64")
trusted module std.ffi.c;

@copy
@layout(transparent)
/// Target-exact wrapper for C `unsigned long long` when `target.c.UNSIGNED_LONG_LONG` selects `u64`.
struct UnsignedLongLong
{
    internal raw: u64;

    /// Returns the selected `u64` representation.
    func value() -> u64
    {
        return self.raw;
    }
}

/// Creates a C `unsigned long long` wrapper from its exact `u64` representation.
const func unsigned_long_long_exact(pos raw: u64) -> UnsignedLongLong
{
    return
    {
        raw = raw
    };
}

/// Converts an integer to C `unsigned long long` and reports `ConversionError.OutOfRange` when it does not fit.
func unsigned_long_long_checked(pos value: u128) -> Result<UnsignedLongLong, ConversionError>
{
    if value > std.numeric.U64_MAX as u128
    {
        return Error(ConversionError.OutOfRange);
    }

    return Ok(
        {
            raw = std.truncate_to<u64>(value)
        }
    );
}

/// Converts an integer to C `unsigned long long` by wrapping it to the selected `u64` representation.
func unsigned_long_long_wrapping(pos value: u128) -> UnsignedLongLong
{
    return
    {
        raw = std.truncate_to<u64>(value)
    };
}
