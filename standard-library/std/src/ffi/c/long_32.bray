@target(target.c.LONG == "i32")
module std.ffi.c;

@copy
@layout(transparent)
/// Target-exact wrapper for C `long` when `target.c.LONG` selects `i32`.
struct Long
{
    internal raw: i32;

    /// Returns the selected `i32` representation.
    func value() -> i32
    {
        return self.raw;
    }
}

/// Creates a C `long` wrapper from its exact `i32` representation.
const func long_exact(pos raw: i32) -> Long
{
    return
    {
        raw = raw
    };
}

/// Converts an integer to C `long` and reports `ConversionError.OutOfRange` when it does not fit.
func long_checked(pos value: i128) -> Result<Long, ConversionError>
{
    if value < std.numeric.I32_MIN as i128 || value > std.numeric.I32_MAX as i128
    {
        return Error(ConversionError.OutOfRange);
    }

    return Ok(
        {
            raw = std.truncate_to<i32>(value)
        }
    );
}

/// Converts an integer to C `long` by wrapping it to the selected `i32` representation.
func long_wrapping(pos value: i128) -> Long
{
    return
    {
        raw = std.truncate_to<i32>(value)
    };
}
