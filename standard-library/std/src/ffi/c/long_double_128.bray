@target(target.c.LONG_DOUBLE == "r128")
module std.ffi.c;

@copy
@layout(transparent)
struct LongDouble
{
    internal raw: r128;

    func value() -> r128
    {
        return self.raw;
    }
}

const func long_double_exact(pos raw: r128) -> LongDouble
{
    return
    {
        raw = raw,
    };
}
