@target(target.c.SIZE == "usize")
module std.ffi.c;

@copy
@layout(transparent)
/// Target-exact wrapper for C `size_t` when `target.c.SIZE` selects `usize`.
struct Size
{
    internal raw: usize;

    /// Returns the selected `usize` representation.
    func value() -> usize
    {
        return self.raw;
    }
}

/// Creates a C `size_t` wrapper from its exact `usize` representation.
const func size_exact(pos raw: usize) -> Size
{
    return
    {
        raw = raw
    };
}

/// Converts an integer to C `size_t` and reports `ConversionError.OutOfRange` when it does not fit.
func size_checked(pos value: u128) -> Result<Size, ConversionError>
{
    if value > std.numeric.USIZE_MAX as u128
    {
        return Error(ConversionError.OutOfRange);
    }

    return Ok(
        {
            raw = std.truncate_to<usize>(value)
        }
    );
}

/// Converts an integer to C `size_t` by wrapping it to the selected `usize` representation.
func size_wrapping(pos value: u128) -> Size
{
    return
    {
        raw = std.truncate_to<usize>(value)
    };
}
