@target(target.c.UNSIGNED_LONG == "u32")
module std.ffi.c;

@copy
@layout(transparent)
/// Target-exact wrapper for C `unsigned long` when `target.c.UNSIGNED_LONG` selects `u32`.
struct UnsignedLong
{
    internal raw: u32;

    /// Returns the selected `u32` representation.
    func value() -> u32
    {
        return self.raw;
    }
}

/// Creates a C `unsigned long` wrapper from its exact `u32` representation.
const func unsigned_long_exact(pos raw: u32) -> UnsignedLong
{
    return
    {
        raw = raw
    };
}

/// Converts an integer to C `unsigned long` and reports `ConversionError.OutOfRange` when it does not fit.
func unsigned_long_checked(pos value: u128) -> Result<UnsignedLong, ConversionError>
{
    if value > std.numeric.U32_MAX as u128
    {
        return Error(ConversionError.OutOfRange);
    }

    return Ok(
        {
            raw = std.truncate_to<u32>(value)
        }
    );
}

/// Converts an integer to C `unsigned long` by wrapping it to the selected `u32` representation.
func unsigned_long_wrapping(pos value: u128) -> UnsignedLong
{
    return
    {
        raw = std.truncate_to<u32>(value)
    };
}
