@target(target.c.UNSIGNED_LONG == "u64")
module std.ffi.c;

@copy
@layout(transparent)
struct UnsignedLong
{
    internal raw: u64;

    func value() -> u64
    {
        return self.raw;
    }
}

const func unsigned_long_exact(pos raw: u64) -> UnsignedLong
{
    return
    {
        raw = raw
    };
}

func unsigned_long_checked(pos value: u128) -> Result<UnsignedLong, ConversionError>
{
    if value > std.numeric.U64_MAX as u128
    {
        return Error(ConversionError.OutOfRange);
    }

    return Ok(
        {
            raw = std.truncate_to<u64>(value)
        }
    );
}

func unsigned_long_wrapping(pos value: u128) -> UnsignedLong
{
    return
    {
        raw = std.truncate_to<u64>(value)
    };
}
