@target(target.c.SIGNED_CHAR == "i8")
module std.ffi.c;

@copy
@layout(transparent)
struct SignedChar
{
    internal raw: i8;

    func value() -> i8
    {
        return self.raw;
    }
}

const func signed_char_exact(pos raw: i8) -> SignedChar
{
    return
    {
        raw = raw
    };
}

func signed_char_checked(pos value: i128) -> Result<SignedChar, ConversionError>
{
    if value < std.numeric.I8_MIN as i128 || value > std.numeric.I8_MAX as i128
    {
        return Error(ConversionError.OutOfRange);
    }

    return Ok(
        {
            raw = std.truncate_to<i8>(value)
        }
    );
}

func signed_char_wrapping(pos value: i128) -> SignedChar
{
    return
    {
        raw = std.truncate_to<i8>(value)
    };
}
