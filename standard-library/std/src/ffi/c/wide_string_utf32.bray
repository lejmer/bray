@target(target.c.WCHAR == "i32")
trusted module std.ffi.c;

/// Returns `StringError.InvalidEncoding` for a non-Unicode scalar value and
/// `StringError.Allocation` when the decoded Bray string cannot be allocated.
trusted internal func decode_wide_string(pos value: &BorrowedWideString) -> Result<string, StringError>
{
    let units: &[WideChar] = value.as_units();
    let count: usize = units.length();

    let mut bytes: std.bytes.Buffer = match trusted std.bytes.Buffer(capacity = count)
    {
        case Ok(buffer) { yield buffer; }
        case Error(_) { return Error(StringError.Allocation); }
    };

    let mut index: usize = 0;

    while index < count
    {
        let scalar: i32 = units[index].value();

        if scalar < 0
        {
            return Error(StringError.InvalidEncoding);
        }

        try trusted internal append_wide_decoded_scalar(&mut bytes, scalar = std.truncate_to<u32>(scalar));
        index += 1;
    }

    return internal decoded_wide_string(&bytes);
}

/// Returns `StringError.InteriorNul` when the text contains NUL and
/// `StringError.Allocation` when the owned wide string cannot be allocated.
trusted internal func encode_wide_string(pos value: &string) -> Result<OwnedWideString, StringError>
{
    let mut units: std.collection.List<WideChar> = match trusted std.collection.List<WideChar>(
        capacity = value.length(),
    )
    {
        case Ok(list) { yield list; }
        case Error(_) { return Error(StringError.Allocation); }
    };

    let mut scalars: std.string.ScalarCursor = value.characters();

    loop
    {
        let character: char = match scalars.next()
        {
            case ?next { yield next; }
            case none { break; }
        };

        let scalar: u32 = character.code_point();

        if scalar == 0
        {
            return Error(StringError.InteriorNul);
        }

        match trusted std.collection.push<WideChar>(&mut units, wide_char_wrapping(scalar as i128))
        {
            case Ok(_) {}
            case Error(_) { return Error(StringError.Allocation); }
        }
    }

    return trusted OwnedWideString.from_units(units.as_slice());
}
