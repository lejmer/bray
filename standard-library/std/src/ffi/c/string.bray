module std.ffi.c;

union StringError
{
    InteriorNul;
    MissingTerminator;
    InvalidEncoding;
    Allocation;
}

@copy
struct BorrowedNarrowString
{
    internal units: &[u8];

    func bytes() -> &[u8]
    {
        let count: usize = self.units.length();

        return &self.units[0..count - 1];
    }

    func bytes_with_nul() -> &[u8]
    {
        return self.units;
    }

    func pointer() -> RawPointer<u8>
    {
        return std.memory.address_of<u8>(&self.units[0]);
    }

    func decode_utf8() -> Result<string, StringError>
    {
        match string.from_utf8(self.bytes())
        {
            case Ok(value) { return Ok(value); }
            case Error(_) { return Error(StringError.InvalidEncoding); }
        }
    }
}

internal func borrow_narrow_string(pos units: &[u8]) -> Result<BorrowedNarrowString, StringError>
{
    let count: usize = units.length();

    if count == 0 || units[count - 1] != 0
    {
        return Error(StringError.MissingTerminator);
    }

    let mut index: usize = 0;

    while index + 1 < count
    {
        if units[index] == 0
        {
            return Error(StringError.InteriorNul);
        }

        index += 1;
    }

    return Ok(
        {
            units = units
        }
    );
}

struct OwnedNarrowString
{
    internal storage: std.bytes.Buffer;

    /// Copies bytes into an owned NUL-terminated narrow C string.
    trusted construct from_bytes(pos bytes: &[u8]) -> Result<Self, StringError>
    {
        if contains_nul(bytes)
        {
            return Error(StringError.InteriorNul);
        }

        let created: Result<std.bytes.Buffer, std.memory.MemoryLayoutError> = trusted std.bytes.Buffer.from_slice(
            bytes
        );

        let mut storage: std.bytes.Buffer = match consume created
        {
            case Ok(buffer) { yield buffer; }
            case Error(_) { return Error(StringError.Allocation); }
        };

        match trusted std.bytes.push(&mut storage, value = 0)
        {
            case Ok(_) {}
            case Error(_) { return Error(StringError.Allocation); }
        }

        return Ok(
            {
                storage = storage
            }
        );
    }

    /// Encodes UTF-8 text as an owned NUL-terminated narrow C string.
    trusted construct from_utf8(pos value: &string) -> Result<Self, StringError>
    {
        return OwnedNarrowString.from_bytes(value.as_bytes());
    }

    func borrow() -> BorrowedNarrowString
    {
        return
        {
            units = self.storage.as_slice(),
        };
    }
}

internal func contains_nul(pos bytes: &[u8]) -> bool
{
    let count: usize = bytes.length();
    let mut index: usize = 0;

    while index < count
    {
        if bytes[index] == 0
        {
            return true;
        }

        index += 1;
    }

    return false;
}
