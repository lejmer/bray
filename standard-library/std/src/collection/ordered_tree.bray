module std.collection;

union Bound<Value>
{
    Unbounded;
    Included(pos value: &Value);
    Excluded(pos value: &Value);
}

internal trait OrderedTreeItem<Key>
{
    func compare_key(pos key: &Key) -> Ordering;
}

@copy
internal union OrderedTreeSide
{
    Root;
    Left;
    Right;
}

@copy
internal struct OrderedTreeNode
{
    mut parent: usize?;
    mut left: usize?;
    mut right: usize?;
    mut height: usize;
    mut occupied: bool;
    mut next_free: usize?;
}

@copy
internal struct OrderedTreeSearch
{
    found: usize?;
    parent: usize?;
    side: OrderedTreeSide;
}

internal struct OrderedTree<Item>
{
    mut nodes: std.memory.RawBuffer<OrderedTreeNode>;
    mut items: std.memory.RawBuffer<Uninit<Item>>;
    mut root: usize?;
    mut free: usize?;
    mut count: usize;

    trusted construct(capacity: usize = 0) -> Result<Self, std.memory.MemoryLayoutError>
    {
        let nodes: std.memory.RawBuffer<OrderedTreeNode> = try trusted ordered_tree_nodes(capacity);

        let items: std.memory.RawBuffer<Uninit<Item>> = try trusted internal std.memory.uninit_buffer<Item>(
            capacity = capacity
        );

        let mut tree: OrderedTree<Item> =
        {
            nodes = nodes,
            items = items,
            root = none,
            free = none,
            count = 0,
        };

        trusted ordered_tree_rebuild_free<Item>(&mut tree);

        return Ok(tree);
    }

    trusted destruct()
    {
        trusted ordered_tree_clear<Item>(&mut self);
    }
}

internal func ordered_tree_empty_node() -> OrderedTreeNode
{
    return
    {
        parent = none,
        left = none,
        right = none,
        height = 0,
        occupied = false,
        next_free = none,
    };
}

trusted internal func ordered_tree_nodes(
    pos capacity: usize
) -> Result<std.memory.RawBuffer<OrderedTreeNode>, std.memory.MemoryLayoutError>
{
    let mut nodes: std.memory.RawBuffer<OrderedTreeNode> = try trusted std.memory.RawBuffer<OrderedTreeNode>(
        capacity = capacity
    );

    let mut initialized: usize = 0;

    while initialized < capacity
    {
        trusted internal std.memory.initialize_spare<OrderedTreeNode>(&mut nodes, ordered_tree_empty_node());

        initialized += 1;
    }

    return Ok(nodes);
}

internal func ordered_tree_length<Item>(pos tree: &OrderedTree<Item>) -> usize
{
    return tree.count;
}

internal func ordered_tree_capacity<Item>(pos tree: &OrderedTree<Item>) -> usize
{
    return std.memory.capacity<OrderedTreeNode>(&tree.nodes);
}

internal func ordered_tree_is_empty<Item>(pos tree: &OrderedTree<Item>) -> bool
{
    return tree.count == 0;
}

internal func ordered_tree_node<Item>(pos tree: &OrderedTree<Item>, index: usize) -> OrderedTreeNode
{
    let nodes: &[OrderedTreeNode] = trusted std.memory.initialized_slice<OrderedTreeNode>(&tree.nodes);

    return nodes[index];
}

trusted internal func ordered_tree_item<Item>(pos tree: &OrderedTree<Item>, index: usize) -> &Item
{
    let pointer: RawPointer<Item> = trusted ordered_tree_item_pointer(tree, index = index);

    return trusted std.memory.borrow_from<Item, OrderedTree<Item>>(tree, pointer);
}

trusted internal func ordered_tree_item_mut<Item>(pos tree: &mut OrderedTree<Item>, index: usize) -> &mut Item
{
    let pointer: RawPointer<Item> = trusted ordered_tree_item_pointer_mut(tree, index = index);

    return trusted std.memory.borrow_mut_from<Item, OrderedTree<Item>>(tree, pointer);
}

trusted internal func ordered_tree_item_pointer<Item>(pos tree: &OrderedTree<Item>, index: usize) -> RawPointer<Item>
    ensures(
        trusted core.memory.valid_read<Item>(pointer = result, count = 1),
        trusted core.memory.aligned_for<Item>(pointer = result),
        trusted core.memory.initialized_as<Item>(pointer = result),
        trusted core.memory.shared_alias_valid<Item>(pointer = result),
        trusted core.memory.epoch_current<Item>(pointer = result),
        trusted core.memory.synchronized_access<Item>(pointer = result),
        trusted core.memory.movement_stable<Item>(pointer = result),
        trusted core.memory.finalization_pending<Item>(pointer = result),
    )
{
    if !ordered_tree_node<Item>(tree, index = index).occupied
    {
        panic("ordered-tree item slot is empty");
    }

    let slots: &[Uninit<Item>] = trusted std.memory.initialized_slice<Uninit<Item>>(&tree.items);

    return std.memory.uninit_pointer<Item>(&slots[index]);
}

trusted internal func ordered_tree_item_pointer_mut<Item>(
    pos tree: &mut OrderedTree<Item>,
    index: usize
) -> RawPointer<Item>
    ensures(
        trusted core.memory.valid_write<Item>(pointer = result, count = 1),
        trusted core.memory.aligned_for<Item>(pointer = result),
        trusted core.memory.initialized_as<Item>(pointer = result),
        trusted core.memory.exclusive_alias_valid<Item>(pointer = result),
        trusted core.memory.epoch_current<Item>(pointer = result),
        trusted core.memory.synchronized_access<Item>(pointer = result),
        trusted core.memory.movement_stable<Item>(pointer = result),
        trusted core.memory.finalization_pending<Item>(pointer = result),
    )
{
    let slot: &mut Uninit<Item> = trusted ordered_tree_initialized_slot(tree, index = index);

    return std.memory.uninit_pointer_mut<Item>(slot);
}

trusted internal func ordered_tree_initialized_slot<Item>(
    pos tree: &mut OrderedTree<Item>,
    index: usize
) -> &mut Uninit<Item>
    ensures(trusted core.memory.uninit_initialized<Item>(storage = &result))
{
    if !ordered_tree_node<Item>(&tree, index = index).occupied
    {
        panic("ordered-tree item slot is empty");
    }

    let slots: &mut [Uninit<Item>] = trusted std.memory.initialized_slice_mut<Uninit<Item>>(&mut tree.items);

    return &mut slots[index];
}

trusted internal func ordered_tree_write_item<Item>(pos tree: &mut OrderedTree<Item>, pos item: Item, index: usize)
{
    if ordered_tree_node<Item>(&tree, index = index).occupied
    {
        panic("ordered-tree item slot is occupied");
    }

    let slots: &mut [Uninit<Item>] = trusted std.memory.initialized_slice_mut<Uninit<Item>>(&mut tree.items);
    let _: &mut Item = std.memory.uninit_write<Item>(&mut slots[index], item);
    let nodes: &mut [OrderedTreeNode] = trusted std.memory.initialized_slice_mut<OrderedTreeNode>(&mut tree.nodes);

    nodes[index].occupied = true;
}

trusted internal func ordered_tree_take_item<Item>(pos tree: &mut OrderedTree<Item>, index: usize) -> Item
{
    let slot: &mut Uninit<Item> = trusted ordered_tree_initialized_slot(tree, index = index);
    let item: Item = trusted std.memory.move_initialized<Item>(slot);
    let nodes: &mut [OrderedTreeNode] = trusted std.memory.initialized_slice_mut<OrderedTreeNode>(&mut tree.nodes);

    nodes[index].occupied = false;
    return item;
}

trusted internal func ordered_tree_swap_items<Item>(pos tree: &mut OrderedTree<Item>, left: usize, right: usize)
{
    if left == right
    {
        return unit;
    }

    if !ordered_tree_node<Item>(&tree, index = left).occupied || !ordered_tree_node<Item>(&tree, index = right).occupied
    {
        panic("ordered-tree swap requires two occupied slots");
    }

    let left_item: Item = trusted ordered_tree_take_item(tree, index = left);
    let right_item: Item = trusted ordered_tree_take_item(tree, index = right);

    trusted ordered_tree_write_item(tree, right_item, index = left);
    trusted ordered_tree_write_item(tree, left_item, index = right);
}
