module std.collection;

using std.numeric;
using std.memory;
using internal std.collection.slot;

const HASH_TABLE_EMPTY: usize = 0;

// Factory bucket counts divide the modulus of the retained low hash bits.
const HASH_TABLE_HASH_MASK: usize = std.numeric.USIZE_MAX >> 1;

const HASH_TABLE_OCCUPIED: usize = ~HASH_TABLE_HASH_MASK;

const HASH_TABLE_MINIMUM_BUCKETS: usize = 8;

internal struct HashTable<Item>
{
    mut buckets: std.memory.RawBuffer<usize>;
    mut items: std.memory.RawBuffer<(Item?)>;
    mut count: usize;

    trusted construct(capacity: usize = 0) -> Result<Self, std.memory.MemoryLayoutError>
    {
        let bucket_count: usize = try hash_table_bucket_count(capacity);
        let buckets = try trusted hash_table_filled_buffer<usize>(bucket_count, HASH_TABLE_EMPTY);
        let items = try trusted internal std.memory.nullable_buffer<Item>(capacity = bucket_count);

        return Ok(
            {
                buckets = buckets,
                items = items,
                count = 0
            }
        );
    }

    trusted destruct()
    {
        let mut buckets = self.buckets;
        let mut items = self.items;

        trusted hash_table_clear_storage<Item>(&mut buckets, &mut items);
    }
}

internal func hash_table_bucket_capacity(pos bucket_count: usize) -> usize
{
    return bucket_count - bucket_count / 4;
}

internal func hash_table_bucket_count(pos capacity: usize) -> Result<usize, std.memory.MemoryLayoutError>
{
    if capacity == 0
    {
        return Ok(0);
    }

    let maximum: usize = std.numeric.USIZE_MAX;
    let mut bucket_count: usize = HASH_TABLE_MINIMUM_BUCKETS;

    while hash_table_bucket_capacity(bucket_count) < capacity
    {
        if bucket_count > maximum / 2
        {
            return Error(std.memory.MemoryLayoutError.SizeOverflow);
        }

        bucket_count *= 2;
    }

    return Ok(bucket_count);
}

trusted internal func hash_table_filled_buffer<Value>(
    pos bucket_count: usize,
    pos value: Value
) -> Result<std.memory.RawBuffer<Value>, std.memory.MemoryLayoutError>
    with(Value: Copyable)
{
    let mut buffer: std.memory.RawBuffer<Value> = try trusted std.memory.RawBuffer<Value>(capacity = bucket_count);
    let mut initialized: usize = 0;

    while initialized < bucket_count
    {
        trusted internal std.memory.initialize_spare<Value>(&mut buffer, value);

        initialized += 1;
    }

    return Ok(buffer);
}

internal func hash_table_length<Item>(pos table: &HashTable<Item>) -> usize
{
    return table.count;
}

internal func hash_table_capacity<Item>(pos table: &HashTable<Item>) -> usize
{
    return hash_table_bucket_capacity(std.memory.capacity<usize>(&table.buckets));
}

internal func hash_table_is_empty<Item>(pos table: &HashTable<Item>) -> bool
{
    return table.count == 0;
}

internal func hash_table_fingerprint(pos hash: u128) -> usize
{
    return std.numeric.truncate_to<usize>(hash) & HASH_TABLE_HASH_MASK;
}

internal func hash_table_bucket_index(pos hash: usize, pos bucket_count: usize) -> usize
{
    return hash % bucket_count;
}

internal func hash_table_next(pos index: usize, pos bucket_count: usize) -> usize
{
    if index + 1 == bucket_count
    {
        return 0;
    }

    return index + 1;
}

internal func hash_table_probe_distance(pos ideal: usize, pos actual: usize, pos bucket_count: usize) -> usize
{
    if actual >= ideal
    {
        return actual - ideal;
    }

    return bucket_count - ideal + actual;
}

trusted internal func hash_table_item<Item>(pos table: &HashTable<Item>, index: usize) -> &Item
{
    return trusted internal std.collection.slot.get<Item>(&table.items, index = index);
}

trusted internal func hash_table_item_mut<Item>(pos table: &mut HashTable<Item>, index: usize) -> &mut Item
{
    return trusted internal std.collection.slot.get_mut<Item>(&mut table.items, index = index);
}

trusted internal func hash_table_hash(pos buckets: &std.memory.RawBuffer<usize>, index: usize) -> usize
    uses(raw_memory)
{
    return std.memory.initialized_slice<usize>(buckets)[index] & HASH_TABLE_HASH_MASK;
}

trusted internal func hash_table_occupied(pos buckets: &std.memory.RawBuffer<usize>, index: usize) -> bool
    uses(raw_memory)
{
    return (std.memory.initialized_slice<usize>(buckets)[index] & HASH_TABLE_OCCUPIED) != 0;
}

trusted internal func hash_table_write<Item>(pos table: &mut HashTable<Item>, pos item: Item, hash: usize, index: usize)
    uses(raw_memory)
{
    assert(!trusted hash_table_occupied(&table.buckets, index = index), "hash-table item slot is occupied");
    trusted internal std.collection.slot.write<Item>(&mut table.items, item, index = index);

    let values: &mut [usize] = trusted std.memory.initialized_slice_mut<usize>(&mut table.buckets);

    values[index] = (hash & HASH_TABLE_HASH_MASK) | HASH_TABLE_OCCUPIED;
}

trusted internal func hash_table_take<Item>(pos table: &mut HashTable<Item>, index: usize) -> Item
{
    return trusted hash_table_take_storage<Item>(&mut table.buckets, &mut table.items, index = index);
}

trusted internal func hash_table_take_storage<Item>(
    pos buckets: &mut std.memory.RawBuffer<usize>,
    pos items: &mut std.memory.RawBuffer<(Item?)>,
    index: usize
) -> Item
    uses(raw_memory)
{
    let value = trusted internal std.collection.slot.take<Item>(items, index = index);
    let values: &mut [usize] = trusted std.memory.initialized_slice_mut<usize>(buckets);

    values[index] = HASH_TABLE_EMPTY;

    return value;
}

trusted internal func hash_table_transfer_at<Item>(
    pos source: &mut HashTable<Item>,
    pos destination: &mut HashTable<Item>,
    index: usize
)
{
    let hash = trusted hash_table_hash(&source.buckets, index = index);
    let item = trusted hash_table_take<Item>(&mut source, index = index);
    let _: usize = trusted hash_table_insert_available<Item>(&mut destination, item, hash = hash);
}

trusted internal func hash_table_find_hash<Item>(pos table: &HashTable<Item>, pos after: usize?, hash: usize) -> usize?
    uses(raw_memory)
{
    let bucket_count: usize = std.memory.capacity<usize>(&table.buckets);

    if bucket_count == 0
    {
        return none;
    }

    let buckets: &[usize] = trusted std.memory.initialized_slice<usize>(&table.buckets);

    let mut index: usize = match after
    {
        case ?index { yield hash_table_next(index, bucket_count); }
        case none { yield hash_table_bucket_index(hash, bucket_count); }
    };

    let mut examined: usize = 0;

    while examined < bucket_count
    {
        if (buckets[index] & HASH_TABLE_OCCUPIED) == 0
        {
            return none;
        }

        if (buckets[index] & HASH_TABLE_HASH_MASK) == hash
        {
            let mut result: usize? = none;

            result = index;

            return result;
        }

        index = hash_table_next(index, bucket_count);
        examined += 1;
    }

    return none;
}

trusted internal func hash_table_insert_available<Item>(
    pos table: &mut HashTable<Item>,
    pos item: Item,
    hash: usize
) -> usize
{
    let bucket_count: usize = std.memory.capacity<usize>(&table.buckets);
    let mut index: usize = hash_table_bucket_index(hash, bucket_count);

    while true
    {
        let available: bool = !trusted hash_table_occupied(&table.buckets, index = index);

        if available
        {
            trusted hash_table_write<Item>(&mut table, item, hash = hash, index = index);
            table.count += 1;

            return index;
        }

        index = hash_table_next(index, bucket_count);
    }
}

trusted internal func hash_table_reserve<Item>(
    pos table: &mut HashTable<Item>,
    additional: usize
) -> Result<unit, std.memory.MemoryLayoutError>
{
    let maximum: usize = std.numeric.USIZE_MAX;

    if additional > maximum - table.count
    {
        return Error(std.memory.MemoryLayoutError.SizeOverflow);
    }

    let required: usize = table.count + additional;

    if required <= hash_table_capacity<Item>(&table)
    {
        return Ok(unit);
    }

    let bucket_count: usize = try hash_table_bucket_count(required);

    try trusted hash_table_reallocate<Item>(&mut table, bucket_count = bucket_count);

    return Ok(unit);
}

trusted internal func hash_table_reallocate<Item>(
    pos table: &mut HashTable<Item>,
    bucket_count: usize
) -> Result<unit, std.memory.MemoryLayoutError>
    uses(manual_alloc)
{
    let requested_capacity: usize = hash_table_bucket_capacity(bucket_count);
    let mut replacement: HashTable<Item> = try trusted HashTable<Item>(capacity = requested_capacity);
    let source_bucket_count: usize = std.memory.capacity<usize>(&table.buckets);
    let mut index: usize = 0;

    while index < source_bucket_count
    {
        let occupied: bool = trusted hash_table_occupied(&table.buckets, index = index);

        if occupied
        {
            trusted hash_table_transfer_at<Item>(&mut table, &mut replacement, index = index);
        }

        index += 1;
    }

    table.count = 0;

    trusted internal std.memory.raw_buffer_replace<usize>(
        destination = &mut table.buckets,
        source = &mut replacement.buckets,
    );

    trusted internal std.memory.raw_buffer_replace<(Item?)>(
        destination = &mut table.items,
        source = &mut replacement.items,
    );

    table.count = replacement.count;
    replacement.count = 0;

    return Ok(unit);
}

trusted internal func hash_table_remove_at<Item>(pos table: &mut HashTable<Item>, index: usize) -> Item
{
    let removed: Item = trusted hash_table_take<Item>(&mut table, index = index);

    trusted hash_table_close_hole<Item>(&mut table, hole = index);

    return removed;
}

trusted internal func hash_table_close_hole<Item>(pos table: &mut HashTable<Item>, hole: usize)
{
    let bucket_count: usize = std.memory.capacity<usize>(&table.buckets);
    let mut open: usize = hole;
    let mut current: usize = hash_table_next(hole, bucket_count);

    while true
    {
        let occupied: bool = trusted hash_table_occupied(&table.buckets, index = current);

        if !occupied
        {
            break;
        }

        let item_hash = trusted hash_table_hash(&table.buckets, index = current);

        let ideal: usize = hash_table_bucket_index(item_hash, bucket_count);

        let current_distance: usize = hash_table_probe_distance(ideal, current, bucket_count);
        let hole_distance: usize = hash_table_probe_distance(ideal, open, bucket_count);

        if current_distance > hole_distance
        {
            let item: Item = trusted hash_table_take<Item>(&mut table, index = current);

            trusted hash_table_write<Item>(&mut table, item, hash = item_hash, index = open);

            open = current;
        }

        current = hash_table_next(current, bucket_count);
    }

    table.count -= 1;
}

trusted internal func hash_table_clear<Item>(pos table: &mut HashTable<Item>)
{
    trusted hash_table_clear_storage<Item>(&mut table.buckets, &mut table.items);

    table.count = 0;
}

trusted internal func hash_table_clear_storage<Item>(
    pos buckets: &mut std.memory.RawBuffer<usize>,
    pos items: &mut std.memory.RawBuffer<(Item?)>
)
{
    let bucket_count = std.memory.capacity<usize>(&buckets);
    let mut index: usize = 0;

    while index < bucket_count
    {
        if trusted hash_table_occupied(&buckets, index = index)
        {
            let _: Item = trusted hash_table_take_storage<Item>(buckets, items, index = index);
        }

        index += 1;
    }
}
