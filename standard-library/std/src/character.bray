module std.character;

struct Utf8Encoding
{
    internal bytes: [u8; 4];
    internal length: usize;

    func as_slice() -> &[u8]
    {
        return &self.bytes[0..self.length];
    }
}

impl char
{
    func code_point() -> u32
    {
        return internal scalar_value(self);
    }

    static func from_code_point(pos value: u32) -> char?
    {
        return internal from_scalar_value(value);
    }

    func encode_utf8() -> Utf8Encoding
    {
        let length: usize = internal utf8_length(self);
        let mut bytes: [u8; 4] = [0; 4];
        let mut index: usize = 0;

        while index < length
        {
            bytes[index] = internal utf8_byte(self, index = index);
            index += 1;
        }

        return Utf8Encoding
        {
            bytes = bytes,
            length = length,
        };
    }

    func is_alphabetic() -> bool
    {
        return internal alphabetic(self);
    }

    func is_numeric() -> bool
    {
        return internal numeric(self);
    }

    func is_whitespace() -> bool
    {
        return internal whitespace(self);
    }
}

extern internal func scalar_value(pos value: char) -> u32;

extern internal func from_scalar_value(pos value: u32) -> char?;

extern internal func utf8_length(pos value: char) -> usize;

extern internal func utf8_byte(pos value: char, index: usize) -> u8;

extern internal func alphabetic(pos value: char) -> bool;

extern internal func numeric(pos value: char) -> bool;

extern internal func whitespace(pos value: char) -> bool;

internal func utf16_units(pos scalar: u32) -> (u16, u16?)
{
    if scalar < 65_536
    {
        return (std.truncate_to<u16>(scalar), none);
    }

    let supplementary: u32 = scalar - 65_536;
    let first: u16 = std.truncate_to<u16>(55_296 + (supplementary >> 10));
    let second: u16 = std.truncate_to<u16>(56_320 + (supplementary & 1_023));
    let mut optional_second: u16? = none;

    optional_second = second;

    return (first, optional_second);
}

internal func utf16_scalar(pos first: u16, second: u16?) -> (u32, bool)?
{
    let first_value: u32 = first as u32;

    if first_value >= 55_296 && first_value <= 56_319
    {
        let second_value: u32 = match second
        {
            case ?value { yield value as u32; }
            case none { return none; }
        };

        if second_value < 56_320 || second_value > 57_343
        {
            return none;
        }

        let scalar: u32 = 65_536 + ((first_value - 55_296) << 10) + (second_value - 56_320);

        let decoded_value: (u32, bool) = (scalar, true);
        let mut decoded: (u32, bool)? = none;

        decoded = decoded_value;

        return decoded;
    }

    if first_value >= 56_320 && first_value <= 57_343
    {
        return none;
    }

    let decoded_value: (u32, bool) = (first_value, false);
    let mut decoded: (u32, bool)? = none;

    decoded = decoded_value;

    return decoded;
}
