module std.memory;

extern func address_of<T>(pos value: &T) -> RawPointer<T>;

extern func address_of_mut<T>(pos value: &mut T) -> RawPointer<T>;

extern func null<T>() -> RawPointer<T>;

extern func is_null<T>(pos pointer: RawPointer<T>) -> bool;

extern func offset<T>(pos pointer: RawPointer<T>, elements: isize) -> RawPointer<T>;

extern func byte_offset<T>(pos pointer: RawPointer<T>, bytes: isize) -> RawPointer<T>;

extern trusted func reinterpret<Target, Source>(pos pointer: RawPointer<Source>) -> RawPointer<Target>
    uses(layout_reinterpret);

extern trusted func read<T>(pos pointer: RawPointer<T>) -> T
    requires(
        trusted core.memory.valid_read<T>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<T>(pointer = pointer),
        trusted core.memory.initialized_as<T>(pointer = pointer),
    )
    uses(raw_memory);

extern trusted func write<T>(pos pointer: RawPointer<T>, pos value: T) -> unit
    requires(
        trusted core.memory.valid_write<T>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<T>(pointer = pointer),
    )
    ensures(trusted core.memory.initialized_as<T>(pointer = pointer))
    uses(raw_memory, unchecked_init);

extern trusted func copy<T>(pos source: RawPointer<T>, pos destination: RawPointer<T>, count: usize) -> unit
    requires(
        trusted core.memory.valid_read<T>(pointer = source, count = count),
        trusted core.memory.valid_write<T>(pointer = destination, count = count),
        trusted core.memory.initialized_range_as<T>(pointer = source, count = count),
        trusted core.memory.non_overlapping<T>(
            left = source,
            left_count = count,
            right = destination,
            right_count = count,
        ),
    )
    ensures(trusted core.memory.initialized_range_as<T>(pointer = destination, count = count))
    uses(raw_memory, unchecked_init);

extern trusted func copy_overlapping<T>(pos source: RawPointer<T>, pos destination: RawPointer<T>, count: usize) -> unit
    requires(
        trusted core.memory.valid_read<T>(pointer = source, count = count),
        trusted core.memory.valid_write<T>(pointer = destination, count = count),
        trusted core.memory.initialized_range_as<T>(pointer = source, count = count),
    )
    ensures(trusted core.memory.initialized_range_as<T>(pointer = destination, count = count))
    uses(raw_memory, unchecked_init);

extern func uninit<T>() -> Uninit<T>;

extern func uninit_pointer<T>(pos storage: &Uninit<T>) -> RawPointer<T>;

extern func uninit_pointer_mut<T>(pos storage: &mut Uninit<T>) -> RawPointer<T>;

extern func uninit_write<T>(pos storage: &mut Uninit<T>, pos value: T) -> &mut T
    ensures(trusted core.memory.uninit_initialized<T>(storage = storage));

extern trusted func assume_initialized<T>(pos mut storage: Uninit<T>) -> T
    requires(trusted core.memory.uninit_initialized<T>(storage = &mut storage))
    uses(unchecked_init);

extern trusted func move_initialized<T>(pos storage: &mut Uninit<T>) -> T
    requires(trusted core.memory.uninit_initialized<T>(storage = storage))
    uses(unchecked_init);

trusted func destroy_initialized<T>(pos storage: &mut Uninit<T>) -> unit
    requires(trusted core.memory.uninit_initialized<T>(storage = storage))
{
    let _: T = trusted move_initialized<T>(storage);
}

extern trusted func borrow_from<T, Owner>(pos owner: &Owner, pos pointer: RawPointer<T>) -> &T
    requires(
        trusted core.memory.valid_read<T>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<T>(pointer = pointer),
        trusted core.memory.initialized_as<T>(pointer = pointer),
        trusted core.memory.shared_alias_valid<T>(pointer = pointer),
        trusted core.memory.epoch_current<T>(pointer = pointer),
        trusted core.memory.synchronized_access<T>(pointer = pointer),
        trusted core.memory.movement_stable<T>(pointer = pointer),
        trusted core.memory.finalization_pending<T>(pointer = pointer),
    )
    uses(raw_memory, unchecked_alias);

extern trusted func borrow_mut_from<T, Capability>(
    pos capability: &mut Capability,
    pos pointer: RawPointer<T>,
) -> &mut T
    requires(
        trusted core.memory.valid_write<T>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<T>(pointer = pointer),
        trusted core.memory.initialized_as<T>(pointer = pointer),
        trusted core.memory.exclusive_alias_valid<T>(pointer = pointer),
        trusted core.memory.epoch_current<T>(pointer = pointer),
        trusted core.memory.synchronized_access<T>(pointer = pointer),
        trusted core.memory.movement_stable<T>(pointer = pointer),
        trusted core.memory.finalization_pending<T>(pointer = pointer),
    )
    uses(raw_memory, unchecked_alias);

struct Output<T>
{
    mut storage: Uninit<T>;

    construct() -> Self
    {
        return
        {
            storage = uninit<T>(),
        };
    }

    consume mut func write(pos value: T) -> T
    {
        let _: &mut T = uninit_write<T>(&mut self.storage, value);

        return trusted assume_initialized<T>(self.storage);
    }

    trusted mut func pointer() -> RawPointer<T>
    {
        return uninit_pointer_mut<T>(&mut self.storage);
    }

    trusted consume mut func into_value() -> T
        requires(trusted core.memory.uninit_initialized<T>(storage = &mut self.storage))
    {
        return trusted assume_initialized<T>(self.storage);
    }
}

struct InPlace<T>
{
    internal storage: &mut Uninit<T>;

    mut func write(pos value: T) -> &mut T
    {
        return uninit_write<T>(self.storage, value);
    }

    trusted mut func pointer() -> RawPointer<T>
    {
        return uninit_pointer_mut<T>(self.storage);
    }
}

func in_place<T>(pos storage: &mut Uninit<T>) -> InPlace<T>
{
    return
    {
        storage = storage,
    };
}

@copy
struct AnchoredView<T, Owner>
{
    internal owner: &Owner;
    internal value: &T;

    func get() -> &T
    {
        return self.value;
    }
}

trusted func anchored_view<T, Owner>(pos owner: &Owner, pos pointer: RawPointer<T>) -> AnchoredView<T, Owner>
    requires(
        trusted core.memory.valid_read<T>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<T>(pointer = pointer),
        trusted core.memory.initialized_as<T>(pointer = pointer),
        trusted core.memory.shared_alias_valid<T>(pointer = pointer),
        trusted core.memory.epoch_current<T>(pointer = pointer),
        trusted core.memory.synchronized_access<T>(pointer = pointer),
        trusted core.memory.movement_stable<T>(pointer = pointer),
        trusted core.memory.finalization_pending<T>(pointer = pointer),
    )
{
    let value: &T = trusted borrow_from<T, Owner>(owner, pointer);

    return
    {
        owner = owner,
        value = value,
    };
}

struct AnchoredViewMut<T, Capability>
{
    internal value: &mut T;

    mut func get() -> &mut T
    {
        return self.value;
    }
}

trusted func anchored_view_mut<T, Capability>(
    pos capability: &mut Capability,
    pos pointer: RawPointer<T>,
) -> AnchoredViewMut<T, Capability>
    requires(
        trusted core.memory.valid_write<T>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<T>(pointer = pointer),
        trusted core.memory.initialized_as<T>(pointer = pointer),
        trusted core.memory.exclusive_alias_valid<T>(pointer = pointer),
        trusted core.memory.epoch_current<T>(pointer = pointer),
        trusted core.memory.synchronized_access<T>(pointer = pointer),
        trusted core.memory.movement_stable<T>(pointer = pointer),
        trusted core.memory.finalization_pending<T>(pointer = pointer),
    )
{
    let value: &mut T = trusted borrow_mut_from<T, Capability>(capability, pointer);

    return
    {
        value = value,
    };
}

struct MemoryLayout
{
    bytes: usize;
    align: usize;
}

union MemoryLayoutError
{
    SizeOverflow;
    UnsupportedAlignment;
}

extern const func size_of<T>() -> usize;

extern const func align_of<T>() -> usize;

extern const func stride_of<T>() -> usize;

extern const func layout_of<T>(count: usize) -> Result<MemoryLayout, MemoryLayoutError>;

@copy
internal union CapacityGrowth
{
    Amortized;
    Exact;
}

internal func growth_capacity(
    pos current_length: usize,
    pos current_capacity: usize,
    additional: usize,
    growth: CapacityGrowth,
) -> Result<usize, MemoryLayoutError>
{
    let maximum: usize = ~0;

    if additional > maximum - current_length
    {
        return Error(MemoryLayoutError.SizeOverflow);
    }

    let required: usize = current_length + additional;

    match growth
    {
        case CapacityGrowth.Exact { return Ok(required); }
        case CapacityGrowth.Amortized {}
    }

    let mut candidate: usize = current_capacity;

    if candidate < 4
    {
        candidate = 4;
    }

    while candidate < required
    {
        if candidate > maximum - candidate
        {
            return Ok(required);
        }

        candidate += candidate;
    }

    return Ok(candidate);
}

struct RawAllocation
{
    pointer: RawPointer<u8>;
    bytes: usize;
    align: usize;

    trusted destruct()
    {
        trusted deallocate(self);
    }
}

extern trusted func allocate(pos layout: MemoryLayout) -> RawAllocation
    ensures(
        trusted core.memory.owned_allocation(pointer = result.pointer, bytes = result.bytes, align = result.align),
        trusted core.memory.valid_write<u8>(pointer = result.pointer, count = result.bytes),
    )
    uses(manual_alloc);

extern trusted func deallocate(pos allocation: RawAllocation) -> unit
    uses(manual_alloc);

struct RawBuffer<T>
{
    pointer: RawPointer<T>;
    capacity: usize;
    initialized: usize;

    trusted construct(capacity: usize) -> Result<Self, MemoryLayoutError>
        uses(manual_alloc, layout_reinterpret)
    {
        if capacity == 0
        {
            let empty_pointer: RawPointer<T> = null<T>();

            let buffer: RawBuffer<T> =
            {
                pointer = empty_pointer,
                capacity = capacity,
                initialized = 0,
            };

            return Ok(buffer);
        }

        if size_of<T>() == 1 && align_of<T>() == 1
        {
            let buffer: RawBuffer<T> = trusted internal allocate_buffer<T>(
                capacity = capacity,
                bytes = capacity,
                align = 1,
            );

            return Ok(buffer);
        }

        let layout: MemoryLayout = try layout_of<T>(count = capacity);

        let buffer: RawBuffer<T> = trusted internal allocate_buffer<T>(
            capacity = capacity,
            bytes = layout.bytes,
            align = layout.align,
        );

        return Ok(buffer);
    }

    trusted destruct()
    {
        trusted raw_buffer_release<T>(&mut self);
    }
}

trusted internal func allocate_buffer<T>(capacity: usize, bytes: usize, align: usize) -> RawBuffer<T>
    uses(manual_alloc)
{
    let allocation_pointer: RawPointer<u8> = trusted core.memory.allocate(bytes = bytes, align = align);
    let storage_pointer: RawPointer<T> = trusted reinterpret<T, u8>(allocation_pointer);

    return
    {
        pointer = storage_pointer,
        capacity = capacity,
        initialized = 0,
    };
}

extern func capacity<T>(pos buffer: &RawBuffer<T>) -> usize;

extern func initialized_count<T>(pos buffer: &RawBuffer<T>) -> usize;

extern func pointer<T>(pos buffer: &RawBuffer<T>) -> RawPointer<T>;

extern trusted func initialized_slice<T>(pos buffer: &RawBuffer<T>) -> &[T]
    uses(raw_memory);

extern trusted func initialized_slice_mut<T>(pos buffer: &mut RawBuffer<T>) -> &mut [T]
    uses(raw_memory);

extern trusted func spare_pointer<T>(pos buffer: &mut RawBuffer<T>) -> RawPointer<T>
    ensures(
        trusted core.memory.valid_write<T>(pointer = result, count = buffer.capacity - buffer.initialized),
        trusted core.memory.aligned_for<T>(pointer = result),
    )
    uses(raw_memory);

extern trusted func set_initialized_count<T>(pos buffer: &mut RawBuffer<T>, count: usize) -> unit
    requires(
        count <= buffer.capacity,
        trusted core.memory.initialized_range_as<T>(pointer = buffer.pointer, count = count),
    )
    ensures(buffer.initialized == count)
    uses(unchecked_init);

extern trusted internal func raw_buffer_release<T>(pos buffer: &mut RawBuffer<T>) -> unit
    uses(manual_alloc);

extern trusted internal func raw_buffer_replace<T>(
    pos destination: &mut RawBuffer<T>,
    pos source: &mut RawBuffer<T>,
) -> unit
    uses(manual_alloc);

extern trusted internal func raw_buffer_relocate<T>(
    pos source: &mut RawBuffer<T>,
    pos destination: &mut RawBuffer<T>,
) -> unit
    requires(
        destination.initialized == 0,
        source.initialized <= destination.capacity,
        trusted core.memory.non_overlapping<T>(
            left = source.pointer,
            left_count = source.initialized,
            right = destination.pointer,
            right_count = source.initialized,
        ),
    )
    uses(raw_memory, unchecked_init);

trusted internal func reserve_raw_buffer<T>(
    pos buffer: &mut RawBuffer<T>,
    additional: usize,
    growth: CapacityGrowth,
) -> Result<unit, MemoryLayoutError>
{
    let current_length: usize = buffer.initialized;

    if additional <= buffer.capacity - current_length
    {
        return Ok(unit);
    }

    let replacement_capacity: usize = try growth_capacity(
        current_length = current_length,
        current_capacity = buffer.capacity,
        additional = additional,
        growth = growth,
    );

    let mut replacement_bytes: usize = replacement_capacity;
    let mut replacement_align: usize = 1;

    if size_of<T>() != 1 || align_of<T>() != 1
    {
        let layout: MemoryLayout = try layout_of<T>(count = replacement_capacity);

        replacement_bytes = layout.bytes;
        replacement_align = layout.align;
    }

    let mut replacement: RawBuffer<T> = trusted internal allocate_buffer<T>(
        capacity = replacement_capacity,
        bytes = replacement_bytes,
        align = replacement_align,
    );

    trusted raw_buffer_relocate<T>(source = &mut buffer, destination = &mut replacement);
    trusted raw_buffer_replace<T>(destination = &mut buffer, source = &mut replacement);

    return Ok(unit);
}

trusted internal func grow_byte_buffer(pos buffer: &mut RawBuffer<u8>) -> Result<unit, MemoryLayoutError>
{
    return trusted internal reserve_raw_buffer<u8>(buffer = buffer, additional = 1, growth = CapacityGrowth.Amortized);
}

extern trusted internal func byte_buffer_fill(pos destination: RawPointer<u8>, value: u8, count: usize) -> unit
    uses(raw_memory, unchecked_init);

extern trusted internal func byte_slice_copy(pos source: &[u8], pos destination: RawPointer<u8>) -> unit
    uses(raw_memory, unchecked_init);

extern trusted internal func byte_buffer_read(pos pointer: RawPointer<u8>, index: usize) -> u8
    uses(raw_memory);

extern internal func slice_length<T>(pos values: &[T]) -> usize;

internal func byte_slice_pointer(pos bytes: &[u8]) -> RawPointer<u8>
{
    if slice_length<u8>(bytes) == 0
    {
        return null<u8>();
    }

    return address_of<u8>(&bytes[0]);
}

internal func byte_slice_pointer_mut(pos bytes: &mut [u8]) -> RawPointer<u8>
{
    let is_empty: bool =
    {
        let shared: &[u8] = &bytes;

        yield slice_length<u8>(shared) == 0;
    };

    if is_empty
    {
        return null<u8>();
    }

    return address_of_mut<u8>(&mut bytes[0]);
}
