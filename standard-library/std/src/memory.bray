module std.memory;

extern func address_of<T>(pos value: &T) -> RawPointer<T>
    ensures(
        trusted core.memory.valid_read<T>(pointer = result, count = 1),
        trusted core.memory.aligned_for<T>(pointer = result),
        trusted core.memory.initialized_as<T>(pointer = result),
        trusted core.memory.shared_alias_valid<T>(pointer = result),
        trusted core.memory.epoch_current<T>(pointer = result),
        trusted core.memory.synchronized_access<T>(pointer = result),
        trusted core.memory.movement_stable<T>(pointer = result),
        trusted core.memory.finalization_pending<T>(pointer = result),
    );

extern func address_of_mut<T>(pos value: &mut T) -> RawPointer<T>
    ensures(
        trusted core.memory.valid_read<T>(pointer = result, count = 1),
        trusted core.memory.valid_write<T>(pointer = result, count = 1),
        trusted core.memory.aligned_for<T>(pointer = result),
        trusted core.memory.initialized_as<T>(pointer = result),
        trusted core.memory.exclusive_alias_valid<T>(pointer = result),
        trusted core.memory.epoch_current<T>(pointer = result),
        trusted core.memory.synchronized_access<T>(pointer = result),
        trusted core.memory.movement_stable<T>(pointer = result),
        trusted core.memory.finalization_pending<T>(pointer = result),
    );

extern func null<T>() -> RawPointer<T>;

extern func is_null<T>(pos pointer: RawPointer<T>) -> bool;

extern func offset<T>(pos pointer: RawPointer<T>, elements: isize) -> RawPointer<T>;

extern func byte_offset<T>(pos pointer: RawPointer<T>, bytes: isize) -> RawPointer<T>;

extern trusted func reinterpret<Target, Source>(pos pointer: RawPointer<Source>) -> RawPointer<Target>
    uses(layout_reinterpret);

extern trusted func callable_from_pointer<F>(pos pointer: RawPointer<F>) -> F
    requires(trusted core.memory.callable_address_valid<F>(pointer = pointer))
    uses(layout_reinterpret);

extern trusted func pointer_from_callable<F>(pos value: F) -> RawPointer<F>
    ensures(trusted core.memory.callable_address_valid<F>(pointer = result))
    uses(layout_reinterpret);

extern trusted func read<T>(pos pointer: RawPointer<T>) -> T
    requires(
        trusted core.memory.valid_read<T>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<T>(pointer = pointer),
        trusted core.memory.initialized_as<T>(pointer = pointer),
    )
    uses(raw_memory);

extern trusted func write<T>(pos pointer: RawPointer<T>, pos value: T) -> unit
    requires(
        trusted core.memory.valid_write<T>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<T>(pointer = pointer),
    )
    ensures(trusted core.memory.initialized_as<T>(pointer = pointer))
    uses(raw_memory, unchecked_init);

extern trusted func copy<T>(pos source: RawPointer<T>, pos destination: RawPointer<T>, count: usize) -> unit
    requires(
        trusted core.memory.valid_read<T>(pointer = source, count = count),
        trusted core.memory.valid_write<T>(pointer = destination, count = count),
        trusted core.memory.initialized_range_as<T>(pointer = source, count = count),
        trusted core.memory.non_overlapping<T>(
            left = source,
            left_count = count,
            right = destination,
            right_count = count,
        ),
    )
    ensures(trusted core.memory.initialized_range_as<T>(pointer = destination, count = count))
    uses(raw_memory, unchecked_init);

extern trusted func copy_overlapping<T>(pos source: RawPointer<T>, pos destination: RawPointer<T>, count: usize) -> unit
    requires(
        trusted core.memory.valid_read<T>(pointer = source, count = count),
        trusted core.memory.valid_write<T>(pointer = destination, count = count),
        trusted core.memory.initialized_range_as<T>(pointer = source, count = count),
    )
    ensures(trusted core.memory.initialized_range_as<T>(pointer = destination, count = count))
    uses(raw_memory, unchecked_init);

trusted func replace_value<T>(pos storage: &mut T, pos value: T) -> T
{
    let value_pointer: RawPointer<T> = address_of_mut<T>(storage);
    let previous: T = trusted read<T>(value_pointer);

    trusted write<T>(value_pointer, value);

    return previous;
}

extern const func uninit<T>() -> Uninit<T>;

extern func uninit_pointer<T>(pos storage: &Uninit<T>) -> RawPointer<T>
    executes(pure, total);

extern func uninit_pointer_mut<T>(pos storage: &mut Uninit<T>) -> RawPointer<T>
    executes(pure, total);

extern func uninit_write<T>(pos storage: &mut Uninit<T>, pos value: T) -> &mut T
    ensures(trusted core.memory.uninit_initialized<T>(storage = &storage));

extern trusted func assume_initialized<T>(pos mut storage: Uninit<T>) -> T
    requires(trusted core.memory.uninit_initialized<T>(storage = &storage))
    uses(unchecked_init);

extern trusted func move_initialized<T>(pos storage: &mut Uninit<T>) -> T
    requires(trusted core.memory.uninit_initialized<T>(storage = &storage))
    uses(unchecked_init);

trusted func destroy_initialized<T>(pos storage: &mut Uninit<T>) -> unit
    requires(trusted core.memory.uninit_initialized<T>(storage = &storage))
{
    let _: T = trusted move_initialized<T>(storage);
}

extern trusted func borrow_from<T, Owner>(pos owner: &Owner, pos pointer: RawPointer<T>) -> &T
    requires(
        trusted core.memory.valid_read<T>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<T>(pointer = pointer),
        trusted core.memory.initialized_as<T>(pointer = pointer),
        trusted core.memory.shared_alias_valid<T>(pointer = pointer),
        trusted core.memory.epoch_current<T>(pointer = pointer),
        trusted core.memory.synchronized_access<T>(pointer = pointer),
        trusted core.memory.movement_stable<T>(pointer = pointer),
        trusted core.memory.finalization_pending<T>(pointer = pointer),
    )
    executes(pure, total)
    uses(raw_memory, unchecked_alias);

extern trusted func borrow_mut_from<T, Capability>(
    pos capability: &mut Capability,
    pos pointer: RawPointer<T>,
) -> &mut T
    requires(
        trusted core.memory.valid_write<T>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<T>(pointer = pointer),
        trusted core.memory.initialized_as<T>(pointer = pointer),
        trusted core.memory.exclusive_alias_valid<T>(pointer = pointer),
        trusted core.memory.epoch_current<T>(pointer = pointer),
        trusted core.memory.synchronized_access<T>(pointer = pointer),
        trusted core.memory.movement_stable<T>(pointer = pointer),
        trusted core.memory.finalization_pending<T>(pointer = pointer),
    )
    executes(pure, total)
    uses(raw_memory, unchecked_alias);

struct Output<T>
{
    mut storage: Uninit<T>;

    construct() -> Self
    {
        return
        {
            storage = uninit<T>(),
        };
    }

    consume mut func write(pos value: T) -> T
    {
        let _: &mut T = uninit_write<T>(&mut self.storage, value);

        return trusted assume_initialized<T>(self.storage);
    }

    trusted mut func pointer() -> RawPointer<T>
    {
        return uninit_pointer_mut<T>(&mut self.storage);
    }

    trusted consume mut func into_value() -> T
        requires(trusted core.memory.uninit_initialized<T>(storage = &self.storage))
    {
        return trusted assume_initialized<T>(self.storage);
    }
}

struct InPlace<T>
{
    internal storage: &mut Uninit<T>;

    mut func write(pos value: T) -> &mut T
    {
        return uninit_write<T>(self.storage, value);
    }

    trusted mut func pointer() -> RawPointer<T>
    {
        return uninit_pointer_mut<T>(self.storage);
    }
}

func in_place<T>(pos storage: &mut Uninit<T>) -> InPlace<T>
{
    return
    {
        storage = storage,
    };
}

@copy
struct AnchoredView<T, Owner>
{
    internal owner: &Owner;
    internal value: &T;

    func get() -> &T
    {
        return self.value;
    }
}

trusted func anchored_view<T, Owner>(pos owner: &Owner, pos pointer: RawPointer<T>) -> AnchoredView<T, Owner>
    requires(
        trusted core.memory.valid_read<T>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<T>(pointer = pointer),
        trusted core.memory.initialized_as<T>(pointer = pointer),
        trusted core.memory.shared_alias_valid<T>(pointer = pointer),
        trusted core.memory.epoch_current<T>(pointer = pointer),
        trusted core.memory.synchronized_access<T>(pointer = pointer),
        trusted core.memory.movement_stable<T>(pointer = pointer),
        trusted core.memory.finalization_pending<T>(pointer = pointer),
    )
{
    let value: &T = trusted borrow_from<T, Owner>(owner, pointer);

    return
    {
        owner = owner,
        value = value,
    };
}

struct AnchoredViewMut<T, Capability>
{
    internal value: &mut T;

    mut func get() -> &mut T
    {
        return self.value;
    }
}

trusted func anchored_view_mut<T, Capability>(
    pos capability: &mut Capability,
    pos pointer: RawPointer<T>,
) -> AnchoredViewMut<T, Capability>
    requires(
        trusted core.memory.valid_write<T>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<T>(pointer = pointer),
        trusted core.memory.initialized_as<T>(pointer = pointer),
        trusted core.memory.exclusive_alias_valid<T>(pointer = pointer),
        trusted core.memory.epoch_current<T>(pointer = pointer),
        trusted core.memory.synchronized_access<T>(pointer = pointer),
        trusted core.memory.movement_stable<T>(pointer = pointer),
        trusted core.memory.finalization_pending<T>(pointer = pointer),
    )
{
    let value: &mut T = trusted borrow_mut_from<T, Capability>(capability, pointer);

    return
    {
        value = value,
    };
}

struct MemoryLayout
{
    bytes: usize;
    align: usize;
}

union MemoryLayoutError
{
    SizeOverflow;
    UnsupportedAlignment;
}

extern const func size_of<T>() -> usize;

extern const func align_of<T>() -> usize;

extern const func stride_of<T>() -> usize;

extern const func layout_of<T>(count: usize) -> Result<MemoryLayout, MemoryLayoutError>;

extern const func trailing_layout_of<T>(count: usize) -> Result<MemoryLayout, MemoryLayoutError>;

@copy
internal union CapacityGrowth
{
    Amortized;
    Exact;
}

internal func growth_capacity(
    pos current_length: usize,
    pos current_capacity: usize,
    additional: usize,
    growth: CapacityGrowth,
) -> Result<usize, MemoryLayoutError>
{
    let maximum: usize = ~0;

    if additional > maximum - current_length
    {
        return Error(MemoryLayoutError.SizeOverflow);
    }

    let required: usize = current_length + additional;

    match growth
    {
        case CapacityGrowth.Exact { return Ok(required); }
        case CapacityGrowth.Amortized {}
    }

    let mut candidate: usize = current_capacity;

    if candidate < 4
    {
        candidate = 4;
    }

    while candidate < required
    {
        if candidate > maximum - candidate
        {
            return Ok(required);
        }

        candidate += candidate;
    }

    return Ok(candidate);
}

struct RawAllocation
{
    pointer: RawPointer<u8>;
    bytes: usize;
    align: usize;

    trusted destruct()
    {
        trusted deallocate(self);
    }
}

extern trusted func allocate(pos layout: MemoryLayout) -> RawAllocation
    ensures(
        result.bytes == layout.bytes,
        result.align == layout.align,
        trusted core.memory.owned_allocation(pointer = result.pointer, bytes = result.bytes, align = result.align),
        trusted core.memory.valid_write<u8>(pointer = result.pointer, count = result.bytes),
    )
    uses(manual_alloc);

extern trusted func deallocate(pos allocation: RawAllocation) -> unit
    uses(manual_alloc);

trusted internal func allocate_value<T>(pos value: T) -> RawPointer<T>
    ensures(
        trusted core.memory.owned_allocation(
            pointer = trusted reinterpret<u8, T>(result),
            bytes = internal value_allocation_bytes<T>(),
            align = align_of<T>(),
        ),
        trusted core.memory.valid_read<T>(pointer = result, count = 1),
        trusted core.memory.valid_write<T>(pointer = result, count = 1),
        trusted core.memory.aligned_for<T>(pointer = result),
        trusted core.memory.initialized_as<T>(pointer = result),
    )
    uses(manual_alloc)
{
    let bytes: usize = internal value_allocation_bytes<T>();
    let align: usize = align_of<T>();
    let allocation: RawPointer<u8> = trusted core.memory.allocate(bytes = bytes, align = align);
    let storage_pointer: RawPointer<T> = trusted internal value_allocation_pointer<T>(allocation);

    trusted write<T>(storage_pointer, value);

    return storage_pointer;
}

trusted internal func value_allocation_pointer<T>(pos allocation: RawPointer<u8>) -> RawPointer<T>
    requires(
        trusted core.memory.owned_allocation(
            pointer = allocation,
            bytes = internal value_allocation_bytes<T>(),
            align = align_of<T>(),
        ),
    )
    ensures(
        trusted core.memory.owned_allocation(
            pointer = allocation,
            bytes = internal value_allocation_bytes<T>(),
            align = align_of<T>(),
        ),
        trusted core.memory.valid_write<T>(pointer = result, count = 1),
        trusted core.memory.aligned_for<T>(pointer = result),
    )
{
    return trusted reinterpret<T, u8>(allocation);
}

trusted internal func deallocate_value<T>(pos pointer: RawPointer<T>)
    requires(
        trusted core.memory.owned_allocation(
            pointer = trusted reinterpret<u8, T>(pointer),
            bytes = internal value_allocation_bytes<T>(),
            align = align_of<T>(),
        ),
    )
    uses(manual_alloc)
{
    let allocation: RawPointer<u8> = trusted reinterpret<u8, T>(pointer);

    trusted core.memory.deallocate(allocation, bytes = internal value_allocation_bytes<T>(), align = align_of<T>());
}

internal const func value_allocation_bytes<T>() -> usize
{
    let size: usize = size_of<T>();

    if size == 0
    {
        return 1;
    }

    return size;
}

struct RawBuffer<T>
{
    pointer: RawPointer<T>;
    capacity: usize;
    initialized: usize;

    trusted construct(capacity: usize) -> Result<Self, MemoryLayoutError>
        uses(manual_alloc, layout_reinterpret)
    {
        if capacity == 0
        {
            return Ok(trusted internal allocate_buffer<T>(capacity = 0, bytes = 0, align = align_of<T>()));
        }

        if size_of<T>() == 1 && align_of<T>() == 1
        {
            let buffer: RawBuffer<T> = trusted internal allocate_buffer<T>(
                capacity = capacity,
                bytes = capacity,
                align = 1,
            );

            return Ok(buffer);
        }

        let layout: MemoryLayout = try layout_of<T>(count = capacity);

        let buffer: RawBuffer<T> = trusted internal allocate_buffer<T>(
            capacity = capacity,
            bytes = layout.bytes,
            align = layout.align,
        );

        return Ok(buffer);
    }

    trusted destruct()
    {
        trusted raw_buffer_release<T>(&mut self);
    }
}

trusted internal func uninit_buffer<T>(capacity: usize) -> Result<RawBuffer<Uninit<T>>, MemoryLayoutError>
{
    let mut storage: RawBuffer<Uninit<T>> = try trusted RawBuffer<Uninit<T>>(capacity = capacity);

    while storage.initialized < storage.capacity
    {
        trusted internal initialize_spare<Uninit<T>>(&mut storage, uninit<T>());
    }

    return Ok(storage);
}

trusted internal func nullable_buffer<T>(capacity: usize) -> Result<RawBuffer<(T?)>, MemoryLayoutError>
{
    let mut storage: RawBuffer<(T?)> = try trusted RawBuffer<(T?)>(capacity = capacity);

    while storage.initialized < storage.capacity
    {
        let empty: T? = none;

        trusted internal initialize_spare(&mut storage, empty);
    }

    return Ok(storage);
}

trusted internal func initialize_spare<T>(pos buffer: &mut RawBuffer<T>, pos value: T) -> unit
{
    if buffer.initialized >= buffer.capacity
    {
        panic("raw buffer has no spare uninitialized slot");
    }

    trusted internal raw_buffer_push<T>(buffer, value);
}

trusted internal func take_last<T>(pos buffer: &mut RawBuffer<T>) -> T
{
    if buffer.initialized == 0
    {
        panic("raw buffer has no initialized value");
    }

    return trusted internal raw_buffer_pop<T>(buffer);
}

extern trusted internal func raw_buffer_push<T>(pos buffer: &mut RawBuffer<T>, pos value: T) -> unit
    requires(buffer.initialized < buffer.capacity)
    uses(raw_memory, unchecked_init);

extern trusted internal func raw_buffer_pop<T>(pos buffer: &mut RawBuffer<T>) -> T
    requires(buffer.initialized > 0)
    uses(raw_memory, unchecked_init);

extern trusted internal func allocate_buffer<T>(capacity: usize, bytes: usize, align: usize) -> RawBuffer<T>
    requires(bytes == stride_of<T>() * capacity, align == align_of<T>())
    ensures(result.capacity == capacity, result.initialized == 0)
    uses(manual_alloc);

extern func capacity<T>(pos buffer: &RawBuffer<T>) -> usize
    ensures(result == buffer.capacity);

extern func initialized_count<T>(pos buffer: &RawBuffer<T>) -> usize
    ensures(
        result == buffer.initialized,
        result <= buffer.capacity,
        trusted core.memory.initialized_range_as<T>(pointer = buffer.pointer, count = result),
    );

extern func pointer<T>(pos buffer: &RawBuffer<T>) -> RawPointer<T>;

extern trusted func initialized_slice<T>(pos buffer: &RawBuffer<T>) -> &[T]
    executes(pure, total)
    uses(raw_memory);

extern trusted func initialized_slice_mut<T>(pos buffer: &mut RawBuffer<T>) -> &mut [T]
    executes(pure, total)
    uses(raw_memory);

extern trusted func spare_pointer<T>(pos buffer: &mut RawBuffer<T>) -> RawPointer<T>
    ensures(
        trusted core.memory.valid_write<T>(pointer = result, count = buffer.capacity - buffer.initialized),
        trusted core.memory.aligned_for<T>(pointer = result),
    )
    uses(raw_memory);

extern trusted func set_initialized_count<T>(pos buffer: &mut RawBuffer<T>, count: usize) -> unit
    requires(
        count <= buffer.capacity,
        trusted core.memory.initialized_range_as<T>(pointer = buffer.pointer, count = count),
    )
    ensures(buffer.initialized == count)
    uses(unchecked_init);

extern trusted internal func raw_buffer_release<T>(pos buffer: &mut RawBuffer<T>) -> unit
    uses(manual_alloc);

extern trusted internal func raw_buffer_replace<T>(
    pos destination: &mut RawBuffer<T>,
    pos source: &mut RawBuffer<T>,
) -> unit
    uses(manual_alloc);

extern trusted internal func raw_buffer_relocate<T>(
    pos source: &mut RawBuffer<T>,
    pos destination: &mut RawBuffer<T>,
) -> unit
    requires(
        destination.initialized == 0,
        source.initialized <= destination.capacity,
        trusted core.memory.non_overlapping<T>(
            left = source.pointer,
            left_count = source.initialized,
            right = destination.pointer,
            right_count = source.initialized,
        ),
    )
    uses(raw_memory, unchecked_init);

trusted internal func reserve_raw_buffer<T>(
    pos buffer: &mut RawBuffer<T>,
    additional: usize,
    growth: CapacityGrowth,
) -> Result<unit, MemoryLayoutError>
{
    let current_length: usize = buffer.initialized;

    if additional <= buffer.capacity - current_length
    {
        return Ok(unit);
    }

    let replacement_capacity: usize = try growth_capacity(
        current_length = current_length,
        current_capacity = buffer.capacity,
        additional = additional,
        growth = growth,
    );

    let mut replacement_bytes: usize = replacement_capacity;
    let mut replacement_align: usize = 1;

    if size_of<T>() != 1 || align_of<T>() != 1
    {
        let layout: MemoryLayout = try layout_of<T>(count = replacement_capacity);

        replacement_bytes = layout.bytes;
        replacement_align = layout.align;
    }

    let mut replacement: RawBuffer<T> = trusted internal allocate_buffer<T>(
        capacity = replacement_capacity,
        bytes = replacement_bytes,
        align = replacement_align,
    );

    trusted raw_buffer_relocate<T>(source = &mut buffer, destination = &mut replacement);
    trusted raw_buffer_replace<T>(destination = &mut buffer, source = &mut replacement);

    return Ok(unit);
}

trusted internal func grow_byte_buffer(pos buffer: &mut RawBuffer<u8>) -> Result<unit, MemoryLayoutError>
{
    return trusted internal reserve_raw_buffer<u8>(buffer = buffer, additional = 1, growth = CapacityGrowth.Amortized);
}

trusted internal func copy_bytes(pos destination: &mut [u8], pos source: &[u8])
{
    let count: usize = source.length();
    let source_pointer: RawPointer<u8> = internal slice_pointer<u8>(source, count = count);

    trusted internal copy_bytes_from_pointer(destination, source = source_pointer, count = count);
}

trusted internal func copy_bytes_from_pointer(pos destination: &mut [u8], source: RawPointer<u8>, count: usize)
    requires(
        trusted core.memory.valid_read<u8>(pointer = source, count = count),
        trusted core.memory.initialized_range_as<u8>(pointer = source, count = count),
    )
{
    if !(count <= destination.length())
    {
        panic("byte copy exceeds its destination storage");
    }

    let destination_pointer: RawPointer<u8> = internal slice_pointer_mut<u8>(destination, count = count);

    trusted copy_overlapping<u8>(source, destination_pointer, count = count);
}

trusted internal func fill_bytes(pos destination: &mut [u8], value: u8)
{
    let count: usize = destination.length();
    let destination_pointer: RawPointer<u8> = internal slice_pointer_mut<u8>(destination, count = count);

    trusted internal byte_buffer_fill(destination = destination_pointer, value = value, count = count);
}

trusted internal func fill_spare_bytes(pos buffer: &mut RawBuffer<u8>, value: u8, count: usize) -> usize
    ensures(
        result <= buffer.capacity,
        trusted core.memory.initialized_range_as<u8>(pointer = buffer.pointer, count = result),
    )
{
    let initialized: usize = buffer.initialized;

    let destination: RawPointer<u8> = trusted spare_pointer<u8>(buffer);

    if count > buffer.capacity - buffer.initialized
    {
        panic("byte fill exceeds spare buffer storage");
    }

    trusted internal byte_buffer_fill(destination = destination, value = value, count = count);

    return initialized + count;
}

trusted internal func copy_spare_bytes(pos buffer: &mut RawBuffer<u8>, pos bytes: &[u8], count: usize) -> usize
    ensures(
        result <= buffer.capacity,
        trusted core.memory.initialized_range_as<u8>(pointer = buffer.pointer, count = result),
    )
{
    if !(count <= bytes.length())
    {
        panic("byte copy exceeds its source storage");
    }

    let source: RawPointer<u8> = internal slice_pointer<u8>(bytes, count = count);

    return trusted internal copy_spare_raw_bytes(buffer, source = source, count = count);
}

trusted internal func copy_spare_raw_bytes(
    pos buffer: &mut RawBuffer<u8>,
    source: RawPointer<u8>,
    count: usize
) -> usize
    requires(
        trusted core.memory.valid_read<u8>(pointer = source, count = count),
        trusted core.memory.initialized_range_as<u8>(pointer = source, count = count),
    )
    ensures(
        result <= buffer.capacity,
        trusted core.memory.initialized_range_as<u8>(pointer = buffer.pointer, count = result),
    )
    when(count <= buffer.capacity - buffer.initialized)
    {
        executes(total)
    }
{
    let available: usize = buffer.capacity - buffer.initialized;

    if count > available
    {
        panic("byte copy exceeds spare buffer storage");
    }

    let initialized: usize = initialized_count<u8>(&buffer);
    let destination: RawPointer<u8> = trusted spare_pointer<u8>(buffer);

    trusted copy_overlapping<u8>(source = source, destination = destination, count = count);

    return initialized + count;
}

extern trusted internal func byte_buffer_fill(pos destination: RawPointer<u8>, value: u8, count: usize) -> unit
    requires(trusted core.memory.valid_write<u8>(pointer = destination, count = count))
    ensures(trusted core.memory.initialized_range_as<u8>(pointer = destination, count = count))
    uses(raw_memory, unchecked_init);

extern trusted internal func byte_buffer_read(pos pointer: RawPointer<u8>, index: usize) -> u8
    requires(
        (trusted core.memory.valid_read<u8>(pointer = pointer, count = index + 1)) && index !=
            18_446_744_073_709_551_615,
        trusted core.memory.initialized_range_as<u8>(pointer = pointer, count = index + 1),
    )
    uses(raw_memory);

trusted internal func slice_pointer<T>(pos values: &[T], count: usize) -> RawPointer<T>
    requires(count <= values.length())
    ensures(
        trusted core.memory.valid_read<T>(pointer = result, count = count),
        trusted core.memory.aligned_for<T>(pointer = result),
        trusted core.memory.initialized_range_as<T>(pointer = result, count = count),
    )
    executes(pure)
{
    if !(count <= values.length())
    {
        panic("slice pointer extent exceeds its storage");
    }

    if count == 0
    {
        return null<T>();
    }

    return address_of<T>(&values[0]);
}

trusted internal func slice_pointer_mut<T>(pos values: &mut [T], count: usize) -> RawPointer<T>
    requires(count <= values.length())
    ensures(
        trusted core.memory.valid_read<T>(pointer = result, count = count),
        trusted core.memory.valid_write<T>(pointer = result, count = count),
        trusted core.memory.aligned_for<T>(pointer = result),
        trusted core.memory.initialized_range_as<T>(pointer = result, count = count),
    )
    executes(pure)
{
    if !(count <= values.length())
    {
        panic("slice pointer extent exceeds its storage");
    }

    if count == 0
    {
        return null<T>();
    }

    return address_of_mut<T>(&mut values[0]);
}
