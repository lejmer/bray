module std.memory;

extern func address_of<T>(pos value: &T) -> RawPointer<T>;

extern func address_of_mut<T>(pos value: &mut T) -> RawPointer<T>;

extern func null<T>() -> RawPointer<T>;

extern func is_null<T>(pos pointer: RawPointer<T>) -> bool;

extern func offset<T>(
    pos pointer: RawPointer<T>,
    elements: isize,
) -> RawPointer<T>;

extern func byte_offset<T>(
    pos pointer: RawPointer<T>,
    bytes: isize,
) -> RawPointer<T>;

extern trusted func reinterpret<Target, Source>(
    pos pointer: RawPointer<Source>,
) -> RawPointer<Target>
    uses(layout_reinterpret);

extern trusted func read<T>(pos pointer: RawPointer<T>) -> T
    uses(raw_memory);

extern trusted func write<T>(
    pos pointer: RawPointer<T>,
    pos value: T,
) -> unit
    uses(raw_memory, unchecked_init);

extern trusted func copy<T>(
    pos source: RawPointer<T>,
    pos destination: RawPointer<T>,
    count: usize,
) -> unit
    uses(raw_memory, unchecked_init);

extern trusted func copy_overlapping<T>(
    pos source: RawPointer<T>,
    pos destination: RawPointer<T>,
    count: usize,
) -> unit
    uses(raw_memory, unchecked_init);

struct MemoryLayout
{
    bytes: usize;
    align: usize;
}

union MemoryLayoutError
{
    SizeOverflow;
    UnsupportedAlignment;
}

extern const func size_of<T>() -> usize;

extern const func align_of<T>() -> usize;

extern const func stride_of<T>() -> usize;

extern const func layout_of<T>(
    count: usize,
) -> Result<MemoryLayout, MemoryLayoutError>;

struct RawAllocation
{
    pointer: RawPointer<u8>;
    bytes: usize;
    align: usize;
}

extern trusted func allocate(pos layout: MemoryLayout) -> RawAllocation
    uses(manual_alloc);

extern trusted func deallocate(pos allocation: RawAllocation) -> unit
    uses(manual_alloc);

struct RawBuffer<T>
{
    pointer: RawPointer<T>;
    capacity: usize;
    initialized: usize;
}

trusted func create_buffer<T>(
    capacity: usize,
) -> Result<RawBuffer<T>, MemoryLayoutError>
    uses(manual_alloc, layout_reinterpret)
{
    let layout: MemoryLayout = try layout_of<T>(count = capacity);
    let allocation: RawAllocation = trusted allocate(layout);

    let storage_pointer: RawPointer<T> =
        trusted reinterpret<T, u8>(allocation.pointer);
    let initialized: usize = 0;

    let buffer: RawBuffer<T> = {
        pointer = storage_pointer,
        capacity = capacity,
        initialized = initialized,
    };

    return .Ok(buffer);
}

extern func capacity<T>(pos buffer: &RawBuffer<T>) -> usize;

extern func initialized_count<T>(pos buffer: &RawBuffer<T>) -> usize;

extern func pointer<T>(pos buffer: &RawBuffer<T>) -> RawPointer<T>;

extern trusted func initialized_slice<T>(
    pos buffer: &RawBuffer<T>,
) -> &[T]
    uses(raw_memory);

extern trusted func initialized_slice_mut<T>(
    pos buffer: &mut RawBuffer<T>,
) -> &mut [T]
    uses(raw_memory);

extern trusted func spare_pointer<T>(
    pos buffer: &mut RawBuffer<T>,
) -> RawPointer<T>
    uses(raw_memory);

extern trusted func set_initialized_count<T>(
    pos buffer: &mut RawBuffer<T>,
    count: usize,
) -> unit
    uses(unchecked_init);

trusted internal func byte_buffer_create(
    capacity: usize,
) -> Result<RawBuffer<u8>, MemoryLayoutError>
{
    return trusted create_buffer<u8>(capacity = capacity);
}

internal func byte_buffer_capacity(pos buffer: &RawBuffer<u8>) -> usize
{
    return buffer.capacity;
}

internal func byte_buffer_initialized_count(pos buffer: &RawBuffer<u8>) -> usize
{
    return buffer.initialized;
}

internal func byte_buffer_pointer(pos buffer: &RawBuffer<u8>) -> RawPointer<u8>
{
    return buffer.pointer;
}

trusted internal func byte_buffer_initialized_slice(
    pos buffer: &RawBuffer<u8>,
) -> &[u8]
{
    return trusted initialized_slice<u8>(buffer);
}

trusted internal func byte_buffer_initialized_slice_mut(
    pos buffer: &mut RawBuffer<u8>,
) -> &mut [u8]
{
    return trusted initialized_slice_mut<u8>(buffer);
}

trusted internal func byte_buffer_spare_pointer(
    pos buffer: &mut RawBuffer<u8>,
) -> RawPointer<u8>
{
    return trusted spare_pointer<u8>(buffer);
}

trusted internal func byte_buffer_set_initialized_count(
    pos buffer: &mut RawBuffer<u8>,
    count: usize,
) -> unit
{
    trusted set_initialized_count<u8>(count = count, buffer = &mut buffer);
}

extern trusted internal func byte_buffer_release(
    pos buffer: &mut RawBuffer<u8>,
) -> unit
    uses(manual_alloc);

extern trusted internal func byte_buffer_fill(
    pos destination: RawPointer<u8>,
    value: u8,
    count: usize,
) -> unit
    uses(raw_memory, unchecked_init);

extern trusted internal func byte_buffer_copy(
    pos source: RawPointer<u8>,
    pos destination: RawPointer<u8>,
    count: usize,
) -> unit
    uses(raw_memory, unchecked_init);

extern trusted internal func byte_buffer_read(
    pos pointer: RawPointer<u8>,
    index: usize,
) -> u8
    uses(raw_memory);

internal func byte_address_of(pos value: &u8) -> RawPointer<u8>
{
    return address_of<u8>(value);
}
