trusted module std.process;

using std.collection;
using std.io;
using std.memory;
using std.path;

union ChildStreamPolicy
{
    Inherit;
    Null;
    Piped;
}

union EnvironmentPolicy
{
    Empty;
    InheritSnapshot;
}

union ChildErrorKind
{
    Creation;
    Waiting;
    Termination;
    Reaping;
}

struct ChildError
{
    kind: ChildErrorKind;
    io: std.io.IoError;
}

union ExitStatus
{
    Code(pos code: i32);
    TargetTermination(pos code: i64);
}

internal struct ChildCommandState
{
    executable: std.path.Path;
    mut argument_values: std.collection.List<std.path.NativeText>;
    mut environment_values: std.collection.List<EnvironmentEntry>;
    mut working_directory: std.path.Path?;
    mut input_policy: ChildStreamPolicy;
    mut output_policy: ChildStreamPolicy;
    mut error_policy: ChildStreamPolicy;
}

struct ChildCommand
{
    internal mut state: ChildCommandState;

    construct(pos executable: std.path.Path) -> Result<Self, ChildError>
    {
        let initial_arguments: std.collection.List<std.path.NativeText> = try trusted empty_list<std.path.NativeText>(
            kind = Creation
        );

        let initial_environment: std.collection.List<EnvironmentEntry> = try trusted inherited_environment();

        return Ok(
            {
                state =
                {
                    executable = executable,
                    argument_values = initial_arguments,
                    environment_values = initial_environment,
                    working_directory = none,
                    input_policy = ChildStreamPolicy.Inherit,
                    output_policy = ChildStreamPolicy.Inherit,
                    error_policy = ChildStreamPolicy.Inherit,
                }
            }
        );
    }

    mut func argument(pos value: std.path.NativeText) -> Result<unit, ChildError>
    {
        return trusted push_value<std.path.NativeText>(&mut self.state.argument_values, value, kind = Creation);
    }

    mut func environment_policy(policy: EnvironmentPolicy) -> Result<unit, ChildError>
    {
        trusted std.collection.clear<EnvironmentEntry>(&mut self.state.environment_values);

        match policy
        {
            case Empty { return Ok(unit); }
            case InheritSnapshot
            {
                try trusted append_inherited_environment(&mut self.state.environment_values);

                return Ok(unit);
            }
        }
    }

    mut func set_environment(pos key: std.path.NativeText, pos value: std.path.NativeText) -> Result<unit, ChildError>
    {
        trusted remove_environment_entry(&mut self.state.environment_values, key = &key);

        return trusted push_value<EnvironmentEntry>(
            &mut self.state.environment_values,
            {
                key = key,
                value = value,
            },
            kind = Creation,
        );
    }

    mut func remove_environment(pos key: &std.path.NativeText) -> unit
    {
        trusted remove_environment_entry(&mut self.state.environment_values, key = key);
    }

    mut func working_directory(pos path: std.path.Path) -> unit
    {
        self.state.working_directory = path;
    }

    mut func standard_input(policy: ChildStreamPolicy) -> unit
    {
        self.state.input_policy = policy;
    }

    mut func standard_output(policy: ChildStreamPolicy) -> unit
    {
        self.state.output_policy = policy;
    }

    mut func standard_error(policy: ChildStreamPolicy) -> unit
    {
        self.state.error_policy = policy;
    }

    consume func spawn() -> Result<ChildProcess, ChildError>
        requires(blocking_execution())
    {
        return trusted spawn_child(self.state);
    }
}

internal struct ChildProcessState
{
    handle: u64;
    mut is_open: bool;
    mut standard_input: u64;
    mut standard_output: u64;
    mut standard_error: u64;
}

internal func retired_child_state() -> ChildProcessState
    executes(pure, total)
    ensures(
        !result.is_open && result.handle == 0 && result.standard_input == 0 && result.standard_output == 0 &&
            result.standard_error == 0
    )
{
    return
    {
        handle = 0,
        is_open = false,
        standard_input = 0,
        standard_output = 0,
        standard_error = 0,
    };
}

struct ChildProcess
{
    internal mut state: ChildProcessState;
    predicate complete(value: &Self) = !value.state.is_open && value.state.standard_input == 0 &&
        value.state.standard_output == 0 && value.state.standard_error == 0;

    func is_complete() -> bool
        executes(pure, total)
        ensures(!result || Self.complete(&self), result || !Self.complete(&self))
    {
        return !self.state.is_open && self.state.standard_input == 0 && self.state.standard_output == 0 &&
            self.state.standard_error == 0;
    }

    trusted finalize() -> Result<unit, ChildError>
        requires(Self.complete(&self) || blocking_execution())
        when(Self.complete(&self))
        {
            executes(pure, total)
            ensures(result matches Ok(_))
        }
    {
        if !self.state.is_open && self.state.standard_input == 0 && self.state.standard_output == 0 &&
            self.state.standard_error == 0
        {
            return Ok(unit);
        }

        let _: ExitStatus = try trusted force_child_termination(&mut self);

        return Ok(unit);
    }

    trusted destruct()
        when(Self.complete(&self))
        {
            executes(pure, total)
        }
    {
        if self.state.is_open || self.state.standard_input != 0 || self.state.standard_output != 0 ||
            self.state.standard_error != 0
        {
            let _: Result<unit, ChildError> = trusted dispose_child(&mut self);
        }
    }

    mut func take_standard_input() -> ChildInput?
    {
        let handle: u64 = self.state.standard_input;

        self.state.standard_input = 0;

        return internal std.process.child_input(handle = handle);
    }

    mut func take_standard_output() -> ChildOutput?
    {
        let handle: u64 = self.state.standard_output;

        self.state.standard_output = 0;

        return internal std.process.child_output(handle = handle);
    }

    mut func take_standard_error() -> ChildOutput?
    {
        let handle: u64 = self.state.standard_error;

        self.state.standard_error = 0;

        return internal std.process.child_output(handle = handle);
    }

    mut func request_termination() -> Result<unit, ChildError>
        requires(blocking_execution())
    {
        return trusted request_child_termination(&mut self);
    }

    mut func wait() -> Result<ExitStatus, ChildError>
        requires(blocking_execution())
        ensures((result matches Error(_)) || Self.complete(&self))
    {
        return trusted wait_for_child(&mut self);
    }

    mut func force_termination() -> Result<ExitStatus, ChildError>
        requires(blocking_execution())
        ensures((result matches Error(_)) || Self.complete(&self))
    {
        return trusted force_child_termination(&mut self);
    }
}

trusted internal func inherited_environment() -> Result<std.collection.List<EnvironmentEntry>, ChildError>
{
    let mut values: std.collection.List<EnvironmentEntry> = try trusted empty_list<EnvironmentEntry>(kind = Creation);

    try trusted append_inherited_environment(&mut values);

    return Ok(values);
}

trusted internal func append_inherited_environment(
    pos values: &mut std.collection.List<EnvironmentEntry>
) -> Result<unit, ChildError>
{
    let snapshot: Environment = environment();
    let mut index: usize = 0;

    while index < snapshot.length()
    {
        let next_entry: EnvironmentEntry? = snapshot.entry_at(index);

        match consume next_entry
        {
            case ?value { try trusted push_value<EnvironmentEntry>(&mut values, value, kind = Creation); }
            case none { return Error(internal std.process.allocation_child_error(kind = Creation)); }
        }

        index += 1;
    }

    return Ok(unit);
}

trusted internal func empty_list<T>(kind: ChildErrorKind) -> Result<std.collection.List<T>, ChildError>
{
    let created: Result<std.collection.List<T>, std.memory.MemoryLayoutError> = trusted std.collection.List<T>();

    match consume created
    {
        case Ok(created_values) { return Ok(created_values); }
        case Error(_) { return Error(internal std.process.allocation_child_error(kind = kind)); }
    }
}

trusted internal func push_value<T>(
    pos values: &mut std.collection.List<T>,
    pos value: T,
    kind: ChildErrorKind,
) -> Result<unit, ChildError>
{
    let pushed: Result<unit, std.memory.MemoryLayoutError> = trusted std.collection.push<T>(&mut values, value);

    match consume pushed
    {
        case Ok(_) { return Ok(unit); }
        case Error(_) { return Error(internal std.process.allocation_child_error(kind = kind)); }
    }
}

trusted internal func remove_environment_entry(
    pos values: &mut std.collection.List<EnvironmentEntry>,
    pos key: &std.path.NativeText,
) -> unit
{
    match environment_entry_index(&values, key)
    {
        case ?index
        {
            let _: EnvironmentEntry? = trusted std.collection.remove<EnvironmentEntry>(&mut values, index = index);
        }
        case none {}
    }
}

internal func environment_entry_index(
    pos values: &std.collection.List<EnvironmentEntry>,
    pos key: &std.path.NativeText,
) -> usize?
{
    let mut index: usize = 0;

    while index < std.collection.length<EnvironmentEntry>(values)
    {
        let entries: &[EnvironmentEntry] = values.as_slice();

        let equal: bool = trusted internal std.platform.environment_keys_equal(
            internal std.path.native_bytes(&entries[index].key),
            internal std.path.native_bytes(key),
        );

        if equal
        {
            let mut result: usize? = none;

            result = index;

            return result;
        }

        index += 1;
    }

    return none;
}

trusted internal func spawn_child(pos state: ChildCommandState) -> Result<ChildProcess, ChildError>
    requires(blocking_execution())
    uses(foreign_call)
{
    let argument_views: std.collection.List<PlatformNativeText> = try argument_spans(&state.argument_values);

    let environment_views: std.collection.List<PlatformEnvironmentEntry> = try environment_spans(
        &state.environment_values
    );

    let executable: PlatformNativeText = internal std.process.path_span(&state.executable);
    let working_directory: std.path.Path? = state.working_directory;

    match consume working_directory
    {
        case ?directory
        {
            return trusted spawn_child_request(
                executable,
                working_directory = internal std.process.path_span(path = &directory),
                arguments = &argument_views,
                environment = &environment_views,
                standard_input = state.input_policy,
                standard_output = state.output_policy,
                standard_error = state.error_policy,
            );
        }
        case none
        {
            return trusted spawn_child_request(
                executable,
                working_directory = internal std.process.empty_span(),
                arguments = &argument_views,
                environment = &environment_views,
                standard_input = state.input_policy,
                standard_output = state.output_policy,
                standard_error = state.error_policy,
            );
        }
    }
}

trusted internal func spawn_child_request(
    pos executable: PlatformNativeText,
    pos arguments: &std.collection.List<PlatformNativeText>,
    pos environment: &std.collection.List<PlatformEnvironmentEntry>,
    working_directory: PlatformNativeText,
    standard_input: ChildStreamPolicy,
    standard_output: ChildStreamPolicy,
    standard_error: ChildStreamPolicy,
) -> Result<ChildProcess, ChildError>
    requires(blocking_execution())
    uses(foreign_call)
{
    let mut child: u64 = 0;
    let mut input: u64 = 0;
    let mut output: u64 = 0;
    let mut error: u64 = 0;

    let status: std.platform.PlatformStatus = trusted internal std.process.platform_child_spawn(
        executable,
        working_directory = working_directory,
        arguments = arguments.as_slice(),
        environment = environment.as_slice(),
        standard_input_policy = internal std.process.stream_policy_value(policy = standard_input),
        standard_output_policy = internal std.process.stream_policy_value(policy = standard_output),
        standard_error_policy = internal std.process.stream_policy_value(policy = standard_error),
        child = std.memory.address_of_mut(&mut child),
        standard_input = std.memory.address_of_mut(&mut input),
        standard_output = std.memory.address_of_mut(&mut output),
        standard_error = std.memory.address_of_mut(&mut error),
    );

    try internal std.process.child_status(status, kind = Creation);

    return Ok(
        {
            state =
            {
                handle = child,
                is_open = true,
                standard_input = input,
                standard_output = output,
                standard_error = error,
            }
        }
    );
}

trusted internal func argument_spans(
    pos values: &std.collection.List<std.path.NativeText>
) -> Result<std.collection.List<PlatformNativeText>, ChildError>
{
    let mut spans: std.collection.List<PlatformNativeText> = try trusted empty_list<PlatformNativeText>(
        kind = Creation
    );

    let entries: &[std.path.NativeText] = values.as_slice();
    let mut index: usize = 0;

    while index < std.collection.length<std.path.NativeText>(values)
    {
        try trusted push_value<PlatformNativeText>(
            &mut spans,
            internal std.process.native_text_span(&entries[index]),
            kind = Creation,
        );

        index += 1;
    }

    return Ok(spans);
}

trusted internal func environment_spans(
    pos values: &std.collection.List<EnvironmentEntry>
) -> Result<std.collection.List<PlatformEnvironmentEntry>, ChildError>
{
    let mut spans: std.collection.List<PlatformEnvironmentEntry> = try trusted empty_list<PlatformEnvironmentEntry>(
        kind = Creation
    );

    let entries: &[EnvironmentEntry] = values.as_slice();
    let mut index: usize = 0;

    while index < std.collection.length<EnvironmentEntry>(&values)
    {
        try trusted push_value<PlatformEnvironmentEntry>(
            &mut spans,
            {
                key = internal std.process.native_text_span(&entries[index].key),
                value = internal std.process.native_text_span(&entries[index].value),
            },
            kind = Creation,
        );

        index += 1;
    }

    return Ok(spans);
}

trusted internal func wait_for_child(pos child: &mut ChildProcess) -> Result<ExitStatus, ChildError>
    requires(blocking_execution())
    ensures((result matches Error(_)) || ChildProcess.complete(&child))
    uses(foreign_call)
{
    try trusted close_retained_pipes(&mut child);

    if !child.state.is_open
    {
        return Error(internal std.process.invalid_child_error(kind = Waiting));
    }

    let mut terminal: u32 = 0;
    let mut status: PlatformExitStatus = internal std.process.empty_exit_status();
    let terminal_pointer: RawPointer<u32> = std.memory.address_of_mut(&mut terminal);
    let status_pointer: RawPointer<PlatformExitStatus> = std.memory.address_of_mut(&mut status);

    let waited: std.platform.PlatformStatus = trusted internal std.process.platform_child_wait(
        child = child.state.handle,
        terminal = terminal_pointer,
        status = status_pointer,
    );

    if internal platform_child_wait_completed(waited)
    {
        child.state = retired_child_state();
    }

    try internal std.process.child_status(waited, kind = Waiting);

    if terminal != 1
    {
        return Error(internal std.process.invalid_child_error(kind = Waiting));
    }

    if child.state.is_open
    {
        let reaped: std.platform.PlatformStatus = trusted internal std.process.platform_child_reap(
            child = child.state.handle,
            status = status_pointer,
        );

        try internal std.process.child_status(reaped, kind = Reaping);
    }

    let result: Result<ExitStatus, ChildError> = internal std.process.exit_status(status);

    child.state = retired_child_state();

    return result;
}

trusted internal func request_child_termination(pos child: &mut ChildProcess) -> Result<unit, ChildError>
    requires(blocking_execution())
{
    if !child.state.is_open
    {
        return Error(internal std.process.invalid_child_error(kind = Termination));
    }

    let status: std.platform.PlatformStatus = trusted internal std.process.platform_child_terminate(
        child = child.state.handle,
        mode = 0,
    );

    return internal std.process.child_status(status, kind = Termination);
}

trusted internal func force_child_termination(pos child: &mut ChildProcess) -> Result<ExitStatus, ChildError>
    requires(blocking_execution())
    ensures((result matches Error(_)) || ChildProcess.complete(&child))
    uses(foreign_call)
{
    if !child.state.is_open
    {
        try trusted close_retained_pipes(&mut child);

        return Error(internal std.process.invalid_child_error(kind = Termination));
    }

    let terminated: std.platform.PlatformStatus = trusted internal std.process.platform_child_terminate(
        child = child.state.handle,
        mode = 1,
    );

    try internal std.process.child_status(terminated, kind = Termination);

    return trusted wait_for_child(&mut child);
}

trusted internal func dispose_child(pos child: &mut ChildProcess) -> Result<unit, ChildError>
    requires(blocking_execution())
    ensures((result matches Error(_)) || ChildProcess.complete(&child))
{
    let pipes = trusted close_retained_pipes(&mut child);

    if !child.state.is_open
    {
        return pipes;
    }

    let mut released: u32 = 0;

    let status: std.platform.PlatformStatus = trusted internal std.process.platform_child_dispose(
        child = child.state.handle,
        released = std.memory.address_of_mut(&mut released),
    );

    if released == 1
    {
        child.state.is_open = false;
    }

    try pipes;
    try internal std.process.child_status(status, kind = Reaping);

    child.state = retired_child_state();

    return Ok(unit);
}

trusted internal func close_retained_pipes(pos child: &mut ChildProcess) -> Result<unit, ChildError>
    requires(blocking_execution())
    ensures(
        (result matches Error(_)) || (child.state.standard_input == 0 && child.state.standard_output == 0 &&
            child.state.standard_error == 0)
    )
{
    let input = trusted close_retained_pipe(child.state.standard_input);

    child.state.standard_input = input.0;

    let output = trusted close_retained_pipe(child.state.standard_output);

    child.state.standard_output = output.0;

    let error = trusted close_retained_pipe(child.state.standard_error);

    child.state.standard_error = error.0;

    try input.1;
    try output.1;
    try error.1;

    child.state.standard_input = 0;
    child.state.standard_output = 0;
    child.state.standard_error = 0;

    return Ok(unit);
}

trusted internal func close_retained_pipe(pos handle: u64) -> (u64, Result<unit, ChildError>)
    requires(blocking_execution())
    ensures((result.1 matches Error(_)) || result.0 == 0)
{
    if handle == 0
    {
        let completed: Result<unit, ChildError> = Ok(unit);

        return (0, completed);
    }

    let status: std.platform.PlatformStatus = trusted internal platform_process_pipe_close(handle = handle);

    let completion = internal std.process.child_status(status, kind = Reaping);

    if internal std.platform.file_close_completed(status)
    {
        return (0, completion);
    }

    return (handle, completion);
}
