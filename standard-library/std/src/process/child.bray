module std.process;

using std.collection;
using std.io;
using std.memory;
using std.path;

union ChildStreamPolicy
{
    Inherit;
    Null;
    Piped;
}

union EnvironmentPolicy
{
    Empty;
    InheritSnapshot;
}

union ChildErrorKind
{
    Creation;
    Waiting;
    Termination;
    Reaping;
}

struct ChildError
{
    kind: ChildErrorKind;
    io: std.io.IoError;
}

union ExitStatus
{
    Code(pos code: i32);
    TargetTermination(pos code: i64);
}

internal struct ChildCommandState
{
    executable: std.path.Path;
    arguments: std.collection.List<std.path.NativeText>;
    environment: std.collection.List<EnvironmentEntry>;
    working_directory: std.path.Path?;
    standard_input: ChildStreamPolicy;
    standard_output: ChildStreamPolicy;
    standard_error: ChildStreamPolicy;
}

struct ChildCommand
{
    internal mut state: ChildCommandState;

    trusted construct(pos executable: std.path.Path) -> Result<Self, ChildError>
    {
        let arguments: std.collection.List<std.path.NativeText> = try empty_list<std.path.NativeText>(
            kind = Creation
        );

        let environment: std.collection.List<EnvironmentEntry> = try inherited_environment();

        return Ok(
            {
                state =
                {
                    executable = executable,
                    arguments = arguments,
                    environment = environment,
                    working_directory = none,
                    standard_input = Inherit,
                    standard_output = Inherit,
                    standard_error = Inherit,
                }
            }
        );
    }

    trusted mut func argument(pos value: std.path.NativeText) -> Result<unit, ChildError>
    {
        return push_value<std.path.NativeText>(&mut self.state.arguments, value, kind = Creation);
    }

    trusted mut func environment_policy(policy: EnvironmentPolicy) -> Result<unit, ChildError>
    {
        std.collection.clear<EnvironmentEntry>(&mut self.state.environment);

        match policy
        {
            case Empty { return Ok(unit); }
            case InheritSnapshot
            {
                self.state.environment = try inherited_environment();

                return Ok(unit);
            }
        }
    }

    trusted mut func set_environment(
        pos key: std.path.NativeText,
        pos value: std.path.NativeText,
    ) -> Result<unit, ChildError>
    {
        remove_environment_entry(&mut self.state.environment, key = &key);

        return push_value<EnvironmentEntry>(
            &mut self.state.environment,
            {
                key = key,
                value = value,
            },
            kind = Creation,
        );
    }

    trusted mut func remove_environment(pos key: &std.path.NativeText) -> unit
    {
        remove_environment_entry(&mut self.state.environment, key = key);
    }

    mut func working_directory(pos path: std.path.Path) -> unit
    {
        self.state.working_directory = path;
    }

    mut func standard_input(policy: ChildStreamPolicy) -> unit
    {
        self.state.standard_input = policy;
    }

    mut func standard_output(policy: ChildStreamPolicy) -> unit
    {
        self.state.standard_output = policy;
    }

    mut func standard_error(policy: ChildStreamPolicy) -> unit
    {
        self.state.standard_error = policy;
    }

    consume trusted func spawn() -> Result<ChildProcess, ChildError>
        requires(blocking_execution())
        uses(foreign_call)
    {
        return trusted spawn_child(consume self.state);
    }

    consume trusted async func spawn_async() -> Result<ChildProcess, ChildError>
        requires(blocking_execution())
    {
        return trusted self.spawn();
    }
}

internal struct ChildProcessState
{
    handle: u64;
    mut is_open: bool;
    mut standard_input: ChildInput?;
    mut standard_output: ChildOutput?;
    mut standard_error: ChildOutput?;
}

struct ChildProcess
{
    internal mut state: ChildProcessState;

    trusted finalize() -> Result<unit, ChildError>
        requires(blocking_execution())
    {
        let _: ExitStatus = try trusted force_child_termination(&mut self);

        return Ok(unit);
    }

    trusted destruct()
        uses(foreign_call)
    {
        if self.state.is_open
        {
            trusted close_retained_pipes(&mut self);

            let _: std.platform.PlatformStatus = trusted platform_child_terminate(
                child = self.state.handle,
                mode = 1,
            );

            let mut terminal: u32 = 0;
            let mut status: PlatformExitStatus = empty_exit_status();
            let terminal_pointer: RawPointer<u32> = std.memory.address_of_mut(&mut terminal);
            let status_pointer: RawPointer<PlatformExitStatus> = std.memory.address_of_mut(&mut status);

            let _: std.platform.PlatformStatus = trusted platform_child_wait(
                child = self.state.handle,
                terminal = terminal_pointer,
                status = status_pointer,
            );

            let _: std.platform.PlatformStatus = trusted platform_child_reap(
                child = self.state.handle,
                status = status_pointer,
            );
        }
    }

    mut func take_standard_input() -> ChildInput?
    {
        let value: ChildInput? = consume self.state.standard_input;

        self.state.standard_input = none;

        return value;
    }

    mut func take_standard_output() -> ChildOutput?
    {
        let value: ChildOutput? = consume self.state.standard_output;

        self.state.standard_output = none;

        return value;
    }

    mut func take_standard_error() -> ChildOutput?
    {
        let value: ChildOutput? = consume self.state.standard_error;

        self.state.standard_error = none;

        return value;
    }

    trusted mut func request_termination() -> Result<unit, ChildError>
        requires(blocking_execution())
        uses(foreign_call)
    {
        let status: std.platform.PlatformStatus = trusted platform_child_terminate(
            child = self.state.handle,
            mode = 0,
        );

        return child_status(status, kind = Termination);
    }

    trusted mut async func request_termination_async() -> Result<unit, ChildError>
        requires(blocking_execution())
    {
        return trusted self.request_termination();
    }

    consume trusted mut func wait() -> Result<ExitStatus, ChildError>
        requires(blocking_execution())
    {
        return trusted wait_for_child(&mut self);
    }

    consume trusted mut async func wait_async() -> Result<ExitStatus, ChildError>
        requires(blocking_execution())
    {
        return trusted self.wait();
    }

    consume trusted mut func force_termination() -> Result<ExitStatus, ChildError>
        requires(blocking_execution())
    {
        return trusted force_child_termination(&mut self);
    }

    consume trusted mut async func force_termination_async() -> Result<ExitStatus, ChildError>
        requires(blocking_execution())
    {
        return trusted self.force_termination();
    }
}

trusted internal func inherited_environment() -> Result<std.collection.List<EnvironmentEntry>, ChildError>
{
    let mut values: std.collection.List<EnvironmentEntry> = try empty_list<EnvironmentEntry>(kind = Creation);
    let snapshot: Environment = environment();
    let mut index: usize = 0;

    while index < snapshot.length()
    {
        match snapshot.entry_at(index)
        {
            case ?entry { try push_value<EnvironmentEntry>(&mut values, entry, kind = Creation); }
            case none { return Error(allocation_child_error(kind = Creation)); }
        }

        index += 1;
    }

    return Ok(values);
}

trusted internal func empty_list<T>(kind: ChildErrorKind) -> Result<std.collection.List<T>, ChildError>
{
    let created: Result<std.collection.List<T>, std.memory.MemoryLayoutError> = trusted std.collection.List<T>();

    match consume created
    {
        case Ok(values) { return Ok(values); }
        case Error(_) { return Error(allocation_child_error(kind)); }
    }
}

trusted internal func push_value<T>(
    pos values: &mut std.collection.List<T>,
    pos value: T,
    kind: ChildErrorKind,
) -> Result<unit, ChildError>
{
    let pushed: Result<unit, std.memory.MemoryLayoutError> = trusted std.collection.push<T>(&mut values, value);

    match consume pushed
    {
        case Ok(_) { return Ok(unit); }
        case Error(_) { return Error(allocation_child_error(kind)); }
    }
}

trusted internal func remove_environment_entry(
    pos values: &mut std.collection.List<EnvironmentEntry>,
    pos key: &std.path.NativeText,
) -> unit
{
    let mut index: usize = 0;

    while index < std.collection.length<EnvironmentEntry>(values)
    {
        let entries: &[EnvironmentEntry] = std.collection.as_slice<EnvironmentEntry>(values);

        if trusted internal std.platform.environment_keys_equal(
            internal std.path.native_bytes(&entries[index].key),
            internal std.path.native_bytes(key),
        )
        {
            let _: EnvironmentEntry? = trusted std.collection.remove<EnvironmentEntry>(&mut values, index = index);

            return unit;
        }

        index += 1;
    }
}

trusted internal func spawn_child(pos state: ChildCommandState) -> Result<ChildProcess, ChildError>
    requires(blocking_execution())
    uses(foreign_call)
{
    let arguments: std.collection.List<PlatformNativeText> = try argument_spans(&state.arguments);
    let environment: std.collection.List<PlatformEnvironmentEntry> = try environment_spans(&state.environment);
    let executable: PlatformNativeText = path_span(&state.executable);

    match consume state.working_directory
    {
        case ?directory
        {
            return trusted spawn_child_request(
                executable,
                working_directory = path_span(&directory),
                arguments = &arguments,
                environment = &environment,
                standard_input = state.standard_input,
                standard_output = state.standard_output,
                standard_error = state.standard_error,
            );
        }
        case none
        {
            return trusted spawn_child_request(
                executable,
                working_directory = empty_span(),
                arguments = &arguments,
                environment = &environment,
                standard_input = state.standard_input,
                standard_output = state.standard_output,
                standard_error = state.standard_error,
            );
        }
    }
}

trusted internal func spawn_child_request(
    pos executable: PlatformNativeText,
    working_directory: PlatformNativeText,
    pos arguments: &std.collection.List<PlatformNativeText>,
    pos environment: &std.collection.List<PlatformEnvironmentEntry>,
    standard_input: ChildStreamPolicy,
    standard_output: ChildStreamPolicy,
    standard_error: ChildStreamPolicy,
) -> Result<ChildProcess, ChildError>
    requires(blocking_execution())
    uses(foreign_call)
{
    let request: PlatformChildRequest =
    {
        executable = executable,
        working_directory = working_directory,
        arguments =
        {
            entries = list_pointer<PlatformNativeText>(arguments),
            count = std.collection.length<PlatformNativeText>(arguments) as u64,
        },
        environment =
        {
            entries = list_pointer<PlatformEnvironmentEntry>(environment),
            count = std.collection.length<PlatformEnvironmentEntry>(environment) as u64,
        },
        standard_input = stream_policy_value(standard_input),
        standard_output = stream_policy_value(standard_output),
        standard_error = stream_policy_value(standard_error),
        reserved = 0,
    };

    let mut child: u64 = 0;
    let mut input: u64 = 0;
    let mut output: u64 = 0;
    let mut error: u64 = 0;

    let status: std.platform.PlatformStatus = trusted platform_child_spawn(
        request,
        child = std.memory.address_of_mut(&mut child),
        standard_input = std.memory.address_of_mut(&mut input),
        standard_output = std.memory.address_of_mut(&mut output),
        standard_error = std.memory.address_of_mut(&mut error),
    );

    try child_status(status, kind = Creation);

    return Ok(
        {
            state =
            {
                handle = child,
                is_open = true,
                standard_input = child_input(input),
                standard_output = child_output(output),
                standard_error = child_output(error),
            }
        }
    );
}

trusted internal func argument_spans(
    pos values: &std.collection.List<std.path.NativeText>
) -> Result<std.collection.List<PlatformNativeText>, ChildError>
{
    let mut spans: std.collection.List<PlatformNativeText> = try empty_list<PlatformNativeText>(kind = Creation);
    let values: &[std.path.NativeText] = std.collection.as_slice<std.path.NativeText>(values);
    let mut index: usize = 0;

    while index < internal std.memory.slice_length<std.path.NativeText>(values)
    {
        try push_value<PlatformNativeText>(&mut spans, native_text_span(&values[index]), kind = Creation);

        index += 1;
    }

    return Ok(spans);
}

trusted internal func environment_spans(
    pos values: &std.collection.List<EnvironmentEntry>
) -> Result<std.collection.List<PlatformEnvironmentEntry>, ChildError>
{
    let mut spans: std.collection.List<PlatformEnvironmentEntry> = try empty_list<PlatformEnvironmentEntry>(
        kind = Creation
    );

    let values: &[EnvironmentEntry] = std.collection.as_slice<EnvironmentEntry>(values);
    let mut index: usize = 0;

    while index < internal std.memory.slice_length<EnvironmentEntry>(values)
    {
        try push_value<PlatformEnvironmentEntry>(
            &mut spans,
            {
                key = native_text_span(&values[index].key),
                value = native_text_span(&values[index].value),
            },
            kind = Creation,
        );

        index += 1;
    }

    return Ok(spans);
}

trusted internal func wait_for_child(pos child: &mut ChildProcess) -> Result<ExitStatus, ChildError>
    requires(blocking_execution())
    uses(foreign_call)
{
    trusted close_retained_pipes(&mut child);

    let mut terminal: u32 = 0;
    let mut status: PlatformExitStatus = empty_exit_status();
    let terminal_pointer: RawPointer<u32> = std.memory.address_of_mut(&mut terminal);
    let status_pointer: RawPointer<PlatformExitStatus> = std.memory.address_of_mut(&mut status);

    let waited: std.platform.PlatformStatus = trusted platform_child_wait(
        child = child.state.handle,
        terminal = terminal_pointer,
        status = status_pointer,
    );

    try child_status(waited, kind = Waiting);

    if terminal != 1
    {
        return Error(invalid_child_error(kind = Waiting));
    }

    let reaped: std.platform.PlatformStatus = trusted platform_child_reap(
        child = child.state.handle,
        status = status_pointer,
    );

    try child_status(reaped, kind = Reaping);

    child.state.is_open = false;

    return exit_status(status);
}

trusted internal func force_child_termination(pos child: &mut ChildProcess) -> Result<ExitStatus, ChildError>
    requires(blocking_execution())
    uses(foreign_call)
{
    let terminated: std.platform.PlatformStatus = trusted platform_child_terminate(
        child = child.state.handle,
        mode = 1,
    );

    try child_status(terminated, kind = Termination);

    return trusted wait_for_child(&mut child);
}

trusted internal func close_retained_pipes(pos child: &mut ChildProcess) -> unit
{
    match consume child.state.standard_input
    {
        case ?mut input { let _: Result<unit, std.io.IoError> = trusted close_child_input(&mut input); }
        case none {}
    }

    child.state.standard_input = none;

    match consume child.state.standard_output
    {
        case ?mut output { let _: Result<unit, std.io.IoError> = trusted close_child_output(&mut output); }
        case none {}
    }

    child.state.standard_output = none;

    match consume child.state.standard_error
    {
        case ?mut error { let _: Result<unit, std.io.IoError> = trusted close_child_output(&mut error); }
        case none {}
    }

    child.state.standard_error = none;
}
