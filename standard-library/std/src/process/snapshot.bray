trusted module std.process;

using std.memory;
using std.path;

@copy
internal struct ProcessContextEntry
{
    key_start: usize;
    key_end: usize;
    value_start: usize;
    value_end: usize;
}

internal struct ProcessContextTable
{
    text: std.memory.RawBuffer<u8>;
    entries: std.memory.RawBuffer<ProcessContextEntry>;
}

internal struct ProcessContext
{
    arguments: ProcessContextTable;
    environment: ProcessContextTable;
    directory: std.memory.RawBuffer<u8>;
}

internal static PROCESS_CONTEXT: std.sync.Once<ProcessContext> = std.sync.Once<ProcessContext>.empty();

internal func create_process_context() -> ProcessContext
{
    return
    {
        arguments = trusted internal context_table(
            trusted internal std.platform.argument_storage(),
            environment = false
        ),
        environment = trusted internal context_table(
            trusted internal required_environment_storage(),
            environment = true
        ),
        directory = trusted internal std.platform.working_directory_storage(),
    };
}

trusted internal func required_environment_storage() -> std.memory.RawBuffer<u8>
{
    match consume trusted internal std.platform.environment_storage()
    {
        case Ok(value) { return value; }
        case Error(_) { panic("the platform process environment is unavailable"); }
    }
}

trusted internal func argument_context_table() -> &ProcessContextTable
{
    return &PROCESS_CONTEXT.get_or_init(create_process_context).arguments;
}

trusted internal func environment_context_table() -> &ProcessContextTable
{
    return &PROCESS_CONTEXT.get_or_init(create_process_context).environment;
}

trusted internal func directory_context() -> &[u8]
{
    return trusted std.memory.initialized_slice<u8>(&PROCESS_CONTEXT.get_or_init(create_process_context).directory);
}
