@target(target.identity.SYSTEM == "windows")
trusted module std.process;

trusted internal func platform_process_pipe_read(
    pos handle: u64,
    pos destination: RawPointer<u8>,
    pos length: u64,
    pos transferred: RawPointer<u64>,
) -> std.platform.PlatformStatus
{
    return trusted internal std.platform.handle_transfer(
        trusted internal std.platform.handle_pointer(handle),
        bytes = destination,
        length = length,
        transferred = transferred,
        read_operation = true,
    );
}

trusted internal func platform_process_pipe_write(
    pos handle: u64,
    pos source: RawPointer<u8>,
    pos length: u64,
    pos transferred: RawPointer<u64>,
) -> std.platform.PlatformStatus
{
    return trusted internal std.platform.handle_transfer(
        trusted internal std.platform.handle_pointer(handle),
        bytes = source,
        length = length,
        transferred = transferred,
        read_operation = false,
    );
}

trusted internal func platform_process_pipe_flush(pos handle: u64) -> std.platform.PlatformStatus
    uses(foreign_call)
{
    if trusted std.os.windows.flush_file_buffers(trusted internal std.platform.handle_pointer(handle)) == 0
    {
        return trusted internal std.platform.windows_error_status();
    }

    return internal std.platform.success_status();
}

trusted internal func platform_process_pipe_close(pos handle: u64) -> std.platform.PlatformStatus
    uses(foreign_call)
{
    if trusted std.os.windows.close_handle(trusted internal std.platform.handle_pointer(handle)) == 0
    {
        return trusted internal std.platform.windows_error_status();
    }

    return internal std.platform.success_status();
}
