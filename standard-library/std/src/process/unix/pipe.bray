@target(target.identity.SYSTEM == "linux" || target.identity.SYSTEM == "darwin")
trusted module std.process;

@abi(c)
trusted internal func platform_process_pipe_read(
    pos handle: u64,
    pos destination: RawPointer<u8>,
    pos length: u64,
    pos transferred: RawPointer<u64>,
) -> std.platform.PlatformStatus
    requires(
        length == 0 || trusted core.memory.valid_write<u8>(pointer = destination, count = length as usize),
        trusted core.memory.valid_write<u64>(pointer = transferred, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = transferred),
    )
{
    let descriptor: i32 = match internal std.platform.checked_descriptor(handle)
    {
        case Ok(value) { yield value; }
        case Error(status) { return status; }
    };

    return trusted internal std.platform.descriptor_read(
        descriptor,
        destination = destination,
        length = length,
        transferred = transferred,
    );
}

@abi(c)
trusted internal func platform_process_pipe_write(
    pos handle: u64,
    pos source: RawPointer<u8>,
    pos length: u64,
    pos transferred: RawPointer<u64>,
) -> std.platform.PlatformStatus
    requires(
        length == 0 || trusted core.memory.valid_read<u8>(pointer = source, count = length as usize),
        length == 0 || trusted core.memory.initialized_range_as<u8>(pointer = source, count = length as usize),
        trusted core.memory.valid_write<u64>(pointer = transferred, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = transferred),
    )
{
    let descriptor: i32 = match internal std.platform.checked_descriptor(handle)
    {
        case Ok(value) { yield value; }
        case Error(status) { return status; }
    };

    return trusted internal std.platform.descriptor_write(
        descriptor,
        source = source,
        length = length,
        transferred = transferred,
    );
}

@abi(c)
trusted internal func platform_process_pipe_flush(pos handle: u64) -> std.platform.PlatformStatus
{
    match internal std.platform.checked_descriptor(handle)
    {
        case Ok(_) { return internal std.platform.success_status(); }
        case Error(status) { return status; }
    }
}

@abi(c)
trusted internal func platform_process_pipe_close(pos handle: u64) -> std.platform.PlatformStatus
{
    let descriptor: i32 = match internal std.platform.checked_descriptor(handle)
    {
        case Ok(value) { yield value; }
        case Error(status) { return status; }
    };

    if trusted std.os.unix.close(descriptor) != 0
    {
        return trusted internal std.platform.unix_error_status();
    }

    return internal std.platform.success_status();
}
