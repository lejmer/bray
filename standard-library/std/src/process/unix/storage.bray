@target(target.identity.SYSTEM == "linux" || target.identity.SYSTEM == "darwin")
trusted module std.process;

trusted internal func spawn_storage(
    pos executable: (&[u8]),
    pos arguments: &[(&[u8])],
    pos environment: &[PlatformEnvironmentEntry],
    working_directory_span: (&[u8]),
) -> Result<SpawnStorage, std.platform.PlatformStatus>
{
    let executable_length: usize = match internal native_text_length(executable, allow_empty = false)
    {
        case Ok(value) { yield value; }
        case Error(status) { return Error(status); }
    };

    let working_length: usize = match internal native_text_length(working_directory_span, allow_empty = true)
    {
        case Ok(value) { yield value; }
        case Error(status) { return Error(status); }
    };

    let argument_count: usize = arguments.length();
    let environment_count: usize = environment.length();

    let mut total: usize = match internal added_text_capacity(0, executable_length)
    {
        case Ok(value) { yield value; }
        case Error(status) { return Error(status); }
    };

    if working_length > 0
    {
        total = match internal added_text_capacity(total, working_length)
        {
            case Ok(value) { yield value; }
            case Error(status) { return Error(status); }
        };
    }

    let mut index: usize = 0;

    while index < argument_count
    {
        let span: (&[u8]) = arguments[index];

        let length: usize = match internal native_text_length(span, allow_empty = true)
        {
            case Ok(value) { yield value; }
            case Error(status) { return Error(status); }
        };

        total = match internal added_text_capacity(total, length)
        {
            case Ok(value) { yield value; }
            case Error(status) { return Error(status); }
        };

        index += 1;
    }

    index = 0;

    while index < environment_count
    {
        let entry: PlatformEnvironmentEntry = environment[index];

        let key_length: usize = match internal environment_key_length(entry.key)
        {
            case Ok(value) { yield value; }
            case Error(status) { return Error(status); }
        };

        let value_length: usize = match internal native_text_length(entry.value, allow_empty = true)
        {
            case Ok(value) { yield value; }
            case Error(status) { return Error(status); }
        };

        total = match internal added_environment_capacity(total, key_length, value_length)
        {
            case Ok(value) { yield value; }
            case Error(status) { return Error(status); }
        };

        index += 1;
    }

    let mut text: std.memory.RawBuffer<u8> = match trusted std.memory.RawBuffer<u8>(capacity = total)
    {
        case Ok(value) { yield value; }
        case Error(_) { return Error(internal std.platform.exhausted_status()); }
    };

    let mut argument_pointers: std.memory.RawBuffer<RawPointer<u8>> = match trusted std.memory.RawBuffer<
        RawPointer<u8>
    >(capacity = argument_count + 2)
    {
        case Ok(value) { yield value; }
        case Error(_) { return Error(internal std.platform.exhausted_status()); }
    };

    let mut environment_pointers: std.memory.RawBuffer<RawPointer<u8>> = match trusted std.memory.RawBuffer<
        RawPointer<u8>
    >(capacity = environment_count + 1)
    {
        case Ok(value) { yield value; }
        case Error(_) { return Error(internal std.platform.exhausted_status()); }
    };

    let executable_pointer: RawPointer<u8> = trusted internal copy_native_text(&mut text, executable);

    let mut working_directory: RawPointer<u8> = std.memory.null<u8>();

    if working_length > 0
    {
        working_directory = trusted internal copy_native_text(&mut text, working_directory_span);
    }

    trusted internal std.memory.initialize_spare<RawPointer<u8>>(&mut argument_pointers, executable_pointer);
    index = 0;

    while index < argument_count
    {
        let span: (&[u8]) = arguments[index];
        let copied: RawPointer<u8> = trusted internal copy_native_text(&mut text, span);

        trusted internal std.memory.initialize_spare<RawPointer<u8>>(&mut argument_pointers, copied);

        index += 1;
    }

    trusted internal std.memory.initialize_spare<RawPointer<u8>>(&mut argument_pointers, std.memory.null<u8>());

    index = 0;

    while index < environment_count
    {
        let entry: PlatformEnvironmentEntry = environment[index];
        let copied: RawPointer<u8> = trusted internal copy_environment_entry(&mut text, entry);

        trusted internal std.memory.initialize_spare<RawPointer<u8>>(&mut environment_pointers, copied);

        index += 1;
    }

    trusted internal std.memory.initialize_spare<RawPointer<u8>>(&mut environment_pointers, std.memory.null<u8>());

    return Ok(
        {
            text = text,
            arguments = argument_pointers,
            environment = environment_pointers,
            executable = executable_pointer,
            working_directory = working_directory,
        }
    );
}

trusted internal func native_text_length(
    pos text: (&[u8]),
    allow_empty: bool,
) -> Result<usize, std.platform.PlatformStatus>
{
    let length: usize = text.length();

    if !allow_empty && length == 0
    {
        return Error(internal std.platform.invalid_input_status());
    }

    let mut index: usize = 0;

    while index < length
    {
        if text[index] == 0
        {
            return Error(internal std.platform.invalid_input_status());
        }

        index += 1;
    }

    return Ok(length);
}

trusted internal func environment_key_length(pos text: (&[u8])) -> Result<usize, std.platform.PlatformStatus>
{
    let length: usize = match trusted internal native_text_length(text, allow_empty = false)
    {
        case Ok(value) { yield value; }
        case Error(status) { return Error(status); }
    };

    let mut index: usize = 0;

    while index < length
    {
        if text[index] == 61
        {
            return Error(internal std.platform.invalid_input_status());
        }

        index += 1;
    }

    return Ok(length);
}

internal func added_text_capacity(pos current: usize, pos length: usize) -> Result<usize, std.platform.PlatformStatus>
{
    if length == 18_446_744_073_709_551_615 || current > 18_446_744_073_709_551_615 - length - 1
    {
        return Error(internal std.platform.exhausted_status());
    }

    return Ok(current + length + 1);
}

internal func added_environment_capacity(
    pos current: usize,
    pos key_length: usize,
    pos value_length: usize,
) -> Result<usize, std.platform.PlatformStatus>
{
    let with_key: usize = match internal added_text_capacity(current, key_length)
    {
        case Ok(value) { yield value; }
        case Error(status) { return Error(status); }
    };

    match internal added_text_capacity(with_key, value_length)
    {
        case Ok(value) { return Ok(value); }
        case Error(status) { return Error(status); }
    }
}

trusted internal func copy_native_text(
    pos destination: &mut std.memory.RawBuffer<u8>,
    pos text: (&[u8]),
) -> RawPointer<u8>
{
    let start: RawPointer<u8> = trusted std.memory.spare_pointer<u8>(destination);
    let length: usize = text.length();

    let initialized: usize = trusted internal std.memory.copy_spare_bytes(destination, text, count = length);

    trusted std.memory.set_initialized_count<u8>(destination, count = initialized);
    trusted internal std.memory.initialize_spare<u8>(destination, b"\0"[0]);

    return start;
}

trusted internal func copy_environment_entry(
    pos destination: &mut std.memory.RawBuffer<u8>,
    pos entry: PlatformEnvironmentEntry,
) -> RawPointer<u8>
{
    let start: RawPointer<u8> = trusted std.memory.spare_pointer<u8>(destination);
    let key_length: usize = entry.key.length();
    let value_length: usize = entry.value.length();

    let key_initialized: usize = trusted internal std.memory.copy_spare_bytes(
        destination,
        entry.key,
        count = key_length,
    );

    trusted std.memory.set_initialized_count<u8>(destination, count = key_initialized);
    trusted internal std.memory.initialize_spare<u8>(destination, b"="[0]);

    let value_initialized: usize = trusted internal std.memory.copy_spare_bytes(
        destination,
        entry.value,
        count = value_length,
    );

    trusted std.memory.set_initialized_count<u8>(destination, count = value_initialized);
    trusted internal std.memory.initialize_spare<u8>(destination, b"\0"[0]);

    return start;
}
