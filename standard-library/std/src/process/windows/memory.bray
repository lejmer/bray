@target(target.identity.SYSTEM == "windows")
trusted module std.process;

trusted internal func windows_text_pointer(pos buffer: &std.memory.RawBuffer<u8>) -> RawPointer<u16>
{
    return trusted std.memory.reinterpret<u16, u8>(std.memory.pointer<u8>(buffer));
}

trusted internal func windows_optional_text_pointer(pos buffer: &std.memory.RawBuffer<u8>) -> RawPointer<u16>
{
    if std.memory.initialized_count<u8>(buffer) == 0
    {
        return std.memory.null<u16>();
    }

    return trusted internal windows_text_pointer(buffer);
}

internal func write_windows_unit(pos destination: &mut [u8], pos value: u16, index: usize) -> unit
{
    destination[index * 2] = std.truncate_to<u8>(value);
    destination[index * 2 + 1] = std.truncate_to<u8>(value >> 8);
}

internal func write_windows_u32(pos destination: &mut [u64], pos value: u32, offset: usize) -> unit
{
    assert(offset % 4 == 0, "native u32 field is misaligned");

    let index: usize = offset / 8;
    let shift: u64 = (offset % 8 * 8) as u64;
    let mask: u64 = 4_294_967_295 << shift;

    destination[index] = destination[index] & (mask ^ 18_446_744_073_709_551_615) | (value as u64 << shift);
}

trusted internal func write_windows_pointer(
    pos destination: &mut [u64],
    pos value: RawPointer<u8>,
    offset: usize,
) -> unit
{
    assert(offset % 8 == 0, "native pointer field is misaligned");

    destination[offset / 8] = trusted internal std.platform.pointer_handle(value);
}

trusted internal func read_windows_pointer(pos source: &[u64], offset: usize) -> RawPointer<u8>
{
    assert(offset % 8 == 0, "native pointer field is misaligned");

    return trusted internal std.platform.handle_pointer(source[offset / 8]);
}
