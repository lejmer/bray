@target(target.identity.SYSTEM == "windows")
trusted module std.process;

using std.memory;
using std.numeric;
using internal std.platform;

trusted internal func windows_text_pointer(pos buffer: &std.memory.RawBuffer<u16>) -> DataPointer<u16>
{
    return std.memory.pointer<u16>(buffer);
}

trusted internal func windows_optional_text_pointer(pos buffer: &std.memory.RawBuffer<u16>) -> DataPointer<u16>
{
    if std.memory.initialized_count<u16>(buffer) == 0
    {
        return std.memory.null<u16>();
    }

    return trusted internal windows_text_pointer(buffer);
}

internal func write_windows_unit(pos destination: &mut [u16], pos value: u16, index: usize) -> unit
{
    destination[index] = value;
}

internal func write_windows_u32(pos destination: &mut [u64], pos value: u32, offset: usize) -> unit
{
    assert(offset % 4 == 0, "native u32 field is misaligned");

    let index: usize = offset / 8;
    let shift: u64 = (offset % 8 * 8) as u64;
    let mask: u64 = (std.numeric.U32_MAX as u64) << shift;

    destination[index] = destination[index] & (mask ^ std.numeric.U64_MAX) | (value as u64 << shift);
}

trusted internal func write_windows_pointer(
    pos destination: &mut [u64],
    pos value: DataPointer<u8>,
    offset: usize,
) -> unit
{
    assert(offset % 8 == 0, "native pointer field is misaligned");

    destination[offset / 8] = trusted internal std.platform.pointer_handle(value);
}

trusted internal func read_windows_pointer(pos source: &[u64], offset: usize) -> DataPointer<u8>
{
    assert(offset % 8 == 0, "native pointer field is misaligned");

    return trusted internal std.platform.handle_pointer(source[offset / 8]);
}
