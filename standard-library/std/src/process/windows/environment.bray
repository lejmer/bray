@target(target.identity.SYSTEM == "windows")
trusted module std.process;

using std.order;

trusted internal func windows_environment(
    pos entries: &[PlatformEnvironmentEntry],
) -> Result<std.memory.RawBuffer<u8>, std.platform.PlatformStatus>
{
    let count: usize = entries.length();

    let mut ordered: std.memory.RawBuffer<usize> = match trusted std.memory.RawBuffer<usize>(capacity = count)
    {
        case Ok(value) { yield value; }
        case Error(_) { return Error(internal std.platform.exhausted_status()); }
    };

    let mut total: usize = if count == 0
    {
        yield 4;
    }
    else
    {
        yield 2;
    };

    let mut index: usize = 0;

    while index < count
    {
        let entry: PlatformEnvironmentEntry = entries[index];
        let key_units: usize = try internal windows_text_units(entry.key, allow_empty = false, allow_equals = false);
        let value_units: usize = try internal windows_text_units(entry.value, allow_empty = true, allow_equals = true);
        let bytes: usize = (key_units + value_units + 2) * 2;

        if total > 18_446_744_073_709_551_615 - bytes
        {
            return Error(internal std.platform.exhausted_status());
        }

        total += bytes;

        trusted internal std.memory.initialize_spare<usize>(&mut ordered, index);

        index += 1;
    }

    let mut order: WindowsEnvironmentOrder =
    {
        indices = trusted std.memory.initialized_slice_mut<usize>(&mut ordered),
        entries = entries,
    };

    order.sort_unstable();

    let mut storage: std.memory.RawBuffer<u8> = try trusted internal windows_buffer(total);
    let destination: &mut [u8] = trusted std.memory.initialized_slice_mut<u8>(&mut storage);
    let values: &[usize] = trusted std.memory.initialized_slice<usize>(&ordered);
    let mut offset: usize = 0;

    index = 0;

    while index < count
    {
        let entry: PlatformEnvironmentEntry = entries[values[index]];

        trusted internal std.memory.copy_bytes(
            &mut destination[offset..offset + entry.key.length()],
            source = entry.key,
        );

        offset += entry.key.length();
        destination[offset] = 61;
        offset += 2;

        trusted internal std.memory.copy_bytes(
            &mut destination[offset..offset + entry.value.length()],
            source = entry.value,
        );

        offset += entry.value.length();
        offset += 2;
        index += 1;
    }

    return Ok(storage);
}

internal struct WindowsEnvironmentOrder
{
    mut indices: &mut [usize];
    entries: &[PlatformEnvironmentEntry];
}

impl WindowsEnvironmentOrderedSequence = WindowsEnvironmentOrder(std.order.OrderedSequence)
{
    type Element = [u8];

    func order_length() -> usize
    {
        return self.indices.length();
    }

    func compare_indices(pos left: usize, pos right: usize) -> Ordering
    {
        let left_index: usize = self.indices[left];
        let right_index: usize = self.indices[right];
        let compared: Ordering = self.compare_value(left, self.entries[right_index].key);

        if compared != Ordering.Equal
        {
            return compared;
        }

        if left_index < right_index
        {
            return Ordering.Less;
        }

        if left_index > right_index
        {
            return Ordering.Greater;
        }

        return Ordering.Equal;
    }

    func compare_value(pos index: usize, pos value: &[u8]) -> Ordering
    {
        let left: usize = self.indices[index];
        let compared: i32 = trusted internal windows_environment_compare(self.entries[left].key, value);

        if compared == 1
        {
            return Ordering.Less;
        }

        if compared == 3
        {
            return Ordering.Greater;
        }

        if compared != 2
        {
            panic("the platform environment comparison failed");
        }

        return Ordering.Equal;
    }

    mut func swap_indices(pos left: usize, pos right: usize)
    {
        let displaced: usize = self.indices[left];

        self.indices[left] = self.indices[right];
        self.indices[right] = displaced;
    }
}

trusted internal func windows_environment_compare(pos left: (&[u8]), pos right: (&[u8])) -> i32
    uses(foreign_call)
{
    return trusted std.os.windows.compare_string_ordinal(
        trusted std.memory.reinterpret<u16, u8>(internal std.memory.slice_pointer(left, count = left.length())),
        left_length = std.truncate_to<i32>(left.length() / 2),
        right = trusted std.memory.reinterpret<u16, u8>(
            internal std.memory.slice_pointer(right, count = right.length())
        ),
        right_length = std.truncate_to<i32>(right.length() / 2),
        ignore_case = 1,
    );
}
