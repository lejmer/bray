@target(target.identity.SYSTEM == "linux" || target.identity.SYSTEM == "darwin")
trusted module std.process;

trusted internal func platform_process_pipe_read(
    pos handle: u64,
    pos destination: RawPointer<u8>,
    pos length: u64,
    pos transferred: RawPointer<u64>,
) -> std.platform.PlatformStatus
{
    let descriptor: i32 = match internal std.platform.checked_descriptor(handle)
    {
        case Ok(value) { yield value; }
        case Error(status) { return status; }
    };

    return trusted internal std.platform.descriptor_transfer(
        descriptor,
        bytes = destination,
        length = length,
        transferred = transferred,
        read_operation = true,
    );
}

trusted internal func platform_process_pipe_write(
    pos handle: u64,
    pos source: RawPointer<u8>,
    pos length: u64,
    pos transferred: RawPointer<u64>,
) -> std.platform.PlatformStatus
{
    let descriptor: i32 = match internal std.platform.checked_descriptor(handle)
    {
        case Ok(value) { yield value; }
        case Error(status) { return status; }
    };

    return trusted internal std.platform.descriptor_transfer(
        descriptor,
        bytes = source,
        length = length,
        transferred = transferred,
        read_operation = false,
    );
}

trusted internal func platform_process_pipe_flush(pos handle: u64) -> std.platform.PlatformStatus
{
    match internal std.platform.checked_descriptor(handle)
    {
        case Ok(_) { return internal std.platform.success_status(); }
        case Error(status) { return status; }
    }
}

trusted internal func platform_process_pipe_close(pos handle: u64) -> std.platform.PlatformStatus
{
    let descriptor: i32 = match internal std.platform.checked_descriptor(handle)
    {
        case Ok(value) { yield value; }
        case Error(status) { return status; }
    };

    if trusted std.os.unix.close(descriptor) != 0
    {
        return trusted internal std.platform.unix_error_status();
    }

    return internal std.platform.success_status();
}

@copy
internal struct ChildDescriptors
{
    parent: i32;
    child: i32;
    target: i32;
}

internal struct SpawnStorage
{
    text: std.memory.RawBuffer<u8>;
    arguments: std.memory.RawBuffer<RawPointer<u8>>;
    environment: std.memory.RawBuffer<RawPointer<u8>>;
    executable: RawPointer<u8>;
    working_directory: RawPointer<u8>;
}

trusted internal func platform_child_spawn(
    pos request: PlatformChildRequest,
    pos child: RawPointer<u64>,
    pos standard_input: RawPointer<u64>,
    pos standard_output: RawPointer<u64>,
    pos standard_error: RawPointer<u64>,
) -> std.platform.PlatformStatus
{
    trusted std.memory.write<u64>(child, value = 0);
    trusted std.memory.write<u64>(standard_input, value = 0);
    trusted std.memory.write<u64>(standard_output, value = 0);
    trusted std.memory.write<u64>(standard_error, value = 0);

    if request.reserved != 0
    {
        return internal std.platform.invalid_input_status();
    }

    let storage: SpawnStorage = match trusted internal spawn_storage(&request)
    {
        case Ok(value) { yield value; }
        case Error(status) { return status; }
    };

    let input: ChildDescriptors = match trusted internal child_descriptors(
        request.standard_input,
        target = 0,
        reads = true,
    )
    {
        case Ok(value) { yield value; }
        case Error(status) { return status; }
    };

    let output: ChildDescriptors = match trusted internal child_descriptors(
        request.standard_output,
        target = 1,
        reads = false,
    )
    {
        case Ok(value) { yield value; }
        case Error(status)
        {
            trusted internal release_descriptors(input);

            return status;
        }
    };

    let error: ChildDescriptors = match trusted internal child_descriptors(
        request.standard_error,
        target = 2,
        reads = false,
    )
    {
        case Ok(value) { yield value; }
        case Error(status)
        {
            trusted internal release_descriptors(input);
            trusted internal release_descriptors(output);

            return status;
        }
    };

    let mut actions: std.memory.RawBuffer<u64> = match trusted std.memory.RawBuffer<u64>(
        capacity = std.os.unix.SPAWN_FILE_ACTION_WORDS
    )
    {
        case Ok(value) { yield value; }
        case Error(_)
        {
            trusted internal release_descriptors(input);
            trusted internal release_descriptors(output);
            trusted internal release_descriptors(error);

            return internal std.platform.exhausted_status();
        }
    };

    let actions_pointer: RawPointer<u8> = trusted std.memory.reinterpret<u8, u64>(std.memory.pointer<u64>(&actions));

    let initialized: i32 = trusted std.os.unix.initialize_spawn_actions(actions_pointer);

    if initialized != 0
    {
        trusted internal release_descriptors(input);
        trusted internal release_descriptors(output);
        trusted internal release_descriptors(error);

        return internal std.platform.native_error_status(initialized as i64);
    }

    let configured: i32 = trusted internal configure_spawn_actions(
        actions_pointer,
        working_directory = storage.working_directory,
        input = input,
        output = output,
        error = error,
    );

    if configured != 0
    {
        let _: i32 = trusted std.os.unix.destroy_spawn_actions(actions_pointer);

        trusted internal release_descriptors(input);
        trusted internal release_descriptors(output);
        trusted internal release_descriptors(error);

        return internal std.platform.native_error_status(configured as i64);
    }

    let mut process: i32 = 0;

    let spawned: i32 = trusted std.os.unix.spawn(
        std.memory.address_of_mut<i32>(&mut process),
        executable = storage.executable,
        actions = actions_pointer,
        arguments = std.memory.pointer<RawPointer<u8>>(&storage.arguments),
        environment = std.memory.pointer<RawPointer<u8>>(&storage.environment),
    );

    let destroyed: i32 = trusted std.os.unix.destroy_spawn_actions(actions_pointer);

    trusted internal release_child_descriptors(input);
    trusted internal release_child_descriptors(output);
    trusted internal release_child_descriptors(error);

    if spawned != 0
    {
        trusted internal release_parent_descriptors(input);
        trusted internal release_parent_descriptors(output);
        trusted internal release_parent_descriptors(error);

        return internal std.platform.native_error_status(spawned as i64);
    }

    if destroyed != 0 || process <= 0
    {
        let _: i32 = trusted std.os.unix.signal(process, force = true);
        let mut ignored: i32 = 0;
        let _: i32 = trusted std.os.unix.wait(process, std.memory.address_of_mut<i32>(&mut ignored));

        trusted internal release_parent_descriptors(input);
        trusted internal release_parent_descriptors(output);
        trusted internal release_parent_descriptors(error);

        if destroyed != 0
        {
            return internal std.platform.native_error_status(destroyed as i64);
        }

        return internal std.platform.other_status();
    }

    trusted std.memory.write<u64>(child, value = std.truncate_to<u64>(process));
    trusted std.memory.write<u64>(standard_input, value = trusted internal descriptor_handle(input.parent));
    trusted std.memory.write<u64>(standard_output, value = trusted internal descriptor_handle(output.parent));
    trusted std.memory.write<u64>(standard_error, value = trusted internal descriptor_handle(error.parent));

    return internal std.platform.success_status();
}

trusted internal func platform_child_wait(
    pos child: u64,
    pos terminal: RawPointer<u32>,
    pos status: RawPointer<PlatformExitStatus>,
) -> std.platform.PlatformStatus
{
    let process: i32 = match internal std.platform.checked_descriptor(child)
    {
        case Ok(value) { yield value; }
        case Error(error) { return error; }
    };

    let mut native_status: i32 = 0;

    loop
    {
        let waited: i32 = trusted std.os.unix.wait(process, std.memory.address_of_mut<i32>(&mut native_status));

        if waited == process
        {
            break;
        }

        if waited < 0 && trusted internal std.platform.unix_error_code() == 4
        {
            continue;
        }

        return trusted internal std.platform.unix_error_status();
    }

    trusted std.memory.write<u32>(terminal, value = 1);
    trusted std.memory.write<PlatformExitStatus>(status, value = internal unix_exit_status(native_status));

    return internal std.platform.success_status();
}

trusted internal func platform_child_terminate(pos child: u64, pos mode: u32) -> std.platform.PlatformStatus
{
    if mode > 1
    {
        return internal std.platform.invalid_input_status();
    }

    let process: i32 = match internal std.platform.checked_descriptor(child)
    {
        case Ok(value) { yield value; }
        case Error(error) { return error; }
    };

    if trusted std.os.unix.signal(process, force = mode == 1) != 0
    {
        return trusted internal std.platform.unix_error_status();
    }

    return internal std.platform.success_status();
}

trusted internal func platform_child_reap(
    pos child: u64,
    pos status: RawPointer<PlatformExitStatus>,
) -> std.platform.PlatformStatus
{
    match internal std.platform.checked_descriptor(child)
    {
        case Ok(_) {}
        case Error(error) { return error; }
    }

    if std.memory.is_null<PlatformExitStatus>(status)
    {
        return internal std.platform.invalid_input_status();
    }

    return internal std.platform.success_status();
}

trusted internal func platform_child_dispose(pos child: u64) -> std.platform.PlatformStatus
{
    let process: i32 = match internal std.platform.checked_descriptor(child)
    {
        case Ok(value) { yield value; }
        case Error(error) { return error; }
    };

    let _: i32 = trusted std.os.unix.signal(process, force = true);
    let mut status: i32 = 0;

    loop
    {
        let waited: i32 = trusted std.os.unix.wait(process, std.memory.address_of_mut<i32>(&mut status));

        if waited == process
        {
            return internal std.platform.success_status();
        }

        if waited < 0 && trusted internal std.platform.unix_error_code() == 4
        {
            continue;
        }

        return trusted internal std.platform.unix_error_status();
    }
}

trusted internal func spawn_storage(
    pos request: &PlatformChildRequest,
) -> Result<SpawnStorage, std.platform.PlatformStatus>
{
    let executable_length: usize = match internal native_text_length(request.executable, allow_empty = false)
    {
        case Ok(value) { yield value; }
        case Error(status) { return Error(status); }
    };

    let working_length: usize = match internal native_text_length(request.working_directory, allow_empty = true)
    {
        case Ok(value) { yield value; }
        case Error(status) { return Error(status); }
    };

    let argument_count: usize = match internal platform_count(request.arguments.count)
    {
        case Ok(value) { yield value; }
        case Error(status) { return Error(status); }
    };

    let environment_count: usize = match internal platform_count(request.environment.count)
    {
        case Ok(value) { yield value; }
        case Error(status) { return Error(status); }
    };

    if argument_count > 0 && std.memory.is_null<PlatformNativeText>(request.arguments.entries) || environment_count >
        0 && std.memory.is_null<PlatformEnvironmentEntry>(request.environment.entries)
    {
        return Error(internal std.platform.invalid_input_status());
    }

    let mut total: usize = match internal added_text_capacity(0, executable_length)
    {
        case Ok(value) { yield value; }
        case Error(status) { return Error(status); }
    };

    if working_length > 0
    {
        total = match internal added_text_capacity(total, working_length)
        {
            case Ok(value) { yield value; }
            case Error(status) { return Error(status); }
        };
    }

    let mut index: usize = 0;

    while index < argument_count
    {
        let span: PlatformNativeText = trusted internal platform_native_text(request.arguments.entries, index);

        let length: usize = match internal native_text_length(span, allow_empty = true)
        {
            case Ok(value) { yield value; }
            case Error(status) { return Error(status); }
        };

        total = match internal added_text_capacity(total, length)
        {
            case Ok(value) { yield value; }
            case Error(status) { return Error(status); }
        };

        index += 1;
    }

    index = 0;

    while index < environment_count
    {
        let entry: PlatformEnvironmentEntry = trusted internal platform_environment_entry(
            request.environment.entries,
            index,
        );

        let key_length: usize = match internal environment_key_length(entry.key)
        {
            case Ok(value) { yield value; }
            case Error(status) { return Error(status); }
        };

        let value_length: usize = match internal native_text_length(entry.value, allow_empty = true)
        {
            case Ok(value) { yield value; }
            case Error(status) { return Error(status); }
        };

        total = match internal added_environment_capacity(total, key_length, value_length)
        {
            case Ok(value) { yield value; }
            case Error(status) { return Error(status); }
        };

        index += 1;
    }

    let mut text: std.memory.RawBuffer<u8> = match trusted std.memory.RawBuffer<u8>(capacity = total)
    {
        case Ok(value) { yield value; }
        case Error(_) { return Error(internal std.platform.exhausted_status()); }
    };

    let mut argument_pointers: std.memory.RawBuffer<RawPointer<u8>> = match trusted std.memory.RawBuffer<
        RawPointer<u8>
    >(capacity = argument_count + 2)
    {
        case Ok(value) { yield value; }
        case Error(_) { return Error(internal std.platform.exhausted_status()); }
    };

    let mut environment_pointers: std.memory.RawBuffer<RawPointer<u8>> = match trusted std.memory.RawBuffer<
        RawPointer<u8>
    >(capacity = environment_count + 1)
    {
        case Ok(value) { yield value; }
        case Error(_) { return Error(internal std.platform.exhausted_status()); }
    };

    let text_pointer: RawPointer<u8> = trusted std.memory.spare_pointer<u8>(&mut text);

    let argument_pointer: RawPointer<RawPointer<u8>> = trusted std.memory.spare_pointer<RawPointer<u8>>(
        &mut argument_pointers
    );

    let environment_pointer: RawPointer<RawPointer<u8>> = trusted std.memory.spare_pointer<RawPointer<u8>>(
        &mut environment_pointers
    );

    let mut offset: usize = 0;
    let executable: RawPointer<u8> = trusted internal copy_native_text(text_pointer, offset, request.executable);

    offset += executable_length + 1;
    let mut working_directory: RawPointer<u8> = std.memory.null<u8>();

    if working_length > 0
    {
        working_directory = trusted internal copy_native_text(text_pointer, offset, request.working_directory);
        offset += working_length + 1;
    }

    trusted std.memory.write<RawPointer<u8>>(argument_pointer, value = executable);
    index = 0;

    while index < argument_count
    {
        let span: PlatformNativeText = trusted internal platform_native_text(request.arguments.entries, index);

        let copied: RawPointer<u8> = trusted internal copy_native_text(text_pointer, offset, span);

        offset += std.truncate_to<usize>(span.length) + 1;

        trusted std.memory.write<RawPointer<u8>>(
            std.memory.offset<RawPointer<u8>>(argument_pointer, elements = std.truncate_to<isize>(index + 1)),
            value = copied,
        );

        index += 1;
    }

    trusted std.memory.write<RawPointer<u8>>(
        std.memory.offset<RawPointer<u8>>(argument_pointer, elements = std.truncate_to<isize>(argument_count + 1)),
        value = std.memory.null<u8>(),
    );

    index = 0;

    while index < environment_count
    {
        let entry: PlatformEnvironmentEntry = trusted internal platform_environment_entry(
            request.environment.entries,
            index,
        );

        let copied: RawPointer<u8> = trusted internal copy_environment_entry(text_pointer, offset, entry);

        offset += std.truncate_to<usize>(entry.key.length) + std.truncate_to<usize>(entry.value.length) + 2;

        trusted std.memory.write<RawPointer<u8>>(
            std.memory.offset<RawPointer<u8>>(environment_pointer, elements = std.truncate_to<isize>(index)),
            value = copied,
        );

        index += 1;
    }

    trusted std.memory.write<RawPointer<u8>>(
        std.memory.offset<RawPointer<u8>>(environment_pointer, elements = std.truncate_to<isize>(environment_count)),
        value = std.memory.null<u8>(),
    );

    trusted std.memory.set_initialized_count<u8>(&mut text, count = total);
    trusted std.memory.set_initialized_count<RawPointer<u8>>(&mut argument_pointers, count = argument_count + 2);
    trusted std.memory.set_initialized_count<RawPointer<u8>>(&mut environment_pointers, count = environment_count + 1);

    return Ok(
        {
            text = text,
            arguments = argument_pointers,
            environment = environment_pointers,
            executable = executable,
            working_directory = working_directory,
        }
    );
}

internal func platform_count(pos count: u64) -> Result<usize, std.platform.PlatformStatus>
{
    let converted: usize = std.truncate_to<usize>(count);

    if converted as u64 != count || converted > 9_223_372_036_854_775_805
    {
        return Error(internal std.platform.invalid_input_status());
    }

    return Ok(converted);
}

trusted internal func native_text_length(
    pos text: PlatformNativeText,
    allow_empty: bool,
) -> Result<usize, std.platform.PlatformStatus>
{
    let length: usize = std.truncate_to<usize>(text.length);

    if length as u64 != text.length || !allow_empty && length == 0 || length > 0 && std.memory.is_null<u8>(text.address)
    {
        return Error(internal std.platform.invalid_input_status());
    }

    let mut index: usize = 0;

    while index < length
    {
        if trusted internal std.memory.byte_buffer_read(text.address, index = index) == 0
        {
            return Error(internal std.platform.invalid_input_status());
        }

        index += 1;
    }

    return Ok(length);
}

trusted internal func environment_key_length(pos text: PlatformNativeText) -> Result<usize, std.platform.PlatformStatus>
{
    let length: usize = match trusted internal native_text_length(text, allow_empty = false)
    {
        case Ok(value) { yield value; }
        case Error(status) { return Error(status); }
    };

    let mut index: usize = 0;

    while index < length
    {
        if trusted internal std.memory.byte_buffer_read(text.address, index = index) == 61
        {
            return Error(internal std.platform.invalid_input_status());
        }

        index += 1;
    }

    return Ok(length);
}

internal func added_text_capacity(pos current: usize, pos length: usize) -> Result<usize, std.platform.PlatformStatus>
{
    if length == 18_446_744_073_709_551_615 || current > 18_446_744_073_709_551_615 - length - 1
    {
        return Error(internal std.platform.exhausted_status());
    }

    return Ok(current + length + 1);
}

internal func added_environment_capacity(
    pos current: usize,
    pos key_length: usize,
    pos value_length: usize,
) -> Result<usize, std.platform.PlatformStatus>
{
    let with_key: usize = match internal added_text_capacity(current, key_length)
    {
        case Ok(value) { yield value; }
        case Error(status) { return Error(status); }
    };

    match internal added_text_capacity(with_key, value_length)
    {
        case Ok(value) { return Ok(value); }
        case Error(status) { return Error(status); }
    }
}

trusted internal func copy_native_text(
    pos destination: RawPointer<u8>,
    pos offset: usize,
    pos text: PlatformNativeText,
) -> RawPointer<u8>
{
    let start: RawPointer<u8> = std.memory.offset<u8>(destination, elements = std.truncate_to<isize>(offset));
    let length: usize = std.truncate_to<usize>(text.length);

    trusted internal std.memory.byte_buffer_copy(text.address, start, count = length);
    trusted std.memory.write<u8>(std.memory.offset<u8>(start, elements = std.truncate_to<isize>(length)), value = 0);
    return start;
}

trusted internal func copy_environment_entry(
    pos destination: RawPointer<u8>,
    pos offset: usize,
    pos entry: PlatformEnvironmentEntry,
) -> RawPointer<u8>
{
    let start: RawPointer<u8> = std.memory.offset<u8>(destination, elements = std.truncate_to<isize>(offset));
    let key_length: usize = std.truncate_to<usize>(entry.key.length);
    let value_length: usize = std.truncate_to<usize>(entry.value.length);

    trusted internal std.memory.byte_buffer_copy(entry.key.address, start, count = key_length);

    trusted std.memory.write<u8>(
        std.memory.offset<u8>(start, elements = std.truncate_to<isize>(key_length)),
        value = 61,
    );

    trusted internal std.memory.byte_buffer_copy(
        entry.value.address,
        std.memory.offset<u8>(start, elements = std.truncate_to<isize>(key_length + 1)),
        count = value_length,
    );

    trusted std.memory.write<u8>(
        std.memory.offset<u8>(start, elements = std.truncate_to<isize>(key_length + value_length + 1)),
        value = 0,
    );

    return start;
}

trusted internal func platform_native_text(
    pos entries: RawPointer<PlatformNativeText>,
    pos index: usize,
) -> PlatformNativeText
{
    let entry: RawPointer<u8> = trusted std.memory.reinterpret<u8, PlatformNativeText>(
        std.memory.offset<PlatformNativeText>(entries, elements = std.truncate_to<isize>(index))
    );

    let address: RawPointer<u8> = trusted internal std.platform.read_native_pointer<u8>(
        trusted std.memory.reinterpret<RawPointer<u8>, u8>(entry)
    );

    let length: u64 = trusted internal std.platform.read_native_u64(std.memory.byte_offset<u8>(entry, bytes = 8));

    return
    {
        address = address,
        length = length,
    };
}

trusted internal func platform_environment_entry(
    pos entries: RawPointer<PlatformEnvironmentEntry>,
    pos index: usize,
) -> PlatformEnvironmentEntry
{
    let entry: RawPointer<u8> = trusted std.memory.reinterpret<u8, PlatformEnvironmentEntry>(
        std.memory.offset<PlatformEnvironmentEntry>(entries, elements = std.truncate_to<isize>(index))
    );

    let values: RawPointer<PlatformNativeText> = trusted std.memory.reinterpret<PlatformNativeText, u8>(entry);

    return
    {
        key = trusted internal platform_native_text(values, index = 0),
        value = trusted internal platform_native_text(values, index = 1),
    };
}

trusted internal func child_descriptors(
    pos policy: u32,
    target: i32,
    reads: bool,
) -> Result<ChildDescriptors, std.platform.PlatformStatus>
{
    match policy
    {
        case 0
        {
            return Ok(
                {
                    parent = -1,
                    child = -1,
                    target = target,
                }
            );
        }
        case 1
        {
            let null_path: [u8; 10] = [47, 100, 101, 118, 47, 110, 117, 108, 108, 0];

            let flags: i32 = if reads
            {
                yield std.os.unix.O_RDONLY | std.os.unix.O_CLOEXEC;
            }
            else
            {
                yield std.os.unix.O_WRONLY | std.os.unix.O_CLOEXEC;
            };

            let descriptor: i32 = trusted std.os.unix.open_file(
                std.memory.address_of<u8>(&null_path[0]),
                flags = flags,
                mode = 0,
            );

            if descriptor < 0
            {
                return Error(trusted internal std.platform.unix_error_status());
            }

            let normalized: i32 = match trusted internal normalized_descriptor(descriptor)
            {
                case Ok(value) { yield value; }
                case Error(status) { return Error(status); }
            };

            return Ok(
                {
                    parent = -1,
                    child = normalized,
                    target = target,
                }
            );
        }
        case 2
        {
            let mut pair: [i32; 2] = [-1, -1];

            if trusted std.os.unix.socket_pair(std.memory.address_of_mut<i32>(&mut pair[0])) != 0
            {
                return Error(trusted internal std.platform.unix_error_status());
            }

            pair[0] = match trusted internal normalized_descriptor(pair[0])
            {
                case Ok(value) { yield value; }
                case Error(status)
                {
                    let _: i32 = trusted std.os.unix.close(pair[1]);

                    return Error(status);
                }
            };

            pair[1] = match trusted internal normalized_descriptor(pair[1])
            {
                case Ok(value) { yield value; }
                case Error(status)
                {
                    let _: i32 = trusted std.os.unix.close(pair[0]);

                    return Error(status);
                }
            };

            if reads
            {
                return Ok(
                    {
                        parent = pair[1],
                        child = pair[0],
                        target = target,
                    }
                );
            }

            return Ok(
                {
                    parent = pair[0],
                    child = pair[1],
                    target = target,
                }
            );
        }
        case _ { return Error(internal std.platform.invalid_input_status()); }
    }
}

trusted internal func normalized_descriptor(pos descriptor: i32) -> Result<i32, std.platform.PlatformStatus>
{
    if descriptor >= 3
    {
        return Ok(descriptor);
    }

    let normalized: i32 = trusted std.os.unix.duplicate_close_on_exec(descriptor, minimum = 3);

    if normalized < 0
    {
        let status: std.platform.PlatformStatus = trusted internal std.platform.unix_error_status();
        let _: i32 = trusted std.os.unix.close(descriptor);

        return Error(status);
    }

    let _: i32 = trusted std.os.unix.close(descriptor);

    return Ok(normalized);
}

trusted internal func configure_spawn_actions(
    pos actions: RawPointer<u8>,
    pos working_directory: RawPointer<u8>,
    pos input: ChildDescriptors,
    pos output: ChildDescriptors,
    pos error: ChildDescriptors,
) -> i32
{
    if !std.memory.is_null<u8>(working_directory)
    {
        let result: i32 = trusted std.os.unix.add_spawn_working_directory(actions, path = working_directory);

        if result != 0
        {
            return result;
        }
    }

    let input_result: i32 = trusted internal configure_child_descriptors(actions, input);

    if input_result != 0
    {
        return input_result;
    }

    let output_result: i32 = trusted internal configure_child_descriptors(actions, output);

    if output_result != 0
    {
        return output_result;
    }

    return trusted internal configure_child_descriptors(actions, error);
}

trusted internal func configure_child_descriptors(pos actions: RawPointer<u8>, pos descriptors: ChildDescriptors) -> i32
{
    if descriptors.child >= 0
    {
        let duplicated: i32 = trusted std.os.unix.add_spawn_duplicate(
            actions,
            source = descriptors.child,
            destination = descriptors.target,
        );

        if duplicated != 0
        {
            return duplicated;
        }

        let closed_child: i32 = trusted std.os.unix.add_spawn_close(actions, descriptor = descriptors.child);

        if closed_child != 0
        {
            return closed_child;
        }
    }

    if descriptors.parent >= 0
    {
        return trusted std.os.unix.add_spawn_close(actions, descriptor = descriptors.parent);
    }

    return 0;
}

trusted internal func release_descriptors(pos descriptors: ChildDescriptors)
{
    trusted internal release_child_descriptors(descriptors);
    trusted internal release_parent_descriptors(descriptors);
}

trusted internal func release_child_descriptors(pos descriptors: ChildDescriptors)
{
    if descriptors.child >= 0
    {
        let _: i32 = trusted std.os.unix.close(descriptors.child);
    }
}

trusted internal func release_parent_descriptors(pos descriptors: ChildDescriptors)
{
    if descriptors.parent >= 0
    {
        let _: i32 = trusted std.os.unix.close(descriptors.parent);
    }
}

internal func descriptor_handle(pos descriptor: i32) -> u64
{
    if descriptor < 0
    {
        return 0;
    }

    return std.truncate_to<u64>(descriptor);
}

internal func unix_exit_status(pos status: i32) -> PlatformExitStatus
{
    let code: i32 = status & 127;

    if code == 0
    {
        return
        {
            tag = 0,
            reserved = 0,
            payload = ((status >> 8) & 255) as i64,
        };
    }

    return
    {
        tag = 1,
        reserved = 0,
        payload = code as i64,
    };
}
