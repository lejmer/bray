trusted module std.process;

using std.io;
using std.memory;

internal struct ChildInputState
{
    mut handle: u64;
    mut is_open: bool;
}

struct ChildInput
{
    internal mut state: ChildInputState;
    /// Whether this owner has no unresolved resource obligation.
    predicate complete(value: &ChildInput) = !value.state.is_open;

    /// Reports whether the resource obligation has been resolved, including after an error.
    func is_complete() -> bool
        executes(pure, total)
        ensures(result == ChildInput.complete(value = &self))
    {
        return !self.state.is_open;
    }

    trusted finalize() -> Result<unit, std.io.IoError>
        requires(ChildInput.complete(value = &self) || blocking_execution())
        ensures(result matches Error(_) || ChildInput.complete(value = &self))
        when(ChildInput.complete(value = &self))
        {
            executes(pure, total)
            ensures(result matches Ok(_))
        }
    {
        return trusted close_child_input(&mut self);
    }

    trusted destruct()
    {
        if self.state.is_open
        {
            let _: std.platform.PlatformStatus = trusted internal platform_process_pipe_close(
                handle = self.state.handle
            );
        }
    }

    mut func close() -> Result<unit, std.io.IoError>
        requires(ChildInput.complete(value = &self) || blocking_execution())
        ensures(result matches Error(_) || ChildInput.complete(value = &self))
        when(ChildInput.complete(value = &self))
        {
            executes(pure, total)
            ensures(result matches Ok(_))
        }
    {
        return trusted close_child_input(&mut self);
    }
}

internal struct ChildOutputState
{
    mut handle: u64;
    mut is_open: bool;
}

struct ChildOutput
{
    internal mut state: ChildOutputState;
    /// Whether this owner has no unresolved resource obligation.
    predicate complete(value: &ChildOutput) = !value.state.is_open;

    /// Reports whether the resource obligation has been resolved, including after an error.
    func is_complete() -> bool
        executes(pure, total)
        ensures(result == ChildOutput.complete(value = &self))
    {
        return !self.state.is_open;
    }

    trusted finalize() -> Result<unit, std.io.IoError>
        requires(ChildOutput.complete(value = &self) || blocking_execution())
        ensures(result matches Error(_) || ChildOutput.complete(value = &self))
        when(ChildOutput.complete(value = &self))
        {
            executes(pure, total)
            ensures(result matches Ok(_))
        }
    {
        return trusted close_child_output(&mut self);
    }

    trusted destruct()
    {
        if self.state.is_open
        {
            let _: std.platform.PlatformStatus = trusted internal platform_process_pipe_close(
                handle = self.state.handle
            );
        }
    }

    mut func close() -> Result<unit, std.io.IoError>
        requires(ChildOutput.complete(value = &self) || blocking_execution())
        ensures(result matches Error(_) || ChildOutput.complete(value = &self))
        when(ChildOutput.complete(value = &self))
        {
            executes(pure, total)
            ensures(result matches Ok(_))
        }
    {
        return trusted close_child_output(&mut self);
    }
}

impl ChildInputWriter = ChildInput(std.io.Writer)
{
    mut func write(pos source: &[u8]) -> Result<usize, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted child_input_write(&mut self, source);
    }

    mut func flush() -> Result<unit, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted child_input_flush(&mut self);
    }
}

impl ChildOutputReader = ChildOutput(std.io.Reader)
{
    mut func read(pos destination: &mut [u8]) -> Result<usize, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted child_output_read(&mut self, destination);
    }
}

trusted internal func child_input(handle: &mut u64) -> ChildInput?
    uses(raw_memory)
{
    if trusted std.memory.read<u64>(std.memory.address_of_mut<u64>(handle)) == 0
    {
        return none;
    }

    let mut input: ChildInput =
    {
        state =
        {
            handle = 0,
            is_open = false,
        }
    };

    input.state.handle = trusted std.memory.replace_value<u64>(handle, 0);
    input.state.is_open = true;

    let mut value: ChildInput? = none;

    value = input;

    return value;
}

trusted internal func child_output(handle: &mut u64) -> ChildOutput?
    uses(raw_memory)
{
    if trusted std.memory.read<u64>(std.memory.address_of_mut<u64>(handle)) == 0
    {
        return none;
    }

    let mut output: ChildOutput =
    {
        state =
        {
            handle = 0,
            is_open = false,
        }
    };

    output.state.handle = trusted std.memory.replace_value<u64>(handle, 0);
    output.state.is_open = true;

    let mut value: ChildOutput? = none;

    value = output;

    return value;
}

trusted internal func child_input_write(pos input: &mut ChildInput, pos source: &[u8]) -> Result<usize, std.io.IoError>
    requires(blocking_execution())
{
    if !input.state.is_open
    {
        return Error(internal std.io.unavailable_stream_error());
    }

    let mut transferred: u64 = 0;

    let status: std.platform.PlatformStatus = trusted internal platform_process_pipe_write(
        handle = input.state.handle,
        source = internal std.memory.slice_pointer(source, count = source.length()),
        length = source.length() as u64,
        transferred = std.memory.address_of_mut(&mut transferred),
    );

    return internal std.io.checked_transfer(
        status,
        transferred = transferred,
        maximum = source.length(),
        require_progress = true,
    );
}

trusted internal func child_input_flush(pos input: &mut ChildInput) -> Result<unit, std.io.IoError>
    requires(blocking_execution())
{
    if !input.state.is_open
    {
        return Error(internal std.io.unavailable_stream_error());
    }

    return internal std.io.checked_status(trusted internal platform_process_pipe_flush(handle = input.state.handle));
}

trusted internal func child_output_read(
    pos output: &mut ChildOutput,
    pos destination: &mut [u8],
) -> Result<usize, std.io.IoError>
    requires(blocking_execution())
{
    if !output.state.is_open
    {
        return Error(internal std.io.unavailable_stream_error());
    }

    let mut transferred: u64 = 0;
    let maximum: usize = destination.length();

    let status: std.platform.PlatformStatus = trusted internal platform_process_pipe_read(
        handle = output.state.handle,
        destination = internal std.memory.slice_pointer_mut(destination, count = maximum),
        length = maximum as u64,
        transferred = std.memory.address_of_mut(&mut transferred),
    );

    return internal std.io.checked_transfer(
        status,
        transferred = transferred,
        maximum = maximum,
        require_progress = false,
    );
}

trusted internal func close_child_input(pos input: &mut ChildInput) -> Result<unit, std.io.IoError>
    requires(ChildInput.complete(value = &input) || blocking_execution())
    ensures(result matches Error(_) || ChildInput.complete(value = &input))
    when(ChildInput.complete(value = &input))
    {
        executes(pure, total)
        ensures(result matches Ok(_))
    }
{
    if !input.state.is_open
    {
        return Ok(unit);
    }

    let (status, released) = trusted internal std.platform.resource.close(input.state.handle);

    if released
    {
        input.state.is_open = false;
    }

    try internal std.io.checked_status(status);
    input.state.is_open = false;

    return Ok(unit);
}

trusted internal func close_child_output(pos output: &mut ChildOutput) -> Result<unit, std.io.IoError>
    requires(ChildOutput.complete(value = &output) || blocking_execution())
    ensures(result matches Error(_) || ChildOutput.complete(value = &output))
    when(ChildOutput.complete(value = &output))
    {
        executes(pure, total)
        ensures(result matches Ok(_))
    }
{
    if !output.state.is_open
    {
        return Ok(unit);
    }

    let (status, released) = trusted internal std.platform.resource.close(output.state.handle);

    if released
    {
        output.state.is_open = false;
    }

    try internal std.io.checked_status(status);
    output.state.is_open = false;

    return Ok(unit);
}
