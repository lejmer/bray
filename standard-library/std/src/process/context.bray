trusted module std.process;

using std.memory;
using std.path;

internal struct ProcessIdState
{
    value: u64;
}

struct Id
{
    internal state: ProcessIdState;
}

internal struct ProcessContextTable
{
    entries: std.memory.RawBuffer<std.platform.NativeTextPair>;
    storage: std.memory.RawBuffer<u8>;
}

struct Arguments
{
    internal state: ProcessContextTable;

    func length() -> usize
    {
        return std.memory.initialized_count<std.platform.NativeTextPair>(&self.state.entries);
    }

    func value_at(pos index: usize) -> std.path.NativeText?
    {
        if index >= self.length()
        {
            return none;
        }

        let entry: std.platform.NativeTextPair = trusted internal table_entry(&self.state, index = index);

        let bytes: std.memory.RawBuffer<u8> = trusted internal std.platform.copy_context_text(
            entry.key.address,
            length = entry.key.length,
        );

        let value: std.path.NativeText = trusted internal required_native_text(bytes);
        let mut result: std.path.NativeText? = none;

        result = value;

        return result;
    }
}

struct EnvironmentEntry
{
    key: std.path.NativeText;
    value: std.path.NativeText;
}

struct Environment
{
    internal state: ProcessContextTable;

    func length() -> usize
    {
        return std.memory.initialized_count<std.platform.NativeTextPair>(&self.state.entries);
    }

    func value(pos key: &std.path.NativeText) -> std.path.NativeText?
    {
        let expected: &[u8] = internal std.path.native_bytes(key);
        let mut index: usize = 0;

        while index < self.length()
        {
            let entry: std.platform.NativeTextPair = trusted internal table_entry(&self.state, index = index);

            if trusted internal std.platform.environment_key_equals_span(expected, right = entry.key)
            {
                let value: std.memory.RawBuffer<u8> = trusted internal std.platform.copy_context_text(
                    entry.value.address,
                    length = entry.value.length,
                );

                let native: std.path.NativeText = trusted internal required_native_text(value);
                let mut result: std.path.NativeText? = none;

                result = native;

                return result;
            }

            index += 1;
        }

        return none;
    }

    func entry_at(pos index: usize) -> EnvironmentEntry?
    {
        if index >= self.length()
        {
            return none;
        }

        let native_entry: std.platform.NativeTextPair = trusted internal table_entry(&self.state, index = index);

        let key: std.memory.RawBuffer<u8> = trusted internal std.platform.copy_context_text(
            native_entry.key.address,
            length = native_entry.key.length,
        );

        let value: std.memory.RawBuffer<u8> = trusted internal std.platform.copy_context_text(
            native_entry.value.address,
            length = native_entry.value.length,
        );

        let entry: EnvironmentEntry =
        {
            key = trusted internal required_native_text(key),
            value = trusted internal required_native_text(value),
        };

        let mut result: EnvironmentEntry? = none;

        result = entry;

        return result;
    }
}

func current_id() -> Id
{
    return
    {
        state =
        {
            value = trusted internal std.platform.process_identity()
        }
    };
}

func arguments() -> Arguments
{
    return
    {
        state = trusted internal context_table(trusted internal std.platform.argument_storage(), environment = false),
    };
}

func environment() -> Environment
{
    return
    {
        state = trusted internal context_table(trusted internal std.platform.environment_storage(), environment = true),
    };
}

func current_directory() -> std.path.Path
{
    let context: std.memory.RawBuffer<u8> = trusted internal std.platform.working_directory_storage();
    let bytes: &[u8] = trusted std.memory.initialized_slice<u8>(&context);
    let path: Result<std.path.Path, std.path.PathError> = trusted internal std.path.path_from_bytes(bytes);

    match consume path
    {
        case Ok(value) { return value; }
        case Error(_) { panic("the platform startup working directory is invalid"); }
    }
}

trusted internal func context_table(pos storage: std.memory.RawBuffer<u8>, environment: bool) -> ProcessContextTable
{
    let width: usize = trusted internal std.platform.native_text_width() / 8;
    let bytes: usize = std.memory.initialized_count<u8>(&storage);

    if width == 0 || bytes % width != 0
    {
        panic("the platform process context contains invalid native text");
    }

    let count: usize = trusted internal context_entry_count(&storage, width = width);

    let created: Result<std.memory.RawBuffer<std.platform.NativeTextPair>, std.memory.MemoryLayoutError> =
        trusted std.memory.RawBuffer<std.platform.NativeTextPair>(capacity = count);

    let mut entries: std.memory.RawBuffer<std.platform.NativeTextPair> = match consume created
    {
        case Ok(buffer) { yield buffer; }
        case Error(_) { panic("the platform process context cannot be allocated"); }
    };

    let base: RawPointer<u8> = std.memory.pointer<u8>(&storage);

    let destination: RawPointer<std.platform.NativeTextPair> = trusted std.memory.spare_pointer<
        std.platform.NativeTextPair
    >(&mut entries);

    let mut start: usize = 0;
    let mut index: usize = 0;
    let mut entry_index: usize = 0;

    while index < bytes
    {
        if trusted internal native_unit_is_zero(base, index = index, width = width)
        {
            let pair: std.platform.NativeTextPair = trusted internal context_pair(
                base,
                start = start,
                end = index,
                width = width,
                environment = environment,
            );

            trusted std.memory.write<std.platform.NativeTextPair>(
                std.memory.offset<std.platform.NativeTextPair>(
                    destination,
                    elements = std.truncate_to<isize>(entry_index),
                ),
                value = pair,
            );

            entry_index += 1;
            start = index + width;
        }

        index += width;
    }

    if start != bytes || entry_index != count
    {
        panic("the platform process context contains invalid native text");
    }

    trusted std.memory.set_initialized_count<std.platform.NativeTextPair>(&mut entries, count = count);

    return
    {
        entries = entries,
        storage = storage,
    };
}

trusted internal func context_entry_count(pos storage: &std.memory.RawBuffer<u8>, width: usize) -> usize
{
    let pointer: RawPointer<u8> = std.memory.pointer<u8>(storage);
    let bytes: usize = std.memory.initialized_count<u8>(storage);

    let mut count: usize = 0;
    let mut index: usize = 0;

    while index < bytes
    {
        if trusted internal native_unit_is_zero(pointer, index = index, width = width)
        {
            count += 1;
        }

        index += width;
    }

    return count;
}

trusted internal func context_pair(
    pos base: RawPointer<u8>,
    start: usize,
    end: usize,
    width: usize,
    environment: bool,
) -> std.platform.NativeTextPair
{
    let mut separator: usize = end;

    if environment
    {
        let mut index: usize = start;

        while index < end
        {
            if trusted internal native_unit_is_equals(base, index = index, width = width)
            {
                separator = index;
                break;
            }

            index += width;
        }

        if separator == end
        {
            panic("the platform process environment contains an invalid entry");
        }
    }

    let key: std.platform.NativeTextSpan = trusted internal context_native_span(base, start = start, end = separator);

    let value_start: usize = if environment
    {
        yield separator + width;
    }
    else
    {
        yield end;
    };

    return
    {
        key = key,
        value = trusted internal context_native_span(base, start = value_start, end = end),
    };
}

trusted internal func context_native_span(
    pos base: RawPointer<u8>,
    start: usize,
    end: usize,
) -> std.platform.NativeTextSpan
{
    return
    {
        address = std.memory.offset<u8>(base, elements = std.truncate_to<isize>(start)),
        length = (end - start) as u64,
    };
}

trusted internal func native_unit_is_zero(pos pointer: RawPointer<u8>, index: usize, width: usize) -> bool
{
    let mut byte: usize = 0;

    while byte < width
    {
        if trusted internal std.memory.byte_buffer_read(pointer, index = index + byte) != 0
        {
            return false;
        }

        byte += 1;
    }

    return true;
}

trusted internal func native_unit_is_equals(pos pointer: RawPointer<u8>, index: usize, width: usize) -> bool
{
    if trusted internal std.memory.byte_buffer_read(pointer, index = index) != 61
    {
        return false;
    }

    let mut byte: usize = 1;

    while byte < width
    {
        if trusted internal std.memory.byte_buffer_read(pointer, index = index + byte) != 0
        {
            return false;
        }

        byte += 1;
    }

    return true;
}

trusted internal func table_entry(pos table: &ProcessContextTable, index: usize) -> std.platform.NativeTextPair
{
    let entries: &[std.platform.NativeTextPair] = trusted std.memory.initialized_slice<std.platform.NativeTextPair>(
        &table.entries
    );

    return entries[index];
}

trusted internal func required_native_text(pos context: std.memory.RawBuffer<u8>) -> std.path.NativeText
{
    let bytes: &[u8] = trusted std.memory.initialized_slice<u8>(&context);

    let value: Result<std.path.NativeText, std.path.PathError> = trusted internal std.path.native_text_from_bytes(
        bytes
    );

    match consume value
    {
        case Ok(native) { return native; }
        case Error(_) { panic("the platform process context contains invalid native text"); }
    }
}
