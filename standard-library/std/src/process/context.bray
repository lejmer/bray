trusted module std.process;

using std.memory;
using std.path;

internal struct ProcessIdState
{
    value: u64;
}

struct Id
{
    internal state: ProcessIdState;
}

struct Arguments
{
    internal state: ProcessContextTable;

    func length() -> usize
    {
        return self.state.count;
    }

    func value_at(pos index: usize) -> std.path.NativeText?
    {
        if index >= self.length()
        {
            return none;
        }

        let entry: std.platform.NativeTextPair = trusted internal table_entry(self.state, index = index);

        let bytes: std.memory.RawBuffer<u8> = trusted internal std.platform.copy_context_text(
            entry.key.address,
            length = entry.key.length,
        );

        let value: std.path.NativeText = trusted internal required_native_text(bytes);
        let mut result: std.path.NativeText? = none;

        result = value;

        return result;
    }
}

struct EnvironmentEntry
{
    key: std.path.NativeText;
    value: std.path.NativeText;
}

struct Environment
{
    internal state: ProcessContextTable;

    func length() -> usize
    {
        return self.state.count;
    }

    func value(pos key: &std.path.NativeText) -> std.path.NativeText?
    {
        let expected: &[u8] = internal std.path.native_bytes(key);
        let mut index: usize = 0;

        while index < self.length()
        {
            let entry: std.platform.NativeTextPair = trusted internal table_entry(self.state, index = index);

            if trusted internal std.platform.environment_key_equals_span(expected, right = entry.key)
            {
                let value: std.memory.RawBuffer<u8> = trusted internal std.platform.copy_context_text(
                    entry.value.address,
                    length = entry.value.length,
                );

                let native: std.path.NativeText = trusted internal required_native_text(value);
                let mut result: std.path.NativeText? = none;

                result = native;

                return result;
            }

            index += 1;
        }

        return none;
    }

    func entry_at(pos index: usize) -> EnvironmentEntry?
    {
        if index >= self.length()
        {
            return none;
        }

        let native_entry: std.platform.NativeTextPair = trusted internal table_entry(self.state, index = index);

        let key: std.memory.RawBuffer<u8> = trusted internal std.platform.copy_context_text(
            native_entry.key.address,
            length = native_entry.key.length,
        );

        let value: std.memory.RawBuffer<u8> = trusted internal std.platform.copy_context_text(
            native_entry.value.address,
            length = native_entry.value.length,
        );

        let entry: EnvironmentEntry =
        {
            key = trusted internal required_native_text(key),
            value = trusted internal required_native_text(value),
        };

        let mut result: EnvironmentEntry? = none;

        result = entry;

        return result;
    }
}

func current_id() -> Id
{
    return
    {
        state =
        {
            value = trusted internal std.platform.process_identity()
        }
    };
}

func arguments() -> Arguments
{
    return
    {
        state = trusted internal argument_context_table(),
    };
}

func environment() -> Environment
{
    return
    {
        state = trusted internal environment_context_table(),
    };
}

func current_directory() -> std.path.Path
{
    let directory_span: std.platform.NativeTextSpan = trusted internal directory_context();

    let directory: std.memory.RawBuffer<u8> = trusted internal std.platform.copy_context_text(
        directory_span.address,
        length = directory_span.length,
    );

    let bytes: &[u8] = trusted std.memory.initialized_slice<u8>(&directory);
    let path: Result<std.path.Path, std.path.PathError> = trusted internal std.path.path_from_bytes(bytes);

    match consume path
    {
        case Ok(value) { return value; }
        case Error(_) { panic("the platform startup working directory is invalid"); }
    }
}

trusted internal func required_native_text(pos context: std.memory.RawBuffer<u8>) -> std.path.NativeText
{
    let bytes: &[u8] = trusted std.memory.initialized_slice<u8>(&context);

    let value: Result<std.path.NativeText, std.path.PathError> = trusted internal std.path.native_text_from_bytes(
        bytes
    );

    match consume value
    {
        case Ok(native) { return native; }
        case Error(_) { panic("the platform process context contains invalid native text"); }
    }
}
