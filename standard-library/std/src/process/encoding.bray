trusted module std.process;

using std.memory;
using std.path;
using std.order;

trusted internal func context_table(pos storage: std.memory.RawBuffer<u8>, environment: bool) -> ProcessContextTable
{
    let width: usize = trusted internal std.platform.native_text_width() / 8;
    let source: &[u8] = trusted std.memory.initialized_slice<u8>(&storage);

    if(width != 1 && width != 2) || source.length() % width != 0
    {
        panic("the platform process context contains invalid native text");
    }

    let source_count: usize = internal context_entry_count(source, width = width);

    let skipped: usize = if !environment && source_count > 0
    {
        yield 1;
    }
    else
    {
        yield 0;
    };

    let count: usize = source_count - skipped;

    let created: Result<std.memory.RawBuffer<ProcessContextEntry>, std.memory.MemoryLayoutError> =
        trusted std.memory.RawBuffer<ProcessContextEntry>(capacity = count);

    let mut entries: std.memory.RawBuffer<ProcessContextEntry> = match consume created
    {
        case Ok(value) { yield value; }
        case Error(_) { panic("the platform process context cannot be allocated"); }
    };

    let mut start: usize = 0;
    let mut index: usize = 0;
    let mut source_entry_index: usize = 0;

    while index < source.length()
    {
        if internal native_unit_is_zero(source, index = index, width = width)
        {
            if source_entry_index >= skipped
            {
                let entry: ProcessContextEntry = internal context_pair(
                    source,
                    start = start,
                    end = index,
                    width = width,
                    environment = environment
                );

                trusted internal std.memory.initialize_spare(&mut entries, entry);
            }

            source_entry_index += 1;
            start = index + width;
        }

        index += width;
    }

    if start != source.length() || source_entry_index != source_count
    {
        panic("the platform process context contains invalid native text");
    }

    if environment
    {
        let mut order: std.process.context_order.ContextEntryOrder =
        {
            values = trusted std.memory.initialized_slice_mut<ProcessContextEntry>(&mut entries),
            text = source,
            width = width,
        };

        order.sort_unstable();
    }

    return
    {
        text = storage,
        entries = entries
    };
}

internal func context_native_unit(pos source: &[u8], index: usize, width: usize) -> u32
{
    let mut value: u32 = 0;
    let mut byte: usize = 0;

    while byte < width
    {
        value |= source[index + byte] as u32 << (std.truncate_to<u32>(byte) * 8);
        byte += 1;
    }

    return value;
}

internal func context_entry_count(pos source: &[u8], width: usize) -> usize
{
    let mut count: usize = 0;
    let mut index: usize = 0;

    while index < source.length()
    {
        if internal native_unit_is_zero(source, index = index, width = width)
        {
            count += 1;
        }

        index += width;
    }

    return count;
}

internal func context_pair(
    pos source: &[u8],
    start: usize,
    end: usize,
    width: usize,
    environment: bool
) -> ProcessContextEntry
{
    let mut separator: usize = end;

    if environment
    {
        let mut index: usize = start;

        while index < end
        {
            if internal native_unit_is_equals(source, index = index, width = width)
            {
                separator = index;
                break;
            }

            index += width;
        }

        if separator == end
        {
            panic("the platform process environment contains an invalid entry");
        }
    }

    return
    {
        key_start = start,
        key_end = separator,
        value_start = if environment
        {
            yield separator + width;
        }
        else
        {
            yield end;
        },
        value_end = end,
    };
}

internal func native_unit_is_zero(pos source: &[u8], index: usize, width: usize) -> bool
{
    return internal context_native_unit(source, index = index, width = width) == 0;
}

internal func native_unit_is_equals(pos source: &[u8], index: usize, width: usize) -> bool
{
    return internal context_native_unit(source, index = index, width = width) == 61;
}

internal func table_entry(pos table: &ProcessContextTable, index: usize) -> ProcessContextEntry
{
    let entries: &[ProcessContextEntry] = trusted std.memory.initialized_slice<ProcessContextEntry>(&table.entries);

    return entries[index];
}

internal func table_key(pos table: &ProcessContextTable, pos entry: ProcessContextEntry) -> &[u8]
{
    let text: &[u8] = trusted std.memory.initialized_slice<u8>(&table.text);

    return &text[entry.key_start..entry.key_end];
}

internal func table_value(pos table: &ProcessContextTable, pos entry: ProcessContextEntry) -> &[u8]
{
    let text: &[u8] = trusted std.memory.initialized_slice<u8>(&table.text);

    return &text[entry.value_start..entry.value_end];
}

internal module std.process.context_order
{
    using std.order;

    internal struct ContextEntryOrder
    {
        mut values: &mut [std.process.ProcessContextEntry];
        text: &[u8];
        width: usize;
    }

    impl ContextEntryOrderedSequence = ContextEntryOrder(std.order.OrderedSequence)
    {
        type Element = std.process.ProcessContextEntry;

        func order_length() -> usize
        {
            return self.values.length();
        }

        func compare_indices(pos left: usize, pos right: usize) -> Ordering
        {
            return self.compare_value(left, &self.values[right]);
        }

        func compare_value(pos index: usize, pos value: &std.process.ProcessContextEntry) -> Ordering
        {
            let left: std.process.ProcessContextEntry = self.values[index];
            let left_key: &[u8] = &self.text[left.key_start..left.key_end];
            let right_key: &[u8] = &self.text[value.key_start..value.key_end];
            let compared: Ordering = internal context_key_order(left_key, right_key, width = self.width);

            if compared != Ordering.Equal
            {
                return compared;
            }

            if left.key_start < value.key_start
            {
                return Ordering.Less;
            }

            if left.key_start > value.key_start
            {
                return Ordering.Greater;
            }

            return Ordering.Equal;
        }

        mut func swap_indices(pos left: usize, pos right: usize)
        {
            let displaced: std.process.ProcessContextEntry = self.values[left];

            self.values[left] = self.values[right];
            self.values[right] = displaced;
        }
    }

    internal func context_key_order(pos left: &[u8], pos right: &[u8], width: usize) -> Ordering
    {
        let common: usize = if left.length() < right.length()
        {
            yield left.length();
        }
        else
        {
            yield right.length();
        };

        let mut index: usize = 0;

        while index < common
        {
            let left_unit: u32 = internal std.process.context_native_unit(left, index = index, width = width);
            let right_unit: u32 = internal std.process.context_native_unit(right, index = index, width = width);

            if left_unit < right_unit
            {
                return Ordering.Less;
            }

            if left_unit > right_unit
            {
                return Ordering.Greater;
            }

            index += width;
        }

        if left.length() < right.length()
        {
            return Ordering.Less;
        }

        if left.length() > right.length()
        {
            return Ordering.Greater;
        }

        return Ordering.Equal;
    }
}
