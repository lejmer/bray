module std.format;

using std.bytes;
using std.memory;
using std.string;

union Radix
{
    Binary;
    Octal;
    Decimal;
    HexadecimalLowercase;
    HexadecimalUppercase;
}

union Alignment
{
    Left;
    Center;
    Right;
}

union Sign
{
    NegativeOnly;
    Always;
    Space;
}

union Escaping
{
    Raw;
    Quoted;
}

struct Options
{
    radix: Radix;
    precision: usize;
    width: usize;
    alignment: Alignment;
    sign: Sign;
    escaping: Escaping;
}

func options(
    radix: Radix,
    precision: usize,
    width: usize,
    alignment: Alignment,
    sign: Sign,
    escaping: Escaping,
) -> Options
{
    return Options
    {
        radix = radix,
        precision = precision,
        width = width,
        alignment = alignment,
        sign = sign,
        escaping = escaping,
    };
}

func default_options() -> Options
{
    return options(
        radix = Decimal,
        precision = 0,
        width = 0,
        alignment = Right,
        sign = NegativeOnly,
        escaping = Raw,
    );
}

struct Argument<Value>
{
    value: Value;
    options: Options;
}

func argument<Value>(pos value: Value) -> Argument<Value>
{
    return
    {
        value = value,
        options = default_options(),
    };
}

func argument_with<Value>(
    pos value: Value,
    options: Options,
) -> Argument<Value>
{
    return
    {
        value = value,
        options = options,
    };
}

struct ByteSink
{
    internal mut buffer: std.bytes.Buffer;
}

func byte_sink(
    capacity: usize,
) -> Result<ByteSink, std.memory.MemoryLayoutError>
{
    let buffer: std.bytes.Buffer = try std.bytes.create(capacity = capacity);

    return Ok(ByteSink { buffer = buffer, });
}

func bytes(pos sink: &ByteSink) -> &[u8]
{
    return std.bytes.as_slice(&sink.buffer);
}

func into_bytes(pos sink: ByteSink) -> std.bytes.Buffer
{
    return sink.buffer;
}

struct TextSink
{
    internal mut bytes: ByteSink;
}

func text_sink(
    capacity: usize,
) -> Result<TextSink, std.memory.MemoryLayoutError>
{
    let sink: ByteSink = try byte_sink(capacity = capacity);

    return Ok(TextSink { bytes = sink, });
}

func text(pos sink: &TextSink) -> Result<string, std.string.Utf8Error>
{
    return std.string.from_utf8(bytes(&sink.bytes));
}

func text_bytes(pos sink: &mut TextSink) -> &mut ByteSink
{
    return &mut sink.bytes;
}

trait Format
{
    func format(
        pos destination: &mut ByteSink,
        pos options: &Options,
    ) -> Result<unit, std.memory.MemoryLayoutError>;
}
