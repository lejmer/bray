module std.hash;

const STABLE_INITIAL_STATE: u128 = 14695981039346656037;

const STABLE_MODULUS: u128 = 170141183460469231731687303715884105727;

const STABLE_MULTIPLIER: u128 = 1099511628211;

trait HashSink
{
    mut func write(pos value: u128) -> unit;
}

trait Hashable<Sink>
{
    func contribute(pos sink: &mut Sink) -> unit;
}

struct StableHasher
{
    internal mut state: u128;

    construct() -> Self
    {
        return
        {
            state = STABLE_INITIAL_STATE,
        };
    }
}

internal func add_modulo(pos left: u128, pos right: u128) -> u128
{
    let reduced_left: u128 = left % STABLE_MODULUS;
    let reduced_right: u128 = right % STABLE_MODULUS;
    let remaining: u128 = STABLE_MODULUS - reduced_right;

    if reduced_left >= remaining
    {
        return reduced_left - remaining;
    }

    return reduced_left + reduced_right;
}

internal func multiply_modulo(pos left: u128, pos right: u128) -> u128
{
    let mut factor: u128 = left % STABLE_MODULUS;
    let mut multiplier: u128 = right;
    let mut product: u128 = 0;

    while multiplier > 0
    {
        if multiplier % 2 == 1
        {
            product = add_modulo(product, factor);
        }

        factor = add_modulo(factor, factor);
        multiplier = multiplier / 2;
    }

    return product;
}

impl StableHasherSink = StableHasher(HashSink)
{
    mut func write(pos value: u128) -> unit
    {
        let mixed: u128 = add_modulo(self.state, value);

        self.state = multiply_modulo(mixed, STABLE_MULTIPLIER);
    }
}

func finish(pos hasher: &StableHasher) -> u128
{
    return hasher.state;
}

func stable_hash<Value>(pos value: &Value) -> u128
    with(Value: Hashable<StableHasher>)
{
    let mut hasher: StableHasher = StableHasher();

    value.contribute(&mut hasher);

    return finish(&hasher);
}

internal func contribute_unsigned<Value, Sink>(pos value: Value, pos sink: &mut Sink) -> unit
    with(Value: ConvertTo<u128>, Sink: HashSink)
{
    sink.write(value as u128);
}

impl BooleanHashable = bool(Hashable<Sink>) with(Sink: HashSink)
{
    func contribute(pos sink: &mut Sink) -> unit
    {
        if self
        {
            sink.write(1);
        }
        else
        {
            sink.write(0);
        }
    }
}

impl CharacterHashable = char(Hashable<Sink>) with(Sink: HashSink)
{
    func contribute(pos sink: &mut Sink) -> unit
    {
        contribute_unsigned<u32, Sink>(std.character.scalar_value(value = self), sink);
    }
}

impl U8Hashable = u8(Hashable<Sink>) with(Sink: HashSink)
{
    func contribute(pos sink: &mut Sink) -> unit
    {
        contribute_unsigned<u8, Sink>(self, sink);
    }
}

impl U16Hashable = u16(Hashable<Sink>) with(Sink: HashSink)
{
    func contribute(pos sink: &mut Sink) -> unit
    {
        contribute_unsigned<u16, Sink>(self, sink);
    }
}

impl U32Hashable = u32(Hashable<Sink>) with(Sink: HashSink)
{
    func contribute(pos sink: &mut Sink) -> unit
    {
        contribute_unsigned<u32, Sink>(self, sink);
    }
}

impl U64Hashable = u64(Hashable<Sink>) with(Sink: HashSink)
{
    func contribute(pos sink: &mut Sink) -> unit
    {
        contribute_unsigned<u64, Sink>(self, sink);
    }
}

impl U128Hashable = u128(Hashable<Sink>) with(Sink: HashSink)
{
    func contribute(pos sink: &mut Sink) -> unit
    {
        contribute_unsigned<u128, Sink>(self, sink);
    }
}

impl UsizeHashable = usize(Hashable<Sink>) with(Sink: HashSink)
{
    func contribute(pos sink: &mut Sink) -> unit
    {
        contribute_unsigned<usize, Sink>(self, sink);
    }
}

impl StringHashable = string(Hashable<Sink>) with(Sink: HashSink)
{
    func contribute(pos sink: &mut Sink) -> unit
    {
        let bytes: &[u8] = std.string.utf8(&self);
        let count: usize = std.bytes.slice_length(bytes);

        sink.write(count as u128);

        let mut index: usize = 0;

        while index < count
        {
            sink.write(bytes[index] as u128);

            index = index + 1;
        }
    }
}
