trusted module std.io;

trait Writer
{
    mut func write(pos source: &[u8]) -> Result<usize, IoError>
        requires(blocking_execution());

    mut func flush() -> Result<unit, IoError>
        requires(blocking_execution());

    /// Writes the complete borrowed byte range or reports the exact accepted prefix.
    mut func write_all(pos source: &[u8]) -> Result<unit, IoError>
        requires(blocking_execution())
    {
        let length: usize = source.length();
        let mut written: usize = 0;

        while written < length
        {
            let remaining: &[u8] = &source[written..length];
            let result: Result<usize, IoError> = self.write(remaining);

            match consume advance_transfer(
                result = result,
                completed = written,
                remaining = length - written,
                require_progress = true,
            )
            {
                case Ok(next) { written = next; }
                case Error(error) { return Error(error); }
            }
        }

        return Ok(unit);
    }
}

trait AsyncWriter
{
    mut async func write_async(pos source: &[u8]) -> Result<usize, IoError>
        requires(blocking_execution());

    mut async func flush_async() -> Result<unit, IoError>
        requires(blocking_execution());

    /// Asynchronously writes the complete borrowed byte range or reports the exact accepted prefix.
    mut async func write_all_async(pos source: &[u8]) -> Result<unit, IoError>
        requires(blocking_execution())
    {
        let length: usize = source.length();
        let mut written: usize = 0;

        while written < length
        {
            let remaining: &[u8] = &source[written..length];
            let result: Result<usize, IoError> = await self.write_async(remaining);

            match consume advance_transfer(
                result = result,
                completed = written,
                remaining = length - written,
                require_progress = true,
            )
            {
                case Ok(next) { written = next; }
                case Error(error) { return Error(error); }
            }
        }

        return Ok(unit);
    }
}

struct StandardOutput
{
    internal marker: bool;
}

struct StandardError
{
    internal marker: bool;
}

internal func normalize_buffer_drain_error(pos error: IoError) -> IoError
{
    return transferred_error(error, transferred = 0);
}

internal func buffer_bytes<Sink>(pos writer: &mut BufferedWriter<Sink>, pos source: &[u8]) -> usize
{
    let capacity: usize = writer.capacity;
    let available: usize = capacity - writer.length;
    let source_length: usize = source.length();
    let accepted: usize = smaller(source_length, available);
    let destination: &mut [u8] = writer.storage.as_slice_mut();

    if accepted > 0
    {
        let accepted_source: &[u8] = &source[0..accepted];
        let available_destination: &mut [u8] = &mut destination[writer.length..writer.length + accepted];
        let destination_pointer: RawPointer<u8> = internal std.memory.byte_slice_pointer_mut(available_destination);

        trusted internal std.memory.byte_buffer_copy(
            source = internal std.memory.byte_slice_pointer(accepted_source),
            destination = destination_pointer,
            count = accepted,
        );
    }

    writer.length += accepted;

    return accepted;
}

impl BufferedWriter<Sink>
{
    mut func drain_buffered() -> Result<usize, IoError>
        with(Sink: Writer)
        requires(blocking_execution())
    {
        let mut committed: usize = 0;

        while self.start < self.length
        {
            let pending_length: usize = self.length - self.start;

            let result: Result<usize, IoError> =
            {
                let bytes: &[u8] = self.storage.as_slice();
                let pending: &[u8] = &bytes[self.start..self.length];

                yield self.sink.write(pending);
            };

            match consume advance_transfer(
                result = result,
                completed = committed,
                remaining = pending_length,
                require_progress = true,
            )
            {
                case Ok(next)
                {
                    self.start += next - committed;
                    committed = next;
                }
                case Error(error)
                {
                    self.start += error.transferred - committed;

                    return Error(error);
                }
            }
        }

        self.start = 0;
        self.length = 0;

        return Ok(committed);
    }

    mut func flush_buffered() -> Result<unit, IoError>
        with(Sink: Writer)
        requires(blocking_execution())
    {
        let committed: usize = try self.drain_buffered();
        let result: Result<unit, IoError> = self.sink.flush();

        match consume result
        {
            case Ok(_) { return Ok(unit); }
            case Error(error) { return Error(prefixed_error(error, prefix = committed)); }
        }
    }

    mut func write_buffered(pos source: &[u8]) -> Result<usize, IoError>
        with(Sink: Writer)
        requires(blocking_execution())
    {
        let source_length: usize = source.length();

        if source_length == 0
        {
            return Ok(0);
        }

        if source_length <= self.capacity - self.length
        {
            return Ok(buffer_bytes(&mut self, source));
        }

        if self.length > 0
        {
            let drained: Result<usize, IoError> = self.drain_buffered();

            match consume drained
            {
                case Ok(_) {}
                case Error(error) { return Error(normalize_buffer_drain_error(error)); }
            }
        }

        if source_length >= self.capacity
        {
            let result: Result<usize, IoError> = self.sink.write(source);

            return advance_transfer(result = result, completed = 0, remaining = source_length, require_progress = true);
        }

        return Ok(buffer_bytes(&mut self, source));
    }

    mut async func drain_buffered_async() -> Result<usize, IoError>
        with(Sink: AsyncWriter)
        requires(blocking_execution())
    {
        let mut committed: usize = 0;

        while self.start < self.length
        {
            let pending_length: usize = self.length - self.start;

            let result: Result<usize, IoError> =
            {
                let bytes: &[u8] = self.storage.as_slice();
                let pending: &[u8] = &bytes[self.start..self.length];

                yield await self.sink.write_async(pending);
            };

            match consume advance_transfer(
                result = result,
                completed = committed,
                remaining = pending_length,
                require_progress = true,
            )
            {
                case Ok(next)
                {
                    self.start += next - committed;
                    committed = next;
                }
                case Error(error)
                {
                    self.start += error.transferred - committed;

                    return Error(error);
                }
            }
        }

        self.start = 0;
        self.length = 0;

        return Ok(committed);
    }

    mut async func flush_buffered_async() -> Result<unit, IoError>
        with(Sink: AsyncWriter)
        requires(blocking_execution())
    {
        let committed: usize = try await self.drain_buffered_async();
        let result: Result<unit, IoError> = await self.sink.flush_async();

        match consume result
        {
            case Ok(_) { return Ok(unit); }
            case Error(error) { return Error(prefixed_error(error, prefix = committed)); }
        }
    }

    mut async func write_buffered_async(pos source: &[u8]) -> Result<usize, IoError>
        with(Sink: AsyncWriter)
        requires(blocking_execution())
    {
        let source_length: usize = source.length();

        if source_length == 0
        {
            return Ok(0);
        }

        if source_length <= self.capacity - self.length
        {
            return Ok(buffer_bytes(&mut self, source));
        }

        if self.length > 0
        {
            let drained: Result<usize, IoError> = await self.drain_buffered_async();

            match consume drained
            {
                case Ok(_) {}
                case Error(error) { return Error(normalize_buffer_drain_error(error)); }
            }
        }

        if source_length >= self.capacity
        {
            let result: Result<usize, IoError> = await self.sink.write_async(source);

            return advance_transfer(result = result, completed = 0, remaining = source_length, require_progress = true);
        }

        return Ok(buffer_bytes(&mut self, source));
    }

    consume mut async func into_sink_async() -> Result<Sink, (Self, IoError)>
        with(Sink: AsyncWriter)
        requires(blocking_execution())
    {
        let result: Result<unit, IoError> = await self.flush_buffered_async();

        match consume result
        {
            case Ok(_) { return Ok(self.sink); }
            case Error(error) { return Error((self, error)); }
        }
    }

    consume mut func into_sink() -> Result<Sink, (Self, IoError)>
        with(Sink: Writer)
        requires(blocking_execution())
    {
        let result: Result<unit, IoError> = self.flush_buffered();

        match consume result
        {
            case Ok(_) { return Ok(self.sink); }
            case Error(error) { return Error((self, error)); }
        }
    }
}

impl BufferedWriterSinkWriter = BufferedWriter<Sink>(Writer)
    with(Sink: Writer)
{
    mut func write(pos source: &[u8]) -> Result<usize, IoError>
        requires(blocking_execution())
    {
        let result: Result<usize, IoError> = self.write_buffered(source);

        return result;
    }

    mut func flush() -> Result<unit, IoError>
        requires(blocking_execution())
    {
        let result: Result<unit, IoError> = self.flush_buffered();

        return result;
    }
}

impl BufferedWriterSinkAsyncWriter = BufferedWriter<Sink>(AsyncWriter)
    with(Sink: AsyncWriter)
{
    mut async func write_async(pos source: &[u8]) -> Result<usize, IoError>
        requires(blocking_execution())
    {
        let result: Result<usize, IoError> = await self.write_buffered_async(source);

        return result;
    }

    mut async func flush_async() -> Result<unit, IoError>
        requires(blocking_execution())
    {
        let result: Result<unit, IoError> = await self.flush_buffered_async();

        return result;
    }
}
