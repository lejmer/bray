trusted module std.io;

internal func support_buffered_writer<Sink>(pos sink: Sink, capacity: usize) -> Result<BufferedWriter<Sink>, IoError>
{
    if capacity == 0
    {
        return Error(support_io_error(
            kind = InvalidInput,
            native_code = 0,
            transferred = 0,
        ));
    }

    let storage: std.bytes.Buffer = try create_fixed_buffer(capacity = capacity);
    let start: usize = 0;
    let length: usize = 0;

    let writer: BufferedWriter<Sink> = {
        sink = sink,
        storage = storage,
        capacity = capacity,
        start = start,
        length = length,
    };

    return Ok(writer);
}

internal func normalize_write_flush_error(pos error: IoError) -> IoError
{
    return transferred_error(error, transferred = 0);
}

internal func buffer_bytes<Sink>(pos writer: &mut BufferedWriter<Sink>, pos source: &[u8]) -> usize
{
    let capacity: usize = writer.capacity;
    let available: usize = capacity - writer.length;
    let source_length: usize = internal std.memory.byte_slice_length(source);
    let accepted: usize = smaller(source_length, available);
    let destination: &mut [u8] = std.bytes.as_slice_mut(&mut writer.storage);

    let mut index: usize = 0;

    while index < accepted
    {
        destination[writer.length + index] = source[index];
        index = index + 1;
    }

    writer.length = writer.length + accepted;

    return accepted;
}

impl BufferedWriter<Sink>
{
    mut func support_flush() -> Result<unit, IoError>
        with(Sink: Writer)
        requires(blocking_execution())
    {
        let mut committed: usize = 0;

        while self.start < self.length
        {
            let pending_length: usize = self.length - self.start;

            let result: Result<usize, IoError> =
            {
                let bytes: &[u8] = std.bytes.as_slice(&self.storage);
                let pending: &[u8] = &bytes[self.start..self.length];

                yield self.sink.write(pending);
            };

            match consume result
            {
                case Ok(transferred)
                {
                    if transferred > pending_length
                    {
                        return Error(invalid_transfer_error(transferred = committed));
                    }

                    if transferred == 0
                    {
                        return Error(no_progress_error(transferred = committed));
                    }

                    self.start = self.start + transferred;
                    committed = committed + transferred;
                }
                case Error(error)
                {
                    if error.transferred > pending_length
                    {
                        return Error(invalid_transfer_error(transferred = committed));
                    }

                    let transferred: usize = error.transferred;

                    self.start = self.start + transferred;

                    return Error(prefixed_error(error, prefix = committed));
                }
            }
        }

        self.start = 0;
        self.length = 0;

        let result: Result<unit, IoError> = self.sink.flush();

        match consume result
        {
            case Ok(_)
            {
                return Ok(unit);
            }
            case Error(error)
            {
                return Error(prefixed_error(error, prefix = committed));
            }
        }
    }

    mut func support_write(pos source: &[u8]) -> Result<usize, IoError>
        with(Sink: Writer)
        requires(blocking_execution())
    {
        if self.length == self.capacity
        {
            let result: Result<unit, IoError> = self.support_flush();

            match consume result
            {
                case Ok(_)
                {
                }
                case Error(error)
                {
                    return Error(normalize_write_flush_error(error));
                }
            }
        }

        return Ok(buffer_bytes(&mut self, source));
    }

    mut async func support_flush_async() -> Result<unit, IoError>
        with(Sink: AsyncWriter)
        requires(blocking_execution())
    {
        let mut committed: usize = 0;

        while self.start < self.length
        {
            let pending_length: usize = self.length - self.start;

            let result: Result<usize, IoError> =
            {
                let bytes: &[u8] = std.bytes.as_slice(&self.storage);
                let pending: &[u8] = &bytes[self.start..self.length];

                yield await self.sink.write_async(pending);
            };

            match consume result
            {
                case Ok(transferred)
                {
                    if transferred > pending_length
                    {
                        return Error(invalid_transfer_error(transferred = committed));
                    }

                    if transferred == 0
                    {
                        return Error(no_progress_error(transferred = committed));
                    }

                    self.start = self.start + transferred;
                    committed = committed + transferred;
                }
                case Error(error)
                {
                    if error.transferred > pending_length
                    {
                        return Error(invalid_transfer_error(transferred = committed));
                    }

                    let transferred: usize = error.transferred;

                    self.start = self.start + transferred;

                    return Error(prefixed_error(error, prefix = committed));
                }
            }
        }

        self.start = 0;
        self.length = 0;

        let result: Result<unit, IoError> = await self.sink.flush_async();

        match consume result
        {
            case Ok(_)
            {
                return Ok(unit);
            }
            case Error(error)
            {
                return Error(prefixed_error(error, prefix = committed));
            }
        }
    }

    mut async func support_write_async(pos source: &[u8]) -> Result<usize, IoError>
        with(Sink: AsyncWriter)
        requires(blocking_execution())
    {
        if self.length == self.capacity
        {
            let result: Result<unit, IoError> = await self.support_flush_async();

            match consume result
            {
                case Ok(_)
                {
                }
                case Error(error)
                {
                    return Error(normalize_write_flush_error(error));
                }
            }
        }

        return Ok(buffer_bytes(&mut self, source));
    }
}

impl BufferedWriter<Sink>
{
    consume func into_sink() -> Result<Sink, IoError>
        with(Sink: Writer)
        requires(blocking_execution())
    {
        let result: Result<unit, IoError> = self.support_flush();

        match consume result
        {
            case Ok(_)
            {
                return Ok(self.sink);
            }
            case Error(error)
            {
                return Error(error);
            }
        }
    }
}

impl BufferedWriterSinkWriter = BufferedWriter<Sink>(Writer)
    with(Sink: Writer)
{
    mut func write(pos source: &[u8]) -> Result<usize, IoError>
        requires(blocking_execution())
    {
        let result: Result<usize, IoError> = self.support_write(source);

        return result;
    }

    mut func flush() -> Result<unit, IoError>
        requires(blocking_execution())
    {
        let result: Result<unit, IoError> = self.support_flush();

        return result;
    }
}

impl BufferedWriterSinkAsyncWriter = BufferedWriter<Sink>(AsyncWriter)
    with(Sink: AsyncWriter)
{
    mut async func write_async(pos source: &[u8]) -> Result<usize, IoError>
        requires(blocking_execution())
    {
        let result: Result<usize, IoError> = await self.support_write_async(source);

        return result;
    }

    mut async func flush_async() -> Result<unit, IoError>
        requires(blocking_execution())
    {
        let result: Result<unit, IoError> = await self.support_flush_async();

        return result;
    }
}
