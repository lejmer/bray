trusted module std.io;

trait Reader
{
    mut func read(pos destination: &mut [u8]) -> Result<usize, IoError>
        requires(blocking_execution());
}

trait AsyncReader
{
    mut async func read_async(pos destination: &mut [u8]) -> Result<usize, IoError>
        requires(blocking_execution());
}

struct StandardInput
{
    internal marker: bool;
}

/// Fills the borrowed byte range or reports the exact initialized prefix.
func read_exact<Source>(pos source: &mut Source, pos destination: &mut [u8]) -> Result<unit, IoError>
    with(Source: Reader)
    requires(blocking_execution())
{
    let length: usize = internal std.memory.slice_length<u8>(&destination);
    let mut read: usize = 0;

    while read < length
    {
        let remaining: &mut [u8] = &mut destination[read..length];
        let result: Result<usize, IoError> = source.read(remaining);

        match consume advance_transfer(
            result = result,
            completed = read,
            remaining = length - read,
            require_progress = true,
        )
        {
            case Ok(next) { read = next; }
            case Error(error) { return Error(error); }
        }
    }

    return Ok(unit);
}

/// Asynchronously fills the borrowed byte range or reports the exact initialized prefix.
async func read_exact_async<Source>(pos source: &mut Source, pos destination: &mut [u8]) -> Result<unit, IoError>
    with(Source: AsyncReader)
    requires(blocking_execution())
{
    let length: usize = internal std.memory.slice_length<u8>(&destination);
    let mut read: usize = 0;

    while read < length
    {
        let remaining: &mut [u8] = &mut destination[read..length];
        let result: Result<usize, IoError> = await source.read_async(remaining);

        match consume advance_transfer(
            result = result,
            completed = read,
            remaining = length - read,
            require_progress = true,
        )
        {
            case Ok(next) { read = next; }
            case Error(error) { return Error(error); }
        }
    }

    return Ok(unit);
}

internal func copy_buffered_bytes<Source>(pos reader: &mut BufferedReader<Source>, pos destination: &mut [u8]) -> usize
{
    let destination_length: usize = internal std.memory.slice_length<u8>(&destination);

    let available: usize = reader.length - reader.start;
    let copied: usize = smaller(destination_length, available);

    if copied > 0
    {
        let buffered: &[u8] = std.bytes.as_slice(&reader.storage);
        let source: &[u8] = &buffered[reader.start..reader.start + copied];
        let destination_pointer: RawPointer<u8> = internal std.memory.byte_slice_pointer_mut(destination);

        trusted internal std.memory.byte_slice_copy(source = source, destination = destination_pointer);
    }

    reader.start += copied;

    if reader.start == reader.length
    {
        reader.start = 0;
        reader.length = 0;
    }

    return copied;
}

internal func buffered_read_result<Source>(
    pos reader: &mut BufferedReader<Source>,
    pos destination: &mut [u8],
    result: Result<usize, IoError>,
) -> Result<usize, IoError>
{
    let capacity: usize = reader.capacity;

    match consume result
    {
        case Ok(transferred)
        {
            if transferred > capacity
            {
                return Error(invalid_transfer_error());
            }

            reader.start = 0;
            reader.length = transferred;

            return Ok(copy_buffered_bytes(reader, destination));
        }
        case Error(error)
        {
            if error.transferred > capacity
            {
                return Error(invalid_transfer_error());
            }

            reader.start = 0;
            reader.length = error.transferred;

            let copied: usize = copy_buffered_bytes(reader, destination);

            return Error(transferred_error(error, transferred = copied));
        }
    }
}

internal func read_buffered<Source>(
    pos reader: &mut BufferedReader<Source>,
    pos destination: &mut [u8],
) -> Result<usize, IoError>
    with(Source: Reader)
    requires(blocking_execution())
{
    if reader.length > reader.start
    {
        return Ok(copy_buffered_bytes(reader, destination));
    }

    let destination_length: usize = internal std.memory.slice_length<u8>(&destination);

    if destination_length == 0
    {
        let transferred: usize = 0;

        return Ok(transferred);
    }

    if destination_length >= reader.capacity
    {
        let result: Result<usize, IoError> = reader.source.read(destination);

        return advance_transfer(
            result = result,
            completed = 0,
            remaining = destination_length,
            require_progress = false,
        );
    }

    let result: Result<usize, IoError> =
    {
        let storage: &mut [u8] = std.bytes.as_slice_mut(&mut reader.storage);

        yield reader.source.read(storage);
    };

    return buffered_read_result(reader, destination, result = result);
}

internal async func read_buffered_async<Source>(
    pos reader: &mut BufferedReader<Source>,
    pos destination: &mut [u8],
) -> Result<usize, IoError>
    with(Source: AsyncReader)
    requires(blocking_execution())
{
    if reader.length > reader.start
    {
        return Ok(copy_buffered_bytes(reader, destination));
    }

    let destination_length: usize = internal std.memory.slice_length<u8>(&destination);

    if destination_length == 0
    {
        let transferred: usize = 0;

        return Ok(transferred);
    }

    if destination_length >= reader.capacity
    {
        let result: Result<usize, IoError> = await reader.source.read_async(destination);

        return advance_transfer(
            result = result,
            completed = 0,
            remaining = destination_length,
            require_progress = false,
        );
    }

    let result: Result<usize, IoError> =
    {
        yield await reader.source.read_async(std.bytes.as_slice_mut(&mut reader.storage));
    };

    return buffered_read_result(reader, destination, result = result);
}

impl BufferedReader<Source>
{
    consume func into_source() -> Source
    {
        return self.source;
    }
}

impl BufferedReaderSourceReader = BufferedReader<Source>(Reader)
    with(Source: Reader)
{
    mut func read(pos destination: &mut [u8]) -> Result<usize, IoError>
        requires(blocking_execution())
    {
        return read_buffered(&mut self, destination);
    }
}

impl BufferedReaderSourceAsyncReader = BufferedReader<Source>(AsyncReader)
    with(Source: AsyncReader)
{
    mut async func read_async(pos destination: &mut [u8]) -> Result<usize, IoError>
        requires(blocking_execution())
    {
        return await read_buffered_async(&mut self, destination);
    }
}
