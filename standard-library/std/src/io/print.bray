trusted module std.io;

internal func checked_flush_result(result: Result<unit, IoError>, written: usize) -> Result<unit, IoError>
{
    match consume result
    {
        case Ok(_) { return Ok(unit); }
        case Error(error) { return Error(prefixed_error(error, prefix = written)); }
    }
}

internal func flush_after_write<Sink>(pos sink: &mut Sink, written: usize) -> Result<unit, IoError>
    with(Sink: Writer)
    requires(blocking_execution())
{
    let result: Result<unit, IoError> = sink.flush();

    return checked_flush_result(result = result, written = written);
}

/// Writes text to standard output, flushes the stream, and reports exact accepted progress on failure.
func print(pos text: string) -> Result<unit, IoError>
    requires(blocking_execution())
{
    let lock: StandardOutputLock = try trusted acquire_standard_output();
    let mut output: UnlockedStandardOutput = unlocked_standard_output();
    let bytes: &[u8] = std.string.utf8(&text);
    let length: usize = internal std.memory.slice_length<u8>(bytes);

    try write_all(&mut output, bytes);

    return flush_after_write(&mut output, written = length);
}

/// Writes text and a line ending to standard output, then flushes the stream.
func print_line(pos text: string) -> Result<unit, IoError>
    requires(blocking_execution())
{
    let lock: StandardOutputLock = try trusted acquire_standard_output();
    let mut output: UnlockedStandardOutput = unlocked_standard_output();
    let bytes: &[u8] = std.string.utf8(&text);
    let length: usize = internal std.memory.slice_length<u8>(bytes);

    try write_all(&mut output, bytes);

    let newline: &[u8] = std.string.utf8(&"\n");
    let newline_result: Result<unit, IoError> = write_all(&mut output, newline);

    match consume newline_result
    {
        case Ok(_) { return flush_after_write(&mut output, written = length + 1); }
        case Error(error) { return Error(prefixed_error(error, prefix = length)); }
    }
}

/// Performs `print` through an asynchronous callable.
async func print_async(pos text: string) -> Result<unit, IoError>
    requires(blocking_execution())
{
    return print(text);
}

/// Performs `print_line` through an asynchronous callable.
async func print_line_async(pos text: string) -> Result<unit, IoError>
    requires(blocking_execution())
{
    return print_line(text);
}
