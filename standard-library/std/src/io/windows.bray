@target(target.identity.NAME == "x86_64-pc-windows-msvc" || target.identity.NAME == "aarch64-pc-windows-msvc")
trusted module std.io;

using std.os.windows;

@abi(c)
trusted internal func platform_standard_input_read(
    pos destination: RawPointer<u8>,
    pos length: u64,
    pos transferred: RawPointer<u64>,
) -> std.platform.PlatformStatus
    uses(foreign_call)
{
    return trusted internal std.platform.handle_read(
        trusted std.os.windows.get_standard_handle(std.os.windows.STD_INPUT_HANDLE),
        destination = destination,
        length = length,
        transferred = transferred,
    );
}

@abi(c)
trusted internal func platform_standard_output_write(
    pos source: RawPointer<u8>,
    pos length: u64,
    pos transferred: RawPointer<u64>,
) -> std.platform.PlatformStatus
    uses(foreign_call)
{
    return trusted internal std.platform.handle_write(
        trusted std.os.windows.get_standard_handle(std.os.windows.STD_OUTPUT_HANDLE),
        source = source,
        length = length,
        transferred = transferred,
    );
}

@abi(c)
trusted internal func platform_standard_error_write(
    pos source: RawPointer<u8>,
    pos length: u64,
    pos transferred: RawPointer<u64>,
) -> std.platform.PlatformStatus
    uses(foreign_call)
{
    return trusted internal std.platform.handle_write(
        trusted std.os.windows.get_standard_handle(std.os.windows.STD_ERROR_HANDLE),
        source = source,
        length = length,
        transferred = transferred,
    );
}
