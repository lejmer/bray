trusted module std.io;

@abi(c)
extern trusted internal func platform_standard_input_read(
    pos destination: RawPointer<u8>,
    pos length: u64,
    pos transferred: RawPointer<u64>,
) -> std.platform.PlatformStatus
    uses(foreign_call);

@abi(c)
extern trusted internal func platform_standard_input_lock() -> std.platform.PlatformStatus
    uses(foreign_call);

@abi(c)
extern trusted internal func platform_standard_input_unlock() -> std.platform.PlatformStatus
    uses(foreign_call);

@abi(c)
extern trusted internal func platform_standard_output_write(
    pos source: RawPointer<u8>,
    pos length: u64,
    pos transferred: RawPointer<u64>,
) -> std.platform.PlatformStatus
    uses(foreign_call);

@abi(c)
extern trusted internal func platform_standard_output_flush() -> std.platform.PlatformStatus
    uses(foreign_call);

@abi(c)
extern trusted internal func platform_standard_output_lock() -> std.platform.PlatformStatus
    uses(foreign_call);

@abi(c)
extern trusted internal func platform_standard_output_unlock() -> std.platform.PlatformStatus
    uses(foreign_call);

@abi(c)
extern trusted internal func platform_standard_error_write(
    pos source: RawPointer<u8>,
    pos length: u64,
    pos transferred: RawPointer<u64>,
) -> std.platform.PlatformStatus
    uses(foreign_call);

@abi(c)
extern trusted internal func platform_standard_error_flush() -> std.platform.PlatformStatus
    uses(foreign_call);

@abi(c)
extern trusted internal func platform_standard_error_lock() -> std.platform.PlatformStatus
    uses(foreign_call);

@abi(c)
extern trusted internal func platform_standard_error_unlock() -> std.platform.PlatformStatus
    uses(foreign_call);

internal struct StandardInputLock
{
    acquired: bool;

    trusted destruct()
        uses(foreign_call)
    {
        if self.acquired
        {
            let _: std.platform.PlatformStatus = trusted platform_standard_input_unlock();
        }
    }
}

internal struct StandardOutputLock
{
    acquired: bool;

    trusted destruct()
        uses(foreign_call)
    {
        if self.acquired
        {
            let _: std.platform.PlatformStatus = trusted platform_standard_output_unlock();
        }
    }
}

internal struct StandardErrorLock
{
    acquired: bool;

    trusted destruct()
        uses(foreign_call)
    {
        if self.acquired
        {
            let _: std.platform.PlatformStatus = trusted platform_standard_error_unlock();
        }
    }
}

func standard_input() -> StandardInput
{
    return StandardInput
    {
        marker = true
    };
}

func standard_output() -> StandardOutput
{
    return StandardOutput
    {
        marker = true
    };
}

func standard_error() -> StandardError
{
    return StandardError
    {
        marker = true
    };
}

internal func platform_error_kind(pos category: u32) -> IoErrorKind
{
    match category
    {
        case 1 { return Unsupported; }
        case 2 { return PermissionDenied; }
        case 3 { return NotFound; }
        case 4 { return AlreadyExists; }
        case 5 { return InvalidInput; }
        case 6 { return Interrupted; }
        case 7 { return Exhausted; }
        case 8 { return BrokenStream; }
        case 9 { return TimedOut; }
        case _ { return Other; }
    }
}

internal func io_error(kind: IoErrorKind, native_code: i64, transferred: usize) -> IoError
{
    let mut platform_code: i64? = none;

    if native_code != 0
    {
        platform_code = native_code;
    }

    return IoError
    {
        kind = kind,
        platform_code = platform_code,
        transferred = transferred,
    };
}

internal func platform_status_error(pos status: std.platform.PlatformStatus, transferred: usize = 0) -> IoError
{
    let category: u32 = status.category;
    let kind: IoErrorKind = platform_error_kind(category);
    let native_code: i64 = status.native_code;

    return io_error(kind = kind, native_code = native_code, transferred = transferred);
}

internal func invalid_transfer_error(transferred: usize = 0) -> IoError
{
    return io_error(kind = Other, native_code = 0, transferred = transferred);
}

internal func unavailable_stream_error() -> IoError
{
    return io_error(kind = Unsupported, native_code = 0, transferred = 0);
}

internal func no_progress_error(transferred: usize = 0) -> IoError
{
    return io_error(kind = BrokenStream, native_code = 0, transferred = transferred);
}

internal func checked_transfer(
    pos status: std.platform.PlatformStatus,
    transferred: u64,
    maximum: usize,
    require_progress: bool,
) -> Result<usize, IoError>
{
    if status.reserved != 0
    {
        return Error(invalid_transfer_error());
    }

    let transferred_count: usize = transferred as usize;

    if transferred_count > maximum
    {
        return Error(invalid_transfer_error());
    }

    if status.category != 0
    {
        return Error(platform_status_error(status, transferred = transferred_count));
    }

    if require_progress && maximum > 0 && transferred_count == 0
    {
        return Error(no_progress_error());
    }

    return Ok(transferred_count);
}

internal func checked_status(pos status: std.platform.PlatformStatus) -> Result<unit, IoError>
{
    if status.reserved != 0
    {
        return Error(invalid_transfer_error());
    }

    if status.category != 0
    {
        return Error(platform_status_error(status));
    }

    return Ok(unit);
}

trusted internal func acquire_standard_output() -> Result<StandardOutputLock, IoError>
    requires(blocking_execution())
    uses(foreign_call)
{
    let status: std.platform.PlatformStatus = trusted platform_standard_output_lock();

    match consume checked_status(status)
    {
        case Ok(_)
        {
            return Ok(
                StandardOutputLock
                {
                    acquired = true,
                }
            );
        }
        case Error(error) { return Error(error); }
    }
}

trusted internal func acquire_standard_input() -> Result<StandardInputLock, IoError>
    requires(blocking_execution())
    uses(foreign_call)
{
    let status: std.platform.PlatformStatus = trusted platform_standard_input_lock();

    match consume checked_status(status)
    {
        case Ok(_)
        {
            return Ok(
                StandardInputLock
                {
                    acquired = true,
                }
            );
        }
        case Error(error) { return Error(error); }
    }
}

trusted internal func acquire_standard_error() -> Result<StandardErrorLock, IoError>
    requires(blocking_execution())
    uses(foreign_call)
{
    let status: std.platform.PlatformStatus = trusted platform_standard_error_lock();

    match consume checked_status(status)
    {
        case Ok(_)
        {
            return Ok(
                StandardErrorLock
                {
                    acquired = true
                }
            );
        }
        case Error(error) { return Error(error); }
    }
}

trusted internal func write_standard_output_unlocked(pos source: &[u8]) -> Result<usize, IoError>
    requires(blocking_execution())
    uses(foreign_call)
{
    let requested: usize = internal std.memory.slice_length<u8>(source);
    let source_pointer: RawPointer<u8> = internal std.memory.byte_slice_pointer(source);
    let mut transferred: u64 = 0;
    let transferred_pointer: RawPointer<u64> = std.memory.address_of_mut<u64>(&mut transferred);

    let status: std.platform.PlatformStatus = trusted platform_standard_output_write(
        source = source_pointer,
        length = requested as u64,
        transferred = transferred_pointer,
    );

    return checked_transfer(status, transferred = transferred, maximum = requested, require_progress = true);
}

trusted internal func write_standard_error_unlocked(pos source: &[u8]) -> Result<usize, IoError>
    requires(blocking_execution())
    uses(foreign_call)
{
    let requested: usize = internal std.memory.slice_length<u8>(source);
    let mut transferred: u64 = 0;

    let status: std.platform.PlatformStatus = trusted platform_standard_error_write(
        source = internal std.memory.byte_slice_pointer(source),
        length = requested as u64,
        transferred = std.memory.address_of_mut<u64>(&mut transferred),
    );

    return checked_transfer(status, transferred = transferred, maximum = requested, require_progress = true);
}

internal func write_standard_output(pos source: &[u8]) -> Result<usize, IoError>
    requires(blocking_execution())
{
    let lock: StandardOutputLock = try trusted acquire_standard_output();
    let result: Result<usize, IoError> = trusted write_standard_output_unlocked(source);

    return result;
}

internal func write_standard_error(pos source: &[u8]) -> Result<usize, IoError>
    requires(blocking_execution())
{
    let lock: StandardErrorLock = try trusted acquire_standard_error();

    return trusted write_standard_error_unlocked(source);
}

trusted internal func flush_standard_output_unlocked() -> Result<unit, IoError>
    requires(blocking_execution())
    uses(foreign_call)
{
    let status: std.platform.PlatformStatus = trusted platform_standard_output_flush();

    return checked_status(status);
}

trusted internal func flush_standard_error_unlocked() -> Result<unit, IoError>
    requires(blocking_execution())
    uses(foreign_call)
{
    return checked_status(trusted platform_standard_error_flush());
}

internal func flush_standard_output() -> Result<unit, IoError>
    requires(blocking_execution())
{
    let lock: StandardOutputLock = try trusted acquire_standard_output();
    let result: Result<unit, IoError> = trusted flush_standard_output_unlocked();

    return result;
}

internal func flush_standard_error() -> Result<unit, IoError>
    requires(blocking_execution())
{
    let lock: StandardErrorLock = try trusted acquire_standard_error();

    return trusted flush_standard_error_unlocked();
}

trusted internal func read_standard_input(pos destination: &mut [u8]) -> Result<usize, IoError>
    requires(blocking_execution())
    uses(foreign_call)
{
    let lock: StandardInputLock = try trusted acquire_standard_input();
    let capacity: usize = internal std.memory.slice_length<u8>(&destination);
    let destination_pointer: RawPointer<u8> = internal std.memory.byte_slice_pointer_mut(destination);
    let mut transferred: u64 = 0;
    let transferred_pointer: RawPointer<u64> = std.memory.address_of_mut<u64>(&mut transferred);

    let status: std.platform.PlatformStatus = trusted platform_standard_input_read(
        destination = destination_pointer,
        length = capacity as u64,
        transferred = transferred_pointer,
    );

    return checked_transfer(status, transferred = transferred, maximum = capacity, require_progress = false);
}

impl StandardInputReader = StandardInput(Reader)
{
    mut func read(pos destination: &mut [u8]) -> Result<usize, IoError>
        requires(blocking_execution())
    {
        return trusted read_standard_input(destination);
    }
}

impl StandardOutputWriter = StandardOutput(Writer)
{
    mut func write(pos source: &[u8]) -> Result<usize, IoError>
        requires(blocking_execution())
    {
        return write_standard_output(source);
    }

    mut func flush() -> Result<unit, IoError>
        requires(blocking_execution())
    {
        return flush_standard_output();
    }
}

impl StandardErrorWriter = StandardError(Writer)
{
    mut func write(pos source: &[u8]) -> Result<usize, IoError>
        requires(blocking_execution())
    {
        return write_standard_error(source);
    }

    mut func flush() -> Result<unit, IoError>
        requires(blocking_execution())
    {
        return flush_standard_error();
    }
}

impl StandardInputAsyncReader = StandardInput(AsyncReader)
{
    mut async func read_async(pos destination: &mut [u8]) -> Result<usize, IoError>
        requires(blocking_execution())
    {
        return trusted read_standard_input(destination);
    }
}

impl StandardOutputAsyncWriter = StandardOutput(AsyncWriter)
{
    mut async func write_async(pos source: &[u8]) -> Result<usize, IoError>
        requires(blocking_execution())
    {
        return write_standard_output(source);
    }

    mut async func flush_async() -> Result<unit, IoError>
        requires(blocking_execution())
    {
        return flush_standard_output();
    }
}

impl StandardErrorAsyncWriter = StandardError(AsyncWriter)
{
    mut async func write_async(pos source: &[u8]) -> Result<usize, IoError>
        requires(blocking_execution())
    {
        return write_standard_error(source);
    }

    mut async func flush_async() -> Result<unit, IoError>
        requires(blocking_execution())
    {
        return flush_standard_error();
    }
}
