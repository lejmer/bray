trusted module std.io;

struct BufferedReader<Source>
{
    internal mut source: Source;
    internal mut storage: std.bytes.Buffer;
    internal capacity: usize;
    internal mut start: usize;
    internal mut length: usize;
}

struct BufferedWriter<Sink>
{
    internal mut sink: Sink;
    internal mut storage: std.bytes.Buffer;
    internal capacity: usize;
    internal mut start: usize;
    internal mut length: usize;
}

internal func buffer_allocation_error() -> IoError
{
    return io_error(
        kind = Exhausted,
        native_code = 0,
        transferred = 0,
    );
}

internal func create_fixed_buffer(capacity: usize) -> Result<std.bytes.Buffer, IoError>
{
    let created: Result<std.bytes.Buffer, std.memory.MemoryLayoutError> =
        std.bytes.create(capacity = capacity);

    match consume created
    {
        case Ok(buffer)
        {
            let mut buffer: std.bytes.Buffer = buffer;

            let resized: Result<unit, std.memory.MemoryLayoutError> =
                std.bytes.resize(
                    buffer = &mut buffer,
                    new_length = capacity,
                );

            match consume resized
            {
                case Ok(_)
                {
                    return Ok(buffer);
                }
                case Error(_)
                {
                    return Error(buffer_allocation_error());
                }
            }
        }
        case Error(_)
        {
            return Error(buffer_allocation_error());
        }
    }
}

internal func transferred_error(pos error: IoError, transferred: usize) -> IoError
{
    let kind: IoErrorKind = error.kind;
    let platform_code: i64? = error.platform_code;

    let native_code: i64 = match platform_code
    {
        case ?code
        {
            yield code;
        }

        case none
        {
            yield 0;
        }
    };

    return io_error(
        kind = kind,
        native_code = native_code,
        transferred = transferred,
    );
}

internal func prefixed_error(pos error: IoError, prefix: usize) -> IoError
{
    let maximum: usize = ~0;

    if error.transferred > maximum - prefix
    {
        return invalid_transfer_error(transferred = prefix);
    }

    let transferred: usize = prefix + error.transferred;

    return transferred_error(
        error,
        transferred = transferred,
    );
}

internal func smaller(pos left: usize, pos right: usize) -> usize
{
    if left < right
    {
        return left;
    }

    return right;
}
