trusted module std.io;

struct BufferedReader<Source>
{
    internal mut source: Source;
    internal mut storage: std.bytes.Buffer;
    internal capacity: usize;
    internal mut start: usize;
    internal mut length: usize;

    construct(pos source: Source, capacity: usize) -> Result<Self, IoError>
        requires(capacity > 0)
    {
        if capacity == 0
        {
            return Error(io_error(kind = InvalidInput, native_code = 0, transferred = 0));
        }

        let storage: std.bytes.Buffer = try allocate_fixed_buffer(capacity = capacity);

        let reader: BufferedReader<Source> =
        {
            source = source,
            storage = storage,
            capacity = capacity,
            start = 0,
            length = 0,
        };

        return Ok(reader);
    }
}

struct BufferedWriter<Sink>
{
    internal mut sink: Sink;
    internal mut storage: std.bytes.Buffer;
    internal capacity: usize;
    internal mut start: usize;
    internal mut length: usize;

    construct(pos sink: Sink, capacity: usize) -> Result<Self, IoError>
        requires(capacity > 0)
    {
        if capacity == 0
        {
            return Error(io_error(kind = InvalidInput, native_code = 0, transferred = 0));
        }

        let storage: std.bytes.Buffer = try allocate_fixed_buffer(capacity = capacity);

        let writer: BufferedWriter<Sink> =
        {
            sink = sink,
            storage = storage,
            capacity = capacity,
            start = 0,
            length = 0,
        };

        return Ok(writer);
    }
}

internal func buffer_allocation_error() -> IoError
{
    return io_error(kind = Exhausted, native_code = 0, transferred = 0);
}

internal func allocate_fixed_buffer(capacity: usize) -> Result<std.bytes.Buffer, IoError>
{
    let created: Result<std.bytes.Buffer, std.memory.MemoryLayoutError> = std.bytes.Buffer(capacity = capacity);

    match consume created
    {
        case Ok(buffer)
        {
            let mut buffer: std.bytes.Buffer = buffer;

            let resized: Result<unit, std.memory.MemoryLayoutError> = std.bytes.resize(
                buffer = &mut buffer,
                new_length = capacity,

            );

            match consume resized
            {
                case Ok(_) { return Ok(buffer); }
                case Error(_) { return Error(buffer_allocation_error()); }
            }
        }
        case Error(_) { return Error(buffer_allocation_error()); }
    }
}

internal func transferred_error(pos error: IoError, transferred: usize) -> IoError
{
    let kind: IoErrorKind = error.kind;
    let platform_code: i64? = error.platform_code;

    let native_code: i64 = match platform_code
    {
        case ?code { yield code; }
        case none { yield 0; }
    };

    return io_error(kind = kind, native_code = native_code, transferred = transferred);
}

internal func prefixed_error(pos error: IoError, prefix: usize) -> IoError
{
    let maximum: usize = ~0;

    if error.transferred > maximum - prefix
    {
        return invalid_transfer_error(transferred = prefix);
    }

    let transferred: usize = prefix + error.transferred;

    return transferred_error(error, transferred = transferred);
}

internal func smaller(pos left: usize, pos right: usize) -> usize
{
    if left < right
    {
        return left;
    }

    return right;
}
