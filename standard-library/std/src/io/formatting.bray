trusted module std.io;

using std.format;

/// Adapts a blocking byte writer for direct formatted output.
struct FormattingSink<Destination>
{
    internal mut destination: &mut Destination;

    construct(pos destination: &mut Destination) -> Self
    {
        return
        {
            destination = destination,
        };
    }
}

impl WriterFormattingSink = FormattingSink<Destination>(std.format.Sink<std.io.IoError>)
    with(Destination: std.io.Writer)
{
    mut func prepare(additional: usize) -> Result<unit, std.io.IoError>
        requires(blocking_execution())
    {
        return Ok(unit);
    }

    mut func write(pos source: &[u8]) -> Result<unit, std.io.IoError>
        requires(blocking_execution())
    {
        let length: usize = std.bytes.slice_length(source);
        let mut written: usize = 0;

        while written < length
        {
            let remaining: &[u8] = &source[written.. length];
            let result: Result<usize, std.io.IoError> = self.destination(std.io.Writer).write(remaining);

            match consume advance_write_all(result = result, written = written, remaining = length - written)
            {
                case Ok(next) { written = next; }
                case Error(error) { return Error(error); }
            }
        }

        return Ok(unit);
    }

    mut func write_repeated(value: u8, count: usize) -> Result<unit, std.io.IoError>
        requires(blocking_execution())
    {
        let chunk: [u8; 64] = [value; 64];
        let mut written: usize = 0;

        while written < count
        {
            let remaining_count: usize = count - written;
            let chunk_length: usize = smaller(remaining_count, 64);
            let mut chunk_written: usize = 0;

            while chunk_written < chunk_length
            {
                let remaining: &[u8] = &chunk[chunk_written.. chunk_length];
                let result: Result<usize, std.io.IoError> = self.destination(std.io.Writer).write(remaining);

                match consume advance_write_all(
                    result = result,
                    written = written + chunk_written,
                    remaining = chunk_length - chunk_written,
                )
                {
                    case Ok(next) { chunk_written = next - written; }
                    case Error(error) { return Error(error); }
                }
            }

            written += chunk_length;
        }

        return Ok(unit);
    }
}
