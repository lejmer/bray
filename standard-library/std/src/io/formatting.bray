trusted module std.io;

using std.format;

/// Adapts a blocking byte writer for direct formatted output.
struct FormattingSink<Destination>
{
    internal mut destination: &mut Destination;

    construct(pos destination: &mut Destination) -> Self
    {
        return
        {
            destination = destination,
        };
    }
}

impl WriterFormattingSink = FormattingSink<Destination>(std.format.Sink<std.io.IoError>)
    with(Destination: std.io.Writer)
{
    mut func prepare(additional: usize) -> Result<unit, std.io.IoError>
        requires(blocking_execution())
    {
        return Ok(unit);
    }

    mut func write(pos source: &[u8]) -> Result<unit, std.io.IoError>
        requires(blocking_execution())
    {
        return write_all<Destination>(&mut self.destination, source);
    }

    mut func write_repeated(value: u8, count: usize) -> Result<unit, std.io.IoError>
        requires(blocking_execution())
    {
        let chunk: [u8; 64] = [value; 64];
        let mut written: usize = 0;

        while written < count
        {
            let remaining_count: usize = count - written;
            let chunk_length: usize = smaller(remaining_count, 64);

            let result: Result<unit, std.io.IoError> = write_all<Destination>(
                &mut self.destination,
                &chunk[0..chunk_length]
            );

            match consume result
            {
                case Ok(_) { written += chunk_length; }
                case Error(error) { return Error(prefixed_error(error, prefix = written)); }
            }
        }

        return Ok(unit);
    }
}
