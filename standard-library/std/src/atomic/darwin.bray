@target(target.identity.NAME == "x86_64-apple-darwin" || target.identity.NAME == "aarch64-apple-darwin")
module std.atomic;

using core.atomic;
using std.memory;
using std.os.darwin;

trusted internal func platform_wait_word_for(
    pos storage: &core.atomic.Atomic<u32>,
    pos expected: u32,
    pos timeout_milliseconds: u32,
)
    requires(blocking_execution())
    uses(foreign_call, layout_reinterpret)
{
    let address: DataPointer<u32> = trusted internal word_pointer(storage);
    let bytes: DataPointer<u8> = trusted std.memory.reinterpret<u8, u32>(address);

    let _: i32 = trusted std.os.darwin.os_sync_wait_on_address_with_timeout(
        bytes,
        expected = expected as u64,
        size = 4,
        flags = std.os.darwin.OS_SYNC_WAIT_ON_ADDRESS_NONE,
        clock = std.os.darwin.OS_CLOCK_MACH_ABSOLUTE_TIME,
        timeout_nanoseconds = (timeout_milliseconds as u64) * 1_000_000,
    );
}
