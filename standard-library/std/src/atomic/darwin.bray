@target(target.identity.NAME == "x86_64-apple-darwin" || target.identity.NAME == "aarch64-apple-darwin")
module std.atomic;

trusted internal func platform_wait_word(pos storage: &core.atomic.Atomic<u32>, pos expected: u32)
    uses(foreign_call)
{
    let address: RawPointer<u32> = trusted internal word_pointer(storage);
    let bytes: RawPointer<u8> = trusted std.memory.reinterpret<u8, u32>(address);

    let _: i32 = trusted std.os.darwin.os_sync_wait_on_address(
        bytes,
        expected = expected as u64,
        size = 4,
        flags = std.os.darwin.OS_SYNC_WAIT_ON_ADDRESS_NONE,
    );
}

trusted internal func platform_wake_word(pos storage: &core.atomic.Atomic<u32>)
    uses(foreign_call)
{
    let address: RawPointer<u32> = trusted internal word_pointer(storage);
    let bytes: RawPointer<u8> = trusted std.memory.reinterpret<u8, u32>(address);

    let _: i32 = trusted std.os.darwin.os_sync_wake_by_address_any(
        bytes,
        size = 4,
        flags = std.os.darwin.OS_SYNC_WAKE_BY_ADDRESS_NONE,
    );
}
