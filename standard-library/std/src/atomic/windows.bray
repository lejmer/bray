@target(target.identity.NAME == "x86_64-pc-windows-msvc" || target.identity.NAME == "aarch64-pc-windows-msvc")
module std.atomic;

using core.atomic;
using std.memory;
using std.os.windows;

trusted internal func platform_wait_word_for(
    pos storage: &core.atomic.Atomic<u32>,
    pos expected: u32,
    pos timeout_milliseconds: u32,
)
    requires(blocking_execution())
    uses(foreign_call, layout_reinterpret)
{
    let address: DataPointer<u32> = trusted internal word_pointer(storage);
    let bytes: DataPointer<u8> = trusted std.memory.reinterpret<u8, u32>(address);
    let expected_pointer: DataPointer<u32> = std.memory.address_of<u32>(&expected);
    let expected_bytes: DataPointer<u8> = trusted std.memory.reinterpret<u8, u32>(expected_pointer);

    let _: i32 = trusted std.os.windows.wait_on_address(
        bytes,
        expected = expected_bytes,
        size = 4,
        timeout = timeout_milliseconds,
    );
}
