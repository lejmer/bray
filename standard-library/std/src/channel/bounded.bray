trusted module std.channel;

union SendError<T>
{
    Closed(pos value: T);
}

union TrySendError<T>
{
    Full(pos value: T);
    Closed(pos value: T);
}

union ReceiveResult<T>
{
    Received(pos value: T);
    Closed;
}

union TryReceiveResult<T>
{
    Received(pos value: T);
    Empty;
    Closed;
}

@copy
union ChannelError
{
    CapacityOverflow;
}

func bounded<T>(capacity: usize) -> Result<(Sender<T>, Receiver<T>), ChannelError>
    ensures(
        !(result matches Ok(_)) || trusted std.channel.owner.live(Sender<T>.result_marker(&result)),
        !(result matches Ok(_)) || trusted std.channel.owner.sender(Sender<T>.result_marker(&result)),
        !(result matches Ok(_)) || trusted std.channel.owner.live(Receiver<T>.result_marker(&result)),
        !(result matches Ok(_)) || trusted std.channel.owner.receiver(Receiver<T>.result_marker(&result)),
    )
{
    let storage_capacity: usize = if capacity == 0
    {
        yield 1;
    }
    else
    {
        yield capacity;
    };

    let storage: std.memory.RawBuffer<Uninit<T>> = match trusted internal std.memory.uninit_buffer<T>(
        capacity = storage_capacity
    )
    {
        case Ok(value) { yield value; }
        case Error(_) { return Error(ChannelError.CapacityOverflow); }
    };

    let state: ChannelState<T> =
    {
        instance = std.channel.owner.Marker
        {
        },
        storage = storage,
        capacity = capacity,
        head = 0,
        length = 0,
        receiver_open = true,
        rendezvous_ticket = none,
        send_waiters = WaitQueue(),
        receive_waiters = WaitQueue(),
    };

    let shared: ChannelCore<T> =
    {
        instance = std.channel.owner.Marker
        {
        },
        owners = core.atomic.initialize<usize>(2),
        senders = core.atomic.initialize<usize>(1),
        generation = core.atomic.initialize<u32>(0),
        state = std.sync.SpinLock<ChannelState<T>>(state),
    };

    let pointer: RawPointer<ChannelCore<T>> = trusted std.memory.allocate_value<ChannelCore<T>>(shared);

    let make_sender = trusted lambda(pos pointer: RawPointer<ChannelCore<T>>) -> Sender<T>
        ensures(
            trusted std.channel.owner.live(&result.owner.instance),
            trusted std.channel.owner.sender(&result.owner.instance)
        )
    {
        return
        {
            owner =
            {
                instance = std.channel.owner.Marker
                {
                },
                core = pointer
            }
        };
    };

    let make_receiver = trusted lambda(pos pointer: RawPointer<ChannelCore<T>>) -> Receiver<T>
        ensures(
            trusted std.channel.owner.live(&result.owner.instance),
            trusted std.channel.owner.receiver(&result.owner.instance)
        )
    {
        return
        {
            owner =
            {
                instance = std.channel.owner.Marker
                {
                },
                core = pointer
            }
        };
    };

    let sender = make_sender(pointer);
    let receiver = make_receiver(pointer);

    return Ok((sender, receiver));
}
