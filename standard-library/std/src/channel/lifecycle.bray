trusted module std.channel;

internal const WAIT_TIMEOUT_MILLISECONDS: u32 = 50;

internal struct PendingValue<T>
{
    mut storage: T?;

    trusted construct(pos value: T) -> Self
    {
        let mut storage: T? = none;

        storage = value;

        return
        {
            storage = storage,
        };
    }

    mut func take() -> T
    {
        let stored: T? = std.memory.replace_value(&mut self.storage, none);

        return match consume stored
        {
            case ?value { yield value; }
            case none { panic("channel pending value has already been taken"); }
        };
    }
}

internal struct WaitRegistration<T>
{
    shared: &ChannelCore<T>;
    ticket: usize;
    kind: WaiterKind;
    mut active: bool;

    trusted destruct()
    {
        if self.active
        {
            trusted internal withdraw_waiter<T>(&mut self);
        }
    }

    trusted consume mut func complete()
    {
        self.active = false;
    }

    trusted consume mut func withdraw()
    {
        trusted internal withdraw_waiter<T>(&mut self);
    }
}

internal struct ChannelWaitWake<T>
{
    shared: &ChannelCore<T>;
    mut active: bool;

    trusted construct(pos shared: &ChannelCore<T>) -> Self
    {
        return
        {
            shared = shared,
            active = true,
        };
    }

    trusted destruct()
    {
        if self.active
        {
            trusted internal notify_channel<T>(self.shared);
        }
    }

    trusted consume mut func disarm()
    {
        self.active = false;
    }
}

internal struct ChannelOwner<T>
{
    core: RawPointer<ChannelCore<T>>;

    trusted destruct()
    {
        let shared: &ChannelCore<T> = trusted internal channel_core<T>(&self);

        trusted internal release_core<T>(&self, shared);
    }
}

trusted internal func register_waiter<T>(pos shared: &ChannelCore<T>, pos kind: WaiterKind) -> WaitRegistration<T>
{
    let mut state = shared.state.lock();
    let channel: &mut ChannelState<T> = state.get();

    let ticket: usize = match kind
    {
        case WaiterKind.Sender { yield trusted channel.send_waiters.enqueue(); }
        case WaiterKind.Receiver { yield trusted channel.receive_waiters.enqueue(); }
    };

    trusted internal notify_channel<T>(shared);

    return
    {
        shared = shared,
        ticket = ticket,
        kind = kind,
        active = true,
    };
}

trusted internal func withdraw_waiter<T>(pos registration: &mut WaitRegistration<T>)
{
    let mut state = registration.shared.state.lock();
    let channel: &mut ChannelState<T> = state.get();

    match registration.kind
    {
        case WaiterKind.Sender
        {
            if channel.rendezvous_belongs_to(registration.ticket)
            {
                let _: T = trusted channel.take_committed_rendezvous(registration.ticket);
            }
            else
            {
                let _: bool = channel.send_waiters.remove(registration.ticket);
            }
        }
        case WaiterKind.Receiver
        {
            let _: bool = channel.receive_waiters.remove(registration.ticket);
        }
    }

    registration.active = false;

    trusted internal notify_channel<T>(registration.shared);
}

internal async func wait_for_channel_change<T>(pos owner: ChannelOwner<T>, pos generation: u32)
    requires(blocking_execution())
{
    let shared: &ChannelCore<T> = trusted internal channel_core<T>(&owner);

    if core.atomic.load<u32, 0>(&shared.generation) == generation
    {
        trusted internal std.atomic.platform_wait_word_for(
            &shared.generation,
            expected = generation,
            timeout_milliseconds = WAIT_TIMEOUT_MILLISECONDS,
        );
    }

    std.run.checkpoint();

    return unit;
}

trusted internal func notify_channel<T>(pos shared: &ChannelCore<T>)
{
    let _: u32 = core.atomic.fetch_add<u32, 2>(&shared.generation, 1);

    trusted internal std.atomic.platform_wake_all_words(&shared.generation);
}

// Each token retains one reference to the shared core. Its private construction sites
// are the initial channel pair and reference-count increments for endpoints and waits.
trusted internal func channel_owner_pointer<T>(pos owner: &ChannelOwner<T>) -> RawPointer<ChannelCore<T>>
    ensures(
        trusted core.memory.valid_read<ChannelCore<T>>(pointer = result, count = 1),
        trusted core.memory.aligned_for<ChannelCore<T>>(pointer = result),
        trusted core.memory.initialized_as<ChannelCore<T>>(pointer = result),
        trusted core.memory.shared_alias_valid<ChannelCore<T>>(pointer = result),
        trusted core.memory.epoch_current<ChannelCore<T>>(pointer = result),
        trusted core.memory.synchronized_access<ChannelCore<T>>(pointer = result),
        trusted core.memory.movement_stable<ChannelCore<T>>(pointer = result),
        trusted core.memory.finalization_pending<ChannelCore<T>>(pointer = result),
    )
{
    return owner.core;
}

trusted internal func channel_core<T>(pos owner: &ChannelOwner<T>) -> &ChannelCore<T>
{
    let pointer: RawPointer<ChannelCore<T>> = trusted internal channel_owner_pointer<T>(owner);

    return trusted std.memory.borrow_from<ChannelCore<T>, ChannelOwner<T>>(owner, pointer);
}

trusted internal func retain_counter(pos counter: &core.atomic.Atomic<usize>)
{
    let mut current: usize = core.atomic.load<usize, 0>(counter);

    while true
    {
        if current == ~0
        {
            panic("channel endpoint count exceeded the target range");
        }

        let (observed, retained) = core.atomic.compare_exchange<usize, 1, 0>(
            counter,
            expected = current,
            desired = current + 1,
        );

        if retained
        {
            return unit;
        }

        current = observed;
    }
}

trusted internal func all_senders_closed<T>(pos shared: &ChannelCore<T>) -> bool
{
    return core.atomic.load<usize, 1>(&shared.senders) == 0;
}

trusted internal func release_sender<T>(pos owner: &ChannelOwner<T>)
{
    let shared: &ChannelCore<T> = trusted internal channel_core<T>(owner);
    let _: usize = core.atomic.fetch_sub<usize, 3>(&shared.senders, 1);

    trusted internal notify_channel<T>(shared);
}

trusted internal func release_receiver<T>(pos owner: &ChannelOwner<T>)
{
    let shared: &ChannelCore<T> = trusted internal channel_core<T>(owner);

    {
        let mut state = shared.state.lock();
        let channel: &mut ChannelState<T> = state.get();

        channel.receiver_open = false;

        let preserve_rendezvous: bool = channel.rendezvous_ticket.is_present();

        while channel.length > 0 && !preserve_rendezvous
        {
            let _: T = trusted channel.take_message();
        }
    }

    trusted internal notify_channel<T>(shared);
}

trusted internal func release_core<T>(pos owner: &ChannelOwner<T>, pos shared: &ChannelCore<T>)
{
    let owners: usize = core.atomic.fetch_sub<usize, 3>(&shared.owners, 1);

    if owners == 1
    {
        {
            let mut state = shared.state.lock();
            let channel: &mut ChannelState<T> = state.get();

            while channel.length > 0
            {
                let _: T = trusted channel.take_message();
            }

            channel.send_waiters.release_storage();
            channel.receive_waiters.release_storage();

            trusted std.memory.raw_buffer_release<Uninit<T>>(&mut channel.storage);
        }

        let pointer: RawPointer<ChannelCore<T>> = trusted internal final_channel_allocation<T>(owner);

        trusted internal std.memory.deallocate_value<ChannelCore<T>>(pointer);
    }
}

// The final decrement is an acquire-release operation. Once it observes the last
// reference, no endpoint or suspended waiter can still own or borrow this allocation.
trusted internal func final_channel_allocation<T>(pos owner: &ChannelOwner<T>) -> RawPointer<ChannelCore<T>>
    ensures(
        trusted core.memory.owned_allocation(
            pointer = trusted std.memory.reinterpret<u8, ChannelCore<T>>(result),
            bytes = internal std.memory.value_allocation_bytes<ChannelCore<T>>(),
            align = std.memory.align_of<ChannelCore<T>>(),
        ),
    )
{
    let shared: &ChannelCore<T> = trusted internal channel_core<T>(owner);

    assert(core.atomic.load<usize, 1>(&shared.owners) == 0, "channel allocation still has live owners");

    return owner.core;
}
