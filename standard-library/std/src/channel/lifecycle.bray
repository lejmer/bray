trusted module std.channel;

using core.atomic;
using core.memory;
using std.atomic;
using std.channel.owner;
using std.memory;
using std.run;
using std.sync.spin_lock;

internal const WAIT_TIMEOUT_MILLISECONDS: u32 = 50;

internal struct PendingValue<T>
{
    mut storage: T?;

    construct(pos value: T) -> Self
    {
        let mut storage: T? = none;

        storage = value;

        return
        {
            storage = storage,
        };
    }

    mut func take() -> T
        ensures(self.storage matches none)
    {
        let stored: T? = std.memory.replace_value(&mut self.storage, none);

        return match consume stored
        {
            case ?value { yield value; }
            case none { panic("channel pending value has already been taken"); }
        };
    }
}

internal struct WaitRegistration<T>
{
    instance: std.channel.owner.Marker;
    shared: &ChannelCore<T>;
    ticket: usize;
    kind: WaiterKind;
    mut active: bool;

    trusted destruct()
        requires(
            !self.active || (trusted std.channel.owner.valid(&self.instance) && trusted std.sync.spin_lock.valid(
                &self.shared.state.instance
            ) && trusted std.channel.owner.valid(&self.shared.instance))
        )
        when(!self.active)
        {
            executes(pure, total)
        }
    {
        if self.active
        {
            self.active = false;
            trusted internal withdraw_waiter<T>(self.shared, self.ticket, self.kind);
        }
    }

    consume mut func complete()
        executes(total)
    {
        self.active = false;
    }
}

internal struct ChannelWaitWake<T>
{
    shared: &ChannelCore<T>;
    mut active: bool;

    trusted construct(pos shared: &ChannelCore<T>) -> Self
    {
        return
        {
            shared = shared,
            active = true,
        };
    }

    trusted destruct()
        when(!self.active)
        {
            executes(pure, total)
        }
    {
        if self.active
        {
            trusted internal notify_channel<T>(self.shared);
        }
    }

    trusted consume mut func disarm()
        executes(total)
    {
        self.active = false;
    }
}

trusted internal func register_waiter<T>(pos shared: &ChannelCore<T>, pos kind: WaiterKind) -> WaitRegistration<T>
    requires(
        trusted std.sync.spin_lock.valid(&shared.state.instance),
        trusted std.channel.owner.valid(&shared.instance)
    )
    ensures(
        trusted std.channel.owner.valid(&result.instance),
        trusted std.sync.spin_lock.valid(&result.shared.state.instance),
        trusted std.channel.owner.valid(&result.shared.instance)
    )
{
    let mut state = shared.state.lock();
    let channel: &mut ChannelState<T> = state.get();

    let authorize_state = trusted lambda(pos marker: &std.channel.owner.Marker)
        ensures(trusted std.channel.owner.valid(marker))
        executes(pure, total) {};

    authorize_state(&channel.instance);

    let ticket: usize = match kind
    {
        case WaiterKind.Sender { yield trusted channel.send_waiters.enqueue(); }
        case WaiterKind.Receiver { yield trusted channel.receive_waiters.enqueue(); }
    };

    trusted internal notify_channel<T>(shared);

    return
    {
        shared = shared,
        instance = std.channel.owner.Marker
        {
        },
        ticket = ticket,
        kind = kind,
        active = true,
    };
}

trusted internal func withdraw_waiter<T>(pos shared: &ChannelCore<T>, pos ticket: usize, pos kind: WaiterKind)
    requires(
        trusted std.sync.spin_lock.valid(&shared.state.instance),
        trusted std.channel.owner.valid(&shared.instance)
    )
    ensures(trusted std.sync.spin_lock.valid(&shared.state.instance), trusted std.channel.owner.valid(&shared.instance))
{
    let discarded: T? =
    {
        let mut state = shared.state.lock();
        let channel: &mut ChannelState<T> = state.get();

        let authorize_state = trusted lambda(pos marker: &std.channel.owner.Marker)
            ensures(trusted std.channel.owner.valid(marker))
            executes(pure, total) {};

        authorize_state(&channel.instance);

        yield match kind
        {
            case WaiterKind.Sender when channel.rendezvous_belongs_to(ticket)
            {
                let mut result: T? = none;

                result = trusted channel.take_committed_rendezvous(ticket);
                yield result;
            }
            case WaiterKind.Sender
            {
                let _: bool = channel.send_waiters.remove(ticket);
                let result: T? = none;

                yield result;
            }
            case WaiterKind.Receiver
            {
                let _: bool = channel.receive_waiters.remove(ticket);
                let result: T? = none;

                yield result;
            }
        };
    };

    trusted internal notify_channel<T>(shared);
}

trusted internal async func wait_for_channel_change<T>(pos owner: std.channel.owner.Owner<T>, pos generation: u32)
    requires(blocking_execution(), trusted std.channel.owner.live(&owner.instance))
{
    let authorize = trusted lambda(pos marker: &std.channel.owner.Marker)
        ensures(trusted std.channel.owner.access(marker))
        executes(pure, total) {};

    authorize(&owner.instance);

    let shared: &ChannelCore<T> = trusted internal channel_core<T>(&owner);

    if core.atomic.load<u32, 0>(&shared.generation) == generation
    {
        trusted internal std.atomic.platform_wait_word_for(
            &shared.generation,
            expected = generation,
            timeout_milliseconds = WAIT_TIMEOUT_MILLISECONDS,
        );
    }

    std.run.checkpoint();

    return unit;
}

trusted internal func notify_channel<T>(pos shared: &ChannelCore<T>)
{
    let _: u32 = core.atomic.fetch_add<u32, 2>(&shared.generation, 1);

    core.atomic.notify_all<u32>(&shared.generation);
}

// Access requires protocol authority, which endpoint operations never return to callers.
trusted internal func channel_owner_pointer<T>(pos owner: &std.channel.owner.Owner<T>) -> DataPointer<ChannelCore<T>>
    requires(trusted std.channel.owner.access(&owner.instance))
    ensures(
        trusted core.memory.valid_read<ChannelCore<T>>(pointer = result, count = 1),
        trusted core.memory.aligned_for<ChannelCore<T>>(pointer = result),
        trusted core.memory.initialized_as<ChannelCore<T>>(pointer = result),
        trusted core.memory.shared_alias_valid<ChannelCore<T>>(pointer = result),
        trusted core.memory.epoch_current<ChannelCore<T>>(pointer = result),
        trusted core.memory.synchronized_access<ChannelCore<T>>(pointer = result),
        trusted core.memory.movement_stable<ChannelCore<T>>(pointer = result),
        trusted core.memory.finalization_pending<ChannelCore<T>>(pointer = result),
    )
{
    return owner.core;
}

trusted internal func channel_core<T>(pos owner: &std.channel.owner.Owner<T>) -> &ChannelCore<T>
    requires(trusted std.channel.owner.access(&owner.instance))
    ensures(trusted std.sync.spin_lock.valid(&result.state.instance), trusted std.channel.owner.valid(&result.instance))
    uses(raw_memory, unchecked_alias)
{
    let pointer: DataPointer<ChannelCore<T>> = trusted internal channel_owner_pointer<T>(owner);

    return trusted std.memory.borrow_from<ChannelCore<T>, std.channel.owner.Owner<T>>(owner, pointer);
}

trusted internal func retain_counter(pos counter: &core.atomic.Atomic<usize>)
{
    let mut current: usize = core.atomic.load<usize, 0>(counter);

    while true
    {
        if current == ~0
        {
            panic("channel endpoint count exceeded the target range");
        }

        let (observed, retained) = core.atomic.compare_exchange<usize, 1, 0>(
            counter,
            expected = current,
            desired = current + 1,
        );

        if retained
        {
            return unit;
        }

        current = observed;
    }
}

trusted internal func all_senders_closed<T>(pos shared: &ChannelCore<T>) -> bool
{
    return core.atomic.load<usize, 1>(&shared.senders) == 0;
}

trusted internal func release_sender<T>(pos shared: &ChannelCore<T>)
{
    let _: usize = core.atomic.fetch_sub<usize, 3>(&shared.senders, 1);

    trusted internal notify_channel<T>(shared);
}

trusted internal func release_receiver<T>(pos shared: &ChannelCore<T>)
    requires(
        trusted std.sync.spin_lock.valid(&shared.state.instance),
        trusted std.channel.owner.valid(&shared.instance)
    )
{
    let messages: (std.memory.RawBuffer<T>)? =
    {
        let mut state = shared.state.lock();
        let channel: &mut ChannelState<T> = state.get();

        let authorize_state = trusted lambda(pos marker: &std.channel.owner.Marker)
            ensures(trusted std.channel.owner.valid(marker))
            executes(pure, total) {};

        authorize_state(&channel.instance);
        channel.receiver_open = false;

        let mut result: (std.memory.RawBuffer<T>)? = none;

        if !channel.rendezvous_ticket.is_present()
        {
            result = trusted channel.take_storage();
        }

        yield result;
    };

    trusted internal notify_channel<T>(shared);
}
