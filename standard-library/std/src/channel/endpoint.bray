trusted module std.channel;

using core.atomic;
using std.channel.owner;
using std.run;

struct Sender<T>
{
    owner: std.channel.owner.Owner<T>;

    static const func result_marker(
        pos value: &Result<(Sender<T>, Receiver<T>), ChannelError>
    ) -> &std.channel.owner.Marker
        requires(value matches Ok(_))
        executes(pure, total)
    {
        match value
        {
            case Ok((endpoint, _)) { return &endpoint.owner.instance; }
            case Error(_) { panic("missing channel endpoints"); }
        }
    }

    trusted destruct()
        requires(
            trusted std.channel.owner.live(&self.owner.instance),
            trusted std.channel.owner.sender(&self.owner.instance)
        )
        ensures(trusted std.channel.owner.live(&self.owner.instance))
    {
        let authorize = trusted lambda(pos marker: &std.channel.owner.Marker)
            ensures(trusted std.channel.owner.access(marker))
            executes(pure, total) {};

        authorize(&self.owner.instance);

        let shared = trusted internal channel_core<T>(&self.owner);

        trusted internal release_sender<T>(shared);
    }

    trusted func duplicate() -> Sender<T>
        ensures(
            trusted std.channel.owner.live(&result.owner.instance),
            trusted std.channel.owner.sender(&result.owner.instance)
        )
        requires(
            trusted std.channel.owner.live(&self.owner.instance),
            trusted std.channel.owner.sender(&self.owner.instance)
        )
        ensures(
            trusted std.channel.owner.live(&self.owner.instance),
            trusted std.channel.owner.sender(&self.owner.instance)
        )
    {
        let authorize = trusted lambda(pos marker: &std.channel.owner.Marker)
            ensures(trusted std.channel.owner.access(marker))
            executes(pure, total) {};

        authorize(&self.owner.instance);

        let shared: &ChannelCore<T> = trusted internal channel_core<T>(&self.owner);

        trusted internal retain_counter(&shared.owners);

        let make_owner = trusted lambda(pos pointer: DataPointer<ChannelCore<T>>) -> std.channel.owner.Owner<T>
            ensures(trusted std.channel.owner.live(&result.instance))
        {
            return
            {
                instance = std.channel.owner.Marker
                {
                },
                core = pointer
            };
        };

        let owner = make_owner(self.owner.core);

        trusted internal retain_counter(&shared.senders);

        return
        {
            owner = owner,
        };
    }

    trusted async func send(pos value: T) -> Result<unit, SendError<T>>
        requires(
            trusted std.channel.owner.live(&self.owner.instance),
            trusted std.channel.owner.sender(&self.owner.instance)
        )
        ensures(
            trusted std.channel.owner.live(&self.owner.instance),
            trusted std.channel.owner.sender(&self.owner.instance)
        )
    {
        let owner: &std.channel.owner.Owner<T> = &self.owner;

        let authorize = trusted lambda(pos marker: &std.channel.owner.Marker)
            ensures(trusted std.channel.owner.access(marker))
            executes(pure, total) {};

        authorize(&owner.instance);

        let shared: &ChannelCore<T> = trusted internal channel_core<T>(owner);
        let mut pending: PendingValue<T> = trusted PendingValue<T>(value);
        let mut registration: WaitRegistration<T> = trusted internal register_waiter<T>(shared, WaiterKind.Sender);

        while true
        {
            let generation: u32 =
            {
                let mut state = shared.state.lock();
                let channel: &mut ChannelState<T> = state.get();

                let authorize_state = trusted lambda(pos marker: &std.channel.owner.Marker)
                    ensures(trusted std.channel.owner.valid(marker))
                    executes(pure, total) {};

                authorize_state(&channel.instance);

                if !channel.receiver_open
                {
                    let closed_message: T = if channel.rendezvous_belongs_to(registration.ticket)
                    {
                        yield trusted channel.take_committed_rendezvous(registration.ticket);
                    }
                    else
                    {
                        let _: bool = channel.send_waiters.remove(registration.ticket);

                        yield trusted pending.take();
                    };

                    trusted registration.complete();

                    let closed_failure: SendError<T> = .Closed(closed_message);

                    trusted internal notify_channel<T>(shared);

                    return Error(closed_failure);
                }

                if channel.capacity == 0 && channel.send_waiters.is_head_completed(registration.ticket)
                {
                    channel.send_waiters.pop_head();
                    trusted registration.complete();

                    trusted internal notify_channel<T>(shared);

                    return Ok(unit);
                }

                if channel.send_waiters.is_head(registration.ticket) && channel.send_can_commit()
                {
                    let message: T = trusted pending.take();

                    trusted channel.store_message(message);

                    if channel.capacity == 0
                    {
                        channel.rendezvous_ticket = registration.ticket;
                    }
                    else
                    {
                        channel.send_waiters.pop_head();
                        trusted registration.complete();

                        trusted internal notify_channel<T>(shared);

                        return Ok(unit);
                    }

                    trusted internal notify_channel<T>(shared);
                }

                yield core.atomic.load<u32, 0>(&shared.generation);
            };

            let mut wake: ChannelWaitWake<T> = trusted internal ChannelWaitWake<T>(shared);

            await internal wait_for_channel_change(&shared.generation, generation);
            std.run.checkpoint();

            trusted wake.disarm();
        }

        let unreachable_message: T = trusted pending.take();
        let unreachable_failure: SendError<T> = .Closed(unreachable_message);

        return Error(unreachable_failure);
    }

    trusted func try_send(pos value: T) -> Result<unit, TrySendError<T>>
        requires(
            trusted std.channel.owner.live(&self.owner.instance),
            trusted std.channel.owner.sender(&self.owner.instance)
        )
        ensures(
            trusted std.channel.owner.live(&self.owner.instance),
            trusted std.channel.owner.sender(&self.owner.instance)
        )
    {
        let authorize = trusted lambda(pos marker: &std.channel.owner.Marker)
            ensures(trusted std.channel.owner.access(marker))
            executes(pure, total) {};

        authorize(&self.owner.instance);

        let shared: &ChannelCore<T> = trusted internal channel_core<T>(&self.owner);
        let mut state = shared.state.lock();
        let channel: &mut ChannelState<T> = state.get();

        let authorize_state = trusted lambda(pos marker: &std.channel.owner.Marker)
            ensures(trusted std.channel.owner.valid(marker))
            executes(pure, total) {};

        authorize_state(&channel.instance);

        if !channel.receiver_open
        {
            let closed_failure: TrySendError<T> = .Closed(value);

            return Error(closed_failure);
        }

        if !channel.send_waiters.is_empty() || !channel.send_can_commit()
        {
            let full_failure: TrySendError<T> = .Full(value);

            return Error(full_failure);
        }

        trusted channel.store_message(value);
        trusted internal notify_channel<T>(shared);

        return Ok(unit);
    }

    trusted consume func close()
        requires(
            trusted std.channel.owner.live(&self.owner.instance),
            trusted std.channel.owner.sender(&self.owner.instance)
        )
        ensures(
            trusted std.channel.owner.live(&self.owner.instance),
            trusted std.channel.owner.sender(&self.owner.instance)
        ) {}
}

struct Receiver<T>
{
    owner: std.channel.owner.Owner<T>;

    static const func result_marker(
        pos value: &Result<(Sender<T>, Receiver<T>), ChannelError>
    ) -> &std.channel.owner.Marker
        requires(value matches Ok(_))
        executes(pure, total)
    {
        match value
        {
            case Ok((_, endpoint)) { return &endpoint.owner.instance; }
            case Error(_) { panic("missing channel endpoints"); }
        }
    }

    trusted destruct()
        requires(
            trusted std.channel.owner.live(&self.owner.instance),
            trusted std.channel.owner.receiver(&self.owner.instance)
        )
        ensures(trusted std.channel.owner.live(&self.owner.instance))
    {
        let authorize = trusted lambda(pos marker: &std.channel.owner.Marker)
            ensures(trusted std.channel.owner.access(marker))
            executes(pure, total) {};

        authorize(&self.owner.instance);

        let shared = trusted internal channel_core<T>(&self.owner);

        trusted internal release_receiver<T>(shared);
    }

    trusted async func receive() -> ReceiveResult<T>
        requires(
            trusted std.channel.owner.live(&self.owner.instance),
            trusted std.channel.owner.receiver(&self.owner.instance)
        )
        ensures(
            trusted std.channel.owner.live(&self.owner.instance),
            trusted std.channel.owner.receiver(&self.owner.instance)
        )
    {
        let owner: &std.channel.owner.Owner<T> = &self.owner;

        let authorize = trusted lambda(pos marker: &std.channel.owner.Marker)
            ensures(trusted std.channel.owner.access(marker))
            executes(pure, total) {};

        authorize(&owner.instance);

        let shared: &ChannelCore<T> = trusted internal channel_core<T>(owner);
        let mut registration: WaitRegistration<T> = trusted internal register_waiter<T>(shared, WaiterKind.Receiver);

        while true
        {
            let generation: u32 =
            {
                let mut state = shared.state.lock();
                let channel: &mut ChannelState<T> = state.get();

                let authorize_state = trusted lambda(pos marker: &std.channel.owner.Marker)
                    ensures(trusted std.channel.owner.valid(marker))
                    executes(pure, total) {};

                authorize_state(&channel.instance);

                if channel.receive_waiters.is_head(registration.ticket) && channel.length > 0
                {
                    let message: T = trusted channel.take_received_message();

                    channel.receive_waiters.pop_head();

                    trusted registration.complete();

                    let result: ReceiveResult<T> = .Received(message);

                    trusted internal notify_channel<T>(shared);

                    return result;
                }

                if channel.receive_waiters.is_head(registration.ticket) && trusted internal all_senders_closed<T>(
                    shared
                )
                {
                    channel.receive_waiters.pop_head();
                    trusted registration.complete();

                    trusted internal notify_channel<T>(shared);

                    return ReceiveResult.Closed;
                }

                yield core.atomic.load<u32, 0>(&shared.generation);
            };

            let mut wake: ChannelWaitWake<T> = trusted internal ChannelWaitWake<T>(shared);

            await internal wait_for_channel_change(&shared.generation, generation);
            std.run.checkpoint();

            trusted wake.disarm();
        }

        return ReceiveResult.Closed;
    }

    trusted func try_receive() -> TryReceiveResult<T>
        requires(
            trusted std.channel.owner.live(&self.owner.instance),
            trusted std.channel.owner.receiver(&self.owner.instance)
        )
        ensures(
            trusted std.channel.owner.live(&self.owner.instance),
            trusted std.channel.owner.receiver(&self.owner.instance)
        )
    {
        let authorize = trusted lambda(pos marker: &std.channel.owner.Marker)
            ensures(trusted std.channel.owner.access(marker))
            executes(pure, total) {};

        authorize(&self.owner.instance);

        let shared: &ChannelCore<T> = trusted internal channel_core<T>(&self.owner);
        let mut state = shared.state.lock();
        let channel: &mut ChannelState<T> = state.get();

        let authorize_state = trusted lambda(pos marker: &std.channel.owner.Marker)
            ensures(trusted std.channel.owner.valid(marker))
            executes(pure, total) {};

        authorize_state(&channel.instance);

        if channel.receive_waiters.is_empty() && channel.length > 0
        {
            let message: T = trusted channel.take_received_message();
            let result: TryReceiveResult<T> = .Received(message);

            trusted internal notify_channel<T>(shared);

            return result;
        }

        if trusted internal all_senders_closed<T>(shared)
        {
            return TryReceiveResult.Closed;
        }

        return TryReceiveResult.Empty;
    }

    trusted consume func close()
        requires(
            trusted std.channel.owner.live(&self.owner.instance),
            trusted std.channel.owner.receiver(&self.owner.instance)
        )
        ensures(
            trusted std.channel.owner.live(&self.owner.instance),
            trusted std.channel.owner.receiver(&self.owner.instance)
        ) {}
}
