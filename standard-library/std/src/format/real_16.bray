@target(target.scalar.R16)
module std.format;

using core.memory;
using std.memory;

// These concrete numeric representations have equal size and alignment and no padding.
trusted internal func real16_pointer(pos value: &r16) -> DataPointer<u16>
    ensures(
        trusted core.memory.valid_read<u16>(pointer = result, count = 1),
        trusted core.memory.aligned_for<u16>(pointer = result),
        trusted core.memory.initialized_as<u16>(pointer = result),
    )
    uses(layout_reinterpret)
{
    return trusted std.memory.reinterpret<u16, r16>(std.memory.address_of<r16>(value));
}

trusted internal func real16_bits(pos value: &r16) -> u128
    uses(raw_memory)
{
    let pointer: DataPointer<u16> = real16_pointer(value);
    let bits: u16 = trusted std.memory.read<u16>(pointer);

    return bits as u128;
}

impl R16Format = r16(Format<Destination, Failure>)
    with(Destination: Sink<Failure>)
{
    func format(pos destination: &mut Destination, pos options: &Options) -> Result<unit, Failure>
        requires(blocking_execution())
    {
        let value: RealRendering = make_real_rendering(real16_bits(&self), 10, 5, options);

        return write_real_rendering<Destination, Failure>(destination, &value, options);
    }
}
