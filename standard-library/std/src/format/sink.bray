module std.format;

using std.bytes;
using std.memory;
using std.string;

struct ByteSink
{
    internal mut buffer: std.bytes.Buffer;

    construct(capacity: usize) -> Result<Self, std.memory.MemoryLayoutError>
    {
        let buffer: std.bytes.Buffer = try std.bytes.Buffer(capacity = capacity);

        let sink: ByteSink = { buffer = buffer, };

        return Ok(sink);
    }
}

func bytes(pos sink: &ByteSink) -> &[u8]
{
    return std.bytes.as_slice(&sink.buffer);
}

func into_bytes(pos sink: ByteSink) -> std.bytes.Buffer
{
    return sink.buffer;
}

struct TextSink
{
    internal mut bytes: ByteSink;

    construct(capacity: usize) -> Result<Self, std.memory.MemoryLayoutError>
    {
        let sink: ByteSink = try ByteSink(capacity = capacity);

        let result: TextSink = { bytes = sink, };

        return Ok(result);
    }
}

func text(pos sink: &TextSink) -> Result<string, std.string.Utf8Error>
{
    return std.string.from_utf8(bytes(&sink.bytes));
}

func text_bytes(pos sink: &mut TextSink) -> &mut ByteSink
{
    return &mut sink.bytes;
}
