module std.format;

union Radix
{
    Binary;
    Octal;
    Decimal;
    HexadecimalLowercase;
    HexadecimalUppercase;
}

union Alignment
{
    Left;
    Center;
    Right;
}

union Sign
{
    NegativeOnly;
    Always;
    Space;
}

union Escaping
{
    Raw;
    Quoted;
}

struct Options
{
    radix: Radix;
    precision: usize;
    width: usize;
    alignment: Alignment;
    sign: Sign;
    escaping: Escaping;

    construct(
        radix: Radix,
        precision: usize,
        width: usize,
        alignment: Alignment,
        sign: Sign,
        escaping: Escaping,
    ) -> Self
    {
        return
        {
            radix = radix,
            precision = precision,
            width = width,
            alignment = alignment,
            sign = sign,
            escaping = escaping,
        };
    }

    construct default() -> Self
    {
        return Options
        {
            radix = Radix.Decimal,
            precision = 0,
            width = 0,
            alignment = Alignment.Right,
            sign = Sign.NegativeOnly,
            escaping = Escaping.Raw,
        };
    }
}
