module std.format;

union Radix
{
    Binary;
    Octal;
    Decimal;
    HexadecimalLowercase;
    HexadecimalUppercase;
}

union Alignment
{
    Left;
    Center;
    Right;
}

union Sign
{
    NegativeOnly;
    Always;
    Space;
}

union Escaping
{
    Raw;
    Quoted;
}

struct Options
{
    radix: Radix;
    precision: usize?;
    width: usize;
    alignment: Alignment;
    sign: Sign;
    escaping: Escaping;

    /// Creates formatting options with ordinary defaults and selected overrides.
    construct(
        radix: Radix = Radix.Decimal,
        precision: usize? = none,
        width: usize = 0,
        alignment: Alignment = Alignment.Right,
        sign: Sign = Sign.NegativeOnly,
        escaping: Escaping = Escaping.Raw,
    ) -> Self
    {
        return
        {
            radix = radix,
            precision = precision,
            width = width,
            alignment = alignment,
            sign = sign,
            escaping = escaping,
        };
    }
}

internal func default_options() -> Options
{
    return Options();
}
