module std.format;

using std.memory;

struct Argument<Value>
{
    value: &Value;
    options: Options;

    construct(pos value: &Value) -> Self
    {
        return
        {
            value = value,
            options = Options.default(),
        };
    }

    construct with_options(pos value: &Value, options: Options) -> Self
    {
        return
        {
            value = value,
            options = options,
        };
    }
}

/// Formats a value into a selected destination and preserves its failure type.
trait Format<Destination, Failure>
{
    func format(pos destination: &mut Destination, pos options: &Options) -> Result<unit, Failure>
        requires(blocking_execution());
}

/// Formats an argument into a destination without constructing an intermediate buffer.
func write_to<Value, Destination, Failure>(
    pos destination: &mut Destination,
    pos value: Argument<Value>,
) -> Result<unit, Failure>
    with(Destination: Sink<Failure>, Value: Format<Destination, Failure>)
    requires(blocking_execution())
{
    let formatted: &Value = value.value;
    let formatting_options: Options = value.options;

    return formatted.format(destination, &formatting_options);
}

/// Formats an argument into an owned byte sink.
func write<Value>(
    pos destination: &mut ByteSink,
    pos value: Argument<Value>,
) -> Result<unit, std.memory.MemoryLayoutError>
    with(Value: Format<ByteSink, std.memory.MemoryLayoutError>)
    requires(blocking_execution())
{
    let formatted: &Value = value.value;
    let formatting_options: Options = value.options;

    return formatted.format(destination, &formatting_options);
}
