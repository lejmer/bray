module std.format;

using std.memory;

struct Argument<Value>
{
    value: Value;
    options: Options;

    construct(pos value: Value) -> Self
    {
        return
        {
            value = value,
            options = Options.default(),
        };
    }

    construct with_options(pos value: Value, options: Options) -> Self
    {
        return
        {
            value = value,
            options = options,
        };
    }
}

trait Format
{
    func format(pos destination: &mut ByteSink, pos options: &Options,) -> Result<unit, std.memory.MemoryLayoutError>;
}

func write<Value>(
    pos destination: &mut ByteSink,
    pos value: Argument<Value>,
) -> Result<unit, std.memory.MemoryLayoutError>
    with(Value: Format)
{
    let formatted: Value = value.value;
    let formatting_options: Options = value.options;

    return formatted.format(destination, &formatting_options);
}
