@target(target.platform.dynamic_loading)
trusted module std.dynamic;

trusted internal func open_dynamic_library_path(
    pos path: &std.path.Path,
    policy: LoadPolicy,
) -> Result<u64, std.ffi.ForeignError>
    requires(blocking_execution())
    uses(foreign_call)
{
    let mut handle: u64 = 0;

    let status: std.platform.PlatformStatus = trusted platform_dynamic_library_open_path(
        internal std.fs.platform_path(path),
        policy = load_policy_value(policy),
        opened = std.memory.address_of_mut<u64>(&mut handle),
    );

    try internal std.ffi.checked_foreign_library_status(status);

    return internal std.ffi.checked_foreign_resource_handle(handle, valid = handle != 0);
}

trusted internal func open_dynamic_library_system(
    pos identity: SystemLibrary,
    policy: LoadPolicy,
) -> Result<u64, std.ffi.ForeignError>
    requires(blocking_execution())
    uses(foreign_call)
{
    let mut handle: u64 = 0;

    let status: std.platform.PlatformStatus = trusted platform_dynamic_library_open_system(
        system_library_value(identity),
        policy = load_policy_value(policy),
        opened = std.memory.address_of_mut<u64>(&mut handle),
    );

    try internal std.ffi.checked_foreign_library_status(status);

    return internal std.ffi.checked_foreign_resource_handle(handle, valid = handle != 0);
}

trusted internal func release_dynamic_library(pos library: &mut DynamicLibrary) -> Result<unit, std.ffi.ForeignError>
    requires(blocking_execution())
    uses(foreign_call)
{
    let handle: u64 = try internal std.ffi.checked_owned_foreign_resource_handle(
        library.handle_value,
        owned = library.is_owned_value,
    );

    library.is_owned_value = false;

    let status: std.platform.PlatformStatus = trusted platform_dynamic_library_close(handle);

    return internal std.ffi.checked_foreign_status(status);
}

trusted internal func dynamic_library_handle(pos library: &DynamicLibrary) -> u64
    executes(pure, total)
{
    return library.handle_value;
}

internal func load_policy_value(pos policy: LoadPolicy) -> u32
    executes(pure, total)
{
    match policy
    {
        case LoadPolicy.PlatformDefault { return 0; }
        case LoadPolicy.LocalImmediate { return 1; }
        case LoadPolicy.LocalLazy { return 2; }
        case LoadPolicy.GlobalImmediate { return 3; }
        case LoadPolicy.GlobalLazy { return 4; }
    }
}

internal func system_library_value(pos identity: SystemLibrary) -> u32
    executes(pure, total)
{
    match identity
    {
        case SystemLibrary.CRuntime { return 0; }
    }
}

@abi(c)
trusted internal func platform_dynamic_library_open_path(
    pos path: std.fs.PlatformPath,
    pos policy: u32,
    pos opened: RawPointer<u64>,
) -> std.platform.PlatformStatus
    requires(
        trusted core.memory.valid_read<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.valid_write<u64>(pointer = opened, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = opened),
        trusted core.memory.exclusive_alias_valid<u64>(pointer = opened),
        trusted core.memory.epoch_current<u64>(pointer = opened),
        trusted core.memory.synchronized_access<u64>(pointer = opened),
        trusted core.memory.movement_stable<u64>(pointer = opened),
        trusted core.memory.finalization_pending<u64>(pointer = opened),
        blocking_execution(),
    )
{
    let prepared: Result<u64, std.platform.PlatformStatus> = trusted internal prepare_dynamic_library_open_path(
        path,
        policy,
        opened,
    );

    match consume prepared
    {
        case Ok(handle)
        {
            trusted std.memory.write<u64>(opened, value = handle);

            return internal std.platform.success_status();
        }
        case Error(status) { return status; }
    }
}

@abi(c)
trusted internal func platform_dynamic_library_symbol(
    pos handle: u64,
    pos name: RawPointer<u8>,
    pos length: u64,
    pos address: RawPointer<RawPointer<u8>>,
) -> std.platform.PlatformStatus
    requires(
        trusted core.memory.valid_read<u8>(pointer = name, count = length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = name, count = length as usize),
        trusted core.memory.valid_write<RawPointer<u8>>(pointer = address, count = 1),
        trusted core.memory.aligned_for<RawPointer<u8>>(pointer = address),
        trusted core.memory.exclusive_alias_valid<RawPointer<u8>>(pointer = address),
        trusted core.memory.epoch_current<RawPointer<u8>>(pointer = address),
        trusted core.memory.synchronized_access<RawPointer<u8>>(pointer = address),
        trusted core.memory.movement_stable<RawPointer<u8>>(pointer = address),
        trusted core.memory.finalization_pending<RawPointer<u8>>(pointer = address),
        blocking_execution(),
    )
{
    let prepared: Result<RawPointer<u8>, std.platform.PlatformStatus> = trusted internal prepare_dynamic_library_symbol(
        handle,
        name,
        length,
        address,
    );

    match consume prepared
    {
        case Ok(pointer)
        {
            trusted std.memory.write<RawPointer<u8>>(address, value = pointer);

            return internal std.platform.success_status();
        }
        case Error(status) { return status; }
    }
}

@abi(c)
trusted internal func platform_dynamic_library_open_system(
    pos identity: u32,
    pos policy: u32,
    pos opened: RawPointer<u64>,
) -> std.platform.PlatformStatus
    requires(
        trusted core.memory.valid_write<u64>(pointer = opened, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = opened),
        trusted core.memory.exclusive_alias_valid<u64>(pointer = opened),
        trusted core.memory.epoch_current<u64>(pointer = opened),
        trusted core.memory.synchronized_access<u64>(pointer = opened),
        trusted core.memory.movement_stable<u64>(pointer = opened),
        trusted core.memory.finalization_pending<u64>(pointer = opened),
        blocking_execution(),
    )
{
    let prepared: Result<u64, std.platform.PlatformStatus> = trusted internal prepare_dynamic_library_open_system(
        identity,
        policy,
        opened,
    );

    match consume prepared
    {
        case Ok(handle)
        {
            trusted std.memory.write<u64>(opened, value = handle);

            return internal std.platform.success_status();
        }
        case Error(status) { return status; }
    }
}
