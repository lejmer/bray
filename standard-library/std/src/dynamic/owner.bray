@target(target.platform.dynamic_loading)
trusted module std.dynamic;

@copy
union LoadPolicy
{
    PlatformDefault;
    LocalImmediate;
    LocalLazy;
    GlobalImmediate;
    GlobalLazy;
}

@copy
union SystemLibrary
{
    CRuntime;
}

struct DynamicLibrary
{
    internal handle_value: u64;
    internal mut is_owned_value: bool;

    internal construct open_path(pos path: &std.path.Path, pos policy: LoadPolicy) -> Result<Self, std.ffi.ForeignError>
        requires(blocking_execution())
    {
        let handle: u64 = try trusted open_dynamic_library_path(path, policy = policy);

        return Ok(
            {
                handle_value = handle,
                is_owned_value = true,
            }
        );
    }

    internal construct open_system(
        pos identity: SystemLibrary,
        pos policy: LoadPolicy
    ) -> Result<Self, std.ffi.ForeignError>
        requires(blocking_execution())
    {
        let handle: u64 = try trusted open_dynamic_library_system(identity, policy = policy);

        return Ok(
            {
                handle_value = handle,
                is_owned_value = true,
            }
        );
    }

    /// Opens a dynamic library by path or platform system-library identity.
    overload open =
    {
        open_path,
        open_system,
    }

    /// Whether this owner has no unresolved resource obligation.
    predicate complete(value: &DynamicLibrary) = !value.is_owned_value;

    /// Reports whether the resource obligation has been resolved, including after an error.
    func is_complete() -> bool
        executes(pure, total)
        ensures(result == DynamicLibrary.complete(value = &self))
    {
        return !self.is_owned_value;
    }

    trusted finalize() -> Result<unit, std.ffi.ForeignError>
        requires(DynamicLibrary.complete(value = &self) || blocking_execution())
        ensures(result matches Error(_) || DynamicLibrary.complete(value = &self))
        when(DynamicLibrary.complete(value = &self))
        {
            executes(pure, total)
            ensures(result matches Ok(_))
        }
    {
        return trusted release_dynamic_library(&mut self);
    }

    trusted destruct()
    {
        if self.is_owned_value
        {
            let _: std.platform.PlatformStatus = trusted platform_dynamic_library_close(self.handle_value);
        }
    }

    mut func close() -> Result<unit, std.ffi.ForeignError>
        requires(DynamicLibrary.complete(value = &self) || blocking_execution())
        ensures(result matches Error(_) || DynamicLibrary.complete(value = &self))
        when(DynamicLibrary.complete(value = &self))
        {
            executes(pure, total)
            ensures(result matches Ok(_))
        }
    {
        return trusted release_dynamic_library(&mut self);
    }

    /// Resolves an exact native symbol name as the caller-supplied ABI type.
    ///
    /// `name` must be nonempty and contain no NUL unit. `T` is the caller's trusted assertion about the symbol's ABI
    /// and representation. The returned symbol retains a borrow of this library and cannot outlive it.
    ///
    /// Returns `ForeignErrorKind.InvalidInput` for an invalid name and `ForeignErrorKind.UnavailableSymbol` when the
    /// loader cannot find the name. Returns `ForeignErrorKind.IncompatibleAbi` when the loader returns a null address.
    trusted func symbol<T>(pos name: &[u8]) -> Result<DynamicSymbol<T>, std.ffi.ForeignError>
        requires(blocking_execution())
        uses(foreign_call, layout_reinterpret)
    {
        return trusted resolve_dynamic_symbol<T>(&self, name);
    }

    /// Transfers ownership of the native handle to the caller.
    ///
    /// Success disables this owner's destruction and makes the caller responsible for closing the handle. Failure
    /// returns no handle.
    trusted consume mut func into_handle() -> Result<u64, std.ffi.ForeignError>
    {
        if !self.is_owned_value
        {
            return Error(internal std.ffi.foreign_error(kind = std.ffi.ForeignErrorKind.InvalidResource));
        }

        self.is_owned_value = false;

        return Ok(self.handle_value);
    }
}

@copy
struct DynamicSymbol<T>
{
    internal owner: &DynamicLibrary;
    internal address: RawPointer<T>;

    func library() -> &DynamicLibrary
    {
        return self.owner;
    }

    func pointer() -> RawPointer<T>
    {
        return self.address;
    }
}
