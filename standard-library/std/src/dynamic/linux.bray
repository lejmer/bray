@target(target.platform.dynamic_loading && target.identity.SYSTEM == "linux")
trusted module std.dynamic;

trusted internal func platform_dynamic_library_open_system(
    pos identity: u32,
    pos policy: u32,
    pos opened: RawPointer<u64>,
) -> std.platform.PlatformStatus
    requires(blocking_execution())
{
    if identity != 0
    {
        return internal std.platform.invalid_input_status();
    }

    let library_name: [u8; 10] = [108, 105, 98, 99, 46, 115, 111, 46, 54, 0];

    return trusted internal open_unix_library(
        std.memory.address_of<u8>(&library_name[0]),
        policy = policy,
        opened = opened,
    );
}
