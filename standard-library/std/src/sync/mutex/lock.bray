trusted module std.sync;

using internal std.sync.mutex;

struct Mutex<T>
{
    instance: std.sync.mutex.Marker;
    storage: Uninit<std.sync.mutex.State<T>>;

    trusted construct(pos value: T) -> Self
        ensures(trusted std.sync.mutex.valid(&result.instance))
    {
        return
        {
            instance = std.sync.mutex.Marker
            {
            },
            storage = std.memory.uninit_from<std.sync.mutex.State<T>>(
                {
                    tickets = core.atomic.initialize<u32>(0),
                    value = std.memory.uninit_from<T>(value),
                }
            ),
        };
    }

    trusted destruct()
        requires(trusted std.sync.mutex.valid(&self.instance))
        uses(raw_memory, unchecked_init)
    {
        let pointer = std.memory.uninit_pointer<std.sync.mutex.State<T>>(&self.storage);

        let authorize = trusted lambda(pos pointer: RawPointer<std.sync.mutex.State<T>>)
            ensures(
                trusted core.memory.valid_read<std.sync.mutex.State<T>>(pointer = pointer, count = 1),
                trusted core.memory.aligned_for<std.sync.mutex.State<T>>(pointer = pointer),
                trusted core.memory.initialized_as<std.sync.mutex.State<T>>(pointer = pointer),
            )
            executes(pure, total) {};

        authorize(pointer);

        let state: std.sync.mutex.State<T> = trusted std.memory.read<std.sync.mutex.State<T>>(pointer);

        let initialized = trusted lambda(pos storage: &Uninit<T>)
            ensures(trusted core.memory.uninit_initialized<T>(storage = storage))
            executes(pure, total) {};

        initialized(&state.value);

        let _: T = trusted std.memory.assume_initialized<T>(state.value);
    }

    trusted func lock() -> MutexGuard<T>
        requires(blocking_execution())
        requires(trusted std.sync.mutex.valid(&self.instance))
        ensures(trusted std.sync.mutex.valid(&self.instance), trusted std.sync.mutex.acquired(&result.acquisition))
        uses(raw_memory, unchecked_alias)
    {
        let pointer = std.memory.uninit_pointer<std.sync.mutex.State<T>>(&self.storage);

        let authorize = trusted lambda(pos pointer: RawPointer<std.sync.mutex.State<T>>)
            ensures(
                trusted core.memory.valid_read<std.sync.mutex.State<T>>(pointer = pointer, count = 1),
                trusted core.memory.aligned_for<std.sync.mutex.State<T>>(pointer = pointer),
                trusted core.memory.initialized_as<std.sync.mutex.State<T>>(pointer = pointer),
                trusted core.memory.shared_alias_valid<std.sync.mutex.State<T>>(pointer = pointer),
                trusted core.memory.epoch_current<std.sync.mutex.State<T>>(pointer = pointer),
                trusted core.memory.synchronized_access<std.sync.mutex.State<T>>(pointer = pointer),
                trusted core.memory.movement_stable<std.sync.mutex.State<T>>(pointer = pointer),
                trusted core.memory.finalization_pending<std.sync.mutex.State<T>>(pointer = pointer),
            )
            executes(pure, total) {};

        authorize(pointer);

        let state = trusted std.memory.borrow_from<std.sync.mutex.State<T>, Self>(&self, pointer);
        let mut observed = core.atomic.load<u32, 1>(&state.tickets);
        let mut ticket: u32 = 0;

        while true
        {
            let next = observed & 65535;
            let serving = observed >> 16;

            if((next + 65536 - serving) & 65535) == 65535
            {
                core.atomic.wait<u32, 1>(&state.tickets, expected = observed);
                observed = core.atomic.load<u32, 1>(&state.tickets);
                continue;
            }

            let desired = (observed & 4294901760) | ((next + 1) & 65535);

            let (current, admitted) = core.atomic.compare_exchange<u32, 3, 1>(
                &state.tickets,
                expected = observed,
                desired = desired,
            );

            if admitted
            {
                ticket = next;
                break;
            }

            observed = current;
        }

        observed = core.atomic.load<u32, 1>(&state.tickets);

        while(observed >> 16) != ticket
        {
            core.atomic.wait<u32, 1>(&state.tickets, expected = observed);
            observed = core.atomic.load<u32, 1>(&state.tickets);
        }

        return
        {
            acquisition = std.sync.mutex.Marker
            {
            },
            mutex = &self
        };
    }

    trusted func try_lock() -> MutexGuard<T>?
        requires(trusted std.sync.mutex.valid(&self.instance))
        ensures(
            trusted std.sync.mutex.valid(&self.instance),
            result matches none || trusted std.sync.mutex.acquired(std.sync.mutex.marker<T>(&result)),
        )
        uses(raw_memory, unchecked_alias)
    {
        let pointer = std.memory.uninit_pointer<std.sync.mutex.State<T>>(&self.storage);

        let authorize = trusted lambda(pos pointer: RawPointer<std.sync.mutex.State<T>>)
            ensures(
                trusted core.memory.valid_read<std.sync.mutex.State<T>>(pointer = pointer, count = 1),
                trusted core.memory.aligned_for<std.sync.mutex.State<T>>(pointer = pointer),
                trusted core.memory.initialized_as<std.sync.mutex.State<T>>(pointer = pointer),
                trusted core.memory.shared_alias_valid<std.sync.mutex.State<T>>(pointer = pointer),
                trusted core.memory.epoch_current<std.sync.mutex.State<T>>(pointer = pointer),
                trusted core.memory.synchronized_access<std.sync.mutex.State<T>>(pointer = pointer),
                trusted core.memory.movement_stable<std.sync.mutex.State<T>>(pointer = pointer),
                trusted core.memory.finalization_pending<std.sync.mutex.State<T>>(pointer = pointer),
            )
            executes(pure, total) {};

        authorize(pointer);

        let state = trusted std.memory.borrow_from<std.sync.mutex.State<T>, Self>(&self, pointer);
        let observed = core.atomic.load<u32, 1>(&state.tickets);
        let serving = observed >> 16;
        let next = observed & 65535;

        if next != serving
        {
            return none;
        }

        let (_, acquired) = core.atomic.compare_exchange<u32, 3, 1>(
            &state.tickets,
            expected = observed,
            desired = (observed & 4294901760) | ((next + 1) & 65535),
        );

        if !acquired
        {
            return none;
        }

        let guard: MutexGuard<T> =
        {
            acquisition = std.sync.mutex.Marker
            {
            },
            mutex = &self
        };

        return guard;
    }
}
