trusted module std.sync;

using core.atomic;

struct ManualResetEvent
{
    internal state: core.atomic.Atomic<u32>;

    construct(set: bool = false) -> Self
    {
        let state: u32 = if set
        {
            yield 1;
        }
        else
        {
            yield 0;
        };

        return
        {
            state = core.atomic.initialize<u32>(state),
        };
    }

    func wait()
        requires(blocking_execution())
    {
        while core.atomic.load<u32, 1>(&self.state) == 0
        {
            core.atomic.wait<u32, 1>(&self.state, expected = 0);
        }
    }

    func set()
    {
        core.atomic.store<u32, 2>(&self.state, 1);

        core.atomic.notify_all<u32>(&self.state);
    }

    func reset()
    {
        core.atomic.store<u32, 0>(&self.state, 0);
    }

    func is_set() -> bool
    {
        return core.atomic.load<u32, 1>(&self.state) != 0;
    }
}

struct AutoResetEvent
{
    internal state: core.atomic.Atomic<u32>;

    construct(set: bool = false) -> Self
    {
        let state: u32 = if set
        {
            yield 1;
        }
        else
        {
            yield 0;
        };

        return
        {
            state = core.atomic.initialize<u32>(state),
        };
    }

    func wait()
        requires(blocking_execution())
    {
        while true
        {
            let (_, acquired) = core.atomic.compare_exchange<u32, 1, 1>(&self.state, expected = 1, desired = 0);

            if acquired
            {
                return unit;
            }

            core.atomic.wait<u32, 1>(&self.state, expected = 0);
        }
    }

    func set()
    {
        let previous: u32 = core.atomic.exchange<u32, 2>(&self.state, 1);

        if previous == 0
        {
            core.atomic.notify_one<u32>(&self.state);
        }
    }
}
