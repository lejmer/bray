trusted module std.sync;

struct SpinLock<T>
{
    internal next_ticket: core.atomic.Atomic<u32>;
    internal serving_ticket: core.atomic.Atomic<u32>;
    internal storage: T;

    construct(pos value: T) -> Self
    {
        return
        {
            next_ticket = core.atomic.initialize<u32>(0),
            serving_ticket = core.atomic.initialize<u32>(0),
            storage = value,
        };
    }

    func lock() -> SpinLockGuard<T>
    {
        let ticket: u32 = core.atomic.fetch_add<u32, 0>(&self.next_ticket, 1);

        while core.atomic.load<u32, 1>(&self.serving_ticket) != ticket
        {
            trusted internal spin_loop();
        }

        let guard: SpinLockGuard<T> =
        {
            lock = &self,
            active = true,
        };

        return guard;
    }

    func try_lock() -> SpinLockGuard<T>?
    {
        let serving: u32 = core.atomic.load<u32, 1>(&self.serving_ticket);
        let next: u32 = core.atomic.load<u32, 0>(&self.next_ticket);

        if next != serving
        {
            return none;
        }

        let (_, acquired) = core.atomic.compare_exchange<u32, 0, 0>(
            &self.next_ticket,
            expected = next,
            desired = next + 1,
        );

        if !acquired
        {
            return none;
        }

        let mut result: SpinLockGuard<T>? = none;

        let guard: SpinLockGuard<T> =
        {
            lock = &self,
            active = true,
        };

        result = guard;

        return result;
    }
}

struct SpinLockGuard<T>
{
    internal lock: &SpinLock<T>;
    internal mut active: bool;

    trusted destruct()
        executes(total)
    {
        if self.active
        {
            trusted internal release_spin_lock<T>(self.lock);
        }
    }

    mut func get() -> &mut T
    {
        let pointer: RawPointer<T> = trusted internal spin_lock_guard_pointer<T>(&mut self);

        return trusted std.memory.borrow_mut_from<T, SpinLockGuard<T>>(&mut self, pointer);
    }

    consume mut func unlock()
    {
        trusted internal release_spin_lock<T>(self.lock);
        self.active = false;
    }
}

trusted internal func spin_lock_guard_pointer<T>(pos guard: &mut SpinLockGuard<T>) -> RawPointer<T>
    ensures(
        trusted core.memory.valid_write<T>(pointer = result, count = 1),
        trusted core.memory.aligned_for<T>(pointer = result),
        trusted core.memory.initialized_as<T>(pointer = result),
        trusted core.memory.exclusive_alias_valid<T>(pointer = result),
        trusted core.memory.epoch_current<T>(pointer = result),
        trusted core.memory.synchronized_access<T>(pointer = result),
        trusted core.memory.movement_stable<T>(pointer = result),
        trusted core.memory.finalization_pending<T>(pointer = result),
    )
{
    if !guard.active
    {
        panic("storage access requires a live lock guard");
    }

    // Guard construction follows successful exclusive acquisition. The guard keeps the
    // lock alive and release consumes it, so this access cannot outlive that acquisition.
    return std.memory.address_of<T>(&guard.lock.storage);
}

trusted internal func release_spin_lock<T>(pos lock: &SpinLock<T>)
    executes(total)
{
    let _: u32 = core.atomic.fetch_add<u32, 2>(&lock.serving_ticket, 1);
}

trusted internal func spin_loop()
    uses(intrinsic)
{
    trusted core.target.spin_loop_hint();
}
