trusted module std.sync;

@copy
union SemaphoreError
{
    ZeroMaximum;
    InitialExceedsMaximum;
    CapacityOverflow;
}

struct Semaphore
{
    internal permits: core.atomic.Atomic<usize>;
    internal generation: core.atomic.Atomic<u32>;
    internal maximum: usize;

    construct(initial: usize, maximum: usize) -> Result<Self, SemaphoreError>
    {
        if maximum == 0
        {
            return Error(SemaphoreError.ZeroMaximum);
        }

        if initial > maximum
        {
            return Error(SemaphoreError.InitialExceedsMaximum);
        }

        return Ok(
            {
                permits = core.atomic.initialize<usize>(initial),
                generation = core.atomic.initialize<u32>(0),
                maximum = maximum,
            }
        );
    }

    func acquire()
        requires(blocking_execution())
    {
        while !self.try_acquire()
        {
            let generation: u32 = core.atomic.load<u32, 0>(&self.generation);

            if core.atomic.load<usize, 0>(&self.permits) == 0
            {
                trusted internal std.atomic.platform_wait_word(&self.generation, expected = generation);
            }
        }
    }

    func try_acquire() -> bool
    {
        let mut available: usize = core.atomic.load<usize, 0>(&self.permits);

        while available > 0
        {
            let (observed, acquired) = core.atomic.compare_exchange<usize, 1, 0>(
                &self.permits,
                expected = available,
                desired = available - 1,
            );

            if acquired
            {
                return true;
            }

            available = observed;
        }

        return false;
    }

    func release(count: usize = 1) -> Result<unit, SemaphoreError>
    {
        if count == 0
        {
            return Ok(unit);
        }

        let mut available: usize = core.atomic.load<usize, 0>(&self.permits);

        while true
        {
            if count > self.maximum - available
            {
                return Error(SemaphoreError.CapacityOverflow);
            }

            let (observed, released) = core.atomic.compare_exchange<usize, 2, 0>(
                &self.permits,
                expected = available,
                desired = available + count,
            );

            if released
            {
                let _: u32 = core.atomic.fetch_add<u32, 2>(&self.generation, 1);

                if count == 1
                {
                    trusted internal std.atomic.platform_wake_word(&self.generation);
                }
                else
                {
                    trusted internal std.atomic.platform_wake_all_words(&self.generation);
                }

                return Ok(unit);
            }

            available = observed;
        }

        return Error(SemaphoreError.CapacityOverflow);
    }

    func available() -> usize
    {
        return core.atomic.load<usize, 1>(&self.permits);
    }
}
