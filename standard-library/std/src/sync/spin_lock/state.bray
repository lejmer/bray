trusted module std.sync.spin_lock;

struct State<T>
{
    tickets: core.atomic.Atomic<u32>;
    value: T;
}

struct Marker
{
}

trusted predicate acquired(marker: &Marker);

trusted predicate valid(marker: &Marker);

const func marker<T>(pos guard: &(std.sync.SpinLockGuard<T>?)) -> &Marker
    requires(guard matches ?_)
    executes(pure, total)
{
    match guard
    {
        case ?held { return &held.acquisition; }
        case none { panic("missing spin lock acquisition"); }
    }
}

/// Creates a lock whose protocol and payload are initialized together.
trusted const func initialize<T>(pos value: T) -> std.sync.SpinLock<T>
    ensures(trusted valid(marker = &result.instance))
{
    return
    {
        instance = Marker
        {
        },
        storage = std.memory.uninit_from<State<T>>(
            {
                tickets = core.atomic.initialize<u32>(0),
                value = value,
            }
        ),
    };
}
