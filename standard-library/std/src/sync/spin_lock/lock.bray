trusted module std.sync;

using internal std.sync.spin_lock;

struct SpinLock<T>
{
    mut storage: Uninit<std.sync.spin_lock.State<T>>;

    trusted construct(pos value: T) -> Self
        ensures(trusted core.memory.uninit_initialized<std.sync.spin_lock.State<T>>(storage = &result.storage))
    {
        return
        {
            storage = std.memory.uninit_from<std.sync.spin_lock.State<T>>(
                {
                    next_ticket = core.atomic.initialize<u32>(0),
                    serving_ticket = core.atomic.initialize<u32>(0),
                    value = value,
                }
            ),
        };
    }

    trusted destruct()
        requires(trusted core.memory.uninit_initialized<std.sync.spin_lock.State<T>>(storage = &self.storage))
    {
        trusted std.memory.destroy_initialized<std.sync.spin_lock.State<T>>(&mut self.storage);
    }

    trusted func lock() -> SpinLockGuard<T>
        requires(trusted core.memory.uninit_initialized<std.sync.spin_lock.State<T>>(storage = &self.storage))
        ensures(
            trusted core.memory.uninit_initialized<std.sync.spin_lock.State<T>>(storage = &self.storage),
            trusted std.sync.spin_lock.acquired<T>(result),
        )
        uses(raw_memory, unchecked_alias)
    {
        let pointer = trusted std.sync.spin_lock.pointer<T>(&self.storage);
        let state = trusted std.memory.borrow_from<std.sync.spin_lock.State<T>, Self>(&self, pointer);
        let ticket: u32 = core.atomic.fetch_add<u32, 0>(&state.next_ticket, 1);

        while core.atomic.load<u32, 1>(&state.serving_ticket) != ticket
        {
            trusted internal spin_loop();
        }

        return
        {
            lock = &self
        };
    }

    trusted func try_lock() -> SpinLockGuard<T>?
        requires(trusted core.memory.uninit_initialized<std.sync.spin_lock.State<T>>(storage = &self.storage))
        ensures(
            trusted core.memory.uninit_initialized<std.sync.spin_lock.State<T>>(storage = &self.storage),
            trusted std.sync.spin_lock.acquired<T>(result),
        )
        uses(raw_memory, unchecked_alias)
    {
        let pointer = trusted std.sync.spin_lock.pointer<T>(&self.storage);
        let state = trusted std.memory.borrow_from<std.sync.spin_lock.State<T>, Self>(&self, pointer);
        let serving: u32 = core.atomic.load<u32, 1>(&state.serving_ticket);
        let next: u32 = core.atomic.load<u32, 0>(&state.next_ticket);

        if next != serving
        {
            return none;
        }

        let (_, acquired) = core.atomic.compare_exchange<u32, 0, 0>(
            &state.next_ticket,
            expected = next,
            desired = next + 1,
        );

        if !acquired
        {
            return none;
        }

        let guard: SpinLockGuard<T> =
        {
            lock = &self
        };

        return guard;
    }
}

trusted internal func spin_loop()
    uses(intrinsic)
{
    trusted core.target.spin_loop_hint();
}
