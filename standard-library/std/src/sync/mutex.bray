trusted module std.sync;

struct Mutex<T>
{
    internal next_ticket: core.atomic.Atomic<u32>;
    internal serving_ticket: core.atomic.Atomic<u32>;
    internal storage: T;

    construct(pos value: T) -> Self
    {
        return
        {
            next_ticket = core.atomic.initialize<u32>(0),
            serving_ticket = core.atomic.initialize<u32>(0),
            storage = value,
        };
    }

    func lock() -> MutexGuard<T>
        requires(blocking_execution())
    {
        let ticket: u32 = core.atomic.fetch_add<u32, 0>(&self.next_ticket, 1);
        let mut serving: u32 = core.atomic.load<u32, 1>(&self.serving_ticket);

        while serving != ticket
        {
            trusted internal std.atomic.platform_wait_word(&self.serving_ticket, expected = serving);

            serving = core.atomic.load<u32, 1>(&self.serving_ticket);
        }

        let guard: MutexGuard<T> =
        {
            mutex = &self,
            active = true,
        };

        return guard;
    }

    func try_lock() -> MutexGuard<T>?
    {
        let serving: u32 = core.atomic.load<u32, 1>(&self.serving_ticket);
        let next: u32 = core.atomic.load<u32, 0>(&self.next_ticket);

        if next != serving
        {
            return none;
        }

        let (_, acquired) = core.atomic.compare_exchange<u32, 0, 0>(
            &self.next_ticket,
            expected = next,
            desired = next + 1,
        );

        if !acquired
        {
            return none;
        }

        let mut result: MutexGuard<T>? = none;

        let guard: MutexGuard<T> =
        {
            mutex = &self,
            active = true,
        };

        result = guard;

        return result;
    }
}

struct MutexGuard<T>
{
    internal mutex: &Mutex<T>;
    internal mut active: bool;

    trusted destruct()
    {
        if self.active
        {
            trusted internal release_mutex<T>(self.mutex);
        }
    }

    mut func get() -> &mut T
    {
        let pointer: RawPointer<T> = trusted internal mutex_guard_pointer<T>(&mut self);

        return trusted std.memory.borrow_mut_from<T, MutexGuard<T>>(&mut self, pointer);
    }

    consume mut func unlock()
    {
        trusted internal release_mutex<T>(self.mutex);
        self.active = false;
    }

    internal func owner() -> &Mutex<T>
    {
        return self.mutex;
    }
}

trusted internal func mutex_guard_pointer<T>(pos guard: &mut MutexGuard<T>) -> RawPointer<T>
    ensures(
        trusted core.memory.valid_write<T>(pointer = result, count = 1),
        trusted core.memory.aligned_for<T>(pointer = result),
        trusted core.memory.initialized_as<T>(pointer = result),
        trusted core.memory.exclusive_alias_valid<T>(pointer = result),
        trusted core.memory.epoch_current<T>(pointer = result),
        trusted core.memory.synchronized_access<T>(pointer = result),
        trusted core.memory.movement_stable<T>(pointer = result),
        trusted core.memory.finalization_pending<T>(pointer = result),
    )
{
    if !guard.active
    {
        panic("storage access requires a live lock guard");
    }

    // Guard construction follows successful exclusive acquisition. The guard keeps the
    // lock alive and release consumes it, so this access cannot outlive that acquisition.
    return std.memory.address_of<T>(&guard.mutex.storage);
}

trusted internal func release_mutex<T>(pos mutex: &Mutex<T>)
{
    let _: u32 = core.atomic.fetch_add<u32, 2>(&mutex.serving_ticket, 1);

    trusted internal std.atomic.platform_wake_all_words(&mutex.serving_ticket);
}
