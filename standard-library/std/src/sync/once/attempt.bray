trusted module std.sync.once;

using core.atomic;
using core.memory;
using std.memory;
using std.sync;

struct Attempt<T>
{
    once: &std.sync.Once<T>;
    thread: &core.atomic.Atomic<u8>;
    acquisition: Marker;

    internal trusted func cell() -> &std.sync.Once<T>
        requires(trusted acquired(&self.acquisition))
        ensures(trusted acquired(&self.acquisition), trusted valid(&result.prepared.instance))
        executes(pure, total)
    {
        return self.once;
    }

    trusted destruct()
        requires(trusted acquired(&self.acquisition))
        ensures(trusted valid(&self.once.prepared.instance))
        executes(total)
    {
        let state = (trusted self.cell()).state();

        if core.atomic.load<u32, 0>(&state.phase) != INITIALIZED
        {
            core.atomic.store<usize, 0>(&state.owner, 0);
            core.atomic.store<u32, 2>(&state.phase, EMPTY);
            core.atomic.notify_all<u32>(&state.phase);
        }
    }

    trusted consume func publish(pos value: T) -> &T
        requires(trusted acquired(&self.acquisition))
        ensures(trusted valid(&self.once.prepared.instance))
        uses(raw_memory, unchecked_alias, unchecked_init)
    {
        let state = (trusted self.cell()).state();

        if core.atomic.load<u32, 0>(&state.phase) == REENTERED
        {
            panic("Once initialization reentered");
        }

        let pointer = std.memory.address_of<Uninit<T>>(&state.value);

        let authorize = trusted lambda(pos pointer: DataPointer<Uninit<T>>)
            ensures(
                trusted core.memory.valid_write<Uninit<T>>(pointer = pointer, count = 1),
                trusted core.memory.aligned_for<Uninit<T>>(pointer = pointer),
                trusted core.memory.initialized_as<Uninit<T>>(pointer = pointer),
                trusted core.memory.exclusive_alias_valid<Uninit<T>>(pointer = pointer),
                trusted core.memory.epoch_current<Uninit<T>>(pointer = pointer),
                trusted core.memory.synchronized_access<Uninit<T>>(pointer = pointer),
                trusted core.memory.movement_stable<Uninit<T>>(pointer = pointer),
                trusted core.memory.finalization_pending<Uninit<T>>(pointer = pointer),
            )
            executes(pure, total) {};

        authorize(pointer);
        trusted std.memory.write<Uninit<T>>(pointer, std.memory.uninit_from<T>(value));
        core.atomic.store<usize, 0>(&state.owner, 0);
        core.atomic.store<u32, 2>(&state.phase, INITIALIZED);
        core.atomic.notify_all<u32>(&state.phase);

        {
            let payload = std.memory.uninit_pointer<T>(&state.value);

            let readable = trusted lambda(pos payload: DataPointer<T>)
                ensures(
                    trusted core.memory.valid_read<T>(pointer = payload, count = 1),
                    trusted core.memory.aligned_for<T>(pointer = payload),
                    trusted core.memory.initialized_as<T>(pointer = payload),
                    trusted core.memory.shared_alias_valid<T>(pointer = payload),
                    trusted core.memory.epoch_current<T>(pointer = payload),
                    trusted core.memory.synchronized_access<T>(pointer = payload),
                    trusted core.memory.movement_stable<T>(pointer = payload),
                    trusted core.memory.finalization_pending<T>(pointer = payload),
                )
                executes(pure, total) {};

            readable(payload);

            return trusted std.memory.borrow_from<T, std.sync.Once<T>>(self.once, payload);
        };
    }
}
