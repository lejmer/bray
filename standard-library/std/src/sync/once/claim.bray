trusted module std.sync;

using core.target;
using core.atomic;
using core.memory;
using std.memory;
using internal std.sync.once;

impl Once<T>
{
    internal trusted func claim() -> std.sync.once.Attempt<T>?
        requires(blocking_execution(), trusted std.sync.once.valid(&self.prepared.instance))
        ensures(
            trusted std.sync.once.valid(&self.prepared.instance),
            result matches none || trusted std.sync.once.acquired(std.sync.once.marker<T>(&result)),
            !(result matches none) || trusted std.sync.once.ready(&self.prepared.instance),
        )
        uses(raw_memory, unchecked_alias, intrinsic)
    {
        let state = trusted self.state();

        let thread = &std.sync.once.CURRENT;

        let owner = trusted core.target.expose_address<core.atomic.Atomic<u8>>(
            std.memory.address_of<core.atomic.Atomic<u8>>(thread)
        );

        while true
        {
            let observed = core.atomic.load<u32, 1>(&state.phase);

            if observed == std.sync.once.INITIALIZED
            {
                return none;
            }

            if observed == std.sync.once.INITIALIZING || observed == std.sync.once.REENTERED
            {
                if core.atomic.load<usize, 0>(&state.owner) == owner
                {
                    core.atomic.store<u32, 0>(&state.phase, std.sync.once.REENTERED);
                    panic("Once initialization reentered");
                }

                core.atomic.wait<u32, 1>(&state.phase, expected = observed);
                continue;
            }

            let (_, acquired) = core.atomic.compare_exchange<u32, 1, 1>(
                &state.phase,
                expected = std.sync.once.EMPTY,
                desired = std.sync.once.INITIALIZING,
            );

            if acquired
            {
                core.atomic.store<usize, 0>(&state.owner, owner);

                let attempt: std.sync.once.Attempt<T> =
                {
                    once = &self,
                    thread = thread,
                    acquisition = std.sync.once.Marker
                    {
                    }
                };

                return attempt;
            }
        }

        return none;
    }
}
