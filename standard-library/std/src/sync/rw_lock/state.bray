trusted module std.sync.rw_lock;

const WRITE_LOCKED: u32 = 2_147_483_648;

const WRITER_PENDING_ONE: u32 = 65_536;

const WRITER_PENDING_MASK: u32 = 2_147_418_112;

const READER_COUNT_MASK: u32 = 65_535;

const READER_BLOCKED_MASK: u32 = 4_294_901_760;

struct State<T>
{
    state: core.atomic.Atomic<u32>;
    value: T;
}

struct Marker
{
}

trusted predicate valid(marker: &Marker);

trusted internal func register_writer<T>(pos lock: &State<T>)
{
    while true
    {
        let state: u32 = core.atomic.load<u32, 0>(&lock.state);

        if state & WRITER_PENDING_MASK == WRITER_PENDING_MASK
        {
            panic("reader-writer lock pending writer count exceeded the target range");
        }

        let (_, registered) = core.atomic.compare_exchange<u32, 1, 0>(
            &lock.state,
            expected = state,
            desired = state + WRITER_PENDING_ONE,
        );

        if registered
        {
            return unit;
        }
    }
}
