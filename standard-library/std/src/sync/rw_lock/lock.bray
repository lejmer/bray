trusted module std.sync;

using core.atomic;
using core.memory;
using std.memory;
using internal std.sync.rw_lock;

struct RwLock<T>
{
    instance: std.sync.rw_lock.Marker;
    storage: Uninit<std.sync.rw_lock.State<T>>;

    trusted construct(pos value: T) -> Self
        ensures(trusted std.sync.rw_lock.valid(&result.instance))
    {
        return
        {
            instance = std.sync.rw_lock.Marker
            {
            },
            storage = std.memory.uninit_from<std.sync.rw_lock.State<T>>(
                {
                    state = core.atomic.initialize<u32>(0),
                    value = std.memory.uninit_from<T>(value),
                }
            ),
        };
    }

    trusted destruct()
        requires(trusted std.sync.rw_lock.valid(&self.instance))
        uses(raw_memory, unchecked_init)
    {
        let pointer = std.memory.uninit_pointer<std.sync.rw_lock.State<T>>(&self.storage);

        let authorize = trusted lambda(pos pointer: DataPointer<std.sync.rw_lock.State<T>>)
            ensures(
                trusted core.memory.valid_read<std.sync.rw_lock.State<T>>(pointer = pointer, count = 1),
                trusted core.memory.aligned_for<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.initialized_as<std.sync.rw_lock.State<T>>(pointer = pointer),
            )
            executes(pure, total) {};

        authorize(pointer);

        let state: std.sync.rw_lock.State<T> = trusted std.memory.read<std.sync.rw_lock.State<T>>(pointer);

        let initialized = trusted lambda(pos storage: &Uninit<T>)
            ensures(trusted core.memory.uninit_initialized<T>(storage = storage))
            executes(pure, total) {};

        initialized(&state.value);

        let _: T = trusted std.memory.assume_initialized<T>(state.value);
    }

    trusted func read() -> RwLockReadGuard<T>
        requires(blocking_execution())
        requires(trusted std.sync.rw_lock.valid(&self.instance))
        ensures(
            trusted std.sync.rw_lock.valid(&self.instance),
            trusted std.sync.rw_lock.read.acquired(&result.acquisition),
        )
        uses(raw_memory, unchecked_alias)
    {
        let pointer = std.memory.uninit_pointer<std.sync.rw_lock.State<T>>(&self.storage);

        let authorize = trusted lambda(pos pointer: DataPointer<std.sync.rw_lock.State<T>>)
            ensures(
                trusted core.memory.valid_read<std.sync.rw_lock.State<T>>(pointer = pointer, count = 1),
                trusted core.memory.aligned_for<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.initialized_as<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.shared_alias_valid<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.epoch_current<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.synchronized_access<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.movement_stable<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.finalization_pending<std.sync.rw_lock.State<T>>(pointer = pointer),
            )
            executes(pure, total) {};

        authorize(pointer);

        let storage = trusted std.memory.borrow_from<std.sync.rw_lock.State<T>, Self>(&self, pointer);

        while true
        {
            let state: u32 = core.atomic.load<u32, 0>(&storage.state);

            if state & std.sync.rw_lock.READER_BLOCKED_MASK == 0
            {
                if state & std.sync.rw_lock.READER_COUNT_MASK == std.sync.rw_lock.READER_COUNT_MASK
                {
                    panic("reader-writer lock reader count exceeded the target range");
                }

                let (_, acquired) = core.atomic.compare_exchange<u32, 1, 0>(
                    &storage.state,
                    expected = state,
                    desired = state + 1,
                );

                if acquired
                {
                    let guard: RwLockReadGuard<T> =
                    {
                        lock = &self,
                        acquisition = std.sync.rw_lock.Marker
                        {
                        },
                    };

                    return guard;
                }
            }

            core.atomic.wait<u32, 1>(&storage.state, expected = state);
        }
    }

    trusted func write() -> RwLockWriteGuard<T>
        requires(blocking_execution())
        requires(trusted std.sync.rw_lock.valid(&self.instance))
        ensures(
            trusted std.sync.rw_lock.valid(&self.instance),
            trusted std.sync.rw_lock.write.acquired(&result.acquisition),
        )
        uses(raw_memory, unchecked_alias)
    {
        let pointer = std.memory.uninit_pointer<std.sync.rw_lock.State<T>>(&self.storage);

        let authorize = trusted lambda(pos pointer: DataPointer<std.sync.rw_lock.State<T>>)
            ensures(
                trusted core.memory.valid_read<std.sync.rw_lock.State<T>>(pointer = pointer, count = 1),
                trusted core.memory.aligned_for<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.initialized_as<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.shared_alias_valid<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.epoch_current<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.synchronized_access<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.movement_stable<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.finalization_pending<std.sync.rw_lock.State<T>>(pointer = pointer),
            )
            executes(pure, total) {};

        authorize(pointer);

        let storage = trusted std.memory.borrow_from<std.sync.rw_lock.State<T>, Self>(&self, pointer);

        trusted internal std.sync.rw_lock.register_writer<T>(storage);

        while true
        {
            let state: u32 = core.atomic.load<u32, 0>(&storage.state);

            if state & (std.sync.rw_lock.WRITE_LOCKED | std.sync.rw_lock.READER_COUNT_MASK) == 0
            {
                let (_, acquired) = core.atomic.compare_exchange<u32, 1, 0>(
                    &storage.state,
                    expected = state,
                    desired = (state - std.sync.rw_lock.WRITER_PENDING_ONE) | std.sync.rw_lock.WRITE_LOCKED,
                );

                if acquired
                {
                    let guard: RwLockWriteGuard<T> =
                    {
                        lock = &self,
                        acquisition = std.sync.rw_lock.Marker
                        {
                        },
                    };

                    return guard;
                }
            }

            core.atomic.wait<u32, 1>(&storage.state, expected = state);
        }
    }

    trusted func try_read() -> RwLockReadGuard<T>?
        requires(trusted std.sync.rw_lock.valid(&self.instance))
        ensures(
            trusted std.sync.rw_lock.valid(&self.instance),
            result matches none || trusted std.sync.rw_lock.read.acquired(std.sync.rw_lock.read.marker<T>(&result)),
        )
        uses(raw_memory, unchecked_alias)
    {
        let pointer = std.memory.uninit_pointer<std.sync.rw_lock.State<T>>(&self.storage);

        let authorize = trusted lambda(pos pointer: DataPointer<std.sync.rw_lock.State<T>>)
            ensures(
                trusted core.memory.valid_read<std.sync.rw_lock.State<T>>(pointer = pointer, count = 1),
                trusted core.memory.aligned_for<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.initialized_as<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.shared_alias_valid<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.epoch_current<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.synchronized_access<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.movement_stable<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.finalization_pending<std.sync.rw_lock.State<T>>(pointer = pointer),
            )
            executes(pure, total) {};

        authorize(pointer);

        let storage = trusted std.memory.borrow_from<std.sync.rw_lock.State<T>, Self>(&self, pointer);

        let state: u32 = core.atomic.load<u32, 0>(&storage.state);

        if state & std.sync.rw_lock.READER_BLOCKED_MASK != 0 || state & std.sync.rw_lock.READER_COUNT_MASK ==
            std.sync.rw_lock.READER_COUNT_MASK
        {
            return none;
        }

        let (_, acquired) = core.atomic.compare_exchange<u32, 1, 0>(
            &storage.state,
            expected = state,
            desired = state + 1
        );

        if !acquired
        {
            return none;
        }

        let guard: RwLockReadGuard<T> =
        {
            lock = &self,
            acquisition = std.sync.rw_lock.Marker
            {
            },
        };

        return guard;
    }

    trusted func try_write() -> RwLockWriteGuard<T>?
        requires(trusted std.sync.rw_lock.valid(&self.instance))
        ensures(
            trusted std.sync.rw_lock.valid(&self.instance),
            result matches none || trusted std.sync.rw_lock.write.acquired(std.sync.rw_lock.write.marker<T>(&result)),
        )
        uses(raw_memory, unchecked_alias)
    {
        let pointer = std.memory.uninit_pointer<std.sync.rw_lock.State<T>>(&self.storage);

        let authorize = trusted lambda(pos pointer: DataPointer<std.sync.rw_lock.State<T>>)
            ensures(
                trusted core.memory.valid_read<std.sync.rw_lock.State<T>>(pointer = pointer, count = 1),
                trusted core.memory.aligned_for<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.initialized_as<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.shared_alias_valid<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.epoch_current<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.synchronized_access<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.movement_stable<std.sync.rw_lock.State<T>>(pointer = pointer),
                trusted core.memory.finalization_pending<std.sync.rw_lock.State<T>>(pointer = pointer),
            )
            executes(pure, total) {};

        authorize(pointer);

        let storage = trusted std.memory.borrow_from<std.sync.rw_lock.State<T>, Self>(&self, pointer);

        let (_, acquired) = core.atomic.compare_exchange<u32, 1, 0>(
            &storage.state,
            expected = 0,
            desired = std.sync.rw_lock.WRITE_LOCKED
        );

        if !acquired
        {
            return none;
        }

        let guard: RwLockWriteGuard<T> =
        {
            lock = &self,
            acquisition = std.sync.rw_lock.Marker
            {
            },
        };

        return guard;
    }
}
