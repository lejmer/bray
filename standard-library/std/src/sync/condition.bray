trusted module std.sync;

using internal std.sync.mutex;

struct ConditionVariable
{
    internal generation: core.atomic.Atomic<u32>;

    construct() -> Self
        executes(pure, total)
    {
        return
        {
            generation = core.atomic.initialize<u32>(0),
        };
    }

    trusted func wait<T>(pos guard: MutexGuard<T>) -> MutexGuard<T>
        requires(blocking_execution(), trusted std.sync.mutex.acquired<T>(guard))
        ensures(
            trusted std.sync.mutex.acquired<T>(result),
            trusted core.memory.uninit_initialized<std.sync.mutex.State<T>>(storage = &result.mutex.storage),
        )
    {
        let generation: u32 = core.atomic.load<u32, 0>(&self.generation);

        let mutex = guard.owner();

        guard.unlock();

        return self.wait_for<T>(mutex, generation).lock();
    }

    internal trusted func wait_for<T>(pos mutex: &Mutex<T>, pos generation: u32) -> &Mutex<T>
        requires(
            blocking_execution(),
            trusted core.memory.uninit_initialized<std.sync.mutex.State<T>>(storage = &mutex.storage),
        )
        ensures(trusted core.memory.uninit_initialized<std.sync.mutex.State<T>>(storage = &result.storage))
    {
        // The native wait observes only this condition's generation word. It neither
        // consumes nor replaces the mutex's initialized storage while the guard is released.
        trusted internal std.atomic.platform_wait_word(&self.generation, expected = generation);

        return mutex;
    }

    func notify_one()
    {
        let _: u32 = core.atomic.fetch_add<u32, 2>(&self.generation, 1);

        trusted internal std.atomic.platform_wake_word(&self.generation);
    }

    func notify_all()
    {
        let _: u32 = core.atomic.fetch_add<u32, 2>(&self.generation, 1);

        trusted internal std.atomic.platform_wake_all_words(&self.generation);
    }
}
