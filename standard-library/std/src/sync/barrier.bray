trusted module std.sync;

using core.atomic;
using std.sync.mutex;

@copy
union BarrierWait
{
    Leader;
    Follower;
}

@copy
union BarrierError
{
    ZeroParticipants;
}

internal struct BarrierState
{
    mut arrived: usize;
}

struct Barrier
{
    internal participants: usize;
    internal state: Mutex<BarrierState>;
    internal generation: core.atomic.Atomic<u32>;

    construct(participants: usize) -> Result<Self, BarrierError>
        ensures(!(result matches Ok(_)) || trusted std.sync.mutex.valid(Barrier.result_marker(&result)))
    {
        if participants == 0
        {
            return Error(BarrierError.ZeroParticipants);
        }

        return Ok(
            {
                participants = participants,
                state = Mutex<BarrierState>(
                    {
                        arrived = 0,
                    }
                ),
                generation = core.atomic.initialize<u32>(0),
            }
        );
    }

    const func marker() -> &std.sync.mutex.Marker
        executes(pure, total)
    {
        return &self.state.instance;
    }

    static const func result_marker(pos value: &Result<Barrier, BarrierError>) -> &std.sync.mutex.Marker
        requires(value matches Ok(_))
        executes(pure, total)
    {
        match value
        {
            case Ok(barrier) { return barrier.marker(); }
            case Error(_) { panic("missing barrier"); }
        }
    }

    func wait() -> BarrierWait
        requires(blocking_execution(), trusted std.sync.mutex.valid(self.marker()))
        ensures(trusted std.sync.mutex.valid(self.marker()))
    {
        let mut guard: MutexGuard<BarrierState> = self.state.lock();
        let generation: u32 = core.atomic.load<u32, 1>(&self.generation);

        guard.get().arrived += 1;

        if guard.get().arrived == self.participants
        {
            guard.get().arrived = 0;

            _ = core.atomic.fetch_add<u32, 2>(&self.generation, 1);

            guard.unlock();

            core.atomic.notify_all<u32>(&self.generation);

            return BarrierWait.Leader;
        }

        guard.unlock();

        while core.atomic.load<u32, 1>(&self.generation) == generation
        {
            core.atomic.wait<u32, 1>(&self.generation, expected = generation);
        }

        return BarrierWait.Follower;
    }
}
