@target(target.identity.SYSTEM == "windows")
trusted internal module std.platform;

internal struct LocalAllocation
{
    pointer: RawPointer<u8>;
    count: usize;

    trusted destruct()
        requires(trusted native_arguments_live(owner = &self))
        executes(total)
        uses(foreign_call)
    {
        let _: RawPointer<u8> = trusted std.os.windows.local_free(self.pointer);
    }
}

internal struct EnvironmentBlock
{
    pointer: RawPointer<u16>;
    mut current: RawPointer<u16>;

    trusted destruct()
        requires(trusted native_environment_live(owner = &self))
        executes(total)
        uses(foreign_call)
    {
        if !std.memory.is_null<u16>(self.pointer)
        {
            let _: i32 = trusted std.os.windows.free_environment_strings_w(self.pointer);
        }
    }
}

trusted internal func process_identity() -> u64
    uses(foreign_call)
{
    return trusted std.os.windows.get_current_process_id() as u64;
}

trusted internal func native_text_width() -> usize
{
    return 16;
}

trusted internal func working_directory_storage() -> std.memory.RawBuffer<u8>
    uses(foreign_call)
{
    let required: u32 = trusted std.os.windows.get_current_directory_w(0, destination = std.memory.null<u16>());

    if required == 0 || required > 2_147_483_647
    {
        panic("the platform startup working directory is unavailable");
    }

    let bytes: usize = required as usize * 2;
    let mut buffer: std.memory.RawBuffer<u8> = trusted internal context_buffer(bytes);
    let observed: (bool, usize) = trusted internal fill_working_directory(&mut buffer, required = required);

    if !observed.0
    {
        panic("the platform startup working directory is unavailable");
    }

    trusted std.memory.set_initialized_count<u8>(&mut buffer, count = observed.1);

    return buffer;
}

trusted internal func argument_storage() -> std.memory.RawBuffer<u8>
{
    let owner: LocalAllocation = trusted internal native_arguments();
    let mut total: usize = 0;
    let mut index: usize = 0;

    while index < owner.count
    {
        let observed: (bool, NativeTextSpan) = trusted internal native_argument(&owner, index = index);

        if !observed.0
        {
            panic("the platform process context contains invalid native text");
        }

        let bytes: usize = observed.1.length as usize + 2;

        if total > 9_223_372_036_854_775_807 - bytes
        {
            panic("the platform process context is too large");
        }

        total += bytes;
        index += 1;
    }

    let mut buffer: std.memory.RawBuffer<u8> = trusted internal std.memory.allocate_buffer<u8>(
        capacity = total,
        bytes = total,
        align = 1
    );

    index = 0;

    while index < owner.count
    {
        if !trusted internal copy_native_argument(&owner, index = index, buffer = &mut buffer)
        {
            {
                let failed_owner: LocalAllocation = owner;
            };

            panic("the platform process context contains invalid native text");
        }

        index += 1;
    }

    return buffer;
}

trusted internal func environment_storage() -> Result<std.memory.RawBuffer<u8>, PlatformStatus>
{
    let mut owner: EnvironmentBlock = trusted internal native_environment();

    if std.memory.is_null<u16>(owner.pointer)
    {
        {
            let null_owner: EnvironmentBlock = owner;
        };

        return Error(trusted internal windows_error_status());
    }

    let mut total: usize = 0;

    loop
    {
        let observed: (bool, NativeTextSpan) = trusted internal native_environment_entry(&owner);

        if !observed.0
        {
            panic("the platform process context contains invalid native text");
        }

        let entry: NativeTextSpan = observed.1;

        if entry.length == 0
        {
            break;
        }

        if trusted internal std.memory.byte_buffer_read(entry.address, index = 0) != 61 ||
            trusted internal std.memory.byte_buffer_read(entry.address, index = 1) != 0
        {
            let bytes: usize = entry.length as usize + 2;

            if total > 9_223_372_036_854_775_807 - bytes
            {
                panic("the platform process context is too large");
            }

            total += bytes;
        }

        if !trusted internal advance_native_environment(&mut owner)
        {
            panic("the platform process context contains invalid native text");
        }
    }

    let mut buffer: std.memory.RawBuffer<u8> = trusted internal std.memory.allocate_buffer<u8>(
        capacity = total,
        bytes = total,
        align = 1
    );

    trusted internal reset_native_environment(&mut owner);

    loop
    {
        let observed: (bool, NativeTextSpan) = trusted internal native_environment_entry(&owner);

        if !observed.0
        {
            {
                let failed_owner: EnvironmentBlock = owner;
            };

            panic("the platform process context contains invalid native text");
        }

        let entry: NativeTextSpan = observed.1;

        if entry.length == 0
        {
            break;
        }

        if !trusted internal copy_native_environment_entry(&owner, buffer = &mut buffer)
        {
            {
                let failed_owner: EnvironmentBlock = owner;
            };

            panic("the platform process context contains invalid native text");
        }

        if !trusted internal advance_native_environment(&mut owner)
        {
            {
                let failed_owner: EnvironmentBlock = owner;
            };

            panic("the platform process context contains invalid native text");
        }
    }

    return Ok(buffer);
}

trusted internal func copy_native_argument(
    pos owner: &LocalAllocation,
    index: usize,
    buffer: &mut std.memory.RawBuffer<u8>,
) -> bool
    requires(trusted native_arguments_live(owner = owner), index < owner.count)
    ensures(trusted native_arguments_live(owner = owner))
    executes(total)
{
    let observed: (bool, NativeTextSpan) = trusted internal native_argument(owner, index = index);

    if !observed.0
    {
        return false;
    }

    let entry: NativeTextSpan = observed.1;
    let count: usize = entry.length as usize + 2;

    if count > buffer.capacity - buffer.initialized
    {
        return false;
    }

    let initialized: usize = trusted internal std.memory.copy_spare_raw_bytes(
        buffer,
        source = entry.address,
        count = count
    );

    trusted std.memory.set_initialized_count<u8>(buffer, count = initialized);
    return true;
}

trusted internal func copy_native_environment_entry(
    pos owner: &EnvironmentBlock,
    buffer: &mut std.memory.RawBuffer<u8>
) -> bool
    requires(trusted native_environment_live(owner = owner))
    ensures(trusted native_environment_live(owner = owner))
    executes(total)
{
    let observed: (bool, NativeTextSpan) = trusted internal native_environment_entry(owner);

    if !observed.0
    {
        return false;
    }

    let entry: NativeTextSpan = observed.1;

    if trusted internal std.memory.byte_buffer_read(entry.address, index = 0) != 61 ||
        trusted internal std.memory.byte_buffer_read(entry.address, index = 1) != 0
    {
        let count: usize = entry.length as usize + 2;

        if count > buffer.capacity - buffer.initialized
        {
            return false;
        }

        let initialized: usize = trusted internal std.memory.copy_spare_raw_bytes(
            buffer,
            source = entry.address,
            count = count
        );

        trusted std.memory.set_initialized_count<u8>(buffer, count = initialized);
    }

    return true;
}

trusted internal func environment_keys_equal(pos left: &[u8], pos right: &[u8]) -> bool
    uses(foreign_call)
{
    let left_bytes: usize = left.length();
    let right_bytes: usize = right.length();

    if left_bytes % 2 != 0 || right_bytes % 2 != 0
    {
        return false;
    }

    let left_units: usize = left_bytes / 2;
    let right_units: usize = right_bytes / 2;

    if left_units > 2_147_483_647 || right_units > 2_147_483_647
    {
        return false;
    }

    return trusted std.os.windows.compare_string_ordinal(
        trusted std.memory.reinterpret<u16, u8>(internal std.memory.slice_pointer(left, count = left.length())),
        left_length = std.truncate_to<i32>(left_units),
        right = trusted std.memory.reinterpret<u16, u8>(
            internal std.memory.slice_pointer(right, count = right.length())
        ),
        right_length = std.truncate_to<i32>(right_units),
        ignore_case = 1,
    ) == std.os.windows.CSTR_EQUAL;
}

trusted internal func terminated_u16_length(pos pointer: RawPointer<u16>) -> i32
    requires(trusted core.memory.wide_nul_terminated_read(pointer = pointer))
    ensures(trusted core.memory.wide_nul_terminated_read(pointer = pointer))
    executes(pure, total)
    uses(foreign_call)
{
    return trusted std.os.windows.wide_string_length(pointer);
}

trusted internal predicate native_arguments_live(owner: &LocalAllocation);

trusted internal predicate native_environment_live(owner: &EnvironmentBlock);

trusted internal func native_arguments() -> LocalAllocation
    ensures(trusted native_arguments_live(owner = &result))
    uses(foreign_call)
{
    let command_line: RawPointer<u16> = trusted std.os.windows.get_command_line_w();
    let mut count: i32 = 0;

    let arguments: RawPointer<RawPointer<u16>> = trusted std.os.windows.command_line_to_argv_w(
        command_line,
        count = std.memory.address_of_mut<i32>(&mut count),
    );

    if std.memory.is_null<RawPointer<u16>>(arguments) || count < 0
    {
        panic("the platform process arguments are unavailable");
    }

    return
    {
        pointer = trusted std.memory.reinterpret<u8, RawPointer<u16>>(arguments),
        count = std.truncate_to<usize>(count)
    };
}

trusted internal func native_argument_slot(pos owner: &LocalAllocation, index: usize) -> RawPointer<RawPointer<u16>>
    requires(trusted native_arguments_live(owner = owner), index < owner.count)
    ensures(
        trusted native_arguments_live(owner = owner),
        trusted core.memory.valid_read<RawPointer<u16>>(pointer = result, count = 1),
        trusted core.memory.aligned_for<RawPointer<u16>>(pointer = result),
        trusted core.memory.initialized_as<RawPointer<u16>>(pointer = result),
    )
    executes(pure, total)
{
    return std.memory.offset<RawPointer<u16>>(
        trusted std.memory.reinterpret<RawPointer<u16>, u8>(owner.pointer),
        elements = std.truncate_to<isize>(index),
    );
}

trusted internal func native_argument_pointer(pos owner: &LocalAllocation, index: usize) -> RawPointer<u16>
    requires(trusted native_arguments_live(owner = owner), index < owner.count)
    ensures(
        trusted native_arguments_live(owner = owner),
        trusted core.memory.wide_nul_terminated_read(pointer = result),
    )
    executes(pure, total)
{
    return trusted internal read_native_pointer<u16>(trusted internal native_argument_slot(owner, index = index));
}

trusted internal func native_argument(pos owner: &LocalAllocation, index: usize) -> (bool, NativeTextSpan)
    requires(trusted native_arguments_live(owner = owner), index < owner.count)
    ensures(
        trusted native_arguments_live(owner = owner),
        !result.0 || trusted core.memory.valid_read<u8>(
            pointer = result.1.address,
            count = result.1.length as usize + 2
        ),
        !result.0 || trusted core.memory.initialized_range_as<u8>(
            pointer = result.1.address,
            count = result.1.length as usize + 2
        ),
    )
    executes(pure, total)
{
    let pointer: RawPointer<u16> = trusted internal native_argument_pointer(owner, index = index);
    let length: i32 = trusted internal terminated_u16_length(pointer);

    if length < 0
    {
        return (
            false,
            {
                address = std.memory.null<u8>(),
                length = 0
            }
        );
    }

    return (
        true,
        {
            address = trusted std.memory.reinterpret<u8, u16>(pointer),
            length = std.truncate_to<u64>(length) * 2
        }
    );
}

trusted internal func native_environment() -> EnvironmentBlock
    ensures(trusted native_environment_live(owner = &result))
    uses(foreign_call)
{
    let pointer: RawPointer<u16> = trusted std.os.windows.get_environment_strings_w();

    return
    {
        pointer = pointer,
        current = pointer
    };
}

trusted internal func native_environment_pointer(pos owner: &EnvironmentBlock) -> RawPointer<u16>
    requires(trusted native_environment_live(owner = owner))
    ensures(
        trusted native_environment_live(owner = owner),
        std.memory.is_null<u16>(result) || trusted core.memory.wide_nul_terminated_read(pointer = result),
    )
    executes(pure, total)
{
    return owner.current;
}

trusted internal func native_environment_entry(pos owner: &EnvironmentBlock) -> (bool, NativeTextSpan)
    requires(trusted native_environment_live(owner = owner))
    ensures(
        trusted native_environment_live(owner = owner),
        !result.0 || trusted core.memory.valid_read<u8>(pointer = result.1.address, count = 2),
        !result.0 || trusted core.memory.initialized_range_as<u8>(pointer = result.1.address, count = 2),
        !result.0 || trusted core.memory.valid_read<u8>(
            pointer = result.1.address,
            count = result.1.length as usize + 2
        ),
        !result.0 || trusted core.memory.initialized_range_as<u8>(
            pointer = result.1.address,
            count = result.1.length as usize + 2
        ),
    )
    executes(pure, total)
{
    let pointer: RawPointer<u16> = trusted internal native_environment_pointer(owner);

    if std.memory.is_null<u16>(pointer)
    {
        return (
            false,
            {
                address = std.memory.null<u8>(),
                length = 0
            }
        );
    }

    let length: i32 = trusted internal terminated_u16_length(pointer);

    if length < 0
    {
        return (
            false,
            {
                address = std.memory.null<u8>(),
                length = 0
            }
        );
    }

    return (
        true,
        {
            address = trusted std.memory.reinterpret<u8, u16>(pointer),
            length = std.truncate_to<u64>(length) * 2
        }
    );
}

trusted internal func advance_native_environment(pos owner: &mut EnvironmentBlock) -> bool
    requires(trusted native_environment_live(owner = &owner))
    ensures(trusted native_environment_live(owner = &owner))
    executes(total)
{
    let advance: isize =
    {
        let pointer: RawPointer<u16> = trusted internal native_environment_pointer(&owner);

        if std.memory.is_null<u16>(pointer)
        {
            return false;
        }

        let length: i32 = trusted internal terminated_u16_length(pointer);

        if length < 0
        {
            return false;
        }

        if length == 0
        {
            return true;
        }

        yield std.truncate_to<isize>(length) + 1;
    };

    owner.current = std.memory.offset<u16>(owner.current, elements = advance);

    return true;
}

trusted internal func reset_native_environment(pos owner: &mut EnvironmentBlock)
    requires(trusted native_environment_live(owner = &owner))
    ensures(trusted native_environment_live(owner = &owner))
    executes(total)
{
    owner.current = owner.pointer;
}

trusted internal func windows_error_status() -> PlatformStatus
    uses(foreign_call)
{
    let code: u32 = trusted std.os.windows.get_last_error();

    return windows_error_status_from(code);
}

internal func windows_error_status_from(pos code: u32) -> PlatformStatus
{
    return native_status(category = windows_error_category(code), code = code as i64);
}

internal func windows_errno_status_from(pos code: i32) -> PlatformStatus
{
    let category: u32 = match code
    {
        case std.os.windows.EAGAIN | std.os.windows.ENOMEM { yield 7; }
        case _ { yield 10; }
    };

    return native_status(category = category, code = code as i64);
}

internal func windows_error_category(pos code: u32) -> u32
{
    return match code
    {
        case std.os.windows.ERROR_CALL_NOT_IMPLEMENTED | std.os.windows.ERROR_NOT_SUPPORTED { yield 1; }
        case std.os.windows.ERROR_ACCESS_DENIED | std.os.windows.ERROR_PRIVILEGE_NOT_HELD { yield 2; }
        case std.os.windows.ERROR_FILE_NOT_FOUND | std.os.windows.ERROR_MOD_NOT_FOUND |
            std.os.windows.ERROR_PATH_NOT_FOUND | std.os.windows.ERROR_PROC_NOT_FOUND
        {
            yield 3;
        }
        case std.os.windows.ERROR_ALREADY_EXISTS | std.os.windows.ERROR_FILE_EXISTS { yield 4; }
        case std.os.windows.ERROR_INVALID_DATA | std.os.windows.ERROR_INVALID_PARAMETER { yield 5; }
        case std.os.windows.ERROR_OPERATION_ABORTED { yield 6; }
        case std.os.windows.ERROR_NOT_ENOUGH_MEMORY | std.os.windows.ERROR_NO_SYSTEM_RESOURCES |
            std.os.windows.ERROR_OUTOFMEMORY | std.os.windows.ERROR_TOO_MANY_OPEN_FILES
        {
            yield 7;
        }
        case std.os.windows.ERROR_BROKEN_PIPE | std.os.windows.ERROR_HANDLE_EOF | std.os.windows.ERROR_NO_DATA
        {
            yield 8;
        }
        case std.os.windows.ERROR_SEM_TIMEOUT | std.os.windows.ERROR_TIMEOUT { yield 9; }
        case _ { yield 10; }
    };
}

trusted internal func prepare_clock_monotonic_now(pos ticks: RawPointer<u64>) -> Result<u64, PlatformStatus>
    requires(
        trusted core.memory.valid_write<u64>(pointer = ticks, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = ticks),
    )
    ensures(
        trusted core.memory.valid_write<u64>(pointer = ticks, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = ticks),
    )
    uses(foreign_call)
{
    let mut native_ticks: u64 = 0;

    trusted std.os.windows.query_interrupt_time_precise(std.memory.address_of_mut<u64>(&mut native_ticks));

    if native_ticks > 184_467_440_737_095_516
    {
        return Error(other_status());
    }

    return Ok(native_ticks * 100);
}

trusted internal func prepare_clock_wall_now(
    pos seconds: RawPointer<i64>,
    pos nanoseconds: RawPointer<u32>
) -> Result<(i64, u32), PlatformStatus>
    requires(
        trusted core.memory.valid_write<i64>(pointer = seconds, count = 1),
        trusted core.memory.aligned_for<i64>(pointer = seconds),
        trusted core.memory.valid_write<u32>(pointer = nanoseconds, count = 1),
        trusted core.memory.aligned_for<u32>(pointer = nanoseconds),
    )
    ensures(
        trusted core.memory.valid_write<i64>(pointer = seconds, count = 1),
        trusted core.memory.aligned_for<i64>(pointer = seconds),
        trusted core.memory.valid_write<u32>(pointer = nanoseconds, count = 1),
        trusted core.memory.aligned_for<u32>(pointer = nanoseconds),
    )
    uses(foreign_call)
{
    let mut observed: std.os.windows.FileTime =
    {
        low = 0,
        high = 0,
    };

    trusted std.os.windows.get_system_time_precise_as_file_time(
        std.memory.address_of_mut<std.os.windows.FileTime>(&mut observed)
    );

    return internal windows_file_time(low = observed.low, high = observed.high);
}

internal func windows_file_time(low: u32, high: u32) -> Result<(i64, u32), PlatformStatus>
{
    let native_ticks: u64 = low as u64 | high as u64 << 32;

    if native_ticks >= 116_444_736_000_000_000
    {
        let unix_ticks: u64 = native_ticks - 116_444_736_000_000_000;
        let whole_seconds: u64 = unix_ticks / 10_000_000;

        if whole_seconds > 9_223_372_036_854_775_807
        {
            return Error(other_status());
        }

        return Ok((std.truncate_to<i64>(whole_seconds), std.truncate_to<u32>(unix_ticks % 10_000_000 * 100)));
    }

    let before_epoch: u64 = 116_444_736_000_000_000 - native_ticks;
    let whole_seconds: u64 = before_epoch / 10_000_000;
    let remaining_ticks: u64 = before_epoch % 10_000_000;

    if remaining_ticks == 0
    {
        let nanoseconds: u32 = 0;

        return Ok((-std.truncate_to<i64>(whole_seconds), nanoseconds));
    }

    return Ok((-std.truncate_to<i64>(whole_seconds) - 1, 1_000_000_000 - std.truncate_to<u32>(remaining_ticks * 100),));
}

@abi(c)
trusted internal func clock_sleep(pos seconds: u64, pos nanoseconds: u32) -> PlatformStatus
    uses(foreign_call)
{
    if nanoseconds >= 1_000_000_000
    {
        return invalid_input_status();
    }

    let rounded_nanoseconds: u64 = nanoseconds as u64 + 999_999;

    if seconds > (18_446_744_073_709_551_615 - rounded_nanoseconds / 1_000_000) / 1_000
    {
        return invalid_input_status();
    }

    let mut milliseconds: u64 = seconds * 1_000 + rounded_nanoseconds / 1_000_000;

    while milliseconds > 4_294_967_294
    {
        trusted std.os.windows.sleep(4_294_967_294);
        milliseconds -= 4_294_967_294;
    }

    if milliseconds > 0
    {
        trusted std.os.windows.sleep(std.truncate_to<u32>(milliseconds));
    }

    return success_status();
}

trusted internal func prepare_entropy_fill(
    pos destination: RawPointer<u8>,
    pos length: u64,
    pos transferred: RawPointer<u64>,
) -> Result<usize, PlatformStatus>
    requires(
        trusted core.memory.valid_write<u8>(pointer = destination, count = length as usize),
        trusted core.memory.valid_write<u64>(pointer = transferred, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = transferred),
    )
    ensures(
        trusted core.memory.valid_write<u64>(pointer = transferred, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = transferred),
    )
    uses(foreign_call)
{
    let count: usize = std.truncate_to<usize>(length);

    if count as u64 != length
    {
        return Error(invalid_input_status());
    }

    let mut completed: usize = 0;

    while completed < count
    {
        let remaining: usize = count - completed;

        let requested: u32 = if remaining > 4_294_967_295
        {
            yield 4_294_967_295;
        }
        else
        {
            yield std.truncate_to<u32>(remaining);
        };

        let result: i32 = trusted std.os.windows.bcrypt_gen_random(
            std.memory.null<u8>(),
            destination = std.memory.offset<u8>(destination, elements = std.truncate_to<isize>(completed)),
            length = requested,
            flags = std.os.windows.BCRYPT_USE_SYSTEM_PREFERRED_RNG,
        );

        if result != 0
        {
            return Error(native_error_status(result as i64));
        }

        completed += requested as usize;
    }

    return Ok(count);
}

trusted internal func handle_read(
    pos handle: u64,
    standard_stream: u32 = 0,
    destination: RawPointer<u8>,
    length: u64,
    transferred: RawPointer<u64>,
) -> PlatformStatus
    requires(
        length == 0 || trusted core.memory.valid_write<u8>(pointer = destination, count = length as usize),
        trusted core.memory.valid_write<u64>(pointer = transferred, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = transferred),
    )
    ensures(trusted core.memory.initialized_as<u64>(pointer = transferred))
{
    let observed: (PlatformStatus, u64) = trusted internal prepare_handle_read(
        handle,
        standard_stream = standard_stream,
        destination = destination,
        length = length,
        transferred = transferred,
    );

    trusted std.memory.write<u64>(transferred, value = observed.1);

    return observed.0;
}

trusted internal func prepare_handle_read(
    pos handle: u64,
    standard_stream: u32 = 0,
    destination: RawPointer<u8>,
    length: u64,
    transferred: RawPointer<u64>,
) -> (PlatformStatus, u64)
    requires(
        length == 0 || trusted core.memory.valid_write<u8>(pointer = destination, count = length as usize),
        trusted core.memory.valid_write<u64>(pointer = transferred, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = transferred),
    )
    ensures(
        trusted core.memory.valid_write<u64>(pointer = transferred, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = transferred),
    )
    uses(foreign_call)
{
    if length == 0
    {
        return (internal success_status(), 0);
    }

    let native_handle: RawPointer<u8> = if standard_stream == 0
    {
        yield trusted internal handle_pointer(handle);
    }
    else
    {
        yield trusted std.os.windows.get_standard_handle(standard_stream);
    };

    let mut count: u32 = 0;

    let succeeded: i32 = trusted std.os.windows.read_file(
        native_handle,
        destination = destination,
        length = internal handle_request_length(length),
        transferred = std.memory.address_of_mut<u32>(&mut count),
        overlapped = std.memory.null<u8>(),
    );

    return (trusted internal handle_transfer_status(succeeded), count as u64);
}

trusted internal func handle_write(
    pos handle: u64,
    standard_stream: u32 = 0,
    source: RawPointer<u8>,
    length: u64,
    transferred: RawPointer<u64>,
) -> PlatformStatus
    requires(
        length == 0 || trusted core.memory.valid_read<u8>(pointer = source, count = length as usize),
        length == 0 || trusted core.memory.initialized_range_as<u8>(pointer = source, count = length as usize),
        trusted core.memory.valid_write<u64>(pointer = transferred, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = transferred),
    )
    ensures(trusted core.memory.initialized_as<u64>(pointer = transferred))
{
    let observed: (PlatformStatus, u64) = trusted internal prepare_handle_write(
        handle,
        standard_stream = standard_stream,
        source = source,
        length = length,
        transferred = transferred,
    );

    trusted std.memory.write<u64>(transferred, value = observed.1);

    return observed.0;
}

trusted internal func prepare_handle_write(
    pos handle: u64,
    standard_stream: u32 = 0,
    source: RawPointer<u8>,
    length: u64,
    transferred: RawPointer<u64>,
) -> (PlatformStatus, u64)
    requires(
        length == 0 || trusted core.memory.valid_read<u8>(pointer = source, count = length as usize),
        length == 0 || trusted core.memory.initialized_range_as<u8>(pointer = source, count = length as usize),
        trusted core.memory.valid_write<u64>(pointer = transferred, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = transferred),
    )
    ensures(
        trusted core.memory.valid_write<u64>(pointer = transferred, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = transferred),
    )
    uses(foreign_call)
{
    if length == 0
    {
        return (internal success_status(), 0);
    }

    let native_handle: RawPointer<u8> = if standard_stream == 0
    {
        yield trusted internal handle_pointer(handle);
    }
    else
    {
        yield trusted std.os.windows.get_standard_handle(standard_stream);
    };

    let mut count: u32 = 0;

    let succeeded: i32 = trusted std.os.windows.write_file(
        native_handle,
        source = source,
        length = internal handle_request_length(length),
        transferred = std.memory.address_of_mut<u32>(&mut count),
        overlapped = std.memory.null<u8>(),
    );

    return (trusted internal handle_transfer_status(succeeded), count as u64);
}

internal func handle_request_length(pos length: u64) -> u32
    executes(pure, total)
{
    return if length > 4_294_967_295
    {
        yield 4_294_967_295;
    }
    else
    {
        yield std.truncate_to<u32>(length);
    };
}

trusted internal func handle_transfer_status(pos succeeded: i32) -> PlatformStatus
{
    // ReadFile can report a transferred prefix on failure, including message-pipe ERROR_MORE_DATA.
    if succeeded == 0
    {
        return trusted internal windows_error_status();
    }

    return internal success_status();
}

trusted internal func fill_working_directory(pos buffer: &mut std.memory.RawBuffer<u8>, required: u32) -> (bool, usize)
    ensures(trusted core.memory.initialized_range_as<u8>(pointer = buffer.pointer, count = result.1))
    uses(foreign_call)
{
    let initialized: usize = trusted internal std.memory.fill_spare_bytes(
        buffer,
        value = 0,
        count = required as usize * 2
    );

    trusted std.memory.set_initialized_count<u8>(buffer, count = initialized);

    let written: u32 = trusted std.os.windows.get_current_directory_w(
        required,
        destination = trusted std.memory.reinterpret<u16, u8>(std.memory.pointer<u8>(&buffer)),
    );

    if written == 0 || written >= required
    {
        return (false, 0);
    }

    return (true, written as usize * 2);
}
