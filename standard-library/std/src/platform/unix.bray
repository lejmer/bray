@target(target.identity.SYSTEM == "linux" || target.identity.SYSTEM == "darwin")
trusted internal module std.platform;

internal struct TemporaryDescriptor
{
    value: i32;

    trusted destruct()
    {
        let _: i32 = trusted std.os.unix.close(self.value);
    }
}

trusted internal func native_text_width() -> usize
{
    return 8;
}

trusted internal func working_directory_storage() -> std.memory.RawBuffer<u8>
{
    let mut capacity: usize = 256;

    while capacity <= 9_223_372_036_854_775_807
    {
        let mut buffer: std.memory.RawBuffer<u8> = trusted internal context_buffer(capacity);

        let observed: (bool, usize) = trusted internal fill_working_directory(&mut buffer);

        if observed.0
        {
            trusted std.memory.set_initialized_count<u8>(&mut buffer, count = observed.1);

            return buffer;
        }

        if trusted internal unix_error_code() != 34 || capacity > 4_611_686_018_427_387_903
        {
            panic("the platform startup working directory is unavailable");
        }

        capacity += capacity;
    }

    panic("the platform startup working directory is unavailable");
}

trusted internal func environment_storage() -> Result<std.memory.RawBuffer<u8>, PlatformStatus>
    uses(foreign_call, raw_memory)
{
    return Ok(trusted internal copy_native_text_list(trusted internal environment_cursor()));
}

trusted internal func environment_keys_equal(pos left: &[u8], pos right: &[u8]) -> bool
{
    if left.length() != right.length()
    {
        return false;
    }

    let mut index: usize = 0;

    while index < left.length()
    {
        if left[index] != right[index]
        {
            return false;
        }

        index += 1;
    }

    return true;
}

// Only the native environment and argument producers construct this cursor. Each
// current slot belongs to their provider-owned table. Advancing never crosses its
// first null entry or the declared argument count.
internal struct NativeTextCursor
{
    first: RawPointer<RawPointer<u8>>;
    limit: usize;
    mut current: RawPointer<RawPointer<u8>>;
    mut remaining: usize;
}

trusted internal predicate native_text_cursor_valid(cursor: &NativeTextCursor);

trusted internal func native_text_cursor_slot(pos cursor: &NativeTextCursor) -> RawPointer<RawPointer<u8>>
    requires(trusted native_text_cursor_valid(cursor = cursor))
    ensures(
        trusted native_text_cursor_valid(cursor = cursor),
        trusted core.memory.valid_read<RawPointer<u8>>(pointer = result, count = 1),
        trusted core.memory.aligned_for<RawPointer<u8>>(pointer = result),
        trusted core.memory.initialized_as<RawPointer<u8>>(pointer = result),
    )
{
    if cursor.remaining == 0 || std.memory.is_null<RawPointer<u8>>(cursor.current)
    {
        panic("native text cursor has no current entry");
    }

    return cursor.current;
}

trusted internal func native_text_cursor_value(pos cursor: &NativeTextCursor) -> RawPointer<u8>
    requires(trusted native_text_cursor_valid(cursor = cursor))
    ensures(
        trusted native_text_cursor_valid(cursor = cursor),
        core.memory.is_null<u8>(result) || trusted core.memory.nul_terminated_read(pointer = result),
    )
{
    if cursor.remaining == 0
    {
        return std.memory.null<u8>();
    }

    let slot: RawPointer<RawPointer<u8>> = trusted internal native_text_cursor_slot(cursor);

    return trusted internal read_native_pointer<u8>(slot);
}

trusted internal func native_text_cursor_entry(pos cursor: &NativeTextCursor) -> (RawPointer<u8>, usize)
    requires(trusted native_text_cursor_valid(cursor = cursor))
    ensures(
        trusted native_text_cursor_valid(cursor = cursor),
        core.memory.is_null<u8>(result.0) || trusted core.memory.valid_read<u8>(
            pointer = result.0,
            count = result.1 + 1
        ),
        core.memory.is_null<u8>(result.0) || trusted core.memory.initialized_range_as<u8>(
            pointer = result.0,
            count = result.1 + 1
        ),
    )
{
    let entry: RawPointer<u8> = trusted internal native_text_cursor_value(cursor);

    if core.memory.is_null<u8>(entry)
    {
        return (entry, 0);
    }

    let length: usize = trusted internal terminated_byte_length(entry, limit = 9_223_372_036_854_775_807);

    return (entry, length);
}

trusted internal func advance_native_text_cursor(pos cursor: &mut NativeTextCursor)
    requires(trusted native_text_cursor_valid(cursor = &cursor))
    ensures(trusted native_text_cursor_valid(cursor = &cursor))
{
    let entry: RawPointer<u8> = trusted internal native_text_cursor_value(&cursor);

    if core.memory.is_null<u8>(entry)
    {
        cursor.remaining = 0;

        return;
    }

    cursor.remaining -= 1;

    if cursor.remaining > 0
    {
        cursor.current = std.memory.offset<RawPointer<u8>>(cursor.current, elements = 1);
    }
}

trusted internal func prepare_native_text_copy(
    pos cursor: &mut NativeTextCursor,
    capacity: usize
) -> std.memory.RawBuffer<u8>
    requires(trusted native_text_cursor_valid(cursor = &cursor))
    ensures(trusted native_text_cursor_valid(cursor = &cursor))
{
    let buffer: std.memory.RawBuffer<u8> = trusted internal context_buffer(capacity);

    cursor.current = cursor.first;
    cursor.remaining = cursor.limit;

    return buffer;
}

trusted internal func copy_native_text_entry(pos cursor: &NativeTextCursor, pos buffer: &mut std.memory.RawBuffer<u8>)
    requires(trusted native_text_cursor_valid(cursor = cursor))
    ensures(trusted native_text_cursor_valid(cursor = cursor))
{
    let observed: (RawPointer<u8>, usize) = trusted internal native_text_cursor_entry(cursor);

    if core.memory.is_null<u8>(observed.0)
    {
        panic("the platform process context changed while being copied");
    }

    let initialized: usize = trusted internal std.memory.copy_spare_raw_bytes(
        buffer,
        source = observed.0,
        count = observed.1 + 1,
    );

    trusted std.memory.set_initialized_count<u8>(buffer, count = initialized);
}

trusted internal func copy_native_text_list(pos mut cursor: NativeTextCursor) -> std.memory.RawBuffer<u8>
    requires(trusted native_text_cursor_valid(cursor = &cursor))
{
    let mut total: usize = 0;
    let mut length: usize = 0;

    loop
    {
        let observed: (RawPointer<u8>, usize) = trusted internal native_text_cursor_entry(&cursor);

        if core.memory.is_null<u8>(observed.0)
        {
            break;
        }

        if total > 9_223_372_036_854_775_807 - observed.1 - 1
        {
            panic("the platform process context is too large");
        }

        total += observed.1 + 1;
        length += 1;
        trusted internal advance_native_text_cursor(&mut cursor);
    }

    let mut buffer: std.memory.RawBuffer<u8> = trusted internal prepare_native_text_copy(&mut cursor, capacity = total);
    let mut index: usize = 0;

    while index < length
    {
        trusted internal copy_native_text_entry(&cursor, &mut buffer);

        trusted internal advance_native_text_cursor(&mut cursor);
        index += 1;
    }

    return buffer;
}

trusted internal func read_process_file(pos path: RawPointer<u8>) -> std.memory.RawBuffer<u8>
    uses(foreign_call)
{
    let descriptor: i32 = trusted std.os.unix.open_file(
        path,
        flags = std.os.unix.O_RDONLY | std.os.unix.O_CLOEXEC,
        mode = 0,
    );

    if descriptor < 0
    {
        panic("the platform process context is unavailable");
    }

    let owner: TemporaryDescriptor =
    {
        value = descriptor,
    };

    return trusted internal read_descriptor_to_end(owner.value);
}

trusted internal func read_descriptor_to_end(pos descriptor: i32) -> std.memory.RawBuffer<u8>
{
    let mut buffer: std.memory.RawBuffer<u8> = trusted internal context_buffer(4_096);

    loop
    {
        let used: usize = buffer.initialized;

        if used == buffer.capacity
        {
            match trusted internal std.memory.reserve_raw_buffer<u8>(
                &mut buffer,
                additional = 1,
                growth = internal std.memory.CapacityGrowth.Amortized,
            )
            {
                case Ok(_) {}
                case Error(_) { panic("the platform process context is too large"); }
            }
        }

        let observed: (isize, usize) = trusted internal read_context_buffer(descriptor, &mut buffer);
        let result: isize = observed.0;

        if result < 0
        {
            if trusted internal unix_error_code() == 4
            {
                continue;
            }

            panic("the platform process context is unavailable");
        }

        if result == 0
        {
            break;
        }

        trusted std.memory.set_initialized_count<u8>(&mut buffer, count = observed.1);
    }

    if trusted internal context_buffer_needs_terminator(&buffer)
    {
        match trusted internal std.memory.reserve_raw_buffer<u8>(
            &mut buffer,
            additional = 1,
            growth = internal std.memory.CapacityGrowth.Exact,
        )
        {
            case Ok(_) {}
            case Error(_) { panic("the platform process context is too large"); }
        }

        trusted internal append_context_terminator(&mut buffer);
    }

    return buffer;
}

trusted internal func fill_working_directory(pos buffer: &mut std.memory.RawBuffer<u8>) -> (bool, usize)
    ensures(trusted core.memory.initialized_range_as<u8>(pointer = buffer.pointer, count = result.1))
{
    let initialized: usize = buffer.initialized;
    let capacity: usize = buffer.capacity - initialized;

    if capacity == 0
    {
        return (false, initialized);
    }

    let pointer: RawPointer<u8> = trusted std.os.unix.working_directory(
        trusted std.memory.spare_pointer<u8>(buffer),
        capacity = capacity,
    );

    if core.memory.is_null<u8>(pointer)
    {
        return (false, initialized);
    }

    let length: usize = trusted internal terminated_byte_length(pointer, limit = capacity);

    return (true, initialized + length);
}

trusted internal func read_context_buffer(
    pos descriptor: i32,
    pos buffer: &mut std.memory.RawBuffer<u8>
) -> (isize, usize)
    ensures(trusted core.memory.initialized_range_as<u8>(pointer = buffer.pointer, count = result.1))
{
    let initialized: usize = buffer.initialized;
    let available: usize = buffer.capacity - initialized;

    let result: isize = trusted std.os.unix.read(
        descriptor,
        destination = trusted std.memory.spare_pointer<u8>(buffer),
        length = available,
    );

    if result < 0
    {
        return (result, initialized);
    }

    let count: usize = std.truncate_to<usize>(result);

    assert(count <= available, "native read exceeds spare storage");

    return (result, initialized + count);
}

trusted internal func context_buffer_needs_terminator(pos buffer: &std.memory.RawBuffer<u8>) -> bool
{
    let bytes: &[u8] = trusted std.memory.initialized_slice<u8>(buffer);
    let length: usize = bytes.length();

    if length == 0
    {
        return false;
    }

    return bytes[length - 1] != 0;
}

trusted internal func append_context_terminator(pos buffer: &mut std.memory.RawBuffer<u8>) -> unit
{
    trusted internal std.memory.initialize_spare<u8>(buffer, 0);
}

trusted internal func terminated_byte_length(pos pointer: RawPointer<u8>, limit: usize) -> usize
    requires(trusted core.memory.nul_terminated_read(pointer = pointer))
    ensures(
        trusted core.memory.valid_read<u8>(pointer = pointer, count = result + 1),
        trusted core.memory.initialized_range_as<u8>(pointer = pointer, count = result + 1),
    )
{
    let length: usize = trusted std.os.unix.narrow_string_length(pointer, limit);

    if length == limit
    {
        panic("the platform process context contains invalid native text");
    }

    return length;
}

trusted internal func descriptor_read(
    pos descriptor: i32,
    destination: RawPointer<u8>,
    length: u64,
    transferred: RawPointer<u64>,
) -> PlatformStatus
    requires(
        length == 0 || trusted core.memory.valid_write<u8>(pointer = destination, count = length as usize),
        trusted core.memory.valid_write<u64>(pointer = transferred, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = transferred),
    )
    ensures(trusted core.memory.initialized_as<u64>(pointer = transferred))
{
    let observed: (PlatformStatus, u64) = trusted internal prepare_descriptor_read(
        descriptor,
        destination = destination,
        length = length,
        transferred = transferred,
    );

    trusted std.memory.write<u64>(transferred, value = observed.1);

    return observed.0;
}

trusted internal func prepare_descriptor_read(
    pos descriptor: i32,
    destination: RawPointer<u8>,
    length: u64,
    transferred: RawPointer<u64>,
) -> (PlatformStatus, u64)
    requires(
        length == 0 || trusted core.memory.valid_write<u8>(pointer = destination, count = length as usize),
        trusted core.memory.valid_write<u64>(pointer = transferred, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = transferred),
    )
    ensures(
        trusted core.memory.valid_write<u64>(pointer = transferred, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = transferred),
    )
{
    if length == 0
    {
        return (internal success_status(), 0);
    }

    let requested: usize = internal descriptor_request_length(length);
    let count: isize = trusted std.os.unix.read(descriptor, destination = destination, length = requested);

    if count < 0
    {
        return (trusted unix_error_status(), 0);
    }

    return (internal success_status(), std.truncate_to<u64>(count));
}

trusted internal func descriptor_write(
    pos descriptor: i32,
    source: RawPointer<u8>,
    length: u64,
    transferred: RawPointer<u64>,
) -> PlatformStatus
    requires(
        length == 0 || trusted core.memory.valid_read<u8>(pointer = source, count = length as usize),
        length == 0 || trusted core.memory.initialized_range_as<u8>(pointer = source, count = length as usize),
        trusted core.memory.valid_write<u64>(pointer = transferred, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = transferred),
    )
    ensures(trusted core.memory.initialized_as<u64>(pointer = transferred))
{
    let observed: (PlatformStatus, u64) = trusted internal prepare_descriptor_write(
        descriptor,
        source = source,
        length = length,
        transferred = transferred,
    );

    trusted std.memory.write<u64>(transferred, value = observed.1);

    return observed.0;
}

trusted internal func prepare_descriptor_write(
    pos descriptor: i32,
    source: RawPointer<u8>,
    length: u64,
    transferred: RawPointer<u64>,
) -> (PlatformStatus, u64)
    requires(
        length == 0 || trusted core.memory.valid_read<u8>(pointer = source, count = length as usize),
        length == 0 || trusted core.memory.initialized_range_as<u8>(pointer = source, count = length as usize),
        trusted core.memory.valid_write<u64>(pointer = transferred, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = transferred),
    )
    ensures(
        trusted core.memory.valid_write<u64>(pointer = transferred, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = transferred),
    )
{
    if length == 0
    {
        return (internal success_status(), 0);
    }

    let requested: usize = internal descriptor_request_length(length);
    let count: isize = trusted std.os.unix.write(descriptor, source = source, length = requested);

    if count < 0
    {
        return (trusted unix_error_status(), 0);
    }

    return (internal success_status(), std.truncate_to<u64>(count));
}

internal const func descriptor_request_length(pos length: u64) -> usize
    executes(pure, total)
    ensures(result <= length as usize)
{
    let maximum: u64 = 9_223_372_036_854_775_807;

    if length > maximum
    {
        return maximum as usize;
    }

    return length as usize;
}

internal func checked_descriptor(pos handle: u64) -> Result<i32, PlatformStatus>
    executes(pure, total)
{
    if handle > 2_147_483_647
    {
        return Error(invalid_input_status());
    }

    return Ok(std.truncate_to<i32>(handle));
}
