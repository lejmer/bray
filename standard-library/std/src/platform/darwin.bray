@target(target.identity.NAME == "x86_64-apple-darwin" || target.identity.NAME == "aarch64-apple-darwin")
trusted internal module std.platform;

trusted internal func process_identity() -> u64
    uses(foreign_call)
{
    let identity: i32 = trusted internal std.os.darwin.getpid();

    if identity <= 0
    {
        panic("the platform process identity is unavailable");
    }

    return std.truncate_to<u64>(identity);
}

trusted internal func environment_storage_address() -> RawPointer<RawPointer<RawPointer<u8>>>
    ensures(
        trusted core.memory.valid_read<RawPointer<RawPointer<u8>>>(pointer = result, count = 1),
        trusted core.memory.aligned_for<RawPointer<RawPointer<u8>>>(pointer = result),
        trusted core.memory.initialized_as<RawPointer<RawPointer<u8>>>(pointer = result),
    )
{
    return std.os.darwin.ENVIRON;
}

trusted internal func environment_cursor() -> NativeTextCursor
    ensures(trusted native_text_cursor_valid(cursor = &result))
{
    let entries: RawPointer<RawPointer<u8>> = trusted internal read_native_pointer<RawPointer<u8>>(
        trusted internal environment_storage_address()
    );

    return
    {
        first = entries,
        limit = 18_446_744_073_709_551_615,
        current = entries,
        remaining = 18_446_744_073_709_551_615,
    };
}

trusted internal func argument_storage() -> std.memory.RawBuffer<u8>
{
    return trusted internal copy_native_text_list(trusted internal argument_cursor());
}

trusted internal func argument_cursor() -> NativeTextCursor
    ensures(trusted native_text_cursor_valid(cursor = &result))
    uses(foreign_call)
{
    let count: i32 = trusted internal read_native_i32(trusted internal std.os.darwin.ns_get_argc());

    if count < 0
    {
        panic("the platform process arguments are unavailable");
    }

    let entries: RawPointer<RawPointer<u8>> = trusted internal read_native_pointer<RawPointer<u8>>(
        trusted internal std.os.darwin.ns_get_argv()
    );

    return
    {
        first = entries,
        limit = std.truncate_to<usize>(count),
        current = entries,
        remaining = std.truncate_to<usize>(count),
    };
}

trusted internal func unix_error_status() -> PlatformStatus
{
    return darwin_error_status();
}

trusted internal func unix_error_code() -> i32
{
    return darwin_error_code();
}

trusted internal func clear_unix_error() -> unit
    uses(foreign_call)
{
    trusted std.memory.write<i32>(trusted internal std.os.darwin.error_location(), value = 0);
}

trusted internal func prepare_clock_monotonic_now(pos ticks: RawPointer<u64>) -> Result<u64, PlatformStatus>
    requires(
        trusted core.memory.valid_write<u64>(pointer = ticks, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = ticks),
    )
    ensures(
        trusted core.memory.valid_write<u64>(pointer = ticks, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = ticks),
    )
    uses(foreign_call)
{
    let mut observed: std.os.darwin.Timespec =
    {
        seconds = 0,
        nanoseconds = 0,
    };

    if trusted internal std.os.darwin.clock_gettime(
        6,
        time = std.memory.address_of_mut<std.os.darwin.Timespec>(&mut observed),
    ) != 0
    {
        return Error(darwin_error_status());
    }

    if observed.seconds < 0 || 0 > observed.nanoseconds || observed.nanoseconds >= 1_000_000_000
    {
        return Error(other_status());
    }

    let seconds: u64 = std.truncate_to<u64>(observed.seconds);
    let observed_nanoseconds: u64 = std.truncate_to<u64>(observed.nanoseconds);

    if seconds > (18_446_744_073_709_551_615 - observed_nanoseconds) / 1_000_000_000
    {
        return Error(other_status());
    }

    return Ok(seconds * 1_000_000_000 + observed_nanoseconds);
}

trusted internal func prepare_clock_wall_now(
    pos seconds: RawPointer<i64>,
    pos nanoseconds: RawPointer<u32>
) -> Result<(i64, u32), PlatformStatus>
    requires(
        trusted core.memory.valid_write<i64>(pointer = seconds, count = 1),
        trusted core.memory.aligned_for<i64>(pointer = seconds),
        trusted core.memory.valid_write<u32>(pointer = nanoseconds, count = 1),
        trusted core.memory.aligned_for<u32>(pointer = nanoseconds),
    )
    ensures(
        trusted core.memory.valid_write<i64>(pointer = seconds, count = 1),
        trusted core.memory.aligned_for<i64>(pointer = seconds),
        trusted core.memory.valid_write<u32>(pointer = nanoseconds, count = 1),
        trusted core.memory.aligned_for<u32>(pointer = nanoseconds),
    )
    uses(foreign_call)
{
    let mut observed: std.os.darwin.Timespec =
    {
        seconds = 0,
        nanoseconds = 0,
    };

    if trusted internal std.os.darwin.clock_gettime(
        0,
        time = std.memory.address_of_mut<std.os.darwin.Timespec>(&mut observed),
    ) != 0
    {
        return Error(darwin_error_status());
    }

    if 0 > observed.nanoseconds || observed.nanoseconds >= 1_000_000_000
    {
        return Error(other_status());
    }

    return Ok((observed.seconds, std.truncate_to<u32>(observed.nanoseconds)));
}

@abi(c)
trusted internal func clock_sleep(pos seconds: u64, pos nanoseconds: u32) -> PlatformStatus
    uses(foreign_call)
{
    if nanoseconds >= 1_000_000_000 || seconds > 9_223_372_036_854_775_807
    {
        return invalid_input_status();
    }

    let mut duration: std.os.darwin.Timespec =
    {
        seconds = std.truncate_to<i64>(seconds),
        nanoseconds = nanoseconds as i64,
    };

    let mut remaining: std.os.darwin.Timespec =
    {
        seconds = 0,
        nanoseconds = 0,
    };

    while trusted internal std.os.darwin.nanosleep(
        std.memory.address_of_mut<std.os.darwin.Timespec>(&mut duration),
        remaining = std.memory.address_of_mut<std.os.darwin.Timespec>(&mut remaining),
    ) != 0
    {
        if darwin_error_code() != 4
        {
            return darwin_error_status();
        }

        duration = remaining;
    }

    return success_status();
}

trusted internal func prepare_entropy_fill(
    pos destination: RawPointer<u8>,
    pos length: u64,
    pos transferred: RawPointer<u64>,
) -> Result<usize, PlatformStatus>
    requires(
        trusted core.memory.valid_write<u8>(pointer = destination, count = length as usize),
        trusted core.memory.valid_write<u64>(pointer = transferred, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = transferred),
    )
    ensures(
        trusted core.memory.valid_write<u64>(pointer = transferred, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = transferred),
    )
    uses(foreign_call)
{
    let count: usize = std.truncate_to<usize>(length);

    if count as u64 != length
    {
        return Error(invalid_input_status());
    }

    trusted internal std.os.darwin.arc4random_buf(destination, length = count);
    return Ok(count);
}

trusted internal func darwin_error_code() -> i32
    uses(foreign_call)
{
    return trusted internal read_native_i32(trusted internal std.os.darwin.error_location());
}

trusted internal func darwin_error_status() -> PlatformStatus
{
    return unix_error_status_from(darwin_error_code());
}

trusted internal func unix_error_status_from(pos code: i32) -> PlatformStatus
{
    let category: u32 = match code
    {
        case std.os.darwin.ENOSYS | std.os.darwin.ENOTSUP { yield 1; }
        case std.os.darwin.EACCES | std.os.darwin.EPERM { yield 2; }
        case std.os.darwin.ENOENT { yield 3; }
        case std.os.darwin.EEXIST { yield 4; }
        case std.os.darwin.EINVAL { yield 5; }
        case std.os.darwin.EINTR { yield 6; }
        case std.os.darwin.EAGAIN | std.os.darwin.ENOMEM { yield 7; }
        case std.os.darwin.EPIPE { yield 8; }
        case std.os.darwin.ETIMEDOUT { yield 9; }
        case _ { yield 10; }
    };

    return native_status(category = category, code = code as i64);
}
