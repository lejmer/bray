trusted internal module std.platform;

using std.memory;

@copy
@layout(c)
internal struct PlatformStatus
{
    category: u32;
    reserved: u32;
    native_code: i64;
}

@copy
@layout(c)
internal struct NativeTextSpan
{
    address: RawPointer<u8>;
    length: u64;
}

@copy
@layout(c)
internal struct NativeTextPair
{
    key: NativeTextSpan;
    value: NativeTextSpan;
}

trusted internal func copy_context_text(pos address: RawPointer<u8>, length: u64) -> std.memory.RawBuffer<u8>
{
    let count: usize = length as usize;

    if count as u64 != length || (count > 0 && std.memory.is_null<u8>(address))
    {
        panic("the platform process context text is invalid");
    }

    let created: Result<std.memory.RawBuffer<u8>, std.memory.MemoryLayoutError> = trusted std.memory.RawBuffer<u8>(
        capacity = count
    );

    match consume created
    {
        case Ok(buffer)
        {
            let mut buffer: std.memory.RawBuffer<u8> = buffer;

            if count > 0
            {
                let destination: RawPointer<u8> = trusted std.memory.spare_pointer<u8>(&mut buffer);

                trusted internal std.memory.byte_buffer_copy(address, destination, count = count);

                trusted std.memory.set_initialized_count<u8>(&mut buffer, count = count);
            }

            return buffer;
        }
        case Error(_) { panic("the platform process context text cannot be allocated"); }
    }
}

trusted internal func environment_keys_equal(pos left: &[u8], pos right: &[u8]) -> bool
{
    return trusted internal environment_key_equals_span(left, right = native_text_span(right));
}

internal func native_text_span(pos value: &[u8]) -> NativeTextSpan
{
    return
    {
        address = internal std.memory.byte_slice_pointer(value),
        length = internal std.memory.slice_length<u8>(value) as u64,
    };
}

trusted internal func context_buffer(pos capacity: usize) -> std.memory.RawBuffer<u8>
{
    let created: Result<std.memory.RawBuffer<u8>, std.memory.MemoryLayoutError> = trusted std.memory.RawBuffer<u8>(
        capacity = capacity
    );

    match consume created
    {
        case Ok(buffer) { return buffer; }
        case Error(_) { panic("the platform process context cannot be allocated"); }
    }
}

trusted internal func terminated_native_text(
    pos address: RawPointer<u8>,
    length: u64,
    terminator_bytes: usize,
) -> Result<std.memory.RawBuffer<u8>, PlatformStatus>
{
    let count: usize = length as usize;

    if count as u64 != length || terminator_bytes == 0 || count > 18_446_744_073_709_551_615 - terminator_bytes
    {
        return Error(invalid_input_status());
    }

    if count > 0 && std.memory.is_null<u8>(address)
    {
        return Error(invalid_input_status());
    }

    let total: usize = count + terminator_bytes;

    let created: Result<std.memory.RawBuffer<u8>, std.memory.MemoryLayoutError> = trusted std.memory.RawBuffer<u8>(
        capacity = total
    );

    match consume created
    {
        case Ok(buffer)
        {
            let mut buffer: std.memory.RawBuffer<u8> = buffer;
            let destination: RawPointer<u8> = trusted std.memory.spare_pointer<u8>(&mut buffer);

            if count > 0
            {
                trusted internal std.memory.byte_buffer_copy(address, destination, count = count);
            }

            let terminator: RawPointer<u8> = std.memory.offset<u8>(
                destination,
                elements = std.truncate_to<isize>(count),
            );

            trusted internal std.memory.byte_buffer_fill(terminator, value = 0, count = terminator_bytes);

            trusted std.memory.set_initialized_count<u8>(&mut buffer, count = total);

            return Ok(buffer);
        }
        case Error(_) { return Error(exhausted_status()); }
    }
}

trusted internal func read_native_i32(pos pointer: RawPointer<i32>) -> i32
{
    let source: RawPointer<u8> = trusted std.memory.reinterpret<u8, i32>(pointer);

    let value: u32 = trusted internal std.memory.byte_buffer_read(source, index = 0) as u32 |
        trusted internal std.memory.byte_buffer_read(source, index = 1) as u32 << 8 |
        trusted internal std.memory.byte_buffer_read(source, index = 2) as u32 << 16 |
        trusted internal std.memory.byte_buffer_read(source, index = 3) as u32 << 24;

    return std.truncate_to<i32>(value);
}

trusted internal func read_native_u16(pos pointer: RawPointer<u16>) -> u16
{
    let source: RawPointer<u8> = trusted std.memory.reinterpret<u8, u16>(pointer);

    return trusted internal std.memory.byte_buffer_read(source, index = 0) as u16 |
        trusted internal std.memory.byte_buffer_read(source, index = 1) as u16 << 8;
}

trusted internal func read_native_u32(pos pointer: RawPointer<u8>) -> u32
{
    return trusted internal std.memory.byte_buffer_read(pointer, index = 0) as u32 |
        trusted internal std.memory.byte_buffer_read(pointer, index = 1) as u32 << 8 |
        trusted internal std.memory.byte_buffer_read(pointer, index = 2) as u32 << 16 |
        trusted internal std.memory.byte_buffer_read(pointer, index = 3) as u32 << 24;
}

trusted internal func read_native_u64(pos pointer: RawPointer<u8>) -> u64
{
    let mut value: u64 = 0;
    let mut index: usize = 0;

    while index < 8
    {
        value |= trusted internal std.memory.byte_buffer_read(pointer, index = index) as u64 << (index as u64 * 8);
        index += 1;
    }

    return value;
}

trusted internal func read_native_pointer<T>(pos pointer: RawPointer<RawPointer<T>>) -> RawPointer<T>
    uses(intrinsic)
{
    let source: RawPointer<u8> = trusted std.memory.reinterpret<u8, RawPointer<T>>(pointer);
    let mut address: u64 = 0;
    let mut index: usize = 0;

    while index < 8
    {
        address |= trusted internal std.memory.byte_buffer_read(source, index = index) as u64 << (index as u64 * 8);
        index += 1;
    }

    return trusted core.target.from_exposed_address<T>(address = std.truncate_to<usize>(address));
}

trusted internal func pointer_handle(pos pointer: RawPointer<u8>) -> u64
    uses(intrinsic)
{
    return trusted core.target.expose_address<u8>(pointer) as u64;
}

trusted internal func handle_pointer(pos handle: u64) -> RawPointer<u8>
    uses(intrinsic)
{
    return trusted core.target.from_exposed_address<u8>(address = std.truncate_to<usize>(handle));
}

internal func successful_status(pos status: PlatformStatus) -> bool
{
    return status.category == 0 && status.reserved == 0;
}

internal func is_exhausted_status(pos status: PlatformStatus) -> bool
{
    return status.category == 7 && status.reserved == 0;
}
