@target(target.identity.SYSTEM == "linux" || target.identity.SYSTEM == "darwin")
trusted internal module std.platform.heap;

trusted internal func allocate(pos bytes: usize, align: usize) -> DataPointer<u8>
    uses(foreign_call)
{
    return trusted aligned_allocate(alignment = align, bytes = bytes);
}

trusted internal func deallocate(pos allocation: DataPointer<u8>) -> bool
    uses(foreign_call)
{
    trusted release(allocation);

    return true;
}

@link(name = "c", kind = system)
@symbol(name = "aligned_alloc")
@abi(c)
extern trusted func aligned_allocate(pos alignment: usize, pos bytes: usize) -> DataPointer<u8>
    uses(foreign_call);

@link(name = "c", kind = system)
@symbol(name = "free")
@abi(c)
extern trusted func release(pos allocation: DataPointer<u8>) -> unit
    uses(foreign_call);
