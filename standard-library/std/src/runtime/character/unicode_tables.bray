trusted internal func alphabetic(pos value: u32) -> bool
{
    let leaf: usize = trusted classification_leaf(value);
    let bit: usize = (value & 31) as usize;
    let bits: usize = CLASSIFICATION_ALPHABETIC[leaf][bit / 8] as usize;

    return (bits >> (bit % 8)) & 1 != 0;
}

