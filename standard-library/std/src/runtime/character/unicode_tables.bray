trusted internal func whitespace(pos value: u32) -> bool
{
    let leaf: usize = trusted classification_leaf(value);
    let bit: usize = (value & 31) as usize;
    let bits: usize = CLASSIFICATION_WHITESPACE[leaf][bit / 8] as usize;

    return (bits >> (bit % 8)) & 1 != 0;
}

trusted internal func classification_leaf(pos value: u32) -> usize
{
    let root_index: usize = (value >> 10) as usize;
    let branch: usize = CLASSIFICATION_ROOT[root_index / 16][root_index % 16] as usize;
    let index: usize = branch * 32 + ((value >> 5) & 31) as usize;

    return CLASSIFICATION_BRANCHES[index / 16][index % 16] as usize;
}
