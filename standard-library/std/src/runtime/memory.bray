trusted internal module std.runtime.memory;

using std.memory;
using internal std.platform.heap;

trusted func allocate(pos bytes: usize, pos align: usize) -> DataPointer<u8>
{
    let allocation: DataPointer<u8> = trusted try_allocate(bytes, align);

    assert(!std.memory.is_null<u8>(allocation), "memory allocation failed");

    return allocation;
}

trusted internal func try_allocate(pos bytes: usize, pos align: usize) -> DataPointer<u8>
{
    assert(align != 0 && align & (align - 1) == 0, "memory allocation alignment must be a nonzero power of two");

    let pointer_alignment: usize = std.memory.align_of<DataPointer<u8>>();
    let effective_alignment: usize = maximum(align, right = pointer_alignment);

    let payload_bytes: usize = maximum(bytes, right = 1);
    let padding_bytes: usize = effective_alignment - 1;
    let maximum_bytes: usize = ~0;

    if padding_bytes > maximum_bytes - payload_bytes
    {
        return std.memory.null<u8>();
    }

    let allocation_bytes: usize = (payload_bytes + padding_bytes) & ~padding_bytes;

    return trusted std.platform.heap.allocate(allocation_bytes, align = effective_alignment);
}

trusted func deallocate(pos pointer: DataPointer<u8>, pos bytes: usize, pos align: usize) -> unit
    requires(!std.memory.is_null<u8>(pointer), align != 0 && align & (align - 1) == 0)
    executes(total)
{
    _ = bytes;

    trusted std.platform.heap.deallocate(pointer);
}

func maximum(pos left: usize, right: usize) -> usize
{
    if left >= right
    {
        return left;
    }

    return right;
}
