@abi(c)
trusted internal func platform_path_rename(
    pos source: PlatformPath,
    pos new_path: PlatformPath,
) -> std.platform.PlatformStatus
    requires(
        trusted core.memory.valid_read<u8>(pointer = source.address, count = source.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = source.address, count = source.length as usize),
        trusted core.memory.valid_read<u8>(pointer = new_path.address, count = new_path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = new_path.address, count = new_path.length as usize),
    )
{
    let terminated_source: Result<std.memory.RawBuffer<u8>, std.platform.PlatformStatus> =
        trusted internal prepare_rename_source(&source, &new_path);

    match consume terminated_source
    {
        case Ok(source_path)
        {
            let terminated_destination: Result<std.memory.RawBuffer<u8>, std.platform.PlatformStatus> =
                trusted internal std.platform.terminated_native_text(
                new_path.address,
                length = new_path.length,
                terminator_bytes = 1,
            );

            match consume terminated_destination
            {
                case Ok(destination_path)
                {
                    return trusted internal path_operation_status(
                        trusted std.os.unix.rename_path(source_path.pointer, destination = destination_path.pointer)
                    );
                }
                case Error(status) { return status; }
            }
        }
        case Error(status) { return status; }
    }
}

internal func open_flags(pos options: PlatformFileOptions) -> Result<i32, std.platform.PlatformStatus>
    executes(pure, total)
{
    if options.reserved != 0
    {
        return Error(internal std.platform.invalid_input_status());
    }

    let access: i32 = match options.access
    {
        case 0 { yield std.os.unix.O_RDONLY; }
        case 1 { yield std.os.unix.O_WRONLY; }
        case 2 { yield std.os.unix.O_RDWR; }
        case 3 { yield std.os.unix.O_WRONLY | std.os.unix.O_APPEND; }
        case _ { return Error(internal std.platform.invalid_input_status()); }
    };

    let creation: i32 = match options.creation
    {
        case 0 { yield 0; }
        case 1 { yield std.os.unix.O_CREAT; }
        case 2 { yield std.os.unix.O_CREAT | std.os.unix.O_EXCL; }
        case 3
        {
            if options.access == 0
            {
                return Error(internal std.platform.invalid_input_status());
            }

            yield std.os.unix.O_TRUNC;
        }
        case 4
        {
            if options.access == 0
            {
                return Error(internal std.platform.invalid_input_status());
            }

            yield std.os.unix.O_CREAT | std.os.unix.O_TRUNC;
        }
        case _ { return Error(internal std.platform.invalid_input_status()); }
    };

    return Ok(access | creation | std.os.unix.O_CLOEXEC);
}

trusted internal func path_operation_status(pos result: i32) -> std.platform.PlatformStatus
{
    if result != 0
    {
        return trusted internal std.platform.unix_error_status();
    }

    return internal std.platform.success_status();
}

trusted internal func platform_file_metadata_value(pos handle: u64) -> Result<FileMetadata, std.io.IoError>
{
    let native_descriptor: i32 = match internal std.platform.checked_descriptor(handle)
    {
        case Ok(value) { yield value; }
        case Error(status) { return Error(internal std.io.platform_status_error(status)); }
    };

    let mut storage: [u64; 18] = [0; 18];
    let data: RawPointer<u8> = trusted internal unix_status_storage(&mut storage);

    if trusted std.os.unix.file_status(native_descriptor, status = data) != 0
    {
        return Error(trusted internal unix_io_error());
    }

    return trusted internal unix_metadata(&storage[..]);
}

trusted internal func platform_path_metadata_value(pos path: PlatformPath) -> Result<FileMetadata, std.io.IoError>
    requires(
        trusted core.memory.valid_read<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = path.address, count = path.length as usize),
    )
{
    let terminated: Result<std.memory.RawBuffer<u8>, std.platform.PlatformStatus> =
        trusted internal std.platform.terminated_native_text(path.address, length = path.length, terminator_bytes = 1);

    match consume terminated
    {
        case Ok(terminated_path)
        {
            let mut storage: [u64; 18] = [0; 18];

            let data: RawPointer<u8> = trusted internal unix_status_storage(&mut storage);

            if trusted std.os.unix.path_status(terminated_path.pointer, status = data) != 0
            {
                return Error(trusted internal unix_io_error());
            }

            return trusted internal unix_metadata(&storage[..]);
        }
        case Error(status) { return Error(internal std.io.platform_status_error(status)); }
    }
}

trusted internal func platform_directory_state_capacity() -> usize
{
    return 0;
}

trusted internal func platform_directory_open(
    pos path: PlatformPath,
    pos state: &mut [u64],
) -> Result<u64, std.io.IoError>
    requires(
        trusted core.memory.valid_read<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = path.address, count = path.length as usize),
    )
{
    let terminated: Result<std.memory.RawBuffer<u8>, std.platform.PlatformStatus> =
        trusted internal std.platform.terminated_native_text(path.address, length = path.length, terminator_bytes = 1);

    match consume terminated
    {
        case Ok(terminated_path)
        {
            let directory: RawPointer<u8> = trusted std.os.unix.open_directory(terminated_path.pointer);

            if std.memory.is_null<u8>(directory)
            {
                return Error(trusted internal unix_io_error());
            }

            return Ok(trusted internal std.platform.pointer_handle(directory));
        }
        case Error(status) { return Error(internal std.io.platform_status_error(status)); }
    }
}

trusted internal func platform_directory_next(
    pos handle: u64,
    pos state: &mut [u64],
    pos first: &mut u8,
) -> Result<DirectoryEntry?, std.io.IoError>
    uses(foreign_call)
{
    let directory: RawPointer<u8> = trusted internal std.platform.handle_pointer(handle);
    let descriptor: i32 = trusted std.os.unix.directory_descriptor(directory);

    if descriptor < 0
    {
        return Error(trusted internal unix_io_error());
    }

    loop
    {
        trusted internal std.platform.clear_unix_error();

        let name: RawPointer<u8> = trusted internal next_unix_directory_name(directory);

        if core.memory.is_null<u8>(name)
        {
            if trusted internal std.platform.unix_error_code() != 0
            {
                return Error(trusted internal unix_io_error());
            }

            let exhausted: DirectoryEntry? = none;

            return Ok(exhausted);
        }

        let observed: (bool, usize) = trusted internal unix_directory_name_length(name);

        if !observed.0
        {
            return Error(internal std.io.invalid_transfer_error());
        }

        let length: usize = observed.1;

        if trusted internal unix_dot_entry(name, length = length)
        {
            continue;
        }

        let path: std.path.Path = try trusted internal directory_entry_path(name, bytes = length);
        let mut storage: [u64; 18] = [0; 18];

        let data: RawPointer<u8> = trusted internal unix_status_storage(&mut storage);

        if trusted std.os.unix.file_status_at(descriptor, name, status = data, flags = 0) != 0
        {
            return Error(trusted internal unix_io_error());
        }

        let entry: DirectoryEntry =
        {
            path = path,
            metadata = try trusted internal unix_metadata(&storage[..]),
        };

        let mut result: DirectoryEntry? = none;

        result = entry;

        return Ok(result);
    }
}

trusted internal func platform_directory_close(pos handle: u64) -> Result<unit, std.io.IoError>
{
    if trusted std.os.unix.close_directory(trusted internal std.platform.handle_pointer(handle)) != 0
    {
        return Error(trusted internal unix_io_error());
    }

    return Ok(unit);
}

trusted internal func platform_directory_discard(pos handle: u64) -> unit
{
    let _: i32 = trusted std.os.unix.close_directory(trusted internal std.platform.handle_pointer(handle));
}

trusted internal func unix_status_storage(pos storage: &mut [u64; 18]) -> RawPointer<u8>
    ensures(
        trusted core.memory.valid_write<u8>(pointer = result, count = 144),
        trusted core.memory.initialized_range_as<u8>(pointer = result, count = 144),
    )
{
    assert(std.os.unix.FILE_STATUS_SIZE <= 144, "native file status exceeds its storage");

    return trusted std.memory.reinterpret<u8, u64>(std.memory.address_of_mut<u64>(&mut storage[0]));
}

internal func unix_status_value(pos storage: &[u64], offset: usize, bytes: usize) -> u64
{
    assert(bytes <= 8, "native file status field exceeds its value width");

    let mut value: u64 = 0;
    let mut byte: usize = 0;

    while byte < bytes
    {
        let position: usize = offset + byte;
        let shift: u64 = (position % 8) as u64 * 8;
        let part: u64 = storage[position / 8] >> shift & 255;

        value |= part << (byte as u64 * 8);
        byte += 1;
    }

    return value;
}

trusted internal func unix_metadata(pos storage: &[u64]) -> Result<FileMetadata, std.io.IoError>
{
    let mode: u32 = std.truncate_to<u32>(
        internal unix_status_value(storage, offset = std.os.unix.FILE_STATUS_MODE_OFFSET, bytes = 4)
    );

    let size: i64 = std.truncate_to<i64>(
        internal unix_status_value(storage, offset = std.os.unix.FILE_STATUS_SIZE_OFFSET, bytes = 8)
    );

    if size < 0
    {
        return Error(internal std.io.invalid_transfer_error());
    }

    let kind_bits: u32 = mode & std.os.unix.FILE_KIND_MASK;

    let kind: FileKind = if kind_bits == std.os.unix.FILE_KIND_DIRECTORY
    {
        yield FileKind.Directory;
    }
    else if kind_bits == std.os.unix.FILE_KIND_REGULAR
    {
        yield FileKind.File;
    }
    else
    {
        yield FileKind.Other;
    };

    let seconds: i64 = std.truncate_to<i64>(
        internal unix_status_value(storage, offset = std.os.unix.FILE_STATUS_MODIFIED_SECONDS_OFFSET, bytes = 8)
    );

    let nanoseconds: i64 = std.truncate_to<i64>(
        internal unix_status_value(storage, offset = std.os.unix.FILE_STATUS_MODIFIED_NANOSECONDS_OFFSET, bytes = 8)
    );

    if nanoseconds < 0 || 1_000_000_000 <= nanoseconds
    {
        return Error(internal std.io.invalid_transfer_error());
    }

    let timestamp: std.time.Timestamp = internal std.time.timestamp_from_parts(
        seconds = seconds,
        nanoseconds = std.truncate_to<u32>(nanoseconds),
    );

    let mut modified: std.time.Timestamp? = none;

    modified = timestamp;

    return Ok(
        {
            kind = kind,
            bytes = std.truncate_to<u64>(size),
            modified = modified,
        }
    );
}

trusted internal func next_unix_directory_name(pos directory: RawPointer<u8>) -> RawPointer<u8>
    ensures(core.memory.is_null<u8>(result) || trusted core.memory.nul_terminated_read(pointer = result))
{
    let entry: RawPointer<u8> = trusted std.os.unix.read_directory(directory);

    if core.memory.is_null<u8>(entry)
    {
        return entry;
    }

    return std.memory.byte_offset<u8>(entry, bytes = std.truncate_to<isize>(std.os.unix.DIRECTORY_NAME_OFFSET));
}

trusted internal func unix_directory_name_length(pos name: RawPointer<u8>) -> (bool, usize)
    requires(trusted core.memory.nul_terminated_read(pointer = name))
    ensures(
        trusted core.memory.valid_read<u8>(pointer = name, count = result.1),
        trusted core.memory.initialized_range_as<u8>(pointer = name, count = result.1),
    )
{
    let length: usize = trusted std.os.unix.narrow_string_length(name, limit = std.os.unix.DIRECTORY_NAME_CAPACITY);

    return (length != std.os.unix.DIRECTORY_NAME_CAPACITY, length);
}

trusted internal func unix_dot_entry(pos name: RawPointer<u8>, length: usize) -> bool
    requires(
        trusted core.memory.valid_read<u8>(pointer = name, count = length),
        trusted core.memory.initialized_range_as<u8>(pointer = name, count = length),
    )
    executes(pure)
{
    if length == 1
    {
        return trusted internal std.memory.byte_buffer_read(name, index = 0) == 46;
    }

    if length == 2
    {
        return trusted internal std.memory.byte_buffer_read(name, index = 0) == 46 &&
            trusted internal std.memory.byte_buffer_read(name, index = 1) == 46;
    }

    return false;
}

trusted internal func unix_io_error() -> std.io.IoError
{
    return internal std.io.platform_status_error(trusted internal std.platform.unix_error_status());
}
