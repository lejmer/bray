trusted module std.fs;

struct DirectoryEntry
{
    path: std.path.Path;
    metadata: FileMetadata;
}

struct Directory
{
    internal handle: u64;
    internal mut state: std.memory.RawBuffer<u64>;
    internal mut first: u8;
    internal mut is_open: bool;

    construct open(pos path: &std.path.Path) -> Result<Self, std.io.IoError>
        requires(blocking_execution())
    {
        let capacity: usize = trusted internal platform_directory_state_capacity();

        let created: Result<std.memory.RawBuffer<u64>, std.memory.MemoryLayoutError> = trusted std.memory.RawBuffer<
            u64
        >(capacity = capacity);

        let mut state: std.memory.RawBuffer<u64> = match consume created
        {
            case Ok(buffer) { yield buffer; }
            case Error(_) { return Error(internal std.io.buffer_allocation_error()); }
        };

        let state_pointer: RawPointer<u8> = trusted std.memory.reinterpret<u8, u64>(std.memory.pointer<u64>(&state));

        let handle: u64 = try trusted platform_directory_open(platform_path(path), state = state_pointer);

        return Ok(
            {
                handle = handle,
                state = state,
                first = 1,
                is_open = true,
            }
        );
    }

    trusted finalize() -> Result<unit, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted close_directory(&mut self);
    }

    trusted destruct()
    {
        if self.is_open
        {
            trusted platform_directory_discard(handle = self.handle);
        }
    }

    mut func next() -> Result<DirectoryEntry?, std.io.IoError>
        requires(blocking_execution())
    {
        if !self.is_open
        {
            return Error(internal std.io.invalid_transfer_error());
        }

        return trusted platform_directory_next(
            handle = self.handle,
            state = trusted std.memory.reinterpret<u8, u64>(std.memory.pointer<u64>(&self.state)),
            first = std.memory.address_of_mut<u8>(&mut self.first),
        );
    }

    mut async func next_async() -> Result<DirectoryEntry?, std.io.IoError>
        requires(blocking_execution())
    {
        return self.next();
    }

    consume mut func close() -> Result<unit, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted close_directory(&mut self);
    }

    consume mut async func close_async() -> Result<unit, std.io.IoError>
        requires(blocking_execution())
    {
        return self.close();
    }
}

trusted internal func close_directory(pos directory: &mut Directory) -> Result<unit, std.io.IoError>
    requires(blocking_execution())
{
    if !directory.is_open
    {
        return Ok(unit);
    }

    try trusted platform_directory_close(handle = directory.handle);

    directory.is_open = false;

    return Ok(unit);
}
