func rename(pos source: &std.path.Path, pos destination: &std.path.Path) -> Result<unit, std.io.IoError>
    requires(blocking_execution())
{
    return trusted rename_path(source, destination);
}

trusted internal func rename_path(
    pos source: &std.path.Path,
    pos destination: &std.path.Path,
) -> Result<unit, std.io.IoError>
    requires(blocking_execution())
    uses(foreign_call)
{
    let native_source: PlatformPath = platform_path(source);
    let native_destination: PlatformPath = platform_path(destination);
    let status: std.platform.PlatformStatus = trusted platform_path_rename(native_source, native_destination);

    return checked_platform_status(status);
}

async func rename_async(pos source: &std.path.Path, pos destination: &std.path.Path) -> Result<unit, std.io.IoError>
    requires(blocking_execution())
{
    return rename(source, destination);
}
