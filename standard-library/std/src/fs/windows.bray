@target(target.identity.SYSTEM == "windows")
trusted module std.fs;

using core.memory;
using std.io;
using std.memory;
using std.numeric;
using std.os.windows;
using internal std.platform;
using std.time;

@abi(c)
trusted internal func platform_file_read(
    pos handle: u64,
    pos destination: DataPointer<u8>,
    pos length: u64,
    pos transferred: DataPointer<u64>,
) -> std.platform.PlatformStatus
    requires(
        length == 0 || trusted core.memory.valid_write<u8>(pointer = destination, count = length as usize),
        trusted core.memory.valid_write<u64>(pointer = transferred, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = transferred),
    )
{
    return trusted internal std.platform.handle_read(
        handle,
        destination = destination,
        length = length,
        transferred = transferred,
    );
}

@abi(c)
trusted internal func platform_file_write(
    pos handle: u64,
    pos source: DataPointer<u8>,
    pos length: u64,
    pos transferred: DataPointer<u64>,
) -> std.platform.PlatformStatus
    requires(
        length == 0 || trusted core.memory.valid_read<u8>(pointer = source, count = length as usize),
        length == 0 || trusted core.memory.initialized_range_as<u8>(pointer = source, count = length as usize),
        trusted core.memory.valid_write<u64>(pointer = transferred, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = transferred),
    )
{
    return trusted internal std.platform.handle_write(
        handle,
        source = source,
        length = length,
        transferred = transferred,
    );
}

@abi(c)
trusted internal func platform_file_flush(pos handle: u64) -> std.platform.PlatformStatus
    uses(foreign_call)
{
    let native_handle: DataPointer<u8> = trusted internal std.platform.handle_pointer(handle);

    if trusted std.os.windows.flush_file_buffers(native_handle) == 0
    {
        return trusted internal std.platform.windows_error_status();
    }

    return internal std.platform.success_status();
}

trusted internal func prepare_file_seek(
    pos handle: u64,
    pos offset_bits: u64,
    pos origin: u32,
    pos position: DataPointer<u64>,
) -> Result<u64, std.platform.PlatformStatus>
    requires(
        trusted core.memory.valid_write<u64>(pointer = position, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = position),
    )
    ensures(
        trusted core.memory.valid_write<u64>(pointer = position, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = position),
    )
    uses(foreign_call, layout_reinterpret)
{
    let native_origin: u32 = match origin
    {
        case 0
        {
            if offset_bits > (std.numeric.U64_MAX >> 1)
            {
                return Error(internal std.platform.invalid_input_status());
            }

            yield std.os.windows.FILE_BEGIN;
        }
        case 1 { yield std.os.windows.FILE_CURRENT; }
        case 2 { yield std.os.windows.FILE_END; }
        case _ { return Error(internal std.platform.invalid_input_status()); }
    };

    let distance: std.os.windows.LargeInteger = std.os.windows.LargeInteger.QuadPart(
        quad_part = std.numeric.truncate_to<i64>(offset_bits)
    );

    let mut native_position: i64 = 0;

    let native_position_pointer: DataPointer<std.os.windows.LargeInteger> = trusted std.memory.reinterpret<
        std.os.windows.LargeInteger,
        i64,
    >(std.memory.address_of_mut<i64>(&mut native_position));

    if trusted std.os.windows.set_file_pointer_ex(
        trusted internal std.platform.handle_pointer(handle),
        distance = distance,
        position = native_position_pointer,
        origin = native_origin,
    ) == 0
    {
        return Error(trusted internal std.platform.windows_error_status());
    }

    if native_position < 0
    {
        return Error(internal std.platform.invalid_input_status());
    }

    return Ok(std.numeric.truncate_to<u64>(native_position));
}

trusted internal func prepare_file_open(
    pos path: PlatformPath,
    pos options: PlatformFileOptions,
    pos opened: DataPointer<u64>,
) -> Result<File, std.platform.PlatformStatus>
    requires(
        trusted core.memory.valid_read<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.valid_write<u64>(pointer = opened, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = opened),
    )
    ensures(
        trusted core.memory.valid_write<u64>(pointer = opened, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = opened),
    )
    uses(foreign_call, layout_reinterpret)
{
    if options.reserved != 0
    {
        return Error(internal std.platform.invalid_input_status());
    }

    let access: u32 = match options.access
    {
        case 0 { yield std.os.windows.GENERIC_READ; }
        case 1 { yield std.os.windows.GENERIC_WRITE; }
        case 2 { yield std.os.windows.GENERIC_READ | std.os.windows.GENERIC_WRITE; }
        case 3 { yield std.os.windows.FILE_APPEND_DATA | std.os.windows.SYNCHRONIZE; }
        case _ { return Error(internal std.platform.invalid_input_status()); }
    };

    let creation: u32 = match options.creation
    {
        case 0 { yield std.os.windows.OPEN_EXISTING; }
        case 1 { yield std.os.windows.OPEN_ALWAYS; }
        case 2 { yield std.os.windows.CREATE_NEW; }
        case 3
        {
            if options.access == 0
            {
                return Error(internal std.platform.invalid_input_status());
            }

            yield std.os.windows.TRUNCATE_EXISTING;
        }
        case 4
        {
            if options.access == 0
            {
                return Error(internal std.platform.invalid_input_status());
            }

            yield std.os.windows.CREATE_ALWAYS;
        }
        case _ { return Error(internal std.platform.invalid_input_status()); }
    };

    let terminated: Result<PreparedPath, std.platform.PlatformStatus> = trusted internal prepare_native_path(path);

    match consume terminated
    {
        case Ok(terminated_path)
        {
            let mut owner: File =
            {
                handle = 0,
                is_open = false,
            };

            let native_handle: DataPointer<u8> = trusted std.os.windows.create_file_w(
                trusted std.memory.reinterpret<u16, u8>(terminated_path.pointer),
                access = access,
                share = std.os.windows.FILE_SHARE_READ | std.os.windows.FILE_SHARE_WRITE |
                    std.os.windows.FILE_SHARE_DELETE,
                security = std.memory.null<u8>(),
                creation = creation,
                attributes = std.os.windows.FILE_ATTRIBUTE_NORMAL,
                template_file = std.memory.null<u8>(),
            );

            let native_value: u64 = trusted internal std.platform.pointer_handle(native_handle);

            if native_value == std.numeric.U64_MAX
            {
                return Error(trusted internal std.platform.windows_error_status());
            }

            owner.handle = native_value;
            owner.is_open = true;

            return Ok(owner);
        }
        case Error(status) { return Error(status); }
    }
}

@abi(c)
trusted internal func platform_path_create_directory(pos path: PlatformPath) -> std.platform.PlatformStatus
    requires(
        trusted core.memory.valid_read<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = path.address, count = path.length as usize),
    )
    uses(foreign_call, layout_reinterpret)
{
    let terminated: Result<PreparedPath, std.platform.PlatformStatus> = trusted internal prepare_native_path(path);

    match consume terminated
    {
        case Ok(terminated_path)
        {
            return trusted internal windows_path_operation_status(
                trusted std.os.windows.create_directory_w(
                    trusted std.memory.reinterpret<u16, u8>(terminated_path.pointer),
                    security = std.memory.null<u8>(),
                )
            );
        }
        case Error(status) { return status; }
    }
}

@abi(c)
trusted internal func platform_path_remove_file(pos path: PlatformPath) -> std.platform.PlatformStatus
    requires(
        trusted core.memory.valid_read<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = path.address, count = path.length as usize),
    )
    uses(foreign_call, layout_reinterpret)
{
    let terminated: Result<PreparedPath, std.platform.PlatformStatus> = trusted internal prepare_native_path(path);

    match consume terminated
    {
        case Ok(terminated_path)
        {
            return trusted internal windows_path_operation_status(
                trusted std.os.windows.delete_file_w(trusted std.memory.reinterpret<u16, u8>(terminated_path.pointer))
            );
        }
        case Error(status) { return status; }
    }
}

@abi(c)
trusted internal func platform_path_remove_directory(pos path: PlatformPath) -> std.platform.PlatformStatus
    requires(
        trusted core.memory.valid_read<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = path.address, count = path.length as usize),
    )
    uses(foreign_call, layout_reinterpret)
{
    let terminated: Result<PreparedPath, std.platform.PlatformStatus> = trusted internal prepare_native_path(path);

    match consume terminated
    {
        case Ok(terminated_path)
        {
            return trusted internal windows_path_operation_status(
                trusted std.os.windows.remove_directory_w(
                    trusted std.memory.reinterpret<u16, u8>(terminated_path.pointer)
                )
            );
        }
        case Error(status) { return status; }
    }
}

@abi(c)
trusted internal func platform_path_rename(
    pos source: PlatformPath,
    pos new_path: PlatformPath,
) -> std.platform.PlatformStatus
    requires(
        trusted core.memory.valid_read<u8>(pointer = source.address, count = source.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = source.address, count = source.length as usize),
        trusted core.memory.valid_read<u8>(pointer = new_path.address, count = new_path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = new_path.address, count = new_path.length as usize),
    )
    uses(foreign_call, layout_reinterpret)
{
    let terminated_source: Result<PreparedPath, std.platform.PlatformStatus> = trusted internal prepare_native_path(
        source
    );

    match consume terminated_source
    {
        case Ok(source_path)
        {
            let terminated_destination: Result<PreparedPath, std.platform.PlatformStatus> =
                trusted internal prepare_native_path(new_path);

            match consume terminated_destination
            {
                case Ok(destination_path)
                {
                    return trusted internal windows_path_operation_status(
                        trusted std.os.windows.move_file_ex_w(
                            trusted std.memory.reinterpret<u16, u8>(source_path.pointer),
                            destination = trusted std.memory.reinterpret<u16, u8>(destination_path.pointer),
                            flags = std.os.windows.MOVEFILE_REPLACE_EXISTING,
                        )
                    );
                }
                case Error(status) { return status; }
            }
        }
        case Error(status) { return status; }
    }
}

trusted internal func windows_path_operation_status(pos result: i32) -> std.platform.PlatformStatus
{
    if result == 0
    {
        return trusted internal std.platform.windows_error_status();
    }

    return internal std.platform.success_status();
}

trusted internal func platform_file_metadata_value(pos handle: u64) -> Result<FileMetadata, std.io.IoError>
    uses(foreign_call, layout_reinterpret)
{
    let mut storage: [u64; 7] = [0; 7];

    let data: DataPointer<u8> = trusted std.memory.reinterpret<u8, u64>(
        std.memory.address_of_mut<u64>(&mut storage[0])
    );

    if trusted std.os.windows.get_file_information_by_handle(
        trusted internal std.platform.handle_pointer(handle),
        data = data,
    ) == 0
    {
        return Error(trusted internal windows_io_error());
    }

    return internal windows_metadata(&storage[..], size_high_offset = 32, size_low_offset = 36);
}

trusted internal func platform_path_metadata_value(pos path: PlatformPath) -> Result<FileMetadata, std.io.IoError>
    requires(
        trusted core.memory.valid_read<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = path.address, count = path.length as usize),
    )
    uses(foreign_call, layout_reinterpret)
{
    let terminated: Result<PreparedPath, std.platform.PlatformStatus> = trusted internal prepare_native_path(path);

    match consume terminated
    {
        case Ok(terminated_path)
        {
            let mut storage: [u64; 5] = [0; 5];

            let data: DataPointer<u8> = trusted std.memory.reinterpret<u8, u64>(
                std.memory.address_of_mut<u64>(&mut storage[0])
            );

            if trusted std.os.windows.get_file_attributes_ex_w(
                trusted std.memory.reinterpret<u16, u8>(terminated_path.pointer),
                information_level = 0,
                data = data,
            ) == 0
            {
                return Error(trusted internal windows_io_error());
            }

            return internal windows_metadata(&storage[..], size_high_offset = 28, size_low_offset = 32);
        }
        case Error(status) { return Error(internal std.io.platform_status_error(status)); }
    }
}

@copy
@layout(c)
internal struct NativeWindowsDirectory
{
    handle: u64;
    mut state: [u64; 76];
    mut first: u8;
}

trusted internal func native_directory_required_capacity() -> u64
{
    return 520;
}

trusted internal func native_directory_open_handle(pos path: PlatformPath) -> Result<u64, std.io.IoError>
    requires(
        trusted core.memory.valid_read<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = path.address, count = path.length as usize),
    )
{
    let mut state: [u64; 76] = [0; 76];
    let handle: u64 = try trusted native_directory_open(path, &mut state[..]);

    let native: NativeWindowsDirectory =
    {
        handle = handle,
        state = state,
        first = 1
    };

    let pointer: DataPointer<NativeWindowsDirectory> = trusted internal std.memory.allocate_value<
        NativeWindowsDirectory
    >(native);

    return Ok(trusted internal std.platform.pointer_handle(std.memory.byte_address<NativeWindowsDirectory>(pointer)));
}

trusted internal func native_windows_directory_pointer(pos handle: u64) -> DataPointer<NativeWindowsDirectory>
    ensures(
        trusted core.memory.valid_read<NativeWindowsDirectory>(pointer = result, count = 1),
        trusted core.memory.valid_write<NativeWindowsDirectory>(pointer = result, count = 1),
        trusted core.memory.aligned_for<NativeWindowsDirectory>(pointer = result),
        trusted core.memory.initialized_as<NativeWindowsDirectory>(pointer = result),
        trusted core.memory.owned_allocation(
            pointer = std.memory.byte_address<NativeWindowsDirectory>(result),
            bytes = internal std.memory.value_allocation_bytes<NativeWindowsDirectory>(),
            align = std.memory.align_of<NativeWindowsDirectory>(),
        ),
    )
    uses(layout_reinterpret)
{
    let pointer: DataPointer<NativeWindowsDirectory> = trusted std.memory.reinterpret<NativeWindowsDirectory, u8>(
        trusted internal std.platform.handle_pointer(handle)
    );

    // Only this fallback's open operation creates handles consumed by these functions.
    let authorize = trusted lambda(pos pointer: DataPointer<NativeWindowsDirectory>)
        ensures(
            trusted core.memory.valid_read<NativeWindowsDirectory>(pointer = pointer, count = 1),
            trusted core.memory.valid_write<NativeWindowsDirectory>(pointer = pointer, count = 1),
            trusted core.memory.aligned_for<NativeWindowsDirectory>(pointer = pointer),
            trusted core.memory.initialized_as<NativeWindowsDirectory>(pointer = pointer),
            trusted core.memory.owned_allocation(
                pointer = std.memory.byte_address<NativeWindowsDirectory>(pointer),
                bytes = internal std.memory.value_allocation_bytes<NativeWindowsDirectory>(),
                align = std.memory.align_of<NativeWindowsDirectory>(),
            ),
        )
        executes(pure, total) {};

    authorize(pointer);
    return pointer;
}

trusted internal func native_directory_next_handle(
    pos handle: u64,
    pos destination: DataPointer<u8>,
    pos capacity: usize
) -> Result<NativeDirectoryEntry?, std.io.IoError>
    requires(trusted core.memory.valid_write<u8>(pointer = destination, count = capacity))
    ensures(trusted core.memory.valid_write<u8>(pointer = destination, count = capacity))
    uses(raw_memory, unchecked_alias)
{
    let pointer: DataPointer<NativeWindowsDirectory> = trusted native_windows_directory_pointer(handle);
    let mut capability: u64 = handle;

    // Directory.next owns the only mutable traversal access while the provider call runs.
    let authorize = trusted lambda(pos pointer: DataPointer<NativeWindowsDirectory>)
        ensures(
            trusted core.memory.valid_write<NativeWindowsDirectory>(pointer = pointer, count = 1),
            trusted core.memory.aligned_for<NativeWindowsDirectory>(pointer = pointer),
            trusted core.memory.initialized_as<NativeWindowsDirectory>(pointer = pointer),
            trusted core.memory.exclusive_alias_valid<NativeWindowsDirectory>(pointer = pointer),
            trusted core.memory.epoch_current<NativeWindowsDirectory>(pointer = pointer),
            trusted core.memory.synchronized_access<NativeWindowsDirectory>(pointer = pointer),
            trusted core.memory.movement_stable<NativeWindowsDirectory>(pointer = pointer),
            trusted core.memory.finalization_pending<NativeWindowsDirectory>(pointer = pointer),
        )
        executes(pure, total) {};

    authorize(pointer);

    let native: &mut NativeWindowsDirectory = trusted std.memory.borrow_mut_from<NativeWindowsDirectory, u64>(
        &mut capability,
        pointer,
    );

    let result: Result<NativeDirectoryEntry?, std.io.IoError> = trusted native_directory_next(
        native.handle,
        &mut native.state[..],
        &mut native.first,
        destination,
        capacity,
    );

    // Native directory operations only touch their own state and the supplied output buffer.
    let preserve = trusted lambda(pos destination: DataPointer<u8>, pos capacity: usize)
        ensures(trusted core.memory.valid_write<u8>(pointer = destination, count = capacity))
        executes(pure, total) {};

    preserve(destination, capacity);
    return result;
}

trusted internal func native_directory_open(
    pos path: PlatformPath,
    pos state: &mut [u64],
) -> Result<u64, std.io.IoError>
    requires(
        trusted core.memory.valid_read<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = path.address, count = path.length as usize),
    )
    uses(foreign_call, layout_reinterpret)
{
    let pattern: std.memory.RawBuffer<u16> = match trusted internal windows_directory_pattern(path)
    {
        case Ok(buffer) { yield buffer; }
        case Error(status) { return Error(internal std.io.platform_status_error(status)); }
    };

    let search_handle: DataPointer<u8> = trusted std.os.windows.find_first_file_ex_w(
        std.memory.pointer<u16>(&pattern),
        information_level = std.os.windows.FIND_EX_INFO_BASIC,
        data = trusted std.memory.reinterpret<u8, u64>(std.memory.address_of_mut<u64>(&mut state[0])),
        search_operation = std.os.windows.FIND_EX_SEARCH_NAME_MATCH,
        search_filter = std.memory.null<u8>(),
        flags = std.os.windows.FIND_FIRST_EX_LARGE_FETCH,
    );

    if trusted internal std.platform.pointer_handle(search_handle) == std.numeric.U64_MAX
    {
        return Error(trusted internal windows_io_error());
    }

    return Ok(trusted internal std.platform.pointer_handle(search_handle));
}

trusted internal func native_directory_next(
    pos handle: u64,
    pos state: &mut [u64],
    pos first: &mut u8,
    pos destination: DataPointer<u8>,
    pos capacity: usize,
) -> Result<NativeDirectoryEntry?, std.io.IoError>
    requires(trusted core.memory.valid_write<u8>(pointer = destination, count = capacity))
    uses(foreign_call, layout_reinterpret)
{
    if state.length() < 76 || capacity < 520
    {
        return Error(internal std.io.invalid_transfer_error());
    }

    let native_handle: DataPointer<u8> = trusted internal std.platform.handle_pointer(handle);

    loop
    {
        if first != 0
        {
            first = 0;
        }
        else if trusted std.os.windows.find_next_file_w(
            native_handle,
            data = trusted std.memory.reinterpret<u8, u64>(std.memory.address_of_mut<u64>(&mut state[0]))
        ) == 0
        {
            let error: u32 = trusted std.os.windows.get_last_error();

            if error == 18
            {
                let exhausted: NativeDirectoryEntry? = none;

                return Ok(exhausted);
            }

            return Error(internal std.io.platform_status_error(internal std.platform.windows_error_status_from(error)));
        }

        let mut units: usize = 0;

        while units < 260 && internal windows_data_u16(&state, offset = 44 + units * 2) != 0
        {
            units += 1;
        }

        if units >= 260
        {
            return Error(internal std.io.invalid_transfer_error());
        }

        if internal windows_dot_entry(&state, units = units)
        {
            continue;
        }

        let length: usize = units * 2;

        if length > capacity
        {
            return Error(internal std.io.invalid_transfer_error());
        }

        // FindNextFileW only writes the private native state, leaving the caller's buffer valid.
        let preserve = trusted lambda(pos destination: DataPointer<u8>, pos capacity: usize)
            ensures(trusted core.memory.valid_write<u8>(pointer = destination, count = capacity))
            executes(pure, total) {};

        preserve(destination, capacity);
        trusted internal copy_windows_directory_name(&state, units, destination, capacity);

        let entry_metadata: FileMetadata = try internal windows_metadata(
            &state,
            size_high_offset = 28,
            size_low_offset = 32,
        );

        let entry: NativeDirectoryEntry =
        {
            length = length,
            metadata = entry_metadata,
        };

        let mut result: NativeDirectoryEntry? = none;

        result = entry;

        return Ok(result);
    }
}

trusted internal func native_directory_close_handle(
    pos handle: u64,
    pos terminal: bool
) -> (std.platform.PlatformStatus, bool)
    uses(foreign_call, raw_memory)
{
    let pointer: DataPointer<NativeWindowsDirectory> = trusted native_windows_directory_pointer(handle);
    let native: NativeWindowsDirectory = trusted std.memory.read<NativeWindowsDirectory>(pointer);

    if trusted std.os.windows.find_close(trusted internal std.platform.handle_pointer(native.handle)) == 0
    {
        let status: std.platform.PlatformStatus = trusted internal std.platform.windows_error_status();

        if terminal
        {
            let current: DataPointer<NativeWindowsDirectory> = trusted native_windows_directory_pointer(handle);

            trusted internal std.memory.deallocate_value<NativeWindowsDirectory>(current);
            return (status, true);
        }

        return (status, false);
    }

    let current: DataPointer<NativeWindowsDirectory> = trusted native_windows_directory_pointer(handle);

    trusted internal std.memory.deallocate_value<NativeWindowsDirectory>(current);
    return (internal std.platform.success_status(), true);
}

internal func windows_metadata(
    pos data: &[u64],
    size_high_offset: usize,
    size_low_offset: usize,
) -> Result<FileMetadata, std.io.IoError>
{
    let attributes: u32 = internal windows_data_u32(data, offset = 0);
    let write_low: u32 = internal windows_data_u32(data, offset = 20);
    let write_high: u32 = internal windows_data_u32(data, offset = 24);
    let size_high: u32 = internal windows_data_u32(data, offset = size_high_offset);
    let size_low: u32 = internal windows_data_u32(data, offset = size_low_offset);

    let kind: FileKind = if attributes & std.os.windows.FILE_ATTRIBUTE_DIRECTORY != 0
    {
        yield FileKind.Directory;
    }
    else
    {
        yield FileKind.File;
    };

    let mut modified: std.time.Timestamp? = none;

    match internal std.platform.windows_file_time(low = write_low, high = write_high)
    {
        case Ok(parts) { modified = internal std.time.timestamp_from_parts(seconds = parts.0, nanoseconds = parts.1); }
        case Error(_) {}
    }

    return Ok(
        {
            kind = kind,
            bytes = size_low as u64 | size_high as u64 << 32,
            modified = modified,
        }
    );
}

trusted internal func windows_directory_pattern(
    pos path: PlatformPath
) -> Result<std.memory.RawBuffer<u16>, std.platform.PlatformStatus>
    requires(
        trusted core.memory.valid_read<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = path.address, count = path.length as usize),
    )
    uses(raw_memory)
{
    let path_bytes: usize = path.length as usize;

    if path_bytes as u64 != path.length || path_bytes % 2 != 0 || path_bytes > (std.numeric.USIZE_MAX >> 1) - 6
    {
        return Error(internal std.platform.invalid_input_status());
    }

    let mut pattern: std.memory.RawBuffer<u16> = try trusted allocate_windows_directory_pattern(
        path.address,
        path_bytes
    );

    trusted copy_windows_directory_path(path.address, path_bytes, &mut pattern);

    let units: &[u16] = trusted std.memory.initialized_slice<u16>(&pattern);

    let last: u16 = if path_bytes > 0
    {
        yield units[path_bytes / 2 - 1];
    }
    else
    {
        yield 0;
    };

    if path_bytes > 0 && last != 47 && last != 92
    {
        trusted internal std.memory.initialize_spare<u16>(&mut pattern, 92);
    }

    trusted internal std.memory.initialize_spare<u16>(&mut pattern, 42);
    trusted internal std.memory.initialize_spare<u16>(&mut pattern, 0);

    return Ok(pattern);
}

trusted internal func allocate_windows_directory_pattern(
    pos address: DataPointer<u8>,
    pos count: usize
) -> Result<std.memory.RawBuffer<u16>, std.platform.PlatformStatus>
    requires(
        trusted core.memory.valid_read<u8>(pointer = address, count = count),
        trusted core.memory.initialized_range_as<u8>(pointer = address, count = count),
    )
    ensures(
        trusted core.memory.valid_read<u8>(pointer = address, count = count),
        trusted core.memory.initialized_range_as<u8>(pointer = address, count = count),
    )
{
    let mut buffer: std.memory.RawBuffer<u16> = match trusted std.memory.RawBuffer<u16>(capacity = count / 2 + 3)
    {
        case Ok(value) { yield value; }
        case Error(_) { return Error(internal std.platform.invalid_input_status()); }
    };

    let mut initialized: usize = 0;

    while initialized < count / 2
    {
        trusted internal std.memory.initialize_spare<u16>(&mut buffer, 0);
        initialized += 1;
    }

    return Ok(buffer);
}

trusted internal func copy_windows_directory_path(
    pos address: DataPointer<u8>,
    pos count: usize,
    pos buffer: &mut std.memory.RawBuffer<u16>
)
    requires(
        trusted core.memory.valid_read<u8>(pointer = address, count = count),
        trusted core.memory.initialized_range_as<u8>(pointer = address, count = count),
    )
    uses(raw_memory, unchecked_init)
{
    let initialized: usize = std.memory.initialized_count<u16>(&buffer);

    assert(count == initialized * 2, "directory pattern storage must match the source byte count");

    let units: &mut [u16] = trusted std.memory.initialized_slice_mut<u16>(buffer);

    let destination: DataPointer<u8> = std.memory.byte_address<u16>(
        internal std.memory.slice_pointer_mut<u16>(units, count = initialized)
    );

    // The initialized UTF-16 buffer spans count writable bytes; the input remains readable.
    let authorize = trusted lambda(pos source: DataPointer<u8>, pos destination: DataPointer<u8>, pos count: usize)
        ensures(
            trusted core.memory.valid_read<u8>(pointer = source, count = count),
            trusted core.memory.initialized_range_as<u8>(pointer = source, count = count),
            trusted core.memory.valid_write<u8>(pointer = destination, count = count),
        )
        executes(pure, total) {};

    authorize(address, destination, count);
    trusted std.memory.copy_overlapping<u8>(address, destination, count = count);
}

internal func windows_data_u32(pos data: &[u64], offset: usize) -> u32
{
    assert(offset % 4 == 0, "native u32 field is misaligned");

    return std.numeric.truncate_to<u32>(data[offset / 8] >> (offset % 8 * 8) as u64);
}

internal func windows_data_u16(pos data: &[u64], offset: usize) -> u16
{
    assert(offset % 2 == 0, "native u16 field is misaligned");

    return std.numeric.truncate_to<u16>(data[offset / 8] >> (offset % 8 * 8) as u64);
}

internal func windows_dot_entry(pos data: &[u64], units: usize) -> bool
{
    return units == 1 && internal windows_data_u16(data, offset = 44) == 46 || units == 2 && internal windows_data_u16(
        data,
        offset = 44
    ) == 46 && internal windows_data_u16(data, offset = 46) == 46;
}

trusted internal func copy_windows_directory_name(
    pos data: &[u64],
    pos units: usize,
    pos destination: DataPointer<u8>,
    pos capacity: usize,
) -> unit
    requires(
        data.length() >= 76,
        (units < 260),
        capacity >= 520,
        trusted core.memory.valid_write<u8>(pointer = destination, count = capacity),
    )
    ensures(trusted core.memory.valid_write<u8>(pointer = destination, count = capacity))
    uses(raw_memory, unchecked_init)
{
    let words: DataPointer<u64> = internal std.memory.slice_pointer<u64>(data, count = data.length());
    let source: DataPointer<u8> = std.memory.byte_offset<u8>(std.memory.byte_address<u64>(words), bytes = 44);
    let length: usize = units * 2;

    // The initialized native state contains the name at byte 44, and Windows stores UTF-16 in little endian.
    let authorize = trusted lambda(
        pos source: DataPointer<u8>,
        pos destination: DataPointer<u8>,
        pos length: usize,
        pos capacity: usize
    )
        ensures(
            trusted core.memory.valid_read<u8>(pointer = source, count = length),
            trusted core.memory.initialized_range_as<u8>(pointer = source, count = length),
            trusted core.memory.valid_write<u8>(pointer = destination, count = length),
            trusted core.memory.valid_write<u8>(pointer = destination, count = capacity),
        )
        executes(pure, total) {};

    authorize(source, destination, length, capacity);
    trusted std.memory.copy_overlapping<u8>(source, destination, count = length);
}

trusted internal func windows_io_error() -> std.io.IoError
{
    return internal std.io.platform_status_error(trusted internal std.platform.windows_error_status());
}
