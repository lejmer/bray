@target(target.identity.SYSTEM == "windows")
trusted module std.fs;

using core.memory;
using std.bytes;
using std.io;
using std.memory;
using std.numeric;
using std.os.windows;
using std.path;
using internal std.platform;
using std.time;

@abi(c)
trusted internal func platform_file_read(
    pos handle: u64,
    pos destination: DataPointer<u8>,
    pos length: u64,
    pos transferred: DataPointer<u64>,
) -> std.platform.PlatformStatus
    requires(
        length == 0 || trusted core.memory.valid_write<u8>(pointer = destination, count = length as usize),
        trusted core.memory.valid_write<u64>(pointer = transferred, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = transferred),
    )
{
    return trusted internal std.platform.handle_read(
        handle,
        destination = destination,
        length = length,
        transferred = transferred,
    );
}

@abi(c)
trusted internal func platform_file_write(
    pos handle: u64,
    pos source: DataPointer<u8>,
    pos length: u64,
    pos transferred: DataPointer<u64>,
) -> std.platform.PlatformStatus
    requires(
        length == 0 || trusted core.memory.valid_read<u8>(pointer = source, count = length as usize),
        length == 0 || trusted core.memory.initialized_range_as<u8>(pointer = source, count = length as usize),
        trusted core.memory.valid_write<u64>(pointer = transferred, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = transferred),
    )
{
    return trusted internal std.platform.handle_write(
        handle,
        source = source,
        length = length,
        transferred = transferred,
    );
}

@abi(c)
trusted internal func platform_file_flush(pos handle: u64) -> std.platform.PlatformStatus
    uses(foreign_call)
{
    let native_handle: DataPointer<u8> = trusted internal std.platform.handle_pointer(handle);

    if trusted std.os.windows.flush_file_buffers(native_handle) == 0
    {
        return trusted internal std.platform.windows_error_status();
    }

    return internal std.platform.success_status();
}

trusted internal func prepare_file_seek(
    pos handle: u64,
    pos offset_bits: u64,
    pos origin: u32,
    pos position: DataPointer<u64>,
) -> Result<u64, std.platform.PlatformStatus>
    requires(
        trusted core.memory.valid_write<u64>(pointer = position, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = position),
    )
    ensures(
        trusted core.memory.valid_write<u64>(pointer = position, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = position),
    )
    uses(foreign_call, layout_reinterpret)
{
    let native_origin: u32 = match origin
    {
        case 0
        {
            if offset_bits > (std.numeric.U64_MAX >> 1)
            {
                return Error(internal std.platform.invalid_input_status());
            }

            yield std.os.windows.FILE_BEGIN;
        }
        case 1 { yield std.os.windows.FILE_CURRENT; }
        case 2 { yield std.os.windows.FILE_END; }
        case _ { return Error(internal std.platform.invalid_input_status()); }
    };

    let distance: std.os.windows.LargeInteger = std.os.windows.LargeInteger.QuadPart(
        quad_part = std.numeric.truncate_to<i64>(offset_bits)
    );

    let mut native_position: i64 = 0;

    let native_position_pointer: DataPointer<std.os.windows.LargeInteger> = trusted std.memory.reinterpret<
        std.os.windows.LargeInteger,
        i64,
    >(std.memory.address_of_mut<i64>(&mut native_position));

    if trusted std.os.windows.set_file_pointer_ex(
        trusted internal std.platform.handle_pointer(handle),
        distance = distance,
        position = native_position_pointer,
        origin = native_origin,
    ) == 0
    {
        return Error(trusted internal std.platform.windows_error_status());
    }

    if native_position < 0
    {
        return Error(internal std.platform.invalid_input_status());
    }

    return Ok(std.numeric.truncate_to<u64>(native_position));
}

@abi(c)
trusted internal func platform_file_close(pos handle: u64) -> std.platform.PlatformStatus
{
    return (trusted internal std.platform.resource.close(handle)).0;
}

trusted internal func prepare_file_open(
    pos path: PlatformPath,
    pos options: PlatformFileOptions,
    pos opened: DataPointer<u64>,
    already_terminated: bool,
) -> Result<File, std.platform.PlatformStatus>
    requires(
        trusted core.memory.valid_read<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.valid_write<u64>(pointer = opened, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = opened),
    )
    ensures(
        trusted core.memory.valid_write<u64>(pointer = opened, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = opened),
    )
    uses(foreign_call, layout_reinterpret)
{
    if options.reserved != 0
    {
        return Error(internal std.platform.invalid_input_status());
    }

    let access: u32 = match options.access
    {
        case 0 { yield std.os.windows.GENERIC_READ; }
        case 1 { yield std.os.windows.GENERIC_WRITE; }
        case 2 { yield std.os.windows.GENERIC_READ | std.os.windows.GENERIC_WRITE; }
        case 3 { yield std.os.windows.FILE_APPEND_DATA | std.os.windows.SYNCHRONIZE; }
        case _ { return Error(internal std.platform.invalid_input_status()); }
    };

    let creation: u32 = match options.creation
    {
        case 0 { yield std.os.windows.OPEN_EXISTING; }
        case 1 { yield std.os.windows.OPEN_ALWAYS; }
        case 2 { yield std.os.windows.CREATE_NEW; }
        case 3
        {
            if options.access == 0
            {
                return Error(internal std.platform.invalid_input_status());
            }

            yield std.os.windows.TRUNCATE_EXISTING;
        }
        case 4
        {
            if options.access == 0
            {
                return Error(internal std.platform.invalid_input_status());
            }

            yield std.os.windows.CREATE_ALWAYS;
        }
        case _ { return Error(internal std.platform.invalid_input_status()); }
    };

    let terminated: Result<PreparedPath, std.platform.PlatformStatus> = trusted internal prepare_native_path(
        path,
        already_terminated = already_terminated
    );

    match consume terminated
    {
        case Ok(terminated_path)
        {
            let mut owner: File =
            {
                handle = 0,
                is_open = false,
            };

            let native_handle: DataPointer<u8> = trusted std.os.windows.create_file_w(
                trusted std.memory.reinterpret<u16, u8>(terminated_path.pointer),
                access = access,
                share = std.os.windows.FILE_SHARE_READ | std.os.windows.FILE_SHARE_WRITE |
                    std.os.windows.FILE_SHARE_DELETE,
                security = std.memory.null<u8>(),
                creation = creation,
                attributes = std.os.windows.FILE_ATTRIBUTE_NORMAL,
                template_file = std.memory.null<u8>(),
            );

            let native_value: u64 = trusted internal std.platform.pointer_handle(native_handle);

            if native_value == std.numeric.U64_MAX
            {
                return Error(trusted internal std.platform.windows_error_status());
            }

            owner.handle = native_value;
            owner.is_open = true;

            return Ok(owner);
        }
        case Error(status) { return Error(status); }
    }
}

@abi(c)
trusted internal func platform_path_create_directory(pos path: PlatformPath) -> std.platform.PlatformStatus
    requires(
        trusted core.memory.valid_read<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = path.address, count = path.length as usize),
    )
{
    return trusted internal path_create_directory_implementation(path, already_terminated = false);
}

trusted internal func path_create_directory_implementation(
    pos path: PlatformPath,
    already_terminated: bool
) -> std.platform.PlatformStatus
    requires(
        trusted core.memory.valid_read<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = path.address, count = path.length as usize),
    )
    uses(foreign_call, layout_reinterpret)
{
    let terminated: Result<PreparedPath, std.platform.PlatformStatus> = trusted internal prepare_native_path(
        path,
        already_terminated = already_terminated
    );

    match consume terminated
    {
        case Ok(terminated_path)
        {
            return trusted internal windows_path_operation_status(
                trusted std.os.windows.create_directory_w(
                    trusted std.memory.reinterpret<u16, u8>(terminated_path.pointer),
                    security = std.memory.null<u8>(),
                )
            );
        }
        case Error(status) { return status; }
    }
}

