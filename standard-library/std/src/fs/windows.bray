@abi(c)
trusted internal func platform_path_rename(
    pos source: PlatformPath,
    pos new_path: PlatformPath,
) -> std.platform.PlatformStatus
    requires(
        trusted core.memory.valid_read<u8>(pointer = source.address, count = source.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = source.address, count = source.length as usize),
        trusted core.memory.valid_read<u8>(pointer = new_path.address, count = new_path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = new_path.address, count = new_path.length as usize),
    )
{
    return trusted internal path_rename_implementation(source, new_path, already_terminated = false);
}

trusted internal func path_rename_implementation(
    pos source: PlatformPath,
    pos new_path: PlatformPath,
    already_terminated: bool,
) -> std.platform.PlatformStatus
    requires(
        trusted core.memory.valid_read<u8>(pointer = source.address, count = source.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = source.address, count = source.length as usize),
        trusted core.memory.valid_read<u8>(pointer = new_path.address, count = new_path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = new_path.address, count = new_path.length as usize),
    )
    uses(foreign_call, layout_reinterpret)
{
    let terminated_source: Result<PreparedPath, std.platform.PlatformStatus> = trusted internal prepare_native_path(
        source,
        already_terminated = already_terminated
    );

    match consume terminated_source
    {
        case Ok(source_path)
        {
            let terminated_destination: Result<PreparedPath, std.platform.PlatformStatus> =
                trusted internal prepare_native_path(new_path, already_terminated = already_terminated);

            match consume terminated_destination
            {
                case Ok(destination_path)
                {
                    return trusted internal windows_path_operation_status(
                        trusted std.os.windows.move_file_ex_w(
                            trusted std.memory.reinterpret<u16, u8>(source_path.pointer),
                            destination = trusted std.memory.reinterpret<u16, u8>(destination_path.pointer),
                            flags = std.os.windows.MOVEFILE_REPLACE_EXISTING,
                        )
                    );
                }
                case Error(status) { return status; }
            }
        }
        case Error(status) { return status; }
    }
}

trusted internal func windows_path_operation_status(pos result: i32) -> std.platform.PlatformStatus
{
    if result == 0
    {
        return trusted internal std.platform.windows_error_status();
    }

    return internal std.platform.success_status();
}

trusted internal func platform_file_metadata_value(pos handle: u64) -> Result<FileMetadata, std.io.IoError>
    uses(foreign_call, layout_reinterpret)
{
    let mut storage: [u64; 7] = [0; 7];

    let data: DataPointer<u8> = trusted std.memory.reinterpret<u8, u64>(
        std.memory.address_of_mut<u64>(&mut storage[0])
    );

    if trusted std.os.windows.get_file_information_by_handle(
        trusted internal std.platform.handle_pointer(handle),
        data = data,
    ) == 0
    {
        return Error(trusted internal windows_io_error());
    }

    return internal windows_metadata(&storage[..], size_high_offset = 32, size_low_offset = 36);
}

trusted internal func platform_path_metadata_value(pos path: PlatformPath) -> Result<FileMetadata, std.io.IoError>
    requires(
        trusted core.memory.valid_read<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = path.address, count = path.length as usize),
    )
    uses(foreign_call, layout_reinterpret)
{
    let terminated: Result<PreparedPath, std.platform.PlatformStatus> = trusted internal prepare_native_path(
        path,
        already_terminated = true
    );

    match consume terminated
    {
        case Ok(terminated_path)
        {
            let mut storage: [u64; 5] = [0; 5];

            let data: DataPointer<u8> = trusted std.memory.reinterpret<u8, u64>(
                std.memory.address_of_mut<u64>(&mut storage[0])
            );

            if trusted std.os.windows.get_file_attributes_ex_w(
                trusted std.memory.reinterpret<u16, u8>(terminated_path.pointer),
                information_level = 0,
                data = data,
            ) == 0
            {
                return Error(trusted internal windows_io_error());
            }

            return internal windows_metadata(&storage[..], size_high_offset = 28, size_low_offset = 32);
        }
        case Error(status) { return Error(internal std.io.platform_status_error(status)); }
    }
}

trusted internal func platform_directory_state_capacity() -> usize
{
    return 76;
}

trusted internal func platform_directory_open(
    pos path: &std.path.Path,
    pos state: &mut [u64],
) -> Result<u64, std.io.IoError>
    uses(foreign_call, layout_reinterpret)
{
    let pattern: std.memory.RawBuffer<u16> = match trusted internal windows_directory_pattern(
        internal std.path.native_bytes(path.to_native())
    )
    {
        case Ok(buffer) { yield buffer; }
        case Error(status) { return Error(internal std.io.platform_status_error(status)); }
    };

    let search_handle: DataPointer<u8> = trusted std.os.windows.find_first_file_ex_w(
        std.memory.pointer<u16>(&pattern),
        information_level = std.os.windows.FIND_EX_INFO_BASIC,
        data = trusted std.memory.reinterpret<u8, u64>(std.memory.address_of_mut<u64>(&mut state[0])),
        search_operation = std.os.windows.FIND_EX_SEARCH_NAME_MATCH,
        search_filter = std.memory.null<u8>(),
        flags = std.os.windows.FIND_FIRST_EX_LARGE_FETCH,
    );

    if trusted internal std.platform.pointer_handle(search_handle) == std.numeric.U64_MAX
    {
        return Error(trusted internal windows_io_error());
    }

    return Ok(trusted internal std.platform.pointer_handle(search_handle));
}

trusted internal func platform_directory_next(
    pos handle: u64,
    pos state: &mut [u64],
    pos first: &mut u8,
) -> Result<DirectoryEntry?, std.io.IoError>
    uses(foreign_call, layout_reinterpret)
{
    let native_handle: DataPointer<u8> = trusted internal std.platform.handle_pointer(handle);

    loop
    {
        if first != 0
        {
            first = 0;
        }
        else if trusted std.os.windows.find_next_file_w(
            native_handle,
            data = trusted std.memory.reinterpret<u8, u64>(std.memory.address_of_mut<u64>(&mut state[0]))
        ) == 0
        {
            let error: u32 = trusted std.os.windows.get_last_error();

            if error == 18
            {
                let exhausted: DirectoryEntry? = none;

                return Ok(exhausted);
            }

            return Error(internal std.io.platform_status_error(internal std.platform.windows_error_status_from(error)));
        }

        let mut units: usize = 0;

        while units < 260 && internal windows_data_u16(&state, offset = 44 + units * 2) != 0
        {
            units += 1;
        }

        if units == 260
        {
            return Error(internal std.io.invalid_transfer_error());
        }

        if internal windows_dot_entry(&state, units = units)
        {
            continue;
        }

        let entry_path: std.path.Path = try trusted internal windows_directory_entry_path(&state, units = units);

        let entry_metadata: FileMetadata = try internal windows_metadata(
            &state,
            size_high_offset = 28,
            size_low_offset = 32,
        );

        let entry: DirectoryEntry =
        {
            path = entry_path,
            metadata = entry_metadata,
        };

        let mut result: DirectoryEntry? = none;

        result = entry;

        return Ok(result);
    }
}

trusted internal func platform_directory_close(pos directory: &mut Directory) -> Result<unit, std.io.IoError>
    ensures(result matches Error(_) || Directory.complete(value = &directory))
    uses(foreign_call)
{
    if trusted std.os.windows.find_close(trusted internal std.platform.handle_pointer(directory.handle)) == 0
    {
        return Error(trusted internal windows_io_error());
    }

    directory.is_open = false;

    return Ok(unit);
}

trusted internal func platform_directory_discard(pos handle: u64) -> unit
    uses(foreign_call)
{
    _ = trusted std.os.windows.find_close(trusted internal std.platform.handle_pointer(handle));
}

internal func windows_metadata(
    pos data: &[u64],
    size_high_offset: usize,
    size_low_offset: usize,
) -> Result<FileMetadata, std.io.IoError>
{
    let attributes: u32 = internal windows_data_u32(data, offset = 0);
    let write_low: u32 = internal windows_data_u32(data, offset = 20);
    let write_high: u32 = internal windows_data_u32(data, offset = 24);
    let size_high: u32 = internal windows_data_u32(data, offset = size_high_offset);
    let size_low: u32 = internal windows_data_u32(data, offset = size_low_offset);

    let kind: FileKind = if attributes & std.os.windows.FILE_ATTRIBUTE_DIRECTORY != 0
    {
        yield FileKind.Directory;
    }
    else
    {
        yield FileKind.File;
    };

    let mut modified: std.time.Timestamp? = none;

    match internal std.platform.windows_file_time(low = write_low, high = write_high)
    {
        case Ok(parts) { modified = internal std.time.timestamp_from_parts(seconds = parts.0, nanoseconds = parts.1); }
        case Error(_) {}
    }

    return Ok(
        {
            kind = kind,
            bytes = size_low as u64 | size_high as u64 << 32,
            modified = modified,
        }
    );
}

trusted internal func windows_directory_pattern(
    pos bytes: &[u8]
) -> Result<std.memory.RawBuffer<u16>, std.platform.PlatformStatus>
{
    let path_bytes: usize = bytes.length();

    if path_bytes % 2 != 0 || path_bytes > (std.numeric.USIZE_MAX >> 1) - 6
    {
        return Error(internal std.platform.invalid_input_status());
    }

    let mut pattern: std.memory.RawBuffer<u16> = match trusted std.memory.RawBuffer<u16>(capacity = path_bytes / 2 + 3)
    {
        case Ok(buffer) { yield buffer; }
        case Error(_) { return Error(internal std.platform.invalid_input_status()); }
    };

    let mut index: usize = 0;
    let mut last: u16 = 0;

    while index < path_bytes
    {
        let low: u16 = bytes[index] as u16;
        let high: u16 = bytes[index + 1] as u16;

        last = low | high << 8;
        trusted internal std.memory.initialize_spare<u16>(&mut pattern, last);
        index += 2;
    }

    if path_bytes > 0 && last != 47 && last != 92
    {
        trusted internal std.memory.initialize_spare<u16>(&mut pattern, 92);
    }

    trusted internal std.memory.initialize_spare<u16>(&mut pattern, 42);
    trusted internal std.memory.initialize_spare<u16>(&mut pattern, 0);

    return Ok(pattern);
}

internal func windows_data_u32(pos data: &[u64], offset: usize) -> u32
{
    assert(offset % 4 == 0, "native u32 field is misaligned");

    return std.numeric.truncate_to<u32>(data[offset / 8] >> (offset % 8 * 8) as u64);
}

internal func windows_data_u16(pos data: &[u64], offset: usize) -> u16
{
    assert(offset % 2 == 0, "native u16 field is misaligned");

    return std.numeric.truncate_to<u16>(data[offset / 8] >> (offset % 8 * 8) as u64);
}

internal func windows_dot_entry(pos data: &[u64], units: usize) -> bool
{
    return units == 1 && internal windows_data_u16(data, offset = 44) == 46 || units == 2 && internal windows_data_u16(
        data,
        offset = 44
    ) == 46 && internal windows_data_u16(data, offset = 46) == 46;
}

trusted internal func windows_directory_entry_path(
    pos data: &[u64],
    units: usize
) -> Result<std.path.Path, std.io.IoError>
{
    let mut storage: std.memory.RawBuffer<u8> = match trusted std.memory.RawBuffer<u8>(capacity = units * 2)
    {
        case Ok(buffer) { yield buffer; }
        case Error(_) { return Error(internal std.io.buffer_allocation_error()); }
    };

    let mut index: usize = 0;

    while index < units
    {
        let value: u16 = internal windows_data_u16(data, offset = 44 + index * 2);

        trusted internal std.memory.initialize_spare<u8>(&mut storage, std.numeric.truncate_to<u8>(value));
        trusted internal std.memory.initialize_spare<u8>(&mut storage, std.numeric.truncate_to<u8>(value >> 8));
        index += 1;
    }

    let buffer: std.bytes.Buffer =
    {
        storage = storage
    };

    let native: std.path.NativeText = internal std.path.native_text_from_buffer(buffer);

    match std.path.Path.from_native(native)
    {
        case Ok(path) { return Ok(path); }
        case Error(_) { return Error(internal std.io.invalid_transfer_error()); }
    }
}

trusted internal func windows_io_error() -> std.io.IoError
{
    return internal std.io.platform_status_error(trusted internal std.platform.windows_error_status());
}
