trusted module std.fs;

using core.memory;
using std.bytes;
using std.io;
using std.path;
using internal std.platform;
using std.memory;
using std.numeric;
using std.time;

@layout(c)
internal struct PlatformPath
{
    address: DataPointer<u8>;
    length: u64;
    // A value of 1 promises a readable native NUL after the logical bytes and
    // native-unit alignment for the duration of the call. Zero is length-delimited.
    terminated: u64;
}

@layout(c)
internal struct PlatformFileOptions
{
    access: u32;
    creation: u32;
    reserved: u64;
}

@copy
@layout(c)
internal struct PlatformFileMetadata
{
    kind: u32;
    present: u32;
    bytes: u64;
    modified_seconds: i64;
    modified_nanoseconds: u32;
    reserved: u32;
}

internal func empty_platform_metadata() -> PlatformFileMetadata
{
    return
    {
        kind = 0,
        present = 0,
        bytes = 0,
        modified_seconds = 0,
        modified_nanoseconds = 0,
        reserved = 0
    };
}

internal func encode_platform_metadata(pos value: FileMetadata) -> PlatformFileMetadata
{
    let kind: u32 = match value.kind
    {
        case FileKind.File { yield 0; }
        case FileKind.Directory { yield 1; }
        case FileKind.Other { yield 2; }
    };

    let mut present: u32 = 0;
    let mut seconds: i64 = 0;
    let mut nanoseconds: u32 = 0;

    match value.modified
    {
        case ?timestamp
        {
            present = 1;
            seconds = timestamp.seconds();
            nanoseconds = timestamp.nanoseconds();
        }
        case none {}
    }

    return
    {
        kind = kind,
        present = present,
        bytes = value.bytes,
        modified_seconds = seconds,
        modified_nanoseconds = nanoseconds,
        reserved = 0
    };
}

internal func decode_platform_metadata(pos value: PlatformFileMetadata) -> Result<FileMetadata, std.io.IoError>
{
    if value.reserved != 0 || value.present > 1 || value.kind > 2 || value.modified_nanoseconds >=
        std.time.NANOSECONDS_PER_SECOND
    {
        return Error(internal std.io.invalid_transfer_error());
    }

    let kind: FileKind = match value.kind
    {
        case 0 { yield FileKind.File; }
        case 1 { yield FileKind.Directory; }
        case _ { yield FileKind.Other; }
    };

    let mut modified: std.time.Timestamp? = none;

    if value.present == 1
    {
        modified = internal std.time.timestamp_from_parts(
            seconds = value.modified_seconds,
            nanoseconds = value.modified_nanoseconds
        );
    }

    return Ok(
        {
            kind = kind,
            bytes = value.bytes,
            modified = modified
        }
    );
}

internal func platform_status_from_io_error(pos error: std.io.IoError) -> std.platform.PlatformStatus
{
    let category: u32 = match error.kind
    {
        case std.io.IoErrorKind.Unsupported { yield 1; }
        case std.io.IoErrorKind.PermissionDenied { yield 2; }
        case std.io.IoErrorKind.NotFound { yield 3; }
        case std.io.IoErrorKind.AlreadyExists { yield 4; }
        case std.io.IoErrorKind.InvalidInput { yield 5; }
        case std.io.IoErrorKind.Interrupted { yield 6; }
        case std.io.IoErrorKind.Exhausted { yield 7; }
        case std.io.IoErrorKind.BrokenStream { yield 8; }
        case std.io.IoErrorKind.TimedOut { yield 9; }
        case std.io.IoErrorKind.Other { yield 10; }
    };

    let code: i64 = match error.platform_code
    {
        case ?value { yield value; }
        case none { yield 0; }
    };

    return internal std.platform.native_status(category = category, code = code);
}

@abi(c)
trusted internal func platform_file_metadata(
    pos handle: u64,
    pos metadata: DataPointer<PlatformFileMetadata>
) -> std.platform.PlatformStatus
    requires(
        trusted core.memory.valid_write<PlatformFileMetadata>(pointer = metadata, count = 1),
        trusted core.memory.aligned_for<PlatformFileMetadata>(pointer = metadata),
    )
    uses(raw_memory, unchecked_init)
{
    match consume trusted prepare_file_metadata(handle, metadata)
    {
        case Ok(value)
        {
            trusted std.memory.write<PlatformFileMetadata>(metadata, encode_platform_metadata(value));
            return internal std.platform.success_status();
        }
        case Error(error) { return platform_status_from_io_error(error); }
    }
}

@abi(c)
trusted internal func platform_path_metadata(
    pos path: PlatformPath,
    pos metadata: DataPointer<PlatformFileMetadata>
) -> std.platform.PlatformStatus
    requires(
        trusted core.memory.valid_read<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.valid_write<PlatformFileMetadata>(pointer = metadata, count = 1),
        trusted core.memory.aligned_for<PlatformFileMetadata>(pointer = metadata),
    )
    uses(raw_memory, unchecked_init)
{
    match consume trusted prepare_path_metadata(path, metadata)
    {
        case Ok(value)
        {
            trusted std.memory.write<PlatformFileMetadata>(metadata, encode_platform_metadata(value));
            return internal std.platform.success_status();
        }
        case Error(error) { return platform_status_from_io_error(error); }
    }
}

trusted internal func prepare_file_metadata(
    pos handle: u64,
    pos output: DataPointer<PlatformFileMetadata>
) -> Result<FileMetadata, std.io.IoError>
    requires(
        trusted core.memory.valid_write<PlatformFileMetadata>(pointer = output, count = 1),
        trusted core.memory.aligned_for<PlatformFileMetadata>(pointer = output),
    )
    ensures(
        trusted core.memory.valid_write<PlatformFileMetadata>(pointer = output, count = 1),
        trusted core.memory.aligned_for<PlatformFileMetadata>(pointer = output),
    )
{
    return trusted platform_file_metadata_value(handle);
}

trusted internal func prepare_path_metadata(
    pos path: PlatformPath,
    pos output: DataPointer<PlatformFileMetadata>
) -> Result<FileMetadata, std.io.IoError>
    requires(
        trusted core.memory.valid_read<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.valid_write<PlatformFileMetadata>(pointer = output, count = 1),
        trusted core.memory.aligned_for<PlatformFileMetadata>(pointer = output),
    )
    ensures(
        trusted core.memory.valid_write<PlatformFileMetadata>(pointer = output, count = 1),
        trusted core.memory.aligned_for<PlatformFileMetadata>(pointer = output),
    )
{
    return trusted platform_path_metadata_value(path);
}

trusted internal func prepare_file_close(
    pos handle: u64,
    pos released: DataPointer<u32>
) -> (std.platform.PlatformStatus, bool)
    requires(
        trusted core.memory.valid_write<u32>(pointer = released, count = 1),
        trusted core.memory.aligned_for<u32>(pointer = released),
    )
    ensures(
        trusted core.memory.valid_write<u32>(pointer = released, count = 1),
        trusted core.memory.aligned_for<u32>(pointer = released),
    )
{
    return trusted internal std.platform.resource.close(handle);
}

internal func platform_path(pos path: &std.path.Path) -> PlatformPath
    executes(pure)
    ensures(
        trusted core.memory.valid_read<u8>(pointer = result.address, count = result.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = result.address, count = result.length as usize),
    )
{
    let bytes: &[u8] = internal std.path.native_bytes(path.to_native());

    // A zero-length slice can have a null pointer. The provider uses a static
    // terminator for that case without allocating.
    let terminated: u64 = if bytes.length() == 0
    {
        yield 0;
    }
    else
    {
        yield 1;
    };

    return
    {
        address = internal std.memory.slice_pointer(bytes, count = bytes.length()),
        length = bytes.length() as u64,
        terminated = terminated,
    };
}

internal func file_access_value(pos value: FileAccess) -> u32
    executes(pure, total)
{
    return match value
    {
        case Read { yield 0; }
        case Write { yield 1; }
        case ReadWrite { yield 2; }
        case Append { yield 3; }
    };
}

internal func file_creation_value(pos value: FileCreation) -> u32
    executes(pure, total)
{
    return match value
    {
        case OpenExisting { yield 0; }
        case CreateIfMissing { yield 1; }
        case CreateNew { yield 2; }
        case Truncate { yield 3; }
        case CreateOrTruncate { yield 4; }
    };
}

internal func seek_origin_value(pos value: std.io.SeekOrigin) -> u32
    executes(pure, total)
{
    return match value
    {
        case Start { yield 0; }
        case Current { yield 1; }
        case End { yield 2; }
    };
}

internal func checked_platform_status(pos value: std.platform.PlatformStatus) -> Result<unit, std.io.IoError>
{
    return internal std.io.checked_status(value);
}

trusted internal func directory_entry_path(
    pos source: DataPointer<u8>,
    bytes: usize,
) -> Result<std.path.Path, std.io.IoError>
    requires(
        trusted core.memory.valid_read<u8>(pointer = source, count = bytes),
        trusted core.memory.initialized_range_as<u8>(pointer = source, count = bytes),
    )
    uses(manual_alloc, unchecked_init)
{
    let mut storage: std.memory.RawBuffer<u8> = trusted internal std.memory.allocate_buffer<u8>(
        capacity = bytes,
        bytes = bytes,
        align = 1,
    );

    let initialized: usize = trusted internal std.memory.copy_spare_raw_bytes(
        &mut storage,
        source = source,
        count = bytes,
    );

    trusted std.memory.set_initialized_count<u8>(&mut storage, count = initialized);

    let buffer: std.bytes.Buffer =
    {
        storage = storage
    };

    let native: std.path.NativeText = internal std.path.native_text_from_buffer(buffer);

    match std.path.Path.from_native(native)
    {
        case Ok(path) { return Ok(path); }
        case Error(_) { return Error(internal std.io.invalid_transfer_error()); }
    }
}

@abi(c)
trusted internal func platform_file_seek(
    pos handle: u64,
    pos offset_bits: u64,
    pos origin: u32,
    pos position: DataPointer<u64>,
) -> std.platform.PlatformStatus
    requires(
        trusted core.memory.valid_write<u64>(pointer = position, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = position),
    )
    uses(raw_memory, unchecked_init)
{
    let observed: Result<u64, std.platform.PlatformStatus> = trusted internal prepare_file_seek(
        handle,
        offset_bits,
        origin,
        position,
    );

    match consume observed
    {
        case Ok(value)
        {
            trusted std.memory.write<u64>(position, value);

            return internal std.platform.success_status();
        }
        case Error(status) { return status; }
    }
}

@abi(c)
trusted internal func platform_file_open(
    pos path: PlatformPath,
    pos options: PlatformFileOptions,
    pos opened: DataPointer<u64>,
) -> std.platform.PlatformStatus
    requires(
        trusted core.memory.valid_read<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.valid_write<u64>(pointer = opened, count = 1),
        trusted core.memory.aligned_for<u64>(pointer = opened),
    )
    uses(raw_memory, unchecked_init)
{
    let prepared: Result<File, std.platform.PlatformStatus> = trusted internal prepare_file_open(path, options, opened);

    match consume prepared
    {
        case Ok(created)
        {
            let mut owner: File = created;

            trusted std.memory.write<u64>(opened, value = owner.handle);
            owner.is_open = false;

            return internal std.platform.success_status();
        }
        case Error(status) { return status; }
    }
}

internal static EMPTY_PATH_TERMINATOR: u16 = 0;

// Owns a temporary only for callers of the length-delimited platform ABI.
internal struct PreparedPath
{
    pointer: DataPointer<u8>;
    storage: std.memory.RawBuffer<u8>?;
}

// A terminated input must carry the PlatformPath guarantee for the entire call.
trusted internal func prepare_native_path(pos path: PlatformPath) -> Result<PreparedPath, std.platform.PlatformStatus>
    requires(
        trusted core.memory.valid_read<u8>(pointer = path.address, count = path.length as usize),
        trusted core.memory.initialized_range_as<u8>(pointer = path.address, count = path.length as usize),
    )
    uses(manual_alloc, raw_memory, unchecked_init)
{
    let width: usize = if target.identity.SYSTEM == "windows"
    {
        yield 2;
    }
    else
    {
        yield 1;
    };

    let count: usize = path.length as usize;

    let extra: usize = if width == 2
    {
        yield 3;
    }
    else
    {
        yield 1;
    };

    if count as u64 != path.length || count % width != 0 || count > std.numeric.USIZE_MAX - extra || (count > 0 &&
        std.memory.is_null<u8>(path.address))
    {
        return Error(internal std.platform.invalid_input_status());
    }

    if path.length == 0
    {
        return Ok(
            {
                pointer = std.memory.byte_address<u16>(std.memory.address_of<u16>(&EMPTY_PATH_TERMINATOR)),
                storage = none,
            }
        );
    }

    if path.terminated == 1
    {
        if width == 2 && trusted internal std.platform.pointer_handle(path.address) % 2 != 0
        {
            return Error(internal std.platform.invalid_input_status());
        }

        return Ok(
            {
                pointer = path.address,
                storage = none
            }
        );
    }

    let capacity: usize = count + extra;

    let mut buffer: std.memory.RawBuffer<u8> = trusted internal std.memory.allocate_buffer<u8>(
        capacity = capacity,
        bytes = capacity,
        align = 1,
    );

    if count > 0
    {
        let initialized: usize = trusted internal std.memory.copy_spare_raw_bytes(
            &mut buffer,
            source = path.address,
            count = count,
        );

        trusted std.memory.set_initialized_count<u8>(&mut buffer, count = initialized);
    }

    let mut start: usize = 0;

    if width == 2 && trusted internal std.platform.pointer_handle(buffer.pointer) % 2 != 0
    {
        trusted internal std.memory.initialize_spare<u8>(&mut buffer, 0);

        let bytes: &mut [u8] = trusted std.memory.initialized_slice_mut<u8>(&mut buffer);
        let mut index: usize = count;

        while index > 0
        {
            bytes[index] = bytes[index - 1];
            index -= 1;
        }

        start = 1;
    }

    trusted internal std.memory.initialize_spare<u8>(&mut buffer, 0);

    if width == 2
    {
        trusted internal std.memory.initialize_spare<u8>(&mut buffer, 0);
    }

    let bytes: &[u8] = trusted std.memory.initialized_slice<u8>(&buffer);
    let pointer: DataPointer<u8> = std.memory.address_of<u8>(&bytes[start]);
    let mut storage: std.memory.RawBuffer<u8>? = none;

    storage = buffer;

    return Ok(
        {
            pointer = pointer,
            storage = storage
        }
    );
}
