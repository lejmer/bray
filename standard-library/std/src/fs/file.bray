trusted module std.fs;

struct File
{
    internal handle: u64;
    internal mut is_open: bool;

    construct open(pos path: &std.path.Path, options: OpenOptions) -> Result<Self, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted open_file(path, options = options);
    }

    trusted finalize() -> Result<unit, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted close_file(&mut self);
    }

    trusted destruct()
    {
        if self.is_open
        {
            let _: std.platform.PlatformStatus = trusted platform_file_close(handle = self.handle);
        }
    }

    func metadata() -> Result<FileMetadata, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted file_metadata(handle = self.handle);
    }

    async func metadata_async() -> Result<FileMetadata, std.io.IoError>
        requires(blocking_execution())
    {
        return self.metadata();
    }

    mut func read(pos destination: &mut [u8]) -> Result<usize, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted read_file(&mut self, destination);
    }

    mut func write(pos source: &[u8]) -> Result<usize, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted write_file(&mut self, source);
    }

    mut func flush() -> Result<unit, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted flush_file(&mut self);
    }

    mut func seek(offset: i64, origin: std.io.SeekOrigin) -> Result<u64, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted seek_file(&mut self, offset = offset, origin = origin);
    }

    mut async func read_async(pos destination: &mut [u8]) -> Result<usize, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted read_file(&mut self, destination);
    }

    mut async func write_async(pos source: &[u8]) -> Result<usize, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted write_file(&mut self, source);
    }

    mut async func flush_async() -> Result<unit, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted flush_file(&mut self);
    }

    mut async func seek_async(offset: i64, origin: std.io.SeekOrigin) -> Result<u64, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted seek_file(&mut self, offset = offset, origin = origin);
    }

    consume mut func close() -> Result<unit, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted close_file(&mut self);
    }

    consume mut async func close_async() -> Result<unit, std.io.IoError>
        requires(blocking_execution())
    {
        return self.close();
    }
}

trusted internal func open_file(pos path: &std.path.Path, options: OpenOptions) -> Result<File, std.io.IoError>
    requires(blocking_execution())
{
    let handle: u64 = try open_file_handle(path, options = options);

    let file: File =
    {
        handle = handle,
        is_open = true,
    };

    return Ok(file);
}

/// Opens one file as a scalar handle owned until `close_file_handle` or process termination.
trusted func open_file_handle(pos path: &std.path.Path, options: OpenOptions) -> Result<u64, std.io.IoError>
    requires(blocking_execution())
{
    let platform_path_value: PlatformPath = platform_path(path);

    let platform_options: PlatformFileOptions =
    {
        access = file_access_value(options.access),
        creation = file_creation_value(options.creation),
        reserved = 0,
    };

    let mut handle: u64 = 0;
    let handle_pointer: RawPointer<u64> = std.memory.address_of_mut(&mut handle);

    let status: std.platform.PlatformStatus = trusted platform_file_open(
        platform_path_value,
        options = platform_options,
        opened = handle_pointer,
    );

    try checked_platform_status(status);

    return Ok(handle);
}

trusted internal func file_metadata(handle: u64) -> Result<FileMetadata, std.io.IoError>
    requires(blocking_execution())
{
    return trusted platform_file_metadata_value(handle);
}

trusted internal func close_file(pos file: &mut File) -> Result<unit, std.io.IoError>
    requires(blocking_execution())
{
    if !file.is_open
    {
        return Ok(unit);
    }

    let result: Result<unit, std.io.IoError> = trusted close_file_handle(handle = file.handle);

    match consume result
    {
        case Ok(_)
        {
            file.is_open = false;

            return Ok(unit);
        }
        case Error(error) { return Error(error); }
    }
}

/// Closes one owned scalar file handle.
trusted func close_file_handle(pos handle: u64) -> Result<unit, std.io.IoError>
    requires(blocking_execution())
{
    return checked_platform_status(trusted platform_file_close(handle = handle));
}

impl FileReader = File(std.io.Reader)
{
    mut func read(pos destination: &mut [u8]) -> Result<usize, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted read_file(&mut self, destination);
    }
}

impl FileWriter = File(std.io.Writer)
{
    mut func write(pos source: &[u8]) -> Result<usize, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted write_file(&mut self, source);
    }

    mut func flush() -> Result<unit, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted flush_file(&mut self);
    }
}

impl FileSeeker = File(std.io.Seeker)
{
    mut func seek(offset: i64, origin: std.io.SeekOrigin) -> Result<u64, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted seek_file(&mut self, offset = offset, origin = origin);
    }
}

trusted internal func read_file(pos file: &mut File, pos destination: &mut [u8]) -> Result<usize, std.io.IoError>
    requires(blocking_execution())
{
    let maximum: usize = destination.length();
    let destination_pointer: RawPointer<u8> = internal std.memory.byte_slice_pointer_mut(destination);
    let mut transferred: u64 = 0;
    let transferred_pointer: RawPointer<u64> = std.memory.address_of_mut(&mut transferred);

    let status: std.platform.PlatformStatus = trusted platform_file_read(
        handle = file.handle,
        destination = destination_pointer,
        length = maximum as u64,
        transferred = transferred_pointer,
    );

    return internal std.io.checked_transfer(
        status,
        transferred = transferred,
        maximum = maximum,
        require_progress = false,
    );
}

trusted internal func write_file(pos file: &mut File, pos source: &[u8]) -> Result<usize, std.io.IoError>
    requires(blocking_execution())
{
    return trusted write_file_handle(file.handle, source = source);
}

trusted internal func write_file_handle(pos handle: u64, pos source: &[u8]) -> Result<usize, std.io.IoError>
    requires(blocking_execution())
{
    let maximum: usize = source.length();
    let source_pointer: RawPointer<u8> = internal std.memory.byte_slice_pointer(source);
    let mut transferred: u64 = 0;
    let transferred_pointer: RawPointer<u64> = std.memory.address_of_mut(&mut transferred);

    let status: std.platform.PlatformStatus = trusted platform_file_write(
        handle = handle,
        source = source_pointer,
        length = maximum as u64,
        transferred = transferred_pointer,
    );

    return internal std.io.checked_transfer(
        status,
        transferred = transferred,
        maximum = maximum,
        require_progress = true,
    );
}

/// Writes an entire byte slice to a scalar file handle owned by a trusted runtime component.
trusted func write_all_file_handle(pos handle: u64, pos source: &[u8]) -> Result<unit, std.io.IoError>
    requires(blocking_execution())
{
    let mut written: usize = 0;

    while written < source.length()
    {
        written += try trusted write_file_handle(handle, &source[written..source.length()]);
    }

    return Ok(unit);
}

trusted internal func flush_file(pos file: &mut File) -> Result<unit, std.io.IoError>
    requires(blocking_execution())
{
    let status: std.platform.PlatformStatus = trusted platform_file_flush(handle = file.handle);

    return checked_platform_status(status);
}

trusted internal func seek_file(
    pos file: &mut File,
    offset: i64,
    origin: std.io.SeekOrigin,
) -> Result<u64, std.io.IoError>
    requires(blocking_execution())
{
    let mut position: u64 = 0;
    let position_pointer: RawPointer<u64> = std.memory.address_of_mut(&mut position);

    let status: std.platform.PlatformStatus = trusted platform_file_seek(
        handle = file.handle,
        offset_bits = std.truncate_to<u64>(offset),
        origin = seek_origin_value(origin),
        position = position_pointer,
    );

    try checked_platform_status(status);

    return Ok(position);
}

impl FileAsyncReader = File(std.io.AsyncReader)
{
    mut async func read_async(pos destination: &mut [u8]) -> Result<usize, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted read_file(&mut self, destination);
    }
}

impl FileAsyncWriter = File(std.io.AsyncWriter)
{
    mut async func write_async(pos source: &[u8]) -> Result<usize, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted write_file(&mut self, source);
    }

    mut async func flush_async() -> Result<unit, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted flush_file(&mut self);
    }
}

impl FileAsyncSeeker = File(std.io.AsyncSeeker)
{
    mut async func seek_async(offset: i64, origin: std.io.SeekOrigin) -> Result<u64, std.io.IoError>
        requires(blocking_execution())
    {
        return trusted seek_file(&mut self, offset = offset, origin = origin);
    }
}
