@target(target.identity.NAME == "x86_64-pc-windows-msvc" || target.identity.NAME == "aarch64-pc-windows-msvc")
trusted module std.os.windows;

@copy
@layout(transparent)
struct Handle
{
    internal raw: usize;

    func value() -> usize
    {
        return self.raw;
    }
}

func handle(pos raw: usize) -> Handle
{
    return
    {
        raw = raw,
    };
}
