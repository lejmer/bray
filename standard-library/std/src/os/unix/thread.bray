@target(target.identity.SYSTEM == "linux" || target.identity.SYSTEM == "darwin")
trusted internal module std.os.unix;

struct PThreadAttribute;

// pthread_create invokes this callback on a dedicated native-thread execution root.
callable ThreadStartRoutine = @abi(c) trusted func(pos context: RawPointer<u8>) -> RawPointer<u8>
    requires(blocking_execution(), compute_execution());

callable ThreadStorageDestructor = @abi(c) func(pos value: RawPointer<u8>);
