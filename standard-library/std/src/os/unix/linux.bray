@target(target.identity.SYSTEM == "linux")
trusted internal module std.os.unix;

const MAP_ANONYMOUS: i32 = std.os.linux.MAP_ANONYMOUS;

const MAP_PRIVATE: i32 = std.os.linux.MAP_PRIVATE;

const O_APPEND: i32 = std.os.linux.O_APPEND;

const O_CLOEXEC: i32 = std.os.linux.O_CLOEXEC;

const O_CREAT: i32 = std.os.linux.O_CREAT;

const O_EXCL: i32 = std.os.linux.O_EXCL;

const O_RDONLY: i32 = std.os.linux.O_RDONLY;

const O_RDWR: i32 = std.os.linux.O_RDWR;

const O_TRUNC: i32 = std.os.linux.O_TRUNC;

const O_WRONLY: i32 = std.os.linux.O_WRONLY;

const PROT_EXEC: i32 = std.os.linux.PROT_EXEC;

const PROT_NONE: i32 = std.os.linux.PROT_NONE;

const PROT_READ: i32 = std.os.linux.PROT_READ;

const PROT_WRITE: i32 = std.os.linux.PROT_WRITE;

const RTLD_GLOBAL: i32 = std.os.linux.RTLD_GLOBAL;

const RTLD_LAZY: i32 = std.os.linux.RTLD_LAZY;

const RTLD_LOCAL: i32 = std.os.linux.RTLD_LOCAL;

const RTLD_NOW: i32 = std.os.linux.RTLD_NOW;

const SEEK_CURRENT: i32 = std.os.linux.SEEK_CURRENT;

const SEEK_END: i32 = std.os.linux.SEEK_END;

const SEEK_START: i32 = std.os.linux.SEEK_START;

const SPAWN_FILE_ACTION_WORDS: usize = std.os.linux.SPAWN_FILE_ACTION_WORDS;

const DIRECTORY_NAME_CAPACITY: usize = std.os.linux.DIRECTORY_NAME_CAPACITY;

const DIRECTORY_NAME_OFFSET: usize = std.os.linux.DIRECTORY_NAME_OFFSET;

const FILE_KIND_DIRECTORY: u32 = std.os.linux.FILE_KIND_DIRECTORY;

const FILE_KIND_MASK: u32 = std.os.linux.FILE_KIND_MASK;

const FILE_KIND_REGULAR: u32 = std.os.linux.FILE_KIND_REGULAR;

const FILE_STATUS_MODE_OFFSET: usize = std.os.linux.FILE_STATUS_MODE_OFFSET;

const FILE_STATUS_MODIFIED_NANOSECONDS_OFFSET: usize = std.os.linux.FILE_STATUS_MODIFIED_NANOSECONDS_OFFSET;

const FILE_STATUS_MODIFIED_SECONDS_OFFSET: usize = std.os.linux.FILE_STATUS_MODIFIED_SECONDS_OFFSET;

const FILE_STATUS_SIZE: usize = std.os.linux.FILE_STATUS_SIZE;

const FILE_STATUS_SIZE_OFFSET: usize = std.os.linux.FILE_STATUS_SIZE_OFFSET;

trusted func close(pos descriptor: i32) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.close(descriptor);
}

trusted func create_directory(pos path: RawPointer<u8>, mode: u32) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.mkdir(path, mode = mode);
}

trusted func close_directory(pos directory: RawPointer<u8>) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.close_directory(directory);
}

trusted func directory_descriptor(pos directory: RawPointer<u8>) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.directory_descriptor(directory);
}

trusted func dlclose(pos handle: RawPointer<u8>) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.dlclose(handle);
}

trusted func dlerror() -> RawPointer<u8>
    uses(foreign_call)
{
    return trusted std.os.linux.dlerror();
}

trusted func dlopen(pos path: RawPointer<u8>, mode: i32) -> RawPointer<u8>
    uses(foreign_call)
{
    return trusted std.os.linux.dlopen(path, mode = mode);
}

trusted func dlsym(pos handle: RawPointer<u8>, pos name: RawPointer<u8>) -> RawPointer<u8>
    uses(foreign_call)
{
    return trusted std.os.linux.dlsym(handle, name);
}

trusted func mmap(
    pos address: RawPointer<u8>,
    pos length: usize,
    pos protection: i32,
    pos flags: i32,
    pos descriptor: i32,
    pos offset: i64,
) -> RawPointer<u8>
    uses(foreign_call)
{
    return trusted std.os.linux.mmap(address, length, protection, flags, descriptor, offset);
}

trusted func flush(pos descriptor: i32) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.fsync(descriptor);
}

trusted func file_status(pos descriptor: i32, pos status: RawPointer<u8>) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.file_status(descriptor, status);
}

trusted func file_status_at(
    pos directory: i32,
    pos path: RawPointer<u8>,
    pos status: RawPointer<u8>,
    pos flags: i32,
) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.file_status_at(directory, path, status, flags);
}

trusted func working_directory(pos destination: RawPointer<u8>, capacity: usize) -> RawPointer<u8>
    uses(foreign_call)
{
    return trusted std.os.linux.getcwd(destination, capacity = capacity);
}

trusted func open_file(pos path: RawPointer<u8>, flags: i32, mode: u32) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.open(path, flags, mode);
}

trusted func open_directory(pos path: RawPointer<u8>) -> RawPointer<u8>
    uses(foreign_call)
{
    return trusted std.os.linux.open_directory(path);
}

trusted func path_status(pos path: RawPointer<u8>, pos status: RawPointer<u8>) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.path_status(path, status);
}

trusted func read_directory(pos directory: RawPointer<u8>) -> RawPointer<u8>
    uses(foreign_call)
{
    return trusted std.os.linux.read_directory(directory);
}

trusted func seek(pos descriptor: i32, offset: i64, origin: i32) -> i64
    uses(foreign_call)
{
    return trusted std.os.linux.lseek(descriptor, offset, origin);
}

trusted func mprotect(pos address: RawPointer<u8>, pos length: usize, pos protection: i32) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.mprotect(address, length, protection);
}

trusted func munmap(pos address: RawPointer<u8>, pos length: usize) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.munmap(address, length);
}

trusted func read(pos descriptor: i32, pos destination: RawPointer<u8>, pos length: usize) -> isize
    uses(foreign_call)
{
    return trusted std.os.linux.read(descriptor, destination = destination, length = length);
}

trusted func remove_directory(pos path: RawPointer<u8>) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.rmdir(path);
}

trusted func remove_file(pos path: RawPointer<u8>) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.unlink(path);
}

trusted func rename_path(pos source: RawPointer<u8>, pos destination: RawPointer<u8>) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.rename(source, destination);
}

trusted func write(pos descriptor: i32, pos source: RawPointer<u8>, pos length: usize) -> isize
    uses(foreign_call)
{
    return trusted std.os.linux.write(descriptor, source = source, length = length);
}

trusted func socket_pair(pos descriptors: RawPointer<i32>) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.socket_pair(
        std.os.linux.AF_UNIX,
        kind = std.os.linux.SOCK_STREAM | std.os.linux.SOCK_CLOEXEC,
        protocol = 0,
        descriptors = descriptors,
    );
}

trusted func duplicate_close_on_exec(pos descriptor: i32, minimum: i32) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.fcntl(descriptor, std.os.linux.F_DUPFD_CLOEXEC, minimum);
}

trusted func initialize_spawn_actions(pos actions: RawPointer<u8>) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.spawn_actions_initialize(
        trusted std.memory.reinterpret<std.os.linux.PosixSpawnFileActions, u8>(actions)
    );
}

trusted func add_spawn_close(pos actions: RawPointer<u8>, descriptor: i32) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.spawn_actions_add_close(
        trusted std.memory.reinterpret<std.os.linux.PosixSpawnFileActions, u8>(actions),
        descriptor,
    );
}

trusted func add_spawn_duplicate(pos actions: RawPointer<u8>, source: i32, destination: i32) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.spawn_actions_add_duplicate(
        trusted std.memory.reinterpret<std.os.linux.PosixSpawnFileActions, u8>(actions),
        source,
        destination,
    );
}

trusted func add_spawn_working_directory(pos actions: RawPointer<u8>, path: RawPointer<u8>) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.spawn_actions_add_chdir(
        trusted std.memory.reinterpret<std.os.linux.PosixSpawnFileActions, u8>(actions),
        path,
    );
}

trusted func destroy_spawn_actions(pos actions: RawPointer<u8>) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.spawn_actions_destroy(
        trusted std.memory.reinterpret<std.os.linux.PosixSpawnFileActions, u8>(actions)
    );
}

trusted func spawn(
    pos process: RawPointer<i32>,
    pos executable: RawPointer<u8>,
    pos actions: RawPointer<u8>,
    pos arguments: RawPointer<RawPointer<u8>>,
    pos environment: RawPointer<RawPointer<u8>>,
) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.posix_spawn(
        process,
        path = executable,
        actions = trusted std.memory.reinterpret<std.os.linux.PosixSpawnFileActions, u8>(actions),
        attributes = std.memory.null<u8>(),
        arguments = arguments,
        environment = environment,
    );
}

trusted func wait(pos process: i32, pos status: RawPointer<i32>) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.wait_pid(process, status, options = 0);
}

trusted func signal(pos process: i32, force: bool) -> i32
    uses(foreign_call)
{
    let requested: i32 = match force
    {
        case true { yield std.os.linux.SIGKILL; }
        case false { yield std.os.linux.SIGTERM; }
    };

    return trusted std.os.linux.kill(process, signal = requested);
}

trusted func pthread_create(
    pos thread: RawPointer<u64>,
    pos attributes: RawPointer<PThreadAttribute>,
    pos entry: ThreadStartRoutine,
    pos context: RawPointer<u8>,
) -> i32
    uses(foreign_call)
{
    let entry_pointer: RawPointer<ThreadStartRoutine> = trusted std.memory.pointer_from_callable(entry);

    let native_pointer: RawPointer<std.os.linux.ThreadStartRoutine> = trusted std.memory.reinterpret<
        std.os.linux.ThreadStartRoutine,
        ThreadStartRoutine
    >(entry_pointer);

    let native_entry: std.os.linux.ThreadStartRoutine = trusted std.memory.callable_from_pointer(native_pointer);

    return trusted std.os.linux.pthread_create(
        thread,
        attributes = trusted std.memory.reinterpret<std.os.linux.PThreadAttribute, PThreadAttribute>(attributes),
        entry = native_entry,
        context = context,
    );
}

trusted func pthread_detach(pos thread: u64) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.pthread_detach(thread);
}

trusted func pthread_join(pos thread: u64, pos result: RawPointer<RawPointer<u8>>) -> i32
    uses(foreign_call)
{
    return trusted std.os.linux.pthread_join(thread, result);
}

trusted func pthread_self() -> u64
    uses(foreign_call)
{
    return trusted std.os.linux.pthread_self();
}
