    uses(foreign_call)
{
    return trusted std.os.darwin.file_status(descriptor, status);
}

trusted func file_status_at(
    pos directory: i32,
    pos path: RawPointer<u8>,
    pos status: RawPointer<u8>,
    pos flags: i32,
) -> i32
    uses(foreign_call)
