@target(target.identity.SYSTEM == "darwin")
trusted internal module std.os.unix;

const MAP_ANONYMOUS: i32 = std.os.darwin.MAP_ANONYMOUS;

const MAP_PRIVATE: i32 = std.os.darwin.MAP_PRIVATE;

const O_APPEND: i32 = std.os.darwin.O_APPEND;

const O_CLOEXEC: i32 = std.os.darwin.O_CLOEXEC;

const O_CREAT: i32 = std.os.darwin.O_CREAT;

const O_EXCL: i32 = std.os.darwin.O_EXCL;

const O_RDONLY: i32 = std.os.darwin.O_RDONLY;

const O_RDWR: i32 = std.os.darwin.O_RDWR;

const O_TRUNC: i32 = std.os.darwin.O_TRUNC;

const O_WRONLY: i32 = std.os.darwin.O_WRONLY;

const PROT_EXEC: i32 = std.os.darwin.PROT_EXEC;

const PROT_NONE: i32 = std.os.darwin.PROT_NONE;

const PROT_READ: i32 = std.os.darwin.PROT_READ;

const PROT_WRITE: i32 = std.os.darwin.PROT_WRITE;

const RTLD_GLOBAL: i32 = std.os.darwin.RTLD_GLOBAL;

const RTLD_LAZY: i32 = std.os.darwin.RTLD_LAZY;

const RTLD_LOCAL: i32 = std.os.darwin.RTLD_LOCAL;

const RTLD_NOW: i32 = std.os.darwin.RTLD_NOW;

const SEEK_CURRENT: i32 = std.os.darwin.SEEK_CURRENT;

const SEEK_END: i32 = std.os.darwin.SEEK_END;

const SEEK_START: i32 = std.os.darwin.SEEK_START;

const SPAWN_FILE_ACTION_WORDS: usize = std.os.darwin.SPAWN_FILE_ACTION_WORDS;

const DIRECTORY_NAME_CAPACITY: usize = std.os.darwin.DIRECTORY_NAME_CAPACITY;

const DIRECTORY_NAME_OFFSET: usize = std.os.darwin.DIRECTORY_NAME_OFFSET;

const FILE_KIND_DIRECTORY: u32 = std.os.darwin.FILE_KIND_DIRECTORY;

const FILE_KIND_MASK: u32 = std.os.darwin.FILE_KIND_MASK;

const FILE_KIND_REGULAR: u32 = std.os.darwin.FILE_KIND_REGULAR;

const FILE_STATUS_MODE_OFFSET: usize = std.os.darwin.FILE_STATUS_MODE_OFFSET;

const FILE_STATUS_MODIFIED_NANOSECONDS_OFFSET: usize = std.os.darwin.FILE_STATUS_MODIFIED_NANOSECONDS_OFFSET;

const FILE_STATUS_MODIFIED_SECONDS_OFFSET: usize = std.os.darwin.FILE_STATUS_MODIFIED_SECONDS_OFFSET;

const FILE_STATUS_SIZE: usize = std.os.darwin.FILE_STATUS_SIZE;

const FILE_STATUS_SIZE_OFFSET: usize = std.os.darwin.FILE_STATUS_SIZE_OFFSET;

trusted func close(pos descriptor: i32) -> i32
    uses(foreign_call)
{
    return trusted std.os.darwin.close(descriptor);
}

trusted func create_directory(pos path: RawPointer<u8>, mode: u32) -> i32
    uses(foreign_call)
{
    return trusted std.os.darwin.mkdir(path, mode = mode);
}

trusted func close_directory(pos directory: RawPointer<u8>) -> i32
    uses(foreign_call)
{
    return trusted std.os.darwin.close_directory(directory);
}

trusted func directory_descriptor(pos directory: RawPointer<u8>) -> i32
    uses(foreign_call)
{
    return trusted std.os.darwin.directory_descriptor(directory);
}

trusted func dlclose(pos handle: RawPointer<u8>) -> i32
    uses(foreign_call)
{
    return trusted std.os.darwin.dlclose(handle);
}

trusted func dlerror() -> RawPointer<u8>
    uses(foreign_call)
{
    return trusted std.os.darwin.dlerror();
}

trusted func dlopen(pos path: RawPointer<u8>, mode: i32) -> RawPointer<u8>
    uses(foreign_call)
{
    return trusted std.os.darwin.dlopen(path, mode = mode);
}

trusted func dlsym(pos handle: RawPointer<u8>, pos name: RawPointer<u8>) -> RawPointer<u8>
    uses(foreign_call)
{
    return trusted std.os.darwin.dlsym(handle, name);
}

