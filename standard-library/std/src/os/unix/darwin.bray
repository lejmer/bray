trusted func write(pos descriptor: i32, pos source: RawPointer<u8>, pos length: usize) -> isize
    uses(foreign_call)
{
    return trusted std.os.darwin.write(descriptor, source = source, length = length);
}

trusted func socket_pair(pos descriptors: RawPointer<i32>) -> i32
    uses(foreign_call)
{
    trusted std.memory.write<i32>(descriptors, value = -1);
    trusted std.memory.write<i32>(std.memory.offset<i32>(descriptors, elements = 1), value = -1);

    let status: i32 = trusted std.os.darwin.socket_pair(
        std.os.darwin.AF_UNIX,
        kind = std.os.darwin.SOCK_STREAM,
        protocol = 0,
        descriptors = descriptors,
    );

    if status != 0
    {
        return -1;
    }

    let first: i32 = trusted std.memory.read<i32>(descriptors);
    let second: i32 = trusted std.memory.read<i32>(std.memory.offset<i32>(descriptors, elements = 1));

    if trusted std.os.darwin.fcntl(first, std.os.darwin.F_SETFD, std.os.darwin.FD_CLOEXEC) != 0 ||
        trusted std.os.darwin.fcntl(second, std.os.darwin.F_SETFD, std.os.darwin.FD_CLOEXEC) != 0
    {
        let error_location: RawPointer<i32> = trusted std.os.darwin.error_location();
        let error: i32 = trusted internal std.platform.read_native_i32(error_location);

        let _: i32 = trusted std.os.darwin.close(first);
        let _: i32 = trusted std.os.darwin.close(second);
        trusted std.memory.write<i32>(error_location, value = error);

        return -1;
    }

    return 0;
}

trusted func duplicate_close_on_exec(pos descriptor: i32, minimum: i32) -> i32
    uses(foreign_call)
{
    return trusted std.os.darwin.fcntl(descriptor, std.os.darwin.F_DUPFD_CLOEXEC, minimum);
}

trusted func initialize_spawn_actions(pos actions: RawPointer<u8>) -> i32
    uses(foreign_call)
{
    return trusted std.os.darwin.spawn_actions_initialize(
        trusted std.memory.reinterpret<std.os.darwin.PosixSpawnFileActions, u8>(actions)
    );
}

trusted func add_spawn_close(pos actions: RawPointer<u8>, descriptor: i32) -> i32
    uses(foreign_call)
{
    return trusted std.os.darwin.spawn_actions_add_close(
        trusted std.memory.reinterpret<std.os.darwin.PosixSpawnFileActions, u8>(actions),
        descriptor,
    );
}

trusted func add_spawn_duplicate(pos actions: RawPointer<u8>, source: i32, destination: i32) -> i32
    uses(foreign_call)
{
    return trusted std.os.darwin.spawn_actions_add_duplicate(
        trusted std.memory.reinterpret<std.os.darwin.PosixSpawnFileActions, u8>(actions),
        source,
        destination,
    );
}

trusted func add_spawn_working_directory(pos actions: RawPointer<u8>, path: RawPointer<u8>) -> i32
    uses(foreign_call)
{
    return trusted std.os.darwin.spawn_actions_add_chdir(
        trusted std.memory.reinterpret<std.os.darwin.PosixSpawnFileActions, u8>(actions),
        path,
    );
}

trusted func destroy_spawn_actions(pos actions: RawPointer<u8>) -> i32
    uses(foreign_call)
{
    return trusted std.os.darwin.spawn_actions_destroy(
        trusted std.memory.reinterpret<std.os.darwin.PosixSpawnFileActions, u8>(actions)
    );
}

trusted func spawn(
    pos process: RawPointer<i32>,
    pos executable: RawPointer<u8>,
    pos actions: RawPointer<u8>,
    pos arguments: RawPointer<RawPointer<u8>>,
    pos environment: RawPointer<RawPointer<u8>>,
) -> i32
    uses(foreign_call)
{
    return trusted std.os.darwin.posix_spawn(
        process,
        path = executable,
        actions = trusted std.memory.reinterpret<std.os.darwin.PosixSpawnFileActions, u8>(actions),
        attributes = std.memory.null<u8>(),
        arguments = arguments,
        environment = environment,
    );
}

trusted func wait(pos process: i32, pos status: RawPointer<i32>) -> i32
    uses(foreign_call)
{
    return trusted std.os.darwin.wait_pid(process, status, options = 0);
}

trusted func signal(pos process: i32, force: bool) -> i32
    uses(foreign_call)
{
    let requested: i32 = match force
    {
        case true { yield std.os.darwin.SIGKILL; }
        case false { yield std.os.darwin.SIGTERM; }
    };

    return trusted std.os.darwin.kill(process, signal = requested);
}

trusted func pthread_create(
    pos thread: RawPointer<u64>,
    pos attributes: RawPointer<PThreadAttribute>,
    pos entry: ThreadStartRoutine,
    pos context: RawPointer<u8>,
) -> i32
    uses(foreign_call, intrinsic)
{
    let entry_pointer: RawPointer<ThreadStartRoutine> = trusted std.memory.pointer_from_callable(entry);

    let native_pointer: RawPointer<std.os.darwin.ThreadStartRoutine> = trusted std.memory.reinterpret<
        std.os.darwin.ThreadStartRoutine,
        ThreadStartRoutine
    >(entry_pointer);

    let native_entry: std.os.darwin.ThreadStartRoutine = trusted std.memory.callable_from_pointer(native_pointer);

    let mut native_thread: RawPointer<u8> = std.memory.null<u8>();

    let status: i32 = trusted std.os.darwin.pthread_create(
        std.memory.address_of_mut<RawPointer<u8>>(&mut native_thread),
        attributes = trusted std.memory.reinterpret<std.os.darwin.PThreadAttribute, PThreadAttribute>(attributes),
        entry = native_entry,
        context = context,
    );

    if status == 0
    {
        trusted std.memory.write<u64>(thread, trusted core.target.expose_address<u8>(native_thread) as u64);
    }

    return status;
}

trusted func pthread_detach(pos thread: u64) -> i32
    uses(foreign_call, intrinsic)
{
    let native_thread: RawPointer<u8> = trusted core.target.from_exposed_address<u8>(address = thread as usize);

    return trusted std.os.darwin.pthread_detach(native_thread);
}

trusted func pthread_join(pos thread: u64, pos result: RawPointer<RawPointer<u8>>) -> i32
    uses(foreign_call, intrinsic)
{
    let native_thread: RawPointer<u8> = trusted core.target.from_exposed_address<u8>(address = thread as usize);

    return trusted std.os.darwin.pthread_join(native_thread, result);
}

trusted func pthread_self() -> u64
    uses(foreign_call, intrinsic)
{
    return trusted core.target.expose_address<u8>(trusted std.os.darwin.pthread_self()) as u64;
}

trusted func pthread_key_create(pos key: RawPointer<u64>, pos destructor: ThreadStorageDestructor) -> i32
    uses(foreign_call)
{
    let destructor_pointer: RawPointer<ThreadStorageDestructor> = trusted std.memory.pointer_from_callable(destructor);

    let native_pointer: RawPointer<std.os.darwin.ThreadStorageDestructor> = trusted std.memory.reinterpret<
        std.os.darwin.ThreadStorageDestructor,
        ThreadStorageDestructor
    >(destructor_pointer);

    let native_destructor: std.os.darwin.ThreadStorageDestructor = trusted std.memory.callable_from_pointer(
        native_pointer,
    );

    return trusted std.os.darwin.pthread_key_create(key, destructor = native_destructor);
}

trusted func pthread_key_delete(pos key: u64) -> i32
    uses(foreign_call)
{
    return trusted std.os.darwin.pthread_key_delete(key);
}

trusted func pthread_getspecific(pos key: u64) -> RawPointer<u8>
    uses(foreign_call)
{
    return trusted std.os.darwin.pthread_getspecific(key);
}

trusted func pthread_setspecific(pos key: u64, pos value: RawPointer<u8>) -> i32
    uses(foreign_call)
{
    return trusted std.os.darwin.pthread_setspecific(key, value);
}
