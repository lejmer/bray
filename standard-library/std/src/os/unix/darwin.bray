    uses(foreign_call)
{
    return trusted std.os.darwin.open(path, flags, mode);
}

trusted func open_directory(pos path: RawPointer<u8>) -> RawPointer<u8>
    uses(foreign_call)
{
    return trusted std.os.darwin.open_directory(path);
