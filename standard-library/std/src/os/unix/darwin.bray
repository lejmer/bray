    pos address: RawPointer<u8>,
    pos length: usize,
    pos protection: i32,
    pos flags: i32,
    pos descriptor: i32,
    pos offset: i64,
) -> RawPointer<u8>
    uses(foreign_call)
{
    return trusted std.os.darwin.mmap(address, length, protection, flags, descriptor, offset);
}

