// Dependencies: blocking_execution, foreign_call, native_thread.
@link(name = "Kernel32", kind = system)
@symbol(name = "WaitForSingleObject")
@abi(system)
extern trusted func wait_for_single_object(pos handle: RawPointer<u8>, pos milliseconds: u32) -> u32
    uses(foreign_call);

// Error state: returns zero and records GetLastError state.
// Dependencies: foreign_call, raw_memory.
@link(name = "Kernel32", kind = system)
@symbol(name = "WaitOnAddress")
@abi(system)
extern trusted func wait_on_address(
    pos address: RawPointer<u8>,
    pos expected: RawPointer<u8>,
    pos size: usize,
    pos timeout: u32
) -> i32
    uses(foreign_call);

// Dependencies: foreign_call, raw_memory.
@link(name = "Kernel32", kind = system)
@symbol(name = "WakeByAddressSingle")
@abi(system)
extern trusted func wake_by_address_single(pos address: RawPointer<u8>) -> unit
    uses(foreign_call);

// Error state: returns zero and records GetLastError state.
// Initialization: success initializes transferred.
// Dependencies: foreign_call, raw_memory.
@link(name = "Kernel32", kind = system)
@symbol(name = "WriteFile")
@abi(system)
extern trusted func write_file(
    pos handle: RawPointer<u8>,
    pos source: RawPointer<u8>,
    pos length: u32,
    pos transferred: RawPointer<u32>,
    pos overlapped: RawPointer<u8>
) -> i32
    uses(foreign_call);

// Dynamic code symbol `GetTickCount64` comes from `kernel32.dll`.
// Ownership contract: the returned owner retains Kernel32.
// Dependencies: blocking_execution, foreign_call, layout_reinterpret.
trusted func dynamic_get_tick_count(
    pos library: &std.dynamic.DynamicLibrary
) -> Result<std.dynamic.DynamicSymbol<TickCountRoutine>, std.ffi.ForeignError>
    requires(blocking_execution())
    uses(foreign_call, layout_reinterpret)
{
    let name: [u8; 14] = [71, 101, 116, 84, 105, 99, 107, 67, 111, 117, 110, 116, 54, 52];

    return trusted std.dynamic.symbol<TickCountRoutine>(library, &name[..]);
}
