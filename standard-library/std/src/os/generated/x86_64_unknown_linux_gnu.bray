// Initialization: the selected system call defines output initialization.
// Dependencies: foreign_call.
@link(name = "c", kind = system)
@symbol(name = "syscall")
@abi(c)
extern trusted func syscall(pos number: isize, ...) -> isize
    uses(foreign_call);

// Error state: returns minus one and sets the C runtime error state.
// Ownership: success removes one filesystem name.
// Initialization: path points to a terminated native string.
// Dependencies: blocking_execution, foreign_call, raw_memory.
@link(name = "c", kind = system)
@symbol(name = "unlink")
@abi(c)
extern trusted func unlink(pos path: RawPointer<u8>) -> i32
    uses(foreign_call);

// Error state: returns minus one and sets the C runtime error state.
// Ownership: success reaps a terminal child process.
// Initialization: success initializes one native wait status.
// Dependencies: blocking_execution, foreign_call, raw_memory.
@link(name = "c", kind = system)
@symbol(name = "waitpid")
@abi(c)
extern trusted func wait_pid(pos process: i32, pos status: RawPointer<i32>, pos options: i32) -> i32
    uses(foreign_call);

// Error state: returns minus one and sets the C runtime error state.
// Ownership: the caller retains descriptor and source ownership.
// Initialization: no output storage.
// Dependencies: blocking_execution, foreign_call, raw_memory.
@link(name = "c", kind = system)
@symbol(name = "write")
@abi(c)
extern trusted func write(pos descriptor: i32, pos source: RawPointer<u8>, pos length: usize) -> isize
    uses(foreign_call);

// Ownership: the C runtime owns the pointer table.
// Dependencies: foreign_call, raw_memory.
@link(name = "c", kind = system)
@symbol(name = "environ")
extern trusted static mut ENVIRON: RawPointer<RawPointer<u8>>;

// Dynamic code symbol `clock_gettime` comes from `libc.so.6`.
// Ownership contract: the returned owner retains the loaded C runtime.
// Dependencies: blocking_execution, foreign_call, layout_reinterpret.
trusted func dynamic_clock_gettime(
    pos library: &std.dynamic.DynamicLibrary
) -> Result<std.dynamic.DynamicSymbol<ClockGetTime>, std.ffi.ForeignError>
    requires(blocking_execution())
    uses(foreign_call, layout_reinterpret)
{
    let name: [u8; 13] = [99, 108, 111, 99, 107, 95, 103, 101, 116, 116, 105, 109, 101];

    return trusted library.symbol<ClockGetTime>(&name[..]);
}

// Dynamic data symbol `environ` comes from `libc.so.6`.
// Ownership contract: the returned owner retains the loaded C runtime.
// Dependencies: blocking_execution, foreign_call, layout_reinterpret, raw_memory.
trusted func dynamic_environ(
    pos library: &std.dynamic.DynamicLibrary
) -> Result<std.dynamic.DynamicSymbol<RawPointer<RawPointer<u8>>>, std.ffi.ForeignError>
    requires(blocking_execution())
    uses(foreign_call, layout_reinterpret)
{
    let name: [u8; 7] = [101, 110, 118, 105, 114, 111, 110];

    return trusted library.symbol<RawPointer<RawPointer<u8>>>(&name[..]);
}
