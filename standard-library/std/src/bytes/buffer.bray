module std.bytes;

using std.memory;

struct Buffer
{
    internal mut storage: std.memory.RawBuffer<u8>;

    trusted internal construct empty() -> Result<Self, std.memory.MemoryLayoutError>
    {
        return trusted Buffer.with_capacity(0);
    }

    trusted internal construct with_capacity(pos capacity: usize) -> Result<Self, std.memory.MemoryLayoutError>
    {
        let storage: std.memory.RawBuffer<u8> = try trusted std.memory.RawBuffer<u8>(capacity = capacity);

        let buffer: Buffer =
        {
            storage = storage,
        };

        return Ok(buffer);
    }

    trusted internal construct from_slice(pos bytes: &[u8]) -> Result<Self, std.memory.MemoryLayoutError>
    {
        let byte_count: usize = internal std.memory.slice_length<u8>(bytes);

        if byte_count == 0
        {
            return Buffer.empty();
        }

        let mut buffer: Buffer = try Buffer.with_capacity(byte_count);
        let destination: RawPointer<u8> = buffer.storage.pointer;

        trusted internal std.memory.byte_buffer_copy(
            source = internal std.memory.byte_slice_pointer(bytes),
            destination = destination,
            count = byte_count,
        );

        trusted std.memory.set_initialized_count<u8>(buffer = &mut buffer.storage, count = byte_count);

        return Ok(buffer);
    }

    /// Creates an empty buffer, reserves a capacity, or copies a byte slice.
    overload new =
    {
        empty,
        with_capacity,
        from_slice,
    }

    func as_slice() -> &[u8]
    {
        return trusted std.memory.initialized_slice<u8>(&self.storage);
    }

    mut func as_slice_mut() -> &mut [u8]
    {
        return trusted std.memory.initialized_slice_mut<u8>(&mut self.storage);
    }
}

func length(pos buffer: &Buffer) -> usize
{
    return std.memory.initialized_count<u8>(&buffer.storage);
}

func capacity(pos buffer: &Buffer) -> usize
{
    return std.memory.capacity<u8>(&buffer.storage);
}

func slice_length(pos bytes: &[u8]) -> usize
{
    return internal std.memory.slice_length<u8>(bytes);
}

func equals(pos left: &[u8], pos right: &[u8]) -> bool
{
    let count: usize = slice_length(left);

    if count != slice_length(right)
    {
        return false;
    }

    let mut index: usize = 0;

    while index < count
    {
        let left_byte: u8 = left[index];
        let right_byte: u8 = right[index];

        if left_byte != right_byte
        {
            return false;
        }

        index += 1;
    }

    return true;
}

trusted func reserve(pos buffer: &mut Buffer, additional: usize) -> Result<unit, std.memory.MemoryLayoutError>
{
    return trusted internal std.memory.reserve_raw_buffer<u8>(
        buffer = &mut buffer.storage,
        additional = additional,
        growth = internal std.memory.CapacityGrowth.Amortized,
    );
}

trusted func reserve_exact(pos buffer: &mut Buffer, additional: usize) -> Result<unit, std.memory.MemoryLayoutError>
{
    return trusted internal std.memory.reserve_raw_buffer<u8>(
        buffer = &mut buffer.storage,
        additional = additional,
        growth = internal std.memory.CapacityGrowth.Exact,
    );
}

trusted func resize(
    pos buffer: &mut Buffer,
    new_length: usize,
    fill: u8 = 0,
) -> Result<unit, std.memory.MemoryLayoutError>
{
    let current_length: usize = buffer.storage.initialized;

    if new_length <= current_length
    {
        truncate(new_length = new_length, buffer = buffer);

        return Ok(unit);
    }

    let additional: usize = new_length - current_length;

    try reserve(additional = additional, buffer = &mut buffer);

    let pointer: RawPointer<u8> = trusted std.memory.spare_pointer<u8>(&mut buffer.storage);

    trusted internal std.memory.byte_buffer_fill(
        destination = pointer,
        value = fill,
        count = new_length - current_length,
    );

    trusted std.memory.set_initialized_count<u8>(buffer = &mut buffer.storage, count = new_length);

    return Ok(unit);
}

trusted func truncate(pos buffer: &mut Buffer, new_length: usize) -> unit
{
    let current_length: usize = buffer.storage.initialized;

    if new_length < current_length
    {
        trusted std.memory.set_initialized_count<u8>(buffer = &mut buffer.storage, count = new_length);
    }
}

func clear(pos buffer: &mut Buffer) -> unit
{
    truncate(new_length = 0, buffer = buffer);
}

trusted func push(pos buffer: &mut Buffer, value: u8) -> Result<unit, std.memory.MemoryLayoutError>
{
    let current_length: usize = buffer.storage.initialized;

    if current_length == buffer.storage.capacity
    {
        try trusted internal std.memory.grow_byte_buffer(&mut buffer.storage);
    }

    trusted internal initialize_spare_byte(buffer = buffer, value = value);

    return Ok(unit);
}

trusted internal func initialize_spare_byte(pos buffer: &mut Buffer, value: u8) -> unit
{
    let current_length: usize = buffer.storage.initialized;
    let pointer: RawPointer<u8> = trusted std.memory.spare_pointer<u8>(&mut buffer.storage);

    trusted internal std.memory.byte_buffer_fill(destination = pointer, value = value, count = 1);
    trusted std.memory.set_initialized_count<u8>(buffer = &mut buffer.storage, count = current_length + 1);
}

trusted internal func append_slice(
    pos buffer: &mut Buffer,
    pos bytes: &[u8],
) -> Result<unit, std.memory.MemoryLayoutError>
{
    let byte_count: usize = internal std.memory.slice_length<u8>(bytes);

    if byte_count == 0
    {
        return Ok(unit);
    }

    try reserve(additional = byte_count, buffer = &mut buffer);

    let current_length: usize = buffer.storage.initialized;
    let destination: RawPointer<u8> = trusted std.memory.spare_pointer<u8>(&mut buffer.storage);

    trusted internal std.memory.byte_buffer_copy(
        source = internal std.memory.byte_slice_pointer(bytes),
        destination = destination,
        count = byte_count,
    );

    trusted std.memory.set_initialized_count<u8>(buffer = &mut buffer.storage, count = current_length + byte_count);

    return Ok(unit);
}

trusted internal func append_repeated(
    pos buffer: &mut Buffer,
    pos value: u8,
    pos count: usize,
) -> Result<unit, std.memory.MemoryLayoutError>
{
    if count == 0
    {
        return Ok(unit);
    }

    try reserve(additional = count, buffer = &mut buffer);

    let current_length: usize = buffer.storage.initialized;
    let destination: RawPointer<u8> = trusted std.memory.spare_pointer<u8>(&mut buffer.storage);

    trusted internal std.memory.byte_buffer_fill(destination = destination, value = value, count = count);
    trusted std.memory.set_initialized_count<u8>(buffer = &mut buffer.storage, count = current_length + count);

    return Ok(unit);
}

/// Appends a byte slice or one repeated byte to a buffer.
overload append =
{
    append_slice,
    append_repeated,
}

trusted func pop(pos buffer: &mut Buffer) -> u8?
{
    let current_length: usize = buffer.storage.initialized;

    if current_length == 0
    {
        return none;
    }

    let new_length: usize = current_length - 1;
    let value: u8 = trusted internal std.memory.byte_buffer_read(buffer.storage.pointer, index = new_length);

    truncate(new_length = new_length, buffer = buffer);

    let mut result: u8? = none;

    result = value;

    return result;
}
