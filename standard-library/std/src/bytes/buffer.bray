module std.bytes;

using std.memory;

struct Buffer
{
    internal mut storage: std.memory.RawBuffer<u8>;

    /// Creates an empty byte buffer with an optional reserved capacity.
    trusted construct(capacity: usize = 0) -> Result<Self, std.memory.MemoryLayoutError>
    {
        let storage: std.memory.RawBuffer<u8> = try trusted std.memory.RawBuffer<u8>(capacity = capacity);

        let buffer: Buffer =
        {
            storage = storage,
        };

        return Ok(buffer);
    }

    /// Copies a byte slice into an owned buffer.
    trusted construct from_slice(pos bytes: &[u8]) -> Result<Self, std.memory.MemoryLayoutError>
    {
        let byte_count: usize = bytes.length();

        if byte_count == 0
        {
            return Buffer();
        }

        let mut buffer: Buffer = try Buffer(capacity = byte_count);

        let initialized: usize = trusted internal std.memory.copy_spare_bytes(
            &mut buffer.storage,
            bytes,
            count = byte_count,
        );

        trusted std.memory.set_initialized_count<u8>(buffer = &mut buffer.storage, count = initialized);

        return Ok(buffer);
    }

    func as_slice() -> &[u8]
        executes(pure, total)
    {
        return trusted std.memory.initialized_slice<u8>(&self.storage);
    }

    mut func as_slice_mut() -> &mut [u8]
        executes(pure, total)
    {
        return trusted std.memory.initialized_slice_mut<u8>(&mut self.storage);
    }
}

func length(pos buffer: &Buffer) -> usize
{
    return std.memory.initialized_count<u8>(&buffer.storage);
}

func capacity(pos buffer: &Buffer) -> usize
{
    return std.memory.capacity<u8>(&buffer.storage);
}

func equals(pos left: &[u8], pos right: &[u8]) -> bool
{
    let count: usize = left.length();

    if count != right.length()
    {
        return false;
    }

    let mut index: usize = 0;

    while index < count
    {
        let left_byte: u8 = left[index];
        let right_byte: u8 = right[index];

        if left_byte != right_byte
        {
            return false;
        }

        index += 1;
    }

    return true;
}

trusted func reserve(pos buffer: &mut Buffer, additional: usize) -> Result<unit, std.memory.MemoryLayoutError>
{
    return trusted internal std.memory.reserve_raw_buffer<u8>(
        buffer = &mut buffer.storage,
        additional = additional,
        growth = internal std.memory.CapacityGrowth.Amortized,
    );
}

trusted func reserve_exact(pos buffer: &mut Buffer, additional: usize) -> Result<unit, std.memory.MemoryLayoutError>
{
    return trusted internal std.memory.reserve_raw_buffer<u8>(
        buffer = &mut buffer.storage,
        additional = additional,
        growth = internal std.memory.CapacityGrowth.Exact,
    );
}

trusted func resize(
    pos buffer: &mut Buffer,
    new_length: usize,
    fill: u8 = 0,
) -> Result<unit, std.memory.MemoryLayoutError>
{
    let current_length: usize = buffer.storage.initialized;

    if new_length <= current_length
    {
        truncate(new_length = new_length, buffer = buffer);

        return Ok(unit);
    }

    let additional: usize = new_length - current_length;

    try reserve(additional = additional, buffer = &mut buffer);

    let initialized: usize = trusted internal std.memory.fill_spare_bytes(
        &mut buffer.storage,
        value = fill,
        count = new_length - current_length,
    );

    trusted std.memory.set_initialized_count<u8>(buffer = &mut buffer.storage, count = initialized);

    return Ok(unit);
}

trusted func truncate(pos buffer: &mut Buffer, new_length: usize) -> unit
{
    let current_length: usize = std.memory.initialized_count<u8>(&buffer.storage);

    if new_length < current_length
    {
        trusted std.memory.set_initialized_count<u8>(buffer = &mut buffer.storage, count = new_length);
    }
}

func clear(pos buffer: &mut Buffer) -> unit
{
    truncate(new_length = 0, buffer = buffer);
}

trusted func push(pos buffer: &mut Buffer, value: u8) -> Result<unit, std.memory.MemoryLayoutError>
{
    let current_length: usize = buffer.storage.initialized;

    if current_length == buffer.storage.capacity
    {
        try trusted internal std.memory.grow_byte_buffer(&mut buffer.storage);
    }

    trusted internal initialize_spare_byte(buffer = buffer, value = value);

    return Ok(unit);
}

trusted internal func initialize_spare_byte(pos buffer: &mut Buffer, value: u8) -> unit
{
    trusted internal std.memory.initialize_spare<u8>(&mut buffer.storage, value);
}

trusted internal func append_slice(
    pos buffer: &mut Buffer,
    pos bytes: &[u8],
) -> Result<unit, std.memory.MemoryLayoutError>
{
    let byte_count: usize = bytes.length();

    if byte_count == 0
    {
        return Ok(unit);
    }

    try reserve(additional = byte_count, buffer = &mut buffer);

    let initialized: usize = trusted internal std.memory.copy_spare_bytes(
        &mut buffer.storage,
        bytes,
        count = byte_count,
    );

    trusted std.memory.set_initialized_count<u8>(buffer = &mut buffer.storage, count = initialized);

    return Ok(unit);
}

trusted internal func append_repeated(
    pos buffer: &mut Buffer,
    pos value: u8,
    pos count: usize,
) -> Result<unit, std.memory.MemoryLayoutError>
{
    if count == 0
    {
        return Ok(unit);
    }

    try reserve(additional = count, buffer = &mut buffer);

    let initialized: usize = trusted internal std.memory.fill_spare_bytes(
        &mut buffer.storage,
        value = value,
        count = count,
    );

    trusted std.memory.set_initialized_count<u8>(buffer = &mut buffer.storage, count = initialized);

    return Ok(unit);
}

/// Appends a byte slice or one repeated byte to a buffer.
overload append =
{
    append_slice,
    append_repeated,
}

trusted func pop(pos buffer: &mut Buffer) -> u8?
{
    let current_length: usize = buffer.storage.initialized;

    if current_length == 0
    {
        return none;
    }

    let value: u8 = trusted std.memory.take_last<u8>(&mut buffer.storage);

    let mut result: u8? = none;

    result = value;

    return result;
}
