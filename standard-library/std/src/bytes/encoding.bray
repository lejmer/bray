module std.bytes;

/// Encodes one unsigned 64-bit value in little-endian byte order.
func u64_little_endian(pos value: u64) -> [u8; 8]
{
    let mut bytes: [u8; 8] = [0; 8];
    let mut index: usize = 0;

    while index < 8
    {
        bytes[index] = std.truncate_to<u8>(value >> (index as u64 * 8));
        index += 1;
    }

    return bytes;
}
