module std.string;

union Utf8Error
{
    InvalidEncoding;
}

impl string
{
    func length() -> usize
    {
        return internal scalar_count(&self);
    }

    func is_empty() -> bool
    {
        return internal empty(&self);
    }

    func get(index: usize) -> char?
    {
        return internal scalar_at(&self, index = index);
    }

    func slice(start: usize, end: usize) -> string
    {
        return internal scalar_slice(&self, start = start, end = end);
    }

    func characters() -> ScalarCursor
    {
        return ScalarCursor
        {
            value = &self,
            count = self.length(),
        };
    }

    func as_bytes() -> &[u8]
    {
        return internal utf8(&self);
    }

    static func from_utf8(pos bytes: &[u8]) -> Result<string, Utf8Error>
    {
        return internal decode_utf8(bytes);
    }
}

impl StringEquatable = string(Equatable<string>)
{
    func equals(pos rhs: &string) -> bool
    {
        return internal equal(&self, rhs);
    }
}

extern internal func scalar_count(pos value: &string) -> usize;

extern internal func empty(pos value: &string) -> bool;

extern internal func equal(pos left: &string, pos right: &string) -> bool;

extern internal func scalar_at(pos value: &string, index: usize) -> char?;

extern internal func scalar_slice(pos value: &string, start: usize, end: usize) -> string;

extern internal func utf8(pos value: &string) -> &[u8];

extern internal func decode_utf8(pos bytes: &[u8]) -> Result<string, Utf8Error>;

struct ScalarCursor
{
    value: &string;
    mut index: usize = 0;
    count: usize;
}

impl ScalarCursorIterator = ScalarCursor(Iterator)
{
    type Element = char;

    mut func next() -> char?
    {
        let index: usize = self.index;
        let count: usize = self.count;

        if index >= count
        {
            let exhausted: char? = none;

            return exhausted;
        }

        let next_index: usize = index + 1;

        self.index = next_index;

        let scalar: char? = self.value.get(index = index);

        return scalar;
    }
}
