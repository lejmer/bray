module std.numeric;

func checked_add_u8(pos left: u8, pos right: u8) -> u8?
{
    if right > U8_MAX - left
    {
        return none;
    }

    return present_u8(left + right);
}

func checked_subtract_u8(pos left: u8, pos right: u8) -> u8?
{
    if right > left
    {
        return none;
    }

    return present_u8(left - right);
}

func checked_multiply_u8(pos left: u8, pos right: u8) -> u8?
{
    if left != 0
    {
        if right > U8_MAX / left
        {
            return none;
        }
    }

    return present_u8(left * right);
}

func checked_divide_u8(pos left: u8, pos right: u8) -> u8?
{
    if right == 0
    {
        return none;
    }

    return present_u8(left / right);
}

