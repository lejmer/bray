module std.numeric;

internal func present_u8(pos value: u8) -> u8?
{
    let mut result: u8? = none;

    result = value;

    return result;
}

internal func present_u16(pos value: u16) -> u16?
{
    let mut result: u16? = none;

    result = value;

    return result;
}

