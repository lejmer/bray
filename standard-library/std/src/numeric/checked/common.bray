    return result;
}

internal func present_u128(pos value: u128) -> u128?
{
    let mut result: u128? = none;

    result = value;

    return result;
}

internal func present_usize(pos value: usize) -> usize?
{
    let mut result: usize? = none;

    result = value;

    return result;
}

