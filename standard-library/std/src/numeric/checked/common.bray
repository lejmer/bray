module std.numeric;

internal trait IntegerBounds
{
    func bounds() -> (Self, Self, Self, Self);
}

internal func present<Value>(pos value: Value) -> Value?
{
    let mut result: Value? = none;

    result = value;

    return result;
}

func checked_add<Value>(pos left: Value, pos right: Value) -> Value?
    with(
        Value: Add<Value>,
        Value(Add<Value>).Output == Value,
        Value: Comparable<Value>,
        Value: Copyable,
        Value: IntegerBounds,
        Value: Subtract<Value>,
        Value(Subtract<Value>).Output == Value,
    )
{
    let bounds: (Value, Value, Value, Value) = right.bounds();
    let zero: Value = bounds.0;

    if right > zero
    {
        let maximum: Value = bounds.3;

        if left > maximum - right
        {
            return none;
        }
    }

    if right < zero
    {
        let minimum: Value = bounds.2;

        if left < minimum - right
        {
            return none;
        }
    }

    return present<Value>(left + right);
}

func checked_subtract<Value>(pos left: Value, pos right: Value) -> Value?
    with(
        Value: Add<Value>,
        Value(Add<Value>).Output == Value,
        Value: Comparable<Value>,
        Value: Copyable,
        Value: IntegerBounds,
        Value: Subtract<Value>,
        Value(Subtract<Value>).Output == Value,
    )
{
    let bounds: (Value, Value, Value, Value) = right.bounds();
    let zero: Value = bounds.0;

    if right < zero
    {
        let maximum: Value = bounds.3;

        if left > maximum + right
        {
            return none;
        }
    }

    if right > zero
    {
        let minimum: Value = bounds.2;

        if left < minimum + right
        {
            return none;
        }
    }

    return present<Value>(left - right);
}

func checked_multiply<Value>(pos left: Value, pos right: Value) -> Value?
    with(
        Value: Comparable<Value>,
        Value: Copyable,
        Value: Divide<Value>,
        Value(Divide<Value>).Output == Value,
        Value: IntegerBounds,
        Value: Multiply<Value>,
        Value(Multiply<Value>).Output == Value,
    )
{
    let bounds: (Value, Value, Value, Value) = right.bounds();
    let zero: Value = bounds.0;

    if left > zero
    {
        if right > zero
        {
            let maximum: Value = bounds.3;

            if left > maximum / right
            {
                return none;
            }
        }

        if right < zero
        {
            let minimum: Value = bounds.2;

            if right < minimum / left
            {
                return none;
            }
        }
    }

    if left < zero
    {
        if right > zero
        {
            let minimum: Value = bounds.2;

            if left < minimum / right
            {
                return none;
            }
        }

        if right < zero
        {
            let maximum: Value = bounds.3;

            if left < maximum / right
            {
                return none;
            }
        }
    }

    return present<Value>(left * right);
}

func checked_divide<Value>(pos left: Value, pos right: Value) -> Value?
    with(
        Value: Copyable,
        Value: Divide<Value>,
        Value(Divide<Value>).Output == Value,
        Value: Equatable<Value>,
        Value: IntegerBounds,
    )
{
    let bounds: (Value, Value, Value, Value) = right.bounds();
    let zero: Value = bounds.0;

    if right == zero
    {
        return none;
    }

    let negative_one: Value = bounds.1;
    let minimum: Value = bounds.2;

    if left == minimum && right == negative_one
    {
        return none;
    }

    return present<Value>(left / right);
}
