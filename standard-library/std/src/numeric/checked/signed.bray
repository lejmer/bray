module std.numeric;

func checked_add_i8(pos left: i8, pos right: i8) -> i8?
{
    if right > 0
    {
        if left > I8_MAX - right
        {
            return none;
        }
    }

    if right < 0
    {
        if left < I8_MIN - right
        {
            return none;
        }
    }

    return present_i8(left + right);
}

func checked_subtract_i8(pos left: i8, pos right: i8) -> i8?
{
    if right < 0
    {
        if left > I8_MAX + right
        {
            return none;
        }
    }

    if right > 0
    {
        if left < I8_MIN + right
        {
            return none;
        }
    }

    return present_i8(left - right);
}

func checked_divide_i8(pos left: i8, pos right: i8) -> i8?
{
    if right == 0
    {
        return none;
    }
    if left == I8_MIN
    {
        if right == -1
        {
            return none;
        }
    }

    return present_i8(left / right);
}

