func checked_add_isize(pos left: isize, pos right: isize) -> isize?
{
    let minimum: isize = isize_minimum();
    let maximum: isize = isize_maximum();

    if right > 0
    {
        if left > maximum - right
        {
            return none;
        }
    }

    if right < 0
    {
        if left < minimum - right
        {
            return none;
        }
    }

    return present_isize(left + right);
}

func checked_subtract_isize(pos left: isize, pos right: isize) -> isize?
{
    let minimum: isize = isize_minimum();
    let maximum: isize = isize_maximum();

    if right < 0
    {
        if left > maximum + right
        {
            return none;
        }
    }

    if right > 0
    {
        if left < minimum + right
        {
            return none;
        }
    }

    return present_isize(left - right);
}

func checked_divide_isize(pos left: isize, pos right: isize) -> isize?
{
    let minimum: isize = isize_minimum();

    if right == 0
    {
        return none;
    }
    if left == minimum
    {
        if right == -1
        {
            return none;
        }
    }

    return present_isize(left / right);
}
