module std.numeric;

const U8_MIN: u8 = 0;

const U8_MAX: u8 = 255;

const U16_MIN: u16 = 0;

const U16_MAX: u16 = 65535;

const U32_MIN: u32 = 0;

const U32_MAX: u32 = 4294967295;

const U64_MIN: u64 = 0;

const U64_MAX: u64 = 18446744073709551615;

const U128_MIN: u128 = 0;

const U128_MAX: u128 = 340282366920938463463374607431768211455;

const I8_MIN: i8 = -127 - 1;

const I8_MAX: i8 = 127;

const I16_MIN: i16 = -32767 - 1;

const I16_MAX: i16 = 32767;

const I32_MIN: i32 = -2147483647 - 1;

const I32_MAX: i32 = 2147483647;

const I64_MIN: i64 = -9223372036854775807 - 1;

const I64_MAX: i64 = 9223372036854775807;

const I128_MIN: i128 = -170141183460469231731687303715884105727 - 1;

const I128_MAX: i128 = 170141183460469231731687303715884105727;

const USIZE_MIN: usize = 0;

const func usize_maximum() -> usize
{
    let mut remaining_bits: usize = std.memory.size_of<usize>() * 8;
    let mut maximum: usize = 0;

    while remaining_bits > 0
    {
        maximum = maximum * 2 + 1;
        remaining_bits = remaining_bits - 1;
    }

    return maximum;
}

const func isize_minimum() -> isize
{
    return -isize_maximum() - 1;
}

const func isize_maximum() -> isize
{
    let mut remaining_bits: usize = std.memory.size_of<isize>() * 8 - 1;
    let mut maximum: isize = 0;

    while remaining_bits > 0
    {
        maximum = maximum * 2 + 1;
        remaining_bits = remaining_bits - 1;
    }

    return maximum;
}
