module std.numeric;

impl U8Integer = u8(Integer)
{
    func bounds() -> IntegerBounds<u8>
    {
        return
        {
            zero = 0,
            negative_one = 0,
            minimum = U8_MIN,
            maximum = U8_MAX
        };
    }
}

impl U16Integer = u16(Integer)
{
    func bounds() -> IntegerBounds<u16>
    {
        return
        {
            zero = 0,
            negative_one = 0,
            minimum = U16_MIN,
            maximum = U16_MAX
        };
    }
}

