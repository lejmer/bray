module std.numeric;

/// Names the arithmetic identities and range selected by an integer implementation.
struct IntegerBounds<Value>
{
    zero: Value;
    negative_one: Value;
    minimum: Value;
    maximum: Value;
}

trait Integer
{
    func bounds() -> IntegerBounds<Self>;

    func checked_add(pos right: Self) -> Self?
        with(
            Self: Add<Self>,
            Self(Add<Self>).Output == Self,
            Self: Comparable<Self>,
            Self: Copyable,
            Self: Subtract<Self>,
            Self(Subtract<Self>).Output == Self,
        )
    {
        let bounds: IntegerBounds<Self> = self.bounds();
        let zero: Self = bounds.zero;

        if right > zero
        {
            let maximum: Self = bounds.maximum;

            if self > maximum - right
            {
                return none;
            }
        }

        if right < zero
        {
            let minimum: Self = bounds.minimum;

            if self < minimum - right
            {
                return none;
            }
        }

        return present<Self>(self + right);
    }

    func checked_subtract(pos right: Self) -> Self?
        with(
            Self: Add<Self>,
            Self(Add<Self>).Output == Self,
            Self: Comparable<Self>,
            Self: Copyable,
            Self: Subtract<Self>,
            Self(Subtract<Self>).Output == Self,
        )
    {
        let bounds: IntegerBounds<Self> = self.bounds();
        let zero: Self = bounds.zero;

        if right < zero
        {
            let maximum: Self = bounds.maximum;

            if self > maximum + right
            {
                return none;
            }
        }

        if right > zero
        {
            let minimum: Self = bounds.minimum;

            if self < minimum + right
            {
                return none;
            }
        }

        return present<Self>(self - right);
    }

    func checked_multiply(pos right: Self) -> Self?
        with(
            Self: Comparable<Self>,
            Self: Copyable,
            Self: Divide<Self>,
            Self(Divide<Self>).Output == Self,
            Self: Multiply<Self>,
            Self(Multiply<Self>).Output == Self,
        )
    {
        let bounds: IntegerBounds<Self> = self.bounds();
        let zero: Self = bounds.zero;

        if self > zero
        {
            if right > zero
            {
                let maximum: Self = bounds.maximum;

                if self > maximum / right
                {
                    return none;
                }
            }

            if right < zero
            {
                let minimum: Self = bounds.minimum;

                if right < minimum / self
                {
                    return none;
                }
            }
        }

        if self < zero
        {
            if right > zero
            {
                let minimum: Self = bounds.minimum;

                if self < minimum / right
                {
                    return none;
                }
            }

            if right < zero
            {
                let maximum: Self = bounds.maximum;

                if self < maximum / right
                {
                    return none;
                }
            }
        }

        return present<Self>(self * right);
    }

    func checked_divide(pos right: Self) -> Self?
        with(Self: Copyable, Self: Divide<Self>, Self(Divide<Self>).Output == Self, Self: Equatable<Self>)
    {
        let bounds: IntegerBounds<Self> = self.bounds();
        let zero: Self = bounds.zero;

        if right == zero
        {
            return none;
        }

        let negative_one: Self = bounds.negative_one;
        let minimum: Self = bounds.minimum;

        if self == minimum && right == negative_one
        {
            return none;
        }

        return present<Self>(self / right);
    }
}

internal func present<Value>(pos value: Value) -> Value?
{
    let mut result: Value? = none;

    result = value;

    return result;
}

/// Supplies the bit representation used by checked integer conversions.
trait IntegerBits
{
    func to_bits() -> u128;
}

/// Decodes integer bits into a selected target representation.
trait IntegerFromBits<Target>
{
    func into_integer() -> Target;
}

impl U8IntegerBits = u8(IntegerBits)
{
    func to_bits() -> u128
    {
        return std.truncate_to<u128>(self);
    }
}

impl U8IntegerFromBits = u128(IntegerFromBits<u8>)
{
    func into_integer() -> u8
    {
        return std.truncate_to<u8>(self);
    }
}

impl U16IntegerBits = u16(IntegerBits)
{
    func to_bits() -> u128
    {
        return std.truncate_to<u128>(self);
    }
}

impl U16IntegerFromBits = u128(IntegerFromBits<u16>)
{
    func into_integer() -> u16
    {
        return std.truncate_to<u16>(self);
    }
}

impl U32IntegerBits = u32(IntegerBits)
{
