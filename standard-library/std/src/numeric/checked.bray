    {
        return std.truncate_to<usize>(self);
    }
}

impl I8IntegerBits = i8(IntegerBits)
{
    func to_bits() -> u128
    {
        return std.truncate_to<u128>(self);
    }
}

impl I8IntegerFromBits = u128(IntegerFromBits<i8>)
{
