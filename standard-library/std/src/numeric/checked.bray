overload u128(IntegerFromBits) =
{
    U8IntegerFromBits,
    U16IntegerFromBits,
    U32IntegerFromBits,
    U64IntegerFromBits,
    U128IntegerFromBits,
    UsizeIntegerFromBits,
    I8IntegerFromBits,
    I16IntegerFromBits,
    I32IntegerFromBits,
    I64IntegerFromBits,
    I128IntegerFromBits,
    IsizeIntegerFromBits,
}

/// Converts between integer representations, reporting `OutOfRange` when the value does not fit.
impl IntegerCheckedConversion = Source(CheckedConvertTo<Target>)
    with(
        Source: Integer,
        Source: IntegerBits,
        Source: Comparable<Source>,
        Source: Copyable,
        Source: Equatable<Source>,
        Target: Integer,
        Target: IntegerBits,
        Target: Comparable<Target>,
        Target: Copyable,
        u128: IntegerFromBits<Target>,
    )
{
    type Error = ConversionError;

    consume func convert_checked() -> Result<Target, ConversionError>
    {
        let bits: u128 = self(IntegerBits).to_bits();
        let converted: Target = bits(IntegerFromBits<Target>).into_integer();
        let source_negative: bool = self < self.bounds().zero;
        let target_negative: bool = converted < converted.bounds().zero;

        if source_negative != target_negative || converted(IntegerBits).to_bits() != bits
        {
            return Error(ConversionError.OutOfRange);
        }

        return Ok(converted);
    }
}
