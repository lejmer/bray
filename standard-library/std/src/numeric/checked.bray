}

impl U128IntegerBits = u128(IntegerBits)
{
    func to_bits() -> u128
    {
        return std.truncate_to<u128>(self);
    }
}

impl U128IntegerFromBits = u128(IntegerFromBits<u128>)
{
    func into_integer() -> u128
    {
