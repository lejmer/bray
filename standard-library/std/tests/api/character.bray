module bray.standard_library_tests.character;

using std.bytes;
using std.character;
using std.testing;

@test
func character_operations()
{
    let value: char = 'é';
    let scalar: u32 = value.code_point();
    let encoding: std.character.Utf8Encoding = value.encode_utf8();
    let encoded: &[u8] = encoding.as_slice();
    let alphabetic: bool = value.is_alphabetic();
    let numeric: bool = value.is_numeric();
    let whitespace: bool = value.is_whitespace();

    assert(scalar == 233);
    assert(encoded.length() == 2);
    assert(encoded[0] == 195);
    assert(encoded[1] == 169);
    assert(alphabetic);
    assert(!numeric);
    assert(!whitespace);

    let decoded: char? = char.from_code_point(scalar);

    let character: char = std.testing.assert_present<char>(decoded);

    assert(character == value);
}

@test
func character_boundaries()
{
    let ascii: char = 'A';
    let supplementary: char = '😀';
    let ascii_encoding: std.character.Utf8Encoding = ascii.encode_utf8();
    let supplementary_encoding: std.character.Utf8Encoding = supplementary.encode_utf8();
    let ascii_bytes: &[u8] = ascii_encoding.as_slice();
    let supplementary_bytes: &[u8] = supplementary_encoding.as_slice();
    let ascii_expected: bytes = b"A";
    let supplementary_expected: bytes = b"😀";

    assert(ascii_bytes.length() == 1);
    assert(std.bytes.equals(ascii_bytes, &ascii_expected[..]));
    assert(supplementary_bytes.length() == 4);
    assert(std.bytes.equals(supplementary_bytes, &supplementary_expected[..]));
    assert('7'.is_numeric());
    assert('٧'.is_numeric());
    assert('界'.is_alphabetic());
    assert(' '.is_whitespace());
    assert(' '.is_whitespace());

    let invalid: char? = char.from_code_point(1114112);

    std.testing.assert_absent<char>(invalid);
}

@test
func unicode_classification_properties()
{
    assert('A'.is_alphabetic());
    assert('z'.is_alphabetic());
    assert('\u{345}'.is_alphabetic());
    assert('\u{10400}'.is_alphabetic());
    assert('\u{11db0}'.is_alphabetic());
    assert('\u{31350}'.is_alphabetic());
    assert(!'@'.is_alphabetic());
    assert(!'['.is_alphabetic());
    assert(!'\u{344}'.is_alphabetic());
    assert(!'\u{10ffff}'.is_alphabetic());

    assert('0'.is_numeric());
    assert('9'.is_numeric());
    assert('²'.is_numeric());
    assert('⅓'.is_numeric());
    assert('四'.is_numeric());
    assert('\u{1d7ce}'.is_numeric());
    assert('\u{11de0}'.is_numeric());
    assert(!'/'.is_numeric());
    assert(!':'.is_numeric());
    assert(!'A'.is_numeric());

    assert('\u{9}'.is_whitespace());
    assert('\u{d}'.is_whitespace());
    assert('\u{85}'.is_whitespace());
    assert('\u{a0}'.is_whitespace());
    assert('\u{200a}'.is_whitespace());
    assert('\u{3000}'.is_whitespace());
    assert(!'\u{8}'.is_whitespace());
    assert(!'\u{e}'.is_whitespace());
    assert(!'\u{200b}'.is_whitespace());
    assert(!'\u{feff}'.is_whitespace());
}

@test
func scalar_conversion_rejects_surrogates_and_out_of_range_values()
{
    std.testing.assert_absent<char>(char.from_code_point(0xd800));
    std.testing.assert_absent<char>(char.from_code_point(0xdfff));
    std.testing.assert_absent<char>(char.from_code_point(0x110000));
    std.testing.assert_absent<char>(char.from_code_point(0xffffffff));

    let before: char = std.testing.assert_present<char>(char.from_code_point(0xd7ff));
    let after: char = std.testing.assert_present<char>(char.from_code_point(0xe000));
    let last: char = std.testing.assert_present<char>(char.from_code_point(0x10ffff));

    assert(before.code_point() == 0xd7ff);
    assert(after.code_point() == 0xe000);
    assert(last.code_point() == 0x10ffff);
    assert(!last.is_alphabetic() && !last.is_numeric() && !last.is_whitespace());
}
