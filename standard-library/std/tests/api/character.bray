module bray.standard_library_tests.character;

using std.bytes;
using std.character;
using std.testing;

@test
func character_operations()
{
    let value: char = 'é';
    let scalar: u32 = value.code_point();
    let encoding: std.character.Utf8Encoding = value.encode_utf8();
    let encoded: &[u8] = encoding.as_slice();
    let alphabetic: bool = value.is_alphabetic();
    let numeric: bool = value.is_numeric();
    let whitespace: bool = value.is_whitespace();

    assert(scalar == 233);
    assert(encoded.length() == 2);
    assert(encoded[0] == 195);
    assert(encoded[1] == 169);
    assert(alphabetic);
    assert(!numeric);
    assert(!whitespace);

    let decoded: char? = char.from_code_point(scalar);

    let character: char = std.testing.assert_present<char>(decoded);

    assert(character == value);
}

@test
func character_boundaries()
{
    let ascii: char = 'A';
    let supplementary: char = '😀';
    let ascii_encoding: std.character.Utf8Encoding = ascii.encode_utf8();
    let supplementary_encoding: std.character.Utf8Encoding = supplementary.encode_utf8();
    let ascii_bytes: &[u8] = ascii_encoding.as_slice();
    let supplementary_bytes: &[u8] = supplementary_encoding.as_slice();
    let ascii_expected: bytes = b"A";
    let supplementary_expected: bytes = b"😀";

    assert(ascii_bytes.length() == 1);
    assert(std.bytes.equals(ascii_bytes, &ascii_expected[..]));
    assert(supplementary_bytes.length() == 4);
    assert(std.bytes.equals(supplementary_bytes, &supplementary_expected[..]));
    assert('7'.is_numeric());
    assert('٧'.is_numeric());
    assert('界'.is_alphabetic());
    assert(' '.is_whitespace());
    assert(' '.is_whitespace());

    let invalid: char? = char.from_code_point(1114112);

    std.testing.assert_absent<char>(invalid);
}
