@target(target.scalar.R128 && target.scalar.C256)
module bray.standard_library_tests.format_real128;

using std.bytes;
using std.format;
using std.format.C256Format;
using std.format.FixedSinkFormatting;
using std.format.R128Format;
using std.string;
using std.testing;

@test
trusted func optional_real_and_complex_formatting_use_the_canonical_sink()
{
    let value: r128 = 1.5;
    let complex_part_real: r128 = 1.5;
    let complex_part_imaginary: r128 = -2.25;
    let complex: c256 = (complex_part_real, complex_part_imaginary) as c256;
    let mut storage: bytes<64> = [0; 64];
    let mut sink: std.format.FixedSink = std.format.FixedSink(&mut storage[..]);

    std.testing.assert_ok<unit, std.format.FixedSinkError>(
        trusted std.format.write_to<r128, std.format.FixedSink, std.format.FixedSinkError>(
            &mut sink,
            std.format.Argument<r128>(&value, options = std.format.Options(precision = 2))
        )
    );

    std.testing.assert_ok<unit, std.format.FixedSinkError>(
        trusted std.format.write_to<c256, std.format.FixedSink, std.format.FixedSinkError>(
            &mut sink,
            std.format.Argument<c256>(&complex)
        )
    );

    let length: usize = std.format.finish_fixed(sink);

    assert(std.bytes.equals(&storage[0..length], "1.501.5-2.25i".as_bytes()));
}
