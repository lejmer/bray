module bray.standard_library_tests.channel;

using std.channel;
using std.task;
using std.testing;

static CHANNEL_CLEANUP_COUNT: core.atomic.Atomic<u32> = core.atomic.initialize<u32>(0);

internal struct ChannelCleanupProbe
{
    value: u32;

    finalize()
    {
        let _: u32 = core.atomic.fetch_add<u32, 3>(&CHANNEL_CLEANUP_COUNT, 1);
    }

    destruct() {}
}

internal async func completed_value() -> i32
{
    return 13;
}

internal async func send_sequence(pos mut sender: std.channel.Sender<i32>, pos first: i32, pos count: i32)
{
    let mut offset: i32 = 0;

    while offset < count
    {
        std.testing.assert_ok<unit, std.channel.SendError<i32>>(await sender.send(first + offset));

        offset += 1;
        await std.task.yield_now();
    }

    sender.close();
}

@test
async func independently_started_computation_completes()
{
    let computation: Task<i32> = internal completed_value().start();
    let value: i32 = try await computation.join();

    assert(value == 13);
}

@test
async func buffered_send_completes_before_receiving()
{
    let (mut sender, mut receiver) = std.testing.assert_ok<
        (std.channel.Sender<i32>, std.channel.Receiver<i32>),
        std.channel.ChannelError
    >(std.channel.bounded<i32>(capacity = 1));

    let send: Task<Result<unit, std.channel.SendError<i32>>> = sender.send(13).start();

    std.testing.assert_ok<unit, std.channel.SendError<i32>>(try await send.join());

    match receiver.try_receive()
    {
        case Received(value) { assert(value == 13); }
        case Empty { assert(false); }
        case Closed { assert(false); }
    }

    sender.close();
    receiver.close();
}

@test
async func buffered_channel_transfers_messages_in_commit_order()
{
    let (mut sender, mut receiver) = std.testing.assert_ok<
        (std.channel.Sender<i32>, std.channel.Receiver<i32>),
        std.channel.ChannelError
    >(std.channel.bounded<i32>(capacity = 2));

    std.testing.assert_ok<unit, std.channel.SendError<i32>>(await sender.send(11));
    std.testing.assert_ok<unit, std.channel.SendError<i32>>(await sender.send(29));

    match await receiver.receive()
    {
        case Received(value) { assert(value == 11); }
        case Closed { assert(false); }
    }

    match await receiver.receive()
    {
        case Received(value) { assert(value == 29); }
        case Closed { assert(false); }
    }

    sender.close();
    receiver.close();
}

@test
async func rendezvous_send_suspends_until_a_receiver_is_registered()
{
    let (mut sender, mut receiver) = std.testing.assert_ok<
        (std.channel.Sender<i32>, std.channel.Receiver<i32>),
        std.channel.ChannelError
    >(std.channel.bounded<i32>(capacity = 0));

    let send: Task<Result<unit, std.channel.SendError<i32>>> = sender.send(41).start();

    match await receiver.receive()
    {
        case Received(value) { assert(value == 41); }
        case Closed { assert(false); }
    }

    std.testing.assert_ok<unit, std.channel.SendError<i32>>(try await send.join());

    sender.close();
    receiver.close();
}

@test
async func cancelling_a_rendezvous_wait_withdraws_it_before_reuse()
{
    let (mut sender, mut receiver) = std.testing.assert_ok<
        (std.channel.Sender<i32>, std.channel.Receiver<i32>),
        std.channel.ChannelError
    >(std.channel.bounded<i32>(capacity = 0));

    let blocked: Task<Result<unit, std.channel.SendError<i32>>> = sender.send(17).start();

    std.testing.assert_cancelled<Result<unit, std.channel.SendError<i32>>>(await blocked.cancel());

    let next: Task<Result<unit, std.channel.SendError<i32>>> = sender.send(23).start();

    match await receiver.receive()
    {
        case Received(value) { assert(value == 23); }
        case Closed { assert(false); }
    }

    std.testing.assert_ok<unit, std.channel.SendError<i32>>(try await next.join());

    sender.close();
    receiver.close();
}

@test
async func cancelling_a_registered_receiver_preserves_a_committed_rendezvous_value()
{
    let (mut sender, mut receiver) = std.testing.assert_ok<
        (std.channel.Sender<i32>, std.channel.Receiver<i32>),
        std.channel.ChannelError
    >(std.channel.bounded<i32>(capacity = 0));

    let waiting: Task<std.channel.ReceiveResult<i32>> = receiver.receive().start();
    let mut pending: i32 = 31;
    let mut committed: bool = false;

    while !committed
    {
        match sender.try_send(pending)
        {
            case Ok(_) { committed = true; }
            case Error(error)
            {
                match consume error
                {
                    case Full(value) { pending = value; }
                    case Closed(_) { assert(false); }
                }
            }
        }

        if !committed
        {
            await std.task.yield_now();
        }
    }

    match await waiting.cancel()
    {
        case Completed(result)
        {
            match result
            {
                case Received(value) { assert(value == 31); }
                case Closed { assert(false); }
            }
        }
        case Cancelled
        {
            match await receiver.receive()
            {
                case Received(value) { assert(value == 31); }
                case Closed { assert(false); }
            }
        }
        case Panicked(_) { assert(false); }
    }

    sender.close();
    receiver.close();
}

@test
async func concurrency_stress_contended_producers_preserve_each_senders_commit_order()
{
    let (mut sender, mut receiver) = std.testing.assert_ok<
        (std.channel.Sender<i32>, std.channel.Receiver<i32>),
        std.channel.ChannelError
    >(std.channel.bounded<i32>(capacity = 4));

    let first_sender: std.channel.Sender<i32> = sender.duplicate();
    let second_sender: std.channel.Sender<i32> = sender.duplicate();
    let first: Task<unit> = send_sequence(first_sender, first = 0, count = 64).start();
    let second: Task<unit> = send_sequence(second_sender, first = 1_000, count = 64).start();
    let mut first_expected: i32 = 0;
    let mut second_expected: i32 = 1_000;
    let mut received: i32 = 0;

    while received < 128
    {
        match await receiver.receive()
        {
            case Received(value)
            {
                if value < 1_000
                {
                    assert(value == first_expected);
                    first_expected += 1;
                }
                else
                {
                    assert(value == second_expected);
                    second_expected += 1;
                }

                received += 1;
            }
            case Closed { assert(false); }
        }
    }

    try await first.join();
    try await second.join();

    assert(first_expected == 64);
    assert(second_expected == 1_064);

    sender.close();
    receiver.close();
}

@test
func endpoint_closure_preserves_unsent_values_and_terminal_receives()
{
    let (mut sender, mut receiver) = std.testing.assert_ok<
        (std.channel.Sender<i32>, std.channel.Receiver<i32>),
        std.channel.ChannelError
    >(std.channel.bounded<i32>(capacity = 1));

    let mut duplicate: std.channel.Sender<i32> = sender.duplicate();

    sender.close();
    receiver.close();

    match consume std.testing.assert_error<unit, std.channel.TrySendError<i32>>(duplicate.try_send(73))
    {
        case Closed(value) { assert(value == 73); }
        case Full(_) { assert(false); }
    }

    duplicate.close();
}

@test
func concurrency_model_receiver_close_resolves_buffered_messages()
{
    core.atomic.store<u32, 4>(&CHANNEL_CLEANUP_COUNT, 0);

    let (mut sender, mut receiver) = std.testing.assert_ok<
        (std.channel.Sender<ChannelCleanupProbe>, std.channel.Receiver<ChannelCleanupProbe>),
        std.channel.ChannelError
    >(std.channel.bounded<ChannelCleanupProbe>(capacity = 2));

    std.testing.assert_ok<unit, std.channel.TrySendError<ChannelCleanupProbe>>(
        sender.try_send(
            ChannelCleanupProbe
            {
                value = 1,
            }
        )
    );

    std.testing.assert_ok<unit, std.channel.TrySendError<ChannelCleanupProbe>>(
        sender.try_send(
            ChannelCleanupProbe
            {
                value = 2,
            }
        )
    );

    receiver.close();

    assert(core.atomic.load<u32, 1>(&CHANNEL_CLEANUP_COUNT) == 2);

    sender.close();
}

@test
func concurrency_model_channel_capacity_overflow_is_recoverable()
{
    let impossible_capacity: usize = ~0;

    match std.testing.assert_error<(std.channel.Sender<u64>, std.channel.Receiver<u64>), std.channel.ChannelError>(
        std.channel.bounded<u64>(capacity = impossible_capacity)
    )
    {
        case CapacityOverflow {}
    }
}
