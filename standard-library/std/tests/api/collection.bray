trusted module bray.standard_library_tests.collection;

using std.bytes;
using std.collection;
using std.collection.DequeElementIndex;
using std.collection.DequeMoveCursorIterator;
using std.collection.DequeMoveIterable;
using std.collection.DequeReadCursorIterator;
using std.collection.DequeReadIterable;
using std.collection.DequeWriteCursorIterator;
using std.collection.DequeWriteIterable;
using std.collection.HashMapMoveCursorIterator;
using std.collection.HashMapMoveIterable;
using std.collection.HashMapReadCursorIterator;
using std.collection.HashMapReadIterable;
using std.collection.HashMapWriteCursorIterator;
using std.collection.HashMapWriteIterable;
using std.collection.HashSetMoveCursorIterator;
using std.collection.HashSetMoveIterable;
using std.collection.HashSetReadCursorIterator;
using std.collection.HashSetReadIterable;
using std.collection.ListElementIndex;
using std.collection.ListMoveIterable;
using std.collection.ListReadIterable;
using std.collection.ListSliceIndex;
using std.collection.ListWriteIterable;
using std.collection.MoveCursorIterator;
using std.collection.QueueDequeAdapter;
using std.collection.ReadCursorIterator;
using std.collection.StackDequeAdapter;
using std.collection.WriteCursorIterator;
using std.iteration;
using std.iteration.EnumerateIterator;
using std.iteration.IteratorDefaultOperations;
using std.iteration.SkipIterator;
using std.iteration.TakeIterator;
using std.hash;
using std.hash.StableHasherSink;
using std.hash.U64Hashable;
using std.memory;
using std.testing;

struct OwnedValue
{
    bytes: std.bytes.Buffer;
}

struct CollisionKey
{
    value: u64;
}

struct OwnedHashValue
{
    identity: u64;
    bytes: std.bytes.Buffer;
}

impl CollisionKeyEquatable = CollisionKey(Equatable<CollisionKey>)
{
    func equals(pos rhs: &CollisionKey) -> bool
    {
        return self.value == rhs.value;
    }
}

impl CollisionKeyHashable = CollisionKey(std.hash.Hashable<Sink>)
    with(Sink: std.hash.HashSink)
{
    func contribute(pos sink: &mut Sink) -> unit
    {
        sink.write(0);
    }
}

impl OwnedHashValueEquatable = OwnedHashValue(Equatable<OwnedHashValue>)
{
    func equals(pos rhs: &OwnedHashValue) -> bool
    {
        return self.identity == rhs.identity;
    }
}

impl OwnedHashValueHashable = OwnedHashValue(std.hash.Hashable<Sink>)
    with(Sink: std.hash.HashSink)
{
    func contribute(pos sink: &mut Sink) -> unit
    {
        sink.write(self.identity as u128);
    }
}

func owned_hash_value(pos identity: u64, pos byte: u8) -> Result<OwnedHashValue, std.memory.MemoryLayoutError>
{
    let bytes: [u8; 1] = [byte];

    return Ok(
        {
            identity = identity,
            bytes = try std.bytes.Buffer.from_slice(&bytes[..]),
        }
    );
}

@test
trusted func list_operations() -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut values: std.collection.List<i32> = try trusted std.collection.List<i32>();

    try trusted std.collection.push<i32>(&mut values, 10);
    try trusted std.collection.push<i32>(&mut values, 30);

    let inserted: bool = try trusted std.collection.insert<i32>(&mut values, 20, index = 1);
    let items: &[i32] = values.as_slice();

    assert(inserted);
    assert(std.collection.length<i32>(&values) == 3);
    assert(items[0] == 10);
    assert(items[1] == 20);
    assert(items[2] == 30);

    let removed: i32? = trusted std.collection.remove<i32>(&mut values, index = 1);
    let removed_value: i32 = std.testing.assert_present<i32>(removed);

    assert(removed_value == 20);
    assert(std.collection.length<i32>(&values) == 2);

    let final: i32? = trusted std.collection.pop<i32>(&mut values);
    let final_value: i32 = std.testing.assert_present<i32>(final);

    assert(final_value == 30);
    assert(std.collection.length<i32>(&values) == 1);

    return Ok(unit);
}

@test
trusted func list_capacity_and_iteration() -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut values: std.collection.List<i32> = try trusted std.collection.List<i32>();

    try trusted std.collection.reserve_exact<i32>(&mut values, additional = 3);

    assert(std.collection.capacity<i32>(&values) == 3);

    try trusted std.collection.push<i32>(&mut values, 4);
    try trusted std.collection.push<i32>(&mut values, 5);
    try trusted std.collection.push<i32>(&mut values, 6);
    try trusted std.collection.push<i32>(&mut values, 7);

    assert(std.collection.capacity<i32>(&values) == 4);

    let cursor: std.collection.MoveCursor<i32> = values(Iterable).iterate();
    let mut taken: std.iteration.Take<std.collection.MoveCursor<i32>, i32> = cursor.take(count = 2);
    let second: i32? = taken.nth(index = 1);
    let second_value: i32 = std.testing.assert_present<i32>(second);

    assert(second_value == 5);

    return Ok(unit);
}

@test
trusted func iterator_adapters_preserve_order() -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut values: std.collection.List<i32> = try trusted std.collection.List<i32>();

    try trusted std.collection.push<i32>(&mut values, 4);
    try trusted std.collection.push<i32>(&mut values, 5);
    try trusted std.collection.push<i32>(&mut values, 6);

    let cursor: std.collection.MoveCursor<i32> = values(Iterable).iterate();
    let skipped: std.iteration.Skip<std.collection.MoveCursor<i32>, i32> = cursor.skip(count = 1);

    let mut enumerated: std.iteration.Enumerate<std.iteration.Skip<std.collection.MoveCursor<i32>, i32>, i32> =
        skipped.enumerate();

    let item: (usize, i32)? = enumerated.first();
    let value: (usize, i32) = std.testing.assert_present<(usize, i32)>(item);

    assert(value.0 == 0);
    assert(value.1 == 5);

    return Ok(unit);
}

@test
trusted func list_mutation_edges() -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut values: std.collection.List<i32> = try trusted std.collection.List<i32>();

    assert(std.collection.is_empty<i32>(&values));

    let inserted: bool = try trusted std.collection.insert<i32>(&mut values, 1, index = 1);

    assert(!inserted);

    try trusted std.collection.push<i32>(&mut values, 1);
    try trusted std.collection.push<i32>(&mut values, 2);
    try trusted std.collection.push<i32>(&mut values, 3);

    std.collection.reverse<i32>(&mut values);

    {
        let items: &mut [i32] = values.as_slice_mut();

        items[1] = 8;
    }

    let items: &[i32] = values.as_slice();

    assert(items[0] == 3);
    assert(items[1] == 8);
    assert(items[2] == 1);

    trusted std.collection.truncate<i32>(&mut values, new_length = 2);

    assert(std.collection.length<i32>(&values) == 2);

    trusted std.collection.clear<i32>(&mut values);

    assert(std.collection.is_empty<i32>(&values));

    let missing: i32? = trusted std.collection.remove<i32>(&mut values, index = 0);

    std.testing.assert_absent<i32>(missing);

    return Ok(unit);
}

@test
trusted func borrowed_list_iteration_preserves_access() -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut values: std.collection.List<i32> = try trusted std.collection.List<i32>();

    try trusted std.collection.push<i32>(&mut values, 4);
    try trusted std.collection.push<i32>(&mut values, 5);

    let index: usize = 1;
    let selected: &i32 = &values[index];
    let suffix: &[i32] = &values[index..];

    assert(selected == 5);
    assert(suffix[0] == 5);

    {
        let source: &std.collection.List<i32> = &values;
        let mut cursor: std.collection.ReadCursor<i32> = source(Iterable).iterate();
        let item: (&i32)? = cursor.first();
        let value: &i32 = std.testing.assert_present(item);

        assert(value == 4);
    }

    {
        let source: &mut std.collection.List<i32> = &mut values;
        let mut cursor: std.collection.WriteCursor<i32> = source(Iterable).iterate();
        let item: (&mut i32)? = cursor(Iterator).next();
        let value: &mut i32 = std.testing.assert_present(item);

        value = 9;
    }

    let items: &[i32] = values.as_slice();

    assert(items[0] == 9);
    assert(items[1] == 5);

    return Ok(unit);
}

@test
trusted func iterator_boundaries() -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut values: std.collection.List<i32> = try trusted std.collection.List<i32>();

    try trusted std.collection.push<i32>(&mut values, 1);
    try trusted std.collection.push<i32>(&mut values, 2);

    let zero_cursor: std.collection.MoveCursor<i32> = values(Iterable).iterate();
    let mut zero: std.iteration.Take<std.collection.MoveCursor<i32>, i32> = zero_cursor.take(count = 0);
    let missing: i32? = zero.first();

    std.testing.assert_absent<i32>(missing);

    let mut skipped_values: std.collection.List<i32> = try trusted std.collection.List<i32>();

    try trusted std.collection.push<i32>(&mut skipped_values, 3);

    let skip_cursor: std.collection.MoveCursor<i32> = skipped_values(Iterable).iterate();
    let mut skipped: std.iteration.Skip<std.collection.MoveCursor<i32>, i32> = skip_cursor.skip(count = 2);
    let exhausted: i32? = skipped.first();

    std.testing.assert_absent<i32>(exhausted);

    return Ok(unit);
}

@test
trusted func list_growth_relocates_only_initialized_owned_values() -> Result<unit, std.memory.MemoryLayoutError>
{
    let first_bytes: [u8; 1] = [11];
    let second_bytes: [u8; 1] = [22];

    let first: OwnedValue =
    {
        bytes = try std.bytes.Buffer.from_slice(&first_bytes[..]),
    };

    let second: OwnedValue =
    {
        bytes = try std.bytes.Buffer.from_slice(&second_bytes[..]),
    };

    let mut values: std.collection.List<OwnedValue> = try trusted std.collection.List<OwnedValue>(capacity = 4);

    try trusted std.collection.push<OwnedValue>(&mut values, first);
    try trusted std.collection.push<OwnedValue>(&mut values, second);
    try trusted std.collection.reserve<OwnedValue>(&mut values, additional = 3);

    assert(std.collection.length<OwnedValue>(&values) == 2);
    assert(std.collection.capacity<OwnedValue>(&values) == 8);

    try trusted std.collection.reserve_exact<OwnedValue>(&mut values, additional = 1);

    assert(std.collection.capacity<OwnedValue>(&values) == 8);

    let stored: &[OwnedValue] = values.as_slice();

    assert(stored[0].bytes.as_slice()[0] == 11);
    assert(stored[1].bytes.as_slice()[0] == 22);

    let removed: OwnedValue? = trusted std.collection.pop<OwnedValue>(&mut values);

    let value: OwnedValue = std.testing.assert_present<OwnedValue>(removed);

    assert(value.bytes.as_slice()[0] == 22);

    return Ok(unit);
}

@test
trusted func list_growth_preserves_zero_sized_values() -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut empty: std.collection.List<unit> = try trusted std.collection.List<unit>();

    try trusted std.collection.push<unit>(&mut empty, unit);
    try trusted std.collection.push<unit>(&mut empty, unit);
    try trusted std.collection.push<unit>(&mut empty, unit);
    try trusted std.collection.push<unit>(&mut empty, unit);
    try trusted std.collection.push<unit>(&mut empty, unit);

    assert(std.collection.length<unit>(&empty) == 5);
    assert(std.collection.capacity<unit>(&empty) == 8);

    return Ok(unit);
}

@test
trusted func deque_wraparound_growth_and_end_access() -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut values: std.collection.Deque<i32> = try trusted std.collection.Deque<i32>(capacity = 4);

    try trusted values.push_back(1);
    try trusted values.push_back(2);
    try trusted values.push_back(3);
    try trusted values.push_back(4);

    let first: i32 = std.testing.assert_present<i32>(trusted values.pop_front());
    let second: i32 = std.testing.assert_present<i32>(trusted values.pop_front());

    assert(first == 1);
    assert(second == 2);

    try trusted values.push_back(5);
    try trusted values.push_back(6);
    try trusted values.push_front(0);

    let first_index: usize = 0;
    let second_index: usize = 1;
    let third_index: usize = 2;
    let fourth_index: usize = 3;
    let fifth_index: usize = 4;

    assert(values.length() == 5);
    assert(values.capacity() == 8);

    {
        assert(values[first_index] == 0);
        assert(values[second_index] == 3);
        assert(values[third_index] == 4);
        assert(values[fourth_index] == 5);
        assert(values[fifth_index] == 6);
    }

    let mutable_front: &mut i32 = std.testing.assert_present(values.front_mut());

    mutable_front = 10;

    let mutable_back: &mut i32 = std.testing.assert_present(values.back_mut());

    mutable_back = 60;

    let observed_front: &i32 = std.testing.assert_present(values.front());
    let observed_back: &i32 = std.testing.assert_present(values.back());

    assert(observed_front == 10);
    assert(observed_back == 60);

    try trusted values.shrink_to_fit();

    assert(values.capacity() == 5);

    {
        assert(values[first_index] == 10);
        assert(values[fifth_index] == 60);
    }

    trusted values.clear();

    assert(values.is_empty());

    return Ok(unit);
}

@test
trusted func deque_iteration_preserves_wrapped_logical_order() -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut values: std.collection.Deque<i32> = try trusted std.collection.Deque<i32>(capacity = 4);

    try trusted values.push_back(1);
    try trusted values.push_back(2);
    try trusted values.push_back(3);
    try trusted values.push_back(4);

    let _: i32? = trusted values.pop_front();
    let _: i32? = trusted values.pop_front();

    try trusted values.push_back(5);
    try trusted values.push_back(6);

    {
        let source: &std.collection.Deque<i32> = &values;
        let mut cursor: std.collection.DequeReadCursor<i32> = source(Iterable).iterate();
        let third: (&i32)? = cursor.nth(index = 2);

        let value: &i32 = std.testing.assert_present(third);

        assert(value == 5);
    }

    {
        let source: &mut std.collection.Deque<i32> = &mut values;
        let mut cursor: std.collection.DequeWriteCursor<i32> = source(Iterable).iterate();
        let first: (&mut i32)? = cursor(Iterator).next();

        let value: &mut i32 = std.testing.assert_present(first);

        value = 30;
    }

    let mut cursor: std.collection.DequeMoveCursor<i32> = values(Iterable).iterate();
    let second: i32? = cursor.nth(index = 1);

    let value: i32 = std.testing.assert_present<i32>(second);

    assert(value == 4);

    return Ok(unit);
}

@test
trusted func deque_owned_zero_sized_and_overflow_edges() -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut exact: std.collection.Deque<i32> = try trusted std.collection.Deque<i32>();

    try trusted exact.reserve_exact(additional = 3);

    assert(exact.capacity() == 3);

    try trusted exact.shrink_to_fit();

    assert(exact.capacity() == 0);

    std.testing.assert_absent(exact.front());
    std.testing.assert_absent(exact.back());
    std.testing.assert_absent<i32>(trusted exact.pop_front());
    std.testing.assert_absent<i32>(trusted exact.pop_back());

    let first_bytes: [u8; 1] = [31];
    let second_bytes: [u8; 1] = [47];
    let mut owned: std.collection.Deque<OwnedValue> = try trusted std.collection.Deque<OwnedValue>(capacity = 1);

    try trusted owned.push_front(
        {
            bytes = try std.bytes.Buffer.from_slice(&first_bytes[..]),
        }
    );

    try trusted owned.push_back(
        {
            bytes = try std.bytes.Buffer.from_slice(&second_bytes[..]),
        }
    );

    let first: OwnedValue = std.testing.assert_present<OwnedValue>(trusted owned.pop_front());
    let second: OwnedValue = std.testing.assert_present<OwnedValue>(trusted owned.pop_back());

    assert(first.bytes.as_slice()[0] == 31);
    assert(second.bytes.as_slice()[0] == 47);

    let mut empty: std.collection.Deque<unit> = try trusted std.collection.Deque<unit>();

    try trusted empty.push_front(unit);
    try trusted empty.push_back(unit);
    try trusted empty.push_front(unit);
    try trusted empty.push_back(unit);
    try trusted empty.push_front(unit);

    assert(empty.length() == 5);
    assert(empty.capacity() == 8);

    let _: std.memory.MemoryLayoutError = std.testing.assert_error<
        std.collection.Deque<u64>,
        std.memory.MemoryLayoutError
    >(trusted std.collection.Deque<u64>(capacity = ~0));

    let mut overflow: std.collection.Deque<u64> = try trusted std.collection.Deque<u64>();

    let _: std.memory.MemoryLayoutError = std.testing.assert_error<unit, std.memory.MemoryLayoutError>(
        trusted overflow.reserve(additional = ~0)
    );

    return Ok(unit);
}

@test
trusted func stack_and_queue_are_explicit_deque_adapters() -> Result<unit, std.memory.MemoryLayoutError>
{
    let empty_stack: std.collection.Stack<i32> = try trusted std.collection.Stack<i32>();
    let mut stack: std.collection.Stack<i32> = try trusted std.collection.Stack<i32>(capacity = 4);

    assert(empty_stack.is_empty());
    assert(stack.capacity() == 4);

    try trusted stack.push(1);
    try trusted stack.push(2);

    let mutable_top: &mut i32 = std.testing.assert_present(stack.peek_mut());

    mutable_top = 20;

    let observed_top: &i32 = std.testing.assert_present(stack.peek());

    assert(observed_top == 20);

    let popped_top: i32 = std.testing.assert_present<i32>(trusted stack.pop());

    assert(popped_top == 20);

    let storage: std.collection.Deque<i32> = stack.into_deque();
    let mut queue: std.collection.Queue<i32> = std.collection.Queue<i32>.from_deque(storage);

    try trusted queue.enqueue(3);
    try trusted queue.enqueue(4);

    let first: i32 = std.testing.assert_present<i32>(trusted queue.dequeue());

    assert(first == 1);

    let observed_front: &i32 = std.testing.assert_present(queue.peek());

    assert(observed_front == 3);

    let mutable_front: &mut i32 = std.testing.assert_present(queue.peek_mut());

    mutable_front = 30;

    let remaining: std.collection.Deque<i32> = queue.into_deque();
    let mut cleared: std.collection.Queue<i32> = std.collection.Queue<i32>.from_deque(remaining);
    let reserved: std.collection.Queue<i32> = try trusted std.collection.Queue<i32>(capacity = 2);

    assert(cleared.length() == 2);

    let rewrapped_front: &i32 = std.testing.assert_present(cleared.peek());

    assert(rewrapped_front == 30);

    let dequeued_front: i32 = std.testing.assert_present<i32>(trusted cleared.dequeue());

    assert(dequeued_front == 30);

    let remaining_front: &i32 = std.testing.assert_present(cleared.peek());

    assert(remaining_front == 4);

    trusted cleared.clear();

    assert(cleared.is_empty());
    assert(reserved.capacity() == 2);

    std.testing.assert_absent<i32>(trusted cleared.dequeue());

    return Ok(unit);
}

@test
trusted func hash_map_supports_growth_replacement_and_removal() -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut map: std.collection.HashMap<u64, u64> = try trusted std.collection.HashMap<u64, u64>(capacity = 2);
    let mut key: u64 = 0;

    while key < 128
    {
        let replaced: u64? = try trusted map.insert(key, key * 10);

        std.testing.assert_absent<u64>(replaced);

        key += 1;
    }

    assert(map.length() == 128);
    assert(map.capacity() >= 128);

    let observed: &u64 = std.testing.assert_present(map.get(&42));

    assert(observed == 420);

    let replaced: u64 = std.testing.assert_present(try trusted map.insert(42, 421));

    assert(replaced == 420);
    assert(map.length() == 128);

    let removed: (u64, u64) = std.testing.assert_present(trusted map.remove_entry(&42));

    assert(removed.0 == 42);
    assert(removed.1 == 421);
    assert(!map.contains_key(&42));

    return Ok(unit);
}

@test
trusted func hash_map_preserves_owned_keys_and_values_across_every_teardown_path(
) -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut map: std.collection.HashMap<OwnedHashValue, OwnedHashValue> = try trusted std.collection.HashMap<
        OwnedHashValue,
        OwnedHashValue
    >(capacity = 1);

    let mut identity: u64 = 0;

    while identity < 32
    {
        let key: OwnedHashValue = try owned_hash_value(identity, 1);

        let value: OwnedHashValue = try owned_hash_value(identity + 100, 2);

        let replaced: OwnedHashValue? = try trusted map.insert(key, value);

        std.testing.assert_absent<OwnedHashValue>(replaced);

        identity += 1;
    }

    let replacement_key: OwnedHashValue = try owned_hash_value(7, 207);
    let replacement_value: OwnedHashValue = try owned_hash_value(107, 208);

    let replaced: OwnedHashValue = std.testing.assert_present(
        try trusted map.insert(replacement_key, replacement_value)
    );

    assert(replaced.bytes.as_slice()[0] == 2);

    let lookup: OwnedHashValue = try owned_hash_value(7, 0);
    let removed: (OwnedHashValue, OwnedHashValue) = std.testing.assert_present(trusted map.remove_entry(&lookup));

    assert(removed.0.bytes.as_slice()[0] == 1);
    assert(removed.1.bytes.as_slice()[0] == 208);

    trusted map.clear();

    assert(map.is_empty());

    {
        let mut partially_consumed: std.collection.HashMap<OwnedHashValue, OwnedHashValue> =
            try trusted std.collection.HashMap<OwnedHashValue, OwnedHashValue>(capacity = 1);

        identity = 0;

        while identity < 8
        {
            let key: OwnedHashValue = try owned_hash_value(identity, 1);

            let value: OwnedHashValue = try owned_hash_value(identity + 10, 2);

            let _: OwnedHashValue? = try trusted partially_consumed.insert(key, value);

            identity += 1;
        }

        let mut cursor: std.collection.HashMapMoveCursor<OwnedHashValue, OwnedHashValue> =
            partially_consumed(Iterable).iterate();

        let first: (OwnedHashValue, OwnedHashValue) = std.testing.assert_present(cursor.next());

        assert(first.0.bytes.as_slice().length() == 1);
        assert(first.1.bytes.as_slice().length() == 1);
    }

    return Ok(unit);
}

@test
trusted func hash_map_supports_entry_insertion_and_mutation() -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut map: std.collection.HashMap<u64, u64> = try trusted std.collection.HashMap<u64, u64>();

    let _: u64? = try trusted map.insert(1, 10);
    let _: u64? = try trusted map.insert(2, 20);

    {
        let mut entry: std.collection.Entry<u64, u64> = try trusted map.entry(3);
        let inserted: &mut u64 = trusted entry.or_insert(30);

        inserted += 1;
    }

    {
        let mut entry: std.collection.Entry<u64, u64> = try trusted map.entry(3);
        let existing: &mut u64 = trusted entry.or_insert(0);

        assert(existing == 31);
    }

    return Ok(unit);
}

@test
trusted func hash_map_produces_mutable_iteration_entries() -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut map: std.collection.HashMap<u64, u64> = try trusted std.collection.HashMap<u64, u64>();

    let _: u64? = try trusted map.insert(1, 10);
    let _: u64? = try trusted map.insert(2, 20);

    {
        let source: &mut std.collection.HashMap<u64, u64> = &mut map;
        let mut cursor: std.collection.HashMapWriteCursor<u64, u64> = source(Iterable).iterate();
        let item: std.collection.HashMapReferenceMut<u64, u64>? = cursor.next();
        let mut entry: std.collection.HashMapReferenceMut<u64, u64> = std.testing.assert_present(item);

        assert(entry.key == 1 || entry.key == 2);
        assert(entry.value == 10 || entry.value == 20);

        let value: &mut u64 = entry.value;

        value += 1;
    }

    let first: &u64 = std.testing.assert_present(map.get(&1));
    let second: &u64 = std.testing.assert_present(map.get(&2));

    assert((first == 11 && second == 20) || (first == 10 && second == 21));

    return Ok(unit);
}

@test
trusted func hash_map_supports_shared_and_consuming_iteration() -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut map: std.collection.HashMap<u64, u64> = try trusted std.collection.HashMap<u64, u64>();
    let mut key: u64 = 0;

    while key < 128
    {
        let _: u64? = try trusted map.insert(key, key * 10);

        key += 1;
    }

    let mut visited: usize = 0;

    {
        let source: &std.collection.HashMap<u64, u64> = &map;
        let mut cursor: std.collection.HashMapReadCursor<u64, u64> = source(Iterable).iterate();

        while true
        {
            match cursor.next()
            {
                case ?_ { visited += 1; }
                case none { break; }
            }
        }
    }

    assert(visited == map.length());

    let mut moved: std.collection.HashMapMoveCursor<u64, u64> = map(Iterable).iterate();
    let mut moved_count: usize = 0;

    while true
    {
        match moved.next()
        {
            case ?_ { moved_count += 1; }
            case none { break; }
        }
    }

    assert(moved_count == 128);

    return Ok(unit);
}

@test
trusted func hash_map_backshift_deletion_preserves_collision_clusters() -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut map: std.collection.HashMap<CollisionKey, u64> = try trusted std.collection.HashMap<CollisionKey, u64>();
    let mut value: u64 = 0;

    while value < 64
    {
        let _: u64? = try trusted map.insert(
            {
                value = value,
            },
            value,
        );

        value += 1;
    }

    value = 0;

    while value < 64
    {
        let key: CollisionKey =
        {
            value = value,
        };

        if value % 3 == 0
        {
            let removed: u64 = std.testing.assert_present(trusted map.remove(&key));

            assert(removed == value);
        }

        value += 1;
    }

    value = 0;

    while value < 64
    {
        let key: CollisionKey =
        {
            value = value,
        };

        if value % 3 == 0
        {
            assert(!map.contains_key(&key));
        }
        else
        {
            let retained: &u64 = std.testing.assert_present(map.get(&key));

            assert(retained == value);
        }

        value += 1;
    }

    while value < 128
    {
        let _: u64? = try trusted map.insert(
            {
                value = value,
            },
            value,
        );

        value += 1;
    }

    assert(map.length() == 106);

    return Ok(unit);
}

@test
trusted func hash_set_uses_value_storage_for_replace_take_and_iteration() -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut set: std.collection.HashSet<CollisionKey> = try trusted std.collection.HashSet<CollisionKey>(capacity = 4);
    let mut value: u64 = 0;

    while value < 48
    {
        assert(
            try trusted set.insert(
                {
                    value = value,
                }
            )
        );

        value += 1;
    }

    let replaced: CollisionKey = std.testing.assert_present(
        try trusted set.replace(
            {
                value = 7,
            }
        )
    );

    assert(replaced.value == 7);

    let lookup: CollisionKey =
    {
        value = 17,
    };

    let stored: &CollisionKey = std.testing.assert_present(set.get(&lookup));

    assert(stored.value == 17);

    let taken: CollisionKey = std.testing.assert_present(trusted set.take(&lookup));

    assert(taken.value == 17);
    assert(!set.contains(&lookup));

    let mut visited: usize = 0;

    {
        let source: &std.collection.HashSet<CollisionKey> = &set;
        let mut cursor: std.collection.HashSetReadCursor<CollisionKey> = source(Iterable).iterate();

        while true
        {
            match cursor.next()
            {
                case ?_ { visited += 1; }
                case none { break; }
            }
        }
    }

    assert(visited == 47);

    let mut moved: std.collection.HashSetMoveCursor<CollisionKey> = set(Iterable).iterate();
    let mut moved_count: usize = 0;

    while true
    {
        match moved.next()
        {
            case ?_ { moved_count += 1; }
            case none { break; }
        }
    }

    assert(moved_count == 47);

    return Ok(unit);
}

@test
trusted func hash_set_preserves_owned_values_across_every_teardown_path() -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut set: std.collection.HashSet<OwnedHashValue> = try trusted std.collection.HashSet<OwnedHashValue>(
        capacity = 1
    );

    let mut identity: u64 = 0;

    while identity < 32
    {
        let value: OwnedHashValue = try owned_hash_value(identity, 1);

        assert(try trusted set.insert(value));

        identity += 1;
    }

    let replacement: OwnedHashValue = try owned_hash_value(7, 207);
    let replaced: OwnedHashValue = std.testing.assert_present(try trusted set.replace(replacement));

    assert(replaced.bytes.as_slice()[0] == 1);

    let lookup: OwnedHashValue = try owned_hash_value(7, 0);
    let taken: OwnedHashValue = std.testing.assert_present(trusted set.take(&lookup));

    assert(taken.bytes.as_slice()[0] == 207);

    trusted set.clear();

    assert(set.is_empty());

    {
        let mut partially_consumed: std.collection.HashSet<OwnedHashValue> = try trusted std.collection.HashSet<
            OwnedHashValue
        >(capacity = 1);

        identity = 0;

        while identity < 8
        {
            let value: OwnedHashValue = try owned_hash_value(identity, 1);

            assert(try trusted partially_consumed.insert(value));

            identity += 1;
        }

        let mut cursor: std.collection.HashSetMoveCursor<OwnedHashValue> = partially_consumed(Iterable).iterate();
        let first: OwnedHashValue = std.testing.assert_present(cursor.next());

        assert(first.bytes.as_slice().length() == 1);
    }

    return Ok(unit);
}

@test
trusted func hash_collection_capacity_overflow_is_reported() -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut zero_sized_values: std.collection.HashMap<u64, unit> = try trusted std.collection.HashMap<u64, unit>();
    let _: unit? = try trusted zero_sized_values.insert(1, unit);
    let _: &unit = std.testing.assert_present(zero_sized_values.get(&1));

    let _: std.memory.MemoryLayoutError = std.testing.assert_error<
        std.collection.HashMap<u64, u64>,
        std.memory.MemoryLayoutError
    >(trusted std.collection.HashMap<u64, u64>(capacity = ~0));

    let mut set: std.collection.HashSet<u64> = try trusted std.collection.HashSet<u64>();

    let _: std.memory.MemoryLayoutError = std.testing.assert_error<unit, std.memory.MemoryLayoutError>(
        trusted set.reserve(additional = ~0)
    );

    return Ok(unit);
}
