module bray.standard_library_tests.string_operations;

using std.string;
using std.string.ScalarCursorIterator;
using std.bytes;
using std.iteration;
using std.testing;

@test(serial)
func string_operations()
{
    let value: string = "Aé";
    let count: usize = value.length();

    assert(count == 2);
}

@test
func string_queries_and_slices()
{
    let value: string = "AéZ";
    let same: string = "AéZ";
    let different: string = "AéY";

    assert(!value.is_empty());
    assert("".is_empty());
    assert(value == same);
    assert(value != different);

    let slice: string = value.slice(start = 1, end = 2);
    let empty_slice: string = value.slice(start = 2, end = 2);

    assert(slice == "é");
    assert(empty_slice.is_empty());

    let middle: char? = value.get(index = 1);
    let missing: char? = value.get(index = 3);

    let middle_character: char = std.testing.assert_present<char>(middle);

    assert(middle_character == 'é');

    std.testing.assert_absent<char>(missing);
}

@test
func utf8_conversion_and_scalar_iteration()
{
    let value: string = "Aé";
    let bytes: &[u8] = value.as_bytes();
    let decoded: Result<string, std.string.Utf8Error> = string.from_utf8(bytes);
    let empty_backing: [u8; 1] = [0];
    let empty: Result<string, std.string.Utf8Error> = string.from_utf8(&empty_backing[0..0]);

    assert(bytes.length() == 3);
    assert(bytes[0] == 65);
    assert(bytes[1] == 195);
    assert(bytes[2] == 169);

    let text: string = std.testing.assert_ok<string, std.string.Utf8Error>(decoded);
    let empty_text: string = std.testing.assert_ok<string, std.string.Utf8Error>(empty);

    assert(text == value);
    assert(empty_text.is_empty());

    let invalid: [u8; 1] = [255];
    let rejected: Result<string, std.string.Utf8Error> = string.from_utf8(&invalid[..]);

    match std.testing.assert_error<string, std.string.Utf8Error>(rejected)
    {
        case std.string.Utf8Error.InvalidEncoding {}
    }

    let mut cursor: std.string.ScalarCursor = value.characters();
    let first: char? = cursor(Iterator).next();
    let second: char? = cursor(Iterator).next();
    let exhausted: char? = cursor(Iterator).next();

    let first_character: char = std.testing.assert_present<char>(first);
    let second_character: char = std.testing.assert_present<char>(second);

    assert(first_character == 'A');
    assert(second_character == 'é');

    std.testing.assert_absent<char>(exhausted);
}
