module bray.standard_library_tests.format;

using std.format;
using std.format.BooleanFormat;
using std.format.ByteSinkFormatting;
using std.format.CharacterFormat;
using std.format.CountingSinkFormatting;
using std.format.FixedSinkFormatting;
using std.format.I8Format;
using std.format.I16Format;
using std.format.I128Format;
using std.format.I32Format;
using std.format.I64Format;
using std.format.IsizeFormat;
using std.format.StringFormat;
using std.format.U8Format;
using std.format.U16Format;
using std.format.U128Format;
using std.format.U32Format;
using std.format.U64Format;
using std.format.UsizeFormat;
using std.bytes;
using std.io;
using std.io.WriterFormattingSink;
using std.memory;
using std.string;
using std.testing;

struct DefaultMemberSink
{
    mut length: usize;
    mut writes: usize;
}

impl DefaultMemberSinkFormatting = DefaultMemberSink(std.format.Sink<std.format.CountingSinkError>)
{
    mut func write(pos source: &[u8]) -> Result<unit, std.format.CountingSinkError>
        requires(blocking_execution())
    {
        self.length += source.length();
        self.writes += 1;

        return Ok(unit);
    }
}

@test
trusted func sink_defaults_prepare_and_repeat_through_write()
{
    let mut sink: DefaultMemberSink =
    {
        length = 0,
        writes = 0,
    };

    std.testing.assert_ok<unit, std.format.CountingSinkError>(sink.prepare(additional = 130));
    std.testing.assert_ok<unit, std.format.CountingSinkError>(sink.write_repeated(value = 7, count = 130));

    assert(sink.length == 130);
    assert(sink.writes == 3);
}

trusted func assert_default_integer_format<Value>(
    pos value: &Value,
    pos expected: string
) -> Result<unit, std.memory.MemoryLayoutError>
    with(Value: std.format.Format<std.format.ByteSink, std.memory.MemoryLayoutError>)
    requires(blocking_execution())
{
    let mut sink: std.format.ByteSink = try std.format.ByteSink(capacity = 0);

    try trusted std.format.write<Value>(&mut sink, std.format.Argument<Value>(value));

    assert(std.bytes.equals(std.format.bytes(&sink), expected.as_bytes()));

    return Ok(unit);
}

@test
func formatting_options_are_available()
{
    let options: std.format.Options = std.format.Options();

    assert(options.radix matches std.format.Radix.Decimal);

    assert(options.width == 0);

    std.testing.assert_absent<usize>(options.precision);

    let explicit_zero: std.format.Options = std.format.Options(precision = 0);

    let precision: usize = std.testing.assert_present<usize>(explicit_zero.precision);

    assert(precision == 0);
}

@test
trusted func scalar_formatting_is_deterministic() -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut sink: std.format.ByteSink = try std.format.ByteSink(capacity = 0);
    let integer: i32 = -42;
    let character: char = 'A';

    try trusted std.format.write<i32>(&mut sink, std.format.Argument<i32>(&integer));

    let expected_integer: [u8; 3] = [45, 52, 50];

    assert(std.bytes.equals(std.format.bytes(&sink), &expected_integer[..]));

    try trusted std.format.write<bool>(&mut sink, std.format.Argument<bool>(&true));

    let expected_boolean: [u8; 7] = [45, 52, 50, 116, 114, 117, 101];

    assert(std.bytes.equals(std.format.bytes(&sink), &expected_boolean[..]));

    try trusted std.format.write<char>(&mut sink, std.format.Argument<char>(&character));

    let expected: [u8; 8] = [45, 52, 50, 116, 114, 117, 101, 65];

    assert(std.bytes.equals(std.format.bytes(&sink), &expected[..]));

    return Ok(unit);
}

@test
trusted func formatting_options_control_output() -> Result<unit, std.memory.MemoryLayoutError>
{
    let options: std.format.Options = std.format.Options(
        radix = std.format.Radix.HexadecimalUppercase,

        precision = 4,
        width = 6,

        alignment = std.format.Alignment.Right,
        sign = std.format.Sign.Always,
        escaping = std.format.Escaping.Raw,
    );

    let argument: std.format.Argument<u32> = std.format.Argument<u32>(&42, options = options);
    let mut sink: std.format.ByteSink = try std.format.ByteSink(capacity = 6);

    try trusted std.format.write<u32>(&mut sink, argument);

    let expected: [u8; 6] = [32, 43, 48, 48, 50, 65];

    assert(std.bytes.equals(std.format.bytes(&sink), &expected[..]));

    return Ok(unit);
}

@test
trusted func wide_integer_formatting_is_total() -> Result<unit, std.memory.MemoryLayoutError>
{
    let minimum: i128 = -170141183460469231731687303715884105727 - 1;
    let mut decimal_sink: std.format.ByteSink = try std.format.ByteSink(capacity = 40);

    try trusted std.format.write<i128>(&mut decimal_sink, std.format.Argument<i128>(&minimum));

    let expected_decimal: string = "-170141183460469231731687303715884105728";

    assert(std.bytes.equals(std.format.bytes(&decimal_sink), expected_decimal.as_bytes()));

    let hexadecimal_options: std.format.Options = std.format.Options(
        radix = std.format.Radix.HexadecimalLowercase,

        precision = 0,
        width = 0,

        alignment = std.format.Alignment.Right,
        sign = std.format.Sign.NegativeOnly,
        escaping = std.format.Escaping.Raw,
    );

    let mut hexadecimal_sink: std.format.ByteSink = try std.format.ByteSink(capacity = 33);

    try trusted std.format.write<i128>(
        &mut hexadecimal_sink,
        std.format.Argument<i128>(&minimum, options = hexadecimal_options),
    );

    let expected_hexadecimal: string = "-80000000000000000000000000000000";

    assert(std.bytes.equals(std.format.bytes(&hexadecimal_sink), expected_hexadecimal.as_bytes()));

    let maximum: u128 = 340282366920938463463374607431768211455;
    let mut maximum_sink: std.format.ByteSink = try std.format.ByteSink(capacity = 32);

    let maximum_hexadecimal_options: std.format.Options = std.format.Options(
        radix = std.format.Radix.HexadecimalLowercase,

        precision = 0,
        width = 0,

        alignment = std.format.Alignment.Right,
        sign = std.format.Sign.NegativeOnly,
        escaping = std.format.Escaping.Raw,
    );

    try trusted std.format.write<u128>(
        &mut maximum_sink,
        std.format.Argument<u128>(&maximum, options = maximum_hexadecimal_options),
    );

    let expected_maximum: string = "ffffffffffffffffffffffffffffffff";

    assert(std.bytes.equals(std.format.bytes(&maximum_sink), expected_maximum.as_bytes()));

    return Ok(unit);
}

@test
trusted func escaped_string_formatting() -> Result<unit, std.memory.MemoryLayoutError>
{
    let options: std.format.Options = std.format.Options(
        radix = std.format.Radix.Decimal,

        precision = 0,
        width = 0,

        alignment = std.format.Alignment.Left,
        sign = std.format.Sign.NegativeOnly,
        escaping = std.format.Escaping.Quoted,
    );

    let argument: std.format.Argument<string> = std.format.Argument<string>(&"A\n", options = options);
    let mut sink: std.format.ByteSink = try std.format.ByteSink(capacity = 0);

    try trusted std.format.write<string>(&mut sink, argument);

    let expected: [u8; 5] = [34, 65, 92, 110, 34];

    assert(std.bytes.equals(std.format.bytes(&sink), &expected[..]));

    return Ok(unit);
}

@test
trusted func counting_formatting_sizes_output_without_collecting_bytes()
{
    let options: std.format.Options = std.format.Options(
        radix = std.format.Radix.Decimal,

        precision = 5,
        width = 8,

        alignment = std.format.Alignment.Right,
        sign = std.format.Sign.Always,
        escaping = std.format.Escaping.Raw,
    );

    let mut sink: std.format.CountingSink = std.format.CountingSink();
    let value: u32 = 42;

    std.testing.assert_ok<unit, std.format.CountingSinkError>(
        trusted std.format.write_to<u32, std.format.CountingSink, std.format.CountingSinkError>(
            &mut sink,
            std.format.Argument<u32>(&value, options = options),
        )
    );

    assert(std.format.formatted_length(&sink) == 8);
}

@test
trusted func fixed_formatting_uses_borrowed_storage()
{
    let options: std.format.Options = std.format.Options(
        radix = std.format.Radix.HexadecimalUppercase,

        precision = 4,
        width = 8,

        alignment = std.format.Alignment.Right,
        sign = std.format.Sign.Always,
        escaping = std.format.Escaping.Raw,
    );

    let mut storage: [u8; 8] = [0; 8];
    let mut sink: std.format.FixedSink = std.format.FixedSink(&mut storage[..]);
    let value: u32 = 255;

    std.testing.assert_ok<unit, std.format.FixedSinkError>(
        trusted std.format.write_to<u32, std.format.FixedSink, std.format.FixedSinkError>(
            &mut sink,
            std.format.Argument<u32>(&value, options = options),
        )
    );

    let expected: [u8; 8] = [32, 32, 32, 43, 48, 48, 70, 70];
    let length: usize = std.format.finish_fixed(sink);

    assert(length == 8);
    assert(std.bytes.equals(&storage[..], &expected[..]));
}

@test
trusted func fixed_formatting_accepts_zero_length_output()
{
    let mut storage: [u8; 0] = [0; 0];
    let mut sink: std.format.FixedSink = std.format.FixedSink(&mut storage[..]);

    std.testing.assert_ok<unit, std.format.FixedSinkError>(
        trusted std.format.write_to<string, std.format.FixedSink, std.format.FixedSinkError>(
            &mut sink,
            std.format.Argument<string>(&""),
        )
    );

    let length: usize = std.format.finish_fixed(sink);

    assert(length == 0);
}

@test
trusted func fixed_formatting_reports_capacity_without_partial_digit_output()
{
    let mut storage: [u8; 2] = [0; 2];
    let mut sink: std.format.FixedSink = std.format.FixedSink(&mut storage[..]);
    let value: u32 = 1024;

    let result: Result<unit, std.format.FixedSinkError> = trusted std.format.write_to<
        u32,
        std.format.FixedSink,
        std.format.FixedSinkError
    >(&mut sink, std.format.Argument<u32>(&value));

    assert(
        std.testing.assert_error<unit, std.format.FixedSinkError>(result) matches
            std.format.FixedSinkError.CapacityExceeded
    );

    let length: usize = std.format.finish_fixed(sink);

    assert(length == 0);
    assert(storage[0] == 0);
    assert(storage[1] == 0);
}

@test
trusted func fixed_formatting_handles_maximum_width_without_arithmetic_overflow()
{
    let options: std.format.Options = std.format.Options(
        radix = std.format.Radix.Decimal,

        precision = 0,
        width = ~0,

        alignment = std.format.Alignment.Right,
        sign = std.format.Sign.NegativeOnly,
        escaping = std.format.Escaping.Raw,
    );

    let mut storage: [u8; 0] = [0; 0];
    let mut sink: std.format.FixedSink = std.format.FixedSink(&mut storage[..]);
    let value: u32 = 0;

    let result: Result<unit, std.format.FixedSinkError> = trusted std.format.write_to<
        u32,
        std.format.FixedSink,
        std.format.FixedSinkError
    >(&mut sink, std.format.Argument<u32>(&value, options = options));

    assert(
        std.testing.assert_error<unit, std.format.FixedSinkError>(result) matches
            std.format.FixedSinkError.CapacityExceeded
    );

    let length: usize = std.format.finish_fixed(sink);

    assert(length == 0);
}

@test
trusted func integer_width_boundaries_preserve_values() -> Result<unit, std.memory.MemoryLayoutError>
{
    let u8_maximum: u8 = 255;
    let u16_maximum: u16 = 65535;
    let u32_maximum: u32 = 4294967295;
    let u64_maximum: u64 = 18446744073709551615;
    let u128_maximum: u128 = 340282366920938463463374607431768211455;
    let usize_maximum: usize = ~0;

    try assert_default_integer_format<u8>(&u8_maximum, "255");
    try assert_default_integer_format<u16>(&u16_maximum, "65535");
    try assert_default_integer_format<u32>(&u32_maximum, "4294967295");
    try assert_default_integer_format<u64>(&u64_maximum, "18446744073709551615");
    try assert_default_integer_format<u128>(&u128_maximum, "340282366920938463463374607431768211455");
    try assert_default_integer_format<usize>(&usize_maximum, "18446744073709551615");

    let i8_minimum: i8 = -127 - 1;
    let i8_maximum: i8 = 127;
    let i16_minimum: i16 = -32767 - 1;
    let i16_maximum: i16 = 32767;
    let i32_minimum: i32 = -2147483647 - 1;
    let i32_maximum: i32 = 2147483647;
    let i64_minimum: i64 = -9223372036854775807 - 1;
    let i64_maximum: i64 = 9223372036854775807;
    let i128_minimum: i128 = -170141183460469231731687303715884105727 - 1;
    let i128_maximum: i128 = 170141183460469231731687303715884105727;
    let isize_minimum: isize = -9223372036854775807 - 1;
    let isize_maximum: isize = 9223372036854775807;

    try assert_default_integer_format<i8>(&i8_minimum, "-128");
    try assert_default_integer_format<i8>(&i8_maximum, "127");
    try assert_default_integer_format<i16>(&i16_minimum, "-32768");
    try assert_default_integer_format<i16>(&i16_maximum, "32767");
    try assert_default_integer_format<i32>(&i32_minimum, "-2147483648");
    try assert_default_integer_format<i32>(&i32_maximum, "2147483647");
    try assert_default_integer_format<i64>(&i64_minimum, "-9223372036854775808");
    try assert_default_integer_format<i64>(&i64_maximum, "9223372036854775807");
    try assert_default_integer_format<i128>(&i128_minimum, "-170141183460469231731687303715884105728");
    try assert_default_integer_format<i128>(&i128_maximum, "170141183460469231731687303715884105727");
    try assert_default_integer_format<isize>(&isize_minimum, "-9223372036854775808");
    try assert_default_integer_format<isize>(&isize_maximum, "9223372036854775807");

    return Ok(unit);
}

@test
trusted func native_integer_zero_preserves_space_sign_precision_and_padding(
) -> Result<unit, std.memory.MemoryLayoutError>
{
    let options: std.format.Options = std.format.Options(
        radix = std.format.Radix.Decimal,

        precision = 2,
        width = 4,

        alignment = std.format.Alignment.Left,
        sign = std.format.Sign.Space,
        escaping = std.format.Escaping.Raw,
    );

    let value: u64 = 0;
    let mut sink: std.format.ByteSink = try std.format.ByteSink(capacity = 4);

    try trusted std.format.write<u64>(&mut sink, std.format.Argument<u64>(&value, options = options));

    let expected: [u8; 4] = [32, 48, 48, 32];

    assert(std.bytes.equals(std.format.bytes(&sink), &expected[..]));

    return Ok(unit);
}

@test
trusted func fixed_formatting_handles_maximum_precision_and_sign_without_arithmetic_overflow()
{
    let options: std.format.Options = std.format.Options(
        radix = std.format.Radix.Decimal,

        precision = ~0,
        width = 0,

        alignment = std.format.Alignment.Right,
        sign = std.format.Sign.Always,
        escaping = std.format.Escaping.Raw,
    );

    let mut storage: [u8; 0] = [0; 0];
    let mut sink: std.format.FixedSink = std.format.FixedSink(&mut storage[..]);
    let value: u32 = 0;

    let result: Result<unit, std.format.FixedSinkError> = trusted std.format.write_to<
        u32,
        std.format.FixedSink,
        std.format.FixedSinkError
    >(&mut sink, std.format.Argument<u32>(&value, options = options));

    assert(
        std.testing.assert_error<unit, std.format.FixedSinkError>(result) matches
            std.format.FixedSinkError.CapacityExceeded
    );

    let length: usize = std.format.finish_fixed(sink);

    assert(length == 0);
}

struct RecordingWriter
{
    mut length: usize;
    mut writes: usize;
    mut preceding: u8;
    mut last: u8;

    construct() -> Self
    {
        return
        {
            length = 0,
            writes = 0,
            preceding = 0,
            last = 0,
        };
    }
}

impl RecordingWriterIo = RecordingWriter(std.io.Writer)
{
    mut func write(pos source: &[u8]) -> Result<usize, std.io.IoError>
        requires(blocking_execution())
    {
        let length: usize = source.length();
        let mut index: usize = 0;

        while index < length
        {
            self.preceding = self.last;
            self.last = source[index];
            index += 1;
        }

        self.length += length;
        self.writes += 1;

        return Ok(length);
    }

    mut func flush() -> Result<unit, std.io.IoError>
        requires(blocking_execution())
    {
        return Ok(unit);
    }
}

@test
trusted func streaming_formatting_writes_without_collecting_an_intermediate_buffer()
{
    let mut writer: RecordingWriter = RecordingWriter();
    let mut sink: std.io.FormattingSink<RecordingWriter> = std.io.FormattingSink<RecordingWriter>(&mut writer);

    let options: std.format.Options = std.format.Options(
        radix = std.format.Radix.Decimal,

        precision = 0,
        width = 130,

        alignment = std.format.Alignment.Right,
        sign = std.format.Sign.NegativeOnly,
        escaping = std.format.Escaping.Raw,
    );

    let value: u32 = 42;

    std.testing.assert_ok<unit, std.io.IoError>(
        trusted std.format.write_to<u32, std.io.FormattingSink<RecordingWriter>, std.io.IoError>(
            &mut sink,
            std.format.Argument<u32>(&value, options = options)
        )
    );

    assert(writer.length == 130);
    assert(writer.writes == 3);
    assert(writer.preceding == 52);
    assert(writer.last == 50);
}
