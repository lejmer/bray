module bray.standard_library_tests.numeric;

using std.convert;
using std.numeric;
using std.numeric.IntegerCheckedConversion;
using std.numeric.I8Integer;
using std.numeric.I8IntegerBits;
using std.numeric.I128Integer;
using std.numeric.I128IntegerBits;
using std.numeric.I128IntegerFromBits;
using std.numeric.U128Integer;
using std.numeric.U128IntegerBits;
using std.numeric.I32Integer;
using std.numeric.I32IntegerBits;
using std.numeric.U8Integer;
using std.numeric.U8IntegerBits;
using std.numeric.U8IntegerFromBits;
using std.testing;

@test
func integer_limits_and_checked_arithmetic()
{
    assert(std.numeric.U8_MIN == 0);
    assert(std.numeric.U8_MAX == 255);
    assert(std.numeric.I32_MIN == -2147483647 - 1);
    assert(std.numeric.I32_MAX == 2147483647);
    assert(std.numeric.USIZE_MIN == 0);
    assert(std.numeric.USIZE_MAX > 0);
    assert(std.numeric.ISIZE_MIN < 0);
    assert(std.numeric.ISIZE_MAX > 0);

    let twenty: u8 = 20;
    let fifty: u8 = 50;
    let zero: u8 = 0;
    let one_hundred_twenty_eight: u8 = 128;

    let sum: u8? = twenty.checked_add(22);
    let overflow: u8? = std.numeric.U8_MAX.checked_add(1);
    let signed_sum: i32? = (-60 as i32).checked_add(18);
    let signed_product: i32? = (-6 as i32).checked_multiply(7);
    let difference: u8? = fifty.checked_subtract(8);
    let underflow: u8? = zero.checked_subtract(1);
    let product_overflow: u8? = one_hundred_twenty_eight.checked_multiply(2);
    let division_by_zero: i32? = (10 as i32).checked_divide(0);
    let division_overflow: i32? = std.numeric.I32_MIN.checked_divide(-1);

    let sum_value: u8 = std.testing.assert_present<u8>(sum);
    let signed_sum_value: i32 = std.testing.assert_present<i32>(signed_sum);
    let signed_product_value: i32 = std.testing.assert_present<i32>(signed_product);
    let difference_value: u8 = std.testing.assert_present<u8>(difference);

    assert(sum_value == 42);
    assert(signed_sum_value == -42);
    assert(signed_product_value == -42);
    assert(difference_value == 42);

    std.testing.assert_absent<u8>(overflow);
    std.testing.assert_absent<u8>(underflow);
    std.testing.assert_absent<u8>(product_overflow);
    std.testing.assert_absent<i32>(division_by_zero);
    std.testing.assert_absent<i32>(division_overflow);
}

@test
func widest_integer_parsing()
{
    let unsigned_decimal: Result<u128, std.numeric.ParseError> = std.numeric.parse_u128(&"42");
    let unsigned_hexadecimal: Result<u128, std.numeric.ParseError> = std.numeric.parse_u128(&"ff", radix = 16);
    let invalid: Result<u128, std.numeric.ParseError> = std.numeric.parse_u128(&"4z");
    let signed: Result<i32, std.numeric.ParseError> = std.numeric.parse_i32(&"-42");
    let narrow_overflow: Result<u8, std.numeric.ParseError> = std.numeric.parse_u8(&"256");
    let empty: Result<u16, std.numeric.ParseError> = std.numeric.parse_u16(&"");
    let invalid_radix: Result<u32, std.numeric.ParseError> = std.numeric.parse_u32(&"10", radix = 1);
    let signed_minimum: Result<i8, std.numeric.ParseError> = std.numeric.parse_i8(&"-128");
    let signed_overflow: Result<i8, std.numeric.ParseError> = std.numeric.parse_i8(&"128");

    let decimal_value: u128 = std.testing.assert_ok<u128, std.numeric.ParseError>(unsigned_decimal);
    let hexadecimal_value: u128 = std.testing.assert_ok<u128, std.numeric.ParseError>(unsigned_hexadecimal);

    assert(decimal_value == 42);
    assert(hexadecimal_value == 255);

    assert(std.testing.assert_error<u128, std.numeric.ParseError>(invalid) matches std.numeric.ParseError.InvalidDigit);

    let signed_value: i32 = std.testing.assert_ok<i32, std.numeric.ParseError>(signed);

    assert(signed_value == -42);

    assert(
        std.testing.assert_error<u8, std.numeric.ParseError>(narrow_overflow) matches std.numeric.ParseError.Overflow
    );

    assert(std.testing.assert_error<u16, std.numeric.ParseError>(empty) matches std.numeric.ParseError.Empty);

    assert(
        std.testing.assert_error<u32, std.numeric.ParseError>(invalid_radix) matches std.numeric.ParseError.InvalidRadix
    );

    let minimum_value: i8 = std.testing.assert_ok<i8, std.numeric.ParseError>(signed_minimum);

    assert(minimum_value == -128);

    assert(
        std.testing.assert_error<i8, std.numeric.ParseError>(signed_overflow) matches std.numeric.ParseError.Overflow
    );
}

struct ConvertedNumber
{
    value: u8;
}

union NumberConversionError
{
    Invalid;
}

struct OwnedNumber
{
    value: u8;
}

impl OwnedNumberConversion = OwnedNumber(CheckedConvertTo<ConvertedNumber>)
{
    type Error = NumberConversionError;

    consume func convert_checked() -> Result<ConvertedNumber, NumberConversionError>
    {
        if self.value == 0
        {
            return Error(NumberConversionError.Invalid);
        }

        return Ok(
            {
                value = self.value
            }
        );
    }
}

@test
func checked_conversion_uses_custom_error_and_transfers_source()
{
    let value: OwnedNumber =
    {
        value = 42
    };

    let converted: Result<ConvertedNumber, NumberConversionError> = std.convert<ConvertedNumber>(value);
    let number: ConvertedNumber = std.testing.assert_ok<ConvertedNumber, NumberConversionError>(converted);

    assert(number.value == 42);

    let invalid: OwnedNumber =
    {
        value = 0
    };

    let rejected: Result<ConvertedNumber, NumberConversionError> = std.convert<ConvertedNumber>(invalid);

    assert(
        std.testing.assert_error<ConvertedNumber, NumberConversionError>(rejected) matches NumberConversionError.Invalid
    );
}

@test
func checked_integer_conversion_preserves_values_and_rejects_out_of_range()
{
    let value: i32 = 42;
    let converted: Result<u8, ConversionError> = std.convert<u8>(value);
    let narrowed: u8 = std.testing.assert_ok<u8, ConversionError>(converted);

    assert(narrowed == 42);

    let too_large: i32 = 300;
    let rejected: Result<u8, ConversionError> = std.convert<u8>(too_large);

    assert(std.testing.assert_error<u8, ConversionError>(rejected) matches ConversionError.OutOfRange);

    let negative: i32 = -1;
    let rejected_negative: Result<u8, ConversionError> = std.convert<u8>(negative);

    assert(std.testing.assert_error<u8, ConversionError>(rejected_negative) matches ConversionError.OutOfRange);

    let signed_small: i8 = -1;
    let signed_wide: Result<i128, ConversionError> = std.convert<i128>(signed_small);

    assert(std.testing.assert_ok<i128, ConversionError>(signed_wide) == -1);

    let unsigned_maximum: u128 = std.numeric.U128_MAX;
    let rejected_signed: Result<i128, ConversionError> = std.convert<i128>(unsigned_maximum);

    assert(std.testing.assert_error<i128, ConversionError>(rejected_signed) matches ConversionError.OutOfRange);
}
