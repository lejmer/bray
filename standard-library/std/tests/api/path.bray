module bray.standard_library_tests.path;

using std.io;
using std.path;
using std.platform;
using std.string;

@test
trusted func native_paths_round_trip_join_and_normalize() -> Result<unit, std.path.PathError>
    uses(foreign_call)
{
    let native: std.path.NativeText = try std.path.NativeText.from_string(&"native");
    let native_path: std.path.Path = try std.path.Path.new(native);
    let base: std.path.Path = try std.path.Path.new(&"alpha/./beta");
    let child: std.path.Path = try std.path.Path.new(&"../gamma");
    let joined: std.path.Path = try base.join(&child);
    let normalized: std.path.Path = try joined.normalize();
    let text: string = try normalized.to_string();
    let native_text: string = try native_path.to_string();

    assert(std.string.equals(&native_text, &"native"));
    assert(std.string.equals(&text, &"alpha/gamma") || std.string.equals(&text, &"alpha\\gamma"));

    let unresolved: std.path.Path = try std.path.Path.new(&"../../alpha");
    let normalized_unresolved: std.path.Path = try unresolved.normalize();
    let unresolved_text: string = try normalized_unresolved.to_string();
    let slash_form: bool = std.string.equals(&unresolved_text, &"../../alpha");
    let backslash_form: bool = std.string.equals(&unresolved_text, &"..\\..\\alpha");

    assert(slash_form || backslash_form);

    let unicode: std.path.Path = try std.path.Path.new(&"data/Bray-λ-🦀");
    let unicode_text: string = try unicode.to_string();

    assert(std.string.equals(&unicode_text, &"data/Bray-λ-🦀"));

    if trusted internal std.platform.native_text_width() == 16
    {
        let drive_base: std.path.Path = try std.path.Path.new(&"C:\\base");
        let rooted_child: std.path.Path = try std.path.Path.new(&"\\child");
        let rooted_join: std.path.Path = try drive_base.join(&rooted_child);
        let rooted_text: string = try rooted_join.to_string();

        assert(std.string.equals(&rooted_text, &"C:\\child"));

        let drive_child: std.path.Path = try std.path.Path.new(&"D:child");
        let drive_join: std.path.Path = try drive_base.join(&drive_child);
        let drive_text: string = try drive_join.to_string();

        assert(std.string.equals(&drive_text, &"D:child"));

        let drive_relative: std.path.Path = try std.path.Path.new(&"C:base\\..\\child");
        let normalized_drive_relative: std.path.Path = try drive_relative.normalize();
        let normalized_drive_text: string = try normalized_drive_relative.to_string();

        assert(std.string.equals(&normalized_drive_text, &"C:child"));
    }

    return Ok(unit);
}
