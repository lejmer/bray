@target(target.c.WCHAR == "u16")
module bray.standard_library_tests.ffi;

@test
trusted func c_utf16_strings_name_and_validate_their_encoding() -> Result<unit, std.ffi.c.StringError>
{
    let encoded: std.ffi.c.OwnedWideString = try trusted std.ffi.c.encode_utf16(&"A😀");
    let borrowed: std.ffi.c.BorrowedWideString = encoded.borrow();
    let decoded: string = try trusted std.ffi.c.decode_utf16(&borrowed);

    assert(std.string.equals(&decoded, &"A😀"));

    let invalid_units: [std.ffi.c.WideChar; 2] = [
        std.ffi.c.wide_char_wrapping(55_296),
        std.ffi.c.wide_char_wrapping(0),
    ];

    let invalid: std.ffi.c.BorrowedWideString = try std.ffi.c.borrow_wide_string(&invalid_units[..]);

    let _: std.ffi.c.StringError = std.testing.assert_error<string, std.ffi.c.StringError>(
        trusted std.ffi.c.decode_utf16(&invalid),
    );

    return Ok(unit);
}
