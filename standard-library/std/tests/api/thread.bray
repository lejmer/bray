@target(target.platform.native_threads)
module bray.standard_library_tests.thread;

using std.thread;
using std.thread.IdEquatable;
using std.task;
using std.testing;

static TERMINAL_OBSERVATION: core.atomic.Atomic<u32> = core.atomic.initialize<u32>(0);

static PARK_READY: core.atomic.Atomic<u32> = core.atomic.initialize<u32>(0);

@thread_local static THREAD_LOCAL_IDENTITY: core.atomic.Atomic<u64> = core.atomic.initialize<u64>(0);

@thread_local static GENERIC_THREAD_VALUE<const N: u64>: u64 = N;

internal struct ThreadCleanupProbe
{
    finalize()
    {
        let _: u32 = core.atomic.fetch_add<u32, 3>(&TERMINAL_OBSERVATION, 1);
    }

    destruct() {}
}

@thread_local static THREAD_CLEANUP: ThreadCleanupProbe = ThreadCleanupProbe
{
};

internal func return_value(pos state: i32) -> i32
{
    return state;
}

internal func retain_borrow(pos state: &i32) -> unit
{
    let _: &i32 = state;
}

internal func observe_identity(pos state: unit) -> std.thread.Id
{
    let identity: std.thread.Id = std.thread.current_id();

    core.atomic.store<u64, 2>(&THREAD_LOCAL_IDENTITY, 1);

    let _: &ThreadCleanupProbe = &THREAD_CLEANUP;

    return identity;
}

internal func observe_platform_identity(pos state: unit) -> u64
{
    return trusted std.thread.current_platform_identity();
}

internal struct PanickingThreadState
{
    cleanups: &core.atomic.Atomic<u32>;

    destruct()
    {
        let _: u32 = core.atomic.fetch_add<u32, 3>(self.cleanups, 1);

        panic("native thread state cleanup fixture");
    }
}

internal func panic_in_thread(pos state: PanickingThreadState) -> unit
{
    panic("native thread panic fixture");
}

internal func wait_for_cancellation(pos state: unit) -> unit
{
    while !std.thread.cancellation_requested()
    {
        std.thread.checkpoint();
    }

    std.thread.checkpoint();
}

internal func park_until_woken(pos state: i32) -> i32
{
    core.atomic.store<u32, 2>(&PARK_READY, 1);
    core.atomic.notify_all<u32>(&PARK_READY);

    std.thread.park();

    return state;
}

internal func name_current_thread(pos state: string) -> bool
{
    return std.thread.set_current_name(&state) matches Ok(_);
}

internal func generic_thread_values(pos state: unit) -> (u64, u64)
{
    return (GENERIC_THREAD_VALUE<7>, GENERIC_THREAD_VALUE<11>);
}

@test
func native_thread_returns_a_typed_value()
{
    let mut thread: std.thread.Thread<i32> = std.testing.assert_ok<std.thread.Thread<i32>, std.thread.ThreadError>(
        std.thread.start<i32, i32>(return_value, 37)
    );

    let value: i32 = std.testing.assert_completed<i32>(thread.join());

    assert(value == 37);
}

@test
async func native_thread_run_bridges_to_async_execution()
{
    let value: i32 = std.testing.assert_ok<i32, std.thread.ThreadError>(
        await std.thread.run<i32, i32>(return_value, 39)
    );

    assert(value == 39);
}

@test
func main_native_thread_identity_is_stable()
{
    assert(std.thread.is_main());
    assert(std.thread.current_id() == std.thread.main_id());
}

@test
func native_platform_identity_is_stable_and_distinguishes_concurrent_threads()
{
    let expected: u64 = trusted std.thread.current_platform_identity();

    assert(trusted std.thread.current_platform_identity() == expected);

    let mut thread: std.thread.Thread<u64> = std.testing.assert_ok<std.thread.Thread<u64>, std.thread.ThreadError>(
        std.thread.start<unit, u64>(observe_platform_identity, unit)
    );

    let observed: u64 = std.testing.assert_completed<u64>(thread.join());

    assert(observed != expected);
}

@test
func native_thread_owner_scopes_a_transferred_borrow()
{
    let value: i32 = 41;

    let mut thread: std.thread.Thread<unit> = std.testing.assert_ok<std.thread.Thread<unit>, std.thread.ThreadError>(
        std.thread.start< &i32, unit>(retain_borrow, &value)
    );

    std.testing.assert_completed<unit>(thread.join());

    assert(value == 41);
}

@test
func concurrency_model_native_thread_identity_and_exact_thread_cleanup_are_observable()
{
    core.atomic.store<u32, 2>(&TERMINAL_OBSERVATION, 0);

    let mut thread: std.thread.Thread<std.thread.Id> = std.testing.assert_ok<
        std.thread.Thread<std.thread.Id>,
        std.thread.ThreadError
    >(std.thread.start<unit, std.thread.Id>(observe_identity, unit));

    let expected: std.thread.Id = thread.id();

    assert(expected != std.thread.current_id());

    let identity: std.thread.Id = std.testing.assert_completed<std.thread.Id>(thread.join());

    assert(identity == expected);

    assert(core.atomic.load<u32, 1>(&TERMINAL_OBSERVATION) == 1);
}

@test
func native_thread_panic_is_reported_to_the_owner()
{
    let cleanups: core.atomic.Atomic<u32> = core.atomic.initialize<u32>(0);

    let mut thread: std.thread.Thread<unit> = std.testing.assert_ok<std.thread.Thread<unit>, std.thread.ThreadError>(
        std.thread.start<PanickingThreadState, unit>(
            panic_in_thread,
            {
                cleanups = &cleanups
            }
        )
    );

    let _: PanicReport = std.testing.assert_panicked<unit>(thread.join());

    assert(core.atomic.load<u32, 1>(&cleanups) == 1);
}

@test
func concurrency_stress_native_thread_cancellation_reaches_a_checkpoint()
{
    let mut thread: std.thread.Thread<unit> = std.testing.assert_ok<std.thread.Thread<unit>, std.thread.ThreadError>(
        std.thread.start<unit, unit>(wait_for_cancellation, unit)
    );

    std.testing.assert_cancelled<unit>(thread.cancel());
}

@test
func native_thread_finalization_accepts_cooperative_cancellation()
{
    let _: std.thread.Thread<unit> = std.testing.assert_ok<std.thread.Thread<unit>, std.thread.ThreadError>(
        std.thread.start<unit, unit>(wait_for_cancellation, unit)
    );
}

@test
async func cancelling_native_thread_run_cancels_the_owned_thread()
{
    let running: Task<Result<unit, std.thread.ThreadError>> = std.thread.run<unit, unit>(
        wait_for_cancellation,
        unit,
    ).start();

    std.testing.assert_cancelled<Result<unit, std.thread.ThreadError>>(await running.cancel());
}

@test
func native_thread_wake_publishes_one_park_token()
{
    core.atomic.store<u32, 2>(&PARK_READY, 0);

    let mut thread: std.thread.Thread<i32> = std.testing.assert_ok<std.thread.Thread<i32>, std.thread.ThreadError>(
        std.thread.start<i32, i32>(park_until_woken, 43)
    );

    while core.atomic.load<u32, 1>(&PARK_READY) == 0
    {
        core.atomic.wait<u32, 1>(&PARK_READY, 0);
    }

    thread.wake();

    let value: i32 = std.testing.assert_completed<i32>(thread.join());

    assert(value == 43);
}

@test
func native_thread_can_set_its_platform_name()
{
    let mut thread: std.thread.Thread<bool> = std.testing.assert_ok<std.thread.Thread<bool>, std.thread.ThreadError>(
        std.thread.start<string, bool>(name_current_thread, "bray-test")
    );

    let named: bool = std.testing.assert_completed<bool>(thread.join());

    assert(named);
}

@test
func native_thread_realizes_distinct_generic_thread_statics()
{
    let mut thread: std.thread.Thread<(u64, u64)> = std.testing.assert_ok<
        std.thread.Thread<(u64, u64)>,
        std.thread.ThreadError
    >(std.thread.start<unit, (u64, u64)>(generic_thread_values, unit));

    let values: (u64, u64) = std.testing.assert_completed<(u64, u64)>(thread.join());

    let (first, second) = values;

    assert(first == 7);
    assert(second == 11);
}
