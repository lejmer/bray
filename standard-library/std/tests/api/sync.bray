module bray.standard_library_tests.sync;

using std.atomic;
using std.memory;
using std.sync;
using std.task;
using std.testing;

internal async func increment_mutex(pos counter: &std.sync.Mutex<u32>, pos iterations: u32)
    requires(blocking_execution(), trusted std.sync.mutex.valid(&counter.instance))
    ensures(trusted std.sync.mutex.valid(&counter.instance))
{
    let mut remaining: u32 = iterations;

    while remaining > 0
    {
        {
            let mut guard: std.sync.MutexGuard<u32> = counter.lock();
            let value: &mut u32 = guard.get();

            value += 1;
        }

        remaining -= 1;
        await std.task.yield_now();
    }
}

internal async func panic_while_holding_mutex(pos mutex: &std.sync.Mutex<u32>)
    requires(blocking_execution(), trusted std.sync.mutex.valid(&mutex.instance))
    ensures(trusted std.sync.mutex.valid(&mutex.instance))
{
    let guard: std.sync.MutexGuard<u32> = mutex.lock();

    panic("synchronization cleanup fixture");
}

internal async func record_writer_order(pos lock: &std.sync.RwLock<u32>, pos order: &std.atomic.Atomic<u32>)
    requires(blocking_execution(), trusted std.sync.rw_lock.valid(&lock.instance))
    ensures(trusted std.sync.rw_lock.valid(&lock.instance))
{
    let mut guard: std.sync.RwLockWriteGuard<u32> = lock.write();
    let position: u32 = order.fetch_add(1, order = std.atomic.ReadModifyWriteOrder.AcquireRelease);
    let value: &mut u32 = guard.get();

    assert(position == 0);
    value = 1;
}

internal async func record_reader_order(pos lock: &std.sync.RwLock<u32>, pos order: &std.atomic.Atomic<u32>)
    requires(blocking_execution(), trusted std.sync.rw_lock.valid(&lock.instance))
    ensures(trusted std.sync.rw_lock.valid(&lock.instance))
{
    let guard: std.sync.RwLockReadGuard<u32> = lock.read();
    let position: u32 = order.fetch_add(1, order = std.atomic.ReadModifyWriteOrder.AcquireRelease);

    assert(position == 1);
    assert(guard.get() == 1);
}

internal async func cross_reusable_barrier(
    pos barrier: &std.sync.Barrier,
    pos rounds: u32,
    pos crossings: &std.atomic.Atomic<u32>,
)
    requires(blocking_execution(), trusted std.sync.mutex.valid(barrier.marker()))
    ensures(trusted std.sync.mutex.valid(barrier.marker()))
{
    let mut remaining: u32 = rounds;

    while remaining > 0
    {
        let _: std.sync.BarrierWait = barrier.wait();
        let _: u32 = crossings.fetch_add(1, order = std.atomic.ReadModifyWriteOrder.AcquireRelease);

        remaining -= 1;
        await std.task.yield_now();
    }
}

func initialized_value() -> i32
{
    return 37;
}

internal func failed_initialization() -> Result<i32, i32>
{
    return Error(19);
}

@test
func synchronization_owners_guard_and_publish_values()
{
    assert(std.memory.size_of<std.sync.SpinLockGuard<u32>>() == std.memory.size_of<DataPointer<u8>>());
    assert(std.memory.size_of<std.sync.MutexGuard<u32>>() == std.memory.size_of<DataPointer<u8>>());
    assert(std.memory.size_of<std.sync.RwLockReadGuard<u32>>() == std.memory.size_of<DataPointer<u8>>());
    assert(std.memory.size_of<std.sync.RwLockWriteGuard<u32>>() == std.memory.size_of<DataPointer<u8>>());

    let spin: std.sync.SpinLock<i32> = std.sync.SpinLock<i32>(1);

    {
        let mut guard: std.sync.SpinLockGuard<i32> = spin.lock();
        let value: &mut i32 = guard.get();

        value = 2;
    }

    let mutex: std.sync.Mutex<i32> = std.sync.Mutex<i32>(3);

    {
        let mut guard: std.sync.MutexGuard<i32> = mutex.lock();
        let value: &mut i32 = guard.get();

        value = 5;
    }

    let lock: std.sync.RwLock<i32> = std.sync.RwLock<i32>(7);

    {
        let mut guard: std.sync.RwLockWriteGuard<i32> = lock.write();
        let value: &mut i32 = guard.get();

        value = 11;
    }

    {
        let guard: std.sync.RwLockReadGuard<i32> = lock.read();

        assert(guard.get() == 11);
    }

    let once: std.sync.Once<i32> = std.sync.Once<i32>.empty();

    assert(once.get_or_init(initialized_value) == 37);

    assert(
        once.get_or_init(
            lambda() -> i32
            {
                return 99;
            }
        ) == 37
    );
}

@test
func concurrency_model_failed_once_initialization_can_be_retried()
{
    let once: std.sync.Once<i32> = std.sync.Once<i32>.empty();

    let _: i32 = std.testing.assert_error< &i32, i32>(once.get_or_try_init<i32>(failed_initialization));

    assert(once.get_or_init(initialized_value) == 37);
}

@test
func synchronization_signals_cover_immediate_progress()
{
    let event: std.sync.ManualResetEvent = std.sync.ManualResetEvent(set = true);

    event.wait();
    event.reset();
    assert(!event.is_set());
    event.set();
    assert(event.is_set());

    let automatic: std.sync.AutoResetEvent = std.sync.AutoResetEvent(set = true);

    automatic.wait();

    let semaphore: std.sync.Semaphore = std.testing.assert_ok<std.sync.Semaphore, std.sync.SemaphoreError>(
        std.sync.Semaphore(initial = 1, maximum = 2)
    );

    assert(semaphore.try_acquire());
    assert(!semaphore.try_acquire());

    std.testing.assert_ok<unit, std.sync.SemaphoreError>(semaphore.release());

    let barrier: std.sync.Barrier = std.testing.assert_ok<std.sync.Barrier, std.sync.BarrierError>(
        std.sync.Barrier(participants = 1)
    );

    assert(barrier.wait() matches Leader);
}

@test
async func concurrency_stress_mutex_contention_and_panic_cleanup_preserve_progress()
{
    let counter: std.sync.Mutex<u32> = std.sync.Mutex<u32>(0);
    let first: Task<unit> = increment_mutex(&counter, iterations = 128).start();
    let second: Task<unit> = increment_mutex(&counter, iterations = 128).start();

    try await first.join();
    try await second.join();

    {
        let mut guard: std.sync.MutexGuard<u32> = counter.lock();

        assert(guard.get() == 256);
    }

    let panicked: Task<unit> = panic_while_holding_mutex(&counter).start();

    let _: PanicReport = std.testing.assert_panicked<unit>(await panicked.join());

    {
        let _: std.sync.MutexGuard<u32> = std.testing.assert_present<std.sync.MutexGuard<u32>>(counter.try_lock());
    }

    let mut acquired: std.sync.MutexGuard<u32> = std.testing.assert_present<std.sync.MutexGuard<u32>>(
        counter.try_lock()
    );

    acquired.unlock();
}

@test
async func concurrency_model_reader_writer_lock_admits_a_pending_writer_before_later_readers()
{
    let lock: std.sync.RwLock<u32> = std.sync.RwLock<u32>(0);
    let order = std.atomic.Atomic<u32>(0);
    let mut initial: std.sync.RwLockReadGuard<u32> = lock.read();
    let writer: Task<unit> = record_writer_order(&lock, order = &order).start();
    let mut writer_pending: bool = false;

    while !writer_pending
    {
        writer_pending = lock.try_read() matches none;

        if !writer_pending
        {
            await std.task.yield_now();
        }
    }

    assert(writer_pending);

    let reader: Task<unit> = record_reader_order(&lock, order = &order).start();

    initial.unlock();

    try await writer.join();
    try await reader.join();

    assert(order.load(order = std.atomic.LoadOrder.Acquire) == 2);
}

@test
async func concurrency_stress_barrier_reuses_its_generation_across_contended_rounds()
{
    let barrier: std.sync.Barrier = std.testing.assert_ok<std.sync.Barrier, std.sync.BarrierError>(
        std.sync.Barrier(participants = 3)
    );

    let crossings: std.atomic.Atomic<u32> = std.atomic.Atomic<u32>(0);

    let first: Task<unit> = cross_reusable_barrier(&barrier, rounds = 16, crossings = &crossings).start();

    let second: Task<unit> = cross_reusable_barrier(&barrier, rounds = 16, crossings = &crossings).start();

    let third: Task<unit> = cross_reusable_barrier(&barrier, rounds = 16, crossings = &crossings).start();

    try await first.join();
    try await second.join();
    try await third.join();

    assert(crossings.load(order = std.atomic.LoadOrder.Acquire) == 48);
}

static REENTERED_ONCE: std.sync.Once<i32> =
{
    let prepared = std.sync.Once<i32>.prepare();

    yield
    {
        instance = prepared.0,
        storage = prepared.1,
    };
};

internal func catch_once_reentry() -> i32
{
    let caught: Result<unit, PanicReport> = catch
    {
        let _: &i32 = REENTERED_ONCE.get_or_init(initialized_value);

        yield unit;
    };

    let _: PanicReport = std.testing.assert_error<unit, PanicReport>(caught);

    return 99;
}

@test
func once_caught_reentry_rejects_publication_and_allows_retry()
{
    let caught: Result<unit, PanicReport> = catch
    {
        let _: &i32 = REENTERED_ONCE.get_or_init(catch_once_reentry);

        yield unit;
    };

    let _: PanicReport = std.testing.assert_error<unit, PanicReport>(caught);

    assert(REENTERED_ONCE.get_or_init(initialized_value) == 37);
}
