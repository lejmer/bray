internal func real_coefficient_checksum(pos coefficient: &std.format.RealCoefficient) -> u64
{
    match coefficient
    {
        case Small(value)
        {
            let mut remaining: u128 = value;
            let mut checksum: u64 = 0;

            loop
            {
                checksum = (checksum << 7) | (checksum >> 57);
                checksum ^= std.numeric.truncate_to<u64>(remaining % 1000000000);
                remaining /= 1000000000;

                if remaining == 0
                {
                    return checksum;
                }
            }
        }
        case Large(value)
        {
            let mut checksum: u64 = 0;
            let mut index: usize = 0;

            while index < value.length
            {
                checksum = (checksum << 7) | (checksum >> 57);
                checksum ^= value.limbs[index] as u64;
                index += 1;
            }

            return checksum;
        }
    }
}

@test
func fixed_decimal_conversion_covers_the_full_ieee_storage_bound()
{
    // Goldens round the exact rational value times 10^scale to nearest even,
    // then fold its base-10^9 limbs with rotate-left seven and xor.
    let value_0 = internal std.format.fixed_real_decimal(1, -16494, 16494);

    assert(value_0.scale == 16494);
    assert(internal std.format.real_coefficient_digits(&value_0.coefficient) == 11529);
    assert(real_coefficient_checksum(&value_0.coefficient) == 3234639345196462509);
    let value_1 = internal std.format.fixed_real_decimal(5192296858534827628530496329220095, -16494, 16494);

    assert(value_1.scale == 16494);
    assert(internal std.format.real_coefficient_digits(&value_1.coefficient) == 11563);
    assert(real_coefficient_checksum(&value_1.coefficient) == 9859851418744684235);
    let value_2 = internal std.format.fixed_real_decimal(10384593717069655257060992658440191, 16271, 0);

    assert(value_2.scale == 0);
    assert(internal std.format.real_coefficient_digits(&value_2.coefficient) == 4933);
    assert(real_coefficient_checksum(&value_2.coefficient) == 2304088591483079409);
    let value_3 = internal std.format.fixed_real_decimal(1, -16494, 5000);

    assert(value_3.scale == 5000);
    assert(internal std.format.real_coefficient_digits(&value_3.coefficient) == 35);
    assert(real_coefficient_checksum(&value_3.coefficient) == 1221831715824903);
    let value_4 = internal std.format.fixed_real_decimal(9007199254740991, -1074, 1074);

    assert(value_4.scale == 1074);
    assert(internal std.format.real_coefficient_digits(&value_4.coefficient) == 767);
    assert(real_coefficient_checksum(&value_4.coefficient) == 5790737589827659129);
}
