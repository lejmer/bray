module bray.standard_library_tests.format_real_conversion;

using std.bytes;
using std.format;
using std.format.FixedSinkFormatting;
using std.numeric;
using std.string;
using std.testing;
using internal std.format;
using internal std.format.RealCoefficient;

func assert_real_conversion(
    pos bits: u128,
    pos fraction_bits: u32,
    pos exponent_bits: u32,
    pos coefficient: u128,
    pos exponent: i32
)
{
    let one: u128 = 1;
    let fraction: u128 = bits & ((one << fraction_bits as u128) - 1);
    let field: u32 = std.numeric.truncate_to<u32>(bits >> fraction_bits as u128);
    let actual = internal std.format.shortest_real_decimal(fraction, field, fraction_bits, exponent_bits);

    assert(actual.coefficient == coefficient);
    assert(actual.exponent == exponent);
}

@test
func all_finite_positive_binary16_values_choose_the_closest_shortest_decimal()
{
    // The digest comes from exact rational midpoint intervals with ties to even,
    // independently of Ryu. Both signs share the same magnitude conversion.
    let mut checksum: u64 = 0;

    let mut bits: u32 = 1;

    while bits < 31744
    {
        let value = internal std.format.shortest_real_decimal((bits % 1024) as u128, bits / 1024, 10, 5);

        checksum = (checksum << 7) | (checksum >> 57);
        checksum ^= std.numeric.truncate_to<u64>(value.coefficient) ^ std.numeric.truncate_to<u64>(value.exponent);
        bits += 1;
    }

    assert(checksum == 6702837057293423163);
}

func real_power_checksum(pos inverse: bool, pos limit: u32) -> u64
{
    let mut checksum: u64 = 0;
    let mut index: u32 = 0;

    while index <= limit
    {
        let value: [u64; 4] = internal std.format.real_power(index, inverse);
        let mut part: usize = 0;

        while part < 4
        {
            checksum = (checksum << 7) | (checksum >> 57);
            checksum ^= value[part];
            part += 1;
        }

        index += 1;
    }

    return checksum;
}

@test
func real_power_cache_matches_exact_powers_and_reciprocals_through_binary128()
{
    // Exact 5^i is scaled to 249 bits and truncated. Its reciprocal is
    // floor(2^(bit_length(5^i) + 248) / 5^i) + 1. Fold little-endian words
    // with rotate-left seven and xor, covering every power used by binary128.
    assert(real_power_checksum(false, 4967) == 6524634665978581620);

    assert(real_power_checksum(true, 4896) == 3401574218191106991);
}

trusted func assert_binary_real_format(
    pos bits: u128,
    pos fraction_bits: u32,
    pos exponent_bits: u32,
    pos expected: string,
    options: std.format.Options = std.format.Options(),
)
    requires(blocking_execution())
{
    let value = internal std.format.make_real_rendering(bits, fraction_bits, exponent_bits, &options);
    let mut storage: bytes<1024> = [0; 1024];
    let mut sink: std.format.FixedSink = std.format.FixedSink(&mut storage[..]);

    std.testing.assert_ok<unit, std.format.FixedSinkError>(
        internal std.format.write_real_rendering<std.format.FixedSink, std.format.FixedSinkError>(
            &mut sink,
            &value,
            &options
        )
    );

    let length: usize = std.format.finish_fixed(sink);

    assert(std.bytes.equals(&storage[0..length], expected.as_bytes()));
}

@test
trusted func every_ieee_width_preserves_zero_infinity_and_nan_signs()
{
    let widths: [u32; 4] = [10, 23, 52, 112];
    let exponents: [u32; 4] = [5, 8, 11, 15];
    let one: u128 = 1;
    let mut index: usize = 0;

    while index < 4
    {
        let fraction: u32 = widths[index];
        let exponent: u32 = exponents[index];
        let sign: u128 = one << (fraction + exponent) as u128;
        let infinity: u128 = ((one << exponent as u128) - 1) << fraction as u128;
        let quiet: u128 = one << (fraction - 1) as u128;

        assert_binary_real_format(0, fraction, exponent, "0");
        assert_binary_real_format(sign, fraction, exponent, "-0");
        assert_binary_real_format(0, fraction, exponent, "0.00", options = std.format.Options(precision = 2));
        assert_binary_real_format(sign, fraction, exponent, "-0.00", options = std.format.Options(precision = 2));
        assert_binary_real_format(infinity, fraction, exponent, "inf");
        assert_binary_real_format(infinity | sign, fraction, exponent, "-inf");
        assert_binary_real_format(infinity | quiet, fraction, exponent, "nan");
        assert_binary_real_format(infinity | 1, fraction, exponent, "nan");
        assert_binary_real_format(infinity | quiet | sign, fraction, exponent, "-nan");

        assert_binary_real_format(
            infinity | quiet | 3,
            fraction,
            exponent,
            "+NAN",
            options = std.format.Options(
                radix = std.format.Radix.HexadecimalUppercase,
                precision = 100,
                sign = std.format.Sign.Always
            )
        );

        index += 1;
    }
}

@test
func binary32_edges_and_sampled_values_match_exact_midpoint_intervals()
{
    assert_real_conversion(1, 23, 8, 1, -45);
    assert_real_conversion(2, 23, 8, 3, -45);
    assert_real_conversion(8388607, 23, 8, 11754942, -45);
    assert_real_conversion(8388608, 23, 8, 11754944, -45);
    assert_real_conversion(8388609, 23, 8, 11754945, -45);
    assert_real_conversion(2139095039, 23, 8, 34028235, 31);
    assert_real_conversion(1065353216, 23, 8, 1, 0);
    assert_real_conversion(1065353217, 23, 8, 10000001, -7);
    assert_real_conversion(1443719396, 23, 8, 3887041, 7);
    assert_real_conversion(1570475934, 23, 8, 1401169, 12);
    assert_real_conversion(1546652446, 23, 8, 19820728, 10);
    assert_real_conversion(869964881, 23, 8, 1017985, -13);
    assert_real_conversion(1012100274, 23, 8, 12904333, -9);
    assert_real_conversion(624393751, 23, 8, 15915441, -23);
    assert_real_conversion(348602845, 23, 8, 20119843, -33);
    assert_real_conversion(1426676330, 23, 8, 9438839, 6);
    assert_real_conversion(1119259711, 23, 8, 9127392, -5);
    assert_real_conversion(217074279, 23, 8, 37022634, -38);
    assert_real_conversion(914181099, 23, 8, 37744128, -13);
    assert_real_conversion(833624428, 23, 8, 51251643, -16);
    assert_real_conversion(390025545, 23, 8, 61818025, -32);
    assert_real_conversion(1245470176, 23, 8, 30862, 2);
    assert_real_conversion(2306548, 23, 8, 3232162, -45);
    assert_real_conversion(960718465, 23, 8, 18634835, -11);
}

