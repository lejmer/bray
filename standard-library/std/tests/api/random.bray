module bray.standard_library_tests.random;

using std.random;
using std.bytes;
using std.testing;

@test
func deterministic_generators_repeat_the_seeded_sequence()
{
    let seed: bytes<32> = [1; 32];
    let mut generator: std.random.Generator = std.random.Generator(seed = seed);

    assert(generator.next_u64() == 10851025925711500946);
    assert(generator.next_u64() == 10851025925711500946);
    assert(generator.next_u64() == 3255307777710489645);
    assert(generator.next_u64() == 14106333703421990591);
}

@test
func deterministic_generators_fill_bytes_in_sequence_order()
{
    let mut seed: bytes<32> = [1; 32];

    seed[0] = 2;

    let mut generator: std.random.Generator = std.random.Generator(seed = seed);
    let mut bytes: bytes<17> = [0; 17];
    let expected: bytes<17> = [146, 150, 150, 150, 150, 150, 150, 150, 18, 173, 150, 150, 150, 150, 150, 150, 173];

    generator.fill(&mut bytes[..]);

    assert(std.bytes.equals(&bytes[..], &expected[..]));
    assert(generator.next_u64() == 14106333704176971071);
}

@test
func all_zero_seed_uses_the_specified_nonzero_state()
{
    let seed: bytes<32> = [0; 32];
    let mut generator: std.random.Generator = std.random.Generator(seed = seed);

    assert(generator.next_u64() == 0);
    assert(generator.next_u64() == 16155200969329072355);
    assert(generator.next_u64() == 16155200969329072355);
}

@test
func system_entropy_provider_accepts_a_native_request()
{
    let mut bytes: bytes<32> = [0; 32];

    std.testing.assert_ok<unit, std.random.EntropyError>(std.random.fill_entropy(&mut bytes[..]));
}
