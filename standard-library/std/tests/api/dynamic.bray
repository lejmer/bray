@target(target.platform.dynamic_loading)
module bray.standard_library_tests.dynamic;

using std.dynamic;
using std.ffi;
using std.path;
using std.testing;

@test
trusted func dynamic_libraries_resolve_typed_symbols_and_close_owners() -> Result<unit, std.ffi.ForeignError>
    uses(foreign_call, layout_reinterpret)
{
    let relative_result: Result<std.path.Path, std.path.PathError> = std.path.Path.from_string(&"ambient-loader-name");
    let relative: std.path.Path = std.testing.assert_ok<std.path.Path, std.path.PathError>(relative_result);

    let relative_open: Result<std.dynamic.DynamicLibrary, std.ffi.ForeignError> = std.dynamic.DynamicLibrary.open(
        &relative,
        policy = std.dynamic.LoadPolicy.PlatformDefault,
    );

    let relative_error: std.ffi.ForeignError = std.testing.assert_error<
        std.dynamic.DynamicLibrary,
        std.ffi.ForeignError
    >(relative_open);

    assert(relative_error.kind() matches std.ffi.ForeignErrorKind.InvalidInput);

    let mut library: std.dynamic.DynamicLibrary = try std.dynamic.DynamicLibrary.open(
        std.dynamic.SystemLibrary.CRuntime,
        policy = std.dynamic.LoadPolicy.PlatformDefault,
    );

    let invalid: bytes = b"\0";

    let invalid_result: Result<std.dynamic.DynamicSymbol<u8>, std.ffi.ForeignError> = trusted library.symbol<u8>(
        &invalid[..]
    );

    let invalid_error: std.ffi.ForeignError = std.testing.assert_error<
        std.dynamic.DynamicSymbol<u8>,
        std.ffi.ForeignError
    >(invalid_result);

    assert(invalid_error.kind() matches std.ffi.ForeignErrorKind.InvalidInput);

    {
        let missing_name: bytes = b"bray_missing_symbol";

        let missing: Result<std.dynamic.DynamicSymbol<u8>, std.ffi.ForeignError> = trusted library.symbol<u8>(
            &missing_name[..]
        );

        let missing_error: std.ffi.ForeignError = std.testing.assert_error<
            std.dynamic.DynamicSymbol<u8>,
            std.ffi.ForeignError
        >(missing);

        assert(missing_error.kind() matches std.ffi.ForeignErrorKind.UnavailableSymbol);

        let name: bytes = b"strlen";
        let _: std.dynamic.DynamicSymbol<u8> = try trusted library.symbol<u8>(&name[..]);
    }

    return library.close();
}

@test
trusted func dynamic_library_handle_transfer_disables_owner_cleanup() -> Result<unit, std.ffi.ForeignError>
    uses(foreign_call, layout_reinterpret)
{
    let mut library: std.dynamic.DynamicLibrary = try std.dynamic.DynamicLibrary.open(
        std.dynamic.SystemLibrary.CRuntime,
        policy = std.dynamic.LoadPolicy.PlatformDefault,
    );

    let handle: u64 = try trusted library.into_handle();
    let status = trusted internal std.dynamic.platform_dynamic_library_close(handle);

    return internal std.ffi.checked_foreign_status(status);
}
