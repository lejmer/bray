module bray.standard_library_tests.memory;

using std.memory;
using internal std.memory;

struct BorrowOutput
{
    value: &u32;
}

@test
trusted func layouts_and_raw_buffers() -> Result<unit, std.memory.MemoryLayoutError>
    uses(layout_reinterpret, manual_alloc, raw_memory, unchecked_init)
{
    let layout: std.memory.MemoryLayout = try std.memory.layout_of<u32>(count = 3);

    assert(std.memory.size_of<u32>() == 4);
    assert(std.memory.align_of<u32>() > 0);
    assert(std.memory.stride_of<u32>() >= std.memory.size_of<u32>());

    assert(layout.bytes == std.memory.stride_of<u32>() * 3);
    assert(layout.align == std.memory.align_of<u32>());

    let null_pointer: RawPointer<u32> = std.memory.null<u32>();

    assert(std.memory.is_null<u32>(null_pointer));

    let mut buffer: std.memory.RawBuffer<u32> = try trusted std.memory.RawBuffer<u32>(capacity = 2);
    trusted internal std.memory.initialize_spare<u32>(&mut buffer, 10);
    trusted internal std.memory.initialize_spare<u32>(&mut buffer, 20);

    let values: &[u32] = trusted std.memory.initialized_slice<u32>(&buffer);

    assert(std.memory.capacity<u32>(&buffer) == 2);
    assert(std.memory.initialized_count<u32>(&buffer) == 2);
    assert(values[0] == 10);
    assert(values[1] == 20);

    let mutable: &mut [u32] = trusted std.memory.initialized_slice_mut<u32>(&mut buffer);

    mutable[1] = 30;

    assert(trusted std.memory.read<u32>(std.memory.address_of<u32>(&mutable[1])) == 30);

    return Ok(unit);
}

@test
trusted func protected_output_and_in_place_construction()
{
    assert(std.memory.size_of<Uninit<BorrowOutput>>() == std.memory.size_of<BorrowOutput>());
    assert(std.memory.align_of<Uninit<BorrowOutput>>() == std.memory.align_of<BorrowOutput>());

    let source: u32 = 41;
    let mut output: std.memory.Output<BorrowOutput> = std.memory.Output<BorrowOutput>();

    let borrowed: BorrowOutput =
    {
        value = &source,
    };

    let output_value: BorrowOutput = match consume output.write(borrowed)
    {
        case value { yield value; }
    };

    assert(output_value.value == 41);

    let mut storage: Uninit<u32> = std.memory.uninit<u32>();

    {
        let mut placement: std.memory.InPlace<u32> = std.memory.in_place<u32>(&mut storage);
        let placed: &mut u32 = placement.write(42);

        assert(placed == 42);
    };
}
