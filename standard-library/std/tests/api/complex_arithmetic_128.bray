module bray.standard_library_tests.complex_arithmetic;

using std.format;

func add_128(pos left: c128, pos right: c128) -> c128
{
    return left + right;
}

func subtract_128(pos left: c128, pos right: c128) -> c128
{
    return left - right;
}

func multiply_128(pos left: c128, pos right: c128) -> c128
{
    return left * right;
}

func divide_128(pos left: c128, pos right: c128) -> c128
{
    return left / right;
}

func power_128(pos left: c128, pos right: c128) -> c128
{
    return left ** right;
}

const PRODUCT_128: c128 = (3.0 + 4.0i) * (1.0 + 1.0i);

const QUOTIENT_128: c128 = (3.0 + 4.0i) / (1.0 + 1.0i);

const POWER_128: c128 = (1.0 + 1.0i) ** (2.0 + 0.0i);

@test
func ordinary_complex_128_operators_and_compound_assignments_execute()
{
    let left: c128 = 3.0 + 4.0i;
    let right: c128 = 1.0 + 1.0i;
    let exponent: c128 = 2.0 + 0.0i;
    let sum: c128 = 4.0 + 5.0i;
    let difference: c128 = 2.0 + 3.0i;
    let product: c128 = -1.0 + 7.0i;
    let quotient: c128 = 3.5 + 0.5i;
    let squared: c128 = 0.0 + 2.0i;
    let negative: c128 = -3.0 - 4.0i;

    assert(add_128(left, right) == sum);
    assert(subtract_128(left, right) == difference);
    assert(multiply_128(left, right) == product);
    assert(divide_128(left, right) == quotient);
    assert(power_128(right, exponent) == squared);
    assert(-left == negative);
    assert(PRODUCT_128 == product);
    assert(QUOTIENT_128 == quotient);
    assert(POWER_128 == squared);
    assert(generic_complex_product<c128>(left, right) == product);
    assert(generic_complex_quotient<c128>(left, right) == quotient);
    assert(generic_complex_power<c128>(right, exponent) == squared);
    assert(generic_complex_negation<c128>(left) == negative);

    let mut assigned = left;

    assigned += right;
    assert(assigned == sum);
    assigned -= right;
    assert(assigned == left);
    assigned *= right;
    assert(assigned == product);
    assigned /= right;
    assert(assigned == left);
    assigned **= exponent;
    assert(assigned == (-7.0 + 24.0i));
}

@test
trusted func complex_division_and_power_preserve_extreme_values_and_branch_cuts()
{
    let largest: c128 = 1.7976931348623157e308 + 1.7976931348623157e308i;
    let smallest: c128 = 5e-324 + 5e-324i;
    let one: c128 = 1.0 + 0.0i;
    let zero: c128 = 0.0 + 0.0i;
    let half: c128 = 0.5 + 0.0i;
    let above: c128 = -1.0 + 0.0i;
    let below: c128 = -1.0 - 0.0i;
    let positive_root = power_128(above, half);
    let negative_root = power_128(below, half);
    let infinity = divide_128(one, zero);
    let nan = divide_128(zero, zero);
    let ordinary: c128 = 1.0 + 1.0i;
    let general_power = power_128(ordinary, ordinary);
    let (real, imaginary): (u128, u128) = internal std.format.complex128_bits(&general_power);

    assert(divide_128(largest, largest) == one);
    assert(divide_128(smallest, smallest) == one);
    assert(positive_root == (0.0 + 1.0i));
    assert(negative_root == (0.0 - 1.0i));
    assert(nan != nan);
    assert(infinity != infinity);
    assert(power_128(nan, zero) == one);
    assert(power_128(one, nan) == one);
    assert(real == 0x3fd18884016cf327);
    assert(imaginary == 0x3fe2adad36b098a9);

    let two: c128 = 2.0 + 0.0i;
    let positive_axis: c128 = 1.7976931348623157e308 + 0.0i;
    let axis_infinity = multiply_128(positive_axis, two);

    assert(power_128(two, axis_infinity) == axis_infinity);
    assert(power_128(half, axis_infinity) == zero);
    assert(power_128(two, -axis_infinity) == zero);
    assert(power_128(half, -axis_infinity) == axis_infinity);

    let below_positive_axis: c128 = 1.7976931348623157e308 - 0.0i;
    let below_axis_infinity = power_128(below_positive_axis, two);
    let root_above_infinity = power_128(axis_infinity, half);
    let root_below_infinity = power_128(below_axis_infinity, half);

    let (root_above_real, root_above_imaginary): (u128, u128) = internal std.format.complex128_bits(
        &root_above_infinity
    );

    let (root_below_real, root_below_imaginary): (u128, u128) = internal std.format.complex128_bits(
        &root_below_infinity
    );

    assert(root_above_real == 0x7ff0000000000000);
    assert(root_above_imaginary == 0);
    assert(root_below_real == 0x7ff0000000000000);
    assert(root_below_imaginary == 0x8000000000000000);

    let tiny_numerator: c128 = 4.440892098500626e-16 + 5e-324i;
    let huge_denominator: c128 = 8.98846567431158e307 + 8.98846567431158e307i;
    let rounded = divide_128(tiny_numerator, huge_denominator);
    let (rounded_real, rounded_imaginary): (u128, u128) = internal std.format.complex128_bits(&rounded);

    assert(rounded_real == 1);
    assert(rounded_imaginary == 0x8000000000000000);

    let negative_zero: c128 = -0.0 + 0.0i;
    let negative_infinity = divide_128(ordinary, negative_zero);
    let (negative_real, negative_imaginary): (u128, u128) = internal std.format.complex128_bits(&negative_infinity);

    assert(negative_real == 0xfff0000000000000);
    assert(negative_imaginary == 0xfff0000000000000);

    let both_infinite = divide_128(ordinary, zero);
    let recovered = divide_128(ordinary, both_infinite);
    let zero_product = multiply_128(zero, both_infinite);
    let negated_zero = -zero;
    let (zero_real, zero_imaginary): (u128, u128) = internal std.format.complex128_bits(&negated_zero);

    assert(recovered == zero);
    assert(zero_product != zero_product);
    assert(zero_real == 0x8000000000000000);
    assert(zero_imaginary == 0x8000000000000000);
}
