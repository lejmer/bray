module bray.standard_library_tests.testing;

using std.testing;

@test
func testing_result_assertions_return_the_selected_payload()
{
    let ok: i32 = std.testing.assert_ok<i32, unit>(Ok(41));
    let error: i32 = std.testing.assert_error<unit, i32>(Error(42));

    assert(ok == 41);
    assert(error == 42);
}

@test
func testing_completed_assertion_returns_the_selected_payload()
{
    let completed: i32 = std.testing.assert_completed<i32>(RunResult.Completed(43));

    assert(completed == 43);
}

@test
func testing_panicked_assertion_returns_the_selected_report()
{
    let caught_for_panicked: Result<unit, PanicReport> = catch
    {
        panic("expected panic");

        yield unit;
    };

    let panicked_report: PanicReport = std.testing.assert_error<unit, PanicReport>(caught_for_panicked);
    let returned_report: PanicReport = std.testing.assert_panicked<unit>(RunResult.Panicked(panicked_report));

    returned_report;
}

@test
func testing_not_completed_assertion_accepts_a_panicked_run()
{
    let caught_for_not_completed: Result<unit, PanicReport> = catch
    {
        panic("expected panic");

        yield unit;
    };

    let not_completed_report: PanicReport = std.testing.assert_error<unit, PanicReport>(caught_for_not_completed);

    std.testing.assert_not_completed<unit>(RunResult.Panicked(not_completed_report));
}

@test
func testing_cancelled_assertions_accept_a_cancelled_run()
{
    std.testing.assert_cancelled<unit>(RunResult.Cancelled);
    std.testing.assert_not_completed<unit>(RunResult.Cancelled);
}
