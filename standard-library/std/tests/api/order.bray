module bray.standard_library_tests.order;

using std.order;
using std.testing;
using std.order.OrderingEquatable;

struct NumberSequence
{
    mut values: [i32; 4];
}

impl NumberSequenceOrdering = NumberSequence(std.order.OrderedSequence)
{
    type Element = i32;

    func order_length() -> usize
    {
        return 4;
    }

    func compare_indices(pos left: usize, pos right: usize) -> Ordering
    {
        if self.values[left] < self.values[right]
        {
            return Ordering.Less;
        }

        if self.values[left] > self.values[right]
        {
            return Ordering.Greater;
        }

        return Ordering.Equal;
    }

    func compare_value(pos index: usize, pos value: &i32) -> Ordering
    {
        if self.values[index] < value
        {
            return Ordering.Less;
        }

        if self.values[index] > value
        {
            return Ordering.Greater;
        }

        return Ordering.Equal;
    }

    mut func swap_indices(pos left: usize, pos right: usize) -> unit
    {
        let value: i32 = self.values[left];

        self.values[left] = self.values[right];
        self.values[right] = value;
    }
}

@test
func ordering_helpers()
{
    assert(std.order.reverse(Ordering.Less) == Ordering.Greater);
    assert(std.order.then(Ordering.Equal, Ordering.Greater) == Ordering.Greater);
    assert(std.order.minimum(3, 7) == 3);
    assert(std.order.maximum(3, 7) == 7);
    assert(std.order.clamp(8, minimum = 2, maximum = 5) == 5);
    assert(std.order.reverse(Ordering.Equal) == Ordering.Equal);
    assert(std.order.then(Ordering.Less, Ordering.Greater) == Ordering.Less);
    assert(std.order.clamp(1, minimum = 2, maximum = 5) == 2);
    assert(std.order.clamp(4, minimum = 2, maximum = 5) == 4);
}

@test
func ordering_algorithms()
{
    let mut stable: NumberSequence = NumberSequence
    {
        values = [4, 1, 3, 2],
    };

    stable.sort_stable();

    assert(stable.values[0] == 1);
    assert(stable.values[1] == 2);
    assert(stable.values[2] == 3);
    assert(stable.values[3] == 4);

    let found_value: i32 = 3;
    let searched_value: i32 = 4;
    let found: usize? = stable.find(&found_value);
    let searched: usize? = stable.binary_search(&searched_value);

    let found_index: usize = std.testing.assert_present<usize>(found);
    let searched_index: usize = std.testing.assert_present<usize>(searched);

    assert(found_index == 2);
    assert(searched_index == 3);

    let absent_value: i32 = 8;
    let absent: usize? = stable.find(&absent_value);
    let unsearchable: usize? = stable.binary_search(&absent_value);

    std.testing.assert_absent<usize>(absent);
    std.testing.assert_absent<usize>(unsearchable);

    let mut unstable: NumberSequence = NumberSequence
    {
        values = [2, 4, 1, 3],
    };

    unstable.sort_unstable();

    assert(unstable.values[0] == 1);
    assert(unstable.values[1] == 2);
    assert(unstable.values[2] == 3);
    assert(unstable.values[3] == 4);
}
