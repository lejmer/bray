module bray.standard_library_tests.bytes;

using std.bytes;
using std.memory;
using std.testing;

@test
func byte_slice_operations()
{
    let first: u8 = 65;
    let second: u8 = 66;
    let bytes: [u8; 2] = [first, second];
    let length: usize = bytes[..].length();
    let equal: bool = std.bytes.equals(&bytes[..], &bytes[..]);

    assert(length == 2);
    assert(equal);
}

@test
trusted func byte_buffer_mutation() -> Result<unit, std.memory.MemoryLayoutError>
{
    let empty: std.bytes.Buffer = try std.bytes.Buffer();
    let initial: [u8; 2] = [65, 66];
    let mut buffer: std.bytes.Buffer = try std.bytes.Buffer.from_slice(&initial[..]);

    assert(std.bytes.length(&empty) == 0);
    assert(std.bytes.length(&buffer) == 2);
    assert(std.bytes.capacity(&buffer) == 2);

    try trusted std.bytes.push(&mut buffer, value = 67);
    try trusted std.bytes.append(&mut buffer, 68, 2);

    let appended: [u8; 2] = [69, 70];

    try trusted std.bytes.append(&mut buffer, bytes = &appended[..]);

    let values: &[u8] = buffer.as_slice();

    assert(std.bytes.length(&buffer) == 7);
    assert(std.bytes.capacity(&buffer) >= 7);

    assert(values[0] == 65);
    assert(values[2] == 67);
    assert(values[4] == 68);
    assert(values[6] == 70);

    let removed: u8? = trusted std.bytes.pop(&mut buffer);

    let removed_value: u8 = std.testing.assert_present<u8>(removed);

    assert(removed_value == 70);

    try trusted std.bytes.resize(&mut buffer, new_length = 8, fill = 90);

    let resized: &mut [u8] = buffer.as_slice_mut();

    assert(resized[6] == 90);
    assert(resized[7] == 90);

    resized[0] = 97;

    trusted std.bytes.truncate(&mut buffer, new_length = 1);

    assert(std.bytes.length(&buffer) == 1);
    assert(buffer.as_slice()[0] == 97);

    std.bytes.clear(&mut buffer);

    assert(std.bytes.length(&buffer) == 0);
    assert(std.bytes.equals(buffer.as_slice(), buffer.as_slice()));

    let exhausted: u8? = trusted std.bytes.pop(&mut buffer);

    std.testing.assert_absent<u8>(exhausted);

    return Ok(unit);
}

@test
func byte_slice_comparison_boundaries()
{
    let first: [u8; 2] = [1, 2];
    let same: [u8; 2] = [1, 2];
    let different_value: [u8; 2] = [1, 3];
    let different_length: [u8; 1] = [1];

    assert(std.bytes.equals(&first[..], &same[..]));
    assert(!std.bytes.equals(&first[..], &different_value[..]));
    assert(!std.bytes.equals(&first[..], &different_length[..]));
}

@test
trusted func byte_buffer_growth_and_exact_reservation() -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut buffer: std.bytes.Buffer = try std.bytes.Buffer(capacity = 0);

    try trusted std.bytes.push(&mut buffer, value = 1);

    assert(std.bytes.capacity(&buffer) == 4);

    try trusted std.bytes.push(&mut buffer, value = 2);
    try trusted std.bytes.push(&mut buffer, value = 3);
    try trusted std.bytes.push(&mut buffer, value = 4);

    assert(std.bytes.capacity(&buffer) == 4);

    try trusted std.bytes.push(&mut buffer, value = 5);

    assert(std.bytes.capacity(&buffer) == 8);

    try trusted std.bytes.reserve_exact(&mut buffer, additional = 5);

    assert(std.bytes.capacity(&buffer) == 10);

    try trusted std.bytes.reserve_exact(&mut buffer, additional = 1);

    assert(std.bytes.capacity(&buffer) == 10);

    return Ok(unit);
}

@test
trusted func byte_buffer_growth_reports_length_overflow() -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut buffer: std.bytes.Buffer = try std.bytes.Buffer(capacity = 1);

    try trusted std.bytes.push(&mut buffer, value = 1);

    let result: Result<unit, std.memory.MemoryLayoutError> = trusted std.bytes.reserve(&mut buffer, additional = ~0);

    match std.testing.assert_error<unit, std.memory.MemoryLayoutError>(result)
    {
        case std.memory.MemoryLayoutError.SizeOverflow { assert(true); }
        case _ { assert(false); }
    }

    return Ok(unit);
}

@test
trusted func full_byte_buffer_append_relocates_before_initializing_spare_storage(
) -> Result<unit, std.memory.MemoryLayoutError>
{
    let mut buffer: std.bytes.Buffer = try std.bytes.Buffer(capacity = 24);

    try trusted std.bytes.resize(&mut buffer, new_length = 24, fill = 7);
    try trusted std.bytes.push(&mut buffer, value = 9);

    assert(std.bytes.length(&buffer) == 25);
    assert(std.bytes.capacity(&buffer) == 48);

    let values: &[u8] = buffer.as_slice();

    assert(values[0] == 7);
    assert(values[23] == 7);
    assert(values[24] == 9);

    return Ok(unit);
}
