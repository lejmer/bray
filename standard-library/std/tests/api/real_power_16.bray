@target(target.scalar.R16)
module bray.standard_library_tests.real_power;

func power_16(pos base: r16, pos exponent: r16) -> r16
{
    return base ** exponent;
}

const CLOSED_POWER_16: r16 = (-2.0) ** 3.0;

const CLOSED_ROOT_16: r16 = 9.0 ** 0.5;

const CLOSED_DOMAIN_16: r16 = (-2.0) ** 0.5;

@test
func real_16_powers_preserve_domain_and_dispatch()
{
    let base: r16 = -2.0;
    let exponent: r16 = 3.0;
    let expected: r16 = -8.0;
    let mut assigned = base;

    assert(power_16(base, exponent) == expected);
    assert(generic_power<r16>(base, exponent) == expected);
    assert(CLOSED_POWER_16 == expected);
    assert(CLOSED_ROOT_16 == 3.0);
    assert(CLOSED_DOMAIN_16 != CLOSED_DOMAIN_16);
    assigned **= exponent;
    assert(assigned == expected);
    assert(power_16(16.0, 0.25) == 2.0);
    assert(power_16(2.0, -3.0) == 0.125);
}
