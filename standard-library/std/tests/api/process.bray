module bray.standard_library_tests.process;

using std.io;
using std.path;
using std.process;
using std.testing;
using internal std.process.ChildOutputReader;
using std.process.current_environment_value;

@test
func process_context_accessors_observe_one_snapshot()
{
    let _: std.process.Id = std.process.current_id();
    let _: std.path.Path = std.process.current_directory();
    let arguments: std.process.Arguments = std.process.arguments();
    let argument_count: usize = arguments.length();

    std.testing.assert_absent<std.path.NativeText>(arguments.value_at(argument_count));

    if argument_count > 0
    {
        let _: std.path.NativeText = std.testing.assert_present<std.path.NativeText>(arguments.value_at(0));
    }

    let environment: std.process.Environment = std.process.environment();
    let environment_count: usize = environment.length();

    std.testing.assert_absent<std.process.EnvironmentEntry>(environment.entry_at(environment_count));

    if environment_count > 0
    {
        let first_entry: std.process.EnvironmentEntry? = environment.entry_at(0);

        let entry: std.process.EnvironmentEntry = std.testing.assert_present<std.process.EnvironmentEntry>(first_entry);
        let _: std.path.NativeText = std.testing.assert_present<std.path.NativeText>(environment.value(&entry.key));
    }
}

@test
func direct_environment_lookup_matches_the_process_snapshot()
{
    let key: std.path.NativeText = required_native_text("BRAY_STANDARD_LIBRARY_TEST_EXECUTABLE");
    let snapshot: std.path.NativeText? = std.process.environment().value(&key);

    let direct: std.path.NativeText? = std.testing.assert_ok<std.path.NativeText?, std.io.IoError>(
        std.process.current_environment_value(&key)
    );

    match consume snapshot
    {
        case ?snapshot_value
        {
            let direct_value: std.path.NativeText = std.testing.assert_present<std.path.NativeText>(direct);

            assert(
                std.testing.assert_ok<string, std.path.PathError>(snapshot_value.to_string()) == std.testing.assert_ok<
                    string,
                    std.path.PathError
                >(direct_value.to_string())
            );
        }
        case none { std.testing.assert_absent<std.path.NativeText>(direct); }
    }
}

@test(serial)
func child_processes_capture_output_and_reap_cleanly()
{
    let executable: std.path.Path = required_child_executable();
    let mut command: std.process.ChildCommand = required_child_command(executable);
    let input_policy: std.process.ChildStreamPolicy = std.process.ChildStreamPolicy.Null;
    let output_policy: std.process.ChildStreamPolicy = std.process.ChildStreamPolicy.Piped;
    let error_policy: std.process.ChildStreamPolicy = std.process.ChildStreamPolicy.Null;

    required_argument(&mut command, "--help");
    command.standard_input(policy = input_policy);
    command.standard_output(policy = output_policy);
    command.standard_error(policy = error_policy);

    let mut child: std.process.ChildProcess = required_child(command);
    let mut output: std.process.ChildOutput = required_output(child.take_standard_output());
    let observed: usize = read_all(&mut output);

    required_close(output);

    let status: std.process.ExitStatus = required_wait(child);

    assert(observed > 0);

    assert(status matches Code(0));
}

@test(serial)
func child_processes_accept_an_empty_environment()
{
    let executable: std.path.Path = required_child_executable();
    let mut command: std.process.ChildCommand = required_child_command(executable);

    std.testing.assert_ok<unit, std.process.ChildError>(
        command.environment_policy(policy = std.process.EnvironmentPolicy.Empty)
    );

    required_argument(&mut command, "--help");
    command.standard_input(policy = std.process.ChildStreamPolicy.Null);
    command.standard_output(policy = std.process.ChildStreamPolicy.Null);
    command.standard_error(policy = std.process.ChildStreamPolicy.Null);

    let status: std.process.ExitStatus = required_wait(required_child(command));

    assert(status matches Code(0));
}

func required_child_executable() -> std.path.Path
{
    let key: std.path.NativeText = required_native_text("BRAY_STANDARD_LIBRARY_TEST_EXECUTABLE");
    let environment: std.process.Environment = std.process.environment();

    let value: std.path.NativeText = std.testing.assert_present<std.path.NativeText>(environment.value(&key));

    return std.testing.assert_ok<std.path.Path, std.path.PathError>(std.path.Path.from_native(value));
}

func required_native_text(pos value: string) -> std.path.NativeText
{
    return std.testing.assert_ok<std.path.NativeText, std.path.PathError>(std.path.NativeText.from_string(&value));
}

func required_child_command(pos executable: std.path.Path) -> std.process.ChildCommand
{
    return std.testing.assert_ok<std.process.ChildCommand, std.process.ChildError>(
        std.process.ChildCommand(executable)
    );
}

func required_argument(pos command: &mut std.process.ChildCommand, pos value: string)
{
    std.testing.assert_ok<unit, std.process.ChildError>(command.argument(required_native_text(value)));
}

func required_child(pos command: std.process.ChildCommand) -> std.process.ChildProcess
{
    return std.testing.assert_ok<std.process.ChildProcess, std.process.ChildError>(command.spawn());
}

func required_output(pos output: std.process.ChildOutput?) -> std.process.ChildOutput
{
    return std.testing.assert_present<std.process.ChildOutput>(output);
}

func read_all(pos output: &mut std.process.ChildOutput) -> usize
{
    let mut buffer: bytes<256> = [0; 256];
    let mut observed: usize = 0;

    loop
    {
        match output(std.io.Reader).read(&mut buffer[..])
        {
            case Ok(0) { return observed; }
            case Ok(read) { observed += read; }
            case Error(_) { panic("child output must be readable"); }
        }
    }
}

func required_close(pos mut output: std.process.ChildOutput)
{
    std.testing.assert_ok<unit, std.io.IoError>(output.close());
}

func required_wait(pos mut child: std.process.ChildProcess) -> std.process.ExitStatus
{
    return std.testing.assert_ok<std.process.ExitStatus, std.process.ChildError>(child.wait());
}
