module bray.standard_library_tests.ffi;

using std.bytes;
using std.ffi;
using std.ffi.c;
using std.memory;
using std.string;
using std.testing;
using internal std.ffi.ForeignResourceState;
using internal std.platform.PlatformStatus;

@abi(c)
func c_increment(pos value: std.ffi.c.Int) -> std.ffi.c.Int
{
    return std.ffi.c.int(value.value() + 1);
}

@symbol(name = "bray_test_stateful_callback")
@abi(c)
trusted func stateful_callback(pos context: RawPointer<i32>, pos value: i32) -> bool
    uses(raw_memory)
{
    let state = trusted std.ffi.callback_state<i32>(context);

    return state == value;
}

@test
func c_scalar_wrappers_preserve_values_and_layouts()
{
    let value: std.ffi.c.Int = c_increment(std.ffi.c.int(41));

    assert(value.value() == 42);
    assert(std.memory.size_of<std.ffi.c.Int>() == std.memory.size_of<i32>());
    assert(std.memory.align_of<std.ffi.c.Int>() == std.memory.align_of<i32>());
    assert(std.ffi.c.boolean(true).value());
    assert(!std.ffi.c.boolean(false).value());
}

@test
trusted func callback_bindings_preserve_state_ownership() -> Result<unit, std.memory.MemoryLayoutError>
    uses(manual_alloc, raw_memory, unchecked_init)
{
    let context: std.ffi.CallbackContext<i32> = try trusted std.ffi.CallbackContext<i32>(41);

    let entry: @abi(c)
    trusted func(pos context: RawPointer<i32>, pos value: i32) -> bool
        uses(raw_memory) = stateful_callback;

    let callback = trusted std.ffi.borrow_callback(&context, entry);

    assert(!std.memory.is_null<i32>(callback.context()));

    return Ok(unit);
}

@test
trusted func callback_entries_recover_state() -> Result<unit, std.memory.MemoryLayoutError>
    uses(manual_alloc, raw_memory, unchecked_init)
{
    let context: std.ffi.CallbackContext<i32> = try trusted std.ffi.CallbackContext<i32>(41);

    let exported: @abi(c)
    trusted func(pos context: RawPointer<i32>, pos value: i32) -> bool
        uses(raw_memory) = stateful_callback;

    let callback = trusted std.ffi.borrow_callback(&context, exported);

    let entry: @abi(c)
    trusted func(pos context: RawPointer<i32>, pos value: i32) -> bool
        uses(raw_memory) = callback.entry();

    assert(trusted entry(callback.context(), 41));
    let _: &std.ffi.CallbackContext<i32> = callback.owner;

    return Ok(unit);
}

@test
trusted func c_strings_validate_termination_and_ownership() -> Result<unit, std.ffi.c.StringError>
    uses(layout_reinterpret, manual_alloc, raw_memory, unchecked_init)
{
    let input: [u8; 3] = [65, 66, 67];
    let owned: std.ffi.c.OwnedNarrowString = try trusted std.ffi.c.OwnedNarrowString.from_bytes(&input[..]);
    let borrowed: std.ffi.c.BorrowedNarrowString = owned.borrow();
    let bytes: &[u8] = borrowed.bytes();
    let terminated: &[u8] = borrowed.bytes_with_nul();

    assert(std.bytes.equals(bytes, &input[..]));
    assert(std.bytes.slice_length(terminated) == 4);
    assert(terminated[3] == 0);
    assert(!std.memory.is_null<u8>(borrowed.pointer()));

    let valid: [u8; 2] = [65, 0];
    let from_terminated: std.ffi.c.BorrowedNarrowString = try std.ffi.c.borrow_narrow_string(&valid[..]);

    assert(std.bytes.slice_length(from_terminated.bytes()) == 1);

    let decoded: string = try from_terminated.decode_utf8();

    assert(std.string.equals(&decoded, &"A"));

    let wide_units: [std.ffi.c.WideChar; 2] = [std.ffi.c.wide_char(65), std.ffi.c.wide_char(66)];

    let wide_owned: std.ffi.c.OwnedWideString = try trusted std.ffi.c.OwnedWideString.from_units(&wide_units[..]);

    let wide_borrowed: std.ffi.c.BorrowedWideString = wide_owned.borrow();
    let borrowed_units: &[std.ffi.c.WideChar] = wide_borrowed.units();
    let terminated_units: &[std.ffi.c.WideChar] = wide_borrowed.units_with_nul();

    assert(std.memory.slice_length<std.ffi.c.WideChar>(borrowed_units) == 2);
    assert(std.memory.slice_length<std.ffi.c.WideChar>(terminated_units) == 3);
    assert(borrowed_units[0].value() == 65);
    assert(terminated_units[2].value() == 0);
    assert(!std.memory.is_null<std.ffi.c.WideChar>(wide_borrowed.pointer()));

    return Ok(unit);
}

@test
trusted func c_strings_reject_invalid_contents() -> Result<unit, std.ffi.c.StringError>
{
    let invalid: [u8; 3] = [65, 0, 66];

    match trusted std.ffi.c.OwnedNarrowString.from_bytes(&invalid[..])
    {
        case Ok(_) { assert(false); }
        case Error(error)
        {
            match error
            {
                case std.ffi.c.StringError.InteriorNul {}
                case _ { assert(false); }
            }
        }
    }

    let invalid_utf8: [u8; 2] = [255, 0];
    let encoded: std.ffi.c.BorrowedNarrowString = try std.ffi.c.borrow_narrow_string(&invalid_utf8[..]);

    match encoded.decode_utf8()
    {
        case Ok(_) { assert(false); }
        case Error(error)
        {
            match error
            {
                case std.ffi.c.StringError.InvalidEncoding {}
                case _ { assert(false); }
            }
        }
    }

    let unterminated: [u8; 1] = [65];

    match std.ffi.c.borrow_narrow_string(&unterminated[..])
    {
        case Ok(_) { assert(false); }
        case Error(error)
        {
            match error
            {
                case std.ffi.c.StringError.MissingTerminator {}
                case _ { assert(false); }
            }
        }
    }

    let wide_unterminated: [std.ffi.c.WideChar; 1] = [std.ffi.c.wide_char(65)];

    match std.ffi.c.borrow_wide_string(&wide_unterminated[..])
    {
        case Ok(_) { assert(false); }
        case Error(error)
        {
            match error
            {
                case std.ffi.c.StringError.MissingTerminator {}
                case _ { assert(false); }
            }
        }
    }

    let wide_interior: [std.ffi.c.WideChar; 3] = [
        std.ffi.c.wide_char(65),
        std.ffi.c.wide_char(0),
        std.ffi.c.wide_char(66),
    ];

    match trusted std.ffi.c.OwnedWideString.from_units(&wide_interior[..])
    {
        case Ok(_) { assert(false); }
        case Error(error)
        {
            match error
            {
                case std.ffi.c.StringError.InteriorNul {}
                case _ { assert(false); }
            }
        }
    }

    return Ok(unit);
}

@test
func foreign_errors_preserve_structured_categories_and_codes()
{
    let mut code: i64? = none;
    let native_code: i64 = 13;

    code = native_code;

    let error: std.ffi.ForeignError = std.ffi.foreign_error(
        kind = std.ffi.ForeignErrorKind.PermissionDenied,
        native_code = code,
    );

    match error.kind()
    {
        case std.ffi.ForeignErrorKind.PermissionDenied {}
        case _ { assert(false); }
    }

    match error.native_code()
    {
        case ?value { assert(value == 13); }
        case none { assert(false); }
    }
}

@test
trusted func foreign_resources_reject_invalid_handles() -> Result<unit, std.ffi.ForeignError>
{
    let mut native_code: i64? = none;
    let invalid_code: i64 = 6;

    native_code = invalid_code;

    match trusted internal std.ffi.owned_foreign_resource(0, valid = false, invalid_native_code = native_code)
    {
        case Ok(_) { assert(false); }
        case Error(error)
        {
            match error.kind()
            {
                case std.ffi.ForeignErrorKind.InvalidResource {}
                case _ { assert(false); }
            }

            match error.native_code()
            {
                case ?value { assert(value == 6); }
                case none { assert(false); }
            }
        }
    }

    return Ok(unit);
}

@test
trusted func foreign_resources_borrow_transfer_and_reject_repeated_transfer() -> Result<unit, std.ffi.ForeignError>
{
    let mut resource: std.ffi.ForeignResourceState = std.testing.assert_ok<
        std.ffi.ForeignResourceState,
        std.ffi.ForeignError
    >(trusted internal std.ffi.owned_foreign_resource(41, valid = true));

    assert(internal std.ffi.foreign_resource_is_owned(&resource));

    {
        let borrowed: &u64 = trusted internal std.ffi.borrow_foreign_resource_handle(&resource);

        assert(borrowed == 41);
    }

    let transferred: u64 = try trusted internal std.ffi.transfer_foreign_resource(&mut resource);

    assert(transferred == 41);
    assert(!internal std.ffi.foreign_resource_is_owned(&resource));

    match trusted internal std.ffi.transfer_foreign_resource(&mut resource)
    {
        case Ok(_) { assert(false); }
        case Error(error)
        {
            match error.kind()
            {
                case std.ffi.ForeignErrorKind.InvalidResource {}
                case _ { assert(false); }
            }
        }
    }

    return Ok(unit);
}

@test
trusted func foreign_resource_release_consumes_successful_and_failed_owners() -> Result<unit, std.ffi.ForeignError>
{
    let success: std.platform.PlatformStatus =
    {
        category = 0,
        reserved = 0,
        native_code = 0,
    };

    {
        let mut released: std.ffi.ForeignResourceState = std.testing.assert_ok<
            std.ffi.ForeignResourceState,
            std.ffi.ForeignError
        >(trusted internal std.ffi.owned_foreign_resource(42, valid = true));

        try trusted internal std.ffi.resolve_foreign_resource_release(&mut released, success);

        assert(!internal std.ffi.foreign_resource_is_owned(&released));

        let repeated_release: std.platform.PlatformStatus =
        {
            category = 0,
            reserved = 0,
            native_code = 0,
        };

        match trusted internal std.ffi.resolve_foreign_resource_release(&mut released, repeated_release)
        {
            case Ok(_) { assert(false); }
            case Error(error)
            {
                match error.kind()
                {
                    case std.ffi.ForeignErrorKind.InvalidResource {}
                    case _ { assert(false); }
                }
            }
        }
    }

    let denied: std.platform.PlatformStatus =
    {
        category = 2,
        reserved = 0,
        native_code = 13,
    };

    {
        let mut failed: std.ffi.ForeignResourceState = std.testing.assert_ok<
            std.ffi.ForeignResourceState,
            std.ffi.ForeignError
        >(trusted internal std.ffi.owned_foreign_resource(43, valid = true));

        match trusted internal std.ffi.resolve_foreign_resource_release(&mut failed, denied)
        {
            case Ok(_) { assert(false); }
            case Error(error)
            {
                match error.kind()
                {
                    case std.ffi.ForeignErrorKind.PermissionDenied {}
                    case _ { assert(false); }
                }

                match error.native_code()
                {
                    case ?value { assert(value == 13); }
                    case none { assert(false); }
                }
            }
        }

        assert(!internal std.ffi.foreign_resource_is_owned(&failed));

        match trusted internal std.ffi.transfer_foreign_resource(&mut failed)
        {
            case Ok(_) { assert(false); }
            case Error(error)
            {
                match error.kind()
                {
                    case std.ffi.ForeignErrorKind.InvalidResource {}
                    case _ { assert(false); }
                }
            }
        }
    }

    return Ok(unit);
}

@test
func foreign_platform_statuses_preserve_stable_failures()
{
    let denied: std.platform.PlatformStatus =
    {
        category = 2,
        reserved = 0,
        native_code = 13,
    };

    match internal std.ffi.checked_foreign_status(denied)
    {
        case Ok(_) { assert(false); }
        case Error(error)
        {
            match error.kind()
            {
                case std.ffi.ForeignErrorKind.PermissionDenied {}
                case _ { assert(false); }
            }

            match error.native_code()
            {
                case ?value { assert(value == 13); }
                case none { assert(false); }
            }
        }
    }

    let malformed: std.platform.PlatformStatus =
    {
        category = 0,
        reserved = 1,
        native_code = 0,
    };

    match internal std.ffi.checked_foreign_status(malformed)
    {
        case Ok(_) { assert(false); }
        case Error(error)
        {
            match error.kind()
            {
                case std.ffi.ForeignErrorKind.IncompatibleAbi {}
                case _ { assert(false); }
            }
        }
    }

    let missing: std.platform.PlatformStatus =
    {
        category = 3,
        reserved = 0,
        native_code = 126,
    };

    match internal std.ffi.checked_foreign_library_status(missing)
    {
        case Ok(_) { assert(false); }
        case Error(error)
        {
            match error.kind()
            {
                case std.ffi.ForeignErrorKind.UnavailableLibrary {}
                case _ { assert(false); }
            }

            match error.native_code()
            {
                case ?value { assert(value == 126); }
                case none { assert(false); }
            }
        }
    }

    let missing_symbol: std.platform.PlatformStatus =
    {
        category = 3,
        reserved = 0,
        native_code = 127,
    };

    match internal std.ffi.checked_foreign_symbol_status(missing_symbol)
    {
        case Ok(_) { assert(false); }
        case Error(error)
        {
            match error.kind()
            {
                case std.ffi.ForeignErrorKind.UnavailableSymbol {}
                case _ { assert(false); }
            }
        }
    }
}
