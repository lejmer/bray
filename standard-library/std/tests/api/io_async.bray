module bray.standard_library_tests.io_async;

using std.bytes;
using std.io;
using internal std.io.BufferedReaderSourceAsyncReader;
using internal std.io.BufferedWriterSinkAsyncWriter;
using std.testing;

struct AsyncCountingWriter
{
    mut calls: usize;
    mut flushes: usize;
    mut total: usize;
    mut last_request: usize;
    limit: usize;

    construct(limit: usize) -> Self
    {
        return
        {
            calls = 0,
            flushes = 0,
            total = 0,
            last_request = 0,
            limit = limit,
        };
    }
}

impl AsyncCountingWriterIo = AsyncCountingWriter(std.io.AsyncWriter)
{
    mut async func write_async(pos source: &[u8]) -> Result<usize, std.io.IoError>
        requires(blocking_execution())
    {
        let requested: usize = source.length();
        let accepted: usize = internal std.io.smaller(requested, self.limit);

        self.calls += 1;
        self.total += accepted;
        self.last_request = requested;

        return Ok(accepted);
    }

    mut async func flush_async() -> Result<unit, std.io.IoError>
        requires(blocking_execution())
    {
        self.flushes += 1;

        return Ok(unit);
    }
}

struct AsyncCountingReader
{
    mut calls: usize;
    mut remaining: usize;
    mut last_request: usize;
    limit: usize;

    construct(remaining: usize, limit: usize) -> Self
    {
        return
        {
            calls = 0,
            remaining = remaining,
            last_request = 0,
            limit = limit,
        };
    }
}

impl AsyncCountingReaderIo = AsyncCountingReader(std.io.AsyncReader)
{
    mut async func read_async(pos destination: &mut [u8]) -> Result<usize, std.io.IoError>
        requires(blocking_execution())
    {
        let requested: usize = destination.length();
        let available: usize = internal std.io.smaller(self.remaining, self.limit);
        let transferred: usize = internal std.io.smaller(requested, available);

        self.calls += 1;
        self.remaining -= transferred;
        self.last_request = requested;

        return Ok(transferred);
    }
}

struct AsyncRecoveringWriter
{
    mut bytes: [u8; 8];
    mut length: usize;
    mut fail_drain: bool;
    mut fail_flush: bool;
}

impl AsyncRecoveringWriterIo = AsyncRecoveringWriter(std.io.AsyncWriter)
{
    mut async func write_async(pos source: &[u8]) -> Result<usize, std.io.IoError>
        requires(blocking_execution())
    {
        let requested: usize = source.length();
        let mut accepted: usize = requested;

        if self.fail_drain
        {
            accepted = 2;
        }

        let mut index: usize = 0;

        while index < accepted
        {
            self.bytes[self.length + index] = source[index];
            index += 1;
        }

        self.length += accepted;

        if self.fail_drain
        {
            self.fail_drain = false;

            return Error(
                std.io.IoError
                {
                    kind = std.io.IoErrorKind.Exhausted,
                    platform_code = none,
                    transferred = accepted,
                }
            );
        }

        return Ok(accepted);
    }

    mut async func flush_async() -> Result<unit, std.io.IoError>
        requires(blocking_execution())
    {
        if self.fail_flush
        {
            self.fail_flush = false;

            return Error(
                std.io.IoError
                {
                    kind = std.io.IoErrorKind.Exhausted,
                    platform_code = none,
                    transferred = 0,
                }
            );
        }

        return Ok(unit);
    }
}

@test
async func asynchronous_standard_output_is_captured()
{
    let message: string = "captured-async-output";

    await std.io.print_async(message);

    let retained: string = message;
}

@test
async func asynchronous_bulk_transfers_and_buffering_share_the_cost_model() -> Result<unit, std.io.IoError>
{
    let bytes: [u8; 5] = [1, 2, 3, 4, 5];
    let mut writer: AsyncCountingWriter = AsyncCountingWriter(limit = 2);

    try await writer.write_all_async(&bytes[..]);

    assert(writer.calls == 3);
    assert(writer.total == 5);

    let sink: AsyncCountingWriter = AsyncCountingWriter(limit = 16);

    let mut buffered: std.io.BufferedWriter<AsyncCountingWriter> = try std.io.BufferedWriter<AsyncCountingWriter>(
        sink,
        capacity = 4
    );

    let large: [u8; 8] = [9; 8];

    let written: usize = try await buffered(std.io.AsyncWriter).write_async(&large[..]);
    let completed_sink: AsyncCountingWriter = try await buffered.into_sink_async();

    assert(written == 8);
    assert(completed_sink.calls == 1);
    assert(completed_sink.last_request == 8);
    assert(completed_sink.flushes == 1);

    let source: AsyncCountingReader = AsyncCountingReader(remaining = 8, limit = 8);

    let mut reader: std.io.BufferedReader<AsyncCountingReader> = try std.io.BufferedReader<AsyncCountingReader>(
        source,
        capacity = 4
    );

    let mut destination: [u8; 8] = [0; 8];

    try await reader.read_exact_async(&mut destination[..]);

    let completed_source: AsyncCountingReader = reader.into_source();

    assert(completed_source.calls == 1);
    assert(completed_source.last_request == 8);

    let recovering_sink: AsyncRecoveringWriter =
    {
        bytes = [0; 8],
        length = 0,
        fail_drain = true,
        fail_flush = true,
    };

    let mut recovering: std.io.BufferedWriter<AsyncRecoveringWriter> = try std.io.BufferedWriter<AsyncRecoveringWriter>(
        recovering_sink,
        capacity = 4
    );

    let full: [u8; 4] = [1, 2, 3, 4];
    let trailing: [u8; 1] = [5];

    let _: usize = try await recovering(std.io.AsyncWriter).write_async(&full[..]);

    let write_error: std.io.IoError = std.testing.assert_error<usize, std.io.IoError>(
        await recovering(std.io.AsyncWriter).write_async(&trailing[..]),
    );

    assert(write_error.transferred == 0);

    let retried: usize = try await recovering(std.io.AsyncWriter).write_async(&trailing[..]);

    assert(retried == 1);

    let flush_error: std.io.IoError = std.testing.assert_error<unit, std.io.IoError>(
        await recovering(std.io.AsyncWriter).flush_async(),
    );

    assert(flush_error.transferred == 1);

    try await recovering(std.io.AsyncWriter).flush_async();

    let recovered: AsyncRecoveringWriter = try await recovering.into_sink_async();

    assert(recovered.length == 5);
    assert(recovered.bytes[0] == 1);
    assert(recovered.bytes[1] == 2);
    assert(recovered.bytes[2] == 3);
    assert(recovered.bytes[3] == 4);
    assert(recovered.bytes[4] == 5);

    return Ok(unit);
}
