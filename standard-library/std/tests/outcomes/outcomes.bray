module bray.standard_library_tests.outcomes;

using std.memory;
using std.run;
using std.string;
using std.sync;
using std.testing;

static FIRST_ONCE: std.sync.Once<i32> = std.sync.Once<i32>.empty();

static SECOND_ONCE: std.sync.Once<i32> = std.sync.Once<i32>.empty();

static RAW_BUFFER_CLEANUP_COUNT: core.atomic.Atomic<u32> = core.atomic.initialize<u32>(0);

internal struct PanickingBufferElement
{
    value: u8;

    destruct()
    {
        let _: u32 = core.atomic.fetch_add<u32, 3>(&RAW_BUFFER_CLEANUP_COUNT, 1);

        panic("raw buffer element cleanup panic");
    }
}

trusted internal func initialized_panicking_buffer() -> std.memory.RawBuffer<PanickingBufferElement>
    uses(raw_memory, unchecked_init)
{
    let mut buffer: std.memory.RawBuffer<PanickingBufferElement> = std.testing.assert_ok<
        std.memory.RawBuffer<PanickingBufferElement>,
        std.memory.MemoryLayoutError,
    >(trusted std.memory.RawBuffer<PanickingBufferElement>(capacity = 1));

    let element: RawPointer<PanickingBufferElement> = trusted std.memory.spare_pointer<PanickingBufferElement>(
        &mut buffer
    );

    let value: PanickingBufferElement =
    {
        value = 1,
    };

    trusted std.memory.write<PanickingBufferElement>(element, value);
    trusted std.memory.set_initialized_count<PanickingBufferElement>(&mut buffer, count = 1);

    return buffer;
}

internal func initialize_first_once() -> i32
{
    let _: &i32 = SECOND_ONCE.get_or_init(initialize_second_once);

    return 1;
}

internal func initialize_second_once() -> i32
{
    let _: &i32 = FIRST_ONCE.get_or_init(initialize_first_once);

    return 2;
}

@test
func assertion_failure()
{
    assert(false, "expected assertion failure");
}

@test
trusted func invalid_allocation_alignment()
    uses(manual_alloc)
{
    let _: RawPointer<u8> = trusted core.memory.allocate(bytes = 8, align = 3);
}

@test
trusted func allocation_size_overflow()
    uses(manual_alloc)
{
    let _: RawPointer<u8> = trusted core.memory.allocate(bytes = ~0, align = 8);
}

@test
trusted func allocation_then_panic_preserves_report()
    uses(manual_alloc)
{
    let allocation: RawPointer<u8> = trusted core.memory.allocate(bytes = 8, align = 8);

    trusted core.memory.deallocate(pointer = allocation, bytes = 8, align = 8);
    panic("panic after valid allocation");
}

@test
trusted func owned_storage_then_panic_preserves_report()
    uses(manual_alloc)
{
    let layout: std.memory.MemoryLayout = std.testing.assert_ok<std.memory.MemoryLayout, std.memory.MemoryLayoutError>(
        std.memory.layout_of<u8>(count = 8)
    );

    let allocation: std.memory.RawAllocation = trusted std.memory.allocate(layout);

    trusted std.memory.deallocate(allocation);
    panic("panic after owned allocation");
}

@test
trusted func raw_buffer_release_preserves_destructor_panic()
    uses(manual_alloc)
{
    let mut buffer: std.memory.RawBuffer<PanickingBufferElement> = trusted internal initialized_panicking_buffer();

    trusted internal std.memory.raw_buffer_release<PanickingBufferElement>(&mut buffer);
}

@test
trusted func raw_buffer_replace_preserves_destructor_panic()
    uses(manual_alloc)
{
    let mut buffer: std.memory.RawBuffer<PanickingBufferElement> = trusted internal initialized_panicking_buffer();

    let mut replacement: std.memory.RawBuffer<PanickingBufferElement> = std.testing.assert_ok<
        std.memory.RawBuffer<PanickingBufferElement>,
        std.memory.MemoryLayoutError,
    >(trusted std.memory.RawBuffer<PanickingBufferElement>(capacity = 0));

    trusted internal std.memory.raw_buffer_replace<PanickingBufferElement>(
        destination = &mut buffer,
        source = &mut replacement,
    );
}

@test
trusted func raw_buffer_implicit_release_preserves_destructor_panic()
{
    let _: std.memory.RawBuffer<PanickingBufferElement> = trusted internal initialized_panicking_buffer();
}

@test
trusted func raw_buffer_release_preserves_deallocation_failure()
    uses(manual_alloc)
{
    let mut buffer: std.memory.RawBuffer<u8> =
    {
        pointer = std.memory.null<u8>(),
        capacity = 1,
        initialized = 0,
    };

    trusted internal std.memory.raw_buffer_release<u8>(&mut buffer);
}

@test
trusted func raw_buffer_release_finishes_each_element_once()
    uses(manual_alloc, raw_memory, unchecked_init)
{
    core.atomic.store<u32, 4>(&RAW_BUFFER_CLEANUP_COUNT, 0);

    let mut buffer: std.memory.RawBuffer<PanickingBufferElement> = std.testing.assert_ok<
        std.memory.RawBuffer<PanickingBufferElement>,
        std.memory.MemoryLayoutError,
    >(trusted std.memory.RawBuffer<PanickingBufferElement>(capacity = 2));

    let first: RawPointer<PanickingBufferElement> = trusted std.memory.spare_pointer<PanickingBufferElement>(
        &mut buffer
    );

    trusted std.memory.write<PanickingBufferElement>(
        first,
        {
            value = 1
        }
    );

    trusted std.memory.set_initialized_count<PanickingBufferElement>(&mut buffer, count = 1);

    let second: RawPointer<PanickingBufferElement> = trusted std.memory.spare_pointer<PanickingBufferElement>(
        &mut buffer
    );

    trusted std.memory.write<PanickingBufferElement>(
        second,
        {
            value = 2
        }
    );

    trusted std.memory.set_initialized_count<PanickingBufferElement>(&mut buffer, count = 2);

    let caught: Result<unit, PanicReport> = catch
    {
        trusted internal std.memory.raw_buffer_release<PanickingBufferElement>(&mut buffer);

        yield unit;
    };

    let _: PanicReport = std.testing.assert_error<unit, PanicReport>(caught);

    assert(core.atomic.load<u32, 1>(&RAW_BUFFER_CLEANUP_COUNT) == 2);
    assert(std.memory.initialized_count<PanickingBufferElement>(&buffer) == 0);
    assert(std.memory.capacity<PanickingBufferElement>(&buffer) == 0);

    panic("raw buffer cleanup progress checked");
}

@test
func explicit_failure()
{
    std.testing.fail(&"expected explicit failure");
}

@test
func assert_ok_rejects_an_error()
{
    let _: unit = std.testing.assert_ok<unit, unit>(Error(unit));
}

@test
func assert_error_rejects_success()
{
    let _: unit = std.testing.assert_error<unit, unit>(Ok(unit));
}

@test
func assert_present_rejects_absence()
{
    let _: unit = std.testing.assert_present<unit>(none);
}

@test
func assert_absent_rejects_presence()
{
    let value: unit? = unit;

    std.testing.assert_absent<unit>(value);
}

@test
func assert_completed_rejects_cancellation()
{
    let _: unit = std.testing.assert_completed<unit>(RunResult.Cancelled);
}

@test
func assert_panicked_rejects_completion()
{
    let _: PanicReport = std.testing.assert_panicked<unit>(RunResult.Completed(unit));
}

@test
func assert_cancelled_rejects_completion()
{
    std.testing.assert_cancelled<unit>(RunResult.Completed(unit));
}

@test
func assert_not_completed_rejects_completion()
{
    std.testing.assert_not_completed<unit>(RunResult.Completed(unit));
}

@test
func panic_failure()
{
    panic("expected panic");
}

internal func panic_from_checked_call()
{
    panic("checked call panic");
}

@test
func checked_call_panic_preserves_report()
{
    panic_from_checked_call();
}

@test
func once_indirect_reentry_panics()
{
    let _: &i32 = FIRST_ONCE.get_or_init(initialize_first_once);
}

@test
func recoverable_error() -> Result<unit, std.string.Utf8Error>
{
    let invalid: u8 = 255;
    let bytes: bytes<1> = [invalid];
    let decoded: Result<string, std.string.Utf8Error> = string.from_utf8(&bytes[..]);

    match consume decoded
    {
        case Ok(_) { panic("invalid UTF-8 unexpectedly decoded"); }
        case Error(error) { return Error(error); }
    }
}

@test
func timeout_requires_forced_termination()
{
    while true {}
}

@test
func timeout_observes_cancellation()
{
    while true
    {
        std.run.checkpoint();
    }
}
