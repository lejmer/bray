module bray.standard_library_conformance.hash;

using std.hash;

@test
func stable_hashing_is_deterministic()
{
    let first: u64 = 42;
    let second: u64 = 43;
    let text: string = "bray";

    let first_hash: u128 = std.hash.stable_hash(&first);
    let repeated_hash: u128 = std.hash.stable_hash(&first);
    let second_hash: u128 = std.hash.stable_hash(&second);
    let text_hash: u128 = std.hash.stable_hash(&text);

    assert(first_hash == repeated_hash);
    assert(first_hash != second_hash);
    assert(text_hash != first_hash);
}

@test
func stable_hashing_covers_scalar_values()
{
    let false_hash: u128 = std.hash.stable_hash(&false);
    let true_hash: u128 = std.hash.stable_hash(&true);
    let character_hash: u128 = std.hash.stable_hash(&'A');
    let byte_hash: u128 = std.hash.stable_hash(&(65 as u8));
    let wide_hash: u128 = std.hash.stable_hash(&(65 as u128));
    let size_hash: u128 = std.hash.stable_hash(&(65 as usize));

    assert(false_hash != true_hash);
    assert(character_hash == byte_hash);
    assert(byte_hash == wide_hash);
    assert(wide_hash == size_hash);
}

@test
func incremental_hashing_preserves_write_order()
{
    let mut first: std.hash.StableHasher = std.hash.StableHasher();
    let mut repeated: std.hash.StableHasher = std.hash.StableHasher();
    let mut reversed: std.hash.StableHasher = std.hash.StableHasher();

    first.write(10);
    first.write(20);
    repeated.write(10);
    repeated.write(20);
    reversed.write(20);
    reversed.write(10);

    assert(std.hash.finish(&first) == std.hash.finish(&repeated));
    assert(std.hash.finish(&first) != std.hash.finish(&reversed));
}
