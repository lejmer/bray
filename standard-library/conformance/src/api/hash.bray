module bray.standard_library_conformance.hash;

using std.hash;

@test
func stable_hashing_is_deterministic()
{
    let first: std.hash.StableHasher = std.hash.StableHasher();
    let second: std.hash.StableHasher = std.hash.StableHasher();

    assert(std.hash.finish(&first) == std.hash.finish(&second));
    // TODO(BRA-357): Exercise imported generic stable hashing natively.
}
