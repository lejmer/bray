module bray.standard_library_conformance.numeric;

using std.numeric;

@test
func integer_limits()
{
    assert(std.numeric.U8_MIN == 0);
    assert(std.numeric.U8_MAX == 255);
    assert(std.numeric.I32_MIN == -2147483647 - 1);
    assert(std.numeric.I32_MAX == 2147483647);
    assert(std.numeric.USIZE_MIN == 0);
    assert(std.numeric.USIZE_MAX > 0);
    assert(std.numeric.ISIZE_MIN < 0);
    assert(std.numeric.ISIZE_MAX > 0);
    // TODO(BRA-357): Exercise imported generic checked arithmetic natively.
}

@test
func widest_integer_parsing()
{
    let unsigned_decimal: Result<u128, std.numeric.ParseError> = std.numeric.parse_u128(&"42");
    let unsigned_hexadecimal: Result<u128, std.numeric.ParseError> = std.numeric.parse_u128(&"ff", radix = 16);
    let invalid: Result<u128, std.numeric.ParseError> = std.numeric.parse_u128(&"4z");
    let signed: Result<i32, std.numeric.ParseError> = std.numeric.parse_i32(&"-42");
    let narrow_overflow: Result<u8, std.numeric.ParseError> = std.numeric.parse_u8(&"256");

    match consume unsigned_decimal
    {
        case Ok(value) { assert(value == 42); }
        case Error(_) { assert(false); }
    }

    match consume unsigned_hexadecimal
    {
        case Ok(value) { assert(value == 255); }
        case Error(_) { assert(false); }
    }

    match consume invalid
    {
        case Ok(_) { assert(false); }
        case Error(std.numeric.ParseError.InvalidDigit) {}
        case Error(_) { assert(false); }
    }

    match consume signed
    {
        case Ok(value) { assert(value == -42); }
        case Error(_) { assert(false); }
    }

    match consume narrow_overflow
    {
        case Ok(_) { assert(false); }
        case Error(std.numeric.ParseError.Overflow) {}
        case Error(_) { assert(false); }
    }
}
