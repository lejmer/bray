module bray.standard_library_conformance.order;

using std.order;

@test
func ordering_helpers()
{
    // TODO(BRA-357): Exercise imported generic ordering helpers and algorithms natively.
    let reversed: Ordering = std.order.reverse(Ordering.Less);
    let chained: Ordering = std.order.then(Ordering.Equal, Ordering.Greater);

    match reversed
    {
        case Ordering.Greater {}
        case _ { assert(false); }
    }

    match chained
    {
        case Ordering.Greater {}
        case _ { assert(false); }
    }
}
