@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap;

using std.memory;


internal callable CleanupIncidentReportCallback = @abi(c)
trusted func(pos incident: RawPointer<CleanupIncident>) -> u32;

internal callable PanicReportStatusCallback = @abi(c)
trusted func(pos payload: usize) -> u32;

internal callable CleanupIncidentDestroyCallback = @abi(c)
trusted func(pos payload: usize) -> usize;

@copy
@layout(c)
internal struct PanicReportCallbacks
{
    report: RawPointer<u8>;
    destroy: RawPointer<u8>;
    construct_cleanup: RawPointer<u8>;
    suppress: RawPointer<u8>;
}

@copy
@layout(c)
internal struct SourceAnchor
{
    present: u32;
    source: u32;
    start: u32;
    end: u32;
    version: u64;
}

@copy
@layout(c)
internal struct CleanupIncident
{
    payload: usize;
    type_identity: [u8; 32];
    source: SourceAnchor;
    report: RawPointer<u8>;
    destroy: RawPointer<u8>;
    panics: PanicReportCallbacks;
}
