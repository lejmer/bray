@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.event;

using core.atomic;
using core.memory;
using core.target;
using std.memory;
using std.numeric;
using std.sync;
using internal std.sync.spin_lock;
using internal bray.runtime.bootstrap.heap;
using internal bray.runtime.bootstrap.host;
using internal bray.runtime.bootstrap.host.product;

// Allocation is admitted before taking either the resident directory or event lock.
trusted internal func allocate_domain() -> Reference?
    ensures(trusted optional_reference(owner = &result))
{
    let allocation = trusted bray.runtime.bootstrap.heap.allocate(
        std.memory.stride_of<Domain>(),
        align = std.memory.align_of<Domain>()
    );

    if std.memory.is_null<u8>(allocation)
    {
        return none;
    }

    return trusted initialize_domain(allocation);
}

trusted internal predicate optional_reference(owner: &(Reference?));

trusted internal func initialize_domain(pos allocation: DataPointer<u8>) -> Reference
    requires(
        trusted core.memory.owned_allocation(
            pointer = allocation,
            bytes = std.memory.stride_of<Domain>(),
            align = std.memory.align_of<Domain>()
        ),
        trusted core.memory.valid_write<u8>(pointer = allocation, count = std.memory.stride_of<Domain>())
    )
    ensures(trusted retained(owner = &result), trusted owned_reference(owner = &result))
    uses(raw_memory, unchecked_init, intrinsic)
{
    let typed = trusted lambda(pos allocation: DataPointer<u8>) -> DataPointer<Domain>
        requires(
            trusted core.memory.owned_allocation(
                pointer = allocation,
                bytes = std.memory.stride_of<Domain>(),
                align = std.memory.align_of<Domain>()
            ),
            trusted core.memory.valid_write<u8>(pointer = allocation, count = std.memory.stride_of<Domain>())
        )
        ensures(
            trusted core.memory.valid_write<Domain>(pointer = result, count = 1),
            trusted core.memory.aligned_for<Domain>(pointer = result)
        )
        uses(layout_reinterpret)
    {
        return trusted std.memory.reinterpret<Domain, u8>(allocation);
    };

    let pointer = trusted typed(allocation);

    trusted std.memory.write<Domain>(
        pointer,
        {
            references = core.atomic.initialize<usize>(1),
            state = core.memory.uninit_from<State>(
                {
                    generation = 0,
                    closed = false,
                    head = 0,
                    tail = 0
                }
            )
        }
    );

    return
    {
        address = trusted core.target.expose_address<Domain>(pointer)
    };
}

trusted internal func retain_event(pos owner: &Reference) -> Reference
    requires(trusted retained(owner = owner))
    ensures(trusted retained(owner = &result), trusted owned_reference(owner = &result))
    uses(intrinsic)
{
    let value = trusted domain(owner);
    let mut count = core.atomic.load<usize, 1>(&value.references);

    while true
    {
        if count == 0 || count == std.numeric.USIZE_MAX
        {
            trusted core.target.abort();
        }

        let (previous, acquired) = core.atomic.compare_exchange<usize, 3, 1>(
            &value.references,
            expected = count,
            desired = count + 1
        );

        if acquired
        {
            return
            {
                address = owner.address
            };
        }

        count = previous;
    }
}

@abi(c)
trusted internal func release(pos pointer: DataPointer<Reference>)
    requires(trusted reference_slot(pointer = pointer), trusted release_entry(pointer = pointer))
{
    trusted release_event(trusted read_owned_reference(pointer));
}

trusted internal func release_event(pos owner: Reference)
    requires(trusted retained(owner = &owner), trusted owned_reference(owner = &owner))
{
    if trusted release_count(&owner)
    {
        let pointer = trusted retired_pointer(&owner);

        trusted bray.runtime.bootstrap.heap.deallocate_bytes(
            std.memory.byte_address<Domain>(pointer),
            std.memory.stride_of<Domain>(),
            align = std.memory.align_of<Domain>()
        );
    }
}

trusted internal func retired_pointer(pos owner: &Reference) -> DataPointer<Domain>
    requires(trusted final_reference(owner = owner))
    ensures(
        trusted core.memory.owned_allocation(
            pointer = std.memory.byte_address<Domain>(result),
            bytes = std.memory.stride_of<Domain>(),
            align = std.memory.align_of<Domain>()
        ),
        trusted core.memory.valid_read<Domain>(pointer = result, count = 1),
        trusted core.memory.valid_write<Domain>(pointer = result, count = 1),
        trusted core.memory.initialized_as<Domain>(pointer = result),
        trusted core.memory.aligned_for<Domain>(pointer = result)
    )
    uses(intrinsic)
{
    return trusted core.target.from_exposed_address<Domain>(address = owner.address);
}

trusted internal func take_optional_reference(pos owner: Reference?) -> Reference
    requires(owner matches ?_, trusted optional_reference(owner = &owner))
    ensures(trusted retained(owner = &result), trusted owned_reference(owner = &result))
    uses(intrinsic)
{
    return match consume owner
    {
        case ?value { yield value; }
        case none { yield trusted core.target.abort(); }
    };
}

trusted internal func read_owned_reference(pos pointer: DataPointer<Reference>) -> Reference
    requires(trusted reference_slot(pointer = pointer), trusted release_entry(pointer = pointer))
    ensures(trusted retained(owner = &result), trusted owned_reference(owner = &result))
    uses(raw_memory)
{
    let permit = trusted lambda(pos pointer: DataPointer<Reference>)
        requires(trusted reference_slot(pointer = pointer), trusted release_entry(pointer = pointer))
        ensures(
            trusted core.memory.valid_read<Reference>(pointer = pointer, count = 1),
            trusted core.memory.aligned_for<Reference>(pointer = pointer),
            trusted core.memory.initialized_as<Reference>(pointer = pointer)
        )
        executes(pure, total) {};

    trusted permit(pointer);
    return trusted std.memory.read<Reference>(pointer);
}

// A final decrement keeps the initialized allocation owned until disposal ends.
trusted internal func release_count(pos owner: &Reference) -> bool
    requires(trusted retained(owner = owner), trusted owned_reference(owner = owner))
    ensures(!result || trusted final_reference(owner = owner))
    uses(intrinsic)
{
    let value = trusted domain(owner);
    let previous = core.atomic.fetch_sub<usize, 3>(&value.references, value = 1);

    if previous == 0
    {
        trusted core.target.abort();
    }

    return previous == 1;
}
