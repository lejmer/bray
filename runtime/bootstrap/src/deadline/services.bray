@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.deadline;

using core.memory;
using core.target;
using std.memory;
using internal std.platform;

trusted internal func service_pointer(pos owner: &Reference) -> DataPointer<Reference>
    requires(trusted retained(owner = owner))
    ensures(trusted retained(owner = owner), trusted reference_slot(pointer = result))
    executes(pure, total)
{
    return std.memory.address_of<Reference>(owner);
}

internal func poll(pos owner: &Reference) -> Result<u32, std.platform.PlatformStatus>
    requires(trusted retained(owner = owner))
    ensures(trusted retained(owner = owner))
{
    let now = try monotonic_now();

    return Ok(trusted dispatch_reference(owner, now));
}

internal func wait(pos owner: &Reference, pos maximum: u32) -> Result<u32, std.platform.PlatformStatus>
    requires(trusted retained(owner = owner))
    ensures(trusted retained(owner = owner))
{
    let scheduled = trusted next_deadline(owner);

    if let ?deadline = scheduled
    {
        let now = try monotonic_now();

        if deadline <= now
        {
            return Ok(0);
        }

        let remaining = deadline - now;

        let milliseconds = remaining / 1_000_000 + if remaining % 1_000_000 == 0
        {
            yield 0;
        }
        else
        {
            yield 1;
        };

        return Ok(
            if milliseconds < maximum as u64
            {
                yield std.numeric.truncate_to<u32, u64>(milliseconds);
            }
            else
            {
                yield maximum;
            }
        );
    }

    return Ok(maximum);
}

trusted internal func close(pos owner: &Reference)
    requires(trusted retained(owner = owner))
    ensures(trusted retained(owner = owner))
{
    loop
    {
        let pending = trusted commit(owner, 18_446_744_073_709_551_615, 0, 0);

        if pending matches none
        {
            return;
        }

        _ = trusted release(owner, trusted take_entry(pending), false);
    }
}

internal func monotonic_now() -> Result<u64, std.platform.PlatformStatus>
{
    let mut ticks: u64 = 0;
    let status = trusted std.platform.clock_monotonic_now(std.memory.address_of_mut<u64>(&mut ticks));

    if status.category != 0
    {
        return Error(status);
    }

    return Ok(ticks);
}

internal const func optional_view(pos owner: &((&Reference)?)) -> &Reference
    requires(owner matches ?_)
    executes(pure, total)
{
    return match owner
    {
        case ?value { yield value; }
        case none { panic("missing retained service"); }
    };
}

trusted internal func borrow_reference(
    pos input: &DataPointer<Reference>,
    pos pointer: DataPointer<Reference>
) -> &Reference
    requires(trusted reference_slot(pointer = pointer))
    ensures(trusted retained(owner = result))
    executes(pure, total)
    uses(raw_memory, unchecked_alias)
{
    let permit = trusted lambda(pos input: &DataPointer<Reference>, pos pointer: DataPointer<Reference>)
        requires(trusted reference_slot(pointer = pointer))
        ensures(
            trusted core.memory.valid_read<Reference>(pointer = pointer, count = 1),
            trusted core.memory.aligned_for<Reference>(pointer = pointer),
            trusted core.memory.initialized_as<Reference>(pointer = pointer),
            trusted core.memory.shared_alias_valid<Reference>(pointer = pointer),
            trusted core.memory.epoch_current<Reference>(pointer = pointer),
            trusted core.memory.synchronized_access<Reference>(pointer = pointer),
            trusted core.memory.movement_stable<Reference>(pointer = pointer),
            trusted core.memory.finalization_pending<Reference>(pointer = pointer)
        )
        executes(pure, total) {};

    trusted permit(input, pointer);
    return trusted std.memory.borrow_from<Reference, DataPointer<Reference>>(input, pointer);
}
