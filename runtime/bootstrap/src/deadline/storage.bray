@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.deadline;

using core.memory;
using core.target;
using std.memory;
using std.sync;
using internal std.sync.spin_lock;
using internal bray.runtime.bootstrap.heap;
using internal bray.runtime.bootstrap.host.product;
using internal bray.runtime.bootstrap.scheduler;
using internal bray.runtime.bootstrap.execution;
using internal bray.runtime.bootstrap.entry;
using internal bray.runtime.bootstrap.pool;

@abi(c)
trusted internal func creation(
    pos scheduler: DataPointer<bray.runtime.bootstrap.scheduler.Reference>,
    pos limit: usize,
    pos output: DataPointer<Reference>
) -> u32
    requires(
        trusted bray.runtime.bootstrap.scheduler.reference_slot(pointer = scheduler),
        trusted bray.runtime.bootstrap.host.product.native_host()
    )
{
    let scheduler_owner = trusted bray.runtime.bootstrap.scheduler.retain_reference(
        trusted bray.runtime.bootstrap.scheduler.borrow_reference(&scheduler, scheduler)
    );

    match consume create(trusted bray.runtime.bootstrap.scheduler.external_backing(scheduler_owner), limit)
    {
        case Ok(owner)
        {
            trusted bray.runtime.bootstrap.host.product.publish_provider<Reference>(output, owner);
            return 0;
        }
        case Error((rejected, status))
        {
            trusted bray.runtime.bootstrap.scheduler.release_external_backing(rejected);
            return status;
        }
    }
}

internal func create(
    pos backing: bray.runtime.bootstrap.scheduler.Backing,
    pos limit: usize
) -> Result<Reference, (bray.runtime.bootstrap.scheduler.Backing, u32)>
    requires(
        trusted bray.runtime.bootstrap.scheduler.backing_retained(owner = &backing),
        trusted bray.runtime.bootstrap.scheduler.backing_owned(owner = &backing),
        trusted bray.runtime.bootstrap.host.product.native_host()
    )
{
    if !trusted bray.runtime.bootstrap.scheduler.deadline_admission(
        trusted bray.runtime.bootstrap.scheduler.backing_queue(&backing)
    )
    {
        let rejected: (bray.runtime.bootstrap.scheduler.Backing, u32) = (backing, 4);

        return Error(rejected);
    }

    let allocation = trusted allocate_domain(&backing);

    if std.memory.is_null<u8>(allocation)
    {
        let rejected: (bray.runtime.bootstrap.scheduler.Backing, u32) = (backing, 1);

        return Error(rejected);
    }

    return Ok(trusted initialize(allocation, backing, limit));
}

trusted internal func allocate_domain(pos backing: &bray.runtime.bootstrap.scheduler.Backing) -> DataPointer<u8>
    requires(
        trusted bray.runtime.bootstrap.scheduler.backing_retained(owner = backing),
        trusted bray.runtime.bootstrap.scheduler.backing_owned(owner = backing)
    )
    ensures(
        trusted bray.runtime.bootstrap.scheduler.backing_retained(owner = backing),
        trusted bray.runtime.bootstrap.scheduler.backing_owned(owner = backing),
        std.memory.is_null<u8>(result) || trusted core.memory.owned_allocation(
            pointer = result,
            bytes = std.memory.stride_of<Domain>(),
            align = std.memory.align_of<Domain>()
        ),
        std.memory.is_null<u8>(result) || trusted core.memory.valid_write<u8>(
            pointer = result,
            count = std.memory.stride_of<Domain>()
        )
    )
{
    return trusted bray.runtime.bootstrap.heap.allocate(
        std.memory.stride_of<Domain>(),
        align = std.memory.align_of<Domain>()
    );
}

trusted internal func initialize(
    pos allocation: DataPointer<u8>,
    pos backing: bray.runtime.bootstrap.scheduler.Backing,
    pos limit: usize
) -> Reference
    requires(
        trusted core.memory.owned_allocation(
            pointer = allocation,
            bytes = std.memory.stride_of<Domain>(),
            align = std.memory.align_of<Domain>()
        ),
        trusted core.memory.valid_write<u8>(pointer = allocation, count = std.memory.stride_of<Domain>()),
        trusted bray.runtime.bootstrap.scheduler.backing_retained(owner = &backing),
        trusted bray.runtime.bootstrap.scheduler.backing_owned(owner = &backing)
    )
    ensures(trusted retained(owner = &result))
    uses(raw_memory, unchecked_init)
{
    let typed = trusted lambda(pos allocation: DataPointer<u8>) -> DataPointer<Domain>
        requires(
            trusted core.memory.owned_allocation(
                pointer = allocation,
                bytes = std.memory.stride_of<Domain>(),
                align = std.memory.align_of<Domain>()
            ),
            trusted core.memory.valid_write<u8>(pointer = allocation, count = std.memory.stride_of<Domain>())
        )
        ensures(
            trusted core.memory.valid_write<Domain>(pointer = result, count = 1),
            trusted core.memory.aligned_for<Domain>(pointer = result)
        )
        uses(layout_reinterpret)
    {
        return trusted std.memory.reinterpret<Domain, u8>(allocation);
    };

    let pointer = trusted typed(allocation);

    trusted std.memory.write<Domain>(
        pointer,
        {
            backing = backing,
            limit = limit,
            state = trusted std.sync.SpinLock<State>(
                {
                    next = 1,
                    entries = none
                }
            )
        }
    );

    return
    {
        acquisition = Marker
        {
        },
        pointer = pointer
    };
}

trusted internal func domain(pos owner: &Reference) -> &Domain
    requires(trusted retained(owner = owner))
    ensures(
        trusted std.sync.spin_lock.valid(&result.state.prepared.instance),
        trusted domain_owned(owner = result),
        trusted bray.runtime.bootstrap.scheduler.backing_retained(owner = &result.backing)
    )
    executes(pure, total)
    uses(raw_memory, unchecked_alias)
{
    let pointer = trusted lambda(pos owner: &Reference) -> DataPointer<Domain>
        requires(trusted retained(owner = owner))
        ensures(
            trusted core.memory.valid_read<Domain>(pointer = result, count = 1),
            trusted core.memory.aligned_for<Domain>(pointer = result),
            trusted core.memory.initialized_as<Domain>(pointer = result),
            trusted core.memory.shared_alias_valid<Domain>(pointer = result),
            trusted core.memory.epoch_current<Domain>(pointer = result),
            trusted core.memory.synchronized_access<Domain>(pointer = result),
            trusted core.memory.movement_stable<Domain>(pointer = result),
            trusted core.memory.finalization_pending<Domain>(pointer = result)
        )
        executes(pure, total)
    {
        return owner.pointer;
    };

    return trusted std.memory.borrow_from<Domain, Reference>(owner, trusted pointer(owner));
}

trusted internal func scheduler_reference(pos owner: &Reference) -> &bray.runtime.bootstrap.scheduler.Reference
    requires(trusted retained(owner = owner))
    ensures(trusted retained(owner = owner), trusted bray.runtime.bootstrap.scheduler.retained(owner = result))
    executes(pure, total)
{
    let backing = &(trusted domain(owner)).backing;

    return trusted bray.runtime.bootstrap.scheduler.backing_queue(backing);
}

trusted internal func execution_reference(pos owner: &Reference) -> &bray.runtime.bootstrap.execution.Reference
    requires(trusted retained(owner = owner))
    ensures(trusted retained(owner = owner), trusted bray.runtime.bootstrap.execution.retained(owner = result))
{
    let backing = &(trusted domain(owner)).backing;

    if !(backing.execution matches ?_)
    {
        trusted core.target.abort();
    }

    return bray.runtime.bootstrap.scheduler.backing_execution(backing);
}

trusted internal func lock(pos owner: &Domain) -> std.sync.SpinLockGuard<State>
    requires(trusted domain_owned(owner = owner), trusted std.sync.spin_lock.valid(&owner.state.prepared.instance))
    ensures(
        trusted domain_owned(owner = owner),
        trusted std.sync.spin_lock.acquired(&result.acquisition),
        trusted acquisition_for(owner = owner, marker = &result.acquisition)
    )
{
    return trusted owner.state.lock();
}

trusted internal func state(pos owner: &Domain, pos guard: &mut std.sync.SpinLockGuard<State>) -> &mut State
    requires(
        trusted domain_owned(owner = owner),
        trusted std.sync.spin_lock.acquired(&guard.acquisition),
        trusted acquisition_for(owner = owner, marker = &guard.acquisition)
    )
    ensures(
        trusted domain_owned(owner = owner),
        trusted std.sync.spin_lock.acquired(&guard.acquisition),
        trusted acquisition_for(owner = owner, marker = &guard.acquisition),
        trusted heap_owned(owner = &result)
    )
{
    return trusted guard.get();
}

trusted internal func notify(pos owner: &Reference)
    requires(trusted retained(owner = owner))
{
    let value = trusted domain(owner);

    bray.runtime.bootstrap.scheduler.notify_ready(trusted scheduler_reference(owner));
}

@abi(c)
trusted internal func destruction(pos pointer: DataPointer<Reference>)
    requires(trusted reference_slot(pointer = pointer), trusted retirement_entry(pointer = pointer))
    uses(intrinsic)
{
    let retire = trusted lambda(pos slot: DataPointer<Reference>) -> Reference
        requires(trusted reference_slot(pointer = slot), trusted retirement_entry(pointer = slot))
        ensures(trusted retained(owner = &result), trusted retiring(owner = &result))
        uses(raw_memory)
    {
        let permit = trusted lambda(pos slot: DataPointer<Reference>)
            requires(trusted reference_slot(pointer = slot), trusted retirement_entry(pointer = slot))
            ensures(
                trusted core.memory.valid_read<Reference>(pointer = slot, count = 1),
                trusted core.memory.initialized_as<Reference>(pointer = slot),
                trusted core.memory.aligned_for<Reference>(pointer = slot)
            )
            executes(pure, total) {};

        trusted permit(slot);
        return trusted std.memory.read<Reference>(slot);
    };

    trusted destroy_reference(trusted retire(pointer));
}

trusted internal func destroy_reference(pos owner: Reference)
    requires(trusted retained(owner = &owner), trusted retiring(owner = &owner))
    uses(intrinsic)
{
    // Only the actual retiring reference can transfer allocation ownership.
    let take = trusted lambda(pos owner: Reference) -> (
        bray.runtime.bootstrap.scheduler.Backing,
        std.sync.SpinLock<State>,
        std.memory.RawAllocation
    )
        requires(trusted retained(owner = &owner), trusted retiring(owner = &owner))
        ensures(
            trusted std.sync.spin_lock.valid(&result.1.prepared.instance),
            trusted core.memory.owned_allocation(
                pointer = result.2.pointer,
                bytes = result.2.bytes,
                align = result.2.align
            ),
            trusted bray.runtime.bootstrap.scheduler.backing_retained(owner = &result.0),
            trusted bray.runtime.bootstrap.scheduler.backing_owned(owner = &result.0)
        )
        uses(raw_memory)
    {
        let take_storage = trusted lambda(pos owner: &Reference) -> Domain
            requires(trusted retained(owner = owner), trusted retiring(owner = owner))
            ensures(
                trusted std.sync.spin_lock.valid(&result.state.prepared.instance),
                trusted bray.runtime.bootstrap.scheduler.backing_retained(owner = &result.backing),
                trusted bray.runtime.bootstrap.scheduler.backing_owned(owner = &result.backing),
                trusted core.memory.owned_allocation(
                    pointer = std.memory.byte_address<Domain>(owner.pointer),
                    bytes = std.memory.stride_of<Domain>(),
                    align = std.memory.align_of<Domain>()
                )
            )
            uses(raw_memory)
        {
            let permit = trusted lambda(pos owner: &Reference)
                requires(trusted retained(owner = owner), trusted retiring(owner = owner))
                ensures(
                    trusted core.memory.valid_read<Domain>(pointer = owner.pointer, count = 1),
                    trusted core.memory.aligned_for<Domain>(pointer = owner.pointer),
                    trusted core.memory.initialized_as<Domain>(pointer = owner.pointer),
                    trusted core.memory.owned_allocation(
                        pointer = std.memory.byte_address<Domain>(owner.pointer),
                        bytes = std.memory.stride_of<Domain>(),
                        align = std.memory.align_of<Domain>()
                    )
                )
                executes(pure, total) {};

            trusted permit(owner);
            return trusted std.memory.read<Domain>(owner.pointer);
        };

        let value = trusted take_storage(&owner);

        let allocation: std.memory.RawAllocation =
        {
            pointer = std.memory.byte_address<Domain>(owner.pointer),
            bytes = std.memory.stride_of<Domain>(),
            align = std.memory.align_of<Domain>()
        };

        return (
            trusted std.memory.read<bray.runtime.bootstrap.scheduler.Backing>(
                std.memory.address_of<bray.runtime.bootstrap.scheduler.Backing>(&value.backing)
            ),
            trusted std.memory.read<std.sync.SpinLock<State>>(
                std.memory.address_of<std.sync.SpinLock<State>>(&value.state)
            ),
            allocation
        );
    };

    let (backing, owned_state, allocation) = trusted take(owner);

    _ = allocation;

    {
        let mut guard = trusted owned_state.lock();
        let current = trusted guard.get();

        if trusted count(&current) != 0
        {
            trusted core.target.abort();
        }
    }

    _ = owned_state;

    trusted bray.runtime.bootstrap.scheduler.release_external_backing(backing);
}

// Keep the closed broker allocation in its execution owner. This transition
// retires its backing pin while the caller's independent owner remains live.
trusted internal func retire_execution_backing(pos execution: &bray.runtime.bootstrap.execution.Reference)
    requires(
        trusted bray.runtime.bootstrap.execution.retained(owner = execution),
        trusted bray.runtime.bootstrap.execution.services_retiring(owner = &execution.acquisition),
        trusted bray.runtime.bootstrap.host.product.native_host(),
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted bray.runtime.bootstrap.pool.protocol_access()
    )
    ensures(trusted bray.runtime.bootstrap.execution.retained(owner = execution))
    uses(raw_memory, unchecked_init, intrinsic)
{
    let service = trusted bray.runtime.bootstrap.execution.deadlines(execution);

    if service matches none
    {
        return;
    }

    let owner = match service
    {
        case ?value { yield value; }
        case none { yield trusted core.target.abort(); }
    };

    close(owner);

    let pointer = std.memory.address_of<(bray.runtime.bootstrap.execution.Reference?)>(
        &(trusted domain(owner)).backing.execution
    );

    let take = trusted lambda(
        pos execution: &bray.runtime.bootstrap.execution.Reference,
        pos owner: &Reference,
        pos pointer: DataPointer<(bray.runtime.bootstrap.execution.Reference?)>
    ) -> bray.runtime.bootstrap.execution.Reference?
        requires(
            trusted bray.runtime.bootstrap.execution.retained(owner = execution),
            trusted bray.runtime.bootstrap.execution.services_retiring(owner = &execution.acquisition),
            trusted retained(owner = owner)
        )
        ensures(trusted bray.runtime.bootstrap.execution.optional_pin(owner = &result), result matches ?_)
        uses(raw_memory, unchecked_init, intrinsic)
    {
        let permit = trusted lambda(
            pos owner: &Reference,
            pos pointer: DataPointer<(bray.runtime.bootstrap.execution.Reference?)>
        )
            requires(trusted retained(owner = owner))
            ensures(
                trusted core.memory.valid_read<(bray.runtime.bootstrap.execution.Reference?)>(
                    pointer = pointer,
                    count = 1
                ),
                trusted core.memory.valid_write<(bray.runtime.bootstrap.execution.Reference?)>(
                    pointer = pointer,
                    count = 1
                ),
                trusted core.memory.initialized_as<(bray.runtime.bootstrap.execution.Reference?)>(pointer = pointer),
                trusted core.memory.aligned_for<(bray.runtime.bootstrap.execution.Reference?)>(pointer = pointer)
            )
            executes(pure, total) {};

        trusted permit(owner, pointer);

        let backing = trusted std.memory.read<(bray.runtime.bootstrap.execution.Reference?)>(pointer);

        trusted std.memory.write<(bray.runtime.bootstrap.execution.Reference?)>(pointer, none);

        if backing matches none
        {
            trusted core.target.abort();
        }

        return backing;
    };

    let backing = trusted take(execution, owner, pointer);

    _ = trusted bray.runtime.bootstrap.execution.release_pin(
        trusted bray.runtime.bootstrap.execution.take_pin(backing)
    );
}
