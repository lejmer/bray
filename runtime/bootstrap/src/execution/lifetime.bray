@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.execution;

using core.atomic;
using core.memory;
using core.target;
using std.memory;
using std.memory.function;
using std.sync;
using internal std.sync.spin_lock;
using internal std.sync.once;
using internal bray.runtime.bootstrap;
using internal bray.runtime.bootstrap.host;
using internal bray.runtime.bootstrap.heap;

internal callable CloseRoot = @abi(c) trusted func(pos owner: Owner) -> Reference
    requires(trusted retained(owner = &owner.execution), trusted pinned(owner = &owner.execution), trusted service_owner(owner = &owner), blocking_execution())
    ensures(trusted retained(owner = &result), trusted pinned(owner = &result));

trusted internal func own_binding(pos selected: &Current, pos owner: Owner) -> Binding
    requires(trusted view_owned(owner = &selected.acquisition), selected.status == 0, trusted bray.runtime.bootstrap.execution.retained(owner = &owner.execution), trusted service_owner(owner = &owner), trusted pinned(owner = &owner.execution))
    ensures(trusted view_owned(owner = &selected.acquisition), trusted kernel_binding(owner = &result))
    uses(layout_reinterpret, raw_memory)
{
    let root: CloseRoot = close_owner_binding;
    let address = trusted std.memory.function.reinterpret<BindingClose, CloseRoot>(trusted std.memory.function_address<CloseRoot>(root));

    // The C entry belongs to this actual retained native driver. Its cleanup
    // root permits internal blocking without changing a task's selected lane.
    let adapt = trusted lambda(pos selected: &Current, pos address: FunctionPointer<BindingClose>)
        requires(trusted view_owned(owner = &selected.acquisition), selected.status == 0)
        ensures(trusted core.memory.callable_address_valid<BindingClose>(pointer = address))
        executes(pure, total) {};

    trusted adapt(selected, address);

    let close = trusted std.memory.callable_from_pointer<BindingClose>(address);

    return { execution = trusted std.memory.read<Reference>(std.memory.address_of<Reference>(&owner.execution)), close = close, release = release_pin_binding, suspend = suspend_binding, resume = trusted resume_operation() };
}

trusted internal func pin_binding(pos owner: bray.runtime.bootstrap.execution.Reference) -> Binding
    requires(trusted bray.runtime.bootstrap.execution.retained(owner = &owner), trusted pinned(owner = &owner))
    ensures(trusted kernel_binding(owner = &result))
{
    return { execution = owner, close = none, release = release_pin_binding, suspend = suspend_binding, resume = trusted resume_operation() };
}

// The entry owns this exact driver through callback return. Keep call-entry
// identity even if a nested foreign entry temporarily changes current TLS.
trusted internal func binding_driver(pos context: DataPointer<Context>) -> Current
    requires(trusted driver_binding_entry(context = context))
    ensures(
        trusted view_owned(owner = &result.acquisition), result.status == 0,
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted bray.runtime.bootstrap.host.product.native_host(),
        trusted bray.runtime.bootstrap.pool.protocol_access()
    )
    uses(raw_memory, unchecked_alias)
{
    let permit = trusted lambda(pos context: DataPointer<Context>)
        requires(trusted driver_binding_entry(context = context))
        ensures(
            trusted core.memory.valid_read<Context>(pointer = context, count = 1),
            trusted core.memory.initialized_as<Context>(pointer = context),
            trusted core.memory.aligned_for<Context>(pointer = context),
            trusted core.memory.shared_alias_valid<Context>(pointer = context),
            trusted core.memory.epoch_current<Context>(pointer = context),
            trusted core.memory.synchronized_access<Context>(pointer = context),
            trusted core.memory.movement_stable<Context>(pointer = context),
            trusted core.memory.finalization_pending<Context>(pointer = context)
        )
        executes(pure, total) {};

    trusted permit(context);

    let value = trusted std.memory.borrow_from<Context, DataPointer<Context>>(&context, context);

    trusted acquire_view(value);
    return { acquisition = Acquisition {}, pointer = context, status = 0 };
}

@abi(c)
trusted internal func close_owner_binding(pos owner: Owner) -> Reference
    requires(blocking_execution(), trusted retained(owner = &owner.execution), trusted pinned(owner = &owner.execution), trusted service_owner(owner = &owner))
    ensures(trusted retained(owner = &result), trusted pinned(owner = &result))
{
    let selected = trusted current();

    if selected.status != 0
    {
        trusted core.target.abort();
    }

    return trusted close_owner(&selected, owner);
}

trusted internal func close_owner(pos selected: &Current, pos owner: Owner) -> bray.runtime.bootstrap.execution.Reference
    requires(blocking_execution(),
        trusted view_owned(owner = &selected.acquisition), selected.status == 0,
        trusted bray.runtime.bootstrap.execution.retained(owner = &owner.execution), trusted service_owner(owner = &owner), trusted pinned(owner = &owner.execution),
        trusted bray.runtime.bootstrap.entry.native_entry(), trusted bray.runtime.bootstrap.host.product.native_host(),
        trusted bray.runtime.bootstrap.pool.protocol_access()
    )
    ensures(trusted view_owned(owner = &selected.acquisition), trusted retained(owner = &result), trusted pinned(owner = &result))
    uses(foreign_call, raw_memory)
{
    let value = trusted domain(&owner.execution);
    let previous = core.atomic.fetch_sub<usize, 3>(&value.owners, 1);

    if previous == 0
    {
        trusted core.target.abort();
    }

    if previous == 1
    {
        let service = trusted workers(&owner.execution);
        let deferred = trusted must_defer_shutdown(selected) && service matches ?_;

        core.atomic.store<u32, 2>(&value.completion, if deferred { yield 2; } else { yield 1; });

        if let ?pool = service
        {
            bray.runtime.bootstrap.worker.close(pool, deferred);
        }

        if !deferred
        {
            trusted finish_services(&owner.execution, 1);
        }
    }

    // The service claim ends with this consumed owner. Transfer its actual
    // independent pin after the counter and closing callbacks have committed.
    return trusted std.memory.read<Reference>(std.memory.address_of<Reference>(&owner.execution));
}

// The resident host owns product eligibility. This operation only closes the
// execution resources after that owner's root and cleanup obligations resolve.
trusted internal func finish_services(pos owner: &bray.runtime.bootstrap.execution.Reference, pos completion: u32)
    requires(
        trusted bray.runtime.bootstrap.execution.retained(owner = owner), trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted bray.runtime.bootstrap.host.product.native_host(), trusted bray.runtime.bootstrap.pool.protocol_access()
    )
    ensures(trusted bray.runtime.bootstrap.execution.retained(owner = owner))
    uses(foreign_call, intrinsic)
{
    let value = trusted domain(owner);

    if core.atomic.load<usize, 1>(&value.owners) != 0 || core.atomic.load<u32, 1>(&value.completion) != completion
    {
        trusted core.target.abort();
    }

    let authorize = trusted lambda(pos owner: &Reference)
        requires(trusted retained(owner = owner))
        ensures(trusted services_retiring(owner = &owner.acquisition))
        executes(pure, total) {};

    // The last service owner has retired and publication is closed. The same
    // owner now authorizes transferring pins out of its selected services.
    trusted authorize(owner);

    trusted bray.runtime.bootstrap.deadline.retire_execution_backing(owner);

    trusted bray.runtime.bootstrap.task.retire_execution(owner);
    trusted bray.runtime.bootstrap.event.clear(value.identity);
    core.atomic.store<u32, 2>(&value.completion, 3);
}

@abi(c)
trusted internal func release_pin_binding(pos owner: Reference) -> u32
    requires(trusted retained(owner = &owner), trusted pinned(owner = &owner))
{
    let selected = trusted current();

    if selected.status != 0
    {
        trusted core.target.abort();
    }

    let value = trusted domain(&owner);
    let incidents = if core.atomic.load<u32, 1>(&value.completion) == 3
    {
        yield trusted drain_reports(&owner);
    }
    else
    {
        yield 0;
    };

    return incidents + trusted release_pin(owner);
}

trusted internal func release_pin(pos owner: bray.runtime.bootstrap.execution.Reference) -> u32
    requires(
        trusted bray.runtime.bootstrap.execution.retained(owner = &owner), trusted pinned(owner = &owner),
        trusted bray.runtime.bootstrap.entry.native_entry(), trusted bray.runtime.bootstrap.host.product.native_host(),
        trusted bray.runtime.bootstrap.pool.protocol_access()
    )
    uses(foreign_call, intrinsic)
{
    let value = trusted domain(&owner);
    let previous = core.atomic.fetch_sub<usize, 3>(&value.pins, 1);

    if previous == 0
    {
        trusted core.target.abort();
    }

    if previous != 1
    {
        return 0;
    }

    if core.atomic.load<usize, 1>(&value.owners) != 0 || core.atomic.load<u32, 1>(&value.completion) != 3
    {
        trusted core.target.abort();
    }

    // Keep the initialized domain and its actual driver through callbacks.
    // They may still access closed services or append a disposal incident.
    let last = trusted lambda(pos owner: &Reference)
        requires(trusted retained(owner = owner))
        ensures(trusted retiring(owner = owner))
        executes(pure, total) {};

    trusted last(&owner);

    trusted release_services(&owner);

    let incidents = trusted drain_reports(&owner);

    trusted destroy_domain(owner);
    return incidents;
}

trusted internal func destroy_domain(pos owner: Reference)
    requires(trusted retained(owner = &owner), trusted retiring(owner = &owner))
    uses(raw_memory)
{
    let take = trusted lambda(pos owner: Reference) -> (
        bray.runtime.bootstrap.scheduler.Reference,
        std.sync.Once<bray.runtime.bootstrap.worker.Reference>,
        std.sync.Once<bray.runtime.bootstrap.deadline.Reference>,
        std.sync.SpinLock<bray.runtime.bootstrap.worker.Failure>,
        std.sync.SpinLock<bray.runtime.bootstrap.report.sink.State>
    )
        requires(trusted retained(owner = &owner), trusted retiring(owner = &owner))
        ensures(
            trusted std.sync.once.valid(&result.1.prepared.instance),
            trusted std.sync.once.valid(&result.2.prepared.instance),
            trusted std.sync.spin_lock.valid(&result.3.prepared.instance),
            trusted std.sync.spin_lock.valid(&result.4.prepared.instance),
            trusted bray.runtime.bootstrap.scheduler.retained(owner = &result.0),
            trusted bray.runtime.bootstrap.scheduler.owned_reference(owner = &result.0)
        )
        uses(raw_memory)
    {
        let permit = trusted lambda(pos owner: &Reference)
            requires(trusted retained(owner = owner), trusted retiring(owner = owner))
            ensures(
                trusted core.memory.valid_read<Domain>(pointer = owner.pointer, count = 1),
                trusted core.memory.initialized_as<Domain>(pointer = owner.pointer),
                trusted core.memory.aligned_for<Domain>(pointer = owner.pointer),
                trusted core.memory.owned_allocation(pointer = std.memory.byte_address<Domain>(owner.pointer), bytes = std.memory.stride_of<Domain>(), align = std.memory.align_of<Domain>())
            )
            executes(pure, total) {};

        trusted permit(&owner);
        let value = trusted std.memory.read<Domain>(owner.pointer);

        trusted bray.runtime.bootstrap.heap.deallocate_bytes(std.memory.byte_address<Domain>(owner.pointer), std.memory.stride_of<Domain>(), align = std.memory.align_of<Domain>());
        return (value.scheduler, value.workers, value.deadlines, value.failure, value.reports);
    };

    let (queue_owner, worker_cell, deadline_cell, failure_state, report_state) = trusted take(owner);

    _ = worker_cell;
    _ = deadline_cell;
    _ = failure_state;
    _ = report_state;
    trusted bray.runtime.bootstrap.scheduler.destroy_reference(queue_owner);
    trusted bray.runtime.bootstrap.host.release_execution_domain();
}

// Rejected service construction returns the actual ownership context. Only
// the execution case transfers a pin, and this operation retires that pin.
trusted internal func discard_backing(pos backing: bray.runtime.bootstrap.scheduler.Backing)
    requires(trusted bray.runtime.bootstrap.scheduler.backing_retained(owner = &backing), trusted bray.runtime.bootstrap.scheduler.backing_owned(owner = &backing), trusted bray.runtime.bootstrap.entry.native_entry(), trusted bray.runtime.bootstrap.host.product.native_host(), trusted bray.runtime.bootstrap.pool.protocol_access())
{
    if backing matches bray.runtime.bootstrap.scheduler.Backing.Execution(_)
    {
        _ = trusted release_pin(trusted bray.runtime.bootstrap.scheduler.take_execution_backing(backing));
    }
}

trusted internal func take_pin(pos owner: Reference?) -> Reference
    requires(owner matches ?_, trusted optional_pin(owner = &owner))
    ensures(trusted retained(owner = &result), trusted pinned(owner = &result))
    uses(intrinsic)
{
    return match consume owner
    {
        case ?execution { yield execution; }
        case none { yield trusted core.target.abort(); }
    };
}

// This optional owner comes directly from task-storage recycling. It is not a
// snapshot, and its actual pin ends only after the retired control is destroyed.
trusted internal predicate optional_pin(owner: &(Reference?));

trusted internal func release_task_pin(pos owner: Reference?) -> u32
    requires(trusted optional_pin(owner = &owner))
{
    if owner matches none
    {
        return 0;
    }

    let take = trusted lambda(pos owner: Reference?) -> Reference
        requires(trusted optional_pin(owner = &owner), owner matches ?_)
        ensures(trusted retained(owner = &result), trusted pinned(owner = &result), trusted bray.runtime.bootstrap.entry.native_entry(), trusted bray.runtime.bootstrap.host.product.native_host(), trusted bray.runtime.bootstrap.pool.protocol_access())
    {
        return match consume owner
        {
            case ?execution { yield execution; }
            case none { yield trusted core.target.abort(); }
        };
    };

    let execution = trusted take(owner);

    let incidents = trusted release_pin(execution);

    // Task storage can outlive its driver, whose release drains every incident
    // before retiring its own pin. Storage retirement invokes no producer.
    assert(incidents == 0, "task storage retirement follows driver incident draining");
    return 0;
}
