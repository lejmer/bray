@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.execution;

using core.atomic;
using core.memory;
using core.target;
using std.memory;
using internal bray.runtime.bootstrap;
using internal bray.runtime.bootstrap.host;

trusted internal predicate driver_closing(owner: &Current);

internal predicate acquired_attachment_option(owner: &(bray.runtime.bootstrap.host.attachment.Owner?)) = owner matches
    none || (bray.runtime.bootstrap.host.attachment.acquired(owner = attachment_option(owner)) && attachment_option(
    owner
).status == 0);

internal const func attachment_option(
    pos owner: &(bray.runtime.bootstrap.host.attachment.Owner?)
) -> &bray.runtime.bootstrap.host.attachment.Owner
    requires(owner matches ?_)
    executes(pure, total)
{
    return match owner
    {
        case ?value { yield &value; }
        case none { panic("missing attachment owner"); }
    };
}

internal func context_idle(pos value: &Context) -> bool
{
    return core.atomic.load<usize, 0>(&value.views) == 1 && core.atomic.load<usize, 0>(&value.task) == 0 &&
        core.atomic.load<usize, 0>(&value.invocation) == 0;
}

trusted internal func driver_idle(pos owner: &Current) -> bool
    requires(trusted view_owned(owner = &owner.acquisition), owner.status == 0)
    ensures(trusted view_owned(owner = &owner.acquisition))
{
    let value = trusted context(owner);

    return context_idle(value);
}

trusted internal func driver_start_status(pos owner: &Current) -> u32
    requires(trusted view_owned(owner = &owner.acquisition), owner.status == 0)
    ensures(trusted view_owned(owner = &owner.acquisition))
{
    let value = trusted context(owner);

    if core.atomic.load<u32, 0>(&value.phase) != 2
    {
        return 2;
    }

    return if context_idle(value)
    {
        yield 0;
    }
    else
    {
        yield 3;
    };
}

trusted internal func begin_driver_close(pos owner: &Current) -> bool
    requires(trusted view_owned(owner = &owner.acquisition), owner.status == 0)
    ensures(trusted view_owned(owner = &owner.acquisition), trusted driver_closing(owner = owner))
    uses(intrinsic)
{
    let value = trusted context(owner);
    let (previous, changed) = core.atomic.compare_exchange<u32, 0, 0>(&value.phase, expected = 1, desired = 2);

    if previous != 1 && previous != 2
    {
        trusted core.target.abort();
    }

    return changed;
}

trusted internal func take_driver_attachment(pos owner: &Current) -> bray.runtime.bootstrap.host.attachment.Owner?
    requires(trusted view_owned(owner = &owner.acquisition), owner.status == 0, trusted driver_closing(owner = owner))
    ensures(trusted view_owned(owner = &owner.acquisition), trusted acquired_attachment_option(owner = &result))
    uses(raw_memory, unchecked_init, intrinsic)
{
    let value = trusted context(owner);
    let pointer = std.memory.uninit_pointer<(bray.runtime.bootstrap.host.attachment.Owner?)>(&value.attachment);

    let permit = trusted lambda(
        pos owner: &Current,
        pos pointer: DataPointer<(bray.runtime.bootstrap.host.attachment.Owner?)>
    )
        requires(trusted view_owned(owner = &owner.acquisition), trusted driver_closing(owner = owner))
        ensures(
            trusted core.memory.valid_read<(bray.runtime.bootstrap.host.attachment.Owner?)>(
                pointer = pointer,
                count = 1
            ),
            trusted core.memory.initialized_as<(bray.runtime.bootstrap.host.attachment.Owner?)>(pointer = pointer),
            trusted core.memory.valid_write<(bray.runtime.bootstrap.host.attachment.Owner?)>(
                pointer = pointer,
                count = 1
            ),
            trusted core.memory.aligned_for<(bray.runtime.bootstrap.host.attachment.Owner?)>(pointer = pointer)
        )
        executes(pure, total) {};

    trusted permit(owner, pointer);

    let attachment = trusted std.memory.read<(bray.runtime.bootstrap.host.attachment.Owner?)>(pointer);

    trusted std.memory.write<(bray.runtime.bootstrap.host.attachment.Owner?)>(pointer, none);
    return attachment;
}

trusted internal func close_driver_binding(pos owner: &bray.runtime.bootstrap.host.ExecutionOwner)
    requires(trusted bray.runtime.bootstrap.host.execution_owned(owner = owner))
    ensures(trusted bray.runtime.bootstrap.host.execution_owned(owner = owner))
{
    let selected = trusted borrow_execution(owner);
    let binding = trusted take_retiring_binding(owner);

    if binding matches ?_
    {
        let closed = trusted close_binding(trusted take_owned_binding(binding));

        trusted install_binding(&selected, closed);
    }
}

trusted internal func close_binding(pos owner: Binding) -> Binding
    requires(trusted kernel_binding(owner = &owner))
    ensures(trusted kernel_binding(owner = &result))
    uses(foreign_call, intrinsic)
{
    let release = owner.release;
    let suspend = owner.suspend;
    let resume = owner.resume;

    let execution_pin = match consume owner.ownership
    {
        case BindingOwnership.Open(value, close) { yield trusted close(value); }
        case BindingOwnership.Cleanup(value) { yield value; }
    };

    return
    {
        ownership = BindingOwnership.Cleanup(execution_pin),
        release = release,
        suspend = suspend,
        resume = resume
    };
}

internal func take_acquired_attachment(
    pos owner: bray.runtime.bootstrap.host.attachment.Owner?
) -> bray.runtime.bootstrap.host.attachment.Owner
    requires(owner matches ?_, trusted acquired_attachment_option(owner = &owner))
    ensures(trusted bray.runtime.bootstrap.host.attachment.acquired(owner = &result), result.status == 0)
    executes(pure, total)
    uses(intrinsic)
{
    return match consume owner
    {
        case ?value { yield value; }
        case none { yield trusted core.target.abort(); }
    };
}

trusted internal func finish_driver_attachment(pos owner: bray.runtime.bootstrap.host.attachment.Owner?) -> u32
    requires(trusted acquired_attachment_option(owner = &owner))
{
    if owner matches ?_
    {
        return trusted bray.runtime.bootstrap.host.attachment.finish(trusted take_acquired_attachment(owner));
    }

    return 0;
}

trusted internal func disarm_driver_attachment(pos owner: bray.runtime.bootstrap.host.attachment.Owner?)
    requires(trusted acquired_attachment_option(owner = &owner), trusted bray.runtime.bootstrap.host.execution_exit())
    executes(pure, total)
{
    // The actual native exit consumes this epoch, including its outstanding
    // acquisition. Transfer the retired carrier to inert storage so its
    // ordinary destructor cannot request a second attachment exit.
    _ = core.memory.uninit_from<(bray.runtime.bootstrap.host.attachment.Owner?)>(owner);
}

@abi(c)
trusted internal func driver_shutdown() -> u32
{
    let attachment =
    {
        let selected = trusted current();

        if selected.status != 0
        {
            return selected.status;
        }

        if !trusted driver_idle(&selected)
        {
            return 3;
        }

        if !trusted begin_driver_close(&selected)
        {
            return 1;
        }

        yield trusted take_driver_attachment(&selected);
    };

    // End the view before attachment exit can retire its sole context owner.
    return trusted finish_driver_attachment(attachment);
}

// Product shutdown ends its driver before completing the optional native host.
// Nested entry scopes retire only their own driver and never finalize that host.
@abi(c)
trusted internal func shutdown() -> u32
    requires(trusted bray.runtime.bootstrap.pool.protocol_access())
    uses(foreign_call)
{
    let control = trusted bray.runtime.bootstrap.entry.bridge.current_control();
    let status = trusted driver_shutdown();

    if status != 0 && status != 1
    {
        return status;
    }

    if let ?complete = control
    {
        let finished = trusted complete(3);

        // Zero means no native host was selected. Nonzero encodes status + 1.
        if finished != 0
        {
            return finished - 1;
        }
    }

    return status;
}
