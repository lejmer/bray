@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.execution;

using core.memory;
using core.target;
using std.memory;
using internal bray.runtime.bootstrap;
using internal bray.runtime.bootstrap.task;
using internal bray.runtime.bootstrap.activation;
using internal bray.runtime.bootstrap.host;
using internal bray.runtime.bootstrap.scheduler;

@abi(c)
trusted internal func task_allocation() -> Admission
    requires(trusted bray.runtime.bootstrap.entry.native_entry(), trusted bray.runtime.bootstrap.host.product.native_host(), trusted bray.runtime.bootstrap.pool.protocol_access())
    ensures(result.status != 0 || trusted resolution_input(owner = &result.task))
    uses(intrinsic)
{
    let selected = trusted current();

    if selected.status != 0
    {
        return { status = selected.status, task = 0 };
    }

    if !has_execution(&selected)
    {
        return { status = 1, task = 0 };
    }

    let (admitted, status) = trusted admit_source_task(&selected, false);

    if admitted matches none
    {
        return { status = status, task = 0 };
    }

    let owner = trusted bray.runtime.bootstrap.task.take_retained(admitted);
    let handle = owner.handle;

    // The returned protected task keeps the source claim. Only the temporary
    // independent storage count ends at this boundary.
    _ = trusted bray.runtime.bootstrap.task.dispose_reference(owner);
    return { status = 0, task = handle };
}

@abi(c)
trusted internal func task_start(pos handle: u64, pos frame: usize, pos outcome: DataPointer<bray.runtime.bootstrap.ReportOutcome>) -> u32
    requires(blocking_execution(), trusted resolution_input(owner = &handle), trusted frame_input(owner = &frame), trusted bray.runtime.bootstrap.entry.native_entry(), trusted bray.runtime.bootstrap.host.product.native_host(), trusted bray.runtime.bootstrap.pool.protocol_access())
{
    if frame == 0 || frame % std.memory.align_of<bray.runtime.bootstrap.activation.Inactive>() != 0
    {
        return 3;
    }

    let selected = trusted current();

    if selected.status != 0
    {
        return selected.status;
    }

    if !has_execution(&selected)
    {
        return 1;
    }

    let execution = trusted bound_execution(&selected);
    let (reference, status) = trusted borrow_resolution(execution, &handle);

    if reference matches none
    {
        return status;
    }

    let owner = trusted bray.runtime.bootstrap.task.take_retained(reference);
    let token = trusted root_frame(&frame);
    let started = trusted start_frame(&selected, &owner, token, none, outcome);

    _ = trusted bray.runtime.bootstrap.task.dispose_reference(owner);
    return started;
}

@abi(c)
trusted internal func task_destruction(pos handle: u64) -> u32
    requires(trusted resolution_input(owner = &handle), trusted bray.runtime.bootstrap.entry.native_entry(), trusted bray.runtime.bootstrap.host.product.native_host(), trusted bray.runtime.bootstrap.pool.protocol_access())
{
    let selected = trusted current();

    if selected.status != 0
    {
        return selected.status;
    }

    if !has_execution(&selected)
    {
        return 1;
    }

    let execution = trusted bound_execution(&selected);
    let (reference, status) = trusted borrow_resolution(execution, &handle);

    if reference matches none
    {
        return status;
    }

    let owner = trusted bray.runtime.bootstrap.task.take_retained(reference);
    let destroyed = trusted destroy_reference(&selected, &owner);

    _ = trusted bray.runtime.bootstrap.task.dispose_reference(owner);
    return destroyed;
}

@abi(c)
trusted internal func task_wake(pos handle: u64) -> u32
    requires(trusted bray.runtime.bootstrap.entry.native_entry(), trusted bray.runtime.bootstrap.host.product.native_host())
{
    let selected = trusted current();

    if selected.status != 0
    {
        return selected.status;
    }

    if !has_execution(&selected)
    {
        return 1;
    }

    let (reference, status) = trusted retain_task(trusted bound_execution(&selected), handle);

    if reference matches none
    {
        return status;
    }

    let owner = trusted bray.runtime.bootstrap.task.take_retained(reference);
    let awakened = trusted wake_reference(&owner, 1);

    _ = trusted bray.runtime.bootstrap.task.dispose_reference(owner);
    return awakened;
}

@abi(c)
trusted internal func task_cancellation(pos handle: u64) -> u32
    requires(trusted resolution_input(owner = &handle), trusted bray.runtime.bootstrap.entry.native_entry(), trusted bray.runtime.bootstrap.host.product.native_host())
    uses(intrinsic)
{
    return trusted cancellation_action(&handle);
}

@abi(c)
trusted internal func root_cancellation(pos handle: u64) -> u32
    requires(trusted resolution_input(owner = &handle), trusted bray.runtime.bootstrap.entry.native_entry(), trusted bray.runtime.bootstrap.host.product.native_host())
{
    return trusted cancellation_action(&handle);
}

trusted internal func cancellation_action(pos handle: &u64) -> u32
    requires(trusted resolution_input(owner = handle), trusted bray.runtime.bootstrap.entry.native_entry(), trusted bray.runtime.bootstrap.host.product.native_host())
    ensures(trusted resolution_input(owner = handle))
    uses(raw_memory)
{
    let selected = trusted current();

    if selected.status != 0
    {
        return selected.status;
    }

    if !has_execution(&selected)
    {
        return 1;
    }

    let (reference, status) = trusted retain_task(trusted bound_execution(&selected), trusted std.memory.read<u64>(std.memory.address_of<u64>(handle)));

    if reference matches none
    {
        return status;
    }

    let owner = trusted bray.runtime.bootstrap.task.take_retained(reference);
    let requested = trusted request_cancellation(&owner);

    _ = trusted bray.runtime.bootstrap.task.dispose_reference(owner);
    return requested;
}

trusted internal func request_cancellation(pos owner: &bray.runtime.bootstrap.task.Reference) -> u32
    requires(trusted bray.runtime.bootstrap.task.retained(owner = owner), trusted bray.runtime.bootstrap.task.owned_reference(owner = owner))
    ensures(trusted bray.runtime.bootstrap.task.retained(owner = owner), trusted bray.runtime.bootstrap.task.owned_reference(owner = owner))
    uses(intrinsic)
{
    let requested = trusted bray.runtime.bootstrap.task.cancellation_change(owner, 1);

    if (requested & 2) != 0
    {
        return trusted wake_reference(owner, bray.runtime.bootstrap.scheduler.WAKE_CANCELLATION);
    }

    return 0;
}
