@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.execution;

using core.atomic;
using core.memory;
using core.target;
using std.memory;
using internal bray.runtime.bootstrap;
using internal bray.runtime.bootstrap.host;
using internal bray.runtime.bootstrap.heap;

trusted internal predicate execution_prepared(owner: &bray.runtime.bootstrap.host.ExecutionOwner);

trusted internal predicate context_binding_released(owner: &Context);

trusted internal func withdraw_inactive_driver(pos owner: &Current) -> bray.runtime.bootstrap.host.ExecutionOwner?
    requires(trusted view_owned(owner = &owner.acquisition), owner.status == 0)
    ensures(trusted view_owned(owner = &owner.acquisition), (result matches none || trusted bray.runtime.bootstrap.host.execution_option_owned(owner = &result)))
    uses(intrinsic)
{
    if trusted driver_start_status(owner) != 0
    {
        trusted core.target.abort();
    }

    let mut withdrawn = trusted take_previous(owner);

    trusted bray.runtime.bootstrap.host.enter_attachment_execution(&mut withdrawn);

    if trusted bray.runtime.bootstrap.host.exchange_attachment_execution(&mut withdrawn) != 0
    {
        trusted core.target.abort();
    }

    return withdrawn;
}

trusted internal func take_retiring_context(pos owner: &bray.runtime.bootstrap.host.ExecutionOwner) -> Context
    requires(trusted bray.runtime.bootstrap.host.execution_owned(owner = owner), trusted execution_prepared(owner = owner))
    ensures(
        trusted context_owned(owner = &result),
        trusted context_binding_released(owner = &result),
        trusted core.memory.owned_allocation(pointer = owner.resource, bytes = std.memory.stride_of<Context>(), align = std.memory.align_of<Context>())
    )
    uses(raw_memory, layout_reinterpret, intrinsic)
{
    let pointer = trusted std.memory.reinterpret<Context, u8>(owner.resource);

    let permit = trusted lambda(pos owner: &bray.runtime.bootstrap.host.ExecutionOwner, pos pointer: DataPointer<Context>)
        requires(trusted bray.runtime.bootstrap.host.execution_owned(owner = owner))
        ensures(
            trusted core.memory.valid_read<Context>(pointer = pointer, count = 1),
            trusted core.memory.initialized_as<Context>(pointer = pointer),
            trusted core.memory.aligned_for<Context>(pointer = pointer)
        )
        executes(pure, total) {};

    trusted permit(owner, pointer);
    return trusted std.memory.read<Context>(pointer);
}

trusted internal func take_context_resources(pos mut owner: Context, pos identity: u64) -> (bray.runtime.bootstrap.host.attachment.Owner?, bray.runtime.bootstrap.host.ExecutionOwner?)
    requires(trusted context_owned(owner = &owner), trusted context_binding_released(owner = &owner), identity == 0 || trusted bray.runtime.bootstrap.host.execution_exit())
    ensures(
        trusted acquired_attachment_option(owner = &result.0),
        (result.1 matches none || trusted bray.runtime.bootstrap.host.execution_option_owned(owner = &result.1)),
        identity == 0 || trusted bray.runtime.bootstrap.host.execution_exit()
    )
    executes(total)
    uses(raw_memory, intrinsic)
{
    let attachment = std.memory.uninit_pointer<(bray.runtime.bootstrap.host.attachment.Owner?)>(&owner.attachment);
    let previous = std.memory.uninit_pointer<(bray.runtime.bootstrap.host.ExecutionOwner?)>(&owner.previous);
    let prepare = trusted lambda(
        pos owner: &Context,
        pos attachment: DataPointer<(bray.runtime.bootstrap.host.attachment.Owner?)>,
        pos previous: DataPointer<(bray.runtime.bootstrap.host.ExecutionOwner?)>
    )
        requires(trusted context_owned(owner = owner))
        ensures(
            trusted core.memory.valid_read<(bray.runtime.bootstrap.host.attachment.Owner?)>(pointer = attachment, count = 1),
            trusted core.memory.initialized_as<(bray.runtime.bootstrap.host.attachment.Owner?)>(pointer = attachment),
            trusted core.memory.aligned_for<(bray.runtime.bootstrap.host.attachment.Owner?)>(pointer = attachment),
            trusted core.memory.valid_read<(bray.runtime.bootstrap.host.ExecutionOwner?)>(pointer = previous, count = 1),
            trusted core.memory.initialized_as<(bray.runtime.bootstrap.host.ExecutionOwner?)>(pointer = previous),
            trusted core.memory.aligned_for<(bray.runtime.bootstrap.host.ExecutionOwner?)>(pointer = previous)
        )
        executes(pure, total) {};

    trusted prepare(&owner, attachment, previous);

    return (
        trusted std.memory.read<(bray.runtime.bootstrap.host.attachment.Owner?)>(attachment),
        trusted std.memory.read<(bray.runtime.bootstrap.host.ExecutionOwner?)>(previous)
    );
}

trusted internal func close_retiring_owner(pos owner: &bray.runtime.bootstrap.host.ExecutionOwner, pos identity: u64)
    requires(trusted bray.runtime.bootstrap.host.execution_owned(owner = owner), identity == 0 || trusted bray.runtime.bootstrap.host.execution_exit())
    ensures(trusted bray.runtime.bootstrap.host.execution_owned(owner = owner), identity == 0 || trusted bray.runtime.bootstrap.host.execution_exit())
    uses(intrinsic)
{
    {
        let selected = trusted borrow_execution(owner);

        if !trusted driver_idle(&selected)
        {
            trusted core.target.abort();
        }

        if identity != 0
        {
            let value = trusted context(&selected);

            if value.thread != identity
            {
                trusted core.target.abort();
            }
        }

        _ = trusted begin_driver_close(&selected);

        // Host attachment exit reaches this owner after exact-thread cleanup.
        // A previously requested Main shutdown only marked the driver closing.
    }

    trusted close_driver_binding(owner);
}

trusted internal func prepare_retirement(pos owner: &bray.runtime.bootstrap.host.ExecutionOwner, pos identity: u64) -> u32
    requires(trusted bray.runtime.bootstrap.host.execution_owned(owner = owner), identity == 0 || trusted bray.runtime.bootstrap.host.execution_exit())
    ensures(trusted bray.runtime.bootstrap.host.execution_owned(owner = owner), trusted execution_prepared(owner = owner), identity == 0 || trusted bray.runtime.bootstrap.host.execution_exit())
    uses(intrinsic)
{
    trusted close_retiring_owner(owner, identity);

    // The actual binding retains native code until the exact-thread provider
    // scope has finished restoring its callbacks.
    _ = trusted take_native_provider(owner);

    let incidents = trusted release_driver_binding(owner);

    // An explicit withdrawal may already have restored an enclosing context.
    // Clear only this actual owner's borrowed address before freeing it.
    let installed = match consume trusted bray.runtime.bootstrap.host.execution_context(none)
    {
        case Ok(value) { yield value; }
        case Error(_) { yield trusted core.target.abort(); }
    };

    if trusted core.target.address_equal<u8>(installed, owner.resource)
    {
        match consume trusted bray.runtime.bootstrap.host.execution_context(std.memory.null<u8>())
        {
            case Ok(_) {}
            case Error(_) { trusted core.target.abort(); }
        }
    }

    return incidents;
}

trusted internal func retire_context_resources(
    pos value: Context,
    pos allocation: &bray.runtime.bootstrap.host.ExecutionOwner,
    pos identity: u64
) -> u32
    requires(
        trusted context_owned(owner = &value),
        trusted context_binding_released(owner = &value),
        trusted core.memory.owned_allocation(pointer = allocation.resource, bytes = std.memory.stride_of<Context>(), align = std.memory.align_of<Context>()),
        identity == 0 || trusted bray.runtime.bootstrap.host.execution_exit()
    )
    ensures(trusted core.memory.owned_allocation(pointer = allocation.resource, bytes = std.memory.stride_of<Context>(), align = std.memory.align_of<Context>()))
{
    let (attachment, mut previous) = trusted take_context_resources(value, identity);

    if identity != 0
    {
        trusted disarm_driver_attachment(attachment);

        if previous matches ?_
        {
            trusted bray.runtime.bootstrap.host.enter_attachment_execution(&mut previous);
            return trusted bray.runtime.bootstrap.host.retire_execution(previous, identity);
        }

        return 0;
    }

    if previous matches ?_
    {
        trusted core.target.abort();
    }

    return trusted finish_driver_attachment(attachment);
}

@abi(c)
trusted internal func retire_driver(pos owner: bray.runtime.bootstrap.host.ExecutionOwner, pos identity: u64) -> u32
    requires(trusted bray.runtime.bootstrap.host.execution_owned(owner = &owner), identity == 0 || trusted bray.runtime.bootstrap.host.execution_exit())
{
    let incidents = trusted prepare_retirement(&owner, identity);
    let value = trusted take_retiring_context(&owner);
    let remaining = trusted retire_context_resources(value, &owner, identity);

    trusted bray.runtime.bootstrap.heap.deallocate_bytes(owner.resource, std.memory.stride_of<Context>(), align = std.memory.align_of<Context>());
    return incidents + remaining;
}
