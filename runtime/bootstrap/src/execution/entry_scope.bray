@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.execution;

using core.memory;
using core.target;
using std.memory;
using internal bray.runtime.bootstrap.host;

// This call scope owns the displaced attachment context and its counted view.
// The enclosing dispatch remains intact while its quota claim is suspended.
internal struct EntryScope
{
    current: Current;
    mut previous: bray.runtime.bootstrap.host.ExecutionOwner?;
    isolated: bool;
    suspended: bool;
    mut status: u32;
}

internal predicate entry_scope_owned(owner: &EntryScope) =
    view_owned(owner = &owner.current.acquisition)
    && (owner.previous matches none || bray.runtime.bootstrap.host.execution_option_owned(owner = &owner.previous));

// The native RAII owner lends exclusive, aligned storage for this complete
// Source value. It does not inspect or copy the value's private representation.
// Entry and completion run on the same attachment in strict nesting order.
trusted internal predicate native_scope_storage(owner: &DataPointer<u8>, bytes: usize, align: usize);

trusted internal predicate native_scope_initialized(owner: &DataPointer<u8>);

@abi(c)
trusted internal func native_scope_enter(
    pos storage: DataPointer<u8>,
    pos bytes: usize,
    pos align: usize,
    pos isolate: u32
) -> u32
    requires(trusted native_scope_storage(owner = &storage, bytes = bytes, align = align))
    ensures(trusted native_scope_initialized(owner = &storage))
    uses(raw_memory, unchecked_init, layout_reinterpret, intrinsic)
{
    // A mismatched private ABI is a provider bug. Check before changing entry
    // ownership, so no live Source value can be stranded in undersized storage.
    if bytes < std.memory.stride_of<EntryScope>()
        || align < std.memory.align_of<EntryScope>()
        || isolate > 1
    {
        trusted core.target.abort();
    }

    let scope = trusted entry_scope(isolate != 0);
    let status = scope.status;
    let pointer = trusted std.memory.reinterpret<EntryScope, u8>(storage);
    let permit = trusted lambda(pos storage: &DataPointer<u8>, pos pointer: DataPointer<EntryScope>, pos bytes: usize, pos align: usize)
        requires(trusted native_scope_storage(owner = storage, bytes = bytes, align = align))
        ensures(trusted core.memory.valid_write<EntryScope>(pointer = pointer, count = 1), trusted core.memory.aligned_for<EntryScope>(pointer = pointer))
        executes(pure, total) {};

    trusted permit(&storage, pointer, bytes, align);
    trusted std.memory.write<EntryScope>(pointer, scope);
    return status;
}

@abi(c)
trusted internal func native_scope_finish(pos storage: DataPointer<u8>) -> u32
    requires(trusted native_scope_initialized(owner = &storage))
    uses(raw_memory, layout_reinterpret, intrinsic)
{
    let pointer = trusted std.memory.reinterpret<EntryScope, u8>(storage);
    let take = trusted lambda(pos storage: &DataPointer<u8>, pos pointer: DataPointer<EntryScope>) -> EntryScope
        requires(trusted native_scope_initialized(owner = storage))
        ensures(trusted entry_scope_owned(owner = &result))
        uses(raw_memory, intrinsic)
    {
        let permit = trusted lambda(pos storage: &DataPointer<u8>, pos pointer: DataPointer<EntryScope>)
            requires(trusted native_scope_initialized(owner = storage))
            ensures(
                trusted core.memory.valid_read<EntryScope>(pointer = pointer, count = 1),
                trusted core.memory.aligned_for<EntryScope>(pointer = pointer),
                trusted core.memory.initialized_as<EntryScope>(pointer = pointer)
            )
            executes(pure, total) {};

        trusted permit(storage, pointer);
        return trusted std.memory.read<EntryScope>(pointer);
    };

    return trusted finish_entry_scope(trusted take(&storage, pointer));
}

trusted internal func entry_scope(pos isolate: bool) -> EntryScope
    ensures(trusted view_owned(owner = &result.current.acquisition), (result.previous matches none || trusted bray.runtime.bootstrap.host.execution_option_owned(owner = &result.previous)))
    uses(intrinsic)
{
    let selected = trusted current();

    if !isolate
    {
        return { current = selected, previous = none, isolated = false, suspended = false, status = 0 };
    }

    let suspended = trusted suspend_current(&selected);
    let mut previous: bray.runtime.bootstrap.host.ExecutionOwner? = none;
    let exchanged = trusted bray.runtime.bootstrap.host.exchange_attachment_execution(&mut previous);

    if exchanged != 0
    {
        if suspended
        {
            trusted resume_current(&selected);
        }

        return { current = selected, previous = none, isolated = false, suspended = false, status = exchanged };
    }

    let cleared = trusted bray.runtime.bootstrap.host.execution_context(std.memory.null<u8>());
    let status = match consume cleared
    {
        case Ok(_) { yield 0; }
        case Error(value) { yield value; }
    };

    return { current = selected, previous = previous, isolated = true, suspended = suspended, status = status };
}

trusted internal func finish_entry_scope(pos owner: EntryScope) -> u32
    requires(trusted view_owned(owner = &owner.current.acquisition), owner.previous matches none || trusted bray.runtime.bootstrap.host.execution_option_owned(owner = &owner.previous))
{
    // Finishing the scope transfers its two actual owners. Restoring the saved
    // attachment owner cannot replace the independent counted Current value.
    let isolated = owner.isolated;
    let suspended = owner.suspended;
    let status = owner.status;
    let take = trusted lambda(pos owner: EntryScope) -> (Current, bray.runtime.bootstrap.host.ExecutionOwner?)
        requires(trusted view_owned(owner = &owner.current.acquisition), owner.previous matches none || trusted bray.runtime.bootstrap.host.execution_option_owned(owner = &owner.previous))
        ensures(trusted view_owned(owner = &result.0.acquisition), result.1 matches none || trusted bray.runtime.bootstrap.host.execution_option_owned(owner = &result.1))
        uses(raw_memory, intrinsic)
    {
        return (
            trusted std.memory.read<Current>(std.memory.address_of<Current>(&owner.current)),
            trusted std.memory.read<(bray.runtime.bootstrap.host.ExecutionOwner?)>(std.memory.address_of<(bray.runtime.bootstrap.host.ExecutionOwner?)>(&owner.previous))
        );
    };

    let (selected, displaced) = trusted take(owner);
    let mut saved = displaced;

    if !isolated
    {
        return status;
    }

    let incidents = trusted retire_entry_execution(&selected, &saved);

    trusted restore_entry_execution(&selected, &mut saved);

    if suspended
    {
        trusted resume_current(&selected);
    }

    return if status != 0 { yield status; } else if incidents != 0 { yield 5; } else { yield 0; };
}

trusted internal func retire_entry_execution(pos selected: &Current, pos previous: &(bray.runtime.bootstrap.host.ExecutionOwner?)) -> u32
    requires(trusted view_owned(owner = &selected.acquisition), previous matches none || trusted bray.runtime.bootstrap.host.execution_option_owned(owner = &previous))
    ensures(trusted view_owned(owner = &selected.acquisition), previous matches none || trusted bray.runtime.bootstrap.host.execution_option_owned(owner = &previous))
    uses(intrinsic)
{
    let mut retired: bray.runtime.bootstrap.host.ExecutionOwner? = none;

    if trusted bray.runtime.bootstrap.host.exchange_attachment_execution(&mut retired) != 0
    {
        trusted core.target.abort();
    }

    return if retired matches ?_
    {
        yield trusted bray.runtime.bootstrap.host.retire_execution(retired, 0);
    }
    else
    {
        yield 0;
    };
}

trusted internal func restore_entry_execution(pos selected: &Current, pos previous: &mut(bray.runtime.bootstrap.host.ExecutionOwner?))
    requires(trusted view_owned(owner = &selected.acquisition), previous matches none || trusted bray.runtime.bootstrap.host.execution_option_owned(owner = &previous))
    ensures(trusted view_owned(owner = &selected.acquisition), previous matches none)
    uses(intrinsic)
{
    trusted bray.runtime.bootstrap.host.enter_attachment_execution(previous);

    if trusted bray.runtime.bootstrap.host.exchange_attachment_execution(previous) != 0
    {
        trusted core.target.abort();
    }

    if previous matches none
    {
        return;
    }

    trusted core.target.abort();
}

trusted internal func suspend_current(pos selected: &Current) -> bool
    requires(trusted view_owned(owner = &selected.acquisition))
    ensures(trusted view_owned(owner = &selected.acquisition))
    uses(foreign_call)
{
    if selected.status != 0
    {
        return false;
    }

    if let ?binding = trusted binding_storage(selected)
    {
        trusted authorize_binding_entry(selected);
        return trusted binding.suspend(selected.pointer) != 0;
    }

    return false;
}

trusted internal func resume_current(pos selected: &Current)
    requires(trusted view_owned(owner = &selected.acquisition))
    ensures(trusted view_owned(owner = &selected.acquisition))
    uses(foreign_call)
{
    if selected.status != 0
    {
        trusted core.target.abort();
    }

    if let ?binding = trusted binding_storage(selected)
    {
        trusted authorize_binding_entry(selected);
        trusted binding.resume(selected.pointer);
        return;
    }

    trusted core.target.abort();
}

trusted internal func authorize_binding_entry(pos selected: &Current)
    requires(trusted view_owned(owner = &selected.acquisition), selected.status == 0)
    ensures(trusted view_owned(owner = &selected.acquisition), trusted driver_binding_entry(context = selected.pointer))
    executes(pure, total)
{
}
