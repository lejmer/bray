@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.execution;

using core.memory;
using internal bray.runtime.bootstrap.deadline;
using internal bray.runtime.bootstrap.event;
using internal bray.runtime.bootstrap.host.product;
using internal bray.runtime.bootstrap.worker;

// Native timeout owners retain this same execution through delivery or withdrawal.
// The execution's published broker is also the one polled by its progress workers.
@abi(c)
trusted internal func native_timeout_prepare(
    pos input: DataPointer<Owner>,
    pos failure: DataPointer<bray.runtime.bootstrap.worker.Failure>
) -> u32
    requires(
        blocking_execution(),
        trusted native_owner_slot(owner = &input),
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted bray.runtime.bootstrap.host.product.native_host(),
        trusted bray.runtime.bootstrap.pool.protocol_access()
    )
{
    trusted bray.runtime.bootstrap.host.product.publish_provider<bray.runtime.bootstrap.worker.Failure>(
        failure,
        bray.runtime.bootstrap.worker.no_failure()
    );

    let owner = trusted borrow_native_owner(&input);
    let status = trusted ensure_deadlines(&owner.execution);

    if status != 0
    {
        return status;
    }

    let worker_status = trusted ensure_workers(&owner.execution);

    if worker_status != 0
    {
        return worker_status;
    }

    let demanded = trusted demand_lane(
        &owner.execution,
        {
            placement = 0,
            workload = 0,
            thread = 0
        }
    );

    trusted bray.runtime.bootstrap.host.product.publish_provider<bray.runtime.bootstrap.worker.Failure>(
        failure,
        demanded
    );

    return if demanded.stage == 0
    {
        yield 0;
    }
    else
    {
        yield 4;
    };
}

@abi(c)
trusted internal func native_timeout_registration(
    pos input: DataPointer<Owner>,
    pos deadline: u64,
    pos callback: DataPointer<bray.runtime.bootstrap.event.Callback>,
    pos output: DataPointer<u64>
) -> u32
    requires(
        trusted native_owner_slot(owner = &input),
        trusted bray.runtime.bootstrap.event.callback_slot(pointer = callback),
        trusted bray.runtime.bootstrap.host.product.native_host()
    )
{
    let owner = trusted borrow_native_owner(&input);

    if let ?service = trusted deadlines(&owner.execution)
    {
        return trusted bray.runtime.bootstrap.deadline.registration(
            trusted bray.runtime.bootstrap.deadline.service_pointer(service),
            deadline,
            0,
            callback,
            output
        );
    }

    return 4;
}

@abi(c)
trusted internal func native_timeout_withdrawal(pos input: DataPointer<Owner>, pos identity: u64) -> u32
    requires(trusted native_owner_slot(owner = &input))
{
    let owner = trusted borrow_native_owner(&input);

    if let ?service = trusted deadlines(&owner.execution)
    {
        return trusted bray.runtime.bootstrap.deadline.withdrawal(
            trusted bray.runtime.bootstrap.deadline.service_pointer(service),
            identity
        );
    }

    return 0;
}
