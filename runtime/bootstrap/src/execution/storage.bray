@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.execution;

using core.atomic;
using core.memory;
using std.memory;
using std.sync;
using std.numeric;
using internal std.sync.spin_lock;
using internal std.sync.once;
using internal std.memory;
using internal bray.runtime.bootstrap;
using internal bray.runtime.bootstrap.scheduler;
using internal bray.runtime.bootstrap.heap;

trusted internal func initialize_domain(
    pos allocation: std.memory.RawAllocation,
    pos scheduler: bray.runtime.bootstrap.scheduler.Reference,
    pos arena: bray.runtime.bootstrap.task.ArenaReference,
    pos configuration: Configuration
) -> Owner
    requires(
        allocation.bytes == std.memory.stride_of<Domain>(),
        allocation.align == std.memory.align_of<Domain>(),
        trusted core.memory.owned_allocation(
            pointer = allocation.pointer,
            bytes = std.memory.stride_of<Domain>(),
            align = std.memory.align_of<Domain>()
        ),
        trusted core.memory.valid_write<u8>(pointer = allocation.pointer, count = std.memory.stride_of<Domain>()),
        trusted bray.runtime.bootstrap.scheduler.retained(owner = &scheduler),
        trusted bray.runtime.bootstrap.scheduler.owned_reference(owner = &scheduler),
        trusted native_configuration(owner = &configuration),
        trusted bray.runtime.bootstrap.task.arena_retained(owner = &arena)
    )
    ensures(
        trusted retained(owner = &result.execution),
        trusted service_owner(owner = &result),
        trusted pinned(owner = &result.execution)
    )
    uses(raw_memory, unchecked_init)
{
    let typed = trusted lambda(pos allocation: &std.memory.RawAllocation) -> DataPointer<Domain>
        requires(
            allocation.align == std.memory.align_of<Domain>(),
            trusted core.memory.valid_write<u8>(pointer = allocation.pointer, count = std.memory.stride_of<Domain>())
        )
        ensures(
            trusted core.memory.valid_write<Domain>(pointer = result, count = 1),
            trusted core.memory.aligned_for<Domain>(pointer = result)
        )
        uses(layout_reinterpret)
    {
        return trusted std.memory.reinterpret<Domain, u8>(allocation.pointer);
    };

    let pointer = trusted typed(&allocation);
    let identity = (trusted bray.runtime.bootstrap.task.arena(&arena)).identity;

    trusted std.memory.write<Domain>(
        pointer,
        {
            allocation = allocation,
            scheduler = scheduler,
            identity = identity,
            arena = arena,
            configuration = configuration,
            task_services = trusted task_services(),
            owners = core.atomic.initialize<usize>(1),
            pins = core.atomic.initialize<usize>(1),
            completion = core.atomic.initialize<u32>(0),
            workers = trusted std.sync.Once<bray.runtime.bootstrap.worker.Reference>.empty(),
            deadlines = trusted std.sync.Once<bray.runtime.bootstrap.deadline.Reference>.empty(),
            failure = trusted std.sync.SpinLock<bray.runtime.bootstrap.worker.Failure>(
                bray.runtime.bootstrap.worker.no_failure()
            ),
            reports = trusted std.sync.SpinLock<bray.runtime.bootstrap.report.sink.State>(
                {
                    next_ordinal = 1,
                    incidents = bray.runtime.bootstrap.empty_records(),
                    pending_count = 0,
                    draining = 0
                }
            )
        }
    );

    return
    {
        acquisition = Acquisition
        {
        },
        execution =
        {
            acquisition = Acquisition
            {
            },
            pointer = pointer
        }
    };
}

trusted internal func domain(pos owner: &Reference) -> &Domain
    requires(trusted retained(owner = owner))
    ensures(
        trusted retained(owner = owner),
        trusted bray.runtime.bootstrap.task.arena_retained(owner = &result.arena),
        trusted std.sync.once.valid(&result.workers.prepared.instance),
        trusted std.sync.once.valid(&result.deadlines.prepared.instance),
        trusted std.sync.spin_lock.valid(&result.failure.prepared.instance),
        trusted std.sync.spin_lock.valid(&result.reports.prepared.instance),
        trusted native_configuration(owner = &result.configuration)
    )
    executes(pure, total)
    uses(raw_memory, unchecked_alias)
{
    let permit = trusted lambda(pos owner: &Reference)
        requires(trusted retained(owner = owner))
        ensures(
            trusted core.memory.valid_read<Domain>(pointer = owner.pointer, count = 1),
            trusted core.memory.initialized_as<Domain>(pointer = owner.pointer),
            trusted core.memory.aligned_for<Domain>(pointer = owner.pointer),
            trusted core.memory.shared_alias_valid<Domain>(pointer = owner.pointer),
            trusted core.memory.epoch_current<Domain>(pointer = owner.pointer),
            trusted core.memory.synchronized_access<Domain>(pointer = owner.pointer),
            trusted core.memory.movement_stable<Domain>(pointer = owner.pointer),
            trusted core.memory.finalization_pending<Domain>(pointer = owner.pointer)
        )
        executes(pure, total) {};

    trusted permit(owner);
    return trusted std.memory.borrow_from<Domain, Reference>(owner, owner.pointer);
}

trusted internal func scheduler_reference(pos owner: &Reference) -> &bray.runtime.bootstrap.scheduler.Reference
    requires(trusted retained(owner = owner))
    ensures(trusted retained(owner = owner), trusted bray.runtime.bootstrap.scheduler.retained(owner = result))
    executes(pure, total)
{
    return &(trusted domain(owner)).scheduler;
}

trusted internal func pin(
    pos owner: &bray.runtime.bootstrap.execution.Reference
) -> bray.runtime.bootstrap.execution.Reference
    requires(trusted bray.runtime.bootstrap.execution.retained(owner = owner))
    ensures(
        trusted bray.runtime.bootstrap.execution.retained(owner = owner),
        trusted bray.runtime.bootstrap.execution.retained(owner = &result),
        trusted pinned(owner = &result)
    )
    uses(intrinsic)
{
    let value = trusted domain(owner);
    let mut count = core.atomic.load<usize, 1>(&value.pins);

    while true
    {
        if count == 0 || count == std.numeric.USIZE_MAX
        {
            trusted core.target.abort();
        }

        let (previous, acquired) = core.atomic.compare_exchange<usize, 3, 1>(
            &value.pins,
            expected = count,
            desired = count + 1
        );

        if acquired
        {
            return
            {
                acquisition = Acquisition
                {
                },
                pointer = owner.pointer
            };
        }

        count = previous;
    }
}

trusted internal func dispatch_services(
    pos owner: &bray.runtime.bootstrap.execution.Reference
) -> &bray.runtime.bootstrap.task.Services
    requires(trusted bray.runtime.bootstrap.execution.retained(owner = owner))
    ensures(
        trusted bray.runtime.bootstrap.execution.retained(owner = owner),
        trusted bray.runtime.bootstrap.task.native_services(owner = result)
    )
    executes(pure, total)
{
    return &(trusted domain(owner)).task_services;
}

trusted internal predicate reference_slot(pointer: DataPointer<Reference>);

trusted internal predicate retirement_entry(pointer: DataPointer<Reference>);

trusted internal func read_reference(pos pointer: DataPointer<Reference>) -> Reference
    requires(trusted reference_slot(pointer = pointer))
    ensures(trusted retained(owner = &result))
    uses(raw_memory)
{
    let permit = trusted lambda(pos pointer: DataPointer<Reference>)
        requires(trusted reference_slot(pointer = pointer))
        ensures(
            trusted core.memory.valid_read<Reference>(pointer = pointer, count = 1),
            trusted core.memory.initialized_as<Reference>(pointer = pointer),
            trusted core.memory.aligned_for<Reference>(pointer = pointer)
        )
        executes(pure, total) {};

    trusted permit(pointer);
    return trusted std.memory.read<Reference>(pointer);
}
