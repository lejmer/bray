@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.execution;

using core.atomic;
using core.memory;
using core.target;
using std.memory;
using std.numeric;
using internal bray.runtime.bootstrap;
using internal bray.runtime.bootstrap.heap;

// The caller has selected a live context before constructing its counted view.
trusted internal func acquire_view(pos value: &Context)
{
    let previous = core.atomic.fetch_add<usize, 0>(&value.views, 1);

    if previous == std.numeric.USIZE_MAX
    {
        trusted core.target.abort();
    }
}

trusted internal func release_view(pos owner: &Current)
    requires(trusted view_owned(owner = &owner.acquisition), !std.memory.is_null<Context>(owner.pointer))
    executes(total)
    uses(intrinsic)
{
    let value = trusted view_context(owner);

    // Current owns exactly one counted view. Retirement checks the final count
    // before freeing, and this frequent destructor performs only its decrement.
    _ = core.atomic.fetch_sub<usize, 0>(&value.views, 1);
}

// A view with a nonzero status can still pin a driver that has no async domain.
// Its status controls API availability, independently of allocation lifetime.
trusted internal func view_context(pos owner: &Current) -> &Context
    requires(
        trusted view_owned(owner = &owner.acquisition),
        owner.status == 0 || !std.memory.is_null<Context>(owner.pointer)
    )
    ensures(trusted view_owned(owner = &owner.acquisition))
    executes(pure, total)
    uses(raw_memory, unchecked_alias)
{
    let pointer = owner.pointer;

    let permit = trusted lambda(pos owner: &Current, pos pointer: DataPointer<Context>)
        requires(
            trusted view_owned(owner = &owner.acquisition),
            owner.status == 0 || !std.memory.is_null<Context>(owner.pointer)
        )
        ensures(
            trusted core.memory.valid_read<Context>(pointer = pointer, count = 1),
            trusted core.memory.initialized_as<Context>(pointer = pointer),
            trusted core.memory.aligned_for<Context>(pointer = pointer),
            trusted core.memory.shared_alias_valid<Context>(pointer = pointer),
            trusted core.memory.epoch_current<Context>(pointer = pointer),
            trusted core.memory.synchronized_access<Context>(pointer = pointer),
            trusted core.memory.movement_stable<Context>(pointer = pointer),
            trusted core.memory.finalization_pending<Context>(pointer = pointer)
        )
        executes(pure, total) {};

    trusted permit(owner, pointer);
    return trusted std.memory.borrow_from<Context, Current>(owner, pointer);
}
