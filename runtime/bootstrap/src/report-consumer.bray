@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap;

using std.memory;

@layout(c)
internal struct ReportOutcome
{
    mut state: u32;
    mut payload: usize;
    mut report: PanicReportData;
}

// NativePanicMessage stores typed optional C callbacks. The native report producer
// retains their provider until consumption. Source construction uses selected
// callable values, and the pool only accepts headers with that same protocol.
trusted internal predicate native_primary_callbacks(primary: &ReportPrimary);

trusted internal predicate native_report_callbacks(report: &PanicReportData);

trusted internal predicate native_primary_slot_callbacks(pointer: RawPointer<ReportPrimary>);

trusted internal predicate native_report_slot_callbacks(pointer: RawPointer<PanicReportData>);

internal callable ReportConsumer = @abi(c) trusted func(
    pos pointer: RawPointer<PanicReportData>,
    pos reporting: bool
) -> u32
    requires(
        trusted core.memory.valid_read<PanicReportData>(pointer = pointer, count = 1),
        trusted core.memory.valid_write<PanicReportData>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<PanicReportData>(pointer = pointer),
        trusted core.memory.initialized_as<PanicReportData>(pointer = pointer),
        trusted native_report_slot_callbacks(pointer = pointer),
    );

trusted internal func consume_pointer() -> RawPointer<u8>
    executes(pure, total)
    uses(layout_reinterpret)
{
    let consumer: ReportConsumer = consume_report;

    return trusted std.memory.reinterpret<u8, ReportConsumer>(
        trusted std.memory.pointer_from_callable<ReportConsumer>(consumer)
    );
}

trusted internal func report_primary_value(pos report: PanicReportData) -> ReportPrimary
    requires(trusted native_report_callbacks(report = &report))
    ensures(trusted native_primary_callbacks(primary = &result))
    executes(pure, total)
{
    return
    {
        source_present = report.source_present,
        source_identity = report.source_identity,
        source_start = report.source_start,
        source_end = report.source_end,
        source_version = report.source_version,
        source_namespace_word_0 = report.source_namespace_word_0,
        source_namespace_word_1 = report.source_namespace_word_1,
        source_namespace_word_2 = report.source_namespace_word_2,
        source_namespace_word_3 = report.source_namespace_word_3,
        cause = report.cause,
        message = report.message,
        message_length = report.message_length,
        copy_message = report.copy_message,
        release_message = report.release_message,
    };
}

// The C producer guarantees typed optional callbacks and retains their providers.
// Reading arbitrary initialized bytes cannot establish this protocol.
trusted internal func read_primary(pos pointer: RawPointer<ReportPrimary>) -> ReportPrimary
    requires(
        trusted native_primary_slot_callbacks(pointer = pointer),
        trusted core.memory.valid_write<ReportPrimary>(pointer = pointer, count = 1),
        trusted core.memory.valid_read<ReportPrimary>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<ReportPrimary>(pointer = pointer),
        trusted core.memory.initialized_as<ReportPrimary>(pointer = pointer),
    )
    ensures(
        trusted native_primary_callbacks(primary = &result),
        trusted core.memory.valid_write<ReportPrimary>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<ReportPrimary>(pointer = pointer),
    )
    uses(raw_memory)
{
    return trusted std.memory.read<ReportPrimary>(pointer);
}

trusted internal func primary_release(pos primary: &ReportPrimary) -> PanicMessageRelease?
    requires(trusted native_primary_callbacks(primary = primary))
    uses(layout_reinterpret)
{
    let mut callback: PanicMessageRelease? = none;

    if !std.memory.is_null<u8>(primary.release_message)
    {
        let pointer: RawPointer<PanicMessageRelease> = trusted native_release_address(primary);

        callback = trusted std.memory.callable_from_pointer<PanicMessageRelease>(pointer);
    }

    return callback;
}

trusted internal func native_release_address(pos primary: &ReportPrimary) -> RawPointer<PanicMessageRelease>
    requires(
        trusted native_primary_callbacks(primary = primary),
        !std.memory.is_null<u8>(primary.release_message),
    )
    ensures(trusted core.memory.callable_address_valid<PanicMessageRelease>(pointer = result))
    uses(intrinsic)
{
    // The native protocol supplies exact callback identity and keeps its provider
    // alive through consumption. This projection copies code-address bits without
    // borrowing the C header that carries them.
    return trusted core.target.from_exposed_address<PanicMessageRelease>(
        address = trusted core.target.expose_address<u8>(primary.release_message),
    );
}

trusted internal func release_primary(pos primary: &ReportPrimary, pos callback: PanicMessageRelease?) -> ReportOutcome
    ensures(trusted native_report_callbacks(report = &result.report))
    uses(layout_reinterpret)
{
    let mut outcome: ReportOutcome =
    {
        state = RUN_COMPLETED,
        payload = 0,
        report = empty_panic_report()
    };

    if let ?release = callback
    {
        let output: RawPointer<u8> = trusted std.memory.reinterpret<u8, ReportOutcome>(
            std.memory.address_of_mut<ReportOutcome>(&mut outcome)
        );

        trusted release(primary.message, primary.message_length, output);
    }

    return outcome;
}

@abi(c)
trusted internal func recycle_reservation(pos handle: usize)
    uses(intrinsic)
{
    if handle == 0
    {
        return;
    }

    let mut reserved: ReportRecords =
    {
        head = handle,
        tail = handle,
        count = 1
    };

    let mut primary: ReportPrimary = empty_primary();

    let pointer: RawPointer<ReportPrimary> = std.memory.address_of_mut<ReportPrimary>(&mut primary);

    trusted report_records_pop(std.memory.address_of_mut<ReportRecords>(&mut reserved), pointer);
    primary = trusted read_primary(pointer);
    let callback: PanicMessageRelease? = trusted primary_release(&primary);
    let outcome: ReportOutcome = trusted release_primary(&primary, callback);

    if outcome.state != RUN_COMPLETED
    {
        trusted core.target.abort();
    }
}

@abi(c)
trusted internal func consume_report(pos pointer: RawPointer<PanicReportData>, pos reporting: bool) -> u32
    requires(
        trusted core.memory.valid_read<PanicReportData>(pointer = pointer, count = 1),
        trusted core.memory.valid_write<PanicReportData>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<PanicReportData>(pointer = pointer),
        trusted core.memory.initialized_as<PanicReportData>(pointer = pointer),
        trusted native_report_slot_callbacks(pointer = pointer),
    )
    uses(intrinsic, foreign_call)
{
    let owned: PanicReportData = trusted take_report(pointer);

    let mut remaining: ReportRecords =
    {
        head = owned.outgoing_head,
        tail = owned.outgoing_tail,
        count = owned.outgoing_count
    };

    let reserved: usize = owned.reserved;
    let mut primary: ReportPrimary = report_primary_value(owned);

    let mut callback: PanicMessageRelease? = trusted primary_release(&primary);

    trusted recycle_reservation(reserved);

    let mut status: u32 = STATUS_SUCCESS;

    loop
    {
        if reporting
        {
            let found: u32 = trusted substrate_report_primary(std.memory.address_of<ReportPrimary>(&primary));

            if status == STATUS_SUCCESS
            {
                status = found;
            }
        }

        let mut release: ReportOutcome = trusted release_primary(&primary, callback);

        if release.state == RUN_PANICKED
        {
            if status == STATUS_SUCCESS
            {
                status = STATUS_PANICKED;
            }

            let mut incidents: ReportRecords =
            {
                head = release.report.outgoing_head,
                tail = release.report.outgoing_tail,
                count = release.report.outgoing_count
            };

            let reservation: usize = release.report.reserved;

            primary = trusted report_primary_value(release.report);
            callback = trusted primary_release(&primary);
            trusted recycle_reservation(reservation);

            trusted report_records_append(
                std.memory.address_of_mut<ReportRecords>(&mut incidents),
                std.memory.address_of_mut<ReportRecords>(&mut remaining)
            );

            remaining = incidents;
        }
        else
        {
            if release.state != RUN_COMPLETED
            {
                trusted core.target.abort();
            }

            if remaining.count == 0
            {
                return status;
            }

            let next_primary: RawPointer<ReportPrimary> = std.memory.address_of_mut<ReportPrimary>(&mut primary);

            trusted report_records_pop(std.memory.address_of_mut<ReportRecords>(&mut remaining), next_primary);
            primary = trusted read_primary(next_primary);
            callback = trusted primary_release(&primary);
        }
    }
}

@link(name = "bray_runtime_host", kind = system)
@symbol(name = "bray_runtime_substrate_report_primary")
@abi(c)
extern trusted internal func substrate_report_primary(pos primary: RawPointer<ReportPrimary>) -> u32
    uses(foreign_call);
