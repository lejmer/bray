@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.task;

using core.memory;
using core.target;
using std.memory;
using internal bray.runtime.bootstrap;
using internal bray.runtime.bootstrap.activation;
using internal bray.runtime.bootstrap.activation.run;
using internal bray.runtime.bootstrap.activation.requirements;
using internal bray.runtime.bootstrap.entry;
using internal bray.runtime.bootstrap.pool;
using internal bray.runtime.bootstrap.host.product;

// This output slot is disjoint from the retained native input owners.
trusted internal predicate dispatch_failure(pointer: DataPointer<bray.runtime.bootstrap.worker.Failure>);

@abi(c)
trusted internal func dispatch(
    pos pointer: DataPointer<Reference>,
    pos service_pointer: DataPointer<Services>,
    pos failure_pointer: DataPointer<bray.runtime.bootstrap.worker.Failure>,
    pos progress: DataPointer<bray.runtime.bootstrap.activation.Progress>,
    pos execution: DataPointer<bray.runtime.bootstrap.activation.requirements.Execution>
) -> u32
    requires(
        trusted reference_slot(owner = &pointer),
        trusted service_slot(owner = &service_pointer),
        trusted dispatch_failure(pointer = failure_pointer),
        trusted bray.runtime.bootstrap.host.product.native_host(),
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted bray.runtime.bootstrap.pool.protocol_access()
    )
    uses(raw_memory)
{
    let reference = trusted borrow_reference(&pointer);
    let services = trusted borrow_services(&service_pointer);

    let permit = trusted lambda(pos pointer: DataPointer<bray.runtime.bootstrap.worker.Failure>)
        requires(trusted dispatch_failure(pointer = pointer))
        ensures(
            trusted core.memory.valid_read<bray.runtime.bootstrap.worker.Failure>(pointer = pointer, count = 1),
            trusted core.memory.initialized_as<bray.runtime.bootstrap.worker.Failure>(pointer = pointer),
            trusted core.memory.aligned_for<bray.runtime.bootstrap.worker.Failure>(pointer = pointer)
        )
        executes(pure, total) {};

    trusted permit(failure_pointer);

    let mut failure = trusted std.memory.read<bray.runtime.bootstrap.worker.Failure>(failure_pointer);
    let claim = trusted acquire_dispatch(reference, services, failure.stage != 0);

    if !claim.active
    {
        return 6;
    }

    let (returned, final_execution, kind) = trusted advance_dispatch(&claim, &mut failure);

    trusted release_dispatch(claim, &failure);

    trusted bray.runtime.bootstrap.host.product.publish_provider<bray.runtime.bootstrap.worker.Failure>(
        failure_pointer,
        failure
    );

    trusted bray.runtime.bootstrap.host.product.publish_provider<bray.runtime.bootstrap.activation.Progress>(
        progress,
        returned
    );

    trusted bray.runtime.bootstrap.host.product.publish_provider<
        bray.runtime.bootstrap.activation.requirements.Execution
    >(execution, final_execution);

    return kind;
}

trusted internal func frame_snapshot(
    pos owner: &Dispatch,
    pos cancellation: bool
) -> bray.runtime.bootstrap.activation.requirements.Execution
    requires(owner.active, owner.root != 0, trusted dispatch_acquired(owner = &owner.acquisition))
    ensures(trusted dispatch_acquired(owner = &owner.acquisition))
    uses(intrinsic)
{
    let mut output: bray.runtime.bootstrap.activation.requirements.Execution =
    {
        address = 0,
        identity = [0; 32],
        state = 0,
        requirements =
        {
            affinity = 0,
            lanes = 0
        },
        origin = 0
    };

    let root = trusted core.target.from_exposed_address<bray.runtime.bootstrap.activation.Header>(address = owner.root);
    let destination = std.memory.address_of_mut<bray.runtime.bootstrap.activation.requirements.Execution>(&mut output);

    let permit = trusted lambda(
        pos owner: &Dispatch,
        pos root: DataPointer<bray.runtime.bootstrap.activation.Header>,
        pos output: DataPointer<bray.runtime.bootstrap.activation.requirements.Execution>
    )
        requires(owner.active, trusted dispatch_acquired(owner = &owner.acquisition))
        ensures(
            trusted bray.runtime.bootstrap.activation.run.owned(root = root),
            trusted bray.runtime.bootstrap.activation.run.snapshot_destination(root = root, output = output)
        )
        executes(pure, total) {};

    trusted permit(owner, root, destination);
    trusted bray.runtime.bootstrap.activation.run.snapshot(root, flag(cancellation), destination);
    return output;
}

trusted internal func suspend_dispatch(
    pos owner: &Dispatch,
    pos execution: bray.runtime.bootstrap.activation.requirements.Execution
)
    requires(owner.active, trusted dispatch_acquired(owner = &owner.acquisition))
    ensures(trusted dispatch_acquired(owner = &owner.acquisition))
{
    let reference = trusted dispatch_reference(owner);
    let mut guard = trusted lock_cell(reference);

    trusted suspend(trusted guard.get(), execution);
}

// Publish only after frame cleanup. Worker admission failure first uses ordinary
// abandonment, then becomes the task's terminal panic.
trusted internal func complete_dispatch(
    pos owner: &Dispatch,
    pos execution: bray.runtime.bootstrap.activation.requirements.Execution,
    pos mut progress: bray.runtime.bootstrap.activation.Progress,
    pos failure: &mut bray.runtime.bootstrap.worker.Failure
) -> bray.runtime.bootstrap.activation.Progress
    requires(
        owner.active,
        trusted dispatch_acquired(owner = &owner.acquisition),
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted bray.runtime.bootstrap.host.product.native_host(),
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted bray.runtime.bootstrap.native_report_callbacks(report = &progress.report)
    )
    ensures(
        trusted dispatch_acquired(owner = &owner.acquisition),
        trusted bray.runtime.bootstrap.native_report_callbacks(report = &result.report)
    )
    uses(intrinsic)
{
    let reference = trusted dispatch_reference(owner);

    trusted close_cancellation(reference);

    // A completed value already committed before the fault keeps its observation.
    // The native terminal path reports that late failure as an incident instead.
    let mut terminal_progress = if failure.stage != 0 && progress.kind != 1
    {
        let reserved =
        {
            let mut guard = trusted lock_cell(reference);
            let control = trusted guard.get();

            yield std.memory.replace_value<bray.runtime.bootstrap.ReportRecords>(
                &mut control.failure_records,
                bray.runtime.bootstrap.empty_records()
            );
        };

        if reserved.count != 1
        {
            trusted core.target.abort();
        }

        let incoming: bray.runtime.bootstrap.activation.Progress =
        {
            kind = 3,
            state = progress.state,
            payload = 0,
            report = trusted bray.runtime.bootstrap.worker.failure_report(&failure, reservation = reserved.head)
        };

        let merged = trusted bray.runtime.bootstrap.activation.execution.merge_panic(&mut progress, incoming);

        failure.stage = 0;
        yield merged;
    }
    else
    {
        yield progress;
    };

    let outcome: bray.runtime.bootstrap.ReportOutcome =
    {
        state = terminal_progress.kind - 1,
        payload = terminal_progress.payload,
        report = trusted bray.runtime.bootstrap.activation.execution.take_report(&mut terminal_progress)
    };

    let unused =
    {
        let current_reference = trusted dispatch_reference(owner);
        let mut guard = trusted lock_cell(current_reference);
        let control = trusted guard.get();

        control.execution = execution;
        trusted complete(control, outcome);

        yield std.memory.replace_value<bray.runtime.bootstrap.ReportRecords>(
            &mut control.failure_records,
            bray.runtime.bootstrap.empty_records()
        );
    };

    _ = trusted bray.runtime.bootstrap.consume_record_values(unused, 0);

    terminal_progress.payload = 0;

    trusted notify_waiters(owner, 0);
    return terminal_progress;
}

internal func yielded(pos state: u32) -> bray.runtime.bootstrap.activation.Progress
{
    return
    {
        kind = 5,
        state = state,
        payload = 0,
        report = bray.runtime.bootstrap.empty_panic_report()
    };
}

// A dispatch runs outside the cell lock. Producer code may wake, observe or
// resolve other tasks, while this noncopy claim excludes another dispatcher.
// Zero means suspended, one means terminal, and three means no producer work.
trusted internal func advance_dispatch(
    pos owner: &Dispatch,
    pos failure: &mut bray.runtime.bootstrap.worker.Failure
) -> (bray.runtime.bootstrap.activation.Progress, bray.runtime.bootstrap.activation.requirements.Execution, u32)
    requires(
        owner.active,
        owner.root != 0,
        trusted dispatch_acquired(owner = &owner.acquisition),
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted bray.runtime.bootstrap.host.product.native_host(),
        trusted bray.runtime.bootstrap.pool.protocol_access()
    )
    uses(intrinsic)
{
    let initial = trusted snapshot_dispatch(owner);

    if initial.phase == 3 || initial.phase == 4
    {
        if initial.phase == 4 && initial.retiring != 0
        {
            let status = trusted retire_dispatch(owner);

            return (yielded(initial.execution.state), initial.execution, status);
        }

        return (bray.runtime.bootstrap.activation.empty_progress(), initial.execution, 3);
    }

    let mut transitions: usize = 0;

    while transitions < 256
    {
        transitions += 1;

        let (mut progress, mut unused, mut incidents, status) = trusted step_dispatch(owner, failure.stage != 0);

        if unused.count != 0 || incidents.count != 0
        {
            let execution = trusted frame_snapshot(owner, false);

            trusted transfer_dispatch(owner, &execution, &mut unused, &mut incidents);
        }

        if status == bray.runtime.bootstrap.activation.run.CONTINUE
        {
            continue;
        }

        if status == bray.runtime.bootstrap.activation.run.FINISHED
        {
            let execution = trusted frame_snapshot(owner, false);

            let returned = trusted complete_dispatch(owner, execution, progress, failure);

            return (returned, execution, 1);
        }

        let cancellation = trusted dispatch_cancellation(owner);
        let execution = trusted frame_snapshot(owner, cancellation);

        if status == bray.runtime.bootstrap.activation.run.DEFERRED
        {
            if progress.payload != 6
            {
                trusted core.target.abort();
            }

            progress = yielded(execution.state);
        }
        else if status != bray.runtime.bootstrap.activation.run.SUSPEND
        {
            trusted core.target.abort();
        }

        trusted suspend_dispatch(owner, execution);
        return (progress, execution, 0);
    }

    let cancellation = trusted dispatch_cancellation(owner);
    let execution = trusted frame_snapshot(owner, cancellation);

    trusted suspend_dispatch(owner, execution);
    return (yielded(execution.state), execution, 0);
}

trusted internal func snapshot_dispatch(pos owner: &Dispatch) -> Snapshot
    requires(owner.active, owner.root != 0, trusted dispatch_acquired(owner = &owner.acquisition))
    ensures(trusted dispatch_acquired(owner = &owner.acquisition))
{
    let reference = trusted dispatch_reference(owner);
    let mut guard = trusted lock_cell(reference);
    let control = trusted guard.get();

    return snapshot_value(&control);
}

trusted internal func dispatch_cancellation(pos owner: &Dispatch) -> bool
    requires(owner.active, owner.root != 0, trusted dispatch_acquired(owner = &owner.acquisition))
    ensures(trusted dispatch_acquired(owner = &owner.acquisition))
{
    let reference = trusted dispatch_reference(owner);

    return trusted cancellation_observable(reference);
}

trusted internal func transfer_dispatch(
    pos owner: &Dispatch,
    pos execution: &bray.runtime.bootstrap.activation.requirements.Execution,
    pos unused: &mut bray.runtime.bootstrap.ReportRecords,
    pos incidents: &mut bray.runtime.bootstrap.ReportRecords
)
    requires(owner.active, owner.root != 0, trusted dispatch_acquired(owner = &owner.acquisition))
    ensures(trusted dispatch_acquired(owner = &owner.acquisition))
{
    trusted transfer_service(trusted dispatch_services(owner), execution, unused, incidents);
}

trusted internal func step_dispatch(
    pos owner: &Dispatch,
    pos worker_failed: bool
) -> (
        bray.runtime.bootstrap.activation.Progress,
        bray.runtime.bootstrap.ReportRecords,
        bray.runtime.bootstrap.ReportRecords,
        u32
    )
    requires(
        owner.active,
        owner.root != 0,
        trusted dispatch_acquired(owner = &owner.acquisition),
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted bray.runtime.bootstrap.pool.protocol_access()
    )
    ensures(
        trusted dispatch_acquired(owner = &owner.acquisition),
        trusted bray.runtime.bootstrap.native_report_callbacks(report = &result.0.report)
    )
{
    let services = trusted dispatch_services(owner);
    let (invoke, ready) = trusted activation_callbacks(services);

    let cancellation = trusted dispatch_cancellation(owner);
    let reference = trusted dispatch_reference(owner);
    let failed = worker_failed && !trusted cancellation_shielded(reference);
    let mut frame_cursor = trusted cursor(owner);

    if failed
    {
        frame_cursor = trusted cancel_wait_service(services, frame_cursor);
    }

    return trusted bray.runtime.bootstrap.activation.run.step(
        frame_cursor,
        invoke,
        ready,
        cancellation,
        abandoning = failed
    );
}
