@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.task;

using core.memory;
using core.atomic;
using core.target;
using std.memory;
using std.numeric;
using std.sync;
using internal std.memory;
using internal std.sync.spin_lock;
using internal bray.runtime.bootstrap;
using internal bray.runtime.bootstrap.heap;
using internal bray.runtime.bootstrap.host;
using internal bray.runtime.bootstrap.host.product;

trusted internal func new_arena_identity() -> u64
    requires(trusted bray.runtime.bootstrap.host.product.native_host())
{
    let lease = trusted bray.runtime.bootstrap.host.host_access();

    if !lease.active
    {
        return 0;
    }

    let mut anchor = trusted bray.runtime.bootstrap.host.host_anchor(&lease);
    let host = trusted bray.runtime.bootstrap.host.host_value(&lease, &mut anchor);

    if host.transitioning || host.next_identity == std.numeric.U64_MAX
    {
        return 0;
    }

    let identity = host.next_identity;

    host.next_identity += 1;
    return identity;
}

// Native callers own the returned arena reference independently of an executor.
@abi(c)
trusted internal func creation(pos output: DataPointer<ArenaReference>) -> u64
    requires(trusted bray.runtime.bootstrap.host.product.native_host())
{
    let created = catch trusted create_arena();

    let optional = match consume created
    {
        case Ok(value) { yield value; }
        case Error(_) { return 0; }
    };

    if optional matches none
    {
        return 0;
    }

    let owner = trusted take_arena(optional);
    let identity = (trusted arena(&owner)).identity;

    trusted bray.runtime.bootstrap.host.product.publish_provider<ArenaReference>(output, owner);
    return identity;
}

// Admission creates the source claim before an inactive frame transfers.
@abi(c)
trusted internal func admission(pos input: DataPointer<ArenaReference>) -> u64
    requires(trusted arena_reference_slot(owner = &input), trusted bray.runtime.bootstrap.host.product.native_host())
{
    // Generic buffer cleanup can require report backing before its fallible
    // allocation is attempted. Keep that failure inside this native boundary;
    // the source start operation still owns and resolves its inactive frame.
    let directory = trusted borrow_arena_reference(&input);

    let admitted = catch trusted admit(directory);

    let reference = match consume admitted
    {
        case Ok(value) { yield value; }
        case Error(_) { return 0; }
    };

    if reference matches none
    {
        return 0;
    }

    let owner = trusted take_retained(reference);
    let handle = owner.handle;

    // The native handle receives the source claim. It does not retain the
    // additional storage reference used by ordinary Source admission.
    _ = trusted dispose_reference(owner);

    return handle;
}

trusted internal func admit(pos directory: &ArenaReference) -> Reference?
    requires(trusted arena_retained(owner = directory), trusted bray.runtime.bootstrap.host.product.native_host())
    ensures(
        trusted arena_retained(owner = directory),
        trusted retained_option(owner = &result),
        trusted resolution_owner_option(owner = &result)
    )
{
    // This report allowance belongs to the task, independently of any frame's
    // body panic. Admission and recycling happen outside the host acquisition.
    let mut failure_records = trusted bray.runtime.bootstrap.report.chain.admit(1);

    if failure_records.status != 0
    {
        return none;
    }

    let protocol = trusted lambda(pos owner: &bray.runtime.bootstrap.report.chain.Owner)
        requires(trusted bray.runtime.bootstrap.report.chain.owned(owner = owner))
        ensures(trusted bray.runtime.bootstrap.pool.protocol_access())
        executes(pure, total) {};

    trusted protocol(&failure_records);

    let mut prepared: Prepared =
    {
        slabs = none,
        slots = none
    };

    while true
    {
        let request =
        {
            let lease = trusted bray.runtime.bootstrap.host.host_access();

            if !lease.active
            {
                return none;
            }

            let mut anchor = trusted arena_anchor(directory, &lease);
            let entries = trusted arena_entries(&mut anchor);

            yield match consume trusted admit_locked(entries, &mut prepared, failure_records.records, directory)
            {
                case Ok(reference)
                {
                    // Commit the admitted allowance before releasing host access.
                    // Growth borrows no report owner and cannot consume its witness.
                    if reference matches ?_
                    {
                        _ = trusted bray.runtime.bootstrap.report.chain.take(&mut failure_records);
                    }

                    return reference;
                }
                case Error(request) { yield request; }
            };
        };

        if !trusted prepare_growth(&mut prepared, request)
        {
            return none;
        }
    }
}

internal func admit_locked(
    pos entries: &mut Entries,
    pos prepared: &mut Prepared,
    pos failure_records: bray.runtime.bootstrap.ReportRecords,
    pos directory: &ArenaReference
) -> Result<(Reference?), Growth>
    requires(trusted arena_retained(owner = directory))
    ensures(trusted arena_retained(owner = directory))
{
    let runtime = (trusted arena(directory)).identity;

    while true
    {
        match consume trusted grow(entries, prepared)
        {
            case Ok(ready)
            {
                if !ready
                {
                    return Ok(none);
                }
            }
            case Error(request) { return Error(request); }
        }

        let index = entries.free;
        let slot = trusted slot_at(entries, index);

        if slot.generation == 0x7fffffff
        {
            // Exhausted cells are never reused, so an old handle cannot
            // become current after generation wraparound.
            entries.free = slot.next;

            continue;
        }

        slot.generation += 1;

        let generation = slot.generation;
        let next = slot.next;

        slot.next = 0;
        slot.runtime = runtime;
        core.atomic.store<usize, 4>(&slot.cancellation, 0);

        let storage_owner: ArenaReference? = trusted retain_arena(directory);

        slot.arena_owner = core.memory.uninit_from<(ArenaReference?)>(storage_owner);

        slot.control = core.memory.uninit_from<std.sync.SpinLock<Control>>(
            trusted std.sync.SpinLock<Control>(prepare(failure_records))
        );

        entries.free = next;
        entries.active += 1;

        let committed = trusted slot_at(entries, index);
        let handle = (std.numeric.truncate_to<u64, u32>(generation) << 32) | std.numeric.truncate_to<u64, usize>(index);

        let commit = trusted lambda(pos slot: &Slot, pos runtime: u64, pos handle: u64) -> Reference
            ensures(
                trusted retained(owner = &result),
                trusted owned_reference(owner = &result),
                trusted resolution_owner(owner = &result)
            )
        {
            return
            {
                acquisition = bray.runtime.bootstrap.task.Marker
                {
                },
                pointer = std.memory.address_of<Slot>(slot),
                runtime = runtime,
                handle = handle
            };
        };

        // Initialization commits both the source claim and this storage pin.
        // Forward their actual canonical reference out of the host acquisition.
        let reference: Reference? = trusted commit(&committed, runtime, handle);

        return Ok(reference);
    }
}

// The native provider transfers its admitted owner only when its complete task
// context is installed. The task cell then owns release of that provider gate.
trusted internal predicate native_context_transfer(owner: &DataPointer<Reference>, context: usize);

@abi(c)
trusted internal func native_context_publication(pos pointer: DataPointer<Reference>, pos context: usize)
    requires(
        trusted reference_slot(owner = &pointer),
        trusted native_context_transfer(owner = &pointer, context = context),
        context != 0
    )
    uses(intrinsic)
{
    let reference = trusted borrow_reference(&pointer);
    let mut guard = trusted lock_cell(reference);
    let control = trusted guard.get();

    if !(control.phase matches Phase.Admitted) || control.registration != 0 || control.native_context != 0
    {
        trusted core.target.abort();
    }

    control.native_context = context;
}
