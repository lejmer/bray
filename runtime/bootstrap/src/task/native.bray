@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.task;

using core.memory;
using core.atomic;
using core.target;
using std.memory;
using std.numeric;
using std.sync;
using internal std.memory;
using internal std.sync.spin_lock;
using internal bray.runtime.bootstrap;
using internal bray.runtime.bootstrap.heap;
using internal bray.runtime.bootstrap.host;
using internal bray.runtime.bootstrap.host.product;

@abi(c)
trusted internal func creation() -> u64
    requires(trusted bray.runtime.bootstrap.host.product.native_host())
{
    let lease = trusted bray.runtime.bootstrap.host.host_access();

    if !lease.active
    {
        return 0;
    }

    let mut anchor = trusted bray.runtime.bootstrap.host.host_anchor(&lease);
    let host = trusted bray.runtime.bootstrap.host.host_value(&lease, &mut anchor);

    if host.transitioning || host.next_identity == std.numeric.U64_MAX
    {
        return 0;
    }

    let identity = host.next_identity;

    host.next_identity += 1;
    return identity;
}

// Admission creates the source claim before an inactive frame transfers.
@abi(c)
trusted internal func admission(pos runtime: u64) -> u64
    requires(trusted bray.runtime.bootstrap.host.product.native_host())
{
    // Generic buffer cleanup can require report backing before its fallible
    // allocation is attempted. Keep that failure inside this native boundary;
    // the source start operation still owns and resolves its inactive frame.
    let admitted = catch trusted admit(runtime);

    return match consume admitted
    {
        case Ok(handle) { yield handle; }
        case Error(_) { yield 0; }
    };
}

trusted internal func admit(pos runtime: u64) -> u64
    requires(trusted bray.runtime.bootstrap.host.product.native_host())
{
    // This report allowance belongs to the task, independently of any frame's
    // body panic. Admission and recycling happen outside the host acquisition.
    let mut failure_records = trusted bray.runtime.bootstrap.report.chain.admit(1);

    if failure_records.status != 0
    {
        return 0;
    }

    let protocol = trusted lambda(pos owner: &bray.runtime.bootstrap.report.chain.Owner)
        requires(trusted bray.runtime.bootstrap.report.chain.owned(owner = owner))
        ensures(trusted bray.runtime.bootstrap.pool.protocol_access())
        executes(pure, total) {};

    trusted protocol(&failure_records);

    let mut prepared: Prepared =
    {
        slabs = none,
        slots = none
    };

    while true
    {
        let request =
        {
            let lease = trusted bray.runtime.bootstrap.host.host_access();

            if !lease.active
            {
                return 0;
            }

            let mut anchor = trusted bray.runtime.bootstrap.host.host_anchor(&lease);
            let host = trusted bray.runtime.bootstrap.host.host_value(&lease, &mut anchor);

            if host.transitioning
            {
                return 0;
            }

            yield match consume trusted admit_locked(&mut host.tasks, &mut prepared, failure_records.records, runtime)
            {
                case Ok(handle)
                {
                    // Commit the admitted allowance before releasing host access.
                    // Growth borrows no report owner and cannot consume its witness.
                    if handle != 0
                    {
                        _ = trusted bray.runtime.bootstrap.report.chain.take(&mut failure_records);
                    }

                    return handle;
                }
                case Error(request) { yield request; }
            };
        };

        if !trusted prepare_growth(&mut prepared, request)
        {
            return 0;
        }
    }
}

trusted internal func admit_locked(
    pos entries: &mut Entries,
    pos prepared: &mut Prepared,
    pos failure_records: bray.runtime.bootstrap.ReportRecords,
    pos runtime: u64
) -> Result<u64, Growth>
{
    while true
    {
        match consume trusted grow(entries, prepared)
        {
            case Ok(ready)
            {
                if !ready
                {
                    return Ok(0);
                }
            }
            case Error(request) { return Error(request); }
        }

        let index = entries.free;
        let slot = trusted slot_at(entries, index);

        if slot.generation == 0x7fffffff
        {
            // Exhausted cells are never reused, so an old handle cannot
            // become current after generation wraparound.
            entries.free = slot.next;

            continue;
        }

        slot.generation += 1;

        let generation = slot.generation;
        let next = slot.next;

        slot.next = 0;
        slot.runtime = runtime;
        core.atomic.store<usize, 4>(&slot.cancellation, 0);

        slot.control = core.memory.uninit_from<std.sync.SpinLock<Control>>(
            trusted std.sync.SpinLock<Control>(prepare(failure_records))
        );

        entries.free = next;
        entries.active += 1;

        return Ok((std.numeric.truncate_to<u64, u32>(generation) << 32) | std.numeric.truncate_to<u64, usize>(index));
    }
}
