@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.task;

using core.memory;
using internal bray.runtime.bootstrap.host;

trusted internal func wait_entry_access(
    pos child: &Reference,
    pos parent: &Reference
) -> bray.runtime.bootstrap.host.HostLease
    requires(trusted retained(owner = child), trusted retained(owner = parent))
    ensures(
        trusted retained(owner = child),
        trusted retained(owner = parent),
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &result.acquisition)
    )
{
    return trusted bray.runtime.bootstrap.host.host_access();
}

trusted internal func registration_access(pos parent: &Reference) -> bray.runtime.bootstrap.host.HostLease
    requires(trusted retained(owner = parent))
    ensures(
        trusted retained(owner = parent),
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &result.acquisition)
    )
{
    return trusted bray.runtime.bootstrap.host.host_access();
}

trusted internal func dispatch_wait_access(pos owner: &Dispatch) -> bray.runtime.bootstrap.host.HostLease
    requires(trusted dispatch_acquired(owner = &owner.acquisition))
    ensures(
        trusted dispatch_acquired(owner = &owner.acquisition),
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &result.acquisition)
    )
{
    return trusted bray.runtime.bootstrap.host.host_access();
}

// Reading native slots and checking task state cannot revoke the independently
// held resident acquisition. Only scalar coordinates leave the borrowed views.
trusted internal func wait_coordinates(
    pos child: &Reference,
    pos parent: &Reference,
    pos retirement: u8,
    pos lease: &bray.runtime.bootstrap.host.HostLease
) -> (u32, (u64, u64, u64)?)
    requires(
        trusted retained(owner = child),
        trusted retained(owner = parent),
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition)
    )
    ensures(
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition)
    )
{
    if retirement > 1 || child.runtime != parent.runtime || child.handle == parent.handle
    {
        return (3, none);
    }

    let coordinates: (u64, u64, u64)? = (child.runtime, child.handle, parent.handle);
    let (status, register) = trusted check_wait(child, retirement);

    if !register
    {
        return (status, none);
    }

    return (status, coordinates);
}

// Retaining a sibling cannot revoke the first independently retained cell.
trusted internal func retain_waiter(
    pos lease: &bray.runtime.bootstrap.host.HostLease,
    pos anchor: &mut bray.runtime.bootstrap.host.HostAnchor,
    pos runtime: u64,
    pos handle: u64,
    pos observed: &Reference
) -> (Reference?, u32)
    requires(
        lease.active,
        trusted retained(owner = observed),
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition),
        trusted bray.runtime.bootstrap.host.host_anchor_matches(anchor = &anchor.acquisition, lease = &lease.acquisition)
    )
    ensures(
        trusted retained_option(owner = &result.0),
        trusted retained(owner = observed),
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition),
        trusted bray.runtime.bootstrap.host.host_anchor_matches(anchor = &anchor.acquisition, lease = &lease.acquisition)
    )
{
    return trusted retain_locked(lease, anchor, runtime, handle);
}
