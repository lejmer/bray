@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.task;

using core.target;
using std.memory;
using std.sync;
using internal std.sync.spin_lock;
using internal bray.runtime.bootstrap.host;
using internal bray.runtime.bootstrap.event;
using internal bray.runtime.bootstrap.host.product;

trusted internal func take_registration(pos access: &mut LinkAccess) -> WaitRegistration?
    requires(trusted link_access(owner = &access))
    ensures(trusted optional_registration(owner = &result), trusted link_access(owner = &access))
{
    let slot = trusted link_slot(access);

    return trusted std.memory.replace_value<(WaitRegistration?)>(&mut slot.registration, none);
}

// Withdrawal uses the admitted previous/next links and never scans waiters.
// A terminal transition commits the still-linked owner to delivery. Resumption
// waits for its pop, which releases the link before waking the continuation.
trusted internal func withdraw_wait(pos parent: &Reference, pos preserve_unready_event: bool) -> bool
    requires(trusted retained(owner = parent), trusted bray.runtime.bootstrap.host.product.native_host())
    ensures(trusted retained(owner = parent))
    uses(intrinsic)
{
    let withdrawn =
    {
        let lease = trusted registration_access(parent);

        if !lease.active
        {
            trusted core.target.abort();
        }

        let mut access = trusted task_slot_access(parent, &lease);
        let taken = trusted take_registration(&mut access);

        if taken matches none
        {
            return true;
        }

        let registration = trusted take_optional_registration(taken);
        let committed = trusted wait_committed(&registration, &lease);

        // Recovery retains a shielded event wait until delivery. Neither an
        // unready link nor committed delivery admits another producer callback.
        if committed || (preserve_unready_event && registration.target matches WaitTarget.Event(_, _, _) |
            WaitTarget.ExecutionEvent(_, _))
        {
            trusted store_registration(registration, &lease);
            return false;
        }

        trusted unlink_registration(&registration, &lease);
        yield registration;
    };

    trusted release_wait(withdrawn);
    return true;
}

trusted internal func wait_committed(
    pos owner: &WaitRegistration,
    pos lease: &bray.runtime.bootstrap.host.HostLease
) -> bool
    requires(
        trusted registration_owned(owner = &owner),
        lease.active,
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition)
    )
    ensures(
        trusted registration_owned(owner = &owner),
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition)
    )
{
    if let WaitTarget.Event(_, observed, _) | WaitTarget.ExecutionEvent(_, observed) = owner.target
    {
        let retained_event = trusted event_reference(owner);
        let mut mutation = trusted bray.runtime.bootstrap.event.event_anchor(retained_event, lease);
        let event = trusted bray.runtime.bootstrap.event.event_state(lease, &mut mutation);

        return event.closed || event.generation != observed;
    }

    let observed = trusted registration_target(owner);
    let mut guard = trusted lock_cell(observed);
    let child = trusted guard.get();

    return if owner.retirement == 0
    {
        yield child.phase matches Phase.Terminal | Phase.Resolved;
    }
    else
    {
        yield child.retired;
    };
}

trusted internal func unlink_registration(
    pos owner: &WaitRegistration,
    pos lease: &bray.runtime.bootstrap.host.HostLease
)
    requires(
        trusted registration_owned(owner = &owner),
        lease.active,
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition)
    )
    ensures(
        trusted registration_owned(owner = &owner),
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition)
    )
    uses(intrinsic)
{
    match owner.target
    {
        case WaitTarget.Task(reference)
        {
            if owner.previous.empty()
            {
                let mut access = trusted task_slot_access(&reference, lease);
                let observed_slot = trusted link_slot(&mut access);

                if owner.retirement == 0
                {
                    observed_slot.terminal_waiters = owner.next;
                }
                else
                {
                    observed_slot.retirement_waiters = owner.next;
                }
            }
        }
        case WaitTarget.Event(_, _, _) | WaitTarget.ExecutionEvent(_, _)
        {
            let retained_event = trusted event_reference(owner);
            let mut mutation = trusted bray.runtime.bootstrap.event.event_anchor(retained_event, lease);
            let event = trusted bray.runtime.bootstrap.event.event_state(lease, &mut mutation);

            if owner.previous.empty()
            {
                event.head = owner.next;
            }

            if owner.next.empty()
            {
                event.tail = owner.previous;
            }
        }
    }

    if !owner.previous.empty()
    {
        let mut access = trusted previous_link_access(owner, lease);
        let previous = trusted link_slot(&mut access);

        if let ?registration = previous.registration
        {
            registration.next = owner.next;
        }
        else
        {
            trusted core.target.abort();
        }
    }

    if !owner.next.empty()
    {
        let mut access = trusted next_link_access(owner, lease);
        let next = trusted link_slot(&mut access);

        if let ?registration = next.registration
        {
            registration.previous = owner.previous;
        }
        else
        {
            trusted core.target.abort();
        }
    }
}
