@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.task;

using internal bray.runtime.bootstrap.scheduler;
using core.target;
using std.memory;
using internal bray.runtime.bootstrap.host;
using internal bray.runtime.bootstrap.event;
using internal bray.runtime.bootstrap.host.product;

// The detached chain owns the directory registrations until each is popped.
// A parent cannot withdraw or reuse a committed link before that pop.
internal struct Delivery
{
    next: u64;
}

trusted internal predicate delivery_owned(owner: &Delivery);

trusted internal func take_waiters(pos owner: &Dispatch, pos retirement: u8) -> Delivery
    requires(trusted dispatch_acquired(owner = &owner.acquisition))
    ensures(trusted delivery_owned(owner = &result), trusted dispatch_acquired(owner = &owner.acquisition))
    uses(intrinsic)
{
    let lease = trusted dispatch_wait_access(owner);

    if !lease.active
    {
        trusted core.target.abort();
    }

    let reference = trusted dispatch_reference(owner);
    let identity = reference.handle;
    let mut anchor = trusted bray.runtime.bootstrap.host.host_anchor(&lease);
    let host = trusted bray.runtime.bootstrap.host.host_value(&lease, &mut anchor);
    let slot = trusted wait_slot(&mut host.tasks, identity);

    let next = if retirement == 0
    {
        yield trusted std.memory.replace_value<u64>(&mut slot.terminal_waiters, 0);
    }
    else
    {
        yield trusted std.memory.replace_value<u64>(&mut slot.retirement_waiters, 0);
    };

    return
    {
        next = next
    };
}

trusted internal func delivery_access(pos owner: &Delivery) -> bray.runtime.bootstrap.host.HostLease
    requires(trusted delivery_owned(owner = owner))
    ensures(
        trusted delivery_owned(owner = owner),
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &result.acquisition)
    )
{
    return trusted bray.runtime.bootstrap.host.host_access();
}

trusted internal func pop_delivery(pos owner: Delivery) -> (WaitRegistration, Delivery)
    requires(owner.next != 0, trusted delivery_owned(owner = &owner))
    ensures(trusted registration_owned(owner = &result.0.marker), trusted delivery_owned(owner = &result.1))
    uses(intrinsic)
{
    let lease = trusted delivery_access(&owner);

    if !lease.active
    {
        trusted core.target.abort();
    }

    let identity = owner.next;
    let mut anchor = trusted bray.runtime.bootstrap.host.host_anchor(&lease);
    let host = trusted bray.runtime.bootstrap.host.host_value(&lease, &mut anchor);
    let taken = trusted take_registration(&mut host.tasks, identity);

    if !(taken matches ?_)
    {
        trusted core.target.abort();
    }

    let registration = trusted take_optional_registration(taken);

    let remaining: Delivery =
    {
        next = registration.next
    };

    return (registration, remaining);
}

trusted internal func notify_waiters(pos owner: &Dispatch, pos retirement: u8)
    requires(
        trusted dispatch_acquired(owner = &owner.acquisition),
        trusted bray.runtime.bootstrap.host.product.native_host()
    )
{
    let mut delivery = trusted take_waiters(owner, retirement);

    while delivery.next != 0
    {
        delivery = trusted deliver_waiter(owner, delivery);
    }
}

trusted internal func deliver_waiter(pos owner: &Dispatch, pos delivery: Delivery) -> Delivery
    requires(
        delivery.next != 0,
        trusted delivery_owned(owner = &delivery),
        trusted dispatch_acquired(owner = &owner.acquisition),
        trusted bray.runtime.bootstrap.host.product.native_host()
    )
    ensures(trusted delivery_owned(owner = &result), trusted dispatch_acquired(owner = &owner.acquisition))
{
    let (registration, remaining) = trusted pop_delivery(delivery);
    let next = trusted wake_waiter(owner, &registration, remaining);

    trusted release_wait(registration);
    return next;
}

// Callback reentrancy can register another wait in the now-vacant parent slot.
// This independent noncopy owner still retains the old target through return.
trusted internal func wake_waiter(
    pos owner: &Dispatch,
    pos registration: &WaitRegistration,
    pos remaining: Delivery
) -> Delivery
    requires(
        trusted registration_owned(owner = &registration.marker),
        trusted delivery_owned(owner = &remaining),
        trusted dispatch_acquired(owner = &owner.acquisition)
    )
    ensures(
        trusted registration_owned(owner = &registration.marker),
        trusted delivery_owned(owner = &result),
        trusted dispatch_acquired(owner = &owner.acquisition)
    )
{
    trusted wake_service(
        trusted dispatch_services(owner),
        &registration.waiter,
        bray.runtime.bootstrap.scheduler.WAKE_EXPLICIT
    );

    return remaining;
}

// Splitting this consumed registration transfers its independently retained
// components. Borrowed projections never create another component owner.
trusted internal func release_wait(pos owner: WaitRegistration)
    requires(
        trusted registration_owned(owner = &owner.marker),
        trusted bray.runtime.bootstrap.host.product.native_host()
    )
{
    let waiter = trusted release_wait_target(owner);

    _ = trusted dispose_reference(waiter);
}

// Retire the selected target and transfer the remaining independent task
// storage owner. Target release cannot consume that retained count.
trusted internal func release_wait_target(pos owner: WaitRegistration) -> Reference
    requires(
        trusted registration_owned(owner = &owner.marker),
        trusted bray.runtime.bootstrap.host.product.native_host()
    )
    ensures(trusted retained(owner = &result), trusted owned_reference(owner = &result))
    uses(intrinsic)
{
    return match owner.target
    {
        case WaitTarget.Task(_)
        {
            let take = trusted lambda(pos owner: WaitRegistration) -> (Reference, Reference)
                requires(trusted registration_owned(owner = &owner.marker), owner.target matches WaitTarget.Task(_))
                ensures(
                    trusted retained(owner = &result.0),
                    trusted owned_reference(owner = &result.0),
                    trusted retained(owner = &result.1),
                    trusted owned_reference(owner = &result.1)
                )
                uses(raw_memory, intrinsic)
            {
                return match owner.target
                {
                    case WaitTarget.Task(reference)
                    {
                        yield (
                            trusted std.memory.read<Reference>(std.memory.address_of<Reference>(&reference)),
                            trusted std.memory.read<Reference>(std.memory.address_of<Reference>(&owner.waiter))
                        );
                    }
                    case WaitTarget.Event(_, _, _) | WaitTarget.ExecutionEvent(_, _)
                    {
                        yield trusted core.target.abort();
                    }
                };
            };

            let (observed, waiter) = trusted take(owner);

            _ = trusted dispose_reference(observed);

            yield waiter;
        }
        case WaitTarget.Event(_, _, _)
        {
            let take = trusted lambda(pos owner: WaitRegistration) -> (
                bray.runtime.bootstrap.event.Reference,
                bray.runtime.bootstrap.event.Callback,
                Reference
            )
                requires(
                    trusted registration_owned(owner = &owner.marker),
                    owner.target matches WaitTarget.Event(_, _, _)
                )
                ensures(
                    trusted bray.runtime.bootstrap.event.retained(owner = &result.0),
                    trusted bray.runtime.bootstrap.event.owned_reference(owner = &result.0),
                    trusted bray.runtime.bootstrap.event.callback_owned(owner = &result.1),
                    trusted retained(owner = &result.2),
                    trusted owned_reference(owner = &result.2)
                )
                uses(raw_memory, intrinsic)
            {
                return match owner.target
                {
                    case WaitTarget.Event(reference, _, callback)
                    {
                        yield (
                            trusted std.memory.read<bray.runtime.bootstrap.event.Reference>(
                                std.memory.address_of<bray.runtime.bootstrap.event.Reference>(&reference)
                            ),
                            trusted std.memory.read<bray.runtime.bootstrap.event.Callback>(
                                std.memory.address_of<bray.runtime.bootstrap.event.Callback>(&callback)
                            ),
                            trusted std.memory.read<Reference>(std.memory.address_of<Reference>(&owner.waiter))
                        );
                    }
                    case WaitTarget.Task(_) | WaitTarget.ExecutionEvent(_, _) { yield trusted core.target.abort(); }
                };
            };

            let (event, callback, waiter) = trusted take(owner);

            trusted bray.runtime.bootstrap.event.release_callback(callback);
            trusted bray.runtime.bootstrap.event.release_event(event);
            yield waiter;
        }
        case WaitTarget.ExecutionEvent(_, _)
        {
            let take = trusted lambda(pos owner: WaitRegistration) -> (
                bray.runtime.bootstrap.event.Reference,
                Reference
            )
                requires(
                    trusted registration_owned(owner = &owner.marker),
                    owner.target matches WaitTarget.ExecutionEvent(_, _)
                )
                ensures(
                    trusted bray.runtime.bootstrap.event.retained(owner = &result.0),
                    trusted bray.runtime.bootstrap.event.owned_reference(owner = &result.0),
                    trusted retained(owner = &result.1),
                    trusted owned_reference(owner = &result.1)
                )
                uses(raw_memory, intrinsic)
            {
                return match owner.target
                {
                    case WaitTarget.ExecutionEvent(reference, _)
                    {
                        yield (
                            trusted std.memory.read<bray.runtime.bootstrap.event.Reference>(
                                std.memory.address_of<bray.runtime.bootstrap.event.Reference>(&reference)
                            ),
                            trusted std.memory.read<Reference>(std.memory.address_of<Reference>(&owner.waiter))
                        );
                    }
                    case WaitTarget.Task(_) | WaitTarget.Event(_, _, _) { yield trusted core.target.abort(); }
                };
            };

            let (event, waiter) = trusted take(owner);

            trusted bray.runtime.bootstrap.event.release_event(event);
            yield waiter;
        }
    };
}
