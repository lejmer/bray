@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.task;

using core.memory;
using core.target;
using std.memory;
using std.numeric;
using std.sync;
using internal std.sync.spin_lock;
using internal bray.runtime.bootstrap.host;
using internal bray.runtime.bootstrap.event;
using internal bray.runtime.bootstrap.host.product;

// One ordinary noncopy owner retains both the collection and callback target.
// Directory links are bookkeeping under the resident acquisition. They do not
// confer ownership or authorize source result observation.
internal struct WaitRegistration
{
    resources: WaitResources;
    retirement: u8;
    mut previous: WaitLink;
    mut next: WaitLink;
}

// Resource ownership remains stable while membership links change. This
// complete carrier owns both retained endpoints and the selected callback.
internal struct WaitResources
{
    target: WaitTarget;
    waiter: Reference;
}

internal union WaitTarget
{
    Task(pos reference: Reference);
    ExecutionEvent(pos reference: bray.runtime.bootstrap.event.Reference, pos observed: u64);
    Event(
        pos reference: bray.runtime.bootstrap.event.Reference,
        pos observed: u64,
        pos callback: bray.runtime.bootstrap.event.Callback
    );
}

trusted internal predicate registration_owned(owner: &WaitResources);

trusted internal predicate optional_registration(owner: &(WaitRegistration?));

trusted internal func registration_target(pos owner: &WaitRegistration) -> &Reference
    requires(trusted registration_owned(owner = &owner.resources))
    ensures(trusted retained(owner = result))
    uses(intrinsic)
{
    return match owner.resources.target
    {
        case WaitTarget.Task(reference) { yield &reference; }
        case WaitTarget.Event(_, _, _) | WaitTarget.ExecutionEvent(_, _) { yield trusted core.target.abort(); }
    };
}

// The resident acquisition excludes notification commitment. The borrowed
// native input keeps this observed cell live until checking returns.
trusted internal func check_wait(pos observed: &Reference, pos retirement: u8) -> (u32, bool)
    requires(trusted retained(owner = observed))
{
    let mut guard = trusted lock_cell(observed);
    let child = trusted guard.get();

    if !child.source_owner || child.phase matches Phase.Admitted
    {
        return (7, false);
    }

    if retirement == 0
    {
        return if child.phase matches Phase.Terminal(_) | Phase.Resolved
        {
            yield (0, false);
        }
        else
        {
            yield (6, true);
        };
    }

    if !(child.phase matches Phase.Resolved)
    {
        return (6, false);
    }

    if (child.retirement matches Retirement.Complete)
    {
        return (0, false);
    }

    child.retirement = Retirement.Requested;
    return (6, true);
}

// Both native inputs retain their actual cells through the resident lease.
// Admission duplicates those owners, without another directory lookup.
trusted internal func admit_wait(pos child: &Reference, pos parent: &Reference, pos retirement: u8) -> WaitRegistration
    requires(trusted retained(owner = child), trusted retained(owner = parent))
    ensures(trusted registration_owned(owner = &result.resources))
{
    let observed = trusted duplicate_reference(child);
    let waiter = trusted duplicate_reference(parent);

    return
    {
        resources =
        {
            target = WaitTarget.Task(observed),
            waiter = waiter
        },
        retirement = retirement,
        previous = no_wait_link(),
        next = no_wait_link()
    };
}

trusted internal func publish_wait(
    pos mut registration: WaitRegistration,
    pos lease: &bray.runtime.bootstrap.host.HostLease
) -> (u32, WaitRegistration?)
    requires(
        trusted registration_owned(owner = &registration.resources),
        lease.active,
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition)
    )
    ensures(
        trusted optional_registration(owner = &result.1),
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition)
    )
    uses(intrinsic)
{
    let waiter = trusted registration_waiter(&registration);
    let child = trusted registration_target(&registration);
    let parent = trusted wait_link(waiter);
    let retirement = registration.retirement;

    {
        let mut access = trusted task_slot_access(waiter, lease);
        let slot = trusted link_slot(&mut access);

        if let ?existing = slot.registration
        {
            let status: u32 = if trusted same_task_wait(
                &existing,
                child,
                retirement
            )
            {
                yield 6;
            }
            else
            {
                yield 3;
            };

            let rejected: WaitRegistration? = registration;

            return (status, rejected);
        }
    }

    let head =
    {
        let mut access = trusted task_slot_access(child, lease);
        let slot = trusted link_slot(&mut access);

        yield if retirement == 0
        {
            yield slot.terminal_waiters;
        }
        else
        {
            yield slot.retirement_waiters;
        };
    };

    if !head.empty()
    {
        let mut access = trusted task_head_access(child, lease, retirement);
        let slot = trusted link_slot(&mut access);

        if let ?prior = slot.registration
        {
            prior.previous = parent;
        }
        else
        {
            trusted core.target.abort();
        }
    }

    {
        let mut access = trusted task_slot_access(child, lease);
        let slot = trusted link_slot(&mut access);

        if retirement == 0
        {
            slot.terminal_waiters = parent;
        }
        else
        {
            slot.retirement_waiters = parent;
        }
    }

    registration.next = head;
    trusted store_registration(registration, lease);
    return (6, none);
}

trusted internal func same_task_wait(pos owner: &WaitRegistration, pos child: &Reference, pos retirement: u8) -> bool
{
    return match owner.resources.target
    {
        case WaitTarget.Task(reference)
        {
            yield reference.runtime == child.runtime && reference.handle == child.handle && owner.retirement ==
                retirement;
        }
        case WaitTarget.Event(_, _, _) | WaitTarget.ExecutionEvent(_, _) { yield false; }
    };
}

// The registration retains this event independently of its external name.
// A local carrier lends that storage under the resident acquisition.
trusted internal func event_reference(pos owner: &WaitRegistration) -> &bray.runtime.bootstrap.event.Reference
    requires(trusted registration_owned(owner = &owner.resources))
    ensures(
        trusted bray.runtime.bootstrap.event.retained(owner = result),
        trusted registration_owned(owner = &owner.resources)
    )
    uses(intrinsic)
{
    return match owner.resources.target
    {
        case WaitTarget.Event(reference, _, _) { yield &reference; }
        case WaitTarget.ExecutionEvent(reference, _) { yield &reference; }
        case WaitTarget.Task(_) { yield trusted core.target.abort(); }
    };
}

trusted internal func event_callback(pos owner: &WaitRegistration) -> &bray.runtime.bootstrap.event.Callback
    requires(trusted registration_owned(owner = &owner.resources))
    ensures(
        trusted bray.runtime.bootstrap.event.callback_owned(owner = result),
        trusted registration_owned(owner = &owner.resources)
    )
    uses(intrinsic)
{
    return match owner.resources.target
    {
        case WaitTarget.Event(_, _, callback) { yield &callback; }
        case WaitTarget.Task(_) | WaitTarget.ExecutionEvent(_, _) { yield trusted core.target.abort(); }
    };
}

trusted internal func registration_waiter(pos owner: &WaitRegistration) -> &Reference
    requires(trusted registration_owned(owner = &owner.resources))
    ensures(trusted retained(owner = result), trusted registration_owned(owner = &owner.resources))
    executes(pure, total)
{
    return &owner.resources.waiter;
}
