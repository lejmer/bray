@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.task;

using core.memory;
using core.target;
using internal bray.runtime.bootstrap.host;
using internal bray.runtime.bootstrap.host.product;

@abi(c)
trusted internal func wait(
    pos child: DataPointer<Reference>,
    pos parent: DataPointer<Reference>,
    pos retirement: u8
) -> u32
    requires(
        trusted reference_slot(owner = &child),
        trusted reference_slot(owner = &parent),
        trusted bray.runtime.bootstrap.host.product.native_host()
    )
{
    return trusted wait_references(trusted borrow_reference(&child), trusted borrow_reference(&parent), retirement);
}

trusted internal func wait_references(pos child: &Reference, pos parent: &Reference, pos retirement: u8) -> u32
    requires(
        trusted retained(owner = child),
        trusted retained(owner = parent),
        trusted bray.runtime.bootstrap.host.product.native_host()
    )
{
    let rejected =
    {
        let lease = trusted wait_entry_access(child, parent);

        if !lease.active
        {
            return 4;
        }

        if retirement > 1 || child.runtime != parent.runtime || child.handle == parent.handle
        {
            return 3;
        }

        let (status, register) = trusted check_wait(child, retirement);

        if !register
        {
            return status;
        }

        let registration = trusted admit_wait(child, parent, retirement);
        let (publication_status, spare) = trusted publish_wait(registration, &lease);

        if spare matches none
        {
            return publication_status;
        }

        yield (publication_status, trusted take_optional_registration(spare));
    };

    // Release the spare owner after the resident collection has unlocked.
    let (result_status, rejected_owner) = rejected;

    trusted release_wait(rejected_owner);
    return result_status;
}

trusted internal func take_optional_registration(pos owner: WaitRegistration?) -> WaitRegistration
    requires(owner matches ?_, trusted optional_registration(owner = &owner))
    ensures(trusted registration_owned(owner = &result.resources))
    uses(intrinsic)
{
    return match consume owner
    {
        case ?registration { yield registration; }
        case none { yield trusted core.target.abort(); }
    };
}
