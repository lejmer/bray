@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.task;

using core.memory;
using core.target;
using std.memory;
using internal bray.runtime.bootstrap;
using internal bray.runtime.bootstrap.activation.requirements;
using internal bray.runtime.bootstrap.host.product;

// The current native producer invocation retains its exact checked frame and
// disjoint metadata slot. This permission is independent of numeric frame IDs.
trusted internal predicate callback_invocation(
    reference: &DataPointer<Reference>,
    execution: DataPointer<bray.runtime.bootstrap.activation.requirements.Execution>
);

@abi(c)
trusted internal func callback_enter(
    pos pointer: DataPointer<Reference>,
    pos execution: DataPointer<bray.runtime.bootstrap.activation.requirements.Execution>,
    pos resumable: u8,
    pos previous_resumable: DataPointer<u8>
) -> usize
    requires(
        trusted reference_slot(owner = &pointer),
        trusted callback_invocation(reference = &pointer, execution = execution),
        trusted bray.runtime.bootstrap.host.product.native_host()
    )
    uses(raw_memory)
{
    let reference = trusted borrow_reference(&pointer);

    let permit = trusted lambda(
        pos pointer: &DataPointer<Reference>,
        pos execution: DataPointer<bray.runtime.bootstrap.activation.requirements.Execution>
    )
        requires(trusted callback_invocation(reference = pointer, execution = execution))
        ensures(
            trusted core.memory.valid_read<bray.runtime.bootstrap.activation.requirements.Execution>(
                pointer = execution,
                count = 1
            ),
            trusted core.memory.aligned_for<bray.runtime.bootstrap.activation.requirements.Execution>(
                pointer = execution
            ),
            trusted core.memory.initialized_as<bray.runtime.bootstrap.activation.requirements.Execution>(
                pointer = execution
            )
        )
        executes(pure, total) {};

    trusted permit(&pointer, execution);

    let value = trusted std.memory.read<bray.runtime.bootstrap.activation.requirements.Execution>(execution);

    let (previous, was_resumable) = trusted enter_callback(reference, &value, resumable != 0);

    trusted bray.runtime.bootstrap.host.product.publish_provider<u8>(previous_resumable, flag(was_resumable));
    return previous;
}

trusted internal func enter_callback(
    pos reference: &Reference,
    pos execution: &bray.runtime.bootstrap.activation.requirements.Execution,
    pos resumable: bool
) -> (usize, bool)
    requires(trusted retained(owner = reference))
    ensures(trusted retained(owner = reference))
    uses(intrinsic)
{
    return
    {
        let mut guard = trusted lock_cell(reference);
        let control = trusted guard.get();

        if execution.address == 0 || (resumable && (!control.dispatching || control.callback != 0))
        {
            trusted core.target.abort();
        }

        let previous = control.callback;
        let was_resumable = control.resumable;

        // Nested synchronous cleanup masks the outer callback's permission to
        // compose. Exit restores the exact previous callback, including zero.
        control.callback = execution.address;

        control.resumable = resumable;

        yield (previous, was_resumable);
    };
}

trusted internal predicate callback_restoration(reference: DataPointer<Reference>);

@abi(c)
trusted internal func callback_exit(pos pointer: DataPointer<Reference>, pos previous: usize, pos was_resumable: u8)
    requires(trusted reference_slot(owner = &pointer), trusted callback_restoration(reference = pointer))
{
    let reference = trusted borrow_reference(&pointer);

    trusted leave_callback(reference, previous, was_resumable != 0);
}

trusted internal func leave_callback(pos reference: &Reference, pos previous: usize, pos was_resumable: bool)
    requires(trusted retained(owner = reference))
    ensures(trusted retained(owner = reference))
    uses(intrinsic)
{
    let mut guard = trusted lock_cell(reference);
    let control = trusted guard.get();

    if control.callback == 0
    {
        trusted core.target.abort();
    }

    control.callback = previous;
    control.resumable = was_resumable;
}
