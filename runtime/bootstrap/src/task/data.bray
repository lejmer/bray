@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.task;

using core.memory;
using internal bray.runtime.bootstrap;
using internal bray.runtime.bootstrap.activation;

// Each noncopy owner carries its acquisition identity. Predicates distinguish
// storage retention, dispatch reservation and wait-registration ownership.
@layout(c)
internal struct Marker
{
}

// The cell owns publication, producer execution and terminal resolution. Queue
// readiness and execution slots belong exclusively to the scheduler. Executing
// covers only the protected producer interval inside an acquired dispatch.
internal union Phase
{
    Admitted;
    Active;
    Executing;
    Terminal(pos outcome: bray.runtime.bootstrap.ReportOutcome);
    Resolved;
}

internal union Retirement
{
    Live;
    Requested;
    Complete;
}

internal struct Control
{
    mut phase: Phase;
    mut references: usize;
    mut source_owner: bool;
    mut root: usize;
    mut registration: u64;
    mut native_context: usize;
    mut callback: usize;
    mut resumable: bool;
    mut execution: bray.runtime.bootstrap.activation.requirements.Execution;
    mut failure: bray.runtime.bootstrap.worker.Failure;
    mut failure_records: bray.runtime.bootstrap.ReportRecords;
    mut dispatching: bool;
    mut retirement: Retirement;
}

internal func empty_outcome() -> bray.runtime.bootstrap.ReportOutcome
{
    return
    {
        state = 4,
        payload = 0,
        report = bray.runtime.bootstrap.empty_panic_report()
    };
}

internal func prepare(pos records: bray.runtime.bootstrap.ReportRecords) -> Control
{
    return
    {
        phase = Phase.Admitted,
        references = 2,
        source_owner = true,
        root = 0,
        registration = 0,
        native_context = 0,
        callback = 0,
        resumable = false,
        execution =
        {
            address = 0,
            identity = [0; 32],
            state = 0,
            requirements =
            {
                affinity = 0,
                lanes = 0
            },
            origin = 0
        },
        failure = bray.runtime.bootstrap.worker.no_failure(),
        failure_records = records,
        dispatching = false,
        retirement = Retirement.Live
    };
}
