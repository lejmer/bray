@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.task.observer;

using internal bray.runtime.bootstrap;
using core.memory;

@link(name = "bray_runtime_host", kind = system)
@symbol(name = "bray_runtime_awaited_frame_composition")
@abi(c)
extern trusted internal func native_compose(
    pos token: bray.runtime.bootstrap.activation.Inactive,
    pos state: u32,
    pos destination: usize,
    pos disposition: u8
)
    requires(trusted bray.runtime.bootstrap.host.product.native_host())
    uses(foreign_call);
