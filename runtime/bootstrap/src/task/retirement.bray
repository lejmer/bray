@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.task;

using core.memory;
using core.atomic;
using core.target;
using std.memory;
using std.numeric;
using std.sync;
using internal std.sync.spin_lock;
using internal bray.runtime.bootstrap;
using internal bray.runtime.bootstrap.host;
using internal bray.runtime.bootstrap.execution;
using internal bray.runtime.bootstrap.host.product;

// The native owner transfers exactly one internal storage reference. A borrowed
// view or a source Task identity cannot satisfy this consumption contract.
trusted internal predicate reference_disposal(owner: &DataPointer<Reference>);

trusted internal predicate released(owner: &Reference);

trusted internal func recycling_access(pos owner: &Reference) -> bray.runtime.bootstrap.host.HostLease
    requires(trusted released(owner = owner))
    ensures(
        trusted released(owner = owner),
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &result.acquisition)
    )
{
    return trusted bray.runtime.bootstrap.host.host_access();
}

trusted internal func last_reference(pos owner: &Reference) -> bool
    requires(trusted retained(owner = owner))
    ensures(!result || trusted released(owner = owner))
{
    let mut guard = trusted lock_cell(owner);

    return trusted release(trusted guard.get());
}

@abi(c)
trusted internal func reference_release(pos pointer: DataPointer<Reference>) -> u32
    requires(
        trusted reference_slot(owner = &pointer),
        trusted reference_disposal(owner = &pointer),
        trusted bray.runtime.bootstrap.host.product.native_host()
    )
{
    let reference = trusted read_disposing_reference(&pointer);

    return trusted dispose_reference(reference);
}

trusted internal predicate storage_owned(owner: &Marker);

internal predicate owned_reference(owner: &Reference) = storage_owned(owner = &owner.acquisition);

trusted internal func read_disposing_reference(pos owner: &DataPointer<Reference>) -> Reference
    requires(trusted reference_slot(owner = owner), trusted reference_disposal(owner = owner))
    ensures(trusted retained(owner = &result), trusted owned_reference(owner = &result))
    uses(raw_memory)
{
    let pointer = trusted std.memory.read<DataPointer<Reference>>(std.memory.address_of<DataPointer<Reference>>(owner));

    let permit = trusted lambda(pos owner: &DataPointer<Reference>, pos pointer: DataPointer<Reference>)
        requires(trusted reference_slot(owner = owner), trusted reference_disposal(owner = owner))
        ensures(
            trusted core.memory.valid_read<Reference>(pointer = pointer, count = 1),
            trusted core.memory.aligned_for<Reference>(pointer = pointer),
            trusted core.memory.initialized_as<Reference>(pointer = pointer)
        )
        executes(pure, total) {};

    trusted permit(owner, pointer);
    return trusted std.memory.read<Reference>(pointer);
}

@abi(c)
trusted internal func dispose_reference(pos reference: Reference) -> u32
    requires(
        trusted retained(owner = &reference),
        trusted owned_reference(owner = &reference),
        trusted bray.runtime.bootstrap.host.product.native_host()
    )
    uses(intrinsic)
{
    if !trusted last_reference(&reference)
    {
        return 0;
    }

    // Move the initialized lock out before publishing this slot for reuse.
    // Its ordinary destruction happens after the resident acquisition retires.
    let retired =
    {
        let lease = trusted recycling_access(&reference);

        if !lease.active
        {
            trusted core.target.abort();
        }

        yield trusted take_released(&lease, &reference);
    };

    return trusted dispose_retired_cell(retired);
}

// Extraction owns every resource needed to finish retirement after unlocking.
internal struct RetiredCell
{
    control: std.sync.SpinLock<Control>;
    execution: bray.runtime.bootstrap.execution.Reference?;
    arena: ArenaReference;
}

internal predicate retired_cell(owner: &RetiredCell) = std.sync.spin_lock.valid(&owner.control.prepared.instance) &&
    bray.runtime.bootstrap.execution.optional_pin(owner = &owner.execution) && arena_retained(owner = &owner.arena);

internal predicate optional_retired_cell(owner: &(RetiredCell?)) = owner matches none ||
    retired_cell(owner = present_retired_cell(owner));

internal const func present_retired_cell(pos owner: &(RetiredCell?)) -> &RetiredCell
    requires(owner matches ?_)
    executes(pure, total)
{
    return match owner
    {
        case ?value { yield &value; }
        case none { panic("missing retired task cell"); }
    };
}

trusted internal func dispose_retired_cell(pos owner: RetiredCell) -> u32
    requires(trusted retired_cell(owner = &owner))
{
    _ = owner.control;
    let status = trusted bray.runtime.bootstrap.execution.release_task_pin(owner.execution);

    trusted release_arena(owner.arena);
    return status;
}

trusted internal func dispose_optional_retired_cell(pos owner: RetiredCell?) -> u32
    requires(trusted optional_retired_cell(owner = &owner))
{
    return match consume owner
    {
        case ?retired { yield trusted dispose_retired_cell(retired); }
        case none { yield 0; }
    };
}

// One move extracts the complete final cell. The resident lease excludes every
// directory lookup and intrusive access until the empty row is recycled.
trusted internal predicate retired_slot(owner: &Slot);

trusted internal func take_retired_slot(
    pos reference: &Reference,
    pos lease: &bray.runtime.bootstrap.host.HostLease
) -> Slot
    requires(
        trusted released(owner = reference),
        lease.active,
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition)
    )
    ensures(trusted retired_slot(owner = &result))
    uses(raw_memory, intrinsic)
{
    let permit = trusted lambda(pos reference: &Reference, pos lease: &bray.runtime.bootstrap.host.HostLease)
        requires(
            trusted released(owner = reference),
            lease.active,
            trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition)
        )
        ensures(
            trusted core.memory.valid_read<Slot>(pointer = reference.pointer, count = 1),
            trusted core.memory.valid_write<Slot>(pointer = reference.pointer, count = 1),
            trusted core.memory.initialized_as<Slot>(pointer = reference.pointer),
            trusted core.memory.aligned_for<Slot>(pointer = reference.pointer)
        )
        executes(pure, total) {};

    trusted permit(reference, lease);
    let slot = trusted std.memory.read<Slot>(reference.pointer);

    if slot.control matches none || slot.registration matches ?_ || !slot.terminal_waiters.empty() ||
        !slot.retirement_waiters.empty()
    {
        trusted core.target.abort();
    }

    trusted std.memory.write<Slot>(reference.pointer, empty_slot(slot.index, slot.generation, 0));
    return slot;
}

internal const func retired_control_storage(pos owner: &Slot) -> &Uninit<std.sync.SpinLock<Control>>
    requires(owner.control matches ?_)
    executes(pure, total)
{
    return match owner.control
    {
        case ?value { yield &value; }
        case none { panic("missing retired task control"); }
    };
}

trusted internal func materialize_retired_slot(pos owner: Slot) -> RetiredCell
    requires(trusted retired_slot(owner = &owner))
    ensures(trusted retired_cell(owner = &result))
    uses(unchecked_init, intrinsic)
{
    let initialized = trusted lambda(pos owner: &Slot)
        requires(trusted retired_slot(owner = owner))
        ensures(
            trusted core.memory.uninit_initialized<(ArenaReference?)>(storage = &owner.arena_owner),
            trusted core.memory.uninit_initialized<(bray.runtime.bootstrap.execution.Reference?)>(storage = &owner.execution_owner),
            owner.control matches none || trusted core.memory.uninit_initialized<std.sync.SpinLock<Control>>(
                storage = retired_control_storage(owner)
            )
        )
        executes(pure, total) {};

    trusted initialized(&owner);

    let arena_owner = trusted std.memory.assume_initialized<(ArenaReference?)>(owner.arena_owner);
    let execution = trusted std.memory.assume_initialized<(bray.runtime.bootstrap.execution.Reference?)>(owner.execution_owner);
    let arena = match consume arena_owner
    {
        case ?value { yield value; }
        case none { yield trusted core.target.abort(); }
    };

    let storage = match consume owner.control
    {
        case ?value { yield value; }
        case none { yield trusted core.target.abort(); }
    };

    let control = trusted std.memory.assume_initialized<std.sync.SpinLock<Control>>(storage);

    return { control = control, execution = execution, arena = arena };
}

trusted internal func take_released(
    pos lease: &bray.runtime.bootstrap.host.HostLease,
    pos reference: &Reference
) -> RetiredCell
    requires(
        lease.active,
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition),
        trusted released(owner = reference)
    )
    ensures(
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition),
        trusted retired_cell(owner = &result)
    )
    uses(intrinsic)
{
    let removed = trusted take_retired_slot(reference, lease);
    let index = removed.index;
    let retired = trusted materialize_retired_slot(removed);

    {
        let mut anchor = trusted arena_anchor(&retired.arena, lease);
        let entries = trusted arena_entries(&mut anchor);

        if index == 0 || index > entries.total || entries.active == 0 { trusted core.target.abort(); }

        let next = entries.free;
        let slot = trusted slot_at(entries, index);

        slot.next = next;
        entries.free = index;
        entries.active -= 1;
    }

    return retired;
}
