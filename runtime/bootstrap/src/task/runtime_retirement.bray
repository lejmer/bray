@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.task;

using core.target;
using core.memory;
using std.memory;
using std.numeric;
using internal bray.runtime.bootstrap;
using internal bray.runtime.bootstrap.host;
using internal bray.runtime.bootstrap.host.product;
using internal bray.runtime.bootstrap.execution;
using internal bray.runtime.bootstrap.scheduler;

trusted internal func retire_execution(pos owner: &bray.runtime.bootstrap.execution.Reference)
    requires(
        trusted bray.runtime.bootstrap.execution.retained(owner = owner),
        trusted bray.runtime.bootstrap.execution.services_retiring(owner = &owner.acquisition),
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted bray.runtime.bootstrap.host.product.native_host(),
        trusted bray.runtime.bootstrap.pool.protocol_access()
    )
    ensures(
        trusted bray.runtime.bootstrap.execution.retained(owner = owner),
        trusted bray.runtime.bootstrap.execution.services_retiring(owner = &owner.acquisition)
    )
    uses(intrinsic)
{
    let limit: usize =
    {
        let lease = trusted bray.runtime.bootstrap.host.host_access();

        if !lease.active
        {
            trusted core.target.abort();
        }

        let mut anchor = trusted bray.runtime.bootstrap.host.host_anchor(&lease);
        let host = trusted bray.runtime.bootstrap.host.host_value(&lease, &mut anchor);

        yield host.tasks.total;
    };

    let mut index: usize = 1;

    while index <= limit
    {
        trusted retire_runtime_slot(owner, index);

        index += 1;
    }
}

trusted internal func retire_runtime_slot(
    pos owner: &bray.runtime.bootstrap.execution.Reference,
    pos index: usize
)
    requires(
        trusted bray.runtime.bootstrap.execution.retained(owner = owner),
        trusted bray.runtime.bootstrap.execution.services_retiring(owner = &owner.acquisition),
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted bray.runtime.bootstrap.host.product.native_host(),
        trusted bray.runtime.bootstrap.pool.protocol_access()
    )
    ensures(
        trusted bray.runtime.bootstrap.execution.retained(owner = owner),
        trusted bray.runtime.bootstrap.execution.services_retiring(owner = &owner.acquisition)
    )
    uses(intrinsic)
{
    let (unused, metadata, execution) = trusted detach_runtime_slot(owner, index);

    // Detachment retires the resident acquisition before invoking callbacks.
    // Keep the task's actual pin through metadata and report disposal.
    trusted bray.runtime.bootstrap.execution.release_context(owner, metadata);

    _ = trusted bray.runtime.bootstrap.consume_record_values(unused, 0);
    _ = trusted bray.runtime.bootstrap.execution.release_task_pin(execution);
}

trusted internal func detach_runtime_slot(
    pos owner: &bray.runtime.bootstrap.execution.Reference,
    pos index: usize
) -> (bray.runtime.bootstrap.ReportRecords, usize, bray.runtime.bootstrap.execution.Reference?)
    requires(
        trusted bray.runtime.bootstrap.execution.retained(owner = owner),
        trusted bray.runtime.bootstrap.execution.services_retiring(owner = &owner.acquisition),
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted bray.runtime.bootstrap.host.product.native_host(),
        trusted bray.runtime.bootstrap.pool.protocol_access()
    )
    ensures(
        trusted bray.runtime.bootstrap.execution.retained(owner = owner),
        trusted bray.runtime.bootstrap.execution.services_retiring(owner = &owner.acquisition),
        trusted bray.runtime.bootstrap.execution.optional_pin(owner = &result.2)
    )
    uses(intrinsic)
{
    let lease = trusted bray.runtime.bootstrap.host.host_access();

    if !lease.active
    {
        trusted core.target.abort();
    }

    let mut anchor = trusted bray.runtime.bootstrap.host.host_anchor(&lease);
    let host = trusted bray.runtime.bootstrap.host.host_value(&lease, &mut anchor);
    let slot = trusted slot_at(&mut host.tasks, index);

    if slot.runtime != (trusted bray.runtime.bootstrap.execution.domain(owner)).identity || slot.control matches none
    {
        return (bray.runtime.bootstrap.empty_records(), 0, none);
    }

    // This view stays inside the actual resident acquisition. It borrows the
    // pinned slot and owns no additional counted reference or source claim.
    let issue_reference = trusted lambda(
        pos lease: &bray.runtime.bootstrap.host.HostLease,
        pos slot: &Slot,
        pos index: usize
    ) -> Reference
        requires(lease.active, trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition))
        ensures(
            trusted retained(owner = &result),
            trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition)
        )
    {
        return
        {
            acquisition = bray.runtime.bootstrap.task.Marker
            {
            },
            pointer = std.memory.address_of<Slot>(slot),
            runtime = slot.runtime,
            handle = (std.numeric.truncate_to<u64, u32>(slot.generation) << 32) | std.numeric.truncate_to<u64, usize>(
                index
            )
        };
    };

    let reference = trusted issue_reference(&lease, &slot, index);
    let (last, unused, metadata) = trusted close_runtime_admission(&lease, &reference, owner);

    let execution = if last
    {
        // The closed cell owns no frame or result. Destroying
        // its initialized lock cannot invoke a producer under this acquisition.
        let mut recycling_anchor = trusted bray.runtime.bootstrap.host.host_anchor(&lease);

        let (retired, execution) = trusted take_released(&lease, &mut recycling_anchor, &reference);

        yield execution;
    }
    else
    {
        yield none;
    };

    return (unused, metadata, execution);
}

trusted internal func close_runtime_admission(
    pos lease: &bray.runtime.bootstrap.host.HostLease,
    pos reference: &Reference,
    pos owner: &bray.runtime.bootstrap.execution.Reference
) -> (bool, bray.runtime.bootstrap.ReportRecords, usize)
    requires(
        trusted bray.runtime.bootstrap.execution.retained(owner = owner),
        trusted retained(owner = reference),
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition)
    )
    ensures(
        !result.0 || trusted released(owner = reference),
        trusted bray.runtime.bootstrap.execution.retained(owner = owner),
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition)
    )
    uses(intrinsic)
{
    let mut guard = trusted lock_cell(reference);
    let control = trusted guard.get();

    if reference.runtime != (trusted bray.runtime.bootstrap.execution.domain(owner)).identity || !control.source_owner
    {
        return (false, bray.runtime.bootstrap.empty_records(), 0);
    }

    if !(control.phase matches Phase.Admitted)
    {
        trusted core.target.abort();
    }

    let metadata = control.native_context;

    control.native_context = 0;
    control.source_owner = false;
    control.phase = Phase.Resolved;
    control.retired = true;

    let unused = std.memory.replace_value<bray.runtime.bootstrap.ReportRecords>(
        &mut control.failure_records,
        bray.runtime.bootstrap.empty_records()
    );

    return (trusted release(control), unused, metadata);
}
