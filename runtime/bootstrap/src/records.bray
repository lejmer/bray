@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap;

using std.memory;

@layout(c)
internal struct ReportPrimary
{
    mut source_present: u32;
    mut source_identity: u32;
    mut source_start: u32;
    mut source_end: u32;
    mut source_version: u64;
    mut source_namespace_word_0: u64;
    mut source_namespace_word_1: u64;
    mut source_namespace_word_2: u64;
    mut source_namespace_word_3: u64;
    mut cause: u32;
    mut message: usize;
    mut message_length: usize;
    mut copy_message: RawPointer<u8>;
    mut release_message: RawPointer<u8>;
}

@copy
@layout(c)
internal struct ReportRecords
{
    mut head: usize;
    mut tail: usize;
    mut count: usize;
}

@copy
@layout(c)
internal struct ReportSegment
{
    mut ordinal: u64;
    mut task: u64;
    mut frame: bytes<32>;
    mut state: u32;
}

@layout(c)
internal struct ReportRecord
{
    mut primary: ReportPrimary;
    mut message: std.memory.RawBuffer<u8>?;
    mut next: usize;
    mut segment: ReportSegment;
    mut segment_tail: usize;
    mut segment_count: usize;
}

trusted internal func empty_primary() -> ReportPrimary
    ensures(trusted native_primary_callbacks(primary = &result))
    executes(pure, total)
{
    return report_primary_value(empty_panic_report());
}

internal func empty_records() -> ReportRecords
    executes(pure, total)
{
    return
    {
        head = 0,
        tail = 0,
        count = 0
    };
}

// C headers contain addresses, not borrows of the pool's guarded metadata. Copy
// their wire bits while retaining callable validation at the native report boundary.
trusted internal func serialized_primary(pos primary: &ReportPrimary) -> ReportPrimary
    uses(intrinsic)
{
    return
    {
        source_present = primary.source_present,
        source_identity = primary.source_identity,
        source_start = primary.source_start,
        source_end = primary.source_end,
        source_version = primary.source_version,
        source_namespace_word_0 = primary.source_namespace_word_0,
        source_namespace_word_1 = primary.source_namespace_word_1,
        source_namespace_word_2 = primary.source_namespace_word_2,
        source_namespace_word_3 = primary.source_namespace_word_3,
        cause = primary.cause,
        message = primary.message,
        message_length = primary.message_length,
        copy_message = trusted core.target.from_exposed_address<u8>(
            address = trusted core.target.expose_address<u8>(primary.copy_message),
        ),
        release_message = trusted core.target.from_exposed_address<u8>(
            address = trusted core.target.expose_address<u8>(primary.release_message),
        ),
    };
}

trusted internal func append_record(pos pool: &mut ReportPool, pos chain: &mut ReportRecords, pos handle: usize)
{
    if chain.count == 0
    {
        chain.head = handle;
    }
    else
    {
        let last: &mut ReportRecord = trusted record(pool, chain.tail);

        last.next = handle;
    }

    chain.tail = handle;
    chain.count += 1;
}

trusted internal func detach_record(pos pool: &mut ReportPool, pos chain: &mut ReportRecords) -> usize
    uses(intrinsic)
{
    if chain.count == 0
    {
        trusted core.target.abort();
    }

    let mut handle: usize = chain.head;
    let first: &mut ReportRecord = trusted record(pool, handle);

    chain.head = first.next;
    first.next = 0;
    chain.count -= 1;

    if chain.count == 0
    {
        chain.tail = 0;
    }

    return handle;
}

@abi(c)
trusted internal func report_records_take(
    pos source: RawPointer<ReportRecords>,
    pos count: usize,
    pos destination: RawPointer<ReportRecords>,
)
    requires(trusted core.memory.valid_write<ReportRecords>(pointer = source, count = 1),
        trusted core.memory.aligned_for<ReportRecords>(pointer = source),
        trusted core.memory.valid_read<ReportRecords>(pointer = source, count = 1),
        trusted core.memory.initialized_as<ReportRecords>(pointer = source), trusted core.memory.valid_write<ReportRecords>(pointer = destination, count = 1),
        trusted core.memory.aligned_for<ReportRecords>(pointer = destination),
        trusted core.memory.valid_read<ReportRecords>(pointer = destination, count = 1),
        trusted core.memory.initialized_as<ReportRecords>(pointer = destination))
    uses(raw_memory, unchecked_init)
{
    let input: ReportRecords = trusted std.memory.read<ReportRecords>(source);
    let output: ReportRecords = trusted std.memory.read<ReportRecords>(destination);
    let (updated_input, updated_output) = trusted take_record_values(input, output, count, source, destination);

    trusted std.memory.write<ReportRecords>(source, updated_input);
    trusted std.memory.write<ReportRecords>(destination, updated_output);
}

trusted internal func take_record_values(pos mut input: ReportRecords, pos mut output: ReportRecords, pos count: usize, pos source: RawPointer<ReportRecords>, pos destination: RawPointer<ReportRecords>) -> (ReportRecords, ReportRecords)
    requires(
        trusted core.memory.valid_write<ReportRecords>(pointer = source, count = 1),
        trusted core.memory.aligned_for<ReportRecords>(pointer = source),
        trusted core.memory.valid_write<ReportRecords>(pointer = destination, count = 1),
        trusted core.memory.aligned_for<ReportRecords>(pointer = destination),
    )
    ensures(
        trusted core.memory.valid_write<ReportRecords>(pointer = source, count = 1),
        trusted core.memory.aligned_for<ReportRecords>(pointer = source),
        trusted core.memory.valid_write<ReportRecords>(pointer = destination, count = 1),
        trusted core.memory.aligned_for<ReportRecords>(pointer = destination),
    )
{
    let mut guard = RECORD_POOL.lock();
    let pool: &mut ReportPool = guard.get();
    let mut remaining: usize = count;

    while remaining != 0
    {
        let handle: usize = trusted detach_record(pool, &mut input);

        trusted append_record(pool, &mut output, handle);
        remaining -= 1;
    }

    return (input, output);
}

@abi(c)
trusted internal func report_records_append(pos destination: RawPointer<ReportRecords>, pos source: RawPointer<ReportRecords>)
    requires(trusted core.memory.valid_write<ReportRecords>(pointer = source, count = 1),
        trusted core.memory.aligned_for<ReportRecords>(pointer = source),
        trusted core.memory.valid_read<ReportRecords>(pointer = source, count = 1),
        trusted core.memory.initialized_as<ReportRecords>(pointer = source), trusted core.memory.valid_write<ReportRecords>(pointer = destination, count = 1),
        trusted core.memory.aligned_for<ReportRecords>(pointer = destination),
        trusted core.memory.valid_read<ReportRecords>(pointer = destination, count = 1),
        trusted core.memory.initialized_as<ReportRecords>(pointer = destination))
    uses(raw_memory, unchecked_init)
{
    let left: ReportRecords = trusted std.memory.read<ReportRecords>(destination);
    let right: ReportRecords = trusted std.memory.read<ReportRecords>(source);
    let (updated_left, updated_right) = trusted append_record_values(left, right, destination, source);

    trusted std.memory.write<ReportRecords>(destination, updated_left);
    trusted std.memory.write<ReportRecords>(source, updated_right);
}

trusted internal func append_record_values(pos mut left: ReportRecords, pos right: ReportRecords, pos destination: RawPointer<ReportRecords>, pos source: RawPointer<ReportRecords>) -> (ReportRecords, ReportRecords)
    requires(
        trusted core.memory.valid_write<ReportRecords>(pointer = destination, count = 1),
        trusted core.memory.aligned_for<ReportRecords>(pointer = destination),
        trusted core.memory.valid_write<ReportRecords>(pointer = source, count = 1),
        trusted core.memory.aligned_for<ReportRecords>(pointer = source),
    )
    ensures(
        trusted core.memory.valid_write<ReportRecords>(pointer = destination, count = 1),
        trusted core.memory.aligned_for<ReportRecords>(pointer = destination),
        trusted core.memory.valid_write<ReportRecords>(pointer = source, count = 1),
        trusted core.memory.aligned_for<ReportRecords>(pointer = source),
    )
{
    if right.count == 0
    {
        return (left, right);
    }

    let mut guard = RECORD_POOL.lock();
    let pool: &mut ReportPool = guard.get();

    if left.count == 0
    {
        left.head = right.head;
    }
    else
    {
        let last: &mut ReportRecord = trusted record(pool, left.tail);

        last.next = right.head;
    }

    left.tail = right.tail;
    left.count += right.count;
    return (left, empty_records());
}

trusted internal func exchange_primary(pos handle: usize, pos value: ReportPrimary) -> ReportPrimary
    requires(trusted native_primary_callbacks(primary = &value))
    ensures(trusted native_primary_callbacks(primary = &result))
{
    let mut guard = RECORD_POOL.lock();
    let entry: &mut ReportRecord = trusted record(guard.get(), handle);
    let old: ReportPrimary = trusted serialized_primary(&entry.primary);

    entry.primary = value;
    return old;
}

@abi(c)
trusted internal func report_record_exchange(pos handle: usize, pos primary: RawPointer<ReportPrimary>)
    requires(trusted native_primary_slot_callbacks(pointer = primary), trusted core.memory.valid_write<ReportPrimary>(pointer = primary, count = 1),
        trusted core.memory.aligned_for<ReportPrimary>(pointer = primary),
        trusted core.memory.valid_read<ReportPrimary>(pointer = primary, count = 1),
        trusted core.memory.initialized_as<ReportPrimary>(pointer = primary))
    ensures(trusted native_primary_slot_callbacks(pointer = primary))
    uses(raw_memory, unchecked_init)
{
    let value: ReportPrimary = trusted read_primary(primary);
    let old: ReportPrimary = trusted exchange_record_value(handle, value, primary);

    trusted std.memory.write<ReportPrimary>(primary, old);
}

trusted internal func exchange_record_value(pos handle: usize, pos value: ReportPrimary, pos primary: RawPointer<ReportPrimary>) -> ReportPrimary
    requires(
        trusted native_primary_callbacks(primary = &value),
        trusted core.memory.valid_write<ReportPrimary>(pointer = primary, count = 1),
        trusted core.memory.aligned_for<ReportPrimary>(pointer = primary),
    )
    ensures(
        trusted core.memory.valid_write<ReportPrimary>(pointer = primary, count = 1),
        trusted core.memory.aligned_for<ReportPrimary>(pointer = primary),
    )
{
    return trusted exchange_primary(handle, value);
}

@abi(c)
trusted internal func report_segment_mark(pos chain: RawPointer<ReportRecords>, pos metadata: RawPointer<ReportSegment>)
    requires(trusted core.memory.valid_write<ReportRecords>(pointer = chain, count = 1),
        trusted core.memory.aligned_for<ReportRecords>(pointer = chain),
        trusted core.memory.valid_read<ReportRecords>(pointer = chain, count = 1),
        trusted core.memory.initialized_as<ReportRecords>(pointer = chain), trusted core.memory.valid_write<ReportSegment>(pointer = metadata, count = 1),
        trusted core.memory.aligned_for<ReportSegment>(pointer = metadata),
        trusted core.memory.valid_read<ReportSegment>(pointer = metadata, count = 1),
        trusted core.memory.initialized_as<ReportSegment>(pointer = metadata))
    uses(raw_memory)
{
    let value: ReportRecords = trusted std.memory.read<ReportRecords>(chain);
    let segment: ReportSegment = trusted std.memory.read<ReportSegment>(metadata);
    let mut guard = RECORD_POOL.lock();
    let pool: &mut ReportPool = guard.get();
    let first: &mut ReportRecord = trusted record(pool, value.head);

    first.segment = segment;
    first.segment_tail = value.tail;
    first.segment_count = value.count;
}

@abi(c)
trusted internal func report_segment_take(
    pos chain: RawPointer<ReportRecords>,
    pos metadata: RawPointer<ReportSegment>,
    pos destination: RawPointer<ReportRecords>,
)
    requires(
        trusted core.memory.valid_write<ReportRecords>(pointer = chain, count = 1),
        trusted core.memory.aligned_for<ReportRecords>(pointer = chain),
        trusted core.memory.valid_read<ReportRecords>(pointer = chain, count = 1),
        trusted core.memory.initialized_as<ReportRecords>(pointer = chain),
        trusted core.memory.valid_write<ReportSegment>(pointer = metadata, count = 1),
        trusted core.memory.aligned_for<ReportSegment>(pointer = metadata),
        trusted core.memory.valid_write<ReportRecords>(pointer = destination, count = 1),
        trusted core.memory.aligned_for<ReportRecords>(pointer = destination),
    )
    uses(raw_memory, unchecked_init)
{
    let source: ReportRecords = trusted std.memory.read<ReportRecords>(chain);
    let (updated_source, segment, output) = trusted take_segment_values(source, chain, metadata, destination);

    trusted std.memory.write<ReportSegment>(metadata, segment);
    trusted std.memory.write<ReportRecords>(chain, updated_source);
    trusted std.memory.write<ReportRecords>(destination, output);
}

trusted internal func take_segment_values(pos mut source: ReportRecords, pos chain: RawPointer<ReportRecords>, pos metadata: RawPointer<ReportSegment>, pos destination: RawPointer<ReportRecords>) -> (ReportRecords, ReportSegment, ReportRecords)
    requires(
        trusted core.memory.valid_write<ReportRecords>(pointer = chain, count = 1),
        trusted core.memory.aligned_for<ReportRecords>(pointer = chain),
        trusted core.memory.valid_write<ReportSegment>(pointer = metadata, count = 1),
        trusted core.memory.aligned_for<ReportSegment>(pointer = metadata),
        trusted core.memory.valid_write<ReportRecords>(pointer = destination, count = 1),
        trusted core.memory.aligned_for<ReportRecords>(pointer = destination),
    )
    ensures(
        trusted core.memory.valid_write<ReportRecords>(pointer = chain, count = 1),
        trusted core.memory.aligned_for<ReportRecords>(pointer = chain),
        trusted core.memory.valid_write<ReportSegment>(pointer = metadata, count = 1),
        trusted core.memory.aligned_for<ReportSegment>(pointer = metadata),
        trusted core.memory.valid_write<ReportRecords>(pointer = destination, count = 1),
        trusted core.memory.aligned_for<ReportRecords>(pointer = destination),
    )
{
    let mut guard = RECORD_POOL.lock();
    let pool: &mut ReportPool = guard.get();
    let (segment, output) = trusted record_segment_value(pool, source.head);

    let last: &mut ReportRecord = trusted record(pool, output.tail);

    source.head = last.next;
    source.count -= output.count;
    last.next = 0;

    if source.count == 0
    {
        source.tail = 0;
    }

    return (source, segment, output);
}

trusted internal func record_segment_value(pos pool: &mut ReportPool, pos handle: usize) -> (ReportSegment, ReportRecords)
{
    let first: &mut ReportRecord = trusted record(pool, handle);
    let segment: ReportSegment =
    {
        ordinal = first.segment.ordinal,
        task = first.segment.task,
        frame = first.segment.frame,
        state = first.segment.state,
    };
    let output: ReportRecords = { head = handle, tail = first.segment_tail, count = first.segment_count };

    return (segment, output);
}
