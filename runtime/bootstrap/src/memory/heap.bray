trusted internal module bray.runtime.bootstrap.heap;

using core.memory;
using std.memory;
using internal std.runtime.memory;

trusted internal func allocate(pos bytes: usize, align: usize) -> DataPointer<u8>
    ensures(
        std.memory.is_null<u8>(result) || trusted core.memory.owned_allocation(
            pointer = result,
            bytes = bytes,
            align = align
        ),
        std.memory.is_null<u8>(result) || trusted core.memory.valid_write<u8>(pointer = result, count = bytes),
    )
{
    return trusted internal std.runtime.memory.try_allocate(bytes, align);
}

trusted internal func deallocate_bytes(pos pointer: DataPointer<u8>, pos bytes: usize, align: usize)
    requires(trusted core.memory.owned_allocation(pointer = pointer, bytes = bytes, align = align))
    uses(manual_alloc)
{
    trusted core.memory.deallocate(pointer, bytes = bytes, align = align);
}

// Adopt the actual allocation into the standard buffer owner. Failure leaves no
// live allocation, and moving the buffer retains its initialized prefix and disposal.
trusted internal func try_buffer<T>(pos capacity: usize) -> std.memory.RawBuffer<T>?
{
    let stride: usize = std.memory.stride_of<T>();
    let maximum: usize = ~0;

    if stride != 0 && capacity > maximum / stride
    {
        return none;
    }

    let bytes: usize = stride * capacity;
    let allocation: DataPointer<u8> = trusted allocate(bytes, align = std.memory.align_of<T>());

    if std.memory.is_null<u8>(allocation)
    {
        return none;
    }

    let pointer: DataPointer<T> = trusted allocation_pointer<T>(allocation, capacity);

    let buffer: std.memory.RawBuffer<T> =
    {
        pointer = pointer,
        capacity = capacity,
        initialized = 0
    };

    let mut result: std.memory.RawBuffer<T>? = none;

    result = buffer;
    return result;
}

trusted internal func allocation_pointer<T>(pos pointer: DataPointer<u8>, pos capacity: usize) -> DataPointer<T>
    requires(
        trusted core.memory.owned_allocation(
            pointer = pointer,
            bytes = std.memory.stride_of<T>() * capacity,
            align = std.memory.align_of<T>(),
        ),
    )
    ensures(
        trusted core.memory.owned_allocation(
            pointer = std.memory.byte_address<T>(result),
            bytes = std.memory.stride_of<T>() * capacity,
            align = std.memory.align_of<T>(),
        ),
        trusted core.memory.valid_write<T>(pointer = result, count = capacity),
        trusted core.memory.aligned_for<T>(pointer = result),
        trusted core.memory.initialized_range_as<T>(pointer = result, count = 0),
    )
    uses(layout_reinterpret)
{
    return trusted std.memory.reinterpret<T, u8>(pointer);
}

// Install prepared capacity without allocating or releasing storage under a caller's lock.
// Replaced empty backing stays in prepared until the caller has released its lock.
trusted internal func reserve<T>(
    pos buffer: &mut(std.memory.RawBuffer<T>?),
    pos prepared: &mut(std.memory.RawBuffer<T>?)
) -> Result<bool, usize>
    executes(total)
{
    if let ?storage = buffer
    {
        return trusted grow<T>(&mut storage, prepared);
    }

    if let ?replacement = prepared
    {
        if replacement.capacity < 1 || replacement.initialized != 0
        {
            return Error(1);
        }
    }
    else
    {
        return Error(1);
    }

    trusted internal std.memory.swap_values<(std.memory.RawBuffer<T>?)>(buffer, prepared);
    return Ok(true);
}

trusted internal func grow<T>(
    pos buffer: &mut std.memory.RawBuffer<T>,
    pos prepared: &mut(std.memory.RawBuffer<T>?)
) -> Result<bool, usize>
    executes(total)
    uses(raw_memory, unchecked_init)
{
    if buffer.initialized < buffer.capacity
    {
        return Ok(true);
    }

    let maximum: usize = ~0;

    if buffer.capacity > maximum - buffer.capacity
    {
        return Ok(false);
    }

    let required: usize = if buffer.capacity == 0
    {
        yield 1;
    }
    else
    {
        yield buffer.capacity * 2;
    };

    if let ?replacement = prepared
    {
        if replacement.capacity < required || replacement.initialized != 0
        {
            return Error(required);
        }

        trusted internal std.memory.raw_buffer_relocate<T>(buffer, &mut replacement);
        trusted internal std.memory.swap_values<std.memory.RawBuffer<T>>(buffer, &mut replacement);
        return Ok(true);
    }

    return Error(required);
}
