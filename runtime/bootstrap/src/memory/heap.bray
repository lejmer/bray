trusted internal module bray.runtime.bootstrap.heap;

using std.memory;
using internal std.runtime.memory;

trusted internal func allocate(pos bytes: usize, align: usize) -> RawPointer<u8>
    ensures(
        std.memory.is_null<u8>(result) || trusted core.memory.owned_allocation(
            pointer = result,
            bytes = bytes,
            align = align
        ),
        std.memory.is_null<u8>(result) || trusted core.memory.valid_write<u8>(pointer = result, count = bytes),
    )
{
    return trusted internal std.runtime.memory.try_allocate(bytes, align);
}

trusted internal func deallocate_bytes(pos pointer: RawPointer<u8>, pos bytes: usize, align: usize)
    requires(trusted core.memory.owned_allocation(pointer = pointer, bytes = bytes, align = align))
    uses(manual_alloc)
{
    trusted core.memory.deallocate(pointer, bytes = bytes, align = align);
}
