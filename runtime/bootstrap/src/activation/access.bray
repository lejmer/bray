@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.activation;

using core.target;
using internal bray.runtime.bootstrap;
using core.memory;
using std.memory;

// The native producer retains the immutable descriptor's provider and has
// initialized the claimed frame. This contract does not certify the supplied
// lease or grant dispatch ownership. Resident validation and phase transition
// establish those separately while the pool is locked. Descriptor callbacks use
// their declared ABI and context and retain the provider through return.
trusted internal predicate producer(token: &Inactive);

internal struct ProducerAcquisition
{
}

// This exclusive permission ends before activation or destruction can release
// the provider. The copied ABI token alone cannot recreate it.
internal struct Producer
{
    acquisition: ProducerAcquisition;
    token: Inactive;
}

trusted internal predicate producer_owned(owner: &ProducerAcquisition);

impl Inactive
{
    trusted internal consume func into_producer() -> Producer
        requires(
            trusted producer(token = &self),
            trusted bray.runtime.bootstrap.activation.requirements.inactive_owner(token = &self),
        )
        ensures(trusted producer_owned(owner = &result.acquisition))
        uses(raw_memory)
    {
        return
        {
            acquisition = ProducerAcquisition
            {
            },
            token = trusted std.memory.read<Inactive>(std.memory.address_of<Inactive>(&self))
        };
    }
}

internal const func producer_reference(pos owner: &(Producer?)) -> &Producer
    requires(owner matches ?_)
    executes(pure, total)
{
    return match owner
    {
        case ?value { yield &value; }
        case none { panic("missing inactive producer"); }
    };
}

trusted internal func producer_description(pos owner: &Producer) -> Descriptor
    requires(trusted producer_owned(owner = &owner.acquisition))
    ensures(trusted producer_owned(owner = &owner.acquisition))
    uses(raw_memory)
{
    let authorize = trusted lambda(pos owner: &Producer) -> DataPointer<Descriptor>
        requires(trusted producer_owned(owner = &owner.acquisition))
        ensures(
            trusted core.memory.valid_read<Descriptor>(pointer = result, count = 1),
            trusted core.memory.aligned_for<Descriptor>(pointer = result),
            trusted core.memory.initialized_as<Descriptor>(pointer = result),
        )
        executes(pure, total)
    {
        return owner.token.descriptor;
    };

    return trusted std.memory.read<Descriptor>(authorize(owner));
}

trusted internal func description(pos token: &Inactive) -> Descriptor
    requires(trusted producer(token = token))
    ensures(trusted producer(token = token))
    uses(raw_memory)
{
    let authorize = trusted lambda(pos owner: &Inactive) -> DataPointer<Descriptor>
        requires(trusted producer(token = owner))
        ensures(
            trusted core.memory.valid_read<Descriptor>(pointer = result, count = 1),
            trusted core.memory.aligned_for<Descriptor>(pointer = result),
            trusted core.memory.initialized_as<Descriptor>(pointer = result),
        )
        executes(pure, total)
    {
        return owner.descriptor;
    };

    let pointer = authorize(token);

    return trusted std.memory.read<Descriptor>(pointer);
}

// Only the producer can publish initialized backing. The descriptor is retained
// in the pool before the inactive value is exposed to its consumer.
trusted internal func publish(pos token: &Inactive) -> u32
    requires(trusted producer(token = token), trusted bray.runtime.bootstrap.pool.protocol_access())
    ensures(trusted producer(token = token))
    uses(intrinsic)
{
    let descriptor = trusted description(token);

    if !valid_layout(&descriptor)
    {
        return 3;
    }

    let identity: usize = trusted core.target.expose_address<Descriptor>(token.descriptor);
    let mut guard = trusted bray.runtime.bootstrap.pool.lock();

    if !trusted bray.runtime.bootstrap.storage.publish_frame(guard.get(), &token.lease, &descriptor.storage, identity)
    {
        return 3;
    }

    return bray.runtime.bootstrap.STATUS_SUCCESS;
}

// A native producer retains this initialized token and its descriptor provider
// throughout publication. The contract refers to the exact input slot.
trusted internal predicate producer_slot(pointer: DataPointer<Inactive>);

@abi(c)
trusted internal func publication(pos pointer: DataPointer<Inactive>) -> u32
    requires(
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted producer_slot(pointer = pointer),
        trusted core.memory.valid_read<Inactive>(pointer = pointer, count = 1),
        trusted core.memory.initialized_as<Inactive>(pointer = pointer),
        trusted core.memory.aligned_for<Inactive>(pointer = pointer),
    )
{
    let token = read_producer(pointer);

    return trusted publish(&token);
}

trusted internal func read_producer(pos source: DataPointer<Inactive>) -> Inactive
    requires(
        trusted producer_slot(pointer = source),
        trusted core.memory.valid_read<Inactive>(pointer = source, count = 1),
        trusted core.memory.initialized_as<Inactive>(pointer = source),
        trusted core.memory.aligned_for<Inactive>(pointer = source),
    )
    ensures(trusted producer(token = &result))
    uses(raw_memory)
{
    return trusted std.memory.read<Inactive>(source);
}
