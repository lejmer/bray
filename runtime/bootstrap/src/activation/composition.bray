@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.activation.composition;

using core.target;
using internal bray.runtime.bootstrap;
using internal bray.runtime.bootstrap.activation;
using internal bray.runtime.bootstrap.entry;
using internal bray.runtime.bootstrap.pool;
using core.memory;
using std.memory;

// The current run exclusively dispatches this parent and retains this exact
// inactive token slot. The admission callback checks the combined requirements
// before either owner changes. No callback can consume either owner before this
// call returns. Failure preserves both.
//
// Ordinary composition requires a distinct, uninitialized, correctly aligned
// parent-frame destination large enough for this exact child result. The parent
// retains it until the transferred outcome is consumed before cancellation.
//
// Abandonment and retained quiescence require destination zero and never enter
// the body. Quiescence returns terminal capture ownership to the original future.
// Its source slot and resident provider remain owned until synchronous destruction.
trusted internal predicate authorized(
    parent: DataPointer<bray.runtime.bootstrap.activation.Header>,
    token: DataPointer<bray.runtime.bootstrap.activation.Inactive>,
    state: u32,
    origin: u64,
    destination: usize,
    disposition: u8,
);

@abi(c)
trusted internal func compose(
    pos parent: DataPointer<bray.runtime.bootstrap.activation.Header>,
    pos token: DataPointer<bray.runtime.bootstrap.activation.Inactive>,
    pos state: u32,
    pos origin: u64,
    pos destination: usize,
    pos disposition: u8,
    pos ready: FunctionPointer<bray.runtime.bootstrap.activation.callback.Ready>
) -> usize
    requires(
        disposition <= 2,
        trusted authorized(
            parent = parent,
            token = token,
            state = state,
            origin = origin,
            destination = destination,
            disposition = disposition
        ),
        trusted bray.runtime.bootstrap.activation.execution.owned(pointer = parent),
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted core.memory.callable_address_valid<bray.runtime.bootstrap.activation.callback.Ready>(pointer = ready)
    )
    ensures(trusted bray.runtime.bootstrap.activation.execution.owned(pointer = parent))
{
    let acquire = trusted lambda(
        pos parent: DataPointer<bray.runtime.bootstrap.activation.Header>,
        pos token: DataPointer<bray.runtime.bootstrap.activation.Inactive>,
        pos state: u32,
        pos origin: u64,
        pos destination: usize,
        pos disposition: u8,
        pos ready: FunctionPointer<bray.runtime.bootstrap.activation.callback.Ready>
    ) -> Composition
        requires(
            trusted authorized(
                parent = parent,
                token = token,
                state = state,
                origin = origin,
                destination = destination,
                disposition = disposition
            ),
            trusted bray.runtime.bootstrap.activation.execution.owned(pointer = parent),
            trusted core.memory.callable_address_valid<bray.runtime.bootstrap.activation.callback.Ready>(
                pointer = ready
            )
        )
        ensures(trusted composition_pending(owner = &result))
        uses(raw_memory, layout_reinterpret)
    {
        let readable = trusted lambda(pos token: DataPointer<bray.runtime.bootstrap.activation.Inactive>)
            ensures(
                trusted core.memory.valid_read<bray.runtime.bootstrap.activation.Inactive>(pointer = token, count = 1),
                trusted core.memory.initialized_as<bray.runtime.bootstrap.activation.Inactive>(pointer = token),
                trusted core.memory.aligned_for<bray.runtime.bootstrap.activation.Inactive>(pointer = token)
            )
            executes(pure, total) {};

        trusted readable(token);

        return
        {
            request = Request
            {
                acquisition = RequestAcquisition
                {
                },
                producer = bray.runtime.bootstrap.activation.Producer
                {
                    acquisition = bray.runtime.bootstrap.activation.ProducerAcquisition
                    {
                    },
                    token = trusted std.memory.read<bray.runtime.bootstrap.activation.Inactive>(token)
                },
                state = state,
                destination = destination,
                disposition = disposition,
                ready = trusted std.memory.callable_from_pointer<bray.runtime.bootstrap.activation.callback.Ready>(
                    ready
                )
            },
            parent = bray.runtime.bootstrap.activation.run.Cursor
            {
                root = parent,
                pointer = parent
            },
            origin = origin
        };
    };

    return trusted compose_owned(trusted acquire(parent, token, state, origin, destination, disposition, ready));
}

trusted internal func compose_owned(pos mut owner: Composition) -> usize
    requires(
        trusted composition_pending(owner = &owner),
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted bray.runtime.bootstrap.entry.native_entry()
    )
    uses(intrinsic)
{
    if owner.request.disposition > 2
    {
        return 0;
    }

    let state = owner.request.state;
    let origin = owner.origin;
    let disposition = owner.request.disposition;

    let execution = match consume trusted bray.runtime.bootstrap.activation.requirements.active(
        &mut owner.parent,
        state,
        0,
        0
    )
    {
        case ?execution { yield execution; }
        case none { return 0; }
    };

    // Inactive abandonment enters cleanup directly. It cannot acquire authority
    // from the source body's requirements or execute that body to discover work.
    let operation: u32 = if disposition != 0
    {
        yield 3;
    }
    else
    {
        yield 0;
    };

    let argument: usize = if disposition == 2
    {
        yield 4;
    }
    else if disposition != 0
    {
        yield 3;
    }
    else
    {
        yield 0;
    };

    let inspect_child = trusted lambda(
        pos cursor: &mut bray.runtime.bootstrap.activation.run.Cursor,
        pos value: &bray.runtime.bootstrap.activation.Producer,
        pos operation: u32,
        pos argument: usize,
        pos origin: u64
    ) -> bray.runtime.bootstrap.activation.requirements.Execution?
        requires(
            trusted bray.runtime.bootstrap.activation.run.selected(cursor = &cursor),
            trusted bray.runtime.bootstrap.activation.producer_owned(owner = &value.acquisition),
            trusted bray.runtime.bootstrap.pool.protocol_access()
        )
        ensures(
            trusted bray.runtime.bootstrap.activation.run.selected(cursor = &cursor),
            trusted bray.runtime.bootstrap.activation.producer_owned(owner = &value.acquisition)
        )
    {
        // The metadata protocol retains both owners through provider reentry.
        // Its callback cannot dispatch the exclusively held parent or child.
        return trusted bray.runtime.bootstrap.activation.requirements.read(value, 0, operation, argument, origin);
    };

    let own = match consume trusted inspect_child(
        &mut owner.parent,
        bray.runtime.bootstrap.activation.producer_reference(&owner.request.producer),
        operation,
        argument,
        origin
    )
    {
        case ?requirements { yield requirements; }
        case none { return 0; }
    };

    let combined = match consume bray.runtime.bootstrap.activation.requirements.combine(
        own.requirements,
        own.origin,
        execution.requirements,
        execution.origin
    )
    {
        case ?requirements { yield requirements; }
        case none { return 0; }
    };

    let requested: bray.runtime.bootstrap.activation.requirements.Execution =
    {
        address = execution.address,
        identity = execution.identity,
        state = execution.state,
        requirements = combined,
        origin = if execution.requirements.affinity == 1
        {
            yield execution.origin;
        }
        else
        {
            yield origin;
        },
    };

    let description: bray.runtime.bootstrap.activation.Descriptor? = none;
    let mut progress = bray.runtime.bootstrap.activation.empty_progress();
    let mut records = bray.runtime.bootstrap.empty_records();

    let mut invocation = trusted bray.runtime.bootstrap.activation.callback.prepare_invocation(
        &mut owner.parent,
        &requested,
        &description,
        operation,
        argument,
        &mut progress,
        &mut records
    );

    trusted bray.runtime.bootstrap.activation.callback.admit(&mut owner.parent, owner.request.ready, &mut invocation);

    if invocation.admission != 0
    {
        return 0;
    }

    // This transition consumes only inactive permission. The complete request
    // and selected parent still retain the exact connection and destination.
    let begin_child = trusted lambda(pos owner: &mut Composition, pos admission: u32) -> usize
        requires(
            admission == 0,
            trusted composition_pending(owner = &owner),
            trusted bray.runtime.bootstrap.pool.protocol_access()
        )
        ensures(
            trusted composition_owned(owner = &owner.request.acquisition),
            trusted bray.runtime.bootstrap.activation.run.selected(cursor = &owner.parent),
            owner.request.producer matches none
        )
        uses(intrinsic)
    {
        let producer = match consume trusted std.memory.take_nullable<bray.runtime.bootstrap.activation.Producer>(
            &mut owner.request.producer
        )
        {
            case ?value { yield value; }
            case none { yield trusted core.target.abort(); }
        };

        let authorize = trusted lambda(pos value: &bray.runtime.bootstrap.activation.Producer, pos origin: u64)
            requires(trusted bray.runtime.bootstrap.activation.producer_owned(owner = &value.acquisition))
            ensures(
                trusted bray.runtime.bootstrap.activation.entry_authorized(owner = &value.acquisition, origin = origin)
            )
            executes(pure, total) {};

        trusted authorize(&producer, owner.origin);

        return trusted bray.runtime.bootstrap.activation.begin(producer, owner.origin);
    };

    let address = trusted begin_child(&mut owner, invocation.admission);

    if address == 0
    {
        return 0;
    }

    // Successful resident admission establishes the new child owner. These local
    // writes only connect the returned header to the already retained parent.
    let connect = trusted lambda(
        pos owner: &mut Composition,
        pos child: DataPointer<bray.runtime.bootstrap.activation.Header>,
        pos execution: bray.runtime.bootstrap.activation.requirements.Execution,
        pos address: usize,
    )
        requires(
            trusted composition_owned(owner = &owner.request.acquisition),
            trusted bray.runtime.bootstrap.activation.run.selected(cursor = &owner.parent)
        )
        ensures(trusted bray.runtime.bootstrap.activation.run.selected(cursor = &owner.parent))
        uses(raw_memory, unchecked_init)
    {
        let acquire = trusted lambda(pos pointer: DataPointer<bray.runtime.bootstrap.activation.Header>) ->
            bray.runtime.bootstrap.activation.run.Cursor
            ensures(trusted bray.runtime.bootstrap.activation.run.selected(cursor = &result))
            executes(pure, total)
        {
            return
            {
                root = pointer,
                pointer = pointer
            };
        };

        // Resident admission returned fresh child storage, distinct from parent.
        let mut attached_cursor = trusted acquire(child);

        {
            let retained = trusted bray.runtime.bootstrap.activation.execution.access(&mut owner.parent);
            let attached = trusted bray.runtime.bootstrap.activation.execution.access(&mut attached_cursor);

            trusted bray.runtime.bootstrap.activation.attach(
                retained,
                attached,
                execution.address,
                address,
                execution.requirements.affinity,
                execution.requirements.lanes,
                execution.origin
            );

            attached.destination = owner.request.destination;
            attached.disposition = owner.request.disposition as u32;

            if owner.request.disposition != 0
            {
                _ = trusted bray.runtime.bootstrap.activation.abandon(attached);
            }
        }
    };

    let child = trusted core.target.from_exposed_address<bray.runtime.bootstrap.activation.Header>(address = address);

    trusted connect(&mut owner, child, execution, address);
    return address;
}

// Abandonment cannot revoke the retained owner's later destruction obligation.
internal func abandon(pos disposition: u32) -> u32
    executes(pure, total)
{
    if disposition == 0
    {
        return 1;
    }
    else
    {
        return disposition;
    }
}
