@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.activation.callback;

using core.memory;
using core.target;
using std.memory;
using internal bray.runtime.bootstrap.activation;
using internal bray.runtime.bootstrap.activation.requirements;
using internal bray.runtime.bootstrap.scheduler;
using internal bray.runtime.bootstrap;

@copy
@layout(c, tag = u32)
internal union Exit
{
    Completed;
    Cancelled;
    Panicked;
    RuntimeFailure;
    Quiescence;
    RetainedDestruction;
    SynchronousDisposal;
}

@copy
@layout(c, tag = u32)
internal union Operation
{
    Resume;
    Cancel;
    Broadcast;
    Resolve(pos cleanup_exit: Exit);
    Move(pos destination: usize);
    Destroy;
}

@layout(c)
internal struct CallAcquisition
{
}

// This noncopy call scope binds the retained execution/descriptor providers to
// the exact producer context and its independent, exclusively owned outputs.
@layout(c)
internal struct Invocation
{
    acquisition: CallAcquisition;
    execution: DataPointer<bray.runtime.bootstrap.activation.requirements.Execution>;
    descriptor: DataPointer<bray.runtime.bootstrap.activation.Descriptor>;
    context: usize;
    operation: Operation;
    progress: DataPointer<bray.runtime.bootstrap.activation.Progress>;
    records: DataPointer<bray.runtime.bootstrap.ReportRecords>;
    mut admission: u32;
}

trusted internal predicate authorized(owner: &CallAcquisition);

// Output storage and the descriptor provider outlive consuming frame actions.
trusted internal predicate outputs_owned(owner: &CallAcquisition);

trusted internal predicate returned(owner: &CallAcquisition);

// Admission borrows the complete call without changing its owner or outputs.
// Operation identity distinguishes synchronous disposal from a resumable entry.
internal callable Ready = @abi(c) trusted func(pos mut owner: Invocation) -> Invocation
    requires(
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted authorized(owner = &owner.acquisition),
        trusted outputs_owned(owner = &owner.acquisition)
    )
    ensures(trusted authorized(owner = &result.acquisition), trusted outputs_owned(owner = &result.acquisition));

// Invocation adapters consume and return the complete call scope. Returning
// ownership keeps the outputs available after consuming frame destruction.
internal callable Invoke = @abi(c) trusted func(pos mut owner: Invocation) -> Invocation
    requires(
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted authorized(owner = &owner.acquisition),
        trusted outputs_owned(owner = &owner.acquisition),
    )
    ensures(trusted returned(owner = &result.acquisition));

// Source retains the whole invocation on its stack while the native adapter
// borrows it. Metadata and lane are observations of that actual call entry.
internal callable NativeInvoke = @abi(c) trusted func(
    pos invocation: DataPointer<Invocation>,
    pos metadata: usize,
    pos lane: bray.runtime.bootstrap.scheduler.Lane
)
    requires(trusted native_invocation(pointer = invocation))
    ensures(trusted native_invocation_returned(pointer = invocation));

// The selected cursor retains the producer and provider while the call owns
// its two output slots. Admission can describe proposed call-entry requirements
// without replacing the run's current execution state.
trusted internal func prepare_invocation(
    pos cursor: &mut bray.runtime.bootstrap.activation.run.Cursor,
    pos execution: DataPointer<bray.runtime.bootstrap.activation.requirements.Execution>,
    pos description: &(bray.runtime.bootstrap.activation.Descriptor?),
    pos operation: u32,
    pos argument: usize,
    pos progress: DataPointer<bray.runtime.bootstrap.activation.Progress>,
    pos records: DataPointer<bray.runtime.bootstrap.ReportRecords>
) -> Invocation
    requires(trusted bray.runtime.bootstrap.activation.run.selected(cursor = &cursor), operation < 6, operation != 3 || argument < 7, operation != 5 || description matches ?_)
    ensures(
        trusted bray.runtime.bootstrap.activation.run.selected(cursor = &cursor),
        trusted authorized(owner = &result.acquisition),
        trusted outputs_owned(owner = &result.acquisition)
    )
    uses(intrinsic)
{
    let (context, address) =
    {
        let header = trusted bray.runtime.bootstrap.activation.execution.access(cursor);

        yield (header.context, trusted core.target.expose_address<bray.runtime.bootstrap.activation.Descriptor>(header.descriptor));
    };

    let descriptor = match description
    {
        case ?value { yield std.memory.address_of<bray.runtime.bootstrap.activation.Descriptor>(&value); }
        case none { yield trusted core.target.from_exposed_address<bray.runtime.bootstrap.activation.Descriptor>(address = address); }
    };

    return
    {
        acquisition = CallAcquisition {},
        execution = execution,
        descriptor = descriptor,
        context = context,
        operation = trusted selected_operation(operation, argument),
        progress = progress,
        records = records,
        admission = 0
    };
}

trusted internal predicate native_invocation(pointer: DataPointer<Invocation>);

trusted internal predicate native_invocation_returned(pointer: DataPointer<Invocation>);

trusted internal func invoke(pos callback: Invoke, pos owner: Invocation) -> (
        bray.runtime.bootstrap.activation.Progress,
        bray.runtime.bootstrap.ReportRecords
    )
    requires(
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted authorized(owner = &owner.acquisition),
        trusted outputs_owned(owner = &owner.acquisition),
    )
    ensures(trusted bray.runtime.bootstrap.native_report_callbacks(report = &result.0.report))
    uses(foreign_call)
{
    let completed = trusted callback(owner);

    return trusted take_returned(completed);
}

trusted internal func take_returned(pos owner: Invocation) -> (
        bray.runtime.bootstrap.activation.Progress,
        bray.runtime.bootstrap.ReportRecords
    )
    requires(trusted returned(owner = &owner.acquisition))
    ensures(trusted bray.runtime.bootstrap.native_report_callbacks(report = &result.0.report))
    uses(raw_memory, intrinsic)
{
    let readable = trusted lambda(pos call: &Invocation)
        requires(trusted returned(owner = &call.acquisition))
        ensures(
            trusted core.memory.valid_read<bray.runtime.bootstrap.activation.Progress>(pointer = call.progress, count = 1),
            trusted core.memory.initialized_as<bray.runtime.bootstrap.activation.Progress>(pointer = call.progress),
            trusted core.memory.aligned_for<bray.runtime.bootstrap.activation.Progress>(pointer = call.progress),
            trusted core.memory.valid_read<bray.runtime.bootstrap.ReportRecords>(pointer = call.records, count = 1),
            trusted core.memory.initialized_as<bray.runtime.bootstrap.ReportRecords>(pointer = call.records),
            trusted core.memory.aligned_for<bray.runtime.bootstrap.ReportRecords>(pointer = call.records),
            trusted core.memory.non_overlapping<u8>(
                left = std.memory.byte_address<bray.runtime.bootstrap.activation.Progress>(call.progress),
                left_count = std.memory.size_of<bray.runtime.bootstrap.activation.Progress>(),
                right = std.memory.byte_address<bray.runtime.bootstrap.ReportRecords>(call.records),
                right_count = std.memory.size_of<bray.runtime.bootstrap.ReportRecords>()
            ),
        )
        executes(pure, total) {};

    trusted readable(&owner);

    let records = trusted std.memory.read<bray.runtime.bootstrap.ReportRecords>(owner.records);
    let progress = trusted std.memory.read<bray.runtime.bootstrap.activation.Progress>(owner.progress);

    return (progress, records);
}

trusted internal func selected_operation(pos operation: u32, pos argument: usize) -> Operation
    requires(operation < 6, operation != 3 || argument < 7)
{
    return match operation
    {
        case 0 { yield Operation.Resume; }
        case 1 { yield Operation.Cancel; }
        case 2 { yield Operation.Broadcast; }
        case 3
        {
            yield match argument
            {
                case 0 { yield Operation.Resolve(Exit.Completed); }
                case 1 { yield Operation.Resolve(Exit.Cancelled); }
                case 2 { yield Operation.Resolve(Exit.Panicked); }
                case 3 { yield Operation.Resolve(Exit.RuntimeFailure); }
                case 4 { yield Operation.Resolve(Exit.Quiescence); }
                case 5 { yield Operation.Resolve(Exit.RetainedDestruction); }
                case 6 { yield Operation.Resolve(Exit.SynchronousDisposal); }
                case _ { yield trusted core.target.abort(); }
            };
        }
        case 4 { yield Operation.Move(argument); }
        case 5 { yield Operation.Destroy; }
        case _ { yield trusted core.target.abort(); }
    };
}

internal func exit_code(pos cleanup_exit: Exit) -> u32
    executes(pure, total)
{
    return match cleanup_exit
    {
        case Completed { yield 0; }
        case Cancelled { yield 1; }
        case Panicked { yield 2; }
        case RuntimeFailure { yield 3; }
        case Quiescence { yield 4; }
        case RetainedDestruction { yield 5; }
        case SynchronousDisposal { yield 6; }
    };
}

internal func resumable(pos operation: Operation) -> bool
    executes(pure, total)
{
    return match operation
    {
        case Resume | Cancel { yield true; }
        case Resolve(cleanup_exit) { yield !(cleanup_exit matches Exit.RetainedDestruction | Exit.SynchronousDisposal); }
        case Broadcast | Move(_) | Destroy { yield false; }
    };
}

trusted internal func execution(pos owner: &Invocation) -> &bray.runtime.bootstrap.activation.requirements.Execution
    requires(trusted authorized(owner = &owner.acquisition))
    ensures(trusted authorized(owner = &owner.acquisition))
    executes(pure, total)
    uses(raw_memory, unchecked_alias)
{
    let permit = trusted lambda(pos owner: &Invocation)
        requires(trusted authorized(owner = &owner.acquisition))
        ensures(
            trusted core.memory.valid_read<bray.runtime.bootstrap.activation.requirements.Execution>(pointer = owner.execution, count = 1),
            trusted core.memory.initialized_as<bray.runtime.bootstrap.activation.requirements.Execution>(pointer = owner.execution),
            trusted core.memory.aligned_for<bray.runtime.bootstrap.activation.requirements.Execution>(pointer = owner.execution),
            trusted core.memory.shared_alias_valid<bray.runtime.bootstrap.activation.requirements.Execution>(pointer = owner.execution),
            trusted core.memory.epoch_current<bray.runtime.bootstrap.activation.requirements.Execution>(pointer = owner.execution),
            trusted core.memory.synchronized_access<bray.runtime.bootstrap.activation.requirements.Execution>(pointer = owner.execution),
            trusted core.memory.movement_stable<bray.runtime.bootstrap.activation.requirements.Execution>(pointer = owner.execution),
            trusted core.memory.finalization_pending<bray.runtime.bootstrap.activation.requirements.Execution>(pointer = owner.execution)
        )
        executes(pure, total) {};

    trusted permit(owner);
    return trusted std.memory.borrow_from<bray.runtime.bootstrap.activation.requirements.Execution, Invocation>(owner, owner.execution);
}
