@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.activation.requirements;

using std.memory;
using internal bray.runtime.bootstrap.activation;

// Exact exclusive ownership keeps inspection from racing activation or disposal.
trusted internal predicate inactive_owner(token: &bray.runtime.bootstrap.activation.Inactive);

// The caller retains an exclusive inactive owner and this independent output
// slot throughout the metadata callback. Neither may be activated by reentry.
trusted internal predicate retained(
    token: RawPointer<bray.runtime.bootstrap.activation.Inactive>,
    output: RawPointer<State>,
);

trusted internal func read(pos token: &bray.runtime.bootstrap.activation.Inactive, pos state: u32) -> State?
    requires(
        trusted bray.runtime.bootstrap.activation.producer(token = token),
        trusted inactive_owner(token = token),
        trusted bray.runtime.bootstrap.pool.protocol_access(),
    )
    ensures(trusted bray.runtime.bootstrap.activation.producer(token = token), trusted inactive_owner(token = token))
    uses(intrinsic, raw_memory, unchecked_alias, layout_reinterpret)
{
    let descriptor = trusted bray.runtime.bootstrap.activation.description(token);

    if state >= descriptor.states
    {
        return none;
    }

    let locate = trusted lambda(
        pos token: &bray.runtime.bootstrap.activation.Inactive,
        pos descriptor: &bray.runtime.bootstrap.activation.Descriptor,
    ) -> usize
        requires(
            trusted bray.runtime.bootstrap.activation.producer(token = token),
            trusted inactive_owner(token = token),
            trusted bray.runtime.bootstrap.pool.protocol_access(),
        )
        ensures(
            trusted bray.runtime.bootstrap.activation.producer(token = token),
            trusted inactive_owner(token = token),
        )
    {
        // The lookup reads the registered inactive phase. It cannot consume the
        // token or invoke its provider, and the caller retains the attachment.
        let mut guard = trusted bray.runtime.bootstrap.pool.lock();

        return trusted bray.runtime.bootstrap.activation.resident_address(
            guard.get(),
            token,
            descriptor,
            dispatch = false
        );
    };

    let address = trusted locate(token, &descriptor);

    if address == 0
    {
        return none;
    }

    let pointer = trusted core.target.from_exposed_address<bray.runtime.bootstrap.activation.Header>(address = address);

    // The resident lookup has checked the exact descriptor, epoch and inactive
    // phase. The producer keeps the initialized frame stable until this returns.
    let authorize = trusted lambda(
        pos token: &bray.runtime.bootstrap.activation.Inactive,
        pos pointer: RawPointer<bray.runtime.bootstrap.activation.Header>
    )
        requires(
            trusted bray.runtime.bootstrap.activation.producer(token = token),
            trusted inactive_owner(token = token)
        )
        ensures(
            trusted bray.runtime.bootstrap.activation.producer(token = token),
            trusted core.memory.valid_read<bray.runtime.bootstrap.activation.Header>(pointer = pointer, count = 1),
            trusted core.memory.aligned_for<bray.runtime.bootstrap.activation.Header>(pointer = pointer),
            trusted core.memory.initialized_as<bray.runtime.bootstrap.activation.Header>(pointer = pointer),
            trusted core.memory.shared_alias_valid<bray.runtime.bootstrap.activation.Header>(pointer = pointer),
            trusted core.memory.epoch_current<bray.runtime.bootstrap.activation.Header>(pointer = pointer),
            trusted core.memory.synchronized_access<bray.runtime.bootstrap.activation.Header>(pointer = pointer),
            trusted core.memory.movement_stable<bray.runtime.bootstrap.activation.Header>(pointer = pointer),
            trusted core.memory.finalization_pending<bray.runtime.bootstrap.activation.Header>(pointer = pointer),
        )
        executes(pure, total) {};

    trusted authorize(token, pointer);

    let context =
    {
        let header = trusted std.memory.borrow_from<
            bray.runtime.bootstrap.activation.Header,
            bray.runtime.bootstrap.activation.Inactive
        >(token, pointer);

        yield header.context;
    };

    let callback = trusted std.memory.reinterpret<Query, u8>(descriptor.state);

    let invoke = trusted lambda(
        pos token: &bray.runtime.bootstrap.activation.Inactive,
        pos callback: RawPointer<Query>,
        pos context: usize,
        pos state: u32,
    ) -> State
        requires(
            trusted bray.runtime.bootstrap.activation.producer(token = token),
            trusted inactive_owner(token = token)
        )
        ensures(
            trusted bray.runtime.bootstrap.activation.producer(token = token),
            trusted inactive_owner(token = token)
        )
        uses(layout_reinterpret)
    {
        let authorize = trusted lambda(pos callback: RawPointer<Query>, pos context: usize, pos state: u32)
            ensures(
                trusted core.memory.callable_address_valid<Query>(pointer = callback),
                trusted query_context(context = context, state = state),
            )
            executes(pure, total) {};

        trusted authorize(callback, context, state);

        let selected = trusted std.memory.callable_from_pointer<Query>(callback);

        return trusted selected(context, state);
    };

    // No pool lock or header borrow crosses the provider callback.
    let requirements = trusted invoke(token, callback, context, state);

    if !valid(requirements)
    {
        return none;
    }

    let mut result: State? = none;

    result = requirements;
    return result;
}

@abi(c)
trusted internal func inspect(
    pos pointer: RawPointer<bray.runtime.bootstrap.activation.Inactive>,
    pos state: u32,
    pos output: RawPointer<State>,
) -> u32
    requires(
        trusted bray.runtime.bootstrap.activation.producer_slot(pointer = pointer),
        trusted retained(token = pointer, output = output),
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted core.memory.valid_read<bray.runtime.bootstrap.activation.Inactive>(pointer = pointer, count = 1),
        trusted core.memory.initialized_as<bray.runtime.bootstrap.activation.Inactive>(pointer = pointer),
        trusted core.memory.aligned_for<bray.runtime.bootstrap.activation.Inactive>(pointer = pointer),
    )
    uses(raw_memory, unchecked_init)
{
    let query = trusted lambda(
        pos pointer: RawPointer<bray.runtime.bootstrap.activation.Inactive>,
        pos state: u32,
        pos output: RawPointer<State>,
    ) -> State?
        requires(
            trusted bray.runtime.bootstrap.activation.producer_slot(pointer = pointer),
            trusted retained(token = pointer, output = output),
            trusted bray.runtime.bootstrap.pool.protocol_access(),
            trusted core.memory.valid_read<bray.runtime.bootstrap.activation.Inactive>(pointer = pointer, count = 1),
            trusted core.memory.initialized_as<bray.runtime.bootstrap.activation.Inactive>(pointer = pointer),
            trusted core.memory.aligned_for<bray.runtime.bootstrap.activation.Inactive>(pointer = pointer),
        )
        ensures(
            trusted core.memory.valid_write<State>(pointer = output, count = 1),
            trusted core.memory.aligned_for<State>(pointer = output),
        )
    {
        let read_owned = trusted lambda(
            pos pointer: RawPointer<bray.runtime.bootstrap.activation.Inactive>,
            pos output: RawPointer<State>
        ) -> bray.runtime.bootstrap.activation.Inactive
            requires(
                trusted bray.runtime.bootstrap.activation.producer_slot(pointer = pointer),
                trusted retained(token = pointer, output = output),
                trusted core.memory.valid_read<bray.runtime.bootstrap.activation.Inactive>(
                    pointer = pointer,
                    count = 1
                ),
                trusted core.memory.initialized_as<bray.runtime.bootstrap.activation.Inactive>(pointer = pointer),
                trusted core.memory.aligned_for<bray.runtime.bootstrap.activation.Inactive>(pointer = pointer),
            )
            ensures(
                trusted bray.runtime.bootstrap.activation.producer(token = &result),
                trusted inactive_owner(token = &result)
            )
        {
            return trusted bray.runtime.bootstrap.activation.read_producer(pointer);
        };

        let token = trusted read_owned(pointer, output);

        return trusted read(&token, state);
    };

    let requirements = match consume trusted query(pointer, state, output)
    {
        case ?requirements { yield requirements; }
        case none { return 3; }
    };

    trusted std.memory.write<State>(output, requirements);
    return bray.runtime.bootstrap.STATUS_SUCCESS;
}
