@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.activation.execution;

using core.target;
using internal bray.runtime.bootstrap;
using core.memory;
using std.memory;

// The native dispatcher exclusively owns this exact admitted header. Retaining
// callbacks may attach a child but cannot dispatch or retire the executing frame.
// Retirement transfers the final records out before releasing frame storage.
// Callback provider code remains live through every call.
trusted internal predicate owned(pointer: DataPointer<bray.runtime.bootstrap.activation.Header>);

// Retirement retains every surviving ancestor under the run's exclusive claim.
// The caller removes the consumed link after the callback and never dereferences
// the retired header. Same-run callbacks cannot compose beneath a retiring frame.
trusted internal predicate retiring(pointer: DataPointer<bray.runtime.bootstrap.activation.Header>);

// The native root observer already took the source outcome from this header.
// Its report/value owner is handled by the observer before storage retirement.
trusted internal predicate observed(pointer: DataPointer<bray.runtime.bootstrap.activation.Header>);

// The caller owns a distinct admitted result destination with the exact size and
// alignment described by this frame. Transferred dependencies remain retained by
// that destination. The mover either transfers once or leaves its input owned by
// the frame when reporting failure. It never suspends or exposes a partial result.
trusted internal predicate completion_destination(
    pointer: DataPointer<bray.runtime.bootstrap.activation.Header>,
    address: usize,
);

// Resume, cancellation, broadcast and resolution retain their frame. Retirement
// consumes an already committed frame and never accesses it afterward.
trusted internal func invoke(
    pos cursor: &mut bray.runtime.bootstrap.activation.run.Cursor,
    pos callback: bray.runtime.bootstrap.activation.callback.Invoke,
    pos ready: bray.runtime.bootstrap.activation.callback.Ready,
    pos operation: u32,
    pos argument: usize,
) -> (
        bray.runtime.bootstrap.activation.Progress,
        bray.runtime.bootstrap.ReportRecords,
        bray.runtime.bootstrap.ReportRecords,
        u32,
        bray.runtime.bootstrap.activation.Progress
    )
    requires(
        trusted bray.runtime.bootstrap.activation.run.selected(cursor = &cursor),
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        operation < 6,
        (operation < 4 || (operation == 4 && trusted completion_destination(
            pointer = cursor.pointer,
            address = argument
        )) || (operation == 5 && trusted retiring(pointer = cursor.pointer))),
        operation != 3 || argument < 7,
    )
    ensures(
        trusted bray.runtime.bootstrap.native_report_callbacks(report = &result.0.report),
        trusted bray.runtime.bootstrap.native_report_callbacks(report = &result.4.report),
    )
    ensures(result.3 == 0 || trusted bray.runtime.bootstrap.activation.run.selected(cursor = &cursor))
    when(operation < 4)
    {
        ensures(trusted bray.runtime.bootstrap.activation.run.selected(cursor = &cursor))
    }
    when(operation == 4)
    {
        ensures(trusted bray.runtime.bootstrap.activation.run.selected(cursor = &cursor))
    }
    uses(intrinsic)
{

    let header = trusted read(cursor);

    if operation == 5 && (header.phase != bray.runtime.bootstrap.activation.COMMITTED || header.child != 0)
    {
        trusted core.target.abort();
    }

    if operation == 4 && (header.phase != bray.runtime.bootstrap.activation.TERMINAL || header.kind != 1 ||
        header.child != 0)
    {
        trusted core.target.abort();
    }

    let execution: bray.runtime.bootstrap.activation.requirements.Execution =
        match consume trusted bray.runtime.bootstrap.activation.requirements.active(
        cursor,
        header.state,
        operation,
        argument
    )
    {
        case ?execution { yield execution; }
        case none { yield trusted core.target.abort(); }
    };

    // Preparation borrows the same invocation that passed readiness. Its
    // output destinations remain owned while frame records transfer into them.
    let prepare = trusted lambda(pos cursor: &mut bray.runtime.bootstrap.activation.run.Cursor, pos invocation: &bray.runtime.bootstrap.activation.callback.Invocation) -> (
        bray.runtime.bootstrap.ReportRecords,
        bray.runtime.bootstrap.ReportRecords,
        bray.runtime.bootstrap.activation.Progress
    )
        requires(
            trusted bray.runtime.bootstrap.activation.run.selected(cursor = &cursor),
            trusted bray.runtime.bootstrap.activation.callback.authorized(owner = &invocation.acquisition),
            trusted bray.runtime.bootstrap.activation.callback.outputs_owned(owner = &invocation.acquisition)
        )
        ensures(
            trusted bray.runtime.bootstrap.activation.run.selected(cursor = &cursor),
            trusted bray.runtime.bootstrap.native_report_callbacks(report = &result.2.report),
            trusted bray.runtime.bootstrap.activation.callback.authorized(owner = &invocation.acquisition),
            trusted bray.runtime.bootstrap.activation.callback.outputs_owned(owner = &invocation.acquisition)
        )
    {
        let (incidents, progress) = if invocation.operation matches bray.runtime.bootstrap.activation.callback.Operation.Destroy
        {
            yield trusted take_terminal(cursor);
        }
        else
        {
            yield (bray.runtime.bootstrap.empty_records(), bray.runtime.bootstrap.activation.empty_progress());
        };

        let resident = trusted access(cursor);

        let records = std.memory.replace_value<bray.runtime.bootstrap.ReportRecords>(
            &mut resident.outgoing,
            bray.runtime.bootstrap.empty_records()
        );

        return (records, incidents, progress);
    };

    let mut records = bray.runtime.bootstrap.empty_records();

    // Only consuming destruction needs a descriptor copy after frame release.
    let description: bray.runtime.bootstrap.activation.Descriptor? = if operation == 5
    {
        yield trusted describe(cursor);
    }
    else
    {
        yield none;
    };

    let mut outcome: bray.runtime.bootstrap.activation.Progress =
    {
        kind = 4,
        state = 0,
        payload = 0,
        report = bray.runtime.bootstrap.empty_panic_report(),
    };

    let mut invocation = trusted bray.runtime.bootstrap.activation.callback.prepare_invocation(
        cursor,
        &execution,
        &description,
        operation,
        argument,
        &mut outcome,
        &mut records
    );

    let admit = trusted lambda(
        pos cursor: &mut bray.runtime.bootstrap.activation.run.Cursor,
        pos ready: bray.runtime.bootstrap.activation.callback.Ready,
        pos invocation: &mut bray.runtime.bootstrap.activation.callback.Invocation,
        pos operation: u32,
    )
        requires(
            trusted bray.runtime.bootstrap.activation.run.selected(cursor = &cursor),
            trusted bray.runtime.bootstrap.entry.native_entry(),
            trusted bray.runtime.bootstrap.pool.protocol_access(),
            trusted bray.runtime.bootstrap.activation.callback.authorized(owner = &invocation.acquisition),
            trusted bray.runtime.bootstrap.activation.callback.outputs_owned(owner = &invocation.acquisition),
        )
        ensures(trusted bray.runtime.bootstrap.activation.run.selected(cursor = &cursor), trusted bray.runtime.bootstrap.activation.callback.authorized(owner = &invocation.acquisition), trusted bray.runtime.bootstrap.activation.callback.outputs_owned(owner = &invocation.acquisition))
    {
        trusted bray.runtime.bootstrap.activation.callback.admit(ready, invocation);

        if invocation.admission == bray.runtime.bootstrap.STATUS_SUCCESS && operation == 3
        {
            trusted bray.runtime.bootstrap.entry.control.enter_cleanup();
        }

    };

    trusted admit(cursor, ready, &mut invocation, operation);
    let status = invocation.admission;

    if status != bray.runtime.bootstrap.STATUS_SUCCESS
    {
        let progress: bray.runtime.bootstrap.activation.Progress =
        {
            kind = 5,
            state = header.state,
            payload = 0,
            report = bray.runtime.bootstrap.empty_panic_report(),
        };

        return (
            progress,
            bray.runtime.bootstrap.empty_records(),
            bray.runtime.bootstrap.empty_records(),
            status,
            bray.runtime.bootstrap.activation.empty_progress()
        );
    }

    let (outgoing, incidents, retired) = trusted prepare(cursor, &invocation);

    trusted bray.runtime.bootstrap.activation.callback.prepare_records(&invocation, outgoing);

    if operation < 5
    {
        let call = trusted lambda(
            pos cursor: &mut bray.runtime.bootstrap.activation.run.Cursor,
            pos callback: bray.runtime.bootstrap.activation.callback.Invoke,
            pos invocation: bray.runtime.bootstrap.activation.callback.Invocation,
            pos resolving: bool,
        ) -> (bray.runtime.bootstrap.activation.Progress, bray.runtime.bootstrap.ReportRecords)
            requires(
                trusted bray.runtime.bootstrap.activation.run.selected(cursor = &cursor),
                trusted bray.runtime.bootstrap.entry.native_entry(),
                trusted bray.runtime.bootstrap.pool.protocol_access(),
                trusted bray.runtime.bootstrap.activation.callback.authorized(owner = &invocation.acquisition),
                trusted bray.runtime.bootstrap.activation.callback.outputs_owned(owner = &invocation.acquisition),
            )
            ensures(
                trusted bray.runtime.bootstrap.activation.run.selected(cursor = &cursor),
                trusted bray.runtime.bootstrap.native_report_callbacks(report = &result.0.report),
            )
        {
            let (returned, remaining) = trusted bray.runtime.bootstrap.activation.callback.invoke(callback, invocation);

            if resolving && !suspended(returned.kind)
            {
                trusted bray.runtime.bootstrap.entry.control.leave_cleanup();
            }

            return (returned, remaining);
        };

        // Select the retaining contract before entry. The complete header is
        // resident during reentry, and a fresh read preserves callback changes.
        let (progress, remaining) = trusted call(
            cursor,
            callback,
            invocation,
            operation == 3 || (operation == 0 && header.phase == bray.runtime.bootstrap.activation.RESOLVING)
        );

        let updated = trusted access(cursor);

        if operation == 4
        {
            if progress.kind == 1
            {
                updated.phase = bray.runtime.bootstrap.activation.COMMITTED;
            }
            else if progress.kind != 3
            {
                trusted core.target.abort();
            }
        }

        updated.outgoing = remaining;

        return (
            progress,
            bray.runtime.bootstrap.empty_records(),
            bray.runtime.bootstrap.empty_records(),
            bray.runtime.bootstrap.STATUS_SUCCESS,
            retired
        );
    }

    // The call retains the descriptor independently of consuming destruction.
    let (progress, remaining) = trusted bray.runtime.bootstrap.activation.callback.invoke(callback, invocation);

    return (progress, remaining, incidents, bray.runtime.bootstrap.STATUS_SUCCESS, retired);
}

// Retaining callbacks leave the dispatch claim and their returned report live.
trusted internal func invoke_retaining(
    pos cursor: &mut bray.runtime.bootstrap.activation.run.Cursor,
    pos callback: bray.runtime.bootstrap.activation.callback.Invoke,
    pos ready: bray.runtime.bootstrap.activation.callback.Ready,
    pos operation: u32,
    pos argument: usize,
) -> (bray.runtime.bootstrap.activation.Progress, u32)
    requires(
        trusted bray.runtime.bootstrap.activation.run.selected(cursor = &cursor),
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        operation < 4 || (operation == 4 && trusted completion_destination(
            pointer = cursor.pointer,
            address = argument
        )),
        operation != 3 || argument < 7,
    )
    ensures(
        trusted bray.runtime.bootstrap.activation.run.selected(cursor = &cursor),
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted bray.runtime.bootstrap.native_report_callbacks(report = &result.0.report),
    )
{
    let (progress, _, _, status, _) = trusted invoke(cursor, callback, ready, operation, argument);

    return (progress, status);
}

// The native caller retains these distinct writable slots independently of the
// dispatched frame and every provider callback, including consuming retirement.
trusted internal predicate destinations(
    pointer: DataPointer<bray.runtime.bootstrap.activation.Header>,
    output: DataPointer<bray.runtime.bootstrap.activation.Progress>,
    records: DataPointer<bray.runtime.bootstrap.ReportRecords>,
    incidents: DataPointer<bray.runtime.bootstrap.ReportRecords>,
);

@abi(c)
trusted internal func execute(
    pos pointer: DataPointer<bray.runtime.bootstrap.activation.Header>,
    pos callback: FunctionPointer<bray.runtime.bootstrap.activation.callback.Invoke>,
    pos ready: FunctionPointer<bray.runtime.bootstrap.activation.callback.Ready>,
    pos operation: u32,
    pos argument: usize,
    pos output: DataPointer<bray.runtime.bootstrap.activation.Progress>,
    pos records: DataPointer<bray.runtime.bootstrap.ReportRecords>,
    pos incidents: DataPointer<bray.runtime.bootstrap.ReportRecords>,
) -> u32
    requires(
        trusted owned(pointer = pointer),
        (operation < 4 || (operation == 4 && trusted completion_destination(pointer = pointer, address = argument)) ||
            (operation == 5 && trusted retiring(pointer = pointer) && trusted observed(pointer = pointer))),
        trusted core.memory.callable_address_valid<bray.runtime.bootstrap.activation.callback.Invoke>(
            pointer = callback
        ),
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted core.memory.callable_address_valid<bray.runtime.bootstrap.activation.callback.Ready>(pointer = ready),
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted destinations(pointer = pointer, output = output, records = records, incidents = incidents),
    )
    uses(intrinsic, layout_reinterpret, raw_memory, unchecked_init)
{
    let selected = trusted std.memory.callable_from_pointer<bray.runtime.bootstrap.activation.callback.Invoke>(
        callback
    );

    let admission = trusted std.memory.callable_from_pointer<bray.runtime.bootstrap.activation.callback.Ready>(ready);

    if operation >= 6 || (operation == 3 && argument >= 7)
    {
        return 3;
    }

    let dispatch = trusted lambda(
        pos pointer: DataPointer<bray.runtime.bootstrap.activation.Header>,
        pos callback: bray.runtime.bootstrap.activation.callback.Invoke,
        pos ready: bray.runtime.bootstrap.activation.callback.Ready,
        pos operation: u32,
        pos argument: usize,
        pos output: DataPointer<bray.runtime.bootstrap.activation.Progress>,
        pos records: DataPointer<bray.runtime.bootstrap.ReportRecords>,
        pos incidents: DataPointer<bray.runtime.bootstrap.ReportRecords>,
    ) -> (
        bray.runtime.bootstrap.activation.Progress,
        bray.runtime.bootstrap.ReportRecords,
        bray.runtime.bootstrap.ReportRecords,
        u32,
        bray.runtime.bootstrap.activation.Progress
    )
        requires(
            trusted owned(pointer = pointer),
            (operation < 4 || (operation == 4 && trusted completion_destination(
                pointer = pointer,
                address = argument
            )) || (operation == 5 && trusted retiring(pointer = pointer) && trusted observed(pointer = pointer))),
            trusted bray.runtime.bootstrap.entry.native_entry(),
            trusted bray.runtime.bootstrap.pool.protocol_access(),
            trusted destinations(pointer = pointer, output = output, records = records, incidents = incidents),
            operation < 6,
            operation != 3 || argument < 7,
        )
        ensures(
            trusted core.memory.valid_write<bray.runtime.bootstrap.activation.Progress>(pointer = output, count = 1),
            trusted core.memory.aligned_for<bray.runtime.bootstrap.activation.Progress>(pointer = output),
            trusted core.memory.valid_write<bray.runtime.bootstrap.ReportRecords>(pointer = records, count = 1),
            trusted core.memory.aligned_for<bray.runtime.bootstrap.ReportRecords>(pointer = records),
            trusted core.memory.valid_write<bray.runtime.bootstrap.ReportRecords>(pointer = incidents, count = 1),
            trusted core.memory.aligned_for<bray.runtime.bootstrap.ReportRecords>(pointer = incidents),
        )
    {
        let acquire = trusted lambda(
            pos pointer: DataPointer<bray.runtime.bootstrap.activation.Header>,
            pos operation: u32,
            pos argument: usize,
        ) -> bray.runtime.bootstrap.activation.run.Cursor
            requires(
                trusted owned(pointer = pointer),
                operation < 4 || (operation == 4 && trusted completion_destination(
                    pointer = pointer,
                    address = argument
                )) || (operation == 5 && trusted retiring(pointer = pointer) && trusted observed(pointer = pointer)),
            )
            ensures(
                trusted bray.runtime.bootstrap.activation.run.selected(cursor = &result),
                operation < 4 || (operation == 4 && trusted completion_destination(
                    pointer = result.pointer,
                    address = argument
                )) || (operation == 5 && trusted retiring(pointer = result.pointer)),
            )
            executes(pure, total)
        {
            return
            {
                root = pointer,
                pointer = pointer
            };
        };

        let mut cursor = trusted acquire(pointer, operation, argument);

        return trusted invoke(&mut cursor, callback, ready, operation, argument);
    };

    let (progress, remaining, retired, status, consumed) = trusted dispatch(
        pointer,
        selected,
        admission,
        operation,
        argument,
        output,
        records,
        incidents
    );

    if status != bray.runtime.bootstrap.STATUS_SUCCESS
    {
        return status;
    }

    // Native root retirement follows observation, which already took its outcome.
    if consumed.kind != 0
    {
        trusted core.target.abort();
    }

    trusted std.memory.write<bray.runtime.bootstrap.activation.Progress>(output, progress);
    trusted std.memory.write<bray.runtime.bootstrap.ReportRecords>(records, remaining);
    trusted std.memory.write<bray.runtime.bootstrap.ReportRecords>(incidents, retired);

    return bray.runtime.bootstrap.STATUS_SUCCESS;
}
