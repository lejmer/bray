@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.activation.execution;

using std.memory;

// The native dispatcher exclusively owns this exact admitted header. Retaining
// callbacks may attach a child but cannot dispatch or retire the executing frame.
// Retirement transfers the final records out before releasing frame storage.
// Callback provider code remains live through every call.
trusted internal predicate owned(pointer: RawPointer<bray.runtime.bootstrap.activation.Header>);

// The caller owns a distinct admitted result destination with the exact size and
// alignment described by this frame. Transferred dependencies remain retained by
// that destination. The mover either transfers once or leaves its input owned by
// the frame when reporting failure. It never suspends or exposes a partial result.
trusted internal predicate completion_destination(
    pointer: RawPointer<bray.runtime.bootstrap.activation.Header>,
    address: usize,
);

// Resume, cancellation, broadcast and resolution retain their frame. Retirement
// consumes an already committed, detached frame and never accesses it afterward.
trusted internal func invoke(
    pos pointer: RawPointer<bray.runtime.bootstrap.activation.Header>,
    pos callback: bray.runtime.bootstrap.activation.callback.Invoke,
    pos ready: bray.runtime.bootstrap.activation.callback.Ready,
    pos operation: u32,
    pos argument: usize,
) -> (bray.runtime.bootstrap.activation.Progress, bray.runtime.bootstrap.ReportRecords, u32)
    requires(
        trusted owned(pointer = pointer),
        trusted bray.runtime.bootstrap.entry.native_entry(),
        operation < 6,
        operation != 4 || trusted completion_destination(pointer = pointer, address = argument),
        operation != 3 || argument < 4,
    )
    ensures(trusted bray.runtime.bootstrap.native_report_callbacks(report = &result.0.report))
    ensures(result.2 == 0 || trusted owned(pointer = pointer))
    when(operation < 5)
    {
        ensures(trusted owned(pointer = pointer))
    }
    uses(intrinsic, raw_memory)
{

    let mut header = trusted read(pointer);

    if operation == 5 && (header.phase != bray.runtime.bootstrap.activation.COMMITTED || header.parent != 0 ||
        header.child != 0 || header.incidents.count != 0)
    {
        trusted core.target.abort();
    }

    if operation == 4 && (header.phase != bray.runtime.bootstrap.activation.TERMINAL || header.progress.kind != 1 ||
        header.child != 0)
    {
        trusted core.target.abort();
    }

    let execution: bray.runtime.bootstrap.activation.requirements.Execution =
        match consume trusted bray.runtime.bootstrap.activation.requirements.active(
        pointer,
        header.state,
        operation,
        argument
    )
    {
        case ?execution { yield execution; }
        case none { yield trusted core.target.abort(); }
    };

    let admit = trusted lambda(
        pos pointer: RawPointer<bray.runtime.bootstrap.activation.Header>,
        pos ready: bray.runtime.bootstrap.activation.callback.Ready,
        pos execution: &bray.runtime.bootstrap.activation.requirements.Execution,
    ) -> u32
        requires(trusted owned(pointer = pointer), trusted bray.runtime.bootstrap.entry.native_entry())
        ensures(trusted owned(pointer = pointer))
    {
        return trusted ready(
            std.memory.address_of<bray.runtime.bootstrap.activation.requirements.Execution>(execution)
        );
    };

    let status = trusted admit(pointer, ready, &execution);

    if status != bray.runtime.bootstrap.STATUS_SUCCESS
    {
        let progress: bray.runtime.bootstrap.activation.Progress =
        {
            kind = 5,
            state = header.state,
            payload = 0,
            report = bray.runtime.bootstrap.empty_panic_report(),
        };

        return (progress, bray.runtime.bootstrap.empty_records(), status);
    }

    let selected_execution = std.memory.address_of<bray.runtime.bootstrap.activation.requirements.Execution>(
        &execution
    );

    let descriptor = header.descriptor;
    let context = header.context;
    let mut records = header.outgoing;

    header.outgoing = bray.runtime.bootstrap.empty_records();
    trusted restore(pointer, header);

    let describe = trusted lambda(
        pos pointer: RawPointer<bray.runtime.bootstrap.activation.Header>,
        pos descriptor: RawPointer<bray.runtime.bootstrap.activation.Descriptor>,
    )
        requires(trusted owned(pointer = pointer))
        ensures(
            trusted core.memory.valid_read<bray.runtime.bootstrap.activation.Descriptor>(
                pointer = descriptor,
                count = 1
            ),
            trusted core.memory.initialized_as<bray.runtime.bootstrap.activation.Descriptor>(pointer = descriptor),
            trusted core.memory.aligned_for<bray.runtime.bootstrap.activation.Descriptor>(pointer = descriptor),
        )
        executes(pure, total) {};

    trusted describe(pointer, descriptor);

    let mut outcome: bray.runtime.bootstrap.activation.Progress =
    {
        kind = 4,
        state = 0,
        payload = 0,
        report = bray.runtime.bootstrap.empty_panic_report(),
    };

    let output = std.memory.address_of_mut<bray.runtime.bootstrap.activation.Progress>(&mut outcome);
    let available = std.memory.address_of_mut<bray.runtime.bootstrap.ReportRecords>(&mut records);

    // Only these local calls issue invocation authority. Both slots belong to
    // this entry, and descriptor/context come from its exclusively owned header.
    let authorize = trusted lambda(
        pos pointer: RawPointer<bray.runtime.bootstrap.activation.Header>,
        pos execution: RawPointer<bray.runtime.bootstrap.activation.requirements.Execution>,
        pos descriptor: RawPointer<bray.runtime.bootstrap.activation.Descriptor>,
        pos context: usize,
        pos operation: u32,
        pos argument: usize,
        pos progress: RawPointer<bray.runtime.bootstrap.activation.Progress>,
        pos records: RawPointer<bray.runtime.bootstrap.ReportRecords>,
    )
        requires(trusted owned(pointer = pointer))
        ensures(
            trusted bray.runtime.bootstrap.activation.callback.authorized(
                execution = execution,
                descriptor = descriptor,
                context = context,
                operation = operation,
                argument = argument,
                progress = progress,
                records = records,
            )
        )
        executes(pure, total) {};

    if operation < 5
    {
        let call = trusted lambda(
            pos pointer: RawPointer<bray.runtime.bootstrap.activation.Header>,
            pos callback: bray.runtime.bootstrap.activation.callback.Invoke,
            pos execution: RawPointer<bray.runtime.bootstrap.activation.requirements.Execution>,
            pos descriptor: RawPointer<bray.runtime.bootstrap.activation.Descriptor>,
            pos context: usize,
            pos operation: u32,
            pos argument: usize,
            pos progress: RawPointer<bray.runtime.bootstrap.activation.Progress>,
            pos records: RawPointer<bray.runtime.bootstrap.ReportRecords>,
        ) -> (bray.runtime.bootstrap.activation.Progress, bray.runtime.bootstrap.ReportRecords)
            requires(
                trusted owned(pointer = pointer),
                trusted bray.runtime.bootstrap.entry.native_entry(),
                trusted bray.runtime.bootstrap.activation.callback.authorized(
                    execution = execution,
                    descriptor = descriptor,
                    context = context,
                    operation = operation,
                    argument = argument,
                    progress = progress,
                    records = records,
                ),
                operation < 5,
            )
            ensures(
                trusted owned(pointer = pointer),
                trusted bray.runtime.bootstrap.native_report_callbacks(report = &result.0.report),
            )
        {
            return trusted bray.runtime.bootstrap.activation.callback.invoke(
                callback,
                execution,
                descriptor,
                context,
                operation,
                argument,
                progress,
                records
            );
        };

        // Select the retaining contract before entry. The complete header is
        // resident during reentry, and a fresh read preserves callback changes.
        trusted authorize(pointer, selected_execution, descriptor, context, operation, argument, output, available);

        let (progress, remaining) = trusted call(
            pointer,
            callback,
            selected_execution,
            descriptor,
            context,
            operation,
            argument,
            output,
            available
        );

        let mut updated = trusted read(pointer);

        if operation == 4
        {
            if progress.kind == 1
            {
                updated.phase = bray.runtime.bootstrap.activation.COMMITTED;
            }
            else if progress.kind != 3
            {
                trusted core.target.abort();
            }
        }

        updated.outgoing = remaining;
        trusted restore(pointer, updated);
        return (progress, bray.runtime.bootstrap.empty_records(), bray.runtime.bootstrap.STATUS_SUCCESS);
    }

    // A native provider may coallocate its immutable descriptor with the frame.
    // Retain a stack copy for the callback's full borrow, including after release.
    let description = trusted std.memory.read<bray.runtime.bootstrap.activation.Descriptor>(descriptor);

    let retained = std.memory.address_of<bray.runtime.bootstrap.activation.Descriptor>(&description);

    // Destruction may release the header. Remaining records leave through the
    // caller's destination, and nothing reads or writes the header after entry.
    trusted authorize(pointer, selected_execution, retained, context, 5, argument, output, available);

    let (progress, remaining) = trusted bray.runtime.bootstrap.activation.callback.invoke(
        callback,
        selected_execution,
        retained,
        context,
        5,
        argument,
        output,
        available
    );

    return (progress, remaining, bray.runtime.bootstrap.STATUS_SUCCESS);
}

// The native caller retains these distinct writable slots independently of the
// dispatched frame and every provider callback, including consuming retirement.
trusted internal predicate destinations(
    pointer: RawPointer<bray.runtime.bootstrap.activation.Header>,
    output: RawPointer<bray.runtime.bootstrap.activation.Progress>,
    records: RawPointer<bray.runtime.bootstrap.ReportRecords>,
);

@abi(c)
trusted internal func execute(
    pos pointer: RawPointer<bray.runtime.bootstrap.activation.Header>,
    pos callback: RawPointer<bray.runtime.bootstrap.activation.callback.Invoke>,
    pos ready: RawPointer<bray.runtime.bootstrap.activation.callback.Ready>,
    pos operation: u32,
    pos argument: usize,
    pos output: RawPointer<bray.runtime.bootstrap.activation.Progress>,
    pos records: RawPointer<bray.runtime.bootstrap.ReportRecords>,
) -> u32
    requires(
        trusted owned(pointer = pointer),
        trusted core.memory.callable_address_valid<bray.runtime.bootstrap.activation.callback.Invoke>(
            pointer = callback
        ),
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted core.memory.callable_address_valid<bray.runtime.bootstrap.activation.callback.Ready>(pointer = ready),
        trusted destinations(pointer = pointer, output = output, records = records),
        operation != 4 || trusted completion_destination(pointer = pointer, address = argument),
    )
    uses(layout_reinterpret, raw_memory, unchecked_init)
{
    if operation >= 6 || (operation == 3 && argument >= 4)
    {
        return 3;
    }

    let selected = trusted std.memory.callable_from_pointer<bray.runtime.bootstrap.activation.callback.Invoke>(
        callback
    );

    let admission = trusted std.memory.callable_from_pointer<bray.runtime.bootstrap.activation.callback.Ready>(ready);

    let dispatch = trusted lambda(
        pos pointer: RawPointer<bray.runtime.bootstrap.activation.Header>,
        pos callback: bray.runtime.bootstrap.activation.callback.Invoke,
        pos ready: bray.runtime.bootstrap.activation.callback.Ready,
        pos operation: u32,
        pos argument: usize,
        pos output: RawPointer<bray.runtime.bootstrap.activation.Progress>,
        pos records: RawPointer<bray.runtime.bootstrap.ReportRecords>,
    ) -> (bray.runtime.bootstrap.activation.Progress, bray.runtime.bootstrap.ReportRecords, u32)
        requires(
            trusted owned(pointer = pointer),
            trusted bray.runtime.bootstrap.entry.native_entry(),
            trusted destinations(pointer = pointer, output = output, records = records),
            operation < 6,
            operation != 4 || trusted completion_destination(pointer = pointer, address = argument),
            operation != 3 || argument < 4,
        )
        ensures(
            trusted core.memory.valid_write<bray.runtime.bootstrap.activation.Progress>(pointer = output, count = 1),
            trusted core.memory.aligned_for<bray.runtime.bootstrap.activation.Progress>(pointer = output),
            trusted core.memory.valid_write<bray.runtime.bootstrap.ReportRecords>(pointer = records, count = 1),
            trusted core.memory.aligned_for<bray.runtime.bootstrap.ReportRecords>(pointer = records),
        )
    {
        return trusted invoke(pointer, callback, ready, operation, argument);
    };

    let (progress, remaining, status) = trusted dispatch(
        pointer,
        selected,
        admission,
        operation,
        argument,
        output,
        records
    );

    if status != bray.runtime.bootstrap.STATUS_SUCCESS
    {
        return status;
    }

    trusted std.memory.write<bray.runtime.bootstrap.activation.Progress>(output, progress);
    trusted std.memory.write<bray.runtime.bootstrap.ReportRecords>(records, remaining);

    return bray.runtime.bootstrap.STATUS_SUCCESS;
}
