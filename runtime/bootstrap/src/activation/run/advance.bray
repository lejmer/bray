@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.activation.run;

using std.memory;

// A retaining producer may attach a child, but the native dispatch claim keeps
// every pre-existing member and the root alive. Read the header again afterward
// so composition performed by that producer is part of the committed transition.
trusted internal func advance(
    pos cursor: &mut Cursor,
    pos callback: bray.runtime.bootstrap.activation.callback.Invoke,
    pos ready: bray.runtime.bootstrap.activation.callback.Ready,
    pos operation: u32,
    pos argument: usize,
) -> (u32, u32, usize, u32)
    requires(
        trusted selected(cursor = &cursor),
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        operation < 4,
        operation != 3 || argument < 4,
    )
    ensures(
        trusted selected(cursor = &cursor),
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted bray.runtime.bootstrap.pool.protocol_access(),
    )
{
    let retaining = trusted lambda(
        pos cursor: &mut Cursor,
        pos callback: bray.runtime.bootstrap.activation.callback.Invoke,
        pos ready: bray.runtime.bootstrap.activation.callback.Ready,
        pos operation: u32,
        pos argument: usize,
    ) -> (bray.runtime.bootstrap.activation.Progress, u32)
        requires(
            trusted selected(cursor = &cursor),
            trusted bray.runtime.bootstrap.entry.native_entry(),
            trusted bray.runtime.bootstrap.pool.protocol_access(),
            operation < 4,
            operation != 3 || argument < 4,
        )
        ensures(
            trusted selected(cursor = &cursor),
            trusted bray.runtime.bootstrap.entry.native_entry(),
            trusted bray.runtime.bootstrap.pool.protocol_access(),
            trusted bray.runtime.bootstrap.native_report_callbacks(report = &result.0.report),
        )
    {
        let (progress, _, _, status, _) = trusted bray.runtime.bootstrap.activation.execution.invoke(
            cursor,
            callback,
            ready,
            operation,
            argument
        );

        return (progress, status);
    };

    let (progress, status) = trusted retaining(cursor, callback, ready, operation, argument);

    if status != bray.runtime.bootstrap.STATUS_SUCCESS
    {
        return (progress.kind, progress.state, progress.payload, status);
    }

    let header = trusted bray.runtime.bootstrap.activation.execution.access(cursor);
    let kind = progress.kind;
    let state = progress.state;
    let payload = progress.payload;

    trusted bray.runtime.bootstrap.activation.execution.accept_progress(header, operation, progress);

    // Only scheduling scalars leave this transition. The header owns its report.
    return (kind, state, payload, status);
}
