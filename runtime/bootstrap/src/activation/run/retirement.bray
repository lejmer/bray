@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.activation.run;

using core.target;
using internal bray.runtime.bootstrap;
using std.memory;

trusted internal func retire(
    pos mut cursor: Cursor,
    pos callback: bray.runtime.bootstrap.activation.callback.Invoke,
    pos ready: bray.runtime.bootstrap.activation.callback.Ready,
) -> (bray.runtime.bootstrap.ReportRecords, bray.runtime.bootstrap.ReportRecords, u32)
    requires(
        trusted selected(cursor = &cursor),
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted bray.runtime.bootstrap.pool.protocol_access(),
    )
{
    let before = trusted bray.runtime.bootstrap.activation.execution.read(&mut cursor);

    let consuming = trusted lambda(
        pos mut cursor: Cursor,
        pos callback: bray.runtime.bootstrap.activation.callback.Invoke,
        pos ready: bray.runtime.bootstrap.activation.callback.Ready,
    ) -> (
        Cursor,
        bray.runtime.bootstrap.activation.Progress,
        bray.runtime.bootstrap.ReportRecords,
        bray.runtime.bootstrap.ReportRecords,
        u32,
        bray.runtime.bootstrap.activation.Progress
    )
        requires(
            trusted selected(cursor = &cursor),
            trusted bray.runtime.bootstrap.entry.native_entry(),
            trusted bray.runtime.bootstrap.pool.protocol_access()
        )
        ensures(
            trusted selected(cursor = &result.0),
            trusted bray.runtime.bootstrap.pool.protocol_access(),
            trusted bray.runtime.bootstrap.native_report_callbacks(report = &result.1.report),
            trusted bray.runtime.bootstrap.native_report_callbacks(report = &result.5.report),
        )
        uses(intrinsic)
    {
        let header = trusted bray.runtime.bootstrap.activation.execution.read(&mut cursor);

        if header.parent == 0
        {
            trusted core.target.abort();
        }

        if header.disposition == 2
        {
            if header.phase != bray.runtime.bootstrap.activation.COMMITTED || header.child != 0
            {
                trusted core.target.abort();
            }

            let (incidents, outcome) = trusted bray.runtime.bootstrap.activation.execution.take_terminal(&mut cursor);

            {
                let retained = trusted bray.runtime.bootstrap.activation.execution.access(&mut cursor);

                retained.phase = bray.runtime.bootstrap.activation.RETAINED;
                retained.parent = 0;
                retained.current = 0;
                retained.retained_affinity = 0;
                retained.retained_lanes = 0;
                retained.retained_origin = 0;
            }

            {
                let mut guard = trusted bray.runtime.bootstrap.pool.lock();

                trusted bray.runtime.bootstrap.storage.retain_frame(guard.get(), &header.lease, header.descriptor);
            }

            // The original future keeps this lease and its unused action records.
            // Only its terminal outcome leaves the child. The same run owns the parent.
            cursor.pointer = trusted core.target.from_exposed_address<bray.runtime.bootstrap.activation.Header>(
                address = header.parent
            );

            return (
                cursor,
                bray.runtime.bootstrap.activation.empty_progress(),
                bray.runtime.bootstrap.empty_records(),
                incidents,
                bray.runtime.bootstrap.STATUS_SUCCESS,
                outcome
            );
        }

        let permit = trusted lambda(pos cursor: &mut Cursor)
            requires(trusted selected(cursor = &cursor))
            ensures(
                trusted selected(cursor = &cursor),
                trusted bray.runtime.bootstrap.activation.execution.retiring(pointer = cursor.pointer)
            )
            executes(pure, total) {};

        trusted permit(&mut cursor);

        // Admission precedes all mutation. On deferral, both headers and their links
        // remain intact. On success, only the retained parent may be accessed again.
        let (progress, remaining, incidents, status, outcome) =
            trusted bray.runtime.bootstrap.activation.execution.invoke(&mut cursor, callback, ready, 5, 0);

        if status == bray.runtime.bootstrap.STATUS_SUCCESS
        {
            cursor.pointer = trusted core.target.from_exposed_address<bray.runtime.bootstrap.activation.Header>(
                address = header.parent
            );
        }

        return (cursor, progress, remaining, incidents, status, outcome);
    };

    let (ancestor, progress, remaining, mut incidents, status, outcome) = trusted consuming(cursor, callback, ready);

    if status != bray.runtime.bootstrap.STATUS_SUCCESS
    {
        return (incidents, remaining, status);
    }

    let retain = trusted lambda(
        pos incidents: &mut bray.runtime.bootstrap.ReportRecords,
        pos mut first: bray.runtime.bootstrap.activation.Progress,
        pos second: bray.runtime.bootstrap.activation.Progress,
    ) -> bray.runtime.bootstrap.activation.Progress
        requires(
            trusted bray.runtime.bootstrap.pool.protocol_access(),
            trusted bray.runtime.bootstrap.native_report_callbacks(report = &first.report),
            trusted bray.runtime.bootstrap.native_report_callbacks(report = &second.report),
        )
        ensures(trusted bray.runtime.bootstrap.native_report_callbacks(report = &result.report))
    {
        // The second report owns its provider independently. Disposing the first
        // record's previous primary cannot consume this retained report owner.
        trusted bray.runtime.bootstrap.activation.execution.retain_incident(
            incidents,
            trusted bray.runtime.bootstrap.activation.execution.take_report(&mut first)
        );

        return second;
    };

    let (retained, discarded) = trusted deliver(ancestor, before.disposition, progress, outcome);

    // All header access has ended before report disposal can invoke native code.
    let mut incident = trusted retain(&mut incidents, discarded, retained);

    trusted bray.runtime.bootstrap.activation.execution.retain_incident(
        &mut incidents,
        trusted bray.runtime.bootstrap.activation.execution.take_report(&mut incident)
    );

    return (incidents, remaining, status);
}

trusted internal func deliver(
    pos mut cursor: Cursor,
    pos disposition: u32,
    pos progress: bray.runtime.bootstrap.activation.Progress,
    pos incoming: bray.runtime.bootstrap.activation.Progress,
) -> (bray.runtime.bootstrap.activation.Progress, bray.runtime.bootstrap.activation.Progress)
    requires(
        trusted selected(cursor = &cursor),
        trusted bray.runtime.bootstrap.native_report_callbacks(report = &progress.report),
        trusted bray.runtime.bootstrap.native_report_callbacks(report = &incoming.report),
    )
    ensures(
        trusted bray.runtime.bootstrap.native_report_callbacks(report = &result.0.report),
        trusted bray.runtime.bootstrap.native_report_callbacks(report = &result.1.report),
    )
    uses(intrinsic)
{
    trusted select(&mut cursor);

    let parent = trusted bray.runtime.bootstrap.activation.execution.access(&mut cursor);

    parent.child = 0;

    if parent.incoming.kind != 0
    {
        trusted core.target.abort();
    }

    // The returned reports are independent owners removed from the retired child.
    // Only the retained parent's empty delivery slot changes, without callbacks.
    if disposition != 0
    {
        if parent.phase == bray.runtime.bootstrap.activation.CLEANUP
        {
            return (progress, incoming);
        }

        // Abandonment has no result to install. Retain its non-panic reports in
        // the run's incident chain before delivering the expected cancellation.
        // A panic still transfers its report to the continuing parent's handler.
        if incoming.kind == 1 || incoming.kind == 2
        {
            parent.incoming =
            {
                kind = 2,
                state = 0,
                payload = 0,
                report = bray.runtime.bootstrap.empty_panic_report()
            };

            return (progress, incoming);
        }
    }

    parent.incoming = incoming;

    return (progress, bray.runtime.bootstrap.activation.empty_progress());
}
