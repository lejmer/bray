@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.activation.run;

using internal bray.runtime.bootstrap;
using std.memory;

// Only unresolved value ownership changes to abandonment. A committed child has
// already initialized its parent's slot, so its outcome must still be consumed
// there before the cancellation checkpoint. Resolve that parent continuation with
// cancellation rather than silently discarding the transferred initialization.
trusted internal func abandon(pos cursor: &mut Cursor) -> usize
    requires(trusted selected(cursor = &cursor))
    ensures(trusted selected(cursor = &cursor))
{
    let header = trusted bray.runtime.bootstrap.activation.execution.access(cursor);

    return trusted bray.runtime.bootstrap.activation.abandon(header);
}

trusted internal func broadcast(
    pos cursor: &mut Cursor,
    pos callback: bray.runtime.bootstrap.activation.callback.Invoke,
    pos ready: bray.runtime.bootstrap.activation.callback.Ready,
) -> (
        bray.runtime.bootstrap.activation.Progress,
        bray.runtime.bootstrap.ReportRecords,
        bray.runtime.bootstrap.ReportRecords,
        u32
    )
    requires(
        trusted selected(cursor = &cursor),
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted bray.runtime.bootstrap.pool.protocol_access(),
    )
    ensures(trusted selected(cursor = &cursor))
{
    let header = trusted bray.runtime.bootstrap.activation.execution.read(cursor);

    if bray.runtime.bootstrap.activation.execution.broadcast_pending(&header)
    {
        let (_, _, _, status) = trusted advance(cursor, callback, ready, 2, 0);

        if status != 0
        {
            let progress: bray.runtime.bootstrap.activation.Progress =
            {
                kind = 5,
                state = header.state,
                payload = status as usize,
                report = bray.runtime.bootstrap.empty_panic_report()
            };

            return (progress, bray.runtime.bootstrap.empty_records(), bray.runtime.bootstrap.empty_records(), DEFERRED);
        }
    }

    let updated = trusted bray.runtime.bootstrap.activation.execution.read(cursor);

    if updated.child != 0
    {
        trusted descend(cursor);

        if updated.disposition != 0 || updated.phase == bray.runtime.bootstrap.activation.CLEANUP
        {
            trusted abandon(cursor);
        }
    }
    else
    {
        let root = trusted bray.runtime.bootstrap.activation.execution.root(cursor);

        root.broadcast_next = 0;
    }

    return (
        bray.runtime.bootstrap.activation.empty_progress(),
        bray.runtime.bootstrap.empty_records(),
        bray.runtime.bootstrap.empty_records(),
        CONTINUE
    );
}
