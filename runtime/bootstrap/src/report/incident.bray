@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.report.incident;

using std.memory;
using internal bray.runtime.bootstrap;

@copy
@layout(c)
internal struct Source
{
    present: u32;
    identity: u32;
    start: u32;
    end: u32;
    version: u64;
    namespace: [u64; 4];
}

@layout(c)
internal struct Record
{
    payload: usize;
    type_identity: bytes<32>;
    source: Source;
    report: Reporter;
    destroy: Destroyer;
    backing: bray.runtime.bootstrap.storage.Lease;
}

// The compiler-bound caller transfers the exclusive descriptor and retains its
// concrete payload, backing, provider and attachment until this call returns.
// Its C callbacks contain failures in initialized outcomes, never native unwind.
trusted internal predicate owned(pointer: RawPointer<Record>);

trusted internal predicate returned(pointer: RawPointer<bray.runtime.bootstrap.ReportOutcome>);

internal callable Reporter = @abi(c) trusted func(
    pos payload: usize,
    pos outcome: RawPointer<bray.runtime.bootstrap.ReportOutcome>
) -> u32
    requires(
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted core.memory.valid_write<bray.runtime.bootstrap.ReportOutcome>(pointer = outcome, count = 1),
        trusted core.memory.aligned_for<bray.runtime.bootstrap.ReportOutcome>(pointer = outcome)
    )
    ensures(trusted returned(pointer = outcome));

internal callable Destroyer = @abi(c) trusted func(
    pos incident: RawPointer<Record>,
    pos destruction: RawPointer<bray.runtime.bootstrap.ReportOutcome>,
    pos release: RawPointer<bray.runtime.bootstrap.ReportOutcome>
)
    requires(
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted core.memory.valid_write<Record>(pointer = incident, count = 1),
        trusted core.memory.aligned_for<Record>(pointer = incident),
        trusted core.memory.valid_read<Record>(pointer = incident, count = 1),
        trusted core.memory.initialized_as<Record>(pointer = incident),
        trusted core.memory.valid_write<bray.runtime.bootstrap.ReportOutcome>(pointer = destruction, count = 1),
        trusted core.memory.aligned_for<bray.runtime.bootstrap.ReportOutcome>(pointer = destruction),
        trusted core.memory.valid_write<bray.runtime.bootstrap.ReportOutcome>(pointer = release, count = 1),
        trusted core.memory.aligned_for<bray.runtime.bootstrap.ReportOutcome>(pointer = release),
        trusted core.memory.non_overlapping<bray.runtime.bootstrap.ReportOutcome>(
            left = destruction,
            left_count = 1,
            right = release,
            right_count = 1
        )
    )
    ensures(
        trusted returned(pointer = destruction),
        trusted returned(pointer = release),
        trusted core.memory.non_overlapping<bray.runtime.bootstrap.ReportOutcome>(
            left = destruction,
            left_count = 1,
            right = release,
            right_count = 1
        )
    );

internal struct StoredOutcome
{
    state: u32;
    primary: bray.runtime.bootstrap.StoredReportPrimary;
    remaining: bray.runtime.bootstrap.ReportRecords;
    reserved: usize;
}

trusted internal func parts(
    pos pointer: RawPointer<bray.runtime.bootstrap.ReportOutcome>
) -> (u32, bray.runtime.bootstrap.PanicReportData)
    requires(trusted returned(pointer = pointer))
    ensures(trusted bray.runtime.bootstrap.native_report_callbacks(report = &result.1))
    uses(raw_memory)
{
    let readable = trusted lambda(pos pointer: RawPointer<bray.runtime.bootstrap.ReportOutcome>) -> RawPointer<
        bray.runtime.bootstrap.ReportOutcome
    >
        requires(trusted returned(pointer = pointer))
        ensures(
            trusted core.memory.valid_read<bray.runtime.bootstrap.ReportOutcome>(pointer = result, count = 1),
            trusted core.memory.aligned_for<bray.runtime.bootstrap.ReportOutcome>(pointer = result),
            trusted core.memory.initialized_as<bray.runtime.bootstrap.ReportOutcome>(pointer = result)
        )
        executes(pure, total)
    {
        return pointer;
    };

    let value = trusted std.memory.read<bray.runtime.bootstrap.ReportOutcome>(trusted readable(pointer));

    return (value.state, value.report);
}

trusted internal func prepare(pos pointer: RawPointer<bray.runtime.bootstrap.ReportOutcome>) -> StoredOutcome
    requires(trusted returned(pointer = pointer))
{
    let (state, report) = trusted parts(pointer);

    return trusted prepare_value(state, report);
}

trusted internal func prepare_value(pos state: u32, pos report: bray.runtime.bootstrap.PanicReportData) -> StoredOutcome
    requires(trusted bray.runtime.bootstrap.native_report_callbacks(report = &report))
{
    let remaining: bray.runtime.bootstrap.ReportRecords =
    {
        head = report.outgoing_head,
        tail = report.outgoing_tail,
        count = report.outgoing_count
    };

    let reserved = report.reserved;

    let primary = trusted bray.runtime.bootstrap.stored_primary(
        trusted bray.runtime.bootstrap.report_primary_value(report)
    );

    return
    {
        state = state,
        primary = primary,
        remaining = remaining,
        reserved = reserved
    };
}

// The other destination is a different live slot. Materialization reads only the
// selected outcome and invokes no callback, so the other transfer remains valid.
trusted internal func prepare_first(
    pos pointer: RawPointer<bray.runtime.bootstrap.ReportOutcome>,
    pos other: RawPointer<bray.runtime.bootstrap.ReportOutcome>
) -> StoredOutcome
    requires(
        trusted returned(pointer = pointer),
        trusted returned(pointer = other),
        trusted core.memory.non_overlapping<bray.runtime.bootstrap.ReportOutcome>(
            left = pointer,
            left_count = 1,
            right = other,
            right_count = 1
        )
    )
    ensures(trusted returned(pointer = other))
{
    return trusted prepare(pointer);
}

trusted internal func retain_outcome(pos value: StoredOutcome) -> (u32, bray.runtime.bootstrap.ReportRecords)
    requires(trusted bray.runtime.bootstrap.pool.protocol_access())
    uses(intrinsic)
{
    if value.state != bray.runtime.bootstrap.RUN_COMPLETED && value.state != bray.runtime.bootstrap.RUN_PANICKED
    {
        trusted core.target.abort();
    }

    let status = if value.state == bray.runtime.bootstrap.RUN_PANICKED
    {
        yield bray.runtime.bootstrap.STATUS_PANICKED;
    }
    else
    {
        yield bray.runtime.bootstrap.STATUS_SUCCESS;
    };

    return (status, trusted bray.runtime.bootstrap.retain_primary(value.primary, value.remaining, value.reserved));
}

trusted internal func read_record(pos pointer: RawPointer<Record>) -> bray.runtime.bootstrap.ReportValue
    requires(trusted owned(pointer = pointer))
    ensures(trusted bray.runtime.bootstrap.retained_report_value(value = &result))
    uses(raw_memory)
{
    let readable = trusted lambda(pos pointer: RawPointer<Record>) -> RawPointer<Record>
        requires(trusted owned(pointer = pointer))
        ensures(
            trusted core.memory.valid_read<Record>(pointer = result, count = 1),
            trusted core.memory.aligned_for<Record>(pointer = result),
            trusted core.memory.initialized_as<Record>(pointer = result)
        )
        executes(pure, total)
    {
        return pointer;
    };

    return bray.runtime.bootstrap.ReportValue.Error(trusted std.memory.read<Record>(trusted readable(pointer)));
}

// Two simultaneous exclusive borrows establish distinct live outcome slots.
trusted internal func destinations(
    pos left: &mut bray.runtime.bootstrap.ReportOutcome,
    pos right: &mut bray.runtime.bootstrap.ReportOutcome
) -> (RawPointer<bray.runtime.bootstrap.ReportOutcome>, RawPointer<bray.runtime.bootstrap.ReportOutcome>)
    ensures(
        trusted core.memory.valid_write<bray.runtime.bootstrap.ReportOutcome>(pointer = result.0, count = 1),
        trusted core.memory.aligned_for<bray.runtime.bootstrap.ReportOutcome>(pointer = result.0),
        trusted core.memory.valid_write<bray.runtime.bootstrap.ReportOutcome>(pointer = result.1, count = 1),
        trusted core.memory.aligned_for<bray.runtime.bootstrap.ReportOutcome>(pointer = result.1),
        trusted core.memory.non_overlapping<bray.runtime.bootstrap.ReportOutcome>(
            left = result.0,
            left_count = 1,
            right = result.1,
            right_count = 1
        )
    )
    executes(pure, total)
{
    return (
        std.memory.address_of_mut<bray.runtime.bootstrap.ReportOutcome>(left),
        std.memory.address_of_mut<bray.runtime.bootstrap.ReportOutcome>(right)
    );
}

@abi(c)
trusted internal func retain(
    pos pointer: RawPointer<Record>,
    pos mut report: bray.runtime.bootstrap.PanicReportData
) -> bray.runtime.bootstrap.PanicReportData
    requires(
        trusted owned(pointer = pointer),
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted bray.runtime.bootstrap.native_report_callbacks(report = &report)
    )
    ensures(trusted bray.runtime.bootstrap.native_report_callbacks(report = &result))
{
    let value = trusted read_record(pointer);

    let mut records: bray.runtime.bootstrap.ReportRecords =
    {
        head = report.outgoing_head,
        tail = report.outgoing_tail,
        count = report.outgoing_count
    };

    let mut guard = trusted bray.runtime.bootstrap.pool.lock();
    let pool = guard.get();
    let handle = trusted bray.runtime.bootstrap.activate_record(pool);
    let entry = trusted bray.runtime.bootstrap.record(pool, handle);

    entry.value = value;
    trusted bray.runtime.bootstrap.append_record(pool, &mut records, handle);
    report.outgoing_head = records.head;
    report.outgoing_tail = records.tail;
    report.outgoing_count = records.count;

    if report.consumer == 0
    {
        report.consumer = trusted bray.runtime.bootstrap.consume_address();
    }

    return report;
}

@abi(c)
trusted internal func dispose(pos pointer: RawPointer<Record>, pos reporting: u32) -> u32
    requires(trusted owned(pointer = pointer), trusted bray.runtime.bootstrap.pool.protocol_access())
{
    let value = trusted read_record(pointer);

    return trusted bray.runtime.bootstrap.consume_values(value, bray.runtime.bootstrap.empty_records(), reporting);
}

trusted internal func dispose_value(
    pos mut value: bray.runtime.bootstrap.ReportValue,
    pos reporting: u32
) -> (u32, bray.runtime.bootstrap.ReportRecords)
    requires(
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted bray.runtime.bootstrap.retained_report_value(value = &value)
    )
{
    match value
    {
        case Panic(primary) { return trusted bray.runtime.bootstrap.consume_panic(&primary, reporting); }
        case Error(record)
        {
            let report = record.report;
            let destroy = record.destroy;

            let mut formatted: bray.runtime.bootstrap.ReportOutcome =
            {
                state = bray.runtime.bootstrap.RUN_COMPLETED,
                payload = 0,
                report = bray.runtime.bootstrap.empty_panic_report()
            };

            let mut destroyed: bray.runtime.bootstrap.ReportOutcome =
            {
                state = bray.runtime.bootstrap.RUN_COMPLETED,
                payload = 0,
                report = bray.runtime.bootstrap.empty_panic_report()
            };

            let mut released: bray.runtime.bootstrap.ReportOutcome =
            {
                state = bray.runtime.bootstrap.RUN_COMPLETED,
                payload = 0,
                report = bray.runtime.bootstrap.empty_panic_report()
            };

            let mut status: u32 = bray.runtime.bootstrap.STATUS_SUCCESS;

            let formatted_value: StoredOutcome = match reporting
            {
                case 0
                {
                    yield StoredOutcome
                    {
                        state = bray.runtime.bootstrap.RUN_COMPLETED,
                        primary = trusted bray.runtime.bootstrap.stored_primary(bray.runtime.bootstrap.empty_primary()),
                        remaining = bray.runtime.bootstrap.empty_records(),
                        reserved = 0
                    };
                }
                case _
                {
                    status = trusted bray.runtime.bootstrap.report.output.typed(record.source, record.type_identity);

                    let output = std.memory.address_of_mut<bray.runtime.bootstrap.ReportOutcome>(&mut formatted);
                    let found = trusted report(record.payload, output);

                    if status == bray.runtime.bootstrap.STATUS_SUCCESS
                    {
                        status = found;
                    }

                    yield trusted prepare(output);
                }
            };

            let (destruction, release) = trusted destinations(&mut destroyed, &mut released);

            trusted destroy(std.memory.address_of_mut<Record>(&mut record), destruction, release);

            let destroyed_value = trusted prepare_first(destruction, release);
            let released_value = trusted prepare(release);

            // Detach callback outcomes before consuming any newly produced reports.
            let (formatting_status, mut records) = trusted retain_outcome(formatted_value);

            let (destruction_status, mut destruction_records) = trusted retain_outcome(destroyed_value);
            let (release_status, mut release_records) = trusted retain_outcome(released_value);

            trusted bray.runtime.bootstrap.report_records_append(
                std.memory.address_of_mut<bray.runtime.bootstrap.ReportRecords>(&mut records),
                std.memory.address_of_mut<bray.runtime.bootstrap.ReportRecords>(&mut destruction_records)
            );

            trusted bray.runtime.bootstrap.report_records_append(
                std.memory.address_of_mut<bray.runtime.bootstrap.ReportRecords>(&mut records),
                std.memory.address_of_mut<bray.runtime.bootstrap.ReportRecords>(&mut release_records)
            );

            if status != bray.runtime.bootstrap.STATUS_SUCCESS
            {
                return (status, records);
            }

            if formatting_status != bray.runtime.bootstrap.STATUS_SUCCESS
            {
                return (formatting_status, records);
            }

            if destruction_status != bray.runtime.bootstrap.STATUS_SUCCESS
            {
                return (destruction_status, records);
            }

            return (release_status, records);
        }
    };
}
