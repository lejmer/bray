@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap;

using core.target;
using internal bray.runtime.bootstrap.pool;
using internal bray.runtime.bootstrap.report.incident;
using internal bray.runtime.bootstrap.report.output;
using core.memory;
using std.memory;

@layout(c)
internal struct ReportOutcome
{
    mut state: u32;
    mut payload: usize;
    mut report: PanicReportData;
}

// NativePanicMessage stores typed optional C callbacks. The native report producer
// retains their provider until consumption. Source construction uses selected
// callable values, and the pool only accepts headers with that same protocol.
trusted internal predicate native_primary_callbacks(primary: &ReportPrimary);

trusted internal predicate native_report_callbacks(report: &PanicReportData);

trusted internal predicate native_primary_slot_callbacks(pointer: RawPointer<ReportPrimary>);

trusted internal predicate native_report_slot_callbacks(pointer: RawPointer<PanicReportData>);

internal callable ReportConsumer = @abi(c) trusted func(pos pointer: RawPointer<PanicReportData>, pos reporting: u32) ->
    u32
    requires(
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted core.memory.valid_read<PanicReportData>(pointer = pointer, count = 1),
        trusted core.memory.valid_write<PanicReportData>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<PanicReportData>(pointer = pointer),
        trusted core.memory.initialized_as<PanicReportData>(pointer = pointer),
        trusted native_report_slot_callbacks(pointer = pointer),
    );

trusted internal func consume_address() -> usize
    executes(total)
    uses(intrinsic, layout_reinterpret)
{
    let consumer: ReportConsumer = consume_report;

    return trusted core.target.expose_address<ReportConsumer>(
        trusted std.memory.pointer_from_callable<ReportConsumer>(consumer)
    );
}

trusted internal func report_primary_value(pos report: PanicReportData) -> ReportPrimary
    requires(trusted native_report_callbacks(report = &report))
    ensures(trusted native_primary_callbacks(primary = &result))
    executes(pure, total)
{
    return
    {
        source_present = report.source_present,
        source_identity = report.source_identity,
        source_start = report.source_start,
        source_end = report.source_end,
        source_version = report.source_version,
        source_namespace_word_0 = report.source_namespace_word_0,
        source_namespace_word_1 = report.source_namespace_word_1,
        source_namespace_word_2 = report.source_namespace_word_2,
        source_namespace_word_3 = report.source_namespace_word_3,
        cause = report.cause,
        primary_present = report.primary_present,
        message = report.message,
        message_length = report.message_length,
        copy_message = report.copy_message,
        release_message = report.release_message,
    };
}

// The C producer guarantees typed optional callbacks and retains their providers.
// Reading arbitrary initialized bytes cannot establish this protocol.
trusted internal func read_primary(pos pointer: RawPointer<ReportPrimary>) -> ReportPrimary
    requires(
        trusted native_primary_slot_callbacks(pointer = pointer),
        trusted core.memory.valid_write<ReportPrimary>(pointer = pointer, count = 1),
        trusted core.memory.valid_read<ReportPrimary>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<ReportPrimary>(pointer = pointer),
        trusted core.memory.initialized_as<ReportPrimary>(pointer = pointer),
    )
    ensures(
        trusted native_primary_callbacks(primary = &result),
        trusted core.memory.valid_write<ReportPrimary>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<ReportPrimary>(pointer = pointer),
    )
    uses(raw_memory)
{
    return trusted std.memory.read<ReportPrimary>(pointer);
}

trusted internal func primary_callbacks(pos primary: &ReportPrimary) -> (PanicMessageCopy?, PanicMessageRelease?)
    requires(trusted native_primary_callbacks(primary = primary))
{
    let copy = trusted primary_copy(primary);
    let release = trusted primary_release(primary);

    return (copy, release);
}

trusted internal func primary_release(pos primary: &ReportPrimary) -> PanicMessageRelease?
    requires(trusted native_primary_callbacks(primary = primary))
    ensures(trusted native_primary_callbacks(primary = primary))
    uses(layout_reinterpret)
{
    let mut callback: PanicMessageRelease? = none;

    if primary.release_message != 0
    {
        let pointer: RawPointer<PanicMessageRelease> = trusted native_release_address(primary);

        callback = trusted std.memory.callable_from_pointer<PanicMessageRelease>(pointer);
    }

    return callback;
}

trusted internal func primary_copy(pos primary: &ReportPrimary) -> PanicMessageCopy?
    requires(trusted native_primary_callbacks(primary = primary))
    ensures(trusted native_primary_callbacks(primary = primary))
    uses(layout_reinterpret)
{
    let mut callback: PanicMessageCopy? = none;

    if primary.copy_message != 0
    {
        let pointer: RawPointer<PanicMessageCopy> = trusted native_copy_address(primary);

        callback = trusted std.memory.callable_from_pointer<PanicMessageCopy>(pointer);
    }

    return callback;
}

trusted internal func native_copy_address(pos primary: &ReportPrimary) -> RawPointer<PanicMessageCopy>
    requires(trusted native_primary_callbacks(primary = primary), primary.copy_message != 0)
    ensures(trusted core.memory.callable_address_valid<PanicMessageCopy>(pointer = result))
    uses(intrinsic)
{
    return trusted core.target.from_exposed_address<PanicMessageCopy>(address = primary.copy_message);
}

trusted internal func native_release_address(pos primary: &ReportPrimary) -> RawPointer<PanicMessageRelease>
    requires(trusted native_primary_callbacks(primary = primary), primary.release_message != 0)
    ensures(trusted core.memory.callable_address_valid<PanicMessageRelease>(pointer = result))
    uses(intrinsic)
{
    // The native protocol supplies exact callback identity and keeps its provider
    // alive through consumption. This projection copies code-address bits without
    // borrowing the C header that carries them.
    return trusted core.target.from_exposed_address<PanicMessageRelease>(address = primary.release_message);
}

trusted internal func release_primary(
    pos primary: &ReportPrimary,
    pos callback: PanicMessageRelease?
) -> (u32, PanicReportData)
    ensures(trusted native_report_callbacks(report = &result.1))
    uses(layout_reinterpret)
    requires(trusted bray.runtime.bootstrap.pool.protocol_access())
{
    let mut outcome: ReportOutcome =
    {
        state = RUN_COMPLETED,
        payload = 0,
        report = empty_panic_report()
    };

    if let ?release = callback
    {
        let output: RawPointer<u8> = trusted std.memory.reinterpret<u8, ReportOutcome>(
            std.memory.address_of_mut<ReportOutcome>(&mut outcome)
        );

        trusted release(primary.message, primary.message_length, output);
    }

    return (outcome.state, outcome.report);
}

trusted internal func recycle_reservation(pos handle: usize)
    requires(trusted bray.runtime.bootstrap.pool.protocol_access())
{
    if handle == 0
    {
        return;
    }

    let reserved: ReportRecords =
    {
        head = handle,
        tail = handle,
        count = 1
    };

    let (_, value) = trusted pop_record_value(reserved);

    trusted recycle_value(value);
}

trusted internal func recycle_value(pos value: ReportValue)
    requires(trusted bray.runtime.bootstrap.pool.protocol_access(), trusted retained_report_value(value = &value))
    uses(intrinsic)
{
    match value
    {
        case Panic(stored)
        {
            let callback = stored.release_message;
            let primary = trusted serialized_primary(&stored);
            let (state, _) = trusted release_primary(&primary, callback);

            if state != RUN_COMPLETED
            {
                trusted core.target.abort();
            }
        }
        case Error(_) { trusted core.target.abort(); }
    };
}

@abi(c)
trusted internal func consume_report(pos pointer: RawPointer<PanicReportData>, pos reporting: u32) -> u32
    requires(
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted core.memory.valid_read<PanicReportData>(pointer = pointer, count = 1),
        trusted core.memory.valid_write<PanicReportData>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<PanicReportData>(pointer = pointer),
        trusted core.memory.initialized_as<PanicReportData>(pointer = pointer),
        trusted native_report_slot_callbacks(pointer = pointer),
    )
{
    let owned: PanicReportData = trusted take_report(pointer);

    let remaining: ReportRecords =
    {
        head = owned.outgoing_head,
        tail = owned.outgoing_tail,
        count = owned.outgoing_count
    };

    let reserved: usize = owned.reserved;
    let primary = trusted stored_primary(report_primary_value(owned));

    return trusted consume_primary(primary, remaining, reserved, reporting);
}

trusted internal func consume_record_values(pos remaining: ReportRecords, pos reporting: u32) -> u32
    requires(trusted bray.runtime.bootstrap.pool.protocol_access())
{
    if remaining.count == 0
    {
        return STATUS_SUCCESS;
    }

    let (tail, primary) = trusted pop_record_value(remaining);

    return trusted consume_values(primary, tail, reporting);
}

trusted internal func consume_primary(
    pos primary: StoredReportPrimary,
    pos remaining: ReportRecords,
    pos reserved: usize,
    pos reporting: u32
) -> u32
    requires(trusted bray.runtime.bootstrap.pool.protocol_access())
{
    trusted recycle_reservation(reserved);

    return trusted consume_values(trusted panic_record(primary), remaining, reporting);
}

trusted internal func consume_values(
    pos mut current: ReportValue,
    pos mut remaining: ReportRecords,
    pos reporting: u32
) -> u32
    requires(trusted bray.runtime.bootstrap.pool.protocol_access(), trusted retained_report_value(value = &current))
{
    let mut status: u32 = STATUS_SUCCESS;

    loop
    {
        let (found, mut incidents) = trusted bray.runtime.bootstrap.report.incident.dispose_value(current, reporting);

        if status == STATUS_SUCCESS
        {
            status = found;
        }

        trusted report_records_append(
            std.memory.address_of_mut<ReportRecords>(&mut incidents),
            std.memory.address_of_mut<ReportRecords>(&mut remaining)
        );

        if incidents.count == 0
        {
            return status;
        }

        let (tail, next) = trusted pop_record_value(incidents);

        remaining = tail;
        current = next;
    }
}

trusted internal func consume_panic(pos stored: &StoredReportPrimary, pos reporting: u32) -> (u32, ReportRecords)
    requires(trusted bray.runtime.bootstrap.pool.protocol_access())
{
    let copy = stored.copy_message;
    let callback = stored.release_message;
    let primary = trusted serialized_primary(stored);
    let mut status: u32 = STATUS_SUCCESS;

    if reporting != 0 && primary.primary_present != 0
    {
        status = trusted bray.runtime.bootstrap.report.output.primary(&primary, copy);
    }

    let (state, report) = trusted release_primary(&primary, callback);

    let value = trusted bray.runtime.bootstrap.report.incident.prepare_value(state, report);
    let (released, records) = trusted bray.runtime.bootstrap.report.incident.retain_outcome(value);

    if status == STATUS_SUCCESS
    {
        status = released;
    }

    return (status, records);
}

@abi(c)
trusted internal func panic_reporting(pos pointer: RawPointer<PanicReportData>) -> u32
    requires(
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted core.memory.valid_read<PanicReportData>(pointer = pointer, count = 1),
        trusted core.memory.valid_write<PanicReportData>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<PanicReportData>(pointer = pointer),
        trusted core.memory.initialized_as<PanicReportData>(pointer = pointer),
        trusted native_report_slot_callbacks(pointer = pointer),
    )
{
    return trusted consume_report(pointer, 1);
}

@abi(c)
trusted internal func panic_report_destruction(pos pointer: RawPointer<PanicReportData>) -> u32
    requires(
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted core.memory.valid_read<PanicReportData>(pointer = pointer, count = 1),
        trusted core.memory.valid_write<PanicReportData>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<PanicReportData>(pointer = pointer),
        trusted core.memory.initialized_as<PanicReportData>(pointer = pointer),
        trusted native_report_slot_callbacks(pointer = pointer),
    )
{
    return trusted consume_report(pointer, 0);
}

@abi(c)
trusted internal func consume_segment(
    pos metadata: RawPointer<ReportSegment>,
    pos pointer: RawPointer<PanicReportData>
) -> u32
    requires(
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted core.memory.valid_read<ReportSegment>(pointer = metadata, count = 1),
        trusted core.memory.aligned_for<ReportSegment>(pointer = metadata),
        trusted core.memory.initialized_as<ReportSegment>(pointer = metadata),
        trusted core.memory.valid_read<PanicReportData>(pointer = pointer, count = 1),
        trusted core.memory.valid_write<PanicReportData>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<PanicReportData>(pointer = pointer),
        trusted core.memory.initialized_as<PanicReportData>(pointer = pointer),
        trusted native_report_slot_callbacks(pointer = pointer)
    )
    uses(raw_memory)
{
    let metadata_value = trusted std.memory.read<ReportSegment>(metadata);
    let report = trusted take_report(pointer);

    let remaining: ReportRecords =
    {
        head = report.outgoing_head,
        tail = report.outgoing_tail,
        count = report.outgoing_count
    };

    let reserved = report.reserved;
    let primary = trusted stored_primary(trusted report_primary_value(report));
    let output = trusted bray.runtime.bootstrap.report.output.segment(&metadata_value);
    let disposal = trusted consume_primary(primary, remaining, reserved, 1);

    if output != STATUS_SUCCESS
    {
        return output;
    }

    return disposal;
}
