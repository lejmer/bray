@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.worker;

using core.memory;
using core.target;
using std.memory;
using std.sync;
using internal std.sync.spin_lock;
using internal bray.runtime.bootstrap.heap;
using internal bray.runtime.bootstrap.scheduler;
using internal bray.runtime.bootstrap.execution;
using internal bray.runtime.bootstrap.host.product;

@abi(c)
trusted internal func creation(
    pos scheduler: DataPointer<bray.runtime.bootstrap.scheduler.Reference>,
    pos callback: DataPointer<Callback>,
    pos output: DataPointer<Reference>
) -> u32
    requires(
        trusted bray.runtime.bootstrap.scheduler.reference_slot(pointer = scheduler),
        trusted callback_slot(pointer = callback),
        trusted bray.runtime.bootstrap.host.product.native_host()
    )
{
    let callback_owner = trusted read_creation_callback(scheduler, callback);
    let scheduler_owner = trusted bray.runtime.bootstrap.scheduler.retain_reference(trusted bray.runtime.bootstrap.scheduler.borrow_reference(&scheduler, scheduler));

    match consume create(trusted bray.runtime.bootstrap.scheduler.external_backing(scheduler_owner), callback_owner)
    {
        case Ok(owner)
        {
            trusted invoke_pool(&owner, 0);
            trusted bray.runtime.bootstrap.host.product.publish_provider<Reference>(output, owner);
            return 0;
        }
        case Error((rejected, status))
        {
            trusted bray.runtime.bootstrap.scheduler.release_external_backing(rejected);
            return status;
        }
    }
}

internal func create(
    pos backing: bray.runtime.bootstrap.scheduler.Backing,
    pos callback: Callback
) -> Result<Reference, (bray.runtime.bootstrap.scheduler.Backing, u32)>
    requires(trusted bray.runtime.bootstrap.scheduler.backing_retained(owner = &backing), trusted bray.runtime.bootstrap.scheduler.backing_owned(owner = &backing), trusted bray.runtime.bootstrap.host.product.native_host())
    ensures(
        result matches Error(_) || trusted retained(owner = &created_reference(&result).marker),
        result matches Ok(_) || trusted bray.runtime.bootstrap.scheduler.backing_retained(owner = bray.runtime.bootstrap.scheduler.rejected_backing<Reference>(&result)),
        result matches Ok(_) || trusted bray.runtime.bootstrap.scheduler.backing_owned(owner = bray.runtime.bootstrap.scheduler.rejected_backing<Reference>(&result))
    )
{
    if !trusted bray.runtime.bootstrap.scheduler.worker_admission(trusted bray.runtime.bootstrap.scheduler.backing_scheduler(&backing))
    {
        let rejected: (bray.runtime.bootstrap.scheduler.Backing, u32) = (backing, 4);

        return Error(rejected);
    }

    let allocation = trusted allocate_domain(&backing);

    if std.memory.is_null<u8>(allocation)
    {
        let rejected: (bray.runtime.bootstrap.scheduler.Backing, u32) = (backing, 1);

        return Error(rejected);
    }

    return Ok(trusted initialize(allocation, backing, callback));
}

internal const func created_reference(pos value: &Result<Reference, (bray.runtime.bootstrap.scheduler.Backing, u32)>) -> &Reference
    requires(value matches Ok(_))
    executes(pure, total)
{
    return match value
    {
        case Ok(owner) { yield &owner; }
        case Error(_) { panic("rejected service creation has no worker owner"); }
    };
}

trusted internal func allocate_domain(pos backing: &bray.runtime.bootstrap.scheduler.Backing) -> DataPointer<u8>
    requires(trusted bray.runtime.bootstrap.scheduler.backing_retained(owner = backing), trusted bray.runtime.bootstrap.scheduler.backing_owned(owner = backing))
    ensures(
        trusted bray.runtime.bootstrap.scheduler.backing_retained(owner = backing),
        trusted bray.runtime.bootstrap.scheduler.backing_owned(owner = backing),
        std.memory.is_null<u8>(result) || trusted core.memory.owned_allocation(
            pointer = result,
            bytes = std.memory.stride_of<Domain>(),
            align = std.memory.align_of<Domain>()
        ),
        std.memory.is_null<u8>(result) || trusted core.memory.valid_write<u8>(
            pointer = result,
            count = std.memory.stride_of<Domain>()
        )
    )
{
    return trusted bray.runtime.bootstrap.heap.allocate(
        std.memory.stride_of<Domain>(),
        align = std.memory.align_of<Domain>()
    );
}

trusted internal func read_creation_callback(
    pos scheduler: DataPointer<bray.runtime.bootstrap.scheduler.Reference>,
    pos callback: DataPointer<Callback>
) -> Callback
    requires(
        trusted bray.runtime.bootstrap.scheduler.reference_slot(pointer = scheduler),
        trusted callback_slot(pointer = callback)
    )
    ensures(trusted bray.runtime.bootstrap.scheduler.reference_slot(pointer = scheduler))
{
    return trusted read_callback(callback);
}

trusted internal func read_callback(pos pointer: DataPointer<Callback>) -> Callback
    requires(trusted callback_slot(pointer = pointer))
    uses(raw_memory)
{
    let permit = trusted lambda(pos pointer: DataPointer<Callback>)
        requires(trusted callback_slot(pointer = pointer))
        ensures(
            trusted core.memory.valid_read<Callback>(pointer = pointer, count = 1),
            trusted core.memory.aligned_for<Callback>(pointer = pointer),
            trusted core.memory.initialized_as<Callback>(pointer = pointer)
        )
        executes(pure, total) {};

    trusted permit(pointer);
    return trusted std.memory.read<Callback>(pointer);
}

trusted internal func initialize(
    pos allocation: DataPointer<u8>,
    pos backing: bray.runtime.bootstrap.scheduler.Backing,
    pos callback: Callback
) -> Reference
    requires(
        trusted core.memory.owned_allocation(
            pointer = allocation,
            bytes = std.memory.stride_of<Domain>(),
            align = std.memory.align_of<Domain>()
        ),
        trusted core.memory.valid_write<u8>(pointer = allocation, count = std.memory.stride_of<Domain>()),
        trusted bray.runtime.bootstrap.scheduler.backing_retained(owner = &backing), trusted bray.runtime.bootstrap.scheduler.backing_owned(owner = &backing)
    )
    ensures(trusted retained(owner = &result.marker))
    uses(raw_memory, unchecked_init)
{
    let typed = trusted lambda(pos allocation: DataPointer<u8>) -> DataPointer<Domain>
        requires(
            trusted core.memory.owned_allocation(
                pointer = allocation,
                bytes = std.memory.stride_of<Domain>(),
                align = std.memory.align_of<Domain>()
            ),
            trusted core.memory.valid_write<u8>(pointer = allocation, count = std.memory.stride_of<Domain>())
        )
        ensures(
            trusted core.memory.valid_write<Domain>(pointer = result, count = 1),
            trusted core.memory.aligned_for<Domain>(pointer = result)
        )
        uses(layout_reinterpret)
    {
        return trusted std.memory.reinterpret<Domain, u8>(allocation);
    };

    let pointer = trusted typed(allocation);

    trusted std.memory.write<Domain>(
        pointer,
        {
            backing = backing,
            callback = callback,
            demand_service = demand_service,
            stop_service = stop_service,
            detach_service = detach_service,
            state = trusted std.sync.SpinLock<State>(
                {
                    stopping = false,
                    entries = none,
                    count = [0; 3],
                    idle_blocking = 0,
                    live = 0,
                    completed = false
                }
            )
        }
    );

    return
    {
        marker = Marker
        {
        },
        pointer = pointer
    };
}

trusted internal func domain(pos owner: &Reference) -> &Domain
    requires(trusted retained(owner = &owner.marker))
    ensures(trusted retained(owner = &owner.marker), trusted std.sync.spin_lock.valid(&result.state.prepared.instance), (result.backing matches bray.runtime.bootstrap.scheduler.Backing.Retired || trusted bray.runtime.bootstrap.scheduler.backing_retained(owner = &result.backing)))
    executes(pure, total)
    uses(raw_memory, unchecked_alias)
{
    let pointer = trusted lambda(pos owner: &Reference) -> DataPointer<Domain>
        requires(trusted retained(owner = &owner.marker))
        ensures(
            trusted core.memory.valid_read<Domain>(pointer = result, count = 1),
            trusted core.memory.aligned_for<Domain>(pointer = result),
            trusted core.memory.initialized_as<Domain>(pointer = result),
            trusted core.memory.shared_alias_valid<Domain>(pointer = result),
            trusted core.memory.epoch_current<Domain>(pointer = result),
            trusted core.memory.synchronized_access<Domain>(pointer = result),
            trusted core.memory.movement_stable<Domain>(pointer = result),
            trusted core.memory.finalization_pending<Domain>(pointer = result)
        )
        executes(pure, total)
    {
        return owner.pointer;
    };

    return trusted std.memory.borrow_from<Domain, Reference>(owner, trusted pointer(owner));
}

trusted internal func lock(pos owner: &Reference) -> std.sync.SpinLockGuard<State>
    requires(trusted retained(owner = &owner.marker))
    ensures(
        trusted retained(owner = &owner.marker),
        trusted std.sync.spin_lock.acquired(&result.acquisition),
        trusted acquisition_for(owner = &owner.marker, marker = &result.acquisition)
    )
    uses(raw_memory, unchecked_alias)
{
    let value = trusted domain(owner);
    let pointer = std.memory.address_of<std.sync.SpinLock<State>>(&value.state);

    let authorize = trusted lambda(pos owner: &Reference, pos pointer: DataPointer<std.sync.SpinLock<State>>)
        requires(trusted retained(owner = &owner.marker))
        ensures(
            trusted core.memory.valid_read<std.sync.SpinLock<State>>(pointer = pointer, count = 1),
            trusted core.memory.aligned_for<std.sync.SpinLock<State>>(pointer = pointer),
            trusted core.memory.initialized_as<std.sync.SpinLock<State>>(pointer = pointer),
            trusted core.memory.shared_alias_valid<std.sync.SpinLock<State>>(pointer = pointer),
            trusted core.memory.epoch_current<std.sync.SpinLock<State>>(pointer = pointer),
            trusted core.memory.synchronized_access<std.sync.SpinLock<State>>(pointer = pointer),
            trusted core.memory.movement_stable<std.sync.SpinLock<State>>(pointer = pointer),
            trusted core.memory.finalization_pending<std.sync.SpinLock<State>>(pointer = pointer)
        )
        executes(pure, total) {};

    trusted authorize(owner, pointer);

    // Anchor the guard to the actual retained pool, not a temporary domain view.
    let protected = trusted std.memory.borrow_from<std.sync.SpinLock<State>, Reference>(owner, pointer);

    let initialized = trusted lambda(pos owner: &Reference, pos protected: &std.sync.SpinLock<State>)
        requires(trusted retained(owner = &owner.marker))
        ensures(trusted std.sync.spin_lock.valid(&protected.prepared.instance))
        executes(pure, total) {};

    trusted initialized(owner, protected);
    return trusted protected.lock();
}

trusted internal func locked_state(pos owner: &Reference, pos guard: &mut std.sync.SpinLockGuard<State>) -> &mut State
    requires(
        trusted retained(owner = &owner.marker),
        trusted std.sync.spin_lock.acquired(&guard.acquisition),
        trusted acquisition_for(owner = &owner.marker, marker = &guard.acquisition)
    )
    ensures(
        trusted retained(owner = &owner.marker),
        trusted std.sync.spin_lock.acquired(&guard.acquisition),
        trusted acquisition_for(owner = &owner.marker, marker = &guard.acquisition)
    )
{
    return trusted guard.get();
}

@abi(c)
trusted internal func destruction(pos pointer: DataPointer<Reference>)
    requires(trusted reference_slot(pointer = pointer), trusted retirement_entry(pointer = pointer))
{
    let retire = trusted lambda(pos slot: DataPointer<Reference>) -> Reference
        requires(trusted reference_slot(pointer = slot), trusted retirement_entry(pointer = slot))
        ensures(trusted retained(owner = &result.marker), trusted retiring(owner = &result))
        uses(raw_memory)
    {
        let permit = trusted lambda(pos slot: DataPointer<Reference>)
            requires(trusted reference_slot(pointer = slot), trusted retirement_entry(pointer = slot))
            ensures(
                trusted core.memory.valid_read<Reference>(pointer = slot, count = 1),
                trusted core.memory.initialized_as<Reference>(pointer = slot),
                trusted core.memory.aligned_for<Reference>(pointer = slot)
            )
            executes(pure, total) {};

        trusted permit(slot);
        return trusted std.memory.read<Reference>(slot);
    };

    trusted destroy_reference(trusted retire(pointer));
}

trusted internal func destroy_reference(pos owner: Reference)
    requires(trusted retained(owner = &owner.marker), trusted retiring(owner = &owner))
{
    let complete =
    {
        let mut guard = trusted lock(&owner);
        let state = trusted locked_state(&owner, &mut guard);

        if state.live != 0
        {
            trusted core.target.abort();
        }

        yield if !state.completed
        {
            state.completed = true;
            yield true;
        }
        else
        {
            yield false;
        };
    };

    if complete
    {
        trusted invoke_pool(&owner, 8);
        trusted invoke_pool(&owner, 1);
    }


    // Only the actual retiring reference can transfer allocation ownership.
    let take = trusted lambda(pos owner: Reference) -> (bray.runtime.bootstrap.scheduler.Backing, std.sync.SpinLock<State>, std.memory.RawAllocation)
        requires(trusted retained(owner = &owner.marker), trusted retiring(owner = &owner))
        ensures(
            trusted std.sync.spin_lock.valid(&result.1.prepared.instance),
            trusted core.memory.owned_allocation(pointer = result.2.pointer, bytes = result.2.bytes, align = result.2.align),
            result.0 matches bray.runtime.bootstrap.scheduler.Backing.Retired || (trusted bray.runtime.bootstrap.scheduler.backing_retained(owner = &result.0) && trusted bray.runtime.bootstrap.scheduler.backing_owned(owner = &result.0))
        )
        uses(raw_memory)
    {
        let take_storage = trusted lambda(pos owner: &Reference) -> Domain
            requires(trusted retained(owner = &owner.marker), trusted retiring(owner = owner))
            ensures(
                trusted std.sync.spin_lock.valid(&result.state.prepared.instance),
                result.backing matches bray.runtime.bootstrap.scheduler.Backing.Retired || (trusted bray.runtime.bootstrap.scheduler.backing_retained(owner = &result.backing) && trusted bray.runtime.bootstrap.scheduler.backing_owned(owner = &result.backing)),
                trusted core.memory.owned_allocation(pointer = std.memory.byte_address<Domain>(owner.pointer), bytes = std.memory.stride_of<Domain>(), align = std.memory.align_of<Domain>())
            )
            uses(raw_memory)
        {
            let permit = trusted lambda(pos owner: &Reference)
                requires(trusted retained(owner = &owner.marker), trusted retiring(owner = owner))
                ensures(
                    trusted core.memory.valid_read<Domain>(pointer = owner.pointer, count = 1),
                    trusted core.memory.aligned_for<Domain>(pointer = owner.pointer),
                    trusted core.memory.initialized_as<Domain>(pointer = owner.pointer),
                    trusted core.memory.owned_allocation(pointer = std.memory.byte_address<Domain>(owner.pointer), bytes = std.memory.stride_of<Domain>(), align = std.memory.align_of<Domain>())
                )
                executes(pure, total) {};

            trusted permit(owner);
            return trusted std.memory.read<Domain>(owner.pointer);
        };

        let value = trusted take_storage(&owner);

        let allocation: std.memory.RawAllocation =
        {
            pointer = std.memory.byte_address<Domain>(owner.pointer),
            bytes = std.memory.stride_of<Domain>(),
            align = std.memory.align_of<Domain>()
        };

        return (
            trusted std.memory.read<bray.runtime.bootstrap.scheduler.Backing>(std.memory.address_of<bray.runtime.bootstrap.scheduler.Backing>(&value.backing)),
            trusted std.memory.read<std.sync.SpinLock<State>>(std.memory.address_of<std.sync.SpinLock<State>>(&value.state)),
            allocation
        );
    };

    let (backing, owned_state, allocation) = trusted take(owner);

    _ = allocation;

    _ = owned_state;

    trusted bray.runtime.bootstrap.scheduler.release_external_backing(backing);
}

trusted internal func scheduler_reference(pos owner: &Reference) -> &bray.runtime.bootstrap.scheduler.Reference
    requires(trusted retained(owner = &owner.marker))
    ensures(trusted retained(owner = &owner.marker), trusted bray.runtime.bootstrap.scheduler.retained(owner = result))
    executes(pure, total)
{
    let backing = &(trusted domain(owner)).backing;

    if backing matches bray.runtime.bootstrap.scheduler.Backing.Retired
    {
        trusted core.target.abort();
    }

    return trusted bray.runtime.bootstrap.scheduler.backing_scheduler(backing);
}

trusted internal func execution_reference(pos owner: &Reference) -> &bray.runtime.bootstrap.execution.Reference
    requires(trusted retained(owner = &owner.marker))
    ensures(trusted retained(owner = &owner.marker), trusted bray.runtime.bootstrap.execution.retained(owner = result))
{
    let backing = &(trusted domain(owner)).backing;

    if !(backing matches bray.runtime.bootstrap.scheduler.Backing.Execution(_))
    {
        trusted core.target.abort();
    }

    return bray.runtime.bootstrap.scheduler.backing_execution(backing);
}

trusted internal func scheduler_pointer(pos owner: &Reference) -> DataPointer<bray.runtime.bootstrap.scheduler.Reference>
    requires(trusted retained(owner = &owner.marker))
{
    return std.memory.address_of<bray.runtime.bootstrap.scheduler.Reference>(trusted scheduler_reference(owner));
}

// The completion callback transfers the actual service backing once, after
// every accepted OS worker has completed its exact-thread cleanup.
trusted internal func take_execution_backing(
    pos context: usize,
    pos owner: &Reference,
    pos pool: DataPointer<Reference>,
    pos scope: DataPointer<DataPointer<Scope>>,
    pos argument: u64,
    pos outcome: DataPointer<bray.runtime.bootstrap.ReportOutcome>
) -> bray.runtime.bootstrap.execution.Reference
    requires(
        trusted retained(owner = &owner.marker),
        trusted callback_authorized(context = context, operation = 1, pool = pool, scope = scope, argument = argument, outcome = outcome)
    )
    ensures(trusted bray.runtime.bootstrap.execution.retained(owner = &result), trusted bray.runtime.bootstrap.execution.pinned(owner = &result))
    uses(raw_memory, unchecked_init, intrinsic)
{
    let pointer = std.memory.address_of<bray.runtime.bootstrap.scheduler.Backing>(&(trusted domain(owner)).backing);
    let take = trusted lambda(
        pos context: usize,
        pos owner: &Reference,
        pos pool: DataPointer<Reference>,
        pos scope: DataPointer<DataPointer<Scope>>,
        pos argument: u64,
        pos outcome: DataPointer<bray.runtime.bootstrap.ReportOutcome>,
        pos pointer: DataPointer<bray.runtime.bootstrap.scheduler.Backing>
    ) -> bray.runtime.bootstrap.scheduler.Backing
        requires(trusted retained(owner = &owner.marker), trusted callback_authorized(context = context, operation = 1, pool = pool, scope = scope, argument = argument, outcome = outcome))
        ensures(trusted bray.runtime.bootstrap.scheduler.backing_retained(owner = &result), trusted bray.runtime.bootstrap.scheduler.backing_owned(owner = &result))
        uses(raw_memory, unchecked_init, intrinsic)
    {
        let permit = trusted lambda(pos owner: &Reference, pos pointer: DataPointer<bray.runtime.bootstrap.scheduler.Backing>)
            requires(trusted retained(owner = &owner.marker))
            ensures(
                trusted core.memory.valid_read<bray.runtime.bootstrap.scheduler.Backing>(pointer = pointer, count = 1),
                trusted core.memory.valid_write<bray.runtime.bootstrap.scheduler.Backing>(pointer = pointer, count = 1),
                trusted core.memory.initialized_as<bray.runtime.bootstrap.scheduler.Backing>(pointer = pointer),
                trusted core.memory.aligned_for<bray.runtime.bootstrap.scheduler.Backing>(pointer = pointer)
            )
            executes(pure, total) {};

        trusted permit(owner, pointer);
        let backing = trusted std.memory.read<bray.runtime.bootstrap.scheduler.Backing>(pointer);

        trusted std.memory.write<bray.runtime.bootstrap.scheduler.Backing>(pointer, bray.runtime.bootstrap.scheduler.Backing.Retired);
        return backing;
    };

    return trusted bray.runtime.bootstrap.scheduler.take_execution_backing(trusted take(context, owner, pool, scope, argument, outcome, pointer));
}
