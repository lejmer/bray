@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.worker;

using core.memory;
using core.target;
using std.memory;
using std.sync;
using internal std.sync.spin_lock;
using internal bray.runtime.bootstrap.heap;
using internal bray.runtime.bootstrap.scheduler;
using internal bray.runtime.bootstrap.host.product;

@abi(c)
trusted internal func creation(
    pos scheduler: DataPointer<bray.runtime.bootstrap.scheduler.Reference>,
    pos callback: DataPointer<Callback>,
    pos output: DataPointer<DataPointer<Domain>>
) -> u32
    requires(
        trusted bray.runtime.bootstrap.scheduler.reference_slot(pointer = scheduler),
        trusted callback_slot(pointer = callback),
        trusted bray.runtime.bootstrap.host.product.native_host()
    )
{
    let callback_owner = trusted read_creation_callback(scheduler, callback);
    let scheduler_owner = trusted bray.runtime.bootstrap.scheduler.read_reference(scheduler);

    if !trusted bray.runtime.bootstrap.scheduler.worker_admission(&scheduler_owner)
    {
        return 4;
    }

    let allocation = trusted allocate_domain(&scheduler_owner);

    if std.memory.is_null<u8>(allocation)
    {
        return 1;
    }

    let owner = trusted initialize(allocation, scheduler_owner, callback_owner);

    trusted bray.runtime.bootstrap.host.product.publish_provider<DataPointer<Domain>>(output, owner.pointer);
    return 0;
}

trusted internal func allocate_domain(pos scheduler: &bray.runtime.bootstrap.scheduler.Reference) -> DataPointer<u8>
    requires(trusted bray.runtime.bootstrap.scheduler.retained(owner = scheduler))
    ensures(
        trusted bray.runtime.bootstrap.scheduler.retained(owner = scheduler),
        std.memory.is_null<u8>(result) || trusted core.memory.owned_allocation(
            pointer = result,
            bytes = std.memory.stride_of<Domain>(),
            align = std.memory.align_of<Domain>()
        ),
        std.memory.is_null<u8>(result) || trusted core.memory.valid_write<u8>(
            pointer = result,
            count = std.memory.stride_of<Domain>()
        )
    )
{
    return trusted bray.runtime.bootstrap.heap.allocate(
        std.memory.stride_of<Domain>(),
        align = std.memory.align_of<Domain>()
    );
}

trusted internal func read_creation_callback(
    pos scheduler: DataPointer<bray.runtime.bootstrap.scheduler.Reference>,
    pos callback: DataPointer<Callback>
) -> Callback
    requires(
        trusted bray.runtime.bootstrap.scheduler.reference_slot(pointer = scheduler),
        trusted callback_slot(pointer = callback)
    )
    ensures(trusted bray.runtime.bootstrap.scheduler.reference_slot(pointer = scheduler))
{
    return trusted read_callback(callback);
}

trusted internal func read_callback(pos pointer: DataPointer<Callback>) -> Callback
    requires(trusted callback_slot(pointer = pointer))
    uses(raw_memory)
{
    let permit = trusted lambda(pos pointer: DataPointer<Callback>)
        requires(trusted callback_slot(pointer = pointer))
        ensures(
            trusted core.memory.valid_read<Callback>(pointer = pointer, count = 1),
            trusted core.memory.aligned_for<Callback>(pointer = pointer),
            trusted core.memory.initialized_as<Callback>(pointer = pointer)
        )
        executes(pure, total) {};

    trusted permit(pointer);
    return trusted std.memory.read<Callback>(pointer);
}

trusted internal func initialize(
    pos allocation: DataPointer<u8>,
    pos scheduler: bray.runtime.bootstrap.scheduler.Reference,
    pos callback: Callback
) -> Reference
    requires(
        trusted core.memory.owned_allocation(
            pointer = allocation,
            bytes = std.memory.stride_of<Domain>(),
            align = std.memory.align_of<Domain>()
        ),
        trusted core.memory.valid_write<u8>(pointer = allocation, count = std.memory.stride_of<Domain>()),
        trusted bray.runtime.bootstrap.scheduler.retained(owner = &scheduler)
    )
    ensures(trusted retained(owner = &result.marker))
    uses(raw_memory, unchecked_init)
{
    let typed = trusted lambda(pos allocation: DataPointer<u8>) -> DataPointer<Domain>
        requires(
            trusted core.memory.owned_allocation(
                pointer = allocation,
                bytes = std.memory.stride_of<Domain>(),
                align = std.memory.align_of<Domain>()
            ),
            trusted core.memory.valid_write<u8>(pointer = allocation, count = std.memory.stride_of<Domain>())
        )
        ensures(
            trusted core.memory.valid_write<Domain>(pointer = result, count = 1),
            trusted core.memory.aligned_for<Domain>(pointer = result)
        )
        uses(layout_reinterpret)
    {
        return trusted std.memory.reinterpret<Domain, u8>(allocation);
    };

    let pointer = trusted typed(allocation);

    trusted std.memory.write<Domain>(
        pointer,
        {
            scheduler = scheduler,
            callback = callback,
            state = trusted std.sync.SpinLock<State>(
                {
                    stopping = false,
                    entries = none,
                    count = [0; 3],
                    idle_blocking = 0,
                    live = 0,
                    completed = false
                }
            )
        }
    );

    return
    {
        marker = Marker
        {
        },
        pointer = pointer
    };
}

trusted internal func read_reference(pos pointer: DataPointer<DataPointer<Domain>>) -> Reference
    requires(trusted reference_slot(pointer = pointer))
    ensures(trusted retained(owner = &result.marker))
{
    let read = trusted lambda(pos pointer: DataPointer<DataPointer<Domain>>) -> Reference
        requires(trusted reference_slot(pointer = pointer))
        ensures(trusted retained(owner = &result.marker))
        uses(raw_memory)
    {
        let permit = trusted lambda(pos pointer: DataPointer<DataPointer<Domain>>)
            requires(trusted reference_slot(pointer = pointer))
            ensures(
                trusted core.memory.valid_read<DataPointer<Domain>>(pointer = pointer, count = 1),
                trusted core.memory.aligned_for<DataPointer<Domain>>(pointer = pointer),
                trusted core.memory.initialized_as<DataPointer<Domain>>(pointer = pointer)
            )
            executes(pure, total) {};

        trusted permit(pointer);

        return
        {
            marker = Marker
            {
            },
            pointer = trusted std.memory.read<DataPointer<Domain>>(pointer)
        };
    };

    return trusted read(pointer);
}

trusted internal func domain(pos owner: &Reference) -> &Domain
    requires(trusted retained(owner = &owner.marker))
    ensures(trusted retained(owner = &owner.marker), trusted std.sync.spin_lock.valid(&result.state.prepared.instance))
    executes(pure, total)
    uses(raw_memory, unchecked_alias)
{
    let pointer = trusted lambda(pos owner: &Reference) -> DataPointer<Domain>
        requires(trusted retained(owner = &owner.marker))
        ensures(
            trusted core.memory.valid_read<Domain>(pointer = result, count = 1),
            trusted core.memory.aligned_for<Domain>(pointer = result),
            trusted core.memory.initialized_as<Domain>(pointer = result),
            trusted core.memory.shared_alias_valid<Domain>(pointer = result),
            trusted core.memory.epoch_current<Domain>(pointer = result),
            trusted core.memory.synchronized_access<Domain>(pointer = result),
            trusted core.memory.movement_stable<Domain>(pointer = result),
            trusted core.memory.finalization_pending<Domain>(pointer = result)
        )
        executes(pure, total)
    {
        return owner.pointer;
    };

    return trusted std.memory.borrow_from<Domain, Reference>(owner, trusted pointer(owner));
}

trusted internal func lock(pos owner: &Reference) -> std.sync.SpinLockGuard<State>
    requires(trusted retained(owner = &owner.marker))
    ensures(
        trusted std.sync.spin_lock.acquired(&result.acquisition),
        trusted acquisition_for(owner = &owner.marker, marker = &result.acquisition)
    )
    uses(raw_memory, unchecked_alias)
{
    let value = trusted domain(owner);
    let pointer = std.memory.address_of<std.sync.SpinLock<State>>(&value.state);

    let authorize = trusted lambda(pos owner: &Reference, pos pointer: DataPointer<std.sync.SpinLock<State>>)
        requires(trusted retained(owner = &owner.marker))
        ensures(
            trusted core.memory.valid_read<std.sync.SpinLock<State>>(pointer = pointer, count = 1),
            trusted core.memory.aligned_for<std.sync.SpinLock<State>>(pointer = pointer),
            trusted core.memory.initialized_as<std.sync.SpinLock<State>>(pointer = pointer),
            trusted core.memory.shared_alias_valid<std.sync.SpinLock<State>>(pointer = pointer),
            trusted core.memory.epoch_current<std.sync.SpinLock<State>>(pointer = pointer),
            trusted core.memory.synchronized_access<std.sync.SpinLock<State>>(pointer = pointer),
            trusted core.memory.movement_stable<std.sync.SpinLock<State>>(pointer = pointer),
            trusted core.memory.finalization_pending<std.sync.SpinLock<State>>(pointer = pointer)
        )
        executes(pure, total) {};

    trusted authorize(owner, pointer);

    // Anchor the guard to the actual retained pool, not a temporary domain view.
    let protected = trusted std.memory.borrow_from<std.sync.SpinLock<State>, Reference>(owner, pointer);

    let initialized = trusted lambda(pos owner: &Reference, pos protected: &std.sync.SpinLock<State>)
        requires(trusted retained(owner = &owner.marker))
        ensures(trusted std.sync.spin_lock.valid(&protected.prepared.instance))
        executes(pure, total) {};

    trusted initialized(owner, protected);
    return trusted protected.lock();
}

trusted internal func locked_state(pos owner: &Reference, pos guard: &mut std.sync.SpinLockGuard<State>) -> &mut State
    requires(
        trusted retained(owner = &owner.marker),
        trusted std.sync.spin_lock.acquired(&guard.acquisition),
        trusted acquisition_for(owner = &owner.marker, marker = &guard.acquisition)
    )
    ensures(
        trusted std.sync.spin_lock.acquired(&guard.acquisition),
        trusted acquisition_for(owner = &owner.marker, marker = &guard.acquisition)
    )
{
    return trusted guard.get();
}

@abi(c)
trusted internal func destruction(pos pointer: DataPointer<DataPointer<Domain>>)
    requires(trusted reference_slot(pointer = pointer), trusted retirement_entry(pointer = pointer))
{
    let retire = trusted lambda(pos slot: DataPointer<DataPointer<Domain>>) -> Reference
        requires(trusted reference_slot(pointer = slot), trusted retirement_entry(pointer = slot))
        ensures(trusted retained(owner = &result.marker), trusted retiring(owner = &result))
    {
        return trusted read_reference(slot);
    };

    let owner = trusted retire(pointer);

    // Only the actual retiring reference can transfer allocation ownership.
    let take = trusted lambda(pos owner: &Reference) -> Domain
        requires(trusted retained(owner = &owner.marker), trusted retiring(owner = owner))
        ensures(
            trusted std.sync.spin_lock.valid(&result.state.prepared.instance),
            trusted core.memory.owned_allocation(
                pointer = std.memory.byte_address<Domain>(owner.pointer),
                bytes = std.memory.stride_of<Domain>(),
                align = std.memory.align_of<Domain>()
            )
        )
        uses(raw_memory)
    {
        let permit = trusted lambda(pos owner: &Reference)
            requires(trusted retained(owner = &owner.marker))
            ensures(
                trusted core.memory.valid_read<Domain>(pointer = owner.pointer, count = 1),
                trusted core.memory.aligned_for<Domain>(pointer = owner.pointer),
                trusted core.memory.initialized_as<Domain>(pointer = owner.pointer)
            )
            executes(pure, total) {};

        trusted permit(owner);
        return trusted std.memory.read<Domain>(owner.pointer);
    };

    let value = trusted take(&owner);

    trusted bray.runtime.bootstrap.heap.deallocate_bytes(
        std.memory.byte_address<Domain>(owner.pointer),
        std.memory.stride_of<Domain>(),
        align = std.memory.align_of<Domain>()
    );
}

trusted internal func scheduler_reference(pos owner: &Reference) -> &bray.runtime.bootstrap.scheduler.Reference
    requires(trusted retained(owner = &owner.marker))
    ensures(trusted bray.runtime.bootstrap.scheduler.retained(owner = result))
    executes(pure, total)
{
    let value = trusted domain(owner);

    return &value.scheduler;
}

trusted internal func scheduler_pointer(
    pos owner: &Reference
) -> DataPointer<bray.runtime.bootstrap.scheduler.Reference>
    requires(trusted retained(owner = &owner.marker))
    ensures(trusted retained(owner = &owner.marker))
{
    let value = trusted domain(owner);
    let pointer = std.memory.address_of<bray.runtime.bootstrap.scheduler.Reference>(&value.scheduler);

    return pointer;
}

// A local loan keeps its proof carrier separate from the mutable pool backing.
// The caller retains the actual native owner throughout this internal operation.
trusted internal func reference_loan(pos owner: &Reference) -> Reference
    requires(trusted retained(owner = &owner.marker))
    ensures(trusted retained(owner = &result.marker))
    executes(pure, total)
{
    return
    {
        marker = Marker
        {
        },
        pointer = owner.pointer
    };
}
