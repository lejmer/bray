@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.worker;

using std.memory;
using core.memory;
using core.target;
using internal bray.runtime.bootstrap.scheduler;
using internal bray.runtime.bootstrap.host.product;
using internal bray.runtime.bootstrap.pool;

internal callable Demand = @abi(c) trusted func(pos owner: DataPointer<Reference>, pos workload: u32) -> Failure
    requires(
        trusted reference_slot(pointer = owner),
        trusted bray.runtime.bootstrap.host.product.native_host(),
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        blocking_execution()
    );

internal callable Stop = @abi(c) trusted func(pos owner: DataPointer<Reference>, pos defer: bool)
    requires(trusted reference_slot(pointer = owner), blocking_execution());

internal callable Detach = @abi(c) trusted func(pos owner: DataPointer<Reference>)
    requires(trusted reference_slot(pointer = owner));

// Operations belong to the pool that owns their backing and provider. Root-only
// consumers can borrow this interface without retaining native worker creation.
internal func request(pos owner: &Reference, pos lane: bray.runtime.bootstrap.scheduler.Lane) -> Failure
    requires(
        trusted retained(owner = &owner.marker),
        trusted bray.runtime.bootstrap.host.product.native_host(),
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        blocking_execution()
    )
    ensures(trusted retained(owner = &owner.marker))
    uses(foreign_call)
{
    let operation = (trusted domain(owner)).demand_service;

    let workload = if lane.workload == 3
    {
        yield 1;
    }
    else
    {
        yield lane.workload;
    };

    return trusted operation(trusted service_pointer(owner), workload);
}

internal func close(pos owner: &Reference, pos defer: bool)
    requires(trusted retained(owner = &owner.marker), blocking_execution())
    ensures(trusted retained(owner = &owner.marker))
    uses(foreign_call)
{
    let operation = (trusted domain(owner)).stop_service;

    trusted operation(trusted service_pointer(owner), defer);
}

internal func detach(pos owner: &Reference)
    requires(trusted retained(owner = &owner.marker))
    ensures(trusted retained(owner = &owner.marker))
    uses(foreign_call)
{
    let operation = (trusted domain(owner)).detach_service;

    trusted operation(trusted service_pointer(owner));
}

internal const func optional_view(pos owner: &((&Reference)?)) -> &Reference
    requires(owner matches ?_)
    executes(pure, total)
{
    return match owner
    {
        case ?value { yield value; }
        case none { panic("missing retained service"); }
    };
}

trusted internal func service_pointer(pos owner: &Reference) -> DataPointer<Reference>
    requires(trusted retained(owner = &owner.marker))
    ensures(trusted retained(owner = &owner.marker), trusted reference_slot(pointer = result))
    executes(pure, total)
{
    return std.memory.address_of<Reference>(owner);
}

trusted internal func borrow_reference(
    pos input: &DataPointer<Reference>,
    pos pointer: DataPointer<Reference>
) -> &Reference
    requires(trusted reference_slot(pointer = pointer))
    ensures(trusted retained(owner = &result.marker))
    executes(pure, total)
    uses(raw_memory, unchecked_alias)
{
    let permit = trusted lambda(pos input: &DataPointer<Reference>, pos pointer: DataPointer<Reference>)
        requires(trusted reference_slot(pointer = pointer))
        ensures(
            trusted core.memory.valid_read<Reference>(pointer = pointer, count = 1),
            trusted core.memory.aligned_for<Reference>(pointer = pointer),
            trusted core.memory.initialized_as<Reference>(pointer = pointer),
            trusted core.memory.shared_alias_valid<Reference>(pointer = pointer),
            trusted core.memory.epoch_current<Reference>(pointer = pointer),
            trusted core.memory.synchronized_access<Reference>(pointer = pointer),
            trusted core.memory.movement_stable<Reference>(pointer = pointer),
            trusted core.memory.finalization_pending<Reference>(pointer = pointer)
        )
        executes(pure, total) {};

    trusted permit(input, pointer);
    return trusted std.memory.borrow_from<Reference, DataPointer<Reference>>(input, pointer);
}

@abi(c)
trusted internal func demand_service(pos owner: DataPointer<Reference>, pos workload: u32) -> Failure
    requires(
        trusted reference_slot(pointer = owner),
        trusted bray.runtime.bootstrap.host.product.native_host(),
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        blocking_execution()
    )
{
    return trusted ensure(trusted borrow_reference(&owner, owner), workload);
}

@abi(c)
trusted internal func stop_service(pos owner: DataPointer<Reference>, pos defer: bool)
    requires(trusted reference_slot(pointer = owner), blocking_execution())
{
    trusted stop_reference(trusted borrow_reference(&owner, owner), defer);
}

@abi(c)
trusted internal func detach_service(pos owner: DataPointer<Reference>)
    requires(trusted reference_slot(pointer = owner))
{
    trusted notify_reference(trusted borrow_reference(&owner, owner));
}
