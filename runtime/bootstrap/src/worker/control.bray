@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.worker;

using core.atomic;
using core.memory;
using internal bray.runtime.bootstrap;
using core.target;
using std.memory;
using internal bray.runtime.bootstrap.scheduler;
using internal bray.runtime.bootstrap.host.product;
using internal bray.runtime.bootstrap.pool;
using internal std.thread;

@abi(c)
trusted internal func acquisition(
    pos pointer: DataPointer<DataPointer<Scope>>,
    pos lanes: u32,
    pos output: DataPointer<bray.runtime.bootstrap.scheduler.Observation>
) -> u32
    requires(trusted scope_slot(pointer = pointer), trusted bray.runtime.bootstrap.host.product.native_host())
    uses(intrinsic)
{
    let reference = trusted read_scope(&pointer, pointer);

    if let ?selected = trusted acquire_ready(reference, lanes)
    {
        trusted bray.runtime.bootstrap.host.product.publish_provider<bray.runtime.bootstrap.scheduler.Observation>(output, selected);
        return 1;
    }

    return 0;
}

trusted internal func acquire_ready(pos owner: &Scope, pos lanes: u32) -> bray.runtime.bootstrap.scheduler.Observation?
    requires(trusted scope_live(owner = &owner.marker))
    ensures(trusted scope_live(owner = &owner.marker))
    uses(intrinsic)
{
    let row = trusted worker(owner);
    let mut guard = trusted lock(&row.pool);
    let state = trusted locked_state(&row.pool, &mut guard);

    if state.stopping
    {
        return none;
    }

    let scheduler = trusted scheduler_reference(&row.pool);
    let selected = bray.runtime.bootstrap.scheduler.acquire(scheduler, owner.attachment, lanes);

    if selected matches ?_ && row.workload == 1
    {
        if state.idle_blocking == 0
        {
            trusted core.target.abort();
        }

        state.idle_blocking -= 1;
    }

    return selected;
}

@abi(c)
trusted internal func notification(pos pointer: DataPointer<Reference>)
    requires(trusted reference_slot(pointer = pointer))
    uses(raw_memory)
{
    trusted notify_reference(trusted borrow_reference(&pointer, pointer));
}

trusted internal func notify_reference(pos reference: &Reference)
    requires(trusted retained(owner = &reference.marker))
    ensures(trusted retained(owner = &reference.marker))
    uses(raw_memory)
{

    {
        let mut guard = trusted lock(reference);
        let state = trusted locked_state(reference, &mut guard);

        if let ?entries = state.entries
        {
            let rows = trusted std.memory.initialized_slice<std.memory.RawBuffer<Worker>>(&entries);
            let mut index: usize = 0;

            while index < rows.length()
            {
                let workers = trusted std.memory.initialized_slice<Worker>(&rows[index]);

                core.atomic.store<u32, 2>(&workers[0].detach, 1);
                index += 1;
            }
        }
    }

    trusted notify_scheduler(reference);
}

trusted internal func notify_scheduler(pos reference: &Reference)
    requires(trusted retained(owner = &reference.marker))
    ensures(trusted retained(owner = &reference.marker))
{
    bray.runtime.bootstrap.scheduler.notify_ready(trusted scheduler_reference(reference));
}

@abi(c)
trusted internal func stop(pos pointer: DataPointer<Reference>)
    requires(trusted stop_entry(), blocking_execution())
    uses(intrinsic, raw_memory)
{
    let authorize = trusted lambda(pos pointer: DataPointer<Reference>)
        requires(trusted stop_entry())
        ensures(trusted reference_slot(pointer = pointer))
        executes(pure, total) {};

    trusted authorize(pointer);

    trusted stop_reference(trusted borrow_reference(&pointer, pointer));
}

trusted internal func stop_reference(pos reference: &Reference, pos defer: bool = false)
    requires(trusted retained(owner = &reference.marker), blocking_execution())
    ensures(trusted retained(owner = &reference.marker))
    uses(intrinsic, raw_memory)
{
    let native = internal std.thread.current_platform_identity();
    let mut from_worker: bool = defer;
    let mut count: usize = 0;
    let mut retire: bool = false;

    {
        let mut guard = trusted lock(reference);
        let state = trusted locked_state(reference, &mut guard);

        state.stopping = true;

        if state.live == 0 && !state.completed
        {
            state.completed = true;
            retire = true;
        }

        if let ?entries = state.entries
        {
            let rows = trusted std.memory.initialized_slice<std.memory.RawBuffer<Worker>>(&entries);

            count = rows.length();

            let mut index: usize = 0;

            while index < count
            {
                let workers = trusted std.memory.initialized_slice<Worker>(&rows[index]);

                if core.atomic.load<u64, 1>(&workers[0].identity) == native && core.atomic.load<u32, 1>(
                    &workers[0].terminal
                ) == 0
                {
                    from_worker = true;
                }

                index += 1;
            }
        }
    }

    if retire
    {
        trusted invoke_pool(reference, 8);
        trusted invoke_pool(reference, 1);
    }

    trusted notify_scheduler(reference);

    let mut index: usize = 0;

    while index < count
    {
        let selected = trusted lambda(pos reference: &Reference, pos index: usize) -> WorkerReference
            requires(trusted retained(owner = &reference.marker))
            ensures(trusted retained_worker(owner = &result.marker))
            uses(intrinsic)
        {
            let mut guard = trusted lock(reference);
            let state = trusted locked_state(reference, &mut guard);

            if let ?entries = state.entries
            {
                let rows = trusted std.memory.initialized_slice<std.memory.RawBuffer<Worker>>(&entries);

                return
                {
                    marker = Marker
                    {
                    },
                    pointer = std.memory.pointer<Worker>(&rows[index])
                };
            }

            return trusted core.target.abort();
        };

        let selected_worker = trusted selected(reference, index);
        let row = trusted retained_worker_value(&selected_worker);

        while core.atomic.load<u32, 1>(&row.formation) == 0
        {
            core.atomic.wait<u32, 1>(&row.formation, 0);
        }

        if !from_worker
        {
            while core.atomic.load<u32, 1>(&row.terminal) == 0
            {
                core.atomic.wait<u32, 1>(&row.terminal, 0);
            }
        }

        let handle = core.atomic.exchange<u64, 3>(&row.handle, 0);

        if handle != 0
        {
            // A worker cannot wait for peers that may depend on its callback.
            // Descriptor ownership keeps every detached worker and provider live
            // until its exact-thread cleanup and terminal acknowledgement.
            let status = if from_worker
            {
                yield trusted internal std.thread.platform_thread_detach(handle);
            }
            else
            {
                yield trusted internal std.thread.platform_thread_join(handle);
            };

            if status.category != 0
            {
                trusted core.target.abort();
            }
        }

        index += 1;
    }
}
