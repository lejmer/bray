@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.worker;

using core.memory;
using core.target;
using std.memory;
using internal bray.runtime.bootstrap;
using internal bray.runtime.bootstrap.pool;
using internal bray.runtime.bootstrap.entry;
using internal bray.runtime.bootstrap.host.product;

trusted internal func invoke(pos scope: &Scope, pos operation: u32, pos argument: u64) -> u32
    requires(
        operation >= 2 && operation <= 7,
        operation != 4 || blocking_execution(),
        operation != 5 || trusted native_entry(),
        trusted scope_live(owner = &scope.marker),
        trusted bray.runtime.bootstrap.pool.protocol_access()
    )
    ensures(trusted scope_live(owner = &scope.marker))
{
    let mut outcome: bray.runtime.bootstrap.ReportOutcome =
    {
        state = bray.runtime.bootstrap.RUN_COMPLETED,
        payload = 0,
        report = bray.runtime.bootstrap.empty_panic_report()
    };

    let result = trusted invoke_owned(scope, operation, argument, &mut outcome);

    if outcome.state == bray.runtime.bootstrap.RUN_PANICKED
    {
        let pointer = std.memory.address_of_mut<bray.runtime.bootstrap.PanicReportData>(&mut outcome.report);

        let authorize = trusted lambda(
            pos report: &bray.runtime.bootstrap.PanicReportData,
            pos pointer: DataPointer<bray.runtime.bootstrap.PanicReportData>
        )
            requires(trusted bray.runtime.bootstrap.native_report_callbacks(report = report))
            ensures(trusted bray.runtime.bootstrap.native_report_slot_callbacks(pointer = pointer))
            executes(pure, total) {};

        trusted authorize(&outcome.report, pointer);

        _ = trusted bray.runtime.bootstrap.panic_reporting(pointer);
    }

    return result;
}

trusted internal func invoke_owned(
    pos scope: &Scope,
    pos operation: u32,
    pos argument: u64,
    pos outcome: &mut bray.runtime.bootstrap.ReportOutcome
) -> u32
    requires(
        operation >= 2 && operation <= 7,
        operation != 4 || blocking_execution(),
        operation != 5 || trusted native_entry(),
        trusted scope_live(owner = &scope.marker),
        trusted bray.runtime.bootstrap.native_report_callbacks(report = &outcome.report)
    )
    ensures(
        trusted scope_live(owner = &scope.marker),
        trusted bray.runtime.bootstrap.native_report_callbacks(report = &outcome.report)
    )
{
    let row = trusted worker(scope);
    let value = trusted domain(&row.pool);
    let pool = &row.pool;
    let input = std.memory.address_of<Reference>(pool);
    let wire = std.memory.address_of<Scope>(scope);
    let scope_pointer = std.memory.address_of<DataPointer<Scope>>(&wire);
    let output = std.memory.address_of_mut<bray.runtime.bootstrap.ReportOutcome>(outcome);
    let callback = value.callback.call;
    let context = value.callback.context;

    let authorize = trusted lambda(
        pos scope: &Scope,
        pos pool: &Reference,
        pos input: &DataPointer<Reference>,
        pos operation: u32,
        pos context: usize,
        pos scope_pointer: DataPointer<DataPointer<Scope>>,
        pos argument: u64,
        pos output: DataPointer<bray.runtime.bootstrap.ReportOutcome>
    )
        requires(
            trusted scope_live(owner = &scope.marker),
            trusted retained(owner = &pool.marker),
            operation >= 2 && operation <= 7
        )
        ensures(
            trusted callback_authorized(
                context = context,
                operation = operation,
                pool = input,
                scope = scope_pointer,
                argument = argument,
                outcome = output
            )
        )
        executes(pure, total) {};

    trusted authorize(scope, pool, &input, operation, context, scope_pointer, argument, output);

    let status = trusted perform(callback, context, operation, &input, scope_pointer, argument, output);

    let returned = trusted lambda(
        pos pointer: DataPointer<bray.runtime.bootstrap.ReportOutcome>,
        pos outcome: &mut bray.runtime.bootstrap.ReportOutcome
    )
        requires(trusted callback_returned(outcome = pointer))
        ensures(trusted bray.runtime.bootstrap.native_report_callbacks(report = &outcome.report))
        executes(pure, total) {};

    trusted returned(output, outcome);
    return status;
}

trusted internal func perform(
    pos callback: Operation,
    pos context: usize,
    pos operation: u32,
    pos pool: &DataPointer<Reference>,
    pos scope: DataPointer<DataPointer<Scope>>,
    pos argument: u64,
    pos outcome: DataPointer<bray.runtime.bootstrap.ReportOutcome>
) -> u32
    requires(
        operation != 4 || blocking_execution(),
        trusted callback_authorized(
            context = context,
            operation = operation,
            pool = pool,
            scope = scope,
            argument = argument,
            outcome = outcome
        )
    )
    ensures(trusted callback_returned(outcome = outcome))
    uses(foreign_call)
{
    let address = trusted lambda(
        pos context: usize,
        pos operation: u32,
        pos pool: &DataPointer<Reference>,
        pos scope: DataPointer<DataPointer<Scope>>,
        pos argument: u64,
        pos outcome: DataPointer<bray.runtime.bootstrap.ReportOutcome>
    ) -> DataPointer<Reference>
        requires(
            trusted callback_authorized(
                context = context,
                operation = operation,
                pool = pool,
                scope = scope,
                argument = argument,
                outcome = outcome
            )
        )
        ensures(
            trusted callback_authorized(
                context = context,
                operation = operation,
                pool = &result,
                scope = scope,
                argument = argument,
                outcome = outcome
            )
        )
        uses(raw_memory)
    {
        return trusted std.memory.read<DataPointer<Reference>>(std.memory.address_of<DataPointer<Reference>>(pool));
    };

    return trusted callback(
        context,
        operation,
        trusted address(context, operation, pool, scope, argument, outcome),
        scope,
        argument,
        outcome
    );
}

// Pool creation accepts one provider retention. Completion releases it after
// every OS entry has acknowledged cleanup. The canonical pool owns that interval.
trusted internal func invoke_pool(pos owner: &Reference, pos operation: u32)
    requires(
        trusted retained(owner = &owner.marker),
        operation != 4,
        operation == 0 || operation == 1 || operation == 8
    )
    ensures(trusted retained(owner = &owner.marker))
    when(trusted retiring(owner = owner))
    {
        ensures(trusted retiring(owner = owner))
    }
    uses(intrinsic)
{
    let value = trusted domain(owner);
    let input = std.memory.address_of<Reference>(owner);
    let wire = std.memory.null<Scope>();
    let scope_pointer = std.memory.address_of<DataPointer<Scope>>(&wire);

    let mut outcome: bray.runtime.bootstrap.ReportOutcome =
    {
        state = bray.runtime.bootstrap.RUN_COMPLETED,
        payload = 0,
        report = bray.runtime.bootstrap.empty_panic_report()
    };

    let output = std.memory.address_of_mut<bray.runtime.bootstrap.ReportOutcome>(&mut outcome);
    let context = value.callback.context;
    let callback = value.callback.call;

    let authorize = trusted lambda(
        pos owner: &Reference,
        pos input: &DataPointer<Reference>,
        pos context: usize,
        pos operation: u32,
        pos scope: DataPointer<DataPointer<Scope>>,
        pos outcome: DataPointer<bray.runtime.bootstrap.ReportOutcome>
    )
        requires(trusted retained(owner = &owner.marker), operation == 0 || operation == 1 || operation == 8)
        ensures(
            trusted callback_authorized(
                context = context,
                operation = operation,
                pool = input,
                scope = scope,
                argument = 0,
                outcome = outcome
            )
        )
        executes(pure, total) {};

    trusted authorize(owner, &input, context, operation, scope_pointer, output);

    if trusted perform(callback, context, operation, &input, scope_pointer, 0, output) != 0
    {
        trusted core.target.abort();
    }
}

trusted internal func retain_descriptor(pos formation: Descriptor) -> (Descriptor, WorkerReference)
    requires(trusted forming(owner = &formation.marker), trusted retained_worker(owner = &formation.reference.marker))
    ensures(
        trusted descriptor_owned(owner = &result.0.marker),
        trusted retained_worker(owner = &result.0.reference.marker),
        trusted retained_worker(owner = &result.1.marker)
    )
{
    let observer: WorkerReference =
    {
        marker = WorkerMarker
        {
        },
        pointer = formation.reference.pointer
    };

    return (formation, observer);
}

trusted internal func release_descriptor(pos descriptor: Descriptor)
    requires(
        trusted descriptor_owned(owner = &descriptor.marker),
        trusted retained_worker(owner = &descriptor.reference.marker)
    )
{
    trusted release_descriptor_resources(&descriptor);
}

trusted internal func release_descriptor_resources(pos descriptor: &Descriptor)
    requires(
        trusted descriptor_owned(owner = &descriptor.marker),
        trusted retained_worker(owner = &descriptor.reference.marker)
    )
    uses(intrinsic)
{
    let row = trusted retained_worker_value(&descriptor.reference);
    let pool = &row.pool;

    let retire =
    {
        let mut guard = trusted lock(&row.pool);
        let state = trusted locked_state(&row.pool, &mut guard);

        if state.live == 0
        {
            trusted core.target.abort();
        }

        state.live -= 1;

        yield if state.stopping && state.live == 0 && !state.completed
        {
            state.completed = true;
            yield true;
        }
        else
        {
            yield false;
        };
    };

    if retire
    {
        trusted invoke_pool(pool, 8);
        trusted invoke_pool(pool, 1);
    }
}

// A callback lends the actual retained pool record for exactly this C input scope.
// The address grants access for this call, while the borrowed input slot
// anchors the returned view. Neither one creates a new pool storage owner.
trusted internal func callback_pool(
    pos context: usize,
    pos operation: u32,
    pos pool: &DataPointer<Reference>,
    pos scope: DataPointer<DataPointer<Scope>>,
    pos argument: u64,
    pos outcome: DataPointer<bray.runtime.bootstrap.ReportOutcome>
) -> &Reference
    requires(
        trusted callback_authorized(
            context = context,
            operation = operation,
            pool = pool,
            scope = scope,
            argument = argument,
            outcome = outcome
        )
    )
    ensures(
        trusted callback_authorized(
            context = context,
            operation = operation,
            pool = pool,
            scope = scope,
            argument = argument,
            outcome = outcome
        ),
        trusted retained(owner = &result.marker),
        trusted bray.runtime.bootstrap.entry.native_entry(),
        trusted bray.runtime.bootstrap.host.product.native_host(),
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted core.memory.valid_read<bray.runtime.bootstrap.ReportOutcome>(pointer = outcome, count = 1),
        trusted core.memory.initialized_as<bray.runtime.bootstrap.ReportOutcome>(pointer = outcome),
        trusted core.memory.aligned_for<bray.runtime.bootstrap.ReportOutcome>(pointer = outcome)
    )
    when(operation >= 2 && operation <= 7)
    {
        ensures(trusted scope_slot(pointer = scope))
    }
    uses(raw_memory)
{
    let pointer = trusted std.memory.read<DataPointer<Reference>>(std.memory.address_of<DataPointer<Reference>>(pool));

    let authorize = trusted lambda(
        pos context: usize,
        pos operation: u32,
        pos pool: &DataPointer<Reference>,
        pos scope: DataPointer<DataPointer<Scope>>,
        pos argument: u64,
        pos outcome: DataPointer<bray.runtime.bootstrap.ReportOutcome>,
        pos pointer: DataPointer<Reference>
    )
        requires(
            trusted callback_authorized(
                context = context,
                operation = operation,
                pool = pool,
                scope = scope,
                argument = argument,
                outcome = outcome
            )
        )
        ensures(trusted reference_slot(pointer = pointer))
        executes(pure, total) {};

    trusted authorize(context, operation, pool, scope, argument, outcome, pointer);
    return trusted borrow_reference(pool, pointer);
}
