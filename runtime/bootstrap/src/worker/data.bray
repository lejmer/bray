@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.worker;

using core.atomic;
using core.memory;
using std.memory;
using std.sync;
using internal bray.runtime.bootstrap.scheduler;
using internal bray.runtime.bootstrap.host;
using internal std.sync.spin_lock;

@layout(c)
internal struct Marker
{
}

@layout(c)
internal struct Reference
{
    marker: Marker;
    pointer: DataPointer<Domain>;
}

internal callable Operation = @abi(c) trusted func(
    pos context: usize,
    pos operation: u32,
    pos pool: DataPointer<Reference>,
    pos scope: DataPointer<DataPointer<Scope>>,
    pos argument: u64,
    pos outcome: DataPointer<bray.runtime.bootstrap.ReportOutcome>
) -> u32
    requires(
        operation != 4 || blocking_execution(),
        trusted callback_authorized(
            context = context,
            operation = operation,
            pool = &pool,
            scope = scope,
            argument = argument,
            outcome = outcome
        )
    )
    ensures(
        trusted core.memory.valid_read<bray.runtime.bootstrap.ReportOutcome>(pointer = outcome, count = 1),
        trusted core.memory.valid_write<bray.runtime.bootstrap.ReportOutcome>(pointer = outcome, count = 1),
        trusted core.memory.initialized_as<bray.runtime.bootstrap.ReportOutcome>(pointer = outcome),
        trusted core.memory.aligned_for<bray.runtime.bootstrap.ReportOutcome>(pointer = outcome),
        trusted callback_returned(outcome = outcome)
    );

trusted internal predicate callback_authorized(
    context: usize,
    operation: u32,
    pool: &DataPointer<Reference>,
    scope: DataPointer<DataPointer<Scope>>,
    argument: u64,
    outcome: DataPointer<bray.runtime.bootstrap.ReportOutcome>
);

trusted internal predicate callback_returned(outcome: DataPointer<bray.runtime.bootstrap.ReportOutcome>);

// The template borrows the native binding. Each admitted OS entry retains its own descriptor.
@copy
@layout(c)
internal struct Callback
{
    context: usize;
    call: Operation;
}

@copy
@layout(c)
internal struct Failure
{
    mut stage: u32;
    mut category: u32;
    mut native_code: i64;
}

internal struct Domain
{
    allocation: std.memory.RawAllocation;
    scheduler: bray.runtime.bootstrap.scheduler.Reference;
    execution: bray.runtime.bootstrap.execution.Reference?;
    callback: Callback;
    demand_service: Demand;
    stop_service: Stop;
    detach_service: Detach;
    destroy_service: Destroy;
    state: std.sync.SpinLock<State>;
}

internal struct State
{
    mut stopping: bool;
    mut entries: std.memory.RawBuffer<std.memory.RawBuffer<Worker>>?;
    mut count: [usize; 3];
    mut idle_blocking: usize;
    mut live: usize;
    mut completed: bool;
}

// One stable allocation admits native ownership, startup acknowledgement,
// detach notification and terminal storage before OS creation.
internal struct Worker
{
    pool: Reference;
    workload: u32;
    handle: core.atomic.Atomic<u64>;
    identity: core.atomic.Atomic<u64>;
    startup: core.atomic.Atomic<u32>;
    terminal: core.atomic.Atomic<u32>;
    detach: core.atomic.Atomic<u32>;
    formation: core.atomic.Atomic<u32>;
    failure_stage: core.atomic.Atomic<u32>;
    failure_category: core.atomic.Atomic<u32>;
    failure_code: core.atomic.Atomic<i64>;
}

// Slot retention, launch ownership and an entered thread have independent lifetimes.
@layout(c)
internal struct WorkerMarker
{
}

@layout(c)
internal struct FormationMarker
{
}

@layout(c)
internal struct ScopeMarker
{
}

internal struct WorkerReference
{
    marker: WorkerMarker;
    pointer: DataPointer<Worker>;
}

// A formation claim and its committed native descriptor keep one complete carrier.
internal struct Descriptor
{
    marker: FormationMarker;
    reference: WorkerReference;
}

trusted internal predicate forming(owner: &FormationMarker);

trusted internal predicate descriptor_owned(owner: &FormationMarker);

internal struct Scope
{
    marker: ScopeMarker;
    worker: Descriptor;
    mut execution: Uninit<(bray.runtime.bootstrap.host.ExecutionOwner?)>;
    attachment: u64;
    native_thread: u64;
}

trusted internal predicate retained(owner: &Marker);

trusted internal predicate retirement_owned(owner: &Marker);

internal predicate retiring(owner: &Reference) = retirement_owned(owner = &owner.marker);

trusted internal predicate reference_slot(pointer: DataPointer<Reference>);

trusted internal predicate retirement_entry(pointer: DataPointer<Reference>);

trusted internal predicate callback_slot(pointer: DataPointer<Callback>);

trusted internal predicate scope_slot(pointer: DataPointer<DataPointer<Scope>>);

trusted internal predicate scope_live(owner: &ScopeMarker);

trusted internal predicate scope_owned(owner: &ScopeMarker);

trusted internal predicate native_entry();

trusted internal predicate retained_worker(owner: &WorkerMarker);

trusted internal predicate formation_entry();

trusted internal predicate stop_entry();

internal func no_failure() -> Failure
{
    return
    {
        stage = 0,
        category = 0,
        native_code = 0
    };
}

internal union FormationChoice
{
    Existing(pos owner: WorkerReference);
    Created(pos formation: Descriptor);
    Backing;
}

trusted internal predicate acquisition_for(owner: &Marker, marker: &std.sync.spin_lock.Marker);
