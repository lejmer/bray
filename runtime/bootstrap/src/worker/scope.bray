@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.worker;

using core.memory;
using core.target;
using std.memory;
using internal bray.runtime.bootstrap.scheduler;
using internal std.thread;

// The native caller retains this exact input slot throughout the callback.
// Borrow the actual scope rather than issuing another pointer-and-marker owner.
trusted internal func read_scope(pos input: &DataPointer<DataPointer<Scope>>, pos pointer: DataPointer<DataPointer<Scope>>) -> &Scope
    requires(trusted scope_slot(pointer = pointer))
    ensures(trusted scope_live(owner = &result.marker))
    executes(pure, total)
    uses(raw_memory, unchecked_alias)
{
    let readable = trusted lambda(pos pointer: DataPointer<DataPointer<Scope>>)
        requires(trusted scope_slot(pointer = pointer))
        ensures(
            trusted core.memory.valid_read<DataPointer<Scope>>(pointer = pointer, count = 1),
            trusted core.memory.aligned_for<DataPointer<Scope>>(pointer = pointer),
            trusted core.memory.initialized_as<DataPointer<Scope>>(pointer = pointer)
        )
        executes(pure, total) {};

    trusted readable(pointer);

    let address = trusted std.memory.read<DataPointer<Scope>>(pointer);
    let authorize = trusted lambda(pos input: &DataPointer<DataPointer<Scope>>, pos pointer: DataPointer<DataPointer<Scope>>, pos address: DataPointer<Scope>)
        requires(trusted scope_slot(pointer = pointer))
        ensures(
            trusted core.memory.valid_read<Scope>(pointer = address, count = 1),
            trusted core.memory.aligned_for<Scope>(pointer = address),
            trusted core.memory.initialized_as<Scope>(pointer = address),
            trusted core.memory.shared_alias_valid<Scope>(pointer = address),
            trusted core.memory.epoch_current<Scope>(pointer = address),
            trusted core.memory.synchronized_access<Scope>(pointer = address),
            trusted core.memory.movement_stable<Scope>(pointer = address),
            trusted core.memory.finalization_pending<Scope>(pointer = address)
        )
        executes(pure, total) {};

    trusted authorize(input, pointer, address);
    return trusted std.memory.borrow_from<Scope, DataPointer<DataPointer<Scope>>>(input, address);
}

trusted internal func worker(pos owner: &Scope) -> &Worker
    requires(trusted scope_live(owner = &owner.marker))
    ensures(trusted scope_live(owner = &owner.marker), trusted retained(owner = &result.pool.marker))
    executes(pure, total)
    uses(raw_memory, unchecked_alias)
{
    let pointer = owner.worker.reference.pointer;

    let authorize = trusted lambda(pos owner: &Scope, pos pointer: DataPointer<Worker>)
        requires(trusted scope_live(owner = &owner.marker))
        ensures(
            trusted core.memory.valid_read<Worker>(pointer = pointer, count = 1),
            trusted core.memory.aligned_for<Worker>(pointer = pointer),
            trusted core.memory.initialized_as<Worker>(pointer = pointer),
            trusted core.memory.shared_alias_valid<Worker>(pointer = pointer),
            trusted core.memory.epoch_current<Worker>(pointer = pointer),
            trusted core.memory.synchronized_access<Worker>(pointer = pointer),
            trusted core.memory.movement_stable<Worker>(pointer = pointer),
            trusted core.memory.finalization_pending<Worker>(pointer = pointer)
        )
        executes(pure, total) {};

    trusted authorize(owner, pointer);

    return trusted std.memory.borrow_from<Worker, Scope>(owner, pointer);
}

// The OS entry owns the attachment and root until all exact-thread cleanup returns.
// A nested foreign entry cannot derive this witness from its attachment identity.
@abi(c)
trusted internal func compatibility(
    pos pointer: DataPointer<DataPointer<Scope>>,
    pos required: DataPointer<bray.runtime.bootstrap.scheduler.Requirements>
) -> u32
    requires(
        trusted scope_slot(pointer = pointer),
        trusted bray.runtime.bootstrap.scheduler.requirements_slot(pointer = required)
    )
{
    // The private slot already identifies this thread's admitted live OS-entry scope.
    let value = trusted read_scope(&pointer, pointer);

    let lane: bray.runtime.bootstrap.scheduler.Lane =
    {
        placement = 1,
        workload = 3,
        thread = value.attachment
    };

    let lane_pointer = std.memory.address_of<bray.runtime.bootstrap.scheduler.Lane>(&lane);

    let authorize = trusted lambda(
        pos root: &Scope,
        pos lane_pointer: DataPointer<bray.runtime.bootstrap.scheduler.Lane>
    )
        requires(trusted scope_live(owner = &root.marker))
        ensures(trusted bray.runtime.bootstrap.scheduler.lane_slot(pointer = lane_pointer))
        executes(pure, total) {};

    trusted authorize(value, lane_pointer);
    return trusted bray.runtime.bootstrap.scheduler.compatibility(lane_pointer, required, value.attachment);
}

// Only the native continuing-driver boundary supplies this optional live slot.
// A present value is the actual Source-owned OS-entry scope, never an ID lookup.
trusted internal func driver_scope(pos pointer: DataPointer<DataPointer<Scope>>) -> u64?
    requires(trusted bray.runtime.bootstrap.scheduler.driver_entry(scope = pointer))
    uses(intrinsic, raw_memory)
{
    let authorize = trusted lambda(pos pointer: DataPointer<DataPointer<Scope>>)
        requires(trusted bray.runtime.bootstrap.scheduler.driver_entry(scope = pointer))
        ensures(
            trusted core.memory.valid_read<DataPointer<Scope>>(pointer = pointer, count = 1),
            trusted core.memory.aligned_for<DataPointer<Scope>>(pointer = pointer),
            trusted core.memory.initialized_as<DataPointer<Scope>>(pointer = pointer),
            trusted scope_slot(pointer = pointer)
        )
        executes(pure, total) {};

    trusted authorize(pointer);

    if trusted core.target.expose_address<Scope>(trusted std.memory.read<DataPointer<Scope>>(pointer)) == 0
    {
        return none;
    }

    let scope = trusted read_scope(&pointer, pointer);

    return scope.attachment;
}
