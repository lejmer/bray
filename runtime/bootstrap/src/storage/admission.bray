@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.storage;

using std.memory;
using internal std.memory;
using internal bray.runtime.bootstrap;
using internal bray.runtime.bootstrap.heap;

trusted internal func shapes(pos pool: &mut bray.runtime.bootstrap.ReportPool) -> &mut [Shape]
    uses(intrinsic, raw_memory)
{
    if let ?storage = pool.storage
    {
        return trusted std.memory.initialized_slice_mut<Shape>(&mut storage);
    }

    trusted core.target.abort();
}

trusted internal func find(pos pool: &mut bray.runtime.bootstrap.ReportPool, pos descriptor: &Descriptor) -> usize
{
    if pool.storage matches none
    {
        return 0;
    }

    let values = trusted shapes(pool);
    let mut index: usize = 0;

    while index < values.length()
    {
        if same_shape(&values[index].descriptor, descriptor)
        {
            return index + 1;
        }

        index += 1;
    }

    return 0;
}

trusted internal func register(pos pool: &mut bray.runtime.bootstrap.ReportPool, pos descriptor: Descriptor) -> usize
{
    let existing: usize = trusted find(pool, &descriptor);

    if existing != 0
    {
        return existing;
    }

    if !valid_layout(&descriptor)
    {
        return 0;
    }

    if !trusted bray.runtime.bootstrap.heap.reserve<Shape>(&mut pool.storage)
    {
        return 0;
    }

    if let ?storage = pool.storage
    {
        trusted internal std.memory.initialize_spare<Shape>(
            &mut storage,
            {
                descriptor = descriptor,
                slabs = none,
                free = 0,
                available = 0,
                total = 0,
                credits = 0
            }
        );

        return std.memory.initialized_count<Shape>(&storage);
    }

    return 0;
}

trusted internal func reserve(pos shape: &mut Shape, pos count: usize) -> bool
    uses(intrinsic)
{
    if count <= shape.available
    {
        return true;
    }

    let maximum: usize = (~0) >> 1;
    let padding: usize = shape.descriptor.align - 1;

    if padding >= maximum || shape.descriptor.bytes > maximum - padding
    {
        return false;
    }

    let stride: usize = (shape.descriptor.bytes + padding) & ~padding;
    let required: usize = count - shape.available;
    let mut additional: usize = required;

    if shape.total > required && shape.total <= maximum / 2
    {
        additional = shape.total;
    }

    if stride != 0 && additional > (maximum - padding - 1) / stride
    {
        return false;
    }

    if additional > maximum - shape.total
    {
        return false;
    }

    let bytes: usize = stride * additional + padding + 1;

    let mut region: std.memory.RawBuffer<u8> = match consume trusted bray.runtime.bootstrap.heap.try_buffer<u8>(bytes)
    {
        case ?buffer { yield buffer; }
        case none { return false; }
    };

    let mut entries: std.memory.RawBuffer<Slot> = match consume trusted bray.runtime.bootstrap.heap.try_buffer<Slot>(
        additional
    )
    {
        case ?buffer { yield buffer; }
        case none { return false; }
    };

    if !trusted bray.runtime.bootstrap.heap.reserve<Slab>(&mut shape.slabs)
    {
        return false;
    }

    let pointer: RawPointer<u8> = std.memory.pointer<u8>(&region);
    let address: usize = trusted core.target.expose_address<u8>(pointer);
    let skip: usize = (shape.descriptor.align - (address & padding)) & padding;
    let first: usize = shape.total + 1;
    let mut head: usize = shape.free;
    let mut index: usize = 0;

    while index < additional
    {
        trusted internal std.memory.initialize_spare<Slot>(
            &mut entries,
            {
                epoch = 0,
                state = FREE,
                next = head,
                address = address + skip + index * stride
            }
        );

        head = first + index;
        index += 1;
    }

    if let ?slabs = shape.slabs
    {
        trusted internal std.memory.initialize_spare<Slab>(
            &mut slabs,
            {
                first = first,
                slots = entries,
                bytes = region
            }
        );

        shape.free = head;
        shape.total += additional;
        shape.available += additional;
        return true;
    }

    trusted core.target.abort();
}

trusted internal func release(pos pool: &mut bray.runtime.bootstrap.ReportPool) -> bool
    uses(manual_alloc)
{
    if pool.storage matches none
    {
        return true;
    }

    {
        let values = trusted shapes(pool);
        let mut index: usize = 0;

        while index < values.length()
        {
            if values[index].credits != 0 || values[index].available != values[index].total
            {
                return false;
            }

            index += 1;
        }
    }

    if let ?storage = pool.storage
    {
        trusted internal std.memory.raw_buffer_release<Shape>(&mut storage);
    }

    pool.storage = none;
    return true;
}
