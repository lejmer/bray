@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.storage;

using std.numeric;
using core.target;
using std.memory;
using internal bray.runtime.bootstrap.pool.growth;
using internal std.memory;
using internal bray.runtime.bootstrap;
using internal bray.runtime.bootstrap.heap;

trusted internal func shapes(pos pool: &mut bray.runtime.bootstrap.ReportPool) -> &mut [Shape]
    uses(intrinsic, raw_memory)
{
    if let ?storage = pool.storage
    {
        return trusted std.memory.initialized_slice_mut<Shape>(&mut storage);
    }

    trusted core.target.abort();
}

trusted internal func find(pos pool: &mut bray.runtime.bootstrap.ReportPool, pos descriptor: &Descriptor) -> usize
{
    if pool.storage matches none
    {
        return 0;
    }

    let values = trusted shapes(pool);
    let mut index: usize = 0;

    while index < values.length()
    {
        if same_shape(&values[index].descriptor, descriptor)
        {
            return index + 1;
        }

        index += 1;
    }

    return 0;
}

trusted internal func register(
    pos pool: &mut bray.runtime.bootstrap.ReportPool,
    pos descriptor: Descriptor,
    pos prepared: &mut bray.runtime.bootstrap.pool.growth.Prepared
) -> Result<usize, bray.runtime.bootstrap.pool.growth.Request>
{
    let existing: usize = trusted find(pool, &descriptor);

    if existing != 0
    {
        return Ok(existing);
    }

    if !valid_layout(&descriptor)
    {
        return Ok(0);
    }

    match consume trusted bray.runtime.bootstrap.heap.reserve<Shape>(&mut pool.storage, &mut prepared.shapes)
    {
        case Ok(ready)
        {
            if !ready
            {
                return Ok(0);
            }
        }
        case Error(count) { return Error(bray.runtime.bootstrap.pool.growth.Request.Shapes(count)); }
    }

    if let ?storage = pool.storage
    {
        trusted internal std.memory.initialize_spare<Shape>(
            &mut storage,
            {
                descriptor = descriptor,
                slabs = none,
                free = 0,
                available = 0,
                total = 0,
                credits = 0
            }
        );

        return Ok(std.memory.initialized_count<Shape>(&storage));
    }

    return Ok(0);
}

trusted internal func reserve(
    pos shape: &mut Shape,
    pos count: usize,
    pos prepared: &mut bray.runtime.bootstrap.pool.growth.Prepared
) -> Result<bool, bray.runtime.bootstrap.pool.growth.Request>
    uses(intrinsic)
{
    if count <= shape.available
    {
        return Ok(true);
    }

    let maximum: usize = std.numeric.USIZE_MAX >> 1;
    let padding: usize = shape.descriptor.align - 1;

    if padding >= maximum || shape.descriptor.bytes > maximum - padding
    {
        return Ok(false);
    }

    let stride: usize = (shape.descriptor.bytes + padding) & ~padding;
    let required: usize = count - shape.available;
    let mut additional: usize = required;

    if shape.total > required && shape.total <= maximum / 2
    {
        additional = shape.total;
    }

    if stride != 0 && additional > (maximum - padding - 1) / stride
    {
        return Ok(false);
    }

    if additional > maximum - shape.total
    {
        return Ok(false);
    }

    let bytes: usize = stride * additional + padding + 1;

    match consume trusted bray.runtime.bootstrap.heap.reserve<Slab>(&mut shape.slabs, &mut prepared.storage_slabs)
    {
        case Ok(ready)
        {
            if !ready
            {
                return Ok(false);
            }
        }
        case Error(capacity) { return Error(bray.runtime.bootstrap.pool.growth.Request.StorageSlabs(capacity)); }
    }

    let ready = if let ?region = prepared.bytes && let ?entries = prepared.slots
    {
        yield region.capacity >= bytes && entries.capacity >= additional && region.initialized == 0 &&
            entries.initialized == 0;
    }
    else
    {
        yield false;
    };

    if !ready
    {
        return Error(bray.runtime.bootstrap.pool.growth.Request.Storage((bytes, additional)));
    }

    let mut region = match consume trusted std.memory.replace_value<(std.memory.RawBuffer<u8>?)>(
        &mut prepared.bytes,
        none
    )
    {
        case ?buffer { yield buffer; }
        case none { return trusted core.target.abort(); }
    };

    let mut entries = match consume trusted std.memory.replace_value<(std.memory.RawBuffer<Slot>?)>(
        &mut prepared.slots,
        none
    )
    {
        case ?buffer { yield buffer; }
        case none { return trusted core.target.abort(); }
    };

    let pointer: DataPointer<u8> = std.memory.pointer<u8>(&region);
    let address: usize = trusted core.target.expose_address<u8>(pointer);
    let skip: usize = (shape.descriptor.align - (address & padding)) & padding;
    let first: usize = shape.total + 1;
    let mut head: usize = shape.free;
    let mut index: usize = 0;

    while index < additional
    {
        trusted internal std.memory.initialize_spare<Slot>(
            &mut entries,
            {
                epoch = 0,
                state = State.Free(head),
                address = address + skip + index * stride
            }
        );

        head = first + index;
        index += 1;
    }

    if let ?slabs = shape.slabs
    {
        trusted internal std.memory.initialize_spare<Slab>(
            &mut slabs,
            {
                first = first,
                slots = entries,
                bytes = region
            }
        );

        shape.free = head;
        shape.total += additional;
        shape.available += additional;
        return Ok(true);
    }

    trusted core.target.abort();
}

trusted internal func can_release(pos pool: &mut bray.runtime.bootstrap.ReportPool) -> bool
{
    if pool.storage matches none
    {
        return true;
    }

    let values = trusted shapes(pool);
    let mut index: usize = 0;

    while index < values.length()
    {
        if values[index].credits != 0 || values[index].available != values[index].total
        {
            return false;
        }

        index += 1;
    }

    return true;
}
