@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap;

using std.memory;
using internal bray.runtime.bootstrap.pool.growth;
using internal bray.runtime.bootstrap.pool;
using internal std.memory;

internal struct ReportSlab
{
    first: usize;
    mut records: std.memory.RawBuffer<ReportRecord>;
}

internal struct ReportPool
{
    mut slabs: std.memory.RawBuffer<ReportSlab>?;
    mut free: usize;
    mut available: usize;
    mut total: usize;
    mut credits: usize;
    mut storage: std.memory.RawBuffer<bray.runtime.bootstrap.storage.Shape>?;
    mut next_epoch: u64;
    mut remaining_epochs: u64;
}

trusted internal func slab_index(pos pool: &mut ReportPool) -> &mut std.memory.RawBuffer<ReportSlab>
    uses(intrinsic)
{
    if let ?slabs = pool.slabs
    {
        return &mut slabs;
    }

    trusted core.target.abort();
}

trusted internal func reserve_records(
    pos pool: &mut ReportPool,
    pos count: usize,
    pos prepared: &mut bray.runtime.bootstrap.pool.growth.Prepared
) -> Result<bool, bray.runtime.bootstrap.pool.growth.Request>
{
    if count <= pool.available
    {
        return Ok(true);
    }

    let required: usize = count - pool.available;
    let maximum: usize = ~0;
    let limit: usize = maximum / std.memory.size_of<ReportRecord>() - pool.total;

    if required > limit
    {
        return Ok(false);
    }

    let mut additional: usize = required;

    if pool.total > required && pool.total <= limit
    {
        additional = pool.total;
    }

    match consume trusted internal bray.runtime.bootstrap.heap.reserve<ReportSlab>(
        &mut pool.slabs,
        &mut prepared.record_slabs
    )
    {
        case Ok(ready)
        {
            if !ready
            {
                return Ok(false);
            }
        }
        case Error(capacity) { return Error(bray.runtime.bootstrap.pool.growth.Request.RecordSlabs(capacity)); }
    }

    if let ?records = prepared.records
    {
        if records.capacity < additional || records.initialized != 0
        {
            return Error(bray.runtime.bootstrap.pool.growth.Request.Records(additional));
        }
    }
    else
    {
        return Error(bray.runtime.bootstrap.pool.growth.Request.Records(additional));
    }

    let allocation = trusted std.memory.replace_value<(std.memory.RawBuffer<ReportRecord>?)>(
        &mut prepared.records,
        none
    );

    match consume allocation
    {
        case ?storage
        {
            let mut slab: std.memory.RawBuffer<ReportRecord> = storage;

            let first: usize = pool.total + 1;
            let mut head: usize = pool.free;
            let mut index: usize = 0;

            while index < additional
            {
                trusted internal std.memory.initialize_spare<ReportRecord>(
                    &mut slab,
                    {
                        value = trusted panic_record(trusted stored_primary(empty_primary())),
                        message = none,
                        next = head,
                        segment =
                        {
                            ordinal = 0,
                            task = 0,
                            frame = [0; 32],
                            state = 0
                        },
                        segment_tail = 0,
                        segment_count = 0,
                    },
                );

                head = first + index;
                index += 1;
            }

            let entry: ReportSlab =
            {
                first = first,
                records = slab
            };

            trusted internal std.memory.initialize_spare<ReportSlab>(trusted slab_index(pool), entry);
            pool.free = head;
            pool.available += additional;
            pool.total += additional;
            return Ok(true);
        }
        case none { return Ok(false); }
    }
}

trusted internal func record(pos pool: &mut ReportPool, pos handle: usize) -> &mut ReportRecord
    uses(intrinsic, raw_memory)
{
    if handle == 0 || handle > pool.total
    {
        trusted core.target.abort();
    }

    let index: &mut std.memory.RawBuffer<ReportSlab> = trusted slab_index(pool);
    let slabs: &mut [ReportSlab] = trusted std.memory.initialized_slice_mut<ReportSlab>(index);
    let mut low: usize = 0;
    let mut high: usize = slabs.length();

    // Stable opaque ordinals select owned storage without reconstructing addresses.
    while low + 1 < high
    {
        let middle: usize = low + (high - low) / 2;

        if slabs[middle].first <= handle
        {
            low = middle;
        }
        else
        {
            high = middle;
        }
    }

    let first: usize = slabs[low].first;
    let records: &mut [ReportRecord] = trusted std.memory.initialized_slice_mut<ReportRecord>(&mut slabs[low].records);

    return &mut records[handle - first];
}

trusted internal func activate_record(pos pool: &mut ReportPool) -> usize
    uses(intrinsic)
{
    let head: usize = pool.free;

    if head == 0
    {
        trusted core.target.abort();
    }

    let next: usize =
    {
        let entry: &mut ReportRecord = trusted record(pool, head);
        let next: usize = entry.next;

        entry.next = 0;
        yield next;
    };

    pool.free = next;
    pool.available -= 1;
    return head;
}

@abi(c)
trusted internal func report_records_admit(pos count: usize, pos destination: RawPointer<ReportRecords>) -> u32
    requires(
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted core.memory.valid_write<ReportRecords>(pointer = destination, count = 1),
        trusted core.memory.aligned_for<ReportRecords>(pointer = destination),
        trusted core.memory.valid_read<ReportRecords>(pointer = destination, count = 1),
        trusted core.memory.initialized_as<ReportRecords>(pointer = destination)
    )
    uses(raw_memory, unchecked_init)
{
    let output: ReportRecords = trusted std.memory.read<ReportRecords>(destination);
    let (status, updated) = trusted admit_record_values(count, output, destination);

    trusted std.memory.write<ReportRecords>(destination, updated);
    return status;
}

trusted internal func admit_record_values(
    pos count: usize,
    pos mut output: ReportRecords,
    pos destination: RawPointer<ReportRecords>
) -> (u32, ReportRecords)
    requires(
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted core.memory.valid_write<ReportRecords>(pointer = destination, count = 1),
        trusted core.memory.aligned_for<ReportRecords>(pointer = destination),
    )
    ensures(
        trusted core.memory.valid_write<ReportRecords>(pointer = destination, count = 1),
        trusted core.memory.aligned_for<ReportRecords>(pointer = destination),
    )
{
    let mut prepared = bray.runtime.bootstrap.pool.growth.empty();

    while true
    {
        let request =
        {
            let mut guard = trusted bray.runtime.bootstrap.pool.lock();
            let pool = guard.get();
            let maximum: usize = ~0;

            if count > maximum - pool.credits
            {
                return (1, output);
            }

            let requested = pool.credits + count;

            yield match consume trusted reserve_records(pool, requested, &mut prepared)
            {
                case Error(request) { yield request; }
                case Ok(ready)
                {
                    if !ready
                    {
                        return (1, output);
                    }

                    let mut remaining = count;

                    while remaining != 0
                    {
                        let handle = trusted activate_record(pool);

                        trusted append_record(pool, &mut output, handle);
                        remaining -= 1;
                    }

                    return (0, output);
                }
            };
        };

        if !trusted bray.runtime.bootstrap.pool.growth.prepare(&mut prepared, request)
        {
            return (1, output);
        }
    }
}

trusted internal func pop_record_value(pos mut value: ReportRecords) -> (ReportRecords, ReportValue)
    requires(trusted bray.runtime.bootstrap.pool.protocol_access())
    ensures(trusted retained_report_value(value = &result.1))
{
    let mut guard = trusted bray.runtime.bootstrap.pool.lock();
    let pool: &mut ReportPool = guard.get();
    let handle: usize = trusted detach_record(pool, &mut value);
    let head: usize = pool.free;

    let payload: ReportValue =
    {
        let entry: &mut ReportRecord = trusted record(pool, handle);

        let payload = trusted std.memory.replace_value<ReportValue>(
            &mut entry.value,
            trusted panic_record(trusted stored_primary(empty_primary()))
        );

        entry.segment_count = 0;
        entry.segment_tail = 0;
        entry.next = head;

        yield payload;
    };

    pool.free = handle;
    pool.available += 1;

    return (value, payload);
}
