@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap;

using std.memory;
using internal std.memory;
using internal std.sync;

internal callable PanicMessageCopy = @abi(c) trusted func(
    pos address: usize,
    pos offset: usize,
    pos destination: RawPointer<u8>,
    pos length: usize,
) -> u32
    requires(trusted core.memory.valid_write<u8>(pointer = destination, count = length));

internal callable PanicMessageRelease = @abi(c) trusted func(
    pos address: usize,
    pos length: usize,
    pos outcome: RawPointer<u8>,
);

trusted internal func empty_panic_report() -> PanicReportData
    ensures(trusted native_report_callbacks(report = &result))
    executes(pure, total)
{
    return
    {
        source_present = 0,
        source_identity = 0,
        source_start = 0,
        source_end = 0,
        source_version = 0,
        source_namespace_word_0 = 0,
        source_namespace_word_1 = 0,
        source_namespace_word_2 = 0,
        source_namespace_word_3 = 0,
        cause = 0,
        message = 0,
        message_length = 0,
        copy_message = std.memory.null<u8>(),
        release_message = std.memory.null<u8>(),
        outgoing_head = 0,
        outgoing_tail = 0,
        outgoing_count = 0,
        reserved = 0,
        consumer = std.memory.null<u8>(),
    };
}

@abi(c)
trusted internal func panic_report_construction(
    pos cause: u32,
    pos source_present: u32,
    pos source_identity: u32,
    pos source_start: u32,
    pos source_end: u32,
    pos source_version: u64,
    pos source_namespace_word_0: u64,
    pos source_namespace_word_1: u64,
    pos source_namespace_word_2: u64,
    pos source_namespace_word_3: u64,
    pos message: RawPointer<u8>,
    pos message_length: usize,
) -> PanicReportData
    ensures(trusted native_report_callbacks(report = &result))
    requires(
        trusted core.memory.valid_read<u8>(pointer = message, count = message_length),
        trusted core.memory.initialized_range_as<u8>(pointer = message, count = message_length),
    )
    uses(intrinsic, layout_reinterpret)
{
    let handle: usize = trusted retain_panic_message(message, message_length);

    if cause > 2 || source_present > 1 || source_start > source_end || (message_length != 0 && core.memory.is_null<u8>(message))
    {
        trusted core.target.abort();
    }

    let mut report: PanicReportData = empty_panic_report();

    report.source_present = source_present;
    report.source_identity = source_identity;
    report.source_start = source_start;
    report.source_end = source_end;
    report.source_version = source_version;
    report.source_namespace_word_0 = source_namespace_word_0;
    report.source_namespace_word_1 = source_namespace_word_1;
    report.source_namespace_word_2 = source_namespace_word_2;
    report.source_namespace_word_3 = source_namespace_word_3;
    report.cause = cause;

    if message_length != 0
    {
        if handle == 0
        {
            report.cause = PANIC_ALLOCATION_FAILURE;
        }
        else
        {
            report.message = handle;
            report.message_length = message_length;
        }
    }

    let copy: PanicMessageCopy = panic_message_copy;
    let release: PanicMessageRelease = panic_message_release;

    report.copy_message = trusted std.memory.reinterpret<u8, PanicMessageCopy>(
        trusted std.memory.pointer_from_callable(copy)
    );

    report.release_message = trusted std.memory.reinterpret<u8, PanicMessageRelease>(
        trusted std.memory.pointer_from_callable(release)
    );

    report.consumer = trusted consume_pointer();

    let _: u64 = core.atomic.fetch_add<u64, 0>(&CONSTRUCTED_REPORTS, value = 1);

    return report;
}

trusted internal func retain_panic_message(pos source: RawPointer<u8>, pos count: usize) -> usize
    uses(unchecked_init)
    requires(
        trusted core.memory.valid_read<u8>(pointer = source, count = count),
        trusted core.memory.initialized_range_as<u8>(pointer = source, count = count),
    )
{
    if count == 0
    {
        return 0;
    }

    let allocation: std.memory.RawBuffer<u8>? = trusted allocate_message_storage(source, count);

    return match consume allocation
    {
        case ?buffer
        {
            let mut storage: std.memory.RawBuffer<u8> = buffer;
            let initialized: usize = trusted internal std.memory.copy_spare_raw_bytes(&mut storage, source = source, count = count);

            trusted std.memory.set_initialized_count<u8>(&mut storage, count = initialized);
            yield trusted retain_message_storage(storage);
        }
        case none { yield 0; }
    };
}

// Fresh allocation does not access the native caller's immutable message range.
trusted internal func allocate_message_storage(pos source: RawPointer<u8>, pos count: usize) -> std.memory.RawBuffer<u8>?
    requires(
        trusted core.memory.valid_read<u8>(pointer = source, count = count),
        trusted core.memory.initialized_range_as<u8>(pointer = source, count = count),
    )
    ensures(
        trusted core.memory.valid_read<u8>(pointer = source, count = count),
        trusted core.memory.initialized_range_as<u8>(pointer = source, count = count),
    )
{
    return trusted internal bray.runtime.bootstrap.heap.try_buffer<u8>(count);
}

trusted internal func retain_message_storage(pos storage: std.memory.RawBuffer<u8>) -> usize
{
    let mut guard = RECORD_POOL.lock();
    let pool: &mut ReportPool = guard.get();
    let maximum: usize = ~0;

    if pool.credits == maximum
    {
        return 0;
    }

    let requested: usize = pool.credits + 1;

    if !trusted reserve_records(pool, requested)
    {
        return 0;
    }

    let handle: usize = trusted activate_record(pool);
    let entry: &mut ReportRecord = trusted record(pool, handle);

    entry.message = storage;
    return handle;
}

trusted internal func message_copy_lock(pos destination: RawPointer<u8>, pos count: usize) -> std.sync.SpinLockGuard<ReportPool>
    requires(trusted core.memory.valid_write<u8>(pointer = destination, count = count))
    ensures(trusted core.memory.valid_write<u8>(pointer = destination, count = count))
{
    return RECORD_POOL.lock();
}

trusted internal func message_storage(
    pos guard: &mut std.sync.SpinLockGuard<ReportPool>,
    pos handle: usize,
    pos destination: RawPointer<u8>,
    pos count: usize,
) -> &std.memory.RawBuffer<u8>
    requires(trusted core.memory.valid_write<u8>(pointer = destination, count = count))
    ensures(trusted core.memory.valid_write<u8>(pointer = destination, count = count))
    uses(intrinsic)
{
    let pool: &mut ReportPool = guard.get();
    let entry: &mut ReportRecord = trusted record(pool, handle);

    if let ?storage = entry.message
    {
        return &storage;
    }

    trusted core.target.abort();
}

@abi(c)
trusted internal func panic_message_copy(pos address: usize, pos offset: usize, pos destination: RawPointer<u8>, pos length: usize) -> u32
    requires(trusted core.memory.valid_write<u8>(pointer = destination, count = length))
    ensures(result != STATUS_SUCCESS || trusted core.memory.initialized_range_as<u8>(pointer = destination, count = length))
    uses(raw_memory, unchecked_init)
{
    let mut guard = trusted message_copy_lock(destination, length);
    let storage: &std.memory.RawBuffer<u8> = trusted message_storage(&mut guard, address, destination, length);
    let bytes: &[u8] = trusted std.memory.initialized_slice<u8>(storage);

    if offset > bytes.length() || length > bytes.length() - offset
    {
        return 3;
    }

    let selected: &[u8] = &bytes[offset..offset + length];
    let count: usize = selected.length();

    if count != length
    {
        return 3;
    }

    let source: RawPointer<u8> = trusted internal std.memory.slice_pointer<u8>(selected, count = count);

    let _: unit = trusted core.memory.copy_overlapping<u8>(source = source, destination = destination, count = count);
    return STATUS_SUCCESS;
}

trusted internal func take_message_storage(pos handle: usize) -> std.memory.RawBuffer<u8>?
    uses(intrinsic)
{
    let mut guard = RECORD_POOL.lock();
    let pool: &mut ReportPool = guard.get();
    let next: usize = pool.free;
    let storage: std.memory.RawBuffer<u8>? =
    {
        let entry: &mut ReportRecord = trusted record(pool, handle);
        let previous: std.memory.RawBuffer<u8>? = trusted std.memory.replace_value<(std.memory.RawBuffer<u8>?)>(&mut entry.message, none);

        entry.next = next;
        if previous matches none
        {
            trusted core.target.abort();
        }

        yield previous;
    };

    pool.free = handle;
    pool.available += 1;
    return storage;
}

@abi(c)
trusted internal func panic_message_release(pos address: usize, pos length: usize, pos outcome: RawPointer<u8>)
{
    let _ = outcome;

    if length != 0
    {
        // Move the real buffer owner out before unlocking; destruction runs outside
        // the pool lock and resolves its actual allocation exactly once.
        let storage: std.memory.RawBuffer<u8>? = trusted take_message_storage(address);
    }

    let _: u64 = core.atomic.fetch_add<u64, 0>(&CONSUMED_REPORTS, value = 1);
}
