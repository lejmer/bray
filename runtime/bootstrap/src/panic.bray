@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap;

@abi(c)
trusted internal func panic_report_construction(
    pos cause: u32,
    pos source_present: u32,
    pos source_identity: u32,
    pos source_start: u32,
    pos source_end: u32,
    pos source_version: u64,
    pos message: RawPointer<u8>,
    pos message_length: usize,
) -> usize
    requires(
        trusted core.memory.valid_read<u8>(pointer = message, count = message_length),
        trusted core.memory.initialized_range_as<u8>(pointer = message, count = message_length),
    )
    uses(intrinsic, raw_memory, unchecked_init)
{
    if cause > 5 || source_present > 1 || source_start > source_end || (message_length != 0 && std.memory.is_null<u8>(message))
    {
        trusted core.target.abort();
    }

    let message_copy: RawPointer<u8> = if message_length == 0
    {
        yield std.memory.null<u8>();
    }
    else
    {
        let copy: RawPointer<u8> = trusted internal bray.runtime.bootstrap.heap.allocate(message_length, align = 1);

        if std.memory.is_null<u8>(copy)
        {
            trusted core.target.abort();
        }

        trusted internal std.memory.byte_buffer_copy(message, destination = copy, count = message_length);

        yield copy;
    };

    return trusted allocate_panic_incident(PanicIncident.Panic({
            cause = cause,
            source_present = source_present,
            source_identity = source_identity,
            source_start = source_start,
            source_end = source_end,
            source_version = source_version,
            message = message_copy,
            message_length = message_length,
        }));
}

@abi(c)
trusted internal func panic_reporting(pos payload: usize) -> u32
{
    let report_status: u32 = trusted panic_report_observation(payload);
    let destruction_status: u32 = trusted destroy_panic_report(payload);

    if report_status != STATUS_SUCCESS
    {
        return report_status;
    }

    return destruction_status;
}

@abi(c)
trusted internal func panic_report_observation(pos payload: usize) -> u32
{
    if payload == 0
    {
        return STATUS_INVALID_ARGUMENT;
    }

    let mut current: usize? = payload;
    let mut report_status: u32 = STATUS_SUCCESS;

    while let ?address = current
    {
        let report: RawPointer<PanicReportData> = trusted panic_report_from_payload(address);
        let value: PanicReportData = trusted read_opaque<PanicReportData>(report);

        let status: u32 = trusted report_panic_incident(value.incident);

        if report_status == STATUS_SUCCESS
        {
            report_status = status;
        }

        current = value.next_incident;
    }

    return report_status;
}

@abi(c)
trusted internal func panic_report_destruction(pos payload: usize) -> u32
{
    return trusted destroy_panic_report(payload);
}

@abi(c)
trusted internal func panic_report_suppression(pos primary: usize, pos incident: usize) -> usize
    uses(intrinsic)
{
    if primary == 0 || incident == 0 || primary == incident
    {
        trusted core.target.abort();
    }

    let mut current: usize = primary;

    loop
    {
        let report: RawPointer<PanicReportData> = trusted panic_report_from_payload(current);
        let mut value: PanicReportData = trusted read_opaque<PanicReportData>(report);

        if let ?next = value.next_incident
        {
            current = next;
        }
        else
        {
            value.next_incident = incident;
            trusted write_opaque<PanicReportData>(report, value);

            return primary;
        }
    }
}

trusted internal func destroy_panic_report(pos payload: usize) -> u32
{
    if payload == 0
    {
        return STATUS_INVALID_ARGUMENT;
    }

    let mut current: usize? = payload;

    while let ?address = current
    {
        current = trusted destroy_panic_incident(address);
    }

    return STATUS_SUCCESS;
}

trusted internal func destroy_panic_incident(pos payload: usize) -> usize?
{
    let report: RawPointer<PanicReportData> = trusted panic_report_from_payload(payload);
    let value: PanicReportData = trusted read_opaque<PanicReportData>(report);

    trusted destroy_panic_incident_payload(value.incident);

    trusted internal bray.runtime.bootstrap.heap.deallocate<PanicReportData>(report);

    let _: u64 = core.atomic.fetch_add<u64, 0>(&CONSUMED_REPORTS, value = 1);

    return value.next_incident;
}

@link(name = "bray_runtime_callback", kind = system)
@symbol(name = "bray_runtime_substrate_panic_reporting")
@abi(c)
extern trusted internal func substrate_panic_reporting(
    pos cause: u32,
    pos source_present: u32,
    pos source_identity: u32,
    pos source_start: u32,
    pos source_end: u32,
    pos source_version: u64,
    pos message: RawPointer<u8>,
    pos message_length: usize,
    pos copy_message: PanicMessageCopy,
) -> u32
    requires(
        trusted core.memory.valid_read<u8>(pointer = message, count = message_length),
        trusted core.memory.initialized_range_as<u8>(pointer = message, count = message_length),
    )
    uses(foreign_call);

internal callable PanicMessageCopy = @abi(c)
trusted func(pos source: RawPointer<u8>, pos destination: RawPointer<u8>, pos count: usize) -> u32
    requires(
        trusted core.memory.valid_read<u8>(pointer = source, count = count),
        trusted core.memory.initialized_range_as<u8>(pointer = source, count = count),
        trusted core.memory.valid_write<u8>(pointer = destination, count = count),
        trusted core.memory.non_overlapping<u8>(left = source, left_count = count, right = destination, right_count = count),
    )
    uses(raw_memory, unchecked_init);

@abi(c)
trusted internal func copy_panic_message(pos source: RawPointer<u8>, pos destination: RawPointer<u8>, pos count: usize) -> u32
    requires(
        trusted core.memory.valid_read<u8>(pointer = source, count = count),
        trusted core.memory.initialized_range_as<u8>(pointer = source, count = count),
        trusted core.memory.valid_write<u8>(pointer = destination, count = count),
        trusted core.memory.non_overlapping<u8>(left = source, left_count = count, right = destination, right_count = count),
    )
    uses(raw_memory, unchecked_init)
{
    trusted internal std.memory.byte_buffer_copy(source, destination = destination, count = count);

    return STATUS_SUCCESS;
}
