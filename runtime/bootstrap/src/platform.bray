@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap;

internal const PLATFORM_STATUS_INVALID_INPUT: u32 = 5;
internal const PLATFORM_STATUS_OTHER: u32 = 10;
internal const NATIVE_THREAD_STORAGE_EMPTY: u32 = 0;
internal const NATIVE_THREAD_STORAGE_PENDING: u32 = 1;
internal const NATIVE_THREAD_STORAGE_READY: u32 = 2;
internal const PRIVATE_THREAD_STORAGE_KEY: u64 = 1;

internal static NATIVE_THREAD_STORAGE_STATE: core.atomic.Atomic<u32> = core.atomic.initialize<u32>(0);

internal func begin_native_thread_storage_creation() -> bool
{
    let(_, acquired) = core.atomic.compare_exchange<u32, 3, 1>(
        &NATIVE_THREAD_STORAGE_STATE,
        expected = NATIVE_THREAD_STORAGE_EMPTY,
        desired = NATIVE_THREAD_STORAGE_PENDING,
    );

    return acquired;
}

internal func cancel_native_thread_storage_creation()
{
    core.atomic.store<u32, 2>(&NATIVE_THREAD_STORAGE_STATE, value = NATIVE_THREAD_STORAGE_EMPTY);
}

internal func publish_native_thread_storage()
{
    core.atomic.store<u32, 2>(&NATIVE_THREAD_STORAGE_STATE, value = NATIVE_THREAD_STORAGE_READY);
}

internal func native_thread_storage_ready(pos key: u64) -> bool
{
    return key == PRIVATE_THREAD_STORAGE_KEY
        && core.atomic.load<u32, 1>(&NATIVE_THREAD_STORAGE_STATE) == NATIVE_THREAD_STORAGE_READY;
}

internal func begin_native_thread_storage_destruction(pos key: u64) -> bool
{
    if key != PRIVATE_THREAD_STORAGE_KEY
    {
        return false;
    }

    let(_, acquired) = core.atomic.compare_exchange<u32, 3, 1>(
        &NATIVE_THREAD_STORAGE_STATE,
        expected = NATIVE_THREAD_STORAGE_READY,
        desired = NATIVE_THREAD_STORAGE_PENDING,
    );

    return acquired;
}

internal func restore_native_thread_storage()
{
    core.atomic.store<u32, 2>(&NATIVE_THREAD_STORAGE_STATE, value = NATIVE_THREAD_STORAGE_READY);
}

internal func finish_native_thread_storage_destruction()
{
    core.atomic.store<u32, 2>(&NATIVE_THREAD_STORAGE_STATE, value = NATIVE_THREAD_STORAGE_EMPTY);
}

internal func platform_success_status() -> PlatformStatus
{
    return platform_status(category = 0, native_code = 0);
}

internal func platform_invalid_input_status() -> PlatformStatus
{
    return platform_status(category = PLATFORM_STATUS_INVALID_INPUT, native_code = 0);
}

internal func platform_error_status(pos native_code: i64) -> PlatformStatus
{
    return platform_status(category = PLATFORM_STATUS_OTHER, native_code = native_code);
}

internal func platform_status(pos category: u32, pos native_code: i64) -> PlatformStatus
{
    return
    {
        category = category,
        reserved = 0,
        native_code = native_code,
    };
}
