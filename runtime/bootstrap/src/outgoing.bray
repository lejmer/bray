@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap;

using std.memory;

@abi(c)
trusted internal func outgoing_admission(pos count: usize, pos outcome: RawPointer<ReportOutcome>)
    requires(trusted core.memory.valid_write<ReportOutcome>(pointer = outcome, count = 1),
        trusted core.memory.aligned_for<ReportOutcome>(pointer = outcome))
    uses(raw_memory, unchecked_init)
{
    if trusted admit_outgoing_values(count, outcome)
    {
        return;
    }

    let mut failure: PanicReportData = empty_panic_report();

    failure.cause = PANIC_ALLOCATION_FAILURE;
    failure.consumer = trusted consume_pointer();
    trusted std.memory.write<ReportOutcome>(outcome, { state = RUN_PANICKED, payload = 0, report = failure });
}

trusted internal func admit_outgoing_values(pos count: usize, pos outcome: RawPointer<ReportOutcome>) -> bool
    requires(
        trusted core.memory.valid_write<ReportOutcome>(pointer = outcome, count = 1),
        trusted core.memory.aligned_for<ReportOutcome>(pointer = outcome),
    )
    ensures(
        trusted core.memory.valid_write<ReportOutcome>(pointer = outcome, count = 1),
        trusted core.memory.aligned_for<ReportOutcome>(pointer = outcome),
    )
{
    let mut guard = RECORD_POOL.lock();
    let pool: &mut ReportPool = guard.get();
    let maximum: usize = ~0;

    if count > maximum - pool.credits
    {
        return false;
    }

    let requested: usize = pool.credits + count;

    if !trusted reserve_records(pool, requested)
    {
        return false;
    }

    pool.credits += count;
    return true;
}

@abi(c)
trusted internal func outgoing_discharge(pos count: usize)
    uses(intrinsic)
{
    let mut guard = RECORD_POOL.lock();
    let pool: &mut ReportPool = guard.get();

    if count > pool.credits
    {
        trusted core.target.abort();
    }

    pool.credits -= count;
}

@abi(c)
trusted internal func outgoing_activation() -> usize
{
    let mut guard = RECORD_POOL.lock();

    return trusted activate_record(guard.get());
}

@abi(c)
trusted internal func outgoing_retirement(pos handle: usize, pos outcome: RawPointer<ReportOutcome>)
    requires(trusted core.memory.valid_write<ReportOutcome>(pointer = outcome, count = 1),
        trusted core.memory.aligned_for<ReportOutcome>(pointer = outcome),
        trusted core.memory.valid_read<ReportOutcome>(pointer = outcome, count = 1),
        trusted core.memory.initialized_as<ReportOutcome>(pointer = outcome))
    uses(raw_memory, unchecked_init)
{
    let mut result: ReportOutcome = trusted std.memory.read<ReportOutcome>(outcome);

    if result.state == RUN_PANICKED && result.report.reserved == 0
    {
        result.report.reserved = handle;
        trusted std.memory.write<ReportOutcome>(outcome, result);
    }
    else
    {
        trusted std.memory.write<ReportOutcome>(outcome, result);
        trusted recycle_reservation(handle);
    }
}

@abi(c)
trusted internal func take_report(pos pointer: RawPointer<PanicReportData>) -> PanicReportData
    requires(trusted native_report_slot_callbacks(pointer = pointer), trusted core.memory.valid_write<PanicReportData>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<PanicReportData>(pointer = pointer),
        trusted core.memory.valid_read<PanicReportData>(pointer = pointer, count = 1),
        trusted core.memory.initialized_as<PanicReportData>(pointer = pointer))
    ensures(trusted native_report_callbacks(report = &result),
        trusted native_report_slot_callbacks(pointer = pointer),
        trusted core.memory.valid_write<PanicReportData>(pointer = pointer, count = 1),
        trusted core.memory.aligned_for<PanicReportData>(pointer = pointer),
        trusted core.memory.valid_read<PanicReportData>(pointer = pointer, count = 1),
        trusted core.memory.initialized_as<PanicReportData>(pointer = pointer))
    uses(raw_memory, unchecked_init)
{
    let owned: PanicReportData = trusted std.memory.read<PanicReportData>(pointer);

    trusted std.memory.write<PanicReportData>(pointer, empty_panic_report());
    return owned;
}

// Moving the primary header leaves the disjoint incident slot untouched.
trusted internal func take_primary_report(pos primary: RawPointer<PanicReportData>, pos incident: RawPointer<PanicReportData>) -> PanicReportData
    requires(
        trusted native_report_slot_callbacks(pointer = primary),
        trusted native_report_slot_callbacks(pointer = incident),
        trusted core.memory.non_overlapping<PanicReportData>(left = primary, left_count = 1, right = incident, right_count = 1),
        trusted core.memory.valid_write<PanicReportData>(pointer = primary, count = 1),
        trusted core.memory.aligned_for<PanicReportData>(pointer = primary),
        trusted core.memory.valid_read<PanicReportData>(pointer = primary, count = 1),
        trusted core.memory.initialized_as<PanicReportData>(pointer = primary), trusted core.memory.valid_write<PanicReportData>(pointer = incident, count = 1),
        trusted core.memory.aligned_for<PanicReportData>(pointer = incident),
        trusted core.memory.valid_read<PanicReportData>(pointer = incident, count = 1),
        trusted core.memory.initialized_as<PanicReportData>(pointer = incident))
    ensures(
        trusted native_report_callbacks(report = &result),
        trusted native_report_slot_callbacks(pointer = incident),
        trusted core.memory.valid_read<PanicReportData>(pointer = incident, count = 1),
        trusted core.memory.valid_write<PanicReportData>(pointer = incident, count = 1),
        trusted core.memory.aligned_for<PanicReportData>(pointer = incident),
        trusted core.memory.initialized_as<PanicReportData>(pointer = incident),
    )
    uses(raw_memory, unchecked_init)
{
    let owned: PanicReportData = trusted std.memory.read<PanicReportData>(primary);

    trusted std.memory.write<PanicReportData>(primary, empty_panic_report());
    return owned;
}

@abi(c)
trusted internal func panic_report_suppression(
    pos primary: RawPointer<PanicReportData>,
    pos incident: RawPointer<PanicReportData>
) -> PanicReportData
    requires(
        trusted native_report_slot_callbacks(pointer = primary),
        trusted native_report_slot_callbacks(pointer = incident),
        trusted core.memory.non_overlapping<PanicReportData>(left = primary, left_count = 1, right = incident, right_count = 1),
        trusted core.memory.valid_write<PanicReportData>(pointer = primary, count = 1),
        trusted core.memory.aligned_for<PanicReportData>(pointer = primary),
        trusted core.memory.valid_read<PanicReportData>(pointer = primary, count = 1),
        trusted core.memory.initialized_as<PanicReportData>(pointer = primary), trusted core.memory.valid_write<PanicReportData>(pointer = incident, count = 1),
        trusted core.memory.aligned_for<PanicReportData>(pointer = incident),
        trusted core.memory.valid_read<PanicReportData>(pointer = incident, count = 1),
        trusted core.memory.initialized_as<PanicReportData>(pointer = incident))
    uses(intrinsic)
{
    let mut report: PanicReportData = trusted take_primary_report(primary, incident);
    let suppressed: PanicReportData = trusted take_report(incident);
    let handle: usize = suppressed.reserved;

    let mut incident_records: ReportRecords =
    {
        head = handle,
        tail = handle,
        count = 1
    };

    let mut later: ReportRecords =
    {
        head = suppressed.outgoing_head,
        tail = suppressed.outgoing_tail,
        count = suppressed.outgoing_count
    };

    let mut value: ReportPrimary = report_primary_value(suppressed);

    value = trusted exchange_primary(handle, value);

    let released: ReportOutcome = trusted release_primary(&value, trusted primary_release(&value));

    if released.state != RUN_COMPLETED
    {
        trusted core.target.abort();
    }

    trusted report_records_append(
        std.memory.address_of_mut<ReportRecords>(&mut incident_records),
        std.memory.address_of_mut<ReportRecords>(&mut later)
    );

    let mut chain: ReportRecords =
    {
        head = report.outgoing_head,
        tail = report.outgoing_tail,
        count = report.outgoing_count
    };

    trusted report_records_append(
        std.memory.address_of_mut<ReportRecords>(&mut chain),
        std.memory.address_of_mut<ReportRecords>(&mut incident_records)
    );

    report.outgoing_head = chain.head;
    report.outgoing_tail = chain.tail;
    report.outgoing_count = chain.count;
    return report;
}
