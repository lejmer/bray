trusted internal func arctangent_anchor(
    pos index: usize,
    pos precision: usize,
    pos pi: &bray.runtime.bootstrap.numeric.number.Number
) -> bray.runtime.bootstrap.numeric.number.Number
{
    if index == 0
    {
        return trusted bray.runtime.bootstrap.numeric.number.zero(false);
    }

    if index == 16
    {
        return trusted bray.runtime.bootstrap.numeric.number.scale_by(pi, -2);
    }

    return trusted table_constant(&ATAN_ANCHORS[index - 1], -1024, precision);
}

trusted internal func logarithm_anchor(
    pos index: usize,
    pos precision: usize,
    pos ln2: &bray.runtime.bootstrap.numeric.number.Number
) -> bray.runtime.bootstrap.numeric.number.Number
{
    if index == 16
    {
        return trusted bray.runtime.bootstrap.numeric.number.zero(false);
    }

    if index == 32
    {
        return trusted bray.runtime.bootstrap.numeric.number.duplicate(ln2);
    }

    if index == 8
    {
        return trusted bray.runtime.bootstrap.numeric.number.negate(ln2);
    }

    let ordinal: usize = if index < 16
    {
        yield index - 9;
    }
    else
    {
        yield index - 10;
    };

    let mut result = trusted table_constant(&LOG_ANCHORS[ordinal], -1024, precision);

    result.negative = index < 16;
    return result;
}
