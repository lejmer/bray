@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.scheduler;

using core.atomic;
using core.memory;
using std.memory;
using std.sync;
using internal bray.runtime.bootstrap.host;

internal const WAKE_EXPLICIT: u32 = 1;

internal const WAKE_TIMER: u32 = 2;

internal const WAKE_CANCELLATION: u32 = 3;

// Each owned reference holds one queue-storage count. Borrowed access does not
// create another count or grant permission to release the enclosing owner.
@layout(c)
internal struct Acquisition
{
}

@layout(c)
internal struct Reference
{
    acquisition: Acquisition;
    pointer: DataPointer<Domain>;
}

@copy
@layout(c)
internal struct Lane
{
    placement: u32;
    workload: u32;
    thread: u64;
}

@copy
@layout(c)
internal struct Requirements
{
    affinity: u32;
    workloads: u32;
    origin: u64;
}

@copy
@layout(c)
internal struct Observation
{
    task: u64;
    registration: u64;
    lane: Lane;
    phase: u32;
    cause: u32;
    wakes: u64;
    queued_at: u64;
}

internal struct Entry
{
    mut generation: u32;
    mut phase: u32;
    mut task: u64;
    mut lane: Lane;
    mut queue: usize;
    mut previous: usize;
    mut next: usize;
    mut cause: u32;
    mut pending: u32;
    mut wakes: u64;
    mut queued_at: u64;
    mut slot: bool;
    mut driver: Lane?;
}

internal struct State
{
    mut deadline_closed: bool;
    mut worker_closed: bool;
    mut entries: std.memory.RawBuffer<Entry>?;
    mut queues: std.memory.RawBuffer<Queue>?;
    mut free_queue: usize;
    mut free: usize;
    mut head: usize;
    mut tail: usize;
    mut running: usize;
    mut waiters: [usize; 2];
}

internal struct Domain
{
    references: core.atomic.Atomic<usize>;
    capabilities: u32;
    main: u64;
    limit: usize;
    state: std.sync.SpinLock<State>;
    signals: [core.atomic.Atomic<u32>; 2];
}

trusted internal predicate reference_retained(owner: &Acquisition);

internal predicate retained(owner: &Reference) = reference_retained(owner = &owner.acquisition);

trusted internal predicate reference_owned(owner: &Acquisition);

internal predicate owned_reference(owner: &Reference) = reference_owned(owner = &owner.acquisition);

trusted internal predicate retiring(owner: &Reference);

trusted internal predicate reference_slot(pointer: DataPointer<Reference>);

internal func empty_entry(pos next: usize) -> Entry
{
    return
    {
        generation = 0,
        phase = 3,
        task = 0,
        lane =
        {
            placement = 0,
            workload = 0,
            thread = 0
        },
        queue = 0,
        previous = 0,
        next = next,
        cause = 0,
        pending = 0,
        wakes = 0,
        queued_at = 0,
        slot = false,
        driver = none
    };
}

internal struct Queue
{
    mut lane: Lane;
    mut head: usize;
    mut tail: usize;
    mut previous: usize;
    mut next: usize;
}

internal struct Prepared
{
    mut entries: std.memory.RawBuffer<Entry>?;
    mut queues: std.memory.RawBuffer<Queue>?;
}

internal union Growth
{
    Entries(pos capacity: usize);
    Queues(pos capacity: usize);
}

internal func empty_queue(pos next: usize) -> Queue
{
    return
    {
        lane =
        {
            placement = 0,
            workload = 0,
            thread = 0
        },
        head = 0,
        tail = 0,
        previous = 0,
        next = next
    };
}

internal func empty_observation() -> Observation
{
    return
    {
        task = 0,
        registration = 0,
        lane =
        {
            placement = 0,
            workload = 0,
            thread = 0
        },
        phase = 0,
        cause = 0,
        wakes = 0,
        queued_at = 0
    };
}
