@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.scheduler;

using core.target;
using std.memory;
using internal bray.runtime.bootstrap.execution;

// Queue storage remains available until the service allocation retires. The
// execution pin ends earlier, when the service completes its execution work.
internal struct Backing
{
    scheduler: Reference;
    execution: bray.runtime.bootstrap.execution.Reference?;
}

trusted internal predicate backing_retained(owner: &Backing);

// The complete backing owns its queue count and any remaining execution pin.
trusted internal predicate backing_owned(owner: &Backing);

trusted internal const func backing_queue(pos owner: &Backing) -> &Reference
    requires(trusted backing_retained(owner = owner))
    ensures(trusted retained(owner = result))
    when(trusted backing_owned(owner = owner))
    {
        ensures(trusted owned_reference(owner = result))
    }
    executes(pure, total)
{
    return &owner.scheduler;
}

trusted internal func external_backing(pos owner: Reference) -> Backing
    requires(trusted retained(owner = &owner), trusted owned_reference(owner = &owner))
    ensures(
        trusted backing_retained(owner = &result),
        trusted backing_owned(owner = &result),
        result.execution matches none
    )
{
    return
    {
        scheduler = owner,
        execution = none
    };
}

trusted internal func execution_backing(pos owner: bray.runtime.bootstrap.execution.Reference) -> Backing
    requires(
        trusted bray.runtime.bootstrap.execution.retained(owner = &owner),
        trusted bray.runtime.bootstrap.execution.pinned(owner = &owner)
    )
    ensures(trusted backing_retained(owner = &result), trusted backing_owned(owner = &result))
{
    let queue_owner = trusted retain_reference(trusted bray.runtime.bootstrap.execution.scheduler_reference(&owner));

    return
    {
        scheduler = queue_owner,
        execution = owner
    };
}

trusted internal const func backing_execution(pos owner: &Backing) -> &bray.runtime.bootstrap.execution.Reference
    requires(owner.execution matches ?_)
    when(trusted backing_retained(owner = owner))
    {
        ensures(trusted bray.runtime.bootstrap.execution.retained(owner = result))
    }
    when(trusted backing_owned(owner = owner))
    {
        ensures(trusted bray.runtime.bootstrap.execution.pinned(owner = result))
    }
    executes(pure, total)
{
    return match owner.execution
    {
        case ?execution_owner { yield &execution_owner; }
        case none { panic("backing has no execution pin"); }
    };
}

// Rejected formation consumes the whole backing. Its queue count ends here,
// while the caller receives and resolves the actual execution pin.
trusted internal func take_execution_backing(pos owner: Backing) -> bray.runtime.bootstrap.execution.Reference
    requires(
        trusted backing_retained(owner = &owner),
        trusted backing_owned(owner = &owner),
        owner.execution matches ?_
    )
    ensures(
        trusted bray.runtime.bootstrap.execution.retained(owner = &result),
        trusted bray.runtime.bootstrap.execution.pinned(owner = &result)
    )
    uses(raw_memory)
{
    let queue_pointer = std.memory.address_of<Reference>(backing_queue(&owner));
    let execution_pointer = std.memory.address_of<bray.runtime.bootstrap.execution.Reference>(backing_execution(&owner));
    let execution = trusted std.memory.read<bray.runtime.bootstrap.execution.Reference>(execution_pointer);
    let queue_owner = trusted std.memory.read<Reference>(queue_pointer);

    trusted destroy_reference(queue_owner);
    return execution;
}

// Completed execution services and native services both retain a queue owner.
trusted internal func release_external_backing(pos owner: Backing)
    requires(trusted backing_retained(owner = &owner), trusted backing_owned(owner = &owner))
    uses(raw_memory)
{
    if owner.execution matches ?_
    {
        trusted core.target.abort();
    }

    let queue_owner = trusted std.memory.read<Reference>(std.memory.address_of<Reference>(backing_queue(&owner)));

    trusted destroy_reference(queue_owner);
}
