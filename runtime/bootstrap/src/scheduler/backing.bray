@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.scheduler;

using core.target;
using std.memory;
using internal bray.runtime.bootstrap.execution;

// Native providers borrow a queue under their own retention protocol. Source
// services retain the whole execution that owns their queue and cleanup state.
internal union Backing
{
    Retired;
    External(pos scheduler: Reference);
    Execution(pos execution: bray.runtime.bootstrap.execution.Reference);
}

trusted internal predicate backing_storage_retained(owner: &Backing);

internal predicate backing_retained(owner: &Backing) =
    (owner matches Backing.External(_) || owner matches Backing.Execution(_))
    && backing_storage_retained(owner = owner);

// This claim belongs to the complete Backing. Its constructors and consuming
// transfers preserve the actual queue count or execution pin it owns.
trusted internal predicate backing_owned(owner: &Backing);

trusted internal const func backing_queue(pos owner: &Backing) -> &Reference
    requires(owner matches Backing.External(_))
    when(trusted backing_storage_retained(owner = owner))
    {
        ensures(trusted retained(owner = result))
    }
    when(trusted backing_owned(owner = owner))
    {
        ensures(trusted owned_reference(owner = result))
    }
    executes(pure, total)
{
    return match owner
    {
        case Backing.External(queue_owner) { yield &queue_owner; }
        case Backing.Execution(_) { panic("execution backing is not a queue owner"); }
        case Backing.Retired { panic("retired backing has no queue owner"); }
    };
}

trusted internal func external_backing(pos owner: Reference) -> Backing
    requires(trusted retained(owner = &owner), trusted owned_reference(owner = &owner))
    ensures(trusted backing_retained(owner = &result), trusted backing_owned(owner = &result))
{
    return Backing.External(owner);
}

trusted internal func execution_backing(pos owner: bray.runtime.bootstrap.execution.Reference) -> Backing
    requires(trusted bray.runtime.bootstrap.execution.retained(owner = &owner), trusted bray.runtime.bootstrap.execution.pinned(owner = &owner))
    ensures(trusted backing_retained(owner = &result), trusted backing_owned(owner = &result))
{
    return Backing.Execution(owner);
}

trusted internal func backing_scheduler(pos owner: &Backing) -> &Reference
    requires(trusted backing_retained(owner = owner))
    ensures(trusted backing_retained(owner = owner), trusted retained(owner = result))
    executes(pure, total)
{
    return match owner
    {
        case Backing.External(selected_queue) { yield &selected_queue; }
        case Backing.Retired { yield trusted core.target.abort(); }
        case Backing.Execution(_) { yield trusted bray.runtime.bootstrap.execution.scheduler_reference(backing_execution(owner)); }
    };
}

trusted internal const func backing_execution(pos owner: &Backing) -> &bray.runtime.bootstrap.execution.Reference
    requires(owner matches Backing.Execution(_))
    when(trusted backing_storage_retained(owner = owner))
    {
        ensures(trusted bray.runtime.bootstrap.execution.retained(owner = result))
    }
    when(trusted backing_owned(owner = owner))
    {
        ensures(trusted bray.runtime.bootstrap.execution.pinned(owner = result))
    }
    executes(pure, total)
{
    return match owner
    {
        case Backing.Execution(execution_owner) { yield &execution_owner; }
        case Backing.External(_) { panic("queue backing is not an execution owner"); }
        case Backing.Retired { panic("retired backing has no execution owner"); }
    };
}

// Consuming the backing transfers its actual pin. A borrowed queue or a
// retired service has no execution pin to transfer.
trusted internal func take_execution_backing(pos owner: Backing) -> bray.runtime.bootstrap.execution.Reference
    requires(trusted backing_retained(owner = &owner), trusted backing_owned(owner = &owner))
    ensures(trusted bray.runtime.bootstrap.execution.retained(owner = &result), trusted bray.runtime.bootstrap.execution.pinned(owner = &result))
    uses(raw_memory)
{
    if owner matches Backing.Execution(_)
    {
        return trusted std.memory.read<bray.runtime.bootstrap.execution.Reference>(std.memory.address_of<bray.runtime.bootstrap.execution.Reference>(backing_execution(&owner)));
    }

    return trusted core.target.abort();
}

// Execution services transfer their pin before retiring their allocation.
// Native services own a separate queue count and release that actual owner.
trusted internal func release_external_backing(pos owner: Backing)
    requires(owner matches Backing.Retired || (trusted backing_retained(owner = &owner) && trusted backing_owned(owner = &owner)))
{
    if owner matches Backing.Retired
    {
        return;
    }

    let take = trusted lambda(pos owner: Backing) -> Reference
        requires(trusted backing_retained(owner = &owner), trusted backing_owned(owner = &owner), owner matches Backing.External(_))
        ensures(trusted retained(owner = &result), trusted owned_reference(owner = &result))
        uses(raw_memory)
    {
        return trusted std.memory.read<Reference>(std.memory.address_of<Reference>(backing_queue(&owner)));
    };

    if !(owner matches Backing.External(_))
    {
        trusted core.target.abort();
    }

    trusted destroy_reference(trusted take(owner));
}
