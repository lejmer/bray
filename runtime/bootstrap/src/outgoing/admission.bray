@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.outgoing;

using std.numeric;
using core.target;
using core.memory;
using std.memory;
using internal bray.runtime.bootstrap.pool.growth;
using internal bray.runtime.bootstrap;

@abi(c)
trusted internal func admission(
    pos pointer: DataPointer<bray.runtime.bootstrap.storage.Bundle>,
    pos outcome: DataPointer<bray.runtime.bootstrap.ReportOutcome>
)
    requires(
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted core.memory.valid_read<bray.runtime.bootstrap.storage.Bundle>(pointer = pointer, count = 1),
        trusted core.memory.initialized_as<bray.runtime.bootstrap.storage.Bundle>(pointer = pointer),
        trusted core.memory.aligned_for<bray.runtime.bootstrap.storage.Bundle>(pointer = pointer),
        trusted core.memory.valid_write<bray.runtime.bootstrap.ReportOutcome>(pointer = outcome, count = 1),
        trusted core.memory.aligned_for<bray.runtime.bootstrap.ReportOutcome>(pointer = outcome),
    )
    uses(raw_memory, unchecked_init)
{
    let bundle = trusted std.memory.read<bray.runtime.bootstrap.storage.Bundle>(pointer);

    if trusted accept(bundle, outcome)
    {
        return;
    }

    trusted std.memory.write<bray.runtime.bootstrap.ReportOutcome>(
        outcome,
        trusted bray.runtime.bootstrap.allocation_failure()
    );
}

trusted internal func accept(
    pos bundle: bray.runtime.bootstrap.storage.Bundle,
    pos outcome: DataPointer<bray.runtime.bootstrap.ReportOutcome>
) -> bool
    requires(
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted core.memory.valid_write<bray.runtime.bootstrap.ReportOutcome>(pointer = outcome, count = 1),
        trusted core.memory.aligned_for<bray.runtime.bootstrap.ReportOutcome>(pointer = outcome),
    )
    ensures(
        trusted core.memory.valid_write<bray.runtime.bootstrap.ReportOutcome>(pointer = outcome, count = 1),
        trusted core.memory.aligned_for<bray.runtime.bootstrap.ReportOutcome>(pointer = outcome),
    )
{
    let mut prepared = bray.runtime.bootstrap.pool.growth.empty();

    while true
    {
        let request =
        {
            let mut guard = trusted bray.runtime.bootstrap.pool.lock();

            yield match consume trusted accept_locked(guard.get(), bundle, &mut prepared)
            {
                case Ok(accepted) { return accepted; }
                case Error(request) { yield request; }
            };
        };

        if !trusted bray.runtime.bootstrap.pool.growth.prepare(&mut prepared, request)
        {
            return false;
        }
    }
}

trusted internal func accept_locked(
    pos pool: &mut bray.runtime.bootstrap.ReportPool,
    pos bundle: bray.runtime.bootstrap.storage.Bundle,
    pos prepared: &mut bray.runtime.bootstrap.pool.growth.Prepared
) -> Result<bool, bray.runtime.bootstrap.pool.growth.Request>
{

    let maximum: usize = std.numeric.USIZE_MAX;

    if bundle.records > maximum - pool.credits
    {
        return Ok(false);
    }

    let requested = pool.credits + bundle.records;

    match consume trusted bray.runtime.bootstrap.reserve_records(pool, requested, prepared)
    {
        case Ok(ready)
        {
            if !ready
            {
                return Ok(false);
            }
        }
        case Error(request) { return Error(request); }
    }

    match consume trusted bray.runtime.bootstrap.storage.reserve_bundle(pool, bundle.descriptors, prepared)
    {
        case Ok(ready)
        {
            if !ready
            {
                return Ok(false);
            }
        }
        case Error(request) { return Error(request); }
    }

    pool.credits += bundle.records;
    return Ok(true);
}

@abi(c)
trusted internal func discharge(pos pointer: DataPointer<bray.runtime.bootstrap.storage.Bundle>)
    requires(
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted core.memory.valid_read<bray.runtime.bootstrap.storage.Bundle>(pointer = pointer, count = 1),
        trusted core.memory.initialized_as<bray.runtime.bootstrap.storage.Bundle>(pointer = pointer),
        trusted core.memory.aligned_for<bray.runtime.bootstrap.storage.Bundle>(pointer = pointer),
    )
    uses(raw_memory, intrinsic)
{
    let bundle = trusted std.memory.read<bray.runtime.bootstrap.storage.Bundle>(pointer);
    let mut guard = trusted bray.runtime.bootstrap.pool.lock();
    let pool = guard.get();

    if bundle.records > pool.credits
    {
        trusted core.target.abort();
    }

    trusted bray.runtime.bootstrap.storage.discharge_bundle(pool, bundle.descriptors, bundle.descriptors.length());
    pool.credits -= bundle.records;
}
