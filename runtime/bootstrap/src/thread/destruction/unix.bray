@target(target.identity.SYSTEM == "linux" || target.identity.SYSTEM == "darwin")
trusted internal module bray.runtime.bootstrap.thread.destruction;

using core.memory;
using std.memory;
using std.memory.function;
using std.os.unix;

internal callable ExitCallback = @abi(c) trusted func(pos value: DataPointer<u8>)
    requires(trusted native_attachment_exit());

@abi(c)
trusted internal func thread_storage_exit(pos value: DataPointer<u8>)
    requires(trusted native_attachment_exit())
{
    trusted finish_native_attachment(value);
}

trusted internal func attachment_destructor_address() -> FunctionPointer<std.os.unix.ThreadStorageDestructor>
    uses(layout_reinterpret)
    ensures(
        trusted core.memory.callable_address_valid<std.os.unix.ThreadStorageDestructor>(
            pointer = result
        )
    )
{
    let callback: ExitCallback = thread_storage_exit;

    return trusted std.memory.function.reinterpret<std.os.unix.ThreadStorageDestructor, ExitCallback>(trusted std.memory.function_address(callback));
}
