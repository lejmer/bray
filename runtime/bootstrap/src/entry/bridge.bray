@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.entry.bridge;

using core.target;
using core.atomic;
using core.memory;
using std.memory;
using std.memory.function;
using internal bray.runtime.bootstrap;
using internal bray.runtime.bootstrap.host;
using internal bray.runtime.bootstrap.entry;
using internal bray.runtime.bootstrap.entry.bridge.address;

// The native scope owns an attachment acquisition on this thread, retains the
// callback provider through final cleanup. Nested scopes restore the previous callback
// before returning to their caller.
// The previous-address destination is exclusive and does not alias host storage.
trusted internal predicate native_provider();

@copy
@layout(c)
internal struct NativeCallbacks
{
    context: DataPointer<u8>;
    report: DataPointer<u8>;
    control: DataPointer<u8>;
}

internal callable Observer = @abi(c) trusted func(
    pos kind: u32,
    pos primary: DataPointer<bray.runtime.bootstrap.ReportPrimary>,
    pos identity: DataPointer<bytes<32>>
) -> u32
    requires(
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted core.memory.valid_read<bray.runtime.bootstrap.ReportPrimary>(pointer = primary, count = 1),
        trusted core.memory.aligned_for<bray.runtime.bootstrap.ReportPrimary>(pointer = primary),
        trusted core.memory.initialized_as<bray.runtime.bootstrap.ReportPrimary>(pointer = primary),
        trusted core.memory.valid_read<bytes<32>>(pointer = identity, count = 1),
        trusted core.memory.aligned_for<bytes<32>>(pointer = identity),
        trusted core.memory.initialized_as<bytes<32>>(pointer = identity)
    );

// The selected execution scope retains this provider through exact-thread cleanup.
internal callable Control = @abi(c) trusted func(pos operation: u32) -> u32
    requires(trusted bray.runtime.bootstrap.pool.protocol_access());

internal callable Callback = @abi(c) trusted func(
    pos continuation: DataPointer<u8>,
    pos callback: DataPointer<u8>,
    pos context: usize,
    pos main: u32,
    pos outcome: DataPointer<bray.runtime.bootstrap.ReportOutcome>
) -> u32
    requires(trusted bray.runtime.bootstrap.entry.native_entry());

@abi(c)
trusted internal func install(
    pos pointer: DataPointer<NativeCallbacks>,
    pos previous: DataPointer<NativeCallbacks>
) -> u32
    requires(trusted native_provider())
    uses(layout_reinterpret)
{
    let read_callbacks = trusted lambda(pos pointer: DataPointer<NativeCallbacks>) -> NativeCallbacks
        requires(trusted native_provider())
        uses(raw_memory)
    {
        let readable = trusted lambda(pos value: DataPointer<NativeCallbacks>) -> DataPointer<NativeCallbacks>
            requires(trusted native_provider())
            ensures(
                trusted core.memory.valid_read<NativeCallbacks>(pointer = result, count = 1),
                trusted core.memory.aligned_for<NativeCallbacks>(pointer = result),
                trusted core.memory.initialized_as<NativeCallbacks>(pointer = result)
            )
            executes(pure, total)
        {
            return value;
        };

        return trusted std.memory.read<NativeCallbacks>(trusted readable(pointer));
    };

    let callbacks = trusted read_callbacks(pointer);
    let context_address = callbacks.context;

    let address = trusted lambda(pos pointer: DataPointer<u8>) -> FunctionPointer<Callback>
        requires(trusted native_provider())
        ensures(trusted core.memory.callable_address_valid<Callback>(pointer = result))
        executes(pure, total)
        uses(layout_reinterpret)
    {
        return trusted std.memory.function.from_data<Callback>(pointer);
    };

    let mut selected: Callback? = none;

    if !std.memory.is_null<u8>(context_address)
    {
        selected = trusted std.memory.callable_from_pointer<Callback>(trusted address(context_address));
    }

    let observer_address = trusted lambda(pos pointer: DataPointer<u8>) -> FunctionPointer<Observer>
        requires(trusted native_provider())
        ensures(trusted core.memory.callable_address_valid<Observer>(pointer = result))
        executes(pure, total)
        uses(layout_reinterpret)
    {
        return trusted std.memory.function.from_data<Observer>(pointer);
    };

    let mut observer: Observer? = none;

    if !std.memory.is_null<u8>(callbacks.report)
    {
        observer = trusted std.memory.callable_from_pointer<Observer>(trusted observer_address(callbacks.report));
    }

    let control_address = trusted lambda(pos pointer: DataPointer<u8>) -> FunctionPointer<Control>
        requires(trusted native_provider())
        ensures(trusted core.memory.callable_address_valid<Control>(pointer = result))
        executes(pure, total)
        uses(layout_reinterpret)
    {
        return trusted std.memory.function.from_data<Control>(pointer);
    };

    let mut control: Control? = none;

    if !std.memory.is_null<u8>(callbacks.control)
    {
        control = trusted std.memory.callable_from_pointer<Control>(trusted control_address(callbacks.control));
    }

    let lease = trusted bray.runtime.bootstrap.host.host_access();

    if !lease.active
    {
        return bray.runtime.bootstrap.STATUS_RUNTIME_FAILURE;
    }

    let identity = trusted bray.runtime.bootstrap.host.current_attachment_locked(&lease);
    let mut anchor = trusted bray.runtime.bootstrap.host.host_anchor(&lease);

    return trusted exchange(&lease, &mut anchor, identity, selected, observer, control, previous);
}

trusted internal func exchange(
    pos lease: &bray.runtime.bootstrap.host.HostLease,
    pos anchor: &mut bray.runtime.bootstrap.host.HostAnchor,
    pos identity: u64,
    pos selected: Callback?,
    pos observer: Observer?,
    pos control: Control?,
    pos previous: DataPointer<NativeCallbacks>
) -> u32
    requires(
        trusted native_provider(),
        lease.active,
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition),
        trusted bray.runtime.bootstrap.host.host_access_idle(owner = lease),
        trusted bray.runtime.bootstrap.host.host_anchor_matches(anchor = &anchor, lease = lease)
    )
    ensures(
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition),
        trusted bray.runtime.bootstrap.host.host_access_idle(owner = lease),
    )
    executes(total)
    uses(raw_memory, unchecked_init, unchecked_alias, intrinsic)
{
    let destination = trusted lambda(pos pointer: DataPointer<NativeCallbacks>) -> DataPointer<NativeCallbacks>
        requires(trusted native_provider())
        ensures(
            trusted core.memory.valid_write<NativeCallbacks>(pointer = result, count = 1),
            trusted core.memory.aligned_for<NativeCallbacks>(pointer = result)
        )
        executes(pure, total)
    {
        return pointer;
    };

    let host = trusted bray.runtime.bootstrap.host.host_value(lease, anchor);

    if let ?storage = host.storage
    {
        let found = trusted bray.runtime.bootstrap.host.find_attachment(&mut storage, identity, 0);

        if let ?attachment = found
        {
            if attachment.closing
            {
                return bray.runtime.bootstrap.STATUS_RUNTIME_FAILURE;
            }

            let old = trusted bray.runtime.bootstrap.entry.bridge.address.context(attachment.context_bridge);
            let next = trusted bray.runtime.bootstrap.entry.bridge.address.context(selected);

            // Different Rust providers have distinct TLS contexts. Their composition
            // needs provider formation authority, not a silent callback replacement.
            if old != 0 && next != 0 && old != next
            {
                return bray.runtime.bootstrap.STATUS_RUNTIME_FAILURE;
            }

            let old_observer = trusted bray.runtime.bootstrap.entry.bridge.address.report(attachment.report_observer);
            let next_observer = trusted bray.runtime.bootstrap.entry.bridge.address.report(observer);

            if old_observer != 0 && next_observer != 0 && old_observer != next_observer
            {
                return bray.runtime.bootstrap.STATUS_RUNTIME_FAILURE;
            }

            let synchronization = trusted std.memory.borrow_from<
                bray.runtime.bootstrap.host.Synchronization,
                Uninit<bray.runtime.bootstrap.host.Synchronization>
            >(lease.synchronization, trusted bray.runtime.bootstrap.host.lease_synchronization_pointer(lease));

            let control_key = core.atomic.load<u64, 1>(&synchronization.control_key);

            let old_control = match consume trusted load_control(control_key)
            {
                case Ok(value) { yield value; }
                case Error(status) { return status; }
            };

            let next_control = trusted bray.runtime.bootstrap.entry.bridge.address.control(control);

            if old_control != 0 && next_control != 0 && old_control != next_control
            {
                return bray.runtime.bootstrap.STATUS_RUNTIME_FAILURE;
            }

            let stored = trusted store_control(control_key, control);

            if stored != 0
            {
                return stored;
            }

            attachment.context_bridge = selected;
            attachment.report_observer = observer;

            trusted std.memory.write<NativeCallbacks>(
                trusted destination(previous),
                {
                    context = trusted core.target.from_exposed_address<u8>(address = old),
                    report = trusted core.target.from_exposed_address<u8>(address = old_observer),
                    control = trusted core.target.from_exposed_address<u8>(address = old_control)
                }
            );

            return bray.runtime.bootstrap.STATUS_SUCCESS;
        }
    }

    return bray.runtime.bootstrap.STATUS_RUNTIME_FAILURE;
}

trusted internal func current() -> Result<Callback?, u32>
    requires(trusted bray.runtime.bootstrap.entry.native_entry())
    uses(layout_reinterpret)
{
    let native_address = trusted lambda(pos value: usize) -> FunctionPointer<Callback>
        requires(trusted bray.runtime.bootstrap.entry.native_entry(), value != 0)
        ensures(trusted core.memory.callable_address_valid<Callback>(pointer = result))
        executes(total)
        uses(intrinsic, layout_reinterpret)
    {
        // Lookup and invocation stay within the native scope retaining this provider.
        return trusted std.memory.function.from_data<Callback>(
            trusted core.target.from_exposed_address<u8>(address = value)
        );
    };

    let address: usize =
    {
        let lease = trusted bray.runtime.bootstrap.host.host_access();

        if !lease.active
        {
            return Error(bray.runtime.bootstrap.STATUS_RUNTIME_FAILURE);
        }

        let identity = trusted bray.runtime.bootstrap.host.current_attachment_locked(&lease);
        let mut anchor = trusted bray.runtime.bootstrap.host.host_anchor(&lease);

        yield trusted read(&lease, &mut anchor, identity, 0);
    };

    if address == 0
    {
        return Ok(none);
    }

    let mut selected: Callback? = none;

    selected = trusted std.memory.callable_from_pointer<Callback>(trusted native_address(address));

    return Ok(selected);
}

trusted internal func read(
    pos lease: &bray.runtime.bootstrap.host.HostLease,
    pos anchor: &mut bray.runtime.bootstrap.host.HostAnchor,
    pos identity: u64,
    pos kind: u32
) -> usize
    requires(
        lease.active,
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition),
        trusted bray.runtime.bootstrap.host.host_access_idle(owner = lease),
        trusted bray.runtime.bootstrap.host.host_anchor_matches(anchor = &anchor, lease = lease)
    )
    ensures(
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition),
        trusted bray.runtime.bootstrap.host.host_access_idle(owner = lease),
    )
    executes(total)
    uses(raw_memory, unchecked_alias)
{
    // Native TLS is empty during final cleanup. The host retains one closing row
    // for this exact native thread and rejects another acquisition until it retires.
    let native_thread: u64 = if kind != 0 && identity == 0
    {
        let synchronization = trusted std.memory.borrow_from<
            bray.runtime.bootstrap.host.Synchronization,
            Uninit<bray.runtime.bootstrap.host.Synchronization>
        >(lease.synchronization, trusted bray.runtime.bootstrap.host.lease_synchronization_pointer(lease));

        yield core.atomic.load<u64, 1>(&synchronization.lock);
    }
    else
    {
        yield 0;
    };

    let host = trusted bray.runtime.bootstrap.host.host_value(lease, anchor);

    if let ?storage = host.storage
    {
        let found = trusted bray.runtime.bootstrap.host.find_attachment(&mut storage, identity, native_thread);

        if let ?attachment = found
        {
            if identity == 0 && !attachment.closing
            {
                return 0;
            }

            if kind == 1
            {
                return trusted bray.runtime.bootstrap.entry.bridge.address.report(attachment.report_observer);
            }

            return trusted bray.runtime.bootstrap.entry.bridge.address.context(attachment.context_bridge);
        }
    }

    return 0;
}

trusted internal func observe(
    pos kind: u32,
    pos primary: &bray.runtime.bootstrap.ReportPrimary,
    pos digest: &bytes<32>
) -> u32
    requires(trusted bray.runtime.bootstrap.pool.protocol_access())
    uses(layout_reinterpret, foreign_call)
{
    let native_address = trusted lambda(pos value: usize) -> FunctionPointer<Observer>
        requires(trusted bray.runtime.bootstrap.pool.protocol_access(), value != 0)
        ensures(trusted core.memory.callable_address_valid<Observer>(pointer = result))
        executes(total)
        uses(intrinsic, layout_reinterpret)
    {
        return trusted std.memory.function.from_data<Observer>(
            trusted core.target.from_exposed_address<u8>(address = value)
        );
    };

    let address: usize =
    {
        let lease = trusted bray.runtime.bootstrap.host.host_access();

        if !lease.active
        {
            return bray.runtime.bootstrap.STATUS_NOT_INITIALIZED;
        }

        let identity = trusted bray.runtime.bootstrap.host.current_attachment_locked(&lease);
        let mut anchor = trusted bray.runtime.bootstrap.host.host_anchor(&lease);

        yield trusted read(&lease, &mut anchor, identity, 1);
    };

    if address == 0
    {
        return bray.runtime.bootstrap.STATUS_NOT_INITIALIZED;
    }

    let callback = trusted std.memory.callable_from_pointer<Observer>(trusted native_address(address));

    return trusted callback(
        kind,
        std.memory.address_of<bray.runtime.bootstrap.ReportPrimary>(primary),
        std.memory.address_of<bytes<32>>(digest)
    );
}

trusted internal func invoke_control(pos operation: u32) -> u32
    requires(trusted bray.runtime.bootstrap.pool.protocol_access())
    uses(raw_memory, unchecked_alias, intrinsic, layout_reinterpret, foreign_call)
{
    let native_address = trusted lambda(pos value: usize) -> FunctionPointer<Control>
        requires(trusted bray.runtime.bootstrap.pool.protocol_access(), value != 0)
        ensures(trusted core.memory.callable_address_valid<Control>(pointer = result))
        executes(total)
        uses(intrinsic, layout_reinterpret)
    {
        return trusted std.memory.function.from_data<Control>(
            trusted core.target.from_exposed_address<u8>(address = value)
        );
    };

    let synchronization = trusted std.memory.borrow_from<
        bray.runtime.bootstrap.host.Synchronization,
        Uninit<bray.runtime.bootstrap.host.Synchronization>
    >(&bray.runtime.bootstrap.host.SYNCHRONIZATION, trusted bray.runtime.bootstrap.host.synchronization_pointer());

    _ = core.atomic.fetch_add<u64, 4>(&synchronization.control_readers, 1);

    let key = core.atomic.load<u64, 4>(&synchronization.control_key);
    let selected = trusted load_control(key);

    _ = core.atomic.fetch_sub<u64, 4>(&synchronization.control_readers, 1);

    let address: usize = match consume selected
    {
        case Ok(value) { yield value; }
        case Error(_) { yield trusted core.target.abort(); }
    };

    if address == 0
    {
        return 0;
    }

    let callback = trusted std.memory.callable_from_pointer<Control>(trusted native_address(address));

    return trusted callback(operation);
}
