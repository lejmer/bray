@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.entry;

using core.memory;
using std.memory;
using std.memory.function;
using internal bray.runtime.bootstrap;
using internal bray.runtime.bootstrap.host;
using internal bray.runtime.bootstrap.host.attachment;
using internal bray.runtime.bootstrap.report.chain;
using internal bray.runtime.bootstrap.entry.bridge;

internal callable Continuation = @abi(c) trusted func(
    pos callback: DataPointer<u8>,
    pos context: usize,
    pos main: u32,
    pos outcome: DataPointer<bray.runtime.bootstrap.ReportOutcome>
) -> u32
    requires(trusted native_entry());

@abi(c)
trusted internal func root(
    pos callback: DataPointer<u8>,
    pos context: usize,
    pos outcome: DataPointer<bray.runtime.bootstrap.ReportOutcome>
) -> u32
    requires(trusted native_entry())
{
    return trusted dispatch(callback, context, 1, outcome);
}

@abi(c)
trusted internal func foreign(
    pos callback: DataPointer<u8>,
    pos context: usize,
    pos outcome: DataPointer<bray.runtime.bootstrap.ReportOutcome>
) -> u32
    requires(trusted native_entry())
{
    return trusted dispatch(callback, context, 0, outcome);
}

trusted internal func dispatch(
    pos callback: DataPointer<u8>,
    pos context: usize,
    pos main: u32,
    pos outcome: DataPointer<bray.runtime.bootstrap.ReportOutcome>
) -> u32
    requires(trusted native_entry())
    uses(layout_reinterpret, foreign_call)
{
    let selected = trusted bray.runtime.bootstrap.entry.bridge.current();

    let selected_bridge = match consume selected
    {
        case Ok(value) { yield value; }
        case Error(status) { return status; }
    };

    if let ?active_bridge = selected_bridge
    {
        let continuation: Continuation = invoke;

        let address = trusted std.memory.function.to_data<Continuation>(
            trusted std.memory.function_address<Continuation>(continuation)
        );

        return trusted active_bridge(address, callback, context, main, outcome);
    }

    return trusted invoke(callback, context, main, outcome);
}

@abi(c)
trusted internal func invoke(
    pos callback: DataPointer<u8>,
    pos context: usize,
    pos main: u32,
    pos outcome: DataPointer<bray.runtime.bootstrap.ReportOutcome>
) -> u32
    requires(trusted native_entry())
    uses(layout_reinterpret, raw_memory, unchecked_init)
{
    let address = trusted lambda(pos callback: DataPointer<u8>) -> FunctionPointer<Callback>
        requires(trusted native_entry())
        ensures(trusted core.memory.callable_address_valid<Callback>(pointer = result))
        executes(pure, total)
        uses(layout_reinterpret)
    {
        return trusted std.memory.function.from_data<Callback>(callback);
    };

    let prepare = trusted lambda()
        requires(trusted native_entry())
        ensures(
            trusted bray.runtime.bootstrap.host.attachment.native_acquisition(),
            trusted bray.runtime.bootstrap.host.native_main_entry()
        )
        executes(pure, total) {};

    trusted prepare();

    let selected = trusted std.memory.callable_from_pointer<Callback>(trusted address(callback));
    let admitted = trusted bray.runtime.bootstrap.report.chain.admit(2);

    if admitted.status != 0
    {
        let destination = trusted bray.runtime.bootstrap.entry.output(outcome);

        trusted std.memory.write<bray.runtime.bootstrap.ReportOutcome>(
            destination,
            trusted bray.runtime.bootstrap.allocation_failure(trusted bray.runtime.bootstrap.consume_address())
        );

        return bray.runtime.bootstrap.STATUS_SUCCESS;
    }

    let attachment = trusted bray.runtime.bootstrap.host.attachment.acquire();

    if attachment.status != bray.runtime.bootstrap.STATUS_SUCCESS
    {
        return attachment.status;
    }

    if main != 0
    {
        let status = trusted bray.runtime.bootstrap.host.thread_attachment_mark_main();

        if status != bray.runtime.bootstrap.STATUS_SUCCESS
        {
            return status;
        }
    }

    let records_status = trusted bray.runtime.bootstrap.report.chain.invoke(admitted, selected, context, outcome);
    let attachment_status = trusted bray.runtime.bootstrap.host.attachment.finish(attachment);

    if records_status != bray.runtime.bootstrap.STATUS_SUCCESS
    {
        return records_status;
    }

    return attachment_status;
}
