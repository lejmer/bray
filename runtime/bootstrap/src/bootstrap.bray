@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap;

using core.atomic;
using std.memory;
using internal bray.runtime.bootstrap.host;
using internal bray.runtime.bootstrap.pool;

internal const STATUS_SUCCESS: u32 = 0;

internal const STATUS_NOT_INITIALIZED: u32 = 1;

internal const STATUS_RUNTIME_FAILURE: u32 = 4;

internal const STATUS_PANICKED: u32 = 5;

internal const RUN_COMPLETED: u32 = 0;

internal const RUN_PANICKED: u32 = 2;

internal const PANIC_ALLOCATION_FAILURE: u32 = 4;

internal const ONE_USIZE: usize = 1;

@layout(c)
internal struct PanicReportData
{
    mut source_present: u32;
    mut source_identity: u32;
    mut source_start: u32;
    mut source_end: u32;
    mut source_version: u64;
    // Four scalar ABI words of one product source namespace.
    mut source_namespace_word_0: u64;
    mut source_namespace_word_1: u64;
    mut source_namespace_word_2: u64;
    mut source_namespace_word_3: u64;
    mut cause: u32;
    mut primary_present: u32;
    mut message: usize;
    mut message_length: usize;
    // Native callback addresses identify retained code, not writable byte storage.
    // Reconstructing a callable still requires the native producer witness.
    mut copy_message: usize;
    mut release_message: usize;
    mut provider_context: usize;
    mut provider_callbacks: usize;
    mut outgoing_head: usize;
    mut outgoing_tail: usize;
    mut outgoing_count: usize;
    mut reserved: usize;
    mut consumer: usize;
}

@abi(c)
trusted internal func runtime_initialization(pos worker_capacity: usize, pos timer_capacity: usize) -> u32
    uses(foreign_call)
{
    let existing_host: bool = trusted bray.runtime.bootstrap.host.initialized();
    let status: u32 = trusted bray.runtime.bootstrap.host.initialize_host();

    if status != STATUS_SUCCESS
    {
        return status;
    }

    let initialized: u32 = trusted substrate_initialization(worker_capacity, timer_capacity);

    if initialized != STATUS_SUCCESS && !existing_host
    {
        _ = trusted bray.runtime.bootstrap.host.shutdown_host();
    }

    return initialized;
}

@abi(c)
trusted internal func structured_shutdown() -> u32
    requires(trusted bray.runtime.bootstrap.pool.protocol_access())
{
    if !trusted bray.runtime.bootstrap.pool.reports_released()
    {
        return STATUS_RUNTIME_FAILURE;
    }

    let shutdown: u32 = trusted bray.runtime.bootstrap.host.shutdown_host();

    if shutdown != STATUS_SUCCESS
    {
        return shutdown;
    }

    if !trusted bray.runtime.bootstrap.pool.release()
    {
        return STATUS_RUNTIME_FAILURE;
    }

    return STATUS_SUCCESS;
}

@link(name = "bray_runtime_host", kind = system)
@symbol(name = "bray_runtime_substrate_initialization")
@abi(c)
extern trusted internal func substrate_initialization(pos worker_capacity: usize, pos timer_capacity: usize) -> u32
    uses(foreign_call);
