@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap;

using std.memory;

internal const STATUS_SUCCESS: u32 = 0;
internal const STATUS_NOT_INITIALIZED: u32 = 1;
internal const STATUS_ALREADY_INITIALIZED: u32 = 2;
internal const STATUS_INVALID_ARGUMENT: u32 = 3;
internal const STATUS_RUNTIME_FAILURE: u32 = 4;


internal const INITIALIZATION_EMPTY: u32 = 0;
internal const INITIALIZATION_PENDING: u32 = 1;
internal const INITIALIZATION_READY: u32 = 2;

internal const ONE_USIZE: usize = 1;

@copy
@layout(stable)
internal struct PanicReportData
{
    mut next_incident: usize?;
    incident: PanicIncident;
}

@copy
@layout(stable)
internal union PanicIncident
{
    Panic(pos message: PanicMessage);
    Cleanup(pos value: CleanupIncident);
}

@copy
@layout(stable)
internal struct PanicMessage
{
    cause: u32;
    source_present: u32;
    source_identity: u32;
    source_start: u32;
    source_end: u32;
    source_version: u64;
    message: RawPointer<u8>;
    message_length: usize;
}

internal static SUBSTRATE_INITIALIZED: core.atomic.Atomic<u32> = core.atomic.initialize<u32>(0);

internal static CONSTRUCTED_REPORTS: core.atomic.Atomic<u64> = core.atomic.initialize<u64>(0);

internal static CONSUMED_REPORTS: core.atomic.Atomic<u64> = core.atomic.initialize<u64>(0);

@abi(c)
trusted internal func runtime_initialization(pos worker_capacity: usize, pos timer_capacity: usize) -> u32
    uses(foreign_call)
{
    let (_, acquired) = core.atomic.compare_exchange<u32, 3, 1>(
        &SUBSTRATE_INITIALIZED,
        expected = INITIALIZATION_EMPTY,
        desired = INITIALIZATION_PENDING,
    );

    if !acquired
    {
        return STATUS_ALREADY_INITIALIZED;
    }

    let substrate_status: u32 = trusted substrate_initialization(worker_capacity, timer_capacity);

    if substrate_status != STATUS_SUCCESS
    {
        core.atomic.store<u32, 2>(&SUBSTRATE_INITIALIZED, value = INITIALIZATION_EMPTY);

        return substrate_status;
    }

    core.atomic.store<u32, 2>(&SUBSTRATE_INITIALIZED, value = INITIALIZATION_READY);

    return STATUS_SUCCESS;
}

@abi(c)
trusted internal func structured_shutdown() -> u32
    uses(foreign_call)
{
    if core.atomic.load<u64, 1>(&CONSTRUCTED_REPORTS) != core.atomic.load<u64, 1>(&CONSUMED_REPORTS)
    {
        return STATUS_RUNTIME_FAILURE;
    }

    let status: u32 = trusted substrate_shutdown();

    if status == STATUS_SUCCESS || status == STATUS_NOT_INITIALIZED
    {
        core.atomic.store<u32, 2>(&SUBSTRATE_INITIALIZED, value = INITIALIZATION_EMPTY);
    }

    return status;
}

@link(name = "bray_runtime_host", kind = system)
@symbol(name = "bray_runtime_substrate_initialization")
@abi(c)
extern trusted internal func substrate_initialization(
    pos worker_capacity: usize,
    pos timer_capacity: usize,
) -> u32
    uses(foreign_call);

@link(name = "bray_runtime_host", kind = system)
@symbol(name = "bray_runtime_substrate_shutdown")
@abi(c)
extern trusted internal func substrate_shutdown() -> u32
    uses(foreign_call);

trusted internal func panic_report_from_payload(pos payload: usize) -> RawPointer<PanicReportData>
    ensures(
        trusted core.memory.valid_read<PanicReportData>(pointer = result, count = 1),
        trusted core.memory.aligned_for<PanicReportData>(pointer = result),
        trusted core.memory.initialized_as<PanicReportData>(pointer = result),
    )
    uses(intrinsic)
{
    return trusted core.target.from_exposed_address<PanicReportData>(address = payload);
}

trusted internal func read_opaque<T>(pos pointer: RawPointer<T>) -> T
    uses(layout_reinterpret, raw_memory, unchecked_init)
{
    let mut storage: Uninit<T> = std.memory.uninit<T>();
    let source: RawPointer<u8> = trusted std.memory.reinterpret<u8, T>(pointer);
    let destination: RawPointer<u8> = trusted std.memory.reinterpret<u8, T>(
        std.memory.uninit_pointer_mut<T>(&mut storage)
    );

    trusted internal std.memory.byte_buffer_copy(
        source,
        destination = destination,
        count = std.memory.size_of<T>(),
    );

    return trusted std.memory.assume_initialized<T>(storage);
}

trusted internal func write_opaque<T>(pos pointer: RawPointer<T>, pos value: T)
    uses(layout_reinterpret, raw_memory, unchecked_init)
{
    let source: RawPointer<u8> = trusted std.memory.reinterpret<u8, T>(std.memory.address_of<T>(&value));
    let destination: RawPointer<u8> = trusted std.memory.reinterpret<u8, T>(pointer);

    trusted internal std.memory.byte_buffer_copy(
        source,
        destination = destination,
        count = std.memory.size_of<T>(),
    );
}
