@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap;

using std.memory;

internal const STATUS_SUCCESS: u32 = 0;
internal const STATUS_NOT_INITIALIZED: u32 = 1;
internal const STATUS_ALREADY_INITIALIZED: u32 = 2;
internal const STATUS_INVALID_ARGUMENT: u32 = 3;
internal const STATUS_RUNTIME_FAILURE: u32 = 4;

internal const RUN_COMPLETED: u32 = 0;
internal const RUN_CANCELLED: u32 = 1;
internal const RUN_PANICKED: u32 = 2;
internal const RUN_RUNTIME_FAILURE: u32 = 3;

internal const INITIALIZATION_EMPTY: u32 = 0;
internal const INITIALIZATION_PENDING: u32 = 1;
internal const INITIALIZATION_READY: u32 = 2;
internal const INITIALIZATION_CLOSED: u32 = 3;

internal const ATTACHMENT_ACTIVE: u32 = 0;
internal const ATTACHMENT_CLEANING: u32 = 1;
internal const ATTACHMENT_GATE_CLOSING: u64 = 0x8000000000000000;
internal const ATTACHMENT_GATE_COUNT_MASK: u64 = 0x7fffffffffffffff;

internal const ONE_USIZE: usize = 1;

@copy
@layout(c)
internal struct PlatformStatus
{
    category: u32;
    reserved: u32;
    native_code: i64;
}

@copy
@layout(c)
internal struct RunOutcome
{
    state: u32;
    payload: usize;
}

@copy
@layout(c)
internal struct ProductHostObservation
{
    status: u32;
    state: u32;
    active_entries: usize;
    external_roots: usize;
    thread_attachments: usize;
    initialized_statics: usize;
    cleaned_statics: usize;
    cleanup_incidents: usize;
    last_incident_0: u64;
    last_incident_1: u64;
    last_incident_2: u64;
    last_incident_3: u64;
}

internal callable SubstrateCleanup = @abi(c)
trusted func();

internal callable ThreadStorageDestructor = @abi(c)
trusted func(pos value: RawPointer<u8>);

@copy
@layout(c)
internal struct AttachmentState
{
    identity: u64;
    depth: usize;
    phase: u32;
    runtime_context: usize;
    task_context: usize;
    cancellation_context: usize;
    product_attachment_state: usize;
    cleanups: RawPointer<CleanupRecord>;
}

@copy
@layout(c)
internal struct PanicReportData
{
    cause: u32;
    source_present: u32;
    source_identity: u32;
    source_start: u32;
    source_end: u32;
    source_version: u64;
    message: RawPointer<u8>;
    message_length: usize;
}

internal static BOOTSTRAP_KEY: core.atomic.Atomic<u64> = core.atomic.initialize<u64>(0);

internal static BOOTSTRAP_INITIALIZED: core.atomic.Atomic<u32> = core.atomic.initialize<u32>(0);

internal static SUBSTRATE_INITIALIZED: core.atomic.Atomic<u32> = core.atomic.initialize<u32>(0);

internal static NEXT_ATTACHMENT_IDENTITY: core.atomic.Atomic<u64> = core.atomic.initialize<u64>(1);

internal static ATTACHMENT_GATE: core.atomic.Atomic<u64> = core.atomic.initialize<u64>(0);

internal static CONSTRUCTED_REPORTS: core.atomic.Atomic<u64> = core.atomic.initialize<u64>(0);

internal static CONSUMED_REPORTS: core.atomic.Atomic<u64> = core.atomic.initialize<u64>(0);

@abi(c)
trusted internal func runtime_initialization(pos worker_capacity: usize, pos timer_capacity: usize) -> u32
    uses(foreign_call)
{
    if trusted ensure_bootstrap_initialized(reopen = true) != STATUS_SUCCESS
    {
        return STATUS_RUNTIME_FAILURE;
    }

    let (_, acquired) = core.atomic.compare_exchange<u32, 3, 1>(
        &SUBSTRATE_INITIALIZED,
        expected = INITIALIZATION_EMPTY,
        desired = INITIALIZATION_PENDING,
    );

    if !acquired
    {
        return STATUS_ALREADY_INITIALIZED;
    }

    let substrate_status: u32 = trusted substrate_initialization(worker_capacity, timer_capacity);

    if substrate_status != STATUS_SUCCESS
    {
        core.atomic.store<u32, 2>(&SUBSTRATE_INITIALIZED, value = INITIALIZATION_EMPTY);

        return substrate_status;
    }

    core.atomic.store<u32, 2>(&SUBSTRATE_INITIALIZED, value = INITIALIZATION_READY);

    return STATUS_SUCCESS;
}

trusted internal func ensure_bootstrap_initialized(pos reopen: bool) -> u32
    uses(layout_reinterpret)
{
    let state: u32 = core.atomic.load<u32, 1>(&BOOTSTRAP_INITIALIZED);

    if state == INITIALIZATION_READY
    {
        return STATUS_SUCCESS;
    }

    if state == INITIALIZATION_CLOSED && !reopen
    {
        return STATUS_NOT_INITIALIZED;
    }

    let expected: u32 = if state == INITIALIZATION_CLOSED
    {
        yield INITIALIZATION_CLOSED;
    }
    else
    {
        yield INITIALIZATION_EMPTY;
    };

    let (_, acquired) = core.atomic.compare_exchange<u32, 3, 1>(
        &BOOTSTRAP_INITIALIZED,
        expected = expected,
        desired = INITIALIZATION_PENDING,
    );

    if !acquired
    {
        return STATUS_RUNTIME_FAILURE;
    }

    let destructor: ThreadStorageDestructor = thread_exit_cleanup;
    let destructor_pointer: RawPointer<ThreadStorageDestructor> = trusted std.memory.pointer_from_callable(destructor);
    let destructor_bytes: RawPointer<u8> = trusted std.memory.reinterpret<u8, ThreadStorageDestructor>(destructor_pointer);
    let key: RawPointer<u64> = trusted atomic_u64_pointer(&BOOTSTRAP_KEY);
    let status: PlatformStatus = trusted platform_thread_storage_create(destructor_bytes, key);

    if status.category != 0
    {
        core.atomic.store<u32, 2>(&BOOTSTRAP_INITIALIZED, value = INITIALIZATION_EMPTY);

        return STATUS_RUNTIME_FAILURE;
    }

    core.atomic.store<u64, 2>(&ATTACHMENT_GATE, value = 0);
    core.atomic.store<u32, 2>(&BOOTSTRAP_INITIALIZED, value = INITIALIZATION_READY);

    return STATUS_SUCCESS;
}

@abi(c)
trusted internal func structured_shutdown() -> u32
{
    let initialization: u32 = core.atomic.load<u32, 1>(&BOOTSTRAP_INITIALIZED);

    if initialization == INITIALIZATION_CLOSED
    {
        return STATUS_NOT_INITIALIZED;
    }

    if initialization == INITIALIZATION_EMPTY
    {
        let status: u32 = trusted finish_substrate_shutdown(allow_not_initialized = false);

        if status == STATUS_SUCCESS
        {
            core.atomic.store<u32, 2>(&BOOTSTRAP_INITIALIZED, value = INITIALIZATION_CLOSED);
        }

        return status;
    }

    let (_, acquired) = core.atomic.compare_exchange<u64, 3, 1>(
        &ATTACHMENT_GATE,
        expected = 0,
        desired = ATTACHMENT_GATE_CLOSING,
    );

    if !acquired
    {
        return STATUS_RUNTIME_FAILURE;
    }

    if core.atomic.load<u64, 1>(&CONSTRUCTED_REPORTS) != core.atomic.load<u64, 1>(&CONSUMED_REPORTS)
    {
        core.atomic.store<u64, 2>(&ATTACHMENT_GATE, value = 0);

        return STATUS_RUNTIME_FAILURE;
    }

    let key: u64 = core.atomic.load<u64, 1>(&BOOTSTRAP_KEY);
    let status: PlatformStatus = trusted platform_thread_storage_destroy(key);

    if status.category != 0
    {
        core.atomic.store<u64, 2>(&ATTACHMENT_GATE, value = 0);

        return STATUS_RUNTIME_FAILURE;
    }

    core.atomic.store<u64, 2>(&BOOTSTRAP_KEY, value = 0);
    core.atomic.store<u32, 2>(&BOOTSTRAP_INITIALIZED, value = INITIALIZATION_CLOSED);
    core.atomic.store<u64, 2>(&ATTACHMENT_GATE, value = 0);

    return trusted finish_substrate_shutdown(allow_not_initialized = true);
}

trusted internal func finish_substrate_shutdown(pos allow_not_initialized: bool) -> u32
    uses(foreign_call)
{
    let status: u32 = trusted substrate_shutdown();

    core.atomic.store<u32, 2>(&SUBSTRATE_INITIALIZED, value = INITIALIZATION_EMPTY);

    if status == STATUS_NOT_INITIALIZED && allow_not_initialized
    {
        return STATUS_SUCCESS;
    }

    return status;
}

@link(name = "bray_runtime_host", kind = system)
@symbol(name = "bray_runtime_substrate_initialization")
@abi(c)
extern trusted internal func substrate_initialization(
    pos worker_capacity: usize,
    pos timer_capacity: usize,
) -> u32
    uses(foreign_call);

@link(name = "bray_runtime_host", kind = system)
@symbol(name = "bray_runtime_substrate_shutdown")
@abi(c)
extern trusted internal func substrate_shutdown() -> u32
    uses(foreign_call);

@link(name = "bray_runtime_host", kind = system)
@symbol(name = "bray_runtime_substrate_product_host_control")
@abi(c)
extern trusted internal func substrate_product_host_control(
    pos descriptor: RawPointer<u8>,
    pos operation: u32,
) -> ProductHostObservation
    uses(foreign_call);

@abi(c)
trusted internal func product_host_control(
    pos descriptor: RawPointer<u8>,
    pos operation: u32,
) -> ProductHostObservation
    uses(foreign_call)
{
    return trusted substrate_product_host_control(descriptor, operation = operation);
}

@link(name = "bray_runtime_host", kind = system)
@symbol(name = "bray_runtime_substrate_thread_attachment_identity")
@abi(c)
extern trusted internal func substrate_thread_attachment_identity(pos descriptor: RawPointer<u8>) -> u64
    uses(foreign_call);

@abi(c)
trusted internal func thread_attachment_identity(pos descriptor: RawPointer<u8>) -> u64
    uses(foreign_call)
{
    if !std.memory.is_null<u8>(descriptor)
    {
        return trusted substrate_thread_attachment_identity(descriptor);
    }

    let existing: RawPointer<AttachmentState> = trusted load_attachment();
    let state: RawPointer<AttachmentState> = if std.memory.is_null<AttachmentState>(existing)
    {
        yield trusted attach(descriptor);
    }
    else
    {
        yield existing;
    };

    if std.memory.is_null<AttachmentState>(state)
    {
        return 0;
    }

    return trusted read_opaque<AttachmentState>(state).identity;
}

@abi(c)
trusted internal func native_thread_execution(
    pos operation: RawPointer<u8>,
    pos context: usize,
    pos cancellation: RawPointer<u8>,
    pos cancellation_context: usize,
    pos panic_payload: RawPointer<usize>,
) -> u32
    uses(foreign_call)
{
    let state: RawPointer<AttachmentState> = trusted attach(std.memory.null<u8>());

    if std.memory.is_null<AttachmentState>(state)
    {
        return RUN_RUNTIME_FAILURE;
    }

    let outcome: u32 = trusted substrate_native_thread_execution(
        operation,
        context = context,
        cancellation = cancellation,
        cancellation_context = cancellation_context,
        panic_payload = panic_payload,
        cleanup = trusted substrate_native_thread_cleanup_pointer(),
    );

    return outcome;
}

@link(name = "bray_runtime_callback", kind = system)
@symbol(name = "bray_runtime_substrate_native_thread_execution")
@abi(c)
extern trusted internal func substrate_native_thread_execution(
    pos operation: RawPointer<u8>,
    pos context: usize,
    pos cancellation: RawPointer<u8>,
    pos cancellation_context: usize,
    pos panic_payload: RawPointer<usize>,
    pos cleanup: RawPointer<u8>,
) -> u32
    uses(foreign_call);

@abi(c)
trusted internal func thread_exit_cleanup(pos value: RawPointer<u8>)
{
    let pointer: RawPointer<AttachmentState> = trusted attachment_from_opaque(value);

    trusted finish_attachment(pointer);
}

trusted internal func prepare_substrate_callback(pos callback: RawPointer<u8>) -> u32
{
    if std.memory.is_null<u8>(callback)
    {
        return STATUS_INVALID_ARGUMENT;
    }

    let state: RawPointer<AttachmentState> = trusted attach(std.memory.null<u8>());

    if std.memory.is_null<AttachmentState>(state)
    {
        return STATUS_RUNTIME_FAILURE;
    }

    return STATUS_SUCCESS;
}

@abi(c)
trusted internal func substrate_thread_cleanup_callback()
{
    trusted detach();
}

@abi(c)
trusted internal func substrate_native_thread_cleanup_callback()
{
    let state: RawPointer<AttachmentState> = trusted load_attachment();

    if !std.memory.is_null<AttachmentState>(state)
    {
        trusted finish_attachment(state);
    }
}

trusted internal func substrate_cleanup_pointer() -> RawPointer<u8>
    uses(layout_reinterpret)
{
    let cleanup: SubstrateCleanup = substrate_thread_cleanup_callback;
    let pointer: RawPointer<SubstrateCleanup> = trusted std.memory.pointer_from_callable(cleanup);

    return trusted std.memory.reinterpret<u8, SubstrateCleanup>(pointer);
}

trusted internal func substrate_native_thread_cleanup_pointer() -> RawPointer<u8>
    uses(layout_reinterpret)
{
    let cleanup: SubstrateCleanup = substrate_native_thread_cleanup_callback;
    let pointer: RawPointer<SubstrateCleanup> = trusted std.memory.pointer_from_callable(cleanup);

    return trusted std.memory.reinterpret<u8, SubstrateCleanup>(pointer);
}

trusted internal func attach(pos product: RawPointer<u8>) -> RawPointer<AttachmentState>
    ensures(
        std.memory.is_null<AttachmentState>(result)
            || trusted core.memory.valid_read<AttachmentState>(pointer = result, count = 1),
        std.memory.is_null<AttachmentState>(result)
            || trusted core.memory.valid_write<AttachmentState>(pointer = result, count = 1),
        std.memory.is_null<AttachmentState>(result)
            || trusted core.memory.aligned_for<AttachmentState>(pointer = result),
        std.memory.is_null<AttachmentState>(result)
            || trusted core.memory.initialized_as<AttachmentState>(pointer = result),
    )
    uses(intrinsic, layout_reinterpret)
{
    if trusted ensure_bootstrap_initialized(reopen = false) != STATUS_SUCCESS
    {
        return std.memory.null<AttachmentState>();
    }

    let existing: RawPointer<AttachmentState> = trusted load_attachment();

    if !std.memory.is_null<AttachmentState>(existing)
    {
        let current: AttachmentState = trusted read_opaque<AttachmentState>(existing);

        if current.phase != ATTACHMENT_ACTIVE
        {
            return std.memory.null<AttachmentState>();
        }

        trusted write_opaque<AttachmentState>(
            existing,
            {
                identity = current.identity,
                depth = current.depth + ONE_USIZE,
                phase = current.phase,
                runtime_context = current.runtime_context,
                task_context = current.task_context,
                cancellation_context = current.cancellation_context,
                product_attachment_state = current.product_attachment_state,
                cleanups = current.cleanups,
            }
        );

        return existing;
    }

    if !trusted acquire_attachment_admission()
    {
        return std.memory.null<AttachmentState>();
    }

    let bytes: usize = internal bray.runtime.bootstrap.heap.allocation_bytes<AttachmentState>();
    let allocation: RawPointer<u8> = trusted internal bray.runtime.bootstrap.heap.allocate(
        bytes,
        align = std.memory.align_of<AttachmentState>()
    );

    if std.memory.is_null<u8>(allocation)
    {
        trusted release_attachment_admission();

        return std.memory.null<AttachmentState>();
    }

    let identity: u64 = core.atomic.fetch_add<u64, 0>(&NEXT_ATTACHMENT_IDENTITY, value = 1);

    if identity == 0
    {
        trusted core.target.abort();
    }

    let state: RawPointer<AttachmentState> = trusted std.memory.reinterpret<AttachmentState, u8>(allocation);

    trusted write_opaque<AttachmentState>(
        state,
        {
            identity = identity,
            depth = ONE_USIZE,
            phase = ATTACHMENT_ACTIVE,
            runtime_context = trusted core.target.expose_address<core.atomic.Atomic<u64>>(
                std.memory.address_of<core.atomic.Atomic<u64>>(&BOOTSTRAP_KEY)
            ),
            task_context = 0,
            cancellation_context = 0,
            product_attachment_state = trusted core.target.expose_address<u8>(product),
            cleanups = std.memory.null<CleanupRecord>(),
        }
    );

    let key: u64 = core.atomic.load<u64, 1>(&BOOTSTRAP_KEY);
    let status: PlatformStatus = trusted platform_thread_storage_store(key, allocation);

    if status.category != 0
    {
        trusted release_attachment_admission();

        trusted internal bray.runtime.bootstrap.heap.deallocate_bytes(
            allocation,
            bytes = bytes,
            align = std.memory.align_of<AttachmentState>(),
        );

        return std.memory.null<AttachmentState>();
    }

    return state;
}

trusted internal func acquire_attachment_admission() -> bool
    uses(intrinsic)
{
    let mut gate: u64 = core.atomic.load<u64, 1>(&ATTACHMENT_GATE);

    while gate & ATTACHMENT_GATE_CLOSING == 0
    {
        if gate & ATTACHMENT_GATE_COUNT_MASK == ATTACHMENT_GATE_COUNT_MASK
        {
            trusted core.target.abort();
        }

        let (observed, acquired) = core.atomic.compare_exchange<u64, 3, 1>(
            &ATTACHMENT_GATE,
            expected = gate,
            desired = gate + 1,
        );

        if acquired
        {
            return true;
        }

        gate = observed;
    }

    return false;
}

trusted internal func release_attachment_admission()
    uses(intrinsic)
{
    let previous: u64 = core.atomic.fetch_sub<u64, 3>(&ATTACHMENT_GATE, value = 1);

    if previous & ATTACHMENT_GATE_CLOSING != 0 || previous & ATTACHMENT_GATE_COUNT_MASK == 0
    {
        trusted core.target.abort();
    }
}

trusted internal func detach()
{
    let state: RawPointer<AttachmentState> = trusted load_attachment();

    if std.memory.is_null<AttachmentState>(state)
    {
        return;
    }

    let current: AttachmentState = trusted read_opaque<AttachmentState>(state);

    if current.phase != ATTACHMENT_ACTIVE
    {
        return;
    }

    if current.depth > 1
    {
        trusted write_opaque<AttachmentState>(
            state,
            {
                identity = current.identity,
                depth = current.depth - ONE_USIZE,
                phase = current.phase,
                runtime_context = current.runtime_context,
                task_context = current.task_context,
                cancellation_context = current.cancellation_context,
                product_attachment_state = current.product_attachment_state,
                cleanups = current.cleanups,
            }
        );

        return;
    }

    trusted finish_attachment(state);
}

trusted internal func finish_attachment(pos state: RawPointer<AttachmentState>)
    requires(
        trusted core.memory.valid_read<AttachmentState>(pointer = state, count = 1),
        trusted core.memory.aligned_for<AttachmentState>(pointer = state),
        trusted core.memory.initialized_as<AttachmentState>(pointer = state),
    )
    uses(intrinsic, layout_reinterpret)
{
    if std.memory.is_null<AttachmentState>(state)
    {
        return;
    }

    let current: AttachmentState = trusted read_opaque<AttachmentState>(state);

    if current.phase == ATTACHMENT_CLEANING
    {
        return;
    }

    trusted write_opaque<AttachmentState>(
        state,
        {
            identity = current.identity,
            depth = 0,
            phase = ATTACHMENT_CLEANING,
            runtime_context = current.runtime_context,
            task_context = current.task_context,
            cancellation_context = current.cancellation_context,
            product_attachment_state = current.product_attachment_state,
            cleanups = current.cleanups,
        }
    );

    let key: u64 = core.atomic.load<u64, 1>(&BOOTSTRAP_KEY);
    let publish_status: PlatformStatus = trusted platform_thread_storage_store(
        key,
        trusted std.memory.reinterpret<u8, AttachmentState>(state),
    );

    if publish_status.category != 0
    {
        trusted core.target.abort();
    }

    let mut cleanup: RawPointer<CleanupRecord> = current.cleanups;

    while !std.memory.is_null<CleanupRecord>(cleanup)
    {
        let record: CleanupRecord = trusted read_opaque<CleanupRecord>(cleanup);

        trusted invoke_static_transition(record.prepare);
        trusted run_static_finalizer(record.finalizer);
        trusted invoke_static_transition(record.destroy);
        trusted invoke_static_transition(record.detach);

        let released: RawPointer<CleanupRecord> = cleanup;
        cleanup = record.next;
        trusted internal bray.runtime.bootstrap.heap.deallocate<CleanupRecord>(released);
    }

    let clear_status: PlatformStatus = trusted platform_thread_storage_store(key, std.memory.null<u8>());

    if clear_status.category != 0
    {
        trusted core.target.abort();
    }

    trusted release_attachment_admission();

    trusted internal bray.runtime.bootstrap.heap.deallocate<AttachmentState>(state);
}

trusted internal func load_attachment() -> RawPointer<AttachmentState>
    ensures(
        std.memory.is_null<AttachmentState>(result)
            || trusted core.memory.valid_read<AttachmentState>(pointer = result, count = 1),
        std.memory.is_null<AttachmentState>(result)
            || trusted core.memory.valid_write<AttachmentState>(pointer = result, count = 1),
        std.memory.is_null<AttachmentState>(result)
            || trusted core.memory.aligned_for<AttachmentState>(pointer = result),
        std.memory.is_null<AttachmentState>(result)
            || trusted core.memory.initialized_as<AttachmentState>(pointer = result),
    )
    uses(layout_reinterpret)
{
    if core.atomic.load<u32, 1>(&BOOTSTRAP_INITIALIZED) != INITIALIZATION_READY
    {
        return std.memory.null<AttachmentState>();
    }

    let mut value: RawPointer<u8> = std.memory.null<u8>();
    let key: u64 = core.atomic.load<u64, 1>(&BOOTSTRAP_KEY);
    let status: PlatformStatus = trusted platform_thread_storage_load(
        key,
        std.memory.address_of_mut<RawPointer<u8>>(&mut value)
    );

    if status.category != 0
    {
        return std.memory.null<AttachmentState>();
    }

    return trusted std.memory.reinterpret<AttachmentState, u8>(value);
}

trusted internal func attachment_from_opaque(pos pointer: RawPointer<u8>) -> RawPointer<AttachmentState>
    ensures(
        std.memory.is_null<AttachmentState>(result)
            || trusted core.memory.valid_read<AttachmentState>(pointer = result, count = 1),
        std.memory.is_null<AttachmentState>(result)
            || trusted core.memory.aligned_for<AttachmentState>(pointer = result),
        std.memory.is_null<AttachmentState>(result)
            || trusted core.memory.initialized_as<AttachmentState>(pointer = result),
    )
    uses(layout_reinterpret)
{
    return trusted std.memory.reinterpret<AttachmentState, u8>(pointer);
}

trusted internal func panic_report_from_payload(pos payload: usize) -> RawPointer<PanicReportData>
    ensures(
        trusted core.memory.valid_read<PanicReportData>(pointer = result, count = 1),
        trusted core.memory.aligned_for<PanicReportData>(pointer = result),
        trusted core.memory.initialized_as<PanicReportData>(pointer = result),
    )
    uses(intrinsic)
{
    return trusted core.target.from_exposed_address<PanicReportData>(address = payload);
}

trusted internal func read_opaque<T>(pos pointer: RawPointer<T>) -> T
    uses(layout_reinterpret, raw_memory, unchecked_init)
{
    let mut storage: Uninit<T> = std.memory.uninit<T>();
    let source: RawPointer<u8> = trusted std.memory.reinterpret<u8, T>(pointer);
    let destination: RawPointer<u8> = trusted std.memory.reinterpret<u8, T>(
        std.memory.uninit_pointer_mut<T>(&mut storage)
    );

    trusted internal std.memory.byte_buffer_copy(
        source,
        destination = destination,
        count = std.memory.size_of<T>(),
    );

    return trusted std.memory.assume_initialized<T>(storage);
}

trusted internal func write_opaque<T>(pos pointer: RawPointer<T>, pos value: T)
    uses(layout_reinterpret, raw_memory, unchecked_init)
{
    let source: RawPointer<u8> = trusted std.memory.reinterpret<u8, T>(std.memory.address_of<T>(&value));
    let destination: RawPointer<u8> = trusted std.memory.reinterpret<u8, T>(pointer);

    trusted internal std.memory.byte_buffer_copy(
        source,
        destination = destination,
        count = std.memory.size_of<T>(),
    );
}

trusted internal func atomic_u64_pointer(pos atomic: &core.atomic.Atomic<u64>) -> RawPointer<u64>
    uses(layout_reinterpret)
{
    let pointer: RawPointer<core.atomic.Atomic<u64>> = std.memory.address_of<core.atomic.Atomic<u64>>(atomic);

    return trusted std.memory.reinterpret<u64, core.atomic.Atomic<u64>>(pointer);
}
