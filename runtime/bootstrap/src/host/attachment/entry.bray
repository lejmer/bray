@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.host;

using std.numeric;
using core.target;
using core.atomic;
using std.memory;
using internal bray.runtime.bootstrap;
using internal std.platform;
using internal std.thread;

@abi(c)
trusted internal func thread_attachment_enter() -> u32
    requires(trusted bray.runtime.bootstrap.host.attachment.native_acquisition())
{
    let transfer = trusted lambda(pos owner: &mut bray.runtime.bootstrap.host.attachment.Owner) -> u32
        requires(trusted bray.runtime.bootstrap.host.attachment.acquired(owner = &owner))
        ensures(trusted bray.runtime.bootstrap.host.attachment.acquired(owner = &owner))
        executes(total)
    {
        let status = owner.status;

        owner.status = bray.runtime.bootstrap.STATUS_RUNTIME_FAILURE;
        return status;
    };

    let mut owner = trusted bray.runtime.bootstrap.host.attachment.acquire();

    return trusted transfer(&mut owner);
}

trusted internal func enter_attachment_locked(
    pos lease: &HostLease,
    pos prepared: &mut(std.memory.RawBuffer<Attachment>?)
) -> Result<(u32, u64), usize>
    requires(
        lease.active,
        trusted host_access_idle(owner = lease),
        trusted host_access_live(owner = &lease.acquisition)
    )
    ensures(
        trusted host_access_live(owner = &lease.acquisition),
        trusted host_access_idle(owner = lease),
        trusted attachment_cleanup_completed(owner = lease)
    )
    executes(total)
    uses(foreign_call, intrinsic, raw_memory, unchecked_alias)
{
    let no_identity: u64 = 0;
    let unavailable = (bray.runtime.bootstrap.STATUS_RUNTIME_FAILURE, no_identity);

    let synchronization = trusted std.memory.borrow_from<Synchronization, Uninit<Synchronization>>(
        lease.synchronization,
        trusted lease_synchronization_pointer(lease)
    );

    let native_thread = core.atomic.load<u64, 1>(&synchronization.lock);
    let identity = trusted current_attachment_locked(lease);

    if !lease.active
    {
        return Ok(unavailable);
    }

    let mut anchor = trusted host_anchor(lease);
    let host: &mut HostOwner = trusted host_value(lease, &mut anchor);

    if host.storage matches none
    {
        return Ok(unavailable);
    }

    let next: u64 = host.next_identity;

    if identity == 0
    {
        if next == std.numeric.U64_MAX
        {
            return Ok(unavailable);
        }

        host.next_identity += 1;
    }

    let storage: &mut HostStorage = if let ?storage = host.storage
    {
        yield &mut storage;
    }
    else
    {
        return Ok(unavailable);
    };

    let key: u64 = storage.key;

    if identity != 0
    {
        let selected = trusted find_attachment(storage, identity, 0);

        match consume selected
        {
            case ?entry
            {
                if entry.closing || entry.native_thread != native_thread || entry.depth == std.numeric.USIZE_MAX
                {
                    return Ok(unavailable);
                }

                entry.depth += 1;
                return Ok((bray.runtime.bootstrap.STATUS_SUCCESS, identity));
            }
            case none {}
        }

        return Ok(unavailable);
    }

    if storage.active == std.numeric.USIZE_MAX
    {
        return Ok(unavailable);
    }

    let inserted: bool = match consume trusted insert_attachment(storage, next, native_thread, prepared)
    {
        case Ok(inserted) { yield inserted; }
        case Error(capacity) { return Error(capacity); }
    };

    if !inserted
    {
        return Ok(unavailable);
    }

    storage.active += 1;

    let pointer: DataPointer<u8> = trusted core.target.from_exposed_address<u8>(address = next as usize);

    let published: std.platform.PlatformStatus = trusted internal std.thread.platform_thread_storage_store(
        key,
        pointer
    );

    if published.category != 0
    {
        {
            let selected = trusted find_attachment(storage, next, 0);

            match consume selected
            {
                case ?entry
                {
                    entry.identity = 0;
                    entry.depth = 0;
                }
                case none {}
            }
        }

        storage.active -= 1;
        return Ok(unavailable);
    }

    return Ok((bray.runtime.bootstrap.STATUS_SUCCESS, next));
}
