@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.host;

using std.numeric;
using core.target;
using core.atomic;
using core.memory;
using std.memory;
using internal bray.runtime.bootstrap;
using internal bray.runtime.bootstrap.thread.destruction;
using internal bray.runtime.bootstrap.entry.bridge;
using internal std.platform;
using internal std.memory;
using internal std.thread;

internal callable AttachmentCleanup = @abi(c) func(pos identity: u64) -> u32;

internal struct Attachment
{
    mut identity: u64;
    mut native_thread: u64;
    mut depth: usize;
    mut closing: bool;
    mut cleanup: AttachmentExit?;
    mut context_bridge: bray.runtime.bootstrap.entry.bridge.Callback?;
    mut report_observer: bray.runtime.bootstrap.entry.bridge.Observer?;
    mut domains: std.memory.RawBuffer<bray.runtime.bootstrap.host.product.ThreadDomain>?;
}

internal struct HostOwner
{
    mut storage: HostStorage?;
    mut products: std.memory.RawBuffer<bray.runtime.bootstrap.host.product.Product>?;
    mut next_identity: u64;
    mut transitioning: bool;
}

internal struct HostStorage
{
    key: u64;
    mut cleanup_key: u64;
    mut control_key: u64;
    mut released: bool;
    mut cleanup_released: bool;
    mut control_released: bool;
    mut attachments: std.memory.RawBuffer<Attachment>;
    mut active: usize;
}

// The owner retains every created key until release succeeds. An incomplete key
// set remains closed to attachment admission and retained for shutdown retry.
trusted internal predicate prepared_host_storage(owner: &(HostStorage?));

// Resident storage owns the key and every initialized attachment epoch. TLS contains
// an opaque ordinal, never an address from which storage authority is reconstructed.
internal static HOST_OWNER: Uninit<HostOwner> = core.memory.uninit_from<HostOwner>(
    {
        storage = none,
        products = none,
        next_identity = 1,
        transitioning = false
    }
);

trusted internal func initialize_host() -> u32
{
    let begin_host_formation_locked = trusted lambda(pos lease: &HostLease, pos anchor: &mut HostAnchor) -> Result<
        bool,
        u32
    >
        requires(
            lease.active,
            trusted host_access_idle(owner = lease),
            trusted host_access_live(owner = &lease.acquisition),
            trusted host_anchor_matches(anchor = &anchor, lease = lease)
        )
        ensures(trusted host_access_live(owner = &lease.acquisition), trusted host_access_idle(owner = lease))
        executes(total)
    {
        let host: &mut HostOwner = trusted host_value(lease, anchor);

        if host.transitioning
        {
            return Error(bray.runtime.bootstrap.STATUS_RUNTIME_FAILURE);
        }

        if let ?storage = host.storage
        {
            if storage.released || storage.cleanup_released || storage.control_released || storage.key ==
                std.numeric.U64_MAX || storage.cleanup_key == std.numeric.U64_MAX || storage.control_key ==
                std.numeric.U64_MAX
            {
                return Error(bray.runtime.bootstrap.STATUS_RUNTIME_FAILURE);
            }

            return Ok(false);
        }

        host.transitioning = true;
        return Ok(true);
    };

    let prepare_host_storage = trusted lambda() -> HostStorage?
        ensures(trusted prepared_host_storage(owner = &result))
        uses(foreign_call, raw_memory, unchecked_init)
    {
        let backing: std.memory.RawBuffer<Attachment>? = trusted internal bray.runtime.bootstrap.heap.try_buffer<
            Attachment
        >(1);

        let buffer: std.memory.RawBuffer<Attachment> = match consume backing
        {
            case ?buffer { yield buffer; }
            case none { return none; }
        };

        let mut key: u64 = 0;

        let status: std.platform.PlatformStatus = trusted internal std.thread.platform_thread_storage_create(
            trusted internal bray.runtime.bootstrap.thread.destruction.attachment_destructor_address(),
            std.memory.address_of_mut<u64>(&mut key),
        );

        if status.category != 0
        {
            return none;
        }

        // Keep each successfully created key owned even if a later step fails.
        // Shutdown can retry its release before this partial host admits attachments.
        let mut storage: HostStorage =
        {
            key = key,
            cleanup_key = 0,
            control_key = 0,
            released = false,
            cleanup_released = true,
            control_released = true,
            attachments = buffer,
            active = 0
        };

        if key == std.numeric.U64_MAX
        {
            return storage;
        }

        let mut cleanup_key: u64 = 0;

        let cleanup_status = trusted internal std.thread.platform_thread_storage_create(
            trusted internal bray.runtime.bootstrap.thread.destruction.attachment_destructor_address(),
            std.memory.address_of_mut<u64>(&mut cleanup_key)
        );

        if cleanup_status.category == 0
        {
            storage.cleanup_key = cleanup_key;
            storage.cleanup_released = false;
        }

        if storage.cleanup_released || cleanup_key == std.numeric.U64_MAX
        {
            return storage;
        }

        let mut control_key: u64 = 0;

        let control_status = trusted internal std.thread.platform_thread_storage_create(
            trusted internal bray.runtime.bootstrap.thread.destruction.control_destructor_address(),
            std.memory.address_of_mut<u64>(&mut control_key)
        );

        if control_status.category == 0
        {
            storage.control_key = control_key;
            storage.control_released = false;
        }

        return storage;
    };

    let empty_host_storage = trusted lambda() -> HostStorage?
        ensures(trusted prepared_host_storage(owner = &result))
        executes(pure, total)
    {
        return none;
    };

    let complete_host_formation = trusted lambda(pos mut prepared: HostStorage?) -> u32
        requires(trusted prepared_host_storage(owner = &prepared))
    {
        let finish_host_formation_locked = trusted lambda(
            pos lease: &HostLease,
            pos anchor: &mut HostAnchor,
            pos prepared: &mut(HostStorage?)
        ) -> u32
            requires(
                trusted prepared_host_storage(owner = &prepared),
                lease.active,
                trusted host_access_idle(owner = lease),
                trusted host_access_live(owner = &lease.acquisition),
                trusted host_anchor_matches(anchor = &anchor, lease = lease)
            )
            ensures(trusted host_access_live(owner = &lease.acquisition), trusted host_access_idle(owner = lease))
            executes(total)
            uses(raw_memory, unchecked_alias)
        {
            let synchronization = trusted std.memory.borrow_from<Synchronization, Uninit<Synchronization>>(
                lease.synchronization,
                trusted lease_synchronization_pointer(lease)
            );

            let host: &mut HostOwner = trusted host_value(lease, anchor);

            host.transitioning = false;

            if let ?storage = prepared
            {
                let key: u64 = storage.key;
                let cleanup_key: u64 = storage.cleanup_key;
                let control_key: u64 = storage.control_key;

                let usable = !storage.released && !storage.cleanup_released && !storage.control_released && key !=
                    std.numeric.U64_MAX && cleanup_key != std.numeric.U64_MAX && control_key != std.numeric.U64_MAX;

                trusted internal std.memory.swap_values<(HostStorage?)>(&mut host.storage, prepared);

                if !usable
                {
                    return bray.runtime.bootstrap.STATUS_RUNTIME_FAILURE;
                }

                core.atomic.store<u64, 2>(&synchronization.key, key + 1);
                core.atomic.store<u64, 2>(&synchronization.cleanup_key, cleanup_key + 1);
                core.atomic.store<u64, 2>(&synchronization.control_key, control_key + 1);
                return bray.runtime.bootstrap.STATUS_SUCCESS;
            }

            return bray.runtime.bootstrap.STATUS_RUNTIME_FAILURE;
        };

        let lease: HostLease = trusted access_prepared_host(&prepared);
        let mut anchor: HostAnchor = trusted host_anchor(&lease);

        return trusted finish_host_formation_locked(&lease, &mut anchor, &mut prepared);
    };

    if trusted initialized()
    {
        return bray.runtime.bootstrap.STATUS_SUCCESS;
    }

    let started: Result<bool, u32> =
    {
        let lease: HostLease = trusted host_access();
        let mut anchor: HostAnchor = trusted host_anchor(&lease);

        if !lease.active
        {
            return bray.runtime.bootstrap.STATUS_RUNTIME_FAILURE;
        }

        yield trusted begin_host_formation_locked(&lease, &mut anchor);
    };

    let forming: bool = match consume started
    {
        case Ok(forming) { yield forming; }
        case Error(status) { return status; }
    };

    if !forming
    {
        return bray.runtime.bootstrap.STATUS_SUCCESS;
    }

    // Preparation has no cancellation point. Keep a caught report alive until the
    // transition is reset, so even report destruction runs outside formation.
    let preparation: Result<u32, PanicReport> = catch
    {
        let prepared = trusted prepare_host_storage();

        yield trusted complete_host_formation(prepared);
    };

    return match consume preparation
    {
        case Ok(status) { yield status; }
        case Error(incident)
        {
            let empty = trusted empty_host_storage();

            yield trusted complete_host_formation(empty);
        }
    };
}

@abi(c)
trusted internal func current_native_thread_identity() -> u64
{
    let lease: HostLease = trusted host_access();
    let anchor: HostAnchor = trusted host_anchor(&lease);

    if !lease.active
    {
        return 0;
    }

    return trusted current_attachment_locked(&lease);
}

trusted internal func current_attachment_locked(pos lease: &HostLease) -> u64
    requires(
        lease.active,
        trusted host_access_idle(owner = lease),
        trusted host_access_live(owner = &lease.acquisition)
    )
    ensures(trusted host_access_live(owner = &lease.acquisition), trusted host_access_idle(owner = lease))
    executes(total)
    uses(raw_memory, unchecked_alias)
{
    let synchronization = trusted std.memory.borrow_from<Synchronization, Uninit<Synchronization>>(
        lease.synchronization,
        trusted lease_synchronization_pointer(lease)
    );

    let observed: u64 = core.atomic.load<u64, 1>(&synchronization.key);

    if observed == 0
    {
        return 0;
    }

    let attached = trusted load_attachment_identity(observed - 1);

    if attached != 0
    {
        return attached;
    }

    let cleanup = core.atomic.load<u64, 1>(&synchronization.cleanup_key);

    return if cleanup == 0
    {
        yield 0;
    }
    else
    {
        yield trusted load_attachment_identity(cleanup - 1);
    };
}

trusted internal func load_attachment_identity(pos key: u64) -> u64
    executes(total)
    uses(intrinsic, raw_memory, unchecked_init)
{
    let mut value: DataPointer<u8> = std.memory.null<u8>();

    let status: std.platform.PlatformStatus = trusted internal std.thread.platform_thread_storage_load(
        key,
        std.memory.address_of_mut<DataPointer<u8>>(&mut value),
    );

    if status.category != 0
    {
        return 0;
    }

    return trusted core.target.expose_address<u8>(value) as u64;
}

@abi(c)
trusted internal func main_native_thread_identity() -> u64
    uses(raw_memory, unchecked_alias)
{
    let synchronization = trusted std.memory.borrow_from<Synchronization, Uninit<Synchronization>>(
        &SYNCHRONIZATION,
        trusted synchronization_pointer()
    );

    return core.atomic.load<u64, 1>(&synchronization.main);
}

trusted internal func find_attachment(
    pos host: &mut HostStorage,
    pos identity: u64,
    pos native_thread: u64
) -> (&mut Attachment)?
    executes(total)
    uses(raw_memory)
{
    let entries: &mut [Attachment] = trusted std.memory.initialized_slice_mut<Attachment>(&mut host.attachments);

    let mut index: usize = 0;
    let count: usize = entries.length();

    while index < count
    {
        if entries[index].identity != 0 && (entries[index].identity == identity || (native_thread != 0 && entries[
            index
        ].native_thread == native_thread))
        {
            let mut result: (&mut Attachment)? = none;

            result = &mut entries[index];
            return result;
        }

        index += 1;
    }

    return none;
}

trusted internal func insert_attachment(
    pos host: &mut HostStorage,
    pos identity: u64,
    pos native_thread: u64,
    pos prepared: &mut(std.memory.RawBuffer<Attachment>?)
) -> Result<bool, usize>
    executes(total)
    uses(raw_memory, unchecked_init)
{
    {
        let existing = trusted find_attachment(host, 0, native_thread);

        if existing matches ?_
        {
            return Ok(false);
        }
    }

    {
        let entries: &mut [Attachment] = trusted std.memory.initialized_slice_mut<Attachment>(&mut host.attachments);
        let mut index: usize = 0;
        let count: usize = entries.length();

        while index < count
        {
            if entries[index].identity == 0
            {
                entries[index].identity = identity;
                entries[index].native_thread = native_thread;
                entries[index].depth = 1;
                entries[index].closing = false;
                return Ok(true);
            }

            index += 1;
        }
    }

    let buffer: &mut std.memory.RawBuffer<Attachment> = &mut host.attachments;

    match consume trusted internal bray.runtime.bootstrap.heap.grow<Attachment>(buffer, prepared)
    {
        case Ok(ready)
        {
            if !ready
            {
                return Ok(false);
            }
        }
        case Error(capacity) { return Error(capacity); }
    }

    if !(buffer.initialized < buffer.capacity)
    {
        return Ok(false);
    }

    trusted internal std.memory.raw_buffer_push<Attachment>(
        buffer,
        Attachment
        {
            identity = identity,
            native_thread = native_thread,
            depth = 1,
            closing = false,
            context_bridge = none,
            report_observer = none,
            domains = none,
            cleanup = none
        }
    );

    return Ok(true);
}

trusted internal func shutdown_host() -> u32
{
    let retire_storage = trusted lambda() -> (u32, HostStorage?, Result<std.platform.PlatformStatus, PanicReport>)
        ensures(trusted prepared_host_storage(owner = &result.1))
        uses(foreign_call)
    {
        let succeeded: Result<std.platform.PlatformStatus, PanicReport> = Ok(internal std.platform.success_status());

        let empty_host_storage = trusted lambda() -> HostStorage?
            ensures(trusted prepared_host_storage(owner = &result))
            executes(pure, total)
        {
            return none;
        };

        let begin_host_shutdown_locked = trusted lambda(
            pos lease: &HostLease,
            pos anchor: &mut HostAnchor,
            pos retired: &mut(HostStorage?)
        ) -> u32
            requires(
                trusted prepared_host_storage(owner = &retired),
                lease.active,
                trusted host_access_idle(owner = lease),
                trusted host_access_live(owner = &lease.acquisition),
                trusted host_anchor_matches(anchor = &anchor, lease = lease)
            )
            ensures(
                trusted prepared_host_storage(owner = &retired),
                trusted host_access_live(owner = &lease.acquisition),
                trusted host_access_idle(owner = lease),
            )
            executes(total)
            uses(raw_memory, unchecked_alias)
        {
            let synchronization = trusted std.memory.borrow_from<Synchronization, Uninit<Synchronization>>(
                lease.synchronization,
                trusted lease_synchronization_pointer(lease)
            );

            let host: &mut HostOwner = trusted host_value(lease, anchor);

            if host.transitioning || retired matches ?_
            {
                return bray.runtime.bootstrap.STATUS_RUNTIME_FAILURE;
            }

            if let ?products = host.products
            {
                let rows = trusted std.memory.initialized_slice<bray.runtime.bootstrap.host.product.Product>(&products);
                let mut index: usize = 0;
                let count: usize = rows.length();

                while index < count
                {
                    if rows[index].callers != 0 || !(rows[index].state.phase matches Closed | Failed)
                    {
                        return bray.runtime.bootstrap.STATUS_RUNTIME_FAILURE;
                    }

                    index += 1;
                }
            }

            if let ?storage = host.storage
            {
                if storage.active != 0
                {
                    return bray.runtime.bootstrap.STATUS_RUNTIME_FAILURE;
                }

                // Unattached control lookups borrow the key without taking this lock.
                // Unpublish before observing readers; retirement never waits for them.
                let control_key = core.atomic.exchange<u64, 4>(&synchronization.control_key, 0);

                if core.atomic.load<u64, 4>(&synchronization.control_readers) != 0
                {
                    core.atomic.store<u64, 2>(&synchronization.control_key, control_key);

                    return bray.runtime.bootstrap.STATUS_RUNTIME_FAILURE;
                }

                host.transitioning = true;
                core.atomic.store<u64, 2>(&synchronization.key, 0);
                core.atomic.store<u64, 2>(&synchronization.cleanup_key, 0);
                trusted internal std.memory.swap_values<(HostStorage?)>(&mut host.storage, retired);
            }

            return bray.runtime.bootstrap.STATUS_SUCCESS;
        };

        let (selected, mut retired) =
        {
            let lease: HostLease = trusted host_access();
            let mut anchor: HostAnchor = trusted host_anchor(&lease);
            let mut empty = trusted empty_host_storage();

            if !lease.active
            {
                return (bray.runtime.bootstrap.STATUS_RUNTIME_FAILURE, empty, succeeded);
            }

            let selected = trusted begin_host_shutdown_locked(&lease, &mut anchor, &mut empty);

            yield (selected, empty);
        };

        if selected != bray.runtime.bootstrap.STATUS_SUCCESS
        {
            return (selected, retired, succeeded);
        }

        let destroyed: Result<std.platform.PlatformStatus, PanicReport> = catch
        {
            if let ?storage = retired
            {
                if !storage.control_released
                {
                    let status = trusted internal std.thread.platform_thread_storage_destroy(storage.control_key);

                    storage.control_released = status.category == 0;
                }

                if !storage.cleanup_released
                {
                    let status = trusted internal std.thread.platform_thread_storage_destroy(storage.cleanup_key);

                    storage.cleanup_released = status.category == 0;
                }

                if !storage.released
                {
                    let status = trusted internal std.thread.platform_thread_storage_destroy(storage.key);

                    storage.released = status.category == 0;
                }
            }

            yield internal std.platform.success_status();
        };

        return (selected, retired, destroyed);
    };

    let finish_host_shutdown_locked = trusted lambda(
        pos lease: &HostLease,
        pos anchor: &mut HostAnchor,
        pos retired: &mut(HostStorage?),
        pos products: &mut(std.memory.RawBuffer<bray.runtime.bootstrap.host.product.Product>?)
    ) -> u32
        requires(
            trusted prepared_host_storage(owner = &retired),
            lease.active,
            trusted host_access_idle(owner = lease),
            trusted host_access_live(owner = &lease.acquisition),
            trusted host_anchor_matches(anchor = &anchor, lease = lease)
        )
        ensures(
            trusted host_access_live(owner = &lease.acquisition),
            trusted host_access_idle(owner = lease),
            trusted bray.runtime.bootstrap.host.product.native_host(),
            trusted bray.runtime.bootstrap.pool.protocol_access(),
        )
        executes(total)
        uses(raw_memory, unchecked_alias)
    {
        let synchronization = trusted std.memory.borrow_from<Synchronization, Uninit<Synchronization>>(
            lease.synchronization,
            trusted lease_synchronization_pointer(lease)
        );

        let host: &mut HostOwner = trusted host_value(lease, anchor);

        if let ?storage = retired
        {
            if !storage.released || !storage.cleanup_released || !storage.control_released
            {
                let key = storage.key;
                let cleanup_key = storage.cleanup_key;
                let control_key = storage.control_key;

                let usable = !storage.released && !storage.cleanup_released && !storage.control_released && key !=
                    std.numeric.U64_MAX && cleanup_key != std.numeric.U64_MAX && control_key != std.numeric.U64_MAX;

                trusted internal std.memory.swap_values<(HostStorage?)>(&mut host.storage, retired);

                if usable
                {
                    core.atomic.store<u64, 2>(&synchronization.key, key + 1);
                    core.atomic.store<u64, 2>(&synchronization.cleanup_key, cleanup_key + 1);
                    core.atomic.store<u64, 2>(&synchronization.control_key, control_key + 1);
                }

                host.transitioning = false;
                return bray.runtime.bootstrap.STATUS_RUNTIME_FAILURE;
            }
        }

        trusted internal std.memory.swap_values<(std.memory.RawBuffer<bray.runtime.bootstrap.host.product.Product>?)>(
            &mut host.products,
            products
        );

        host.transitioning = false;
        return bray.runtime.bootstrap.STATUS_SUCCESS;
    };

    let (selected, mut retired, destroyed) = trusted retire_storage();

    if selected != bray.runtime.bootstrap.STATUS_SUCCESS
    {
        return selected;
    }

    if retired matches none
    {
        return bray.runtime.bootstrap.STATUS_SUCCESS;
    }

    let mut products: std.memory.RawBuffer<bray.runtime.bootstrap.host.product.Product>? = none;

    let status =
    {
        let lease: HostLease = trusted access_prepared_host(&retired);
        let mut anchor: HostAnchor = trusted host_anchor(&lease);

        yield trusted finish_host_shutdown_locked(&lease, &mut anchor, &mut retired, &mut products);
    };

    // The caught report remains owned until the transition has been resolved.
    return status;
}
