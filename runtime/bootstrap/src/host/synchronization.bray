@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.host;

using internal bray.runtime.bootstrap.domain;
using core.atomic;
using core.memory;
using std.memory;

internal struct Synchronization
{
    lock: core.atomic.Atomic<u64>;
    key: core.atomic.Atomic<u64>;
    cleanup_key: core.atomic.Atomic<u64>;
    control_key: core.atomic.Atomic<u64>;
    execution_key: core.atomic.Atomic<u64>;
    control_readers: core.atomic.Atomic<u64>;
    control_used: core.atomic.Atomic<u64>;
    main: core.atomic.Atomic<u64>;
}

// Protected storage prevents safe field projection from exposing the host lock.
internal static SYNCHRONIZATION: Uninit<Synchronization> = core.memory.uninit_from<Synchronization>(
    {
        lock = core.atomic.initialize<u64>(0),
        key = core.atomic.initialize<u64>(0),
        cleanup_key = core.atomic.initialize<u64>(0),
        control_key = core.atomic.initialize<u64>(0),
        execution_key = core.atomic.initialize<u64>(0),
        control_readers = core.atomic.initialize<u64>(0),
        control_used = core.atomic.initialize<u64>(0),
        main = core.atomic.initialize<u64>(0)
    }
);

trusted internal func synchronization_pointer() -> DataPointer<Synchronization>
    ensures(
        trusted core.memory.valid_read<Synchronization>(pointer = result, count = 1),
        trusted core.memory.aligned_for<Synchronization>(pointer = result),
        trusted core.memory.initialized_as<Synchronization>(pointer = result),
        trusted core.memory.shared_alias_valid<Synchronization>(pointer = result),
        trusted core.memory.epoch_current<Synchronization>(pointer = result),
        trusted core.memory.synchronized_access<Synchronization>(pointer = result),
        trusted core.memory.movement_stable<Synchronization>(pointer = result),
        trusted core.memory.finalization_pending<Synchronization>(pointer = result)
    )
    executes(total)
{
    return std.memory.uninit_pointer<Synchronization>(trusted bray.runtime.bootstrap.domain.synchronization_storage());
}

trusted internal func initialized() -> bool
    uses(raw_memory, unchecked_alias)
{
    let synchronization = trusted std.memory.borrow_from<Synchronization, Uninit<Synchronization>>(
        trusted bray.runtime.bootstrap.domain.synchronization_storage(),
        trusted synchronization_pointer()
    );

    return core.atomic.load<u64, 1>(&synchronization.key) != 0;
}

trusted internal func lease_synchronization(pos lease: &HostLease) -> &Synchronization
    requires(trusted host_access_live(owner = &lease.acquisition))
    ensures(trusted host_access_live(owner = &lease.acquisition))
    executes(pure, total)
    uses(raw_memory, unchecked_alias)
{
    let pointer = std.memory.uninit_pointer<Synchronization>(lease.synchronization);

    let authorize = trusted lambda(pos lease: &HostLease, pos pointer: DataPointer<Synchronization>)
        requires(trusted host_access_live(owner = &lease.acquisition))
        ensures(
            trusted core.memory.valid_read<Synchronization>(pointer = pointer, count = 1),
            trusted core.memory.aligned_for<Synchronization>(pointer = pointer),
            trusted core.memory.initialized_as<Synchronization>(pointer = pointer),
            trusted core.memory.shared_alias_valid<Synchronization>(pointer = pointer),
            trusted core.memory.epoch_current<Synchronization>(pointer = pointer),
            trusted core.memory.synchronized_access<Synchronization>(pointer = pointer),
            trusted core.memory.movement_stable<Synchronization>(pointer = pointer),
            trusted core.memory.finalization_pending<Synchronization>(pointer = pointer)
        )
        executes(pure, total) {};

    trusted authorize(lease, pointer);
    return trusted std.memory.borrow_from<Synchronization, Uninit<Synchronization>>(lease.synchronization, pointer);
}
