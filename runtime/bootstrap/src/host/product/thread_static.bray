@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.host.product;

using core.memory;
using std.memory;
using internal bray.runtime.bootstrap.host;

@abi(c)
trusted internal func thread_static_order(
    pos key: usize,
    pos identity: DataPointer<Identity>,
    pos execution: u32,
    pos output: DataPointer<u64>
) -> u32
    requires(trusted native_host())
    uses(raw_memory, unchecked_init)
{
    let source = trusted lambda(pos pointer: DataPointer<Identity>) -> DataPointer<Identity>
        requires(trusted native_host())
        ensures(
            trusted core.memory.valid_read<Identity>(pointer = result, count = 1),
            trusted core.memory.initialized_as<Identity>(pointer = result),
            trusted core.memory.aligned_for<Identity>(pointer = result)
        )
        executes(pure, total)
    {
        return pointer;
    };

    let destination = trusted lambda(pos pointer: DataPointer<u64>) -> DataPointer<u64>
        requires(trusted native_host())
        ensures(
            trusted core.memory.valid_write<u64>(pointer = result, count = 1),
            trusted core.memory.aligned_for<u64>(pointer = result)
        )
        executes(pure, total)
    {
        return pointer;
    };

    let selected = trusted std.memory.read<Identity>(trusted source(identity));
    let lease = trusted bray.runtime.bootstrap.host.host_access();

    if !lease.active
    {
        return 4;
    }

    let mut anchor = trusted bray.runtime.bootstrap.host.host_anchor(&lease);
    let host = trusted bray.runtime.bootstrap.host.host_value(&lease, &mut anchor);

    if let ?products = host.products
    {
        if let ?product = trusted find_product(&mut products, key)
        {
            if let ?statics = product.statics
            {
                let entries = trusted std.memory.initialized_slice_mut<StaticOwner>(&mut statics);
                let count: usize = entries.length();
                let mut index: usize = 0;

                while index < count
                {
                    if let ExactThread(static_identity, order, mode) = entries[index]
                    {
                        let mut byte: usize = 0;

                        while byte < 32 && static_identity.bytes[byte] == selected.bytes[byte]
                        {
                            byte += 1;
                        }

                        if byte == 32
                        {
                            if mode != execution
                            {
                                return 3;
                            }

                            trusted std.memory.write<u64>(trusted destination(output), order);

                            return 0;
                        }
                    }

                    index += 1;
                }
            }
        }
    }

    return 3;
}
