@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.host.product;

using core.target;
using core.memory;
using core.atomic;
using std.numeric;
using std.memory;
using internal bray.runtime.bootstrap.host;
using internal bray.runtime.bootstrap.heap;

internal struct Product
{
    mut key: usize;
    identity: Identity;
    mut descriptor: Descriptor?;
    mut state: State;
    mut callers: usize;
    mut failure: u32?;
    mut statics: std.memory.RawBuffer<StaticOwner>?;
    mut execution: Execution?;
    mut provider: LoadedProvider?;
}

internal union ProductReservation
{
    Existing;
    Reserved;
    Grow(pos capacity: usize);
    Failed(pos status: u32);
}

trusted internal func find_product(pos products: &mut std.memory.RawBuffer<Product>, pos key: usize) -> (&mut Product)?
    executes(pure, total)
    uses(raw_memory)
{
    let rows = trusted std.memory.initialized_slice_mut<Product>(products);
    let count: usize = rows.length();
    let mut index: usize = 0;

    while index < count
    {
        if rows[index].key == key
        {
            return &mut rows[index];
        }

        index += 1;
    }

    return none;
}

trusted internal func reserve_product_locked(
    pos lease: &bray.runtime.bootstrap.host.HostLease,
    pos anchor: &mut bray.runtime.bootstrap.host.HostAnchor,
    pos key: usize,
    pos descriptor: Descriptor,
    pos prepared: &mut(std.memory.RawBuffer<Product>?),
    pos provider: &mut(LoadedProvider?)
) -> ProductReservation
    requires(
        trusted native_host(),
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        lease.active,
        trusted bray.runtime.bootstrap.host.host_access_idle(owner = lease),
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition),
        trusted bray.runtime.bootstrap.host.host_anchor_matches(anchor = &anchor, lease = lease)
    )
    ensures(
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition),
        trusted bray.runtime.bootstrap.host.host_access_idle(owner = lease),
    )
    uses(raw_memory, unchecked_init, intrinsic)
{
    let host = trusted bray.runtime.bootstrap.host.host_value(lease, anchor);

    // Initialization released its lease before preparing this reservation.
    // Common-host shutdown may have closed admission in the meantime.
    let host_ready = if let ?storage = host.storage
    {
        yield storage.usable();
    }
    else
    {
        yield false;
    };

    if host.transitioning || !host_ready
    {
        return ProductReservation.Failed(5);
    }

    if let ?products = host.products
    {
        if let ?product = trusted find_product(&mut products, key)
        {
            return if trusted matches_provider(&product, &provider)
            {
                yield ProductReservation.Existing;
            }
            else
            {
                yield ProductReservation.Failed(3);
            };
        }
    }

    if provider matches ?_ && core.atomic.load<usize, 1>(trusted activation_value(&descriptor)) != 0
    {
        // A compiler-owned activation slot can belong to only one live row.
        return ProductReservation.Failed(3);
    }

    let reusable: usize? = if let ?products = host.products
    {
        yield trusted vacant_product(&mut products);
    }
    else
    {
        yield none;
    };

    if let ?index = reusable
    {
        if provider matches ?_ && host.next_identity == std.numeric.U64_MAX
        {
            return ProductReservation.Failed(6);
        }

        let status = trusted bind_dependencies(host, provider);

        if status != 0
        {
            return ProductReservation.Failed(status);
        }

        let epoch = host.next_identity;

        if provider matches ?_
        {
            host.next_identity += 1;
        }

        let mut replacement = trusted fresh_product(key, descriptor, provider, epoch);

        if let ?products = host.products
        {
            let rows = trusted std.memory.initialized_slice_mut<Product>(&mut products);

            trusted internal std.memory.swap_values<Product>(&mut rows[index], &mut replacement);
            trusted publish_activation(&rows[index]);

            return ProductReservation.Reserved;
        }

        trusted core.target.abort();
    }

    match consume trusted bray.runtime.bootstrap.heap.reserve<Product>(&mut host.products, prepared)
    {
        case Ok(ready)
        {
            if !ready
            {
                return ProductReservation.Existing;
            }
        }
        case Error(capacity) { return ProductReservation.Grow(capacity); }
    }

    if provider matches ?_ && host.next_identity == std.numeric.U64_MAX
    {
        return ProductReservation.Failed(6);
    }

    let status = trusted bind_dependencies(host, provider);

    if status != 0
    {
        return ProductReservation.Failed(status);
    }

    let epoch = host.next_identity;

    if provider matches ?_
    {
        host.next_identity += 1;
    }

    let products: &mut std.memory.RawBuffer<Product> = if let ?products = host.products
    {
        yield &mut products;
    }
    else
    {
        yield trusted core.target.abort();
    };

    let value = trusted fresh_product(key, descriptor, provider, epoch);

    trusted internal std.memory.raw_buffer_push<Product>(products, value);

    let rows = trusted std.memory.initialized_slice_mut<Product>(products);

    trusted publish_activation(&rows[rows.length() - 1]);

    return ProductReservation.Reserved;
}

trusted internal func fresh_product(
    pos key: usize,
    pos descriptor: Descriptor,
    pos provider: &mut(LoadedProvider?),
    pos epoch: u64
) -> Product
    requires(trusted native_host(), trusted bray.runtime.bootstrap.pool.protocol_access())
{
    if let ?loaded = provider
    {
        trusted stamp_provider(&mut loaded, epoch);
    }

    return
    {
        key = key,
        identity = descriptor.identity,
        descriptor = descriptor,
        state =
        {
            phase = Phase.Forming,
            active_entries = 0,
            external_roots = 0,
            attachments = 0,
            workers = 0,
            initialized = 0,
            cleaned = 0,
            incidents = 0,
            last_incident =
            {
                bytes = [0; 32]
            }
        },
        callers = 0,
        failure = none,
        statics = none,
        execution = none,
        provider = trusted std.memory.take_nullable<LoadedProvider>(provider)
    };
}

trusted internal func vacant_product(pos products: &mut std.memory.RawBuffer<Product>) -> usize?
    executes(pure, total)
    uses(raw_memory)
{
    let rows = trusted std.memory.initialized_slice_mut<Product>(products);
    let mut index: usize = 0;

    while index < rows.length()
    {
        if rows[index].key == 0
        {
            return index;
        }

        index += 1;
    }

    return none;
}
