@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.host.product;

using core.target;
using std.memory;
using internal bray.runtime.bootstrap.host;

internal func unavailable(pos status: u32) -> Observation
    executes(pure, total)
{
    return
    {
        status = status,
        state = 4,
        active_entries = 0,
        external_roots = 0,
        thread_attachments = 0,
        initialized_statics = 0,
        cleaned_statics = 0,
        cleanup_incidents = 0,
        last_incident =
        {
            bytes = [0; 32]
        }
    };
}

trusted internal func transition_locked(
    pos lease: &bray.runtime.bootstrap.host.HostLease,
    pos anchor: &mut bray.runtime.bootstrap.host.HostAnchor,
    pos key: usize,
    pos operation: u32
) -> Observation
    requires(
        lease.active,
        trusted bray.runtime.bootstrap.host.host_access_idle(owner = lease),
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition),
        trusted bray.runtime.bootstrap.host.host_anchor_matches(anchor = &anchor, lease = lease)
    )
    ensures(
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition),
        trusted bray.runtime.bootstrap.host.host_access_idle(owner = lease),
    )
    executes(total)
{
    let host = trusted bray.runtime.bootstrap.host.host_value(lease, anchor);

    if let ?products = host.products
    {
        if let ?product = trusted find_product(&mut products, key)
        {
            if operation == 12 && product.state.phase matches Open && product.execution matches none
            {
                return product.state.observation(3);
            }

            let status = product.state.transition(operation);

            if let ?failure = product.failure
            {
                return product.state.observation(failure);
            }

            return product.state.observation(status);
        }
    }

    return unavailable(3);
}

trusted internal func transition(pos key: usize, pos operation: u32) -> Observation
    requires(trusted native_host())
{
    let lease = trusted bray.runtime.bootstrap.host.host_access();

    if !lease.active
    {
        return unavailable(5);
    }

    let mut anchor = trusted bray.runtime.bootstrap.host.host_anchor(&lease);

    return trusted transition_locked(&lease, &mut anchor, key, operation);
}

trusted internal func caller_locked(
    pos lease: &bray.runtime.bootstrap.host.HostLease,
    pos anchor: &mut bray.runtime.bootstrap.host.HostAnchor,
    pos key: usize,
    pos acquire: bool
) -> u32
    requires(
        lease.active,
        trusted bray.runtime.bootstrap.host.host_access_idle(owner = lease),
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition),
        trusted bray.runtime.bootstrap.host.host_anchor_matches(anchor = &anchor, lease = lease)
    )
    ensures(
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition),
        trusted bray.runtime.bootstrap.host.host_access_idle(owner = lease),
    )
    uses(intrinsic)
{
    let host = trusted bray.runtime.bootstrap.host.host_value(lease, anchor);

    if let ?products = host.products
    {
        if let ?product = trusted find_product(&mut products, key)
        {
            if acquire
            {
                let maximum: usize = ~0;

                if product.callers == maximum || product.state.phase matches Forming | Failed
                {
                    return 5;
                }

                product.callers += 1;
            }
            else
            {
                if product.callers == 0
                {
                    trusted core.target.abort();
                }

                product.callers -= 1;
            }

            return 0;
        }
    }

    trusted core.target.abort();
}

trusted internal func acquire_caller(pos key: usize) -> Result<ShutdownOwner, u32>
    requires(trusted native_host(), trusted bray.runtime.bootstrap.pool.protocol_access())
{
    let mut owner: ShutdownOwner =
    {
        key = 0,
        pending = false
    };

    let lease = trusted bray.runtime.bootstrap.host.host_access();

    if !lease.active
    {
        return Error(5);
    }

    let mut anchor = trusted bray.runtime.bootstrap.host.host_anchor(&lease);

    let status = trusted caller_locked(&lease, &mut anchor, key, true);

    if status != 0
    {
        return Error(status);
    }

    owner.key = key;
    owner.pending = true;

    return Ok(owner);
}

trusted internal func release_caller(pos key: usize)
    requires(trusted native_host())
    uses(intrinsic)
{
    let lease = trusted bray.runtime.bootstrap.host.host_access();

    if !lease.active
    {
        trusted core.target.abort();
    }

    let mut anchor = trusted bray.runtime.bootstrap.host.host_anchor(&lease);

    _ = trusted caller_locked(&lease, &mut anchor, key, false);
}
