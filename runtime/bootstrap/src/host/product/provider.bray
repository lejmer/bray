@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.host.product;

using core.atomic;
using core.memory;
using core.target;
using std.memory;
using std.numeric;
using internal bray.runtime.bootstrap.domain;
using internal bray.runtime.bootstrap.provider;
using internal bray.runtime.bootstrap.pool;

// Each constructor admits this owner's cleanup while its reference is empty.
// Formation installs the owning native reference only after that admission.
internal struct ProviderDependency
{
    mut handle: ProviderHandle;
    mut root: bray.runtime.bootstrap.provider.Reference;

    trusted destruct()
        requires(trusted native_host(), trusted bray.runtime.bootstrap.pool.protocol_access())
        uses(foreign_call)
    {
        if !core.memory.is_null<bray.runtime.bootstrap.provider.Callbacks>(self.root.callbacks)
        {
            let permit = trusted lambda(pos owner: &ProviderDependency)
                requires(trusted native_host())
                ensures(trusted bray.runtime.bootstrap.provider.native_reference(reference = &owner.root))
                executes(pure, total) {};

            trusted permit(&self);

            let operations = trusted bray.runtime.bootstrap.provider.callbacks(&self.root);

            trusted operations.release(self.root.context);
        }
    }
}

internal struct LoadedProvider
{
    services: u32;
    mut native: bray.runtime.bootstrap.provider.Reference;
    activation: DataPointer<core.atomic.Atomic<usize>>;
    mut residency: std.memory.RawBuffer<Residency>;
    mut dependencies: std.memory.RawBuffer<ProviderDependency>?;
    mut observing: bool;
    mut observed: u64?;

    trusted destruct()
        requires(trusted native_host(), trusted bray.runtime.bootstrap.pool.protocol_access())
        uses(foreign_call)
    {
        if !core.memory.is_null<bray.runtime.bootstrap.provider.Callbacks>(self.native.callbacks)
        {
            let permit = trusted lambda(pos owner: &LoadedProvider)
                requires(trusted native_host())
                ensures(trusted bray.runtime.bootstrap.provider.native_reference(reference = &owner.native))
                executes(pure, total) {};

            trusted permit(&self);

            let operations = trusted bray.runtime.bootstrap.provider.callbacks(&self.native);

            trusted operations.release(self.native.context);
        }
    }
}

trusted internal func take_dependency_root(
    pos owner: &mut ProviderDependency
) -> bray.runtime.bootstrap.provider.Reference
    requires(trusted native_host(), trusted bray.runtime.bootstrap.pool.protocol_access())
    ensures(
        trusted native_host(),
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted bray.runtime.bootstrap.provider.native_owned_reference(reference = &result)
    )
{
    return trusted std.memory.replace_value<bray.runtime.bootstrap.provider.Reference>(
        &mut owner.root,
        trusted bray.runtime.bootstrap.provider.resident_reference()
    );
}

trusted internal func take_native_provider(pos owner: &mut LoadedProvider) -> bray.runtime.bootstrap.provider.Reference
    requires(trusted native_host(), trusted bray.runtime.bootstrap.pool.protocol_access())
    ensures(
        trusted native_host(),
        trusted bray.runtime.bootstrap.pool.protocol_access(),
        trusted bray.runtime.bootstrap.provider.native_owned_reference(reference = &result)
    )
{
    return trusted std.memory.replace_value<bray.runtime.bootstrap.provider.Reference>(
        &mut owner.native,
        trusted bray.runtime.bootstrap.provider.resident_reference()
    );
}

trusted internal func provider_residency(pos provider: &LoadedProvider) -> &Residency
    requires(trusted native_host())
    executes(pure, total)
    uses(raw_memory, unchecked_alias)
{
    // Formation publishes exactly one initialized cell in this stable allocation.
    let pointer = trusted lambda(pos provider: &LoadedProvider) -> DataPointer<Residency>
        requires(trusted native_host())
        ensures(
            trusted core.memory.valid_read<Residency>(pointer = result, count = 1),
            trusted core.memory.aligned_for<Residency>(pointer = result),
            trusted core.memory.initialized_as<Residency>(pointer = result),
            trusted core.memory.shared_alias_valid<Residency>(pointer = result),
            trusted core.memory.epoch_current<Residency>(pointer = result),
            trusted core.memory.synchronized_access<Residency>(pointer = result),
            trusted core.memory.movement_stable<Residency>(pointer = result),
            trusted core.memory.finalization_pending<Residency>(pointer = result)
        )
        executes(pure, total)
    {
        return provider.residency.pointer;
    };

    return trusted std.memory.borrow_from<Residency, LoadedProvider>(provider, trusted pointer(provider));
}

trusted internal func provider_roots(pos provider: &LoadedProvider) -> usize
    requires(trusted native_host())
    executes(total)
{
    let residency = trusted provider_residency(provider);

    return core.atomic.load<usize, 1>(&residency.roots);
}

trusted internal func pin_provider(pos provider: &LoadedProvider) -> RootCallback
    requires(trusted native_host())
    ensures(trusted root_callback_live(owner = &result.acquisition))
    uses(intrinsic)
{
    let cell = trusted provider_residency(provider);
    let context = trusted core.target.expose_address<Residency>(std.memory.address_of<Residency>(cell));

    // This exact admitted owner retains the initialized cell until the newly
    // acquired callback capability is discharged. No external handle is decoded.
    let borrow = trusted lambda(pos provider: &LoadedProvider, pos context: usize) -> RootBorrow
        requires(trusted native_host())
        ensures(trusted root_borrow_live(owner = &result))
        executes(total)
    {
        return
        {
            context = context
        };
    };

    return trusted start_root_callback(trusted borrow(provider, context));
}

trusted internal func activation_value(pos descriptor: &Descriptor) -> &core.atomic.Atomic<usize>
    requires(trusted native_host(), !core.memory.is_null<core.atomic.Atomic<usize>>(descriptor.activation))
    executes(pure, total)
    uses(raw_memory, unchecked_alias)
{
    // Native entry retains the compiler-generated image descriptor and its exact
    // activation slot for this borrow. Metadata bits alone grant no such entry.
    let pointer = trusted lambda(pos descriptor: &Descriptor) -> DataPointer<core.atomic.Atomic<usize>>
        requires(trusted native_host())
        ensures(
            trusted core.memory.valid_read<core.atomic.Atomic<usize>>(pointer = result, count = 1),
            trusted core.memory.aligned_for<core.atomic.Atomic<usize>>(pointer = result),
            trusted core.memory.initialized_as<core.atomic.Atomic<usize>>(pointer = result),
            trusted core.memory.shared_alias_valid<core.atomic.Atomic<usize>>(pointer = result),
            trusted core.memory.epoch_current<core.atomic.Atomic<usize>>(pointer = result),
            trusted core.memory.synchronized_access<core.atomic.Atomic<usize>>(pointer = result),
            trusted core.memory.movement_stable<core.atomic.Atomic<usize>>(pointer = result),
            trusted core.memory.finalization_pending<core.atomic.Atomic<usize>>(pointer = result)
        )
        executes(pure, total)
    {
        return descriptor.activation;
    };

    return trusted std.memory.borrow_from<core.atomic.Atomic<usize>, Descriptor>(
        descriptor,
        trusted pointer(descriptor)
    );
}

trusted internal func stamp_provider(pos provider: &mut LoadedProvider, pos epoch: u64)
    requires(trusted native_host())
    uses(raw_memory, intrinsic)
{
    let rows = trusted std.memory.initialized_slice_mut<Residency>(&mut provider.residency);

    if rows.length() != 1 || rows[0].epoch != 0
    {
        trusted core.target.abort();
    }

    rows[0].epoch = epoch;
}

trusted internal func publish_activation(pos product: &Product)
    requires(trusted native_host())
    uses(intrinsic)
{
    if let ?provider = product.provider
    {
        let selected = match product.descriptor
        {
            case ?selected_descriptor { yield selected_descriptor; }
            case none { yield trusted core.target.abort(); }
        };

        let slot = trusted activation_value(&selected);
        let context = trusted core.target.expose_address<Residency>(provider.residency.pointer);

        core.atomic.store<usize, 2>(slot, context);
    }
}

// Native entry owns its exact typed output slot. This publishes only a complete
// wire value. it never disposes or overwrites an existing owning destination.
trusted internal func publish_provider<T>(pos output: DataPointer<T>, pos value: T)
    requires(trusted native_host())
    uses(raw_memory, unchecked_init)
{
    let writable = trusted lambda(pos pointer: DataPointer<T>) -> DataPointer<T>
        requires(trusted native_host())
        ensures(
            trusted core.memory.valid_write<T>(pointer = result, count = 1),
            trusted core.memory.aligned_for<T>(pointer = result)
        )
        executes(pure, total)
    {
        return pointer;
    };

    trusted std.memory.write<T>(trusted writable(output), value);
}

trusted internal func provider_view(pos owner: &LoadedProvider) -> bray.runtime.bootstrap.provider.Reference
    requires(trusted native_host())
    ensures(trusted bray.runtime.bootstrap.provider.native_reference(reference = &result))
    executes(pure, total)
{
    return
    {
        context = owner.native.context,
        callbacks = owner.native.callbacks
    };
}

trusted internal func same_provider(pos established: &LoadedProvider, pos incoming: &LoadedProvider) -> bool
    requires(trusted native_host())
    uses(raw_memory, intrinsic)
{
    if established.services != incoming.services || established.native.context != incoming.native.context ||
        (trusted core.target.expose_address<bray.runtime.bootstrap.provider.Callbacks>(established.native.callbacks)) !=
        (trusted core.target.expose_address<bray.runtime.bootstrap.provider.Callbacks>(incoming.native.callbacks))
    {
        return false;
    }

    if let ?left = established.dependencies
    {
        if let ?right = incoming.dependencies
        {
            let left_rows = trusted std.memory.initialized_slice<ProviderDependency>(&left);
            let right_rows = trusted std.memory.initialized_slice<ProviderDependency>(&right);

            if left_rows.length() != right_rows.length()
            {
                return false;
            }

            let mut index: usize = 0;

            while index < left_rows.length()
            {
                if left_rows[index].handle.key != right_rows[index].handle.key || left_rows[index].handle.epoch !=
                    right_rows[index].handle.epoch
                {
                    return false;
                }

                index += 1;
            }

            return true;
        }

        return false;
    }

    return incoming.dependencies matches none;
}

trusted internal func acquire_loaded_root(pos owner: &LoadedProvider) -> bray.runtime.bootstrap.provider.Reference
    requires(trusted native_host())
    ensures(trusted bray.runtime.bootstrap.provider.native_owned_reference(reference = &result))
    uses(intrinsic)
{
    let cell = trusted provider_residency(owner);
    let mut count = core.atomic.load<usize, 1>(&cell.roots);

    while true
    {
        if count >= std.numeric.USIZE_MAX - 1
        {
            trusted core.target.abort();
        }

        let (previous, acquired) = core.atomic.compare_exchange<usize, 3, 1>(
            &cell.roots,
            expected = count,
            desired = count + 1
        );

        if acquired
        {
            break;
        }

        count = previous;
    }

    trusted revise_residency(cell);

    return
    {
        context = trusted core.target.expose_address<Residency>(std.memory.address_of<Residency>(cell)),
        callbacks = trusted bray.runtime.bootstrap.domain.root_callbacks()
    };
}
