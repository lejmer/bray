@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.host.product;

using core.memory;
using std.memory;
using std.numeric;
using internal bray.runtime.bootstrap.host;
using internal bray.runtime.bootstrap.pool;

trusted internal func thread_callback_locked(
    pos lease: &bray.runtime.bootstrap.host.HostLease,
    pos anchor: &mut bray.runtime.bootstrap.host.HostAnchor,
    pos key: usize,
    pos operation: u32
) -> Result<ThreadControl, u32>
    requires(
        lease.active,
        trusted bray.runtime.bootstrap.host.host_access_idle(owner = lease),
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition),
        trusted bray.runtime.bootstrap.host.host_anchor_matches(anchor = &anchor, lease = lease)
    )
    ensures(
        trusted bray.runtime.bootstrap.host.host_access_live(owner = &lease.acquisition),
        trusted bray.runtime.bootstrap.host.host_access_idle(owner = lease),
    )
    uses(raw_memory, intrinsic)
{
    let host = trusted bray.runtime.bootstrap.host.host_value(lease, anchor);

    if let ?products = host.products
    {
        if let ?product = trusted find_product(&mut products, key)
        {
            if !(product.state.phase matches Open | Closing)
            {
                return Error(2);
            }

            if product.state.active_entries == std.numeric.USIZE_MAX
            {
                return Error(5);
            }

            if let ?execution = product.execution
            {
                let execution: NativeExecution = match execution.value
                {
                    case ?value { yield value; }
                    case none { yield trusted core.target.abort(); }
                };

                let callback: ThreadControl = if operation == 9
                {
                    yield trusted std.memory.read<ThreadControl>(
                        std.memory.address_of<ThreadControl>(&execution.attach)
                    );
                }
                else if operation == 10
                {
                    yield trusted std.memory.read<ThreadControl>(
                        std.memory.address_of<ThreadControl>(&execution.detach)
                    );
                }
                else
                {
                    yield trusted std.memory.read<ThreadControl>(
                        std.memory.address_of<ThreadControl>(&execution.finish_root)
                    );
                };

                // The call retains providers until its work returns outside this lock.
                product.state.active_entries += 1;

                return Ok(callback);
            }
        }
    }

    return Error(3);
}

trusted internal func invoke_thread_control(pos key: usize, pos operation: u32) -> Observation
    requires(trusted native_host(), trusted bray.runtime.bootstrap.pool.protocol_access())
    uses(foreign_call)
{
    let selected: Result<ThreadControl, u32> =
    {
        let lease = trusted bray.runtime.bootstrap.host.host_access();

        if !lease.active
        {
            return unavailable(5);
        }

        let mut anchor = trusted bray.runtime.bootstrap.host.host_anchor(&lease);

        yield trusted thread_callback_locked(&lease, &mut anchor, key, operation);
    };

    let callback: ThreadControl = match consume selected
    {
        case Ok(callback) { yield callback; }
        case Error(status)
        {
            if operation == 11 && status == 3
            {
                return trusted observe(key, 5);
            }

            let mut current = trusted transition(key, 0);

            current.status = status;

            return current;
        }
    };

    let reported = trusted callback(key);
    let mut current = trusted progress(key, trusted transition(key, 2));

    if reported.status == 3 || reported.status >= 5
    {
        current.status = reported.status;
    }

    return current;
}

trusted internal func observe(pos key: usize, pos operation: u32) -> Observation
    requires(trusted native_host(), trusted bray.runtime.bootstrap.pool.protocol_access())
{
    if operation > 13
    {
        return unavailable(3);
    }

    let formed = trusted form(key);

    if formed.state == 0 || formed.state == 4
    {
        return formed;
    }

    if operation == 9 || operation == 10 || operation == 11
    {
        return trusted invoke_thread_control(key, operation);
    }

    if operation == 5
    {
        return trusted request_close(key);
    }

    return trusted progress(key, trusted transition(key, operation));
}

@abi(c)
trusted internal func control(pos key: usize, pos operation: u32, pos output: DataPointer<Observation>) -> u32
    requires(trusted native_host())
    uses(raw_memory, unchecked_init)
{
    let destination = trusted lambda(pos pointer: DataPointer<Observation>) -> DataPointer<Observation>
        requires(trusted native_host())
        ensures(
            trusted core.memory.valid_write<Observation>(pointer = result, count = 1),
            trusted core.memory.aligned_for<Observation>(pointer = result),
            trusted bray.runtime.bootstrap.pool.protocol_access()
        )
        executes(pure, total)
    {
        return pointer;
    };

    let pointer = trusted destination(output);
    let observation = trusted observe(key, operation);

    trusted std.memory.write<Observation>(trusted destination(pointer), observation);

    return 0;
}
