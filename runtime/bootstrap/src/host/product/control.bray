@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.host.product;

using core.memory;
using std.memory;
using std.numeric;
using internal bray.runtime.bootstrap.host;
using internal bray.runtime.bootstrap.pool;

trusted internal func invoke_thread_control(pos key: usize, pos operation: u32) -> Observation
    requires(trusted native_host(), trusted bray.runtime.bootstrap.pool.protocol_access())
{
    let native = trusted lambda()
        requires(trusted native_host())
        ensures(
            trusted bray.runtime.bootstrap.host.attachment.native_acquisition(),
            trusted bray.runtime.bootstrap.thread.destruction.native_attachment_release()
        )
        executes(pure, total) {};

    trusted native();

    if operation == 9
    {
        if trusted bray.runtime.bootstrap.host.thread_attachment_enter() != 0
        {
            return unavailable(5);
        }

        if trusted enter_domain(key, 1) != 0
        {
            return trusted transition(key, 6);
        }

        _ = trusted bray.runtime.bootstrap.host.thread_attachment_leave();

        let mut current = trusted transition(key, 6);

        current.status = 3;
        return current;
    }

    let identity = trusted bray.runtime.bootstrap.host.current_native_thread_identity();

    if operation == 10 || operation == 11
    {
        let lease = trusted bray.runtime.bootstrap.host.host_access();

        if !lease.active
        {
            return unavailable(5);
        }

        let mut anchor = trusted bray.runtime.bootstrap.host.host_anchor(&lease);

        let invalid: bool =
        {
            let host = trusted bray.runtime.bootstrap.host.host_value(&lease, &mut anchor);

            yield if let ?domain = trusted domain_in_host(host, identity, key)
            {
                yield (operation == 11 && domain.depth != 0) || (operation == 10 && domain.depth == 0);
            }
            else
            {
                yield operation == 10;
            };
        };

        let mut fresh_anchor = trusted bray.runtime.bootstrap.host.host_anchor(&lease);

        if invalid
        {
            let mut current = trusted transition_locked(&lease, &mut fresh_anchor, key, 6);

            current.status = 3;
            return current;
        }
    }

    if operation == 11
    {
        _ = trusted transition(key, 5);
    }

    let current = trusted leave_domain(identity, key, operation == 10);

    if operation == 10 && current.status != 3 && current.status < 5
    {
        _ = trusted bray.runtime.bootstrap.host.thread_attachment_leave();
    }

    return if operation == 11
    {
        yield trusted progress(key, current);
    }
    else
    {
        yield current;
    };
}

trusted internal func observe(pos key: usize, pos operation: u32) -> Observation
    requires(trusted native_host(), trusted bray.runtime.bootstrap.pool.protocol_access())
{
    if operation > 14
    {
        return unavailable(3);
    }

    let formed = trusted form(key);

    if formed.state == 0 || formed.state == 4
    {
        return formed;
    }

    if operation == 9 || operation == 10 || operation == 11 || operation == 14
    {
        return trusted invoke_thread_control(key, operation);
    }

    if operation == 5
    {
        return trusted request_close(key);
    }

    return trusted progress(key, trusted transition(key, operation));
}

@abi(c)
trusted internal func control(pos key: usize, pos operation: u32, pos output: DataPointer<Observation>) -> u32
    requires(trusted native_host())
    uses(raw_memory, unchecked_init)
{
    let destination = trusted lambda(pos pointer: DataPointer<Observation>) -> DataPointer<Observation>
        requires(trusted native_host())
        ensures(
            trusted core.memory.valid_write<Observation>(pointer = result, count = 1),
            trusted core.memory.aligned_for<Observation>(pointer = result),
            trusted bray.runtime.bootstrap.pool.protocol_access()
        )
        executes(pure, total)
    {
        return pointer;
    };

    let pointer = trusted destination(output);
    let observation = trusted observe(key, operation);

    trusted std.memory.write<Observation>(trusted destination(pointer), observation);

    return 0;
}
