@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.host.product;

using core.memory;
using core.atomic;
using internal bray.runtime.bootstrap;
using internal bray.runtime.bootstrap.report.incident;
using internal bray.runtime.bootstrap.provider;
using internal bray.runtime.bootstrap.domain;

// The selected native host retains this activation's descriptor, callback providers
// and storage until terminal release. Callback failures return initialized outcomes.
trusted internal predicate native_host();

@copy
@layout(c)
internal struct Identity
{
    bytes: [u8; 32];
}

@copy
@layout(c)
internal struct Observation
{
    mut status: u32;
    state: u32;
    active_entries: usize;
    external_roots: usize;
    thread_attachments: usize;
    initialized_statics: usize;
    cleaned_statics: usize;
    cleanup_incidents: usize;
    last_incident: Identity;
}

@copy
@layout(c)
internal struct Finalizer
{
    execution: u32;
    admission: Admission;
    start: DataPointer<u8>;
    resolve: DataPointer<u8>;
}

internal callable Admission = @abi(c) trusted func(
    pos release: u32,
    pos outcome: DataPointer<bray.runtime.bootstrap.ReportOutcome>
)
    requires(trusted native_host())
    ensures(trusted bray.runtime.bootstrap.report.incident.returned(pointer = outcome));

internal callable Transition = @abi(c) trusted func()
    requires(trusted native_host());

internal callable Destroy = @abi(c) trusted func(
    pos abandoned: u32,
    pos outcome: DataPointer<bray.runtime.bootstrap.ReportOutcome>
)
    requires(trusted native_host())
    ensures(trusted bray.runtime.bootstrap.report.incident.returned(pointer = outcome));

internal callable Access = @abi(c) trusted func() -> usize
    requires(trusted native_host());

internal callable Dependency = @abi(c) trusted func(pos index: usize) -> Identity
    requires(trusted native_host());

@copy
@layout(c)
internal struct Static
{
    version: u32;
    duration: u32;
    identity: Identity;
    order: u64;
    storage: usize;
    access: Access;
    prepare: Transition;
    finalizer: Finalizer;
    destroy: Destroy;
    detach: Transition;
    dependency: Dependency;
    dependency_count: usize;
}

internal callable StaticEntry = @abi(c) trusted func(pos index: usize) -> Static
    requires(trusted native_host());

@copy
@layout(c)
internal struct ProviderHandle
{
    key: usize;
    epoch: u64;
}

@copy
@layout(c)
internal struct ProviderObservation
{
    observation: Observation;
    handle: ProviderHandle;
}

@layout(c)
internal struct ProviderRetirement
{
    mut observation: Observation;
    mut provider: bray.runtime.bootstrap.provider.Reference;
}

internal callable ProviderControl = @abi(c) trusted func(
    pos key: usize,
    pos epoch: u64,
    pos operation: u32,
    pos output: DataPointer<ProviderObservation>
) -> u32
    requires(trusted native_host());

internal callable ProviderRetire = @abi(c) trusted func(
    pos key: usize,
    pos epoch: u64,
    pos output: DataPointer<ProviderRetirement>
) -> u32
    requires(trusted native_host());

internal callable ProviderNotify = @abi(c) trusted func(
    pos key: usize,
    pos context: usize,
    pos callbacks: DataPointer<bray.runtime.bootstrap.provider.Callbacks>
) -> u32
    requires(trusted native_host());

@layout(c)
internal struct ProviderBinding
{
    version: u32;
    services: u32;
    domain: DataPointer<bray.runtime.bootstrap.domain.View>;
    provider: bray.runtime.bootstrap.provider.Reference;
    dependencies: DataPointer<ProviderHandle>;
    dependency_count: usize;
}

internal callable ProviderFormation = @abi(c) trusted func(
    pos key: usize,
    pos binding: DataPointer<ProviderBinding>,
    pos output: DataPointer<ProviderObservation>
) -> u32
    requires(trusted native_host());

internal callable ProviderRoot = @abi(c) trusted func(
    pos key: usize,
    pos output: DataPointer<bray.runtime.bootstrap.provider.Reference>
) -> u32
    requires(trusted native_host());

@copy
@layout(c)
internal struct ProviderOperations
{
    formation: ProviderFormation;
    root: ProviderRoot;
}

@copy
@layout(c)
internal struct Descriptor
{
    version: u32;
    asynchronous: u32;
    identity: Identity;
    static_entry: StaticEntry;
    static_count: usize;
    execution: DataPointer<u8>;
    activation: DataPointer<core.atomic.Atomic<usize>>;
    provider: DataPointer<ProviderOperations>;
}
