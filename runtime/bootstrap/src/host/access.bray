@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.host;

using core.target;
using core.atomic;
using core.memory;
using std.memory;
using internal bray.runtime.bootstrap;
using internal std.thread;

internal struct Acquisition
{
}

trusted internal predicate host_access_live(owner: &Acquisition);

trusted internal predicate host_access_idle(owner: &HostLease);

trusted internal predicate host_anchor_matches(anchor: &HostAnchor, lease: &HostLease);

trusted internal predicate resident_host_anchor(anchor: &HostAnchor);

// The live acquisition is a value contract. Copying the ordinary owner reference
// or active flag cannot grant shared mutation authority or release another guard.
internal struct HostAnchor
{
    owner: &Uninit<HostOwner>;
}

trusted internal func host_anchor(pos lease: &HostLease) -> HostAnchor
    requires(trusted host_access_live(owner = &lease.acquisition))
    ensures(
        trusted host_access_live(owner = &lease.acquisition),
        trusted resident_host_anchor(anchor = &result),
        trusted host_anchor_matches(anchor = &result, lease = lease),
    )
    executes(pure, total)
{
    return
    {
        owner = lease.owner
    };
}

trusted internal func host_value(pos lease: &HostLease, pos anchor: &mut HostAnchor) -> &mut HostOwner
    requires(
        lease.active,
        trusted host_access_idle(owner = lease),
        trusted host_access_live(owner = &lease.acquisition),
        trusted host_anchor_matches(anchor = &anchor, lease = lease),
    )
    ensures(
        trusted host_access_live(owner = &lease.acquisition),
        trusted host_access_idle(owner = lease),
        trusted attachment_cleanup_completed(owner = lease)
    )
    executes(total)
    uses(raw_memory, unchecked_alias)
{
    let pointer: DataPointer<HostOwner> = trusted host_access_pointer(lease);

    return trusted std.memory.borrow_mut_from<HostOwner, HostAnchor>(anchor, pointer);
}

// The acquisition lease names the actual host storage and lock. Payload mutation
// through the separate anchor cannot manufacture, copy, or mutate this lease.
internal struct HostLease
{
    acquisition: Acquisition;
    synchronization: &Uninit<Synchronization>;
    owner: &Uninit<HostOwner>;
    active: bool;
    mut retirement: AttachmentRetirement;

    trusted destruct()
        requires(
            trusted host_access_live(owner = &self.acquisition),
            !self.active || trusted attachment_cleanup_completed(owner = &self),
        )
        executes(total)
        when(!self.active)
        {
            executes(pure)
        }
        uses(raw_memory, unchecked_init, unchecked_alias)
    {
        if self.active
        {
            if self.retirement.pending
            {
                let retirement: &AttachmentRetirement = &self.retirement;

                let identity: u64 = retirement.identity;
                let native_thread: u64 = retirement.native_thread;
                let remaining_active: usize = retirement.remaining_active;
                let active_pointer: DataPointer<usize> = trusted completed_active_pointer(&self);
                let pointer: DataPointer<Attachment> = trusted completed_attachment_pointer(&self);

                let synchronization = trusted std.memory.borrow_from<Synchronization, Uninit<Synchronization>>(
                    self.synchronization,
                    trusted lease_synchronization_pointer(&self)
                );

                // Selection moved the callback out before cleanup. The closing row now contains
                // only scalars and None, so replacing it cannot discard a pending callback.
                trusted std.memory.write<Attachment>(
                    pointer,
                    Attachment
                    {
                        identity = 0,
                        native_thread = native_thread,
                        depth = 0,
                        closing = true,
                        context_bridge = none,
                        report_observer = none,
                        cleanup = none
                    }
                );

                trusted std.memory.write<usize>(active_pointer, remaining_active);

                let _: (u64, bool) = core.atomic.compare_exchange<u64, 3, 1>(
                    &synchronization.main,
                    expected = identity,
                    desired = 0
                );
            }

            let synchronization = trusted std.memory.borrow_from<Synchronization, Uninit<Synchronization>>(
                self.synchronization,
                trusted lease_synchronization_pointer(&self)
            );

            core.atomic.store<u64, 2>(&synchronization.lock, 0);
        }
    }
}

trusted internal func host_access() -> HostLease
    ensures(
        trusted host_access_live(owner = &result.acquisition),
        trusted host_access_idle(owner = &result),
        trusted attachment_cleanup_completed(owner = &result)
    )
    uses(intrinsic, raw_memory, unchecked_alias)
{
    let synchronization = trusted std.memory.borrow_from<Synchronization, Uninit<Synchronization>>(
        &SYNCHRONIZATION,
        trusted synchronization_pointer()
    );

    let native_thread: u64 = trusted std.thread.current_platform_identity();

    if native_thread == 0
    {
        return
        {
            acquisition = Acquisition
            {
            },
            synchronization = &SYNCHRONIZATION,
            owner = &HOST_OWNER,
            active = false,
            retirement =
            {
                pending = false,
                identity = 0,
                native_thread = 0,
                record = std.memory.null<Attachment>(),
                active = std.memory.null<usize>(),
                remaining_active = 0
            }
        };
    }

    while true
    {
        let (previous, acquired): (u64, bool) = core.atomic.compare_exchange<u64, 3, 1>(
            &synchronization.lock,
            expected = 0,
            desired = native_thread
        );

        if acquired
        {
            return
            {
                acquisition = Acquisition
                {
                },
                synchronization = &SYNCHRONIZATION,
                owner = &HOST_OWNER,
                active = true,
                retirement =
                {
                    pending = false,
                    identity = 0,
                    native_thread = 0,
                    record = std.memory.null<Attachment>(),
                    active = std.memory.null<usize>(),
                    remaining_active = 0
                }
            };
        }

        // Contending threads serialize. Same-thread formation must reject instead
        // of waiting for its own unfinished acquisition.
        if previous == native_thread
        {
            return
            {
                acquisition = Acquisition
                {
                },
                synchronization = &SYNCHRONIZATION,
                owner = &HOST_OWNER,
                active = false,
                retirement =
                {
                    pending = false,
                    identity = 0,
                    native_thread = 0,
                    record = std.memory.null<Attachment>(),
                    active = std.memory.null<usize>(),
                    remaining_active = 0
                }
            };
        }

        trusted core.target.spin_loop_hint();
    }
}

// Acquiring the lock neither exposes nor changes this separately owned storage.
// Preserve this owner's contract without carrying arbitrary caller witnesses.
trusted internal func access_prepared_host(pos storage: &(HostStorage?)) -> HostLease
    requires(trusted prepared_host_storage(owner = storage))
    ensures(
        result.active,
        trusted prepared_host_storage(owner = storage),
        trusted host_access_live(owner = &result.acquisition),
        trusted host_access_idle(owner = &result),
        trusted attachment_cleanup_completed(owner = &result)
    )
{
    while true
    {
        let lease: HostLease = trusted host_access();

        if lease.active
        {
            return lease;
        }
    }
}

trusted internal func host_access_pointer(pos guard: &HostLease) -> DataPointer<HostOwner>
    uses(intrinsic)
    executes(pure, total)
    requires(
        guard.active,
        trusted host_access_idle(owner = &guard),
        trusted host_access_live(owner = &guard.acquisition)
    )
    ensures(
        trusted host_access_live(owner = &guard.acquisition),
        trusted core.memory.valid_read<HostOwner>(pointer = result, count = 1),
        trusted core.memory.valid_write<HostOwner>(pointer = result, count = 1),
        trusted core.memory.aligned_for<HostOwner>(pointer = result),
        trusted core.memory.initialized_as<HostOwner>(pointer = result),
        trusted core.memory.exclusive_alias_valid<HostOwner>(pointer = result),
        trusted core.memory.epoch_current<HostOwner>(pointer = result),
        trusted core.memory.synchronized_access<HostOwner>(pointer = result),
        trusted core.memory.movement_stable<HostOwner>(pointer = result),
        trusted core.memory.finalization_pending<HostOwner>(pointer = result),
    )
{
    if !guard.active
    {
        trusted core.target.abort();
    }

    return std.memory.uninit_pointer<HostOwner>(guard.owner);
}
