@target(target.platform.native_threads)
trusted internal module bray.runtime.bootstrap.host;

using internal bray.runtime.bootstrap.domain;
using core.target;
using core.atomic;
using core.memory;
using std.memory;
using internal bray.runtime.bootstrap;
using internal std.thread;

@layout(c)
internal struct Acquisition
{
}

trusted internal predicate host_access_live(owner: &Acquisition);

trusted internal predicate host_anchor_matches(anchor: &Acquisition, lease: &Acquisition);

// This access capability has its own identity within the lease. Its relationship
// to the lock owner survives mutation of the separately borrowed host payload.
internal struct HostAnchor
{
    acquisition: Acquisition;
    owner: &Uninit<HostOwner>;
}

trusted internal func host_anchor(pos lease: &HostLease) -> HostAnchor
    requires(trusted host_access_live(owner = &lease.acquisition))
    ensures(
        trusted host_access_live(owner = &lease.acquisition),
        trusted host_anchor_matches(anchor = &result.acquisition, lease = &lease.acquisition),
    )
    executes(pure, total)
{
    return
    {
        acquisition = Acquisition {},
        owner = lease.owner
    };
}

trusted internal func host_value(pos lease: &HostLease, pos anchor: &mut HostAnchor) -> &mut HostOwner
    requires(
        lease.active,
        trusted host_access_live(owner = &lease.acquisition),
        trusted host_anchor_matches(anchor = &anchor.acquisition, lease = &lease.acquisition),
    )
    ensures(trusted host_access_live(owner = &lease.acquisition))
    executes(pure, total)
    uses(raw_memory, unchecked_alias)
{
    let pointer = std.memory.uninit_pointer<HostOwner>(lease.owner);

    let authorize = trusted lambda(pos lease: &HostLease, pos pointer: DataPointer<HostOwner>)
        requires(
            lease.active,
            trusted host_access_live(owner = &lease.acquisition)
        )
        ensures(
            trusted host_access_live(owner = &lease.acquisition),
            trusted core.memory.valid_read<HostOwner>(pointer = pointer, count = 1),
            trusted core.memory.valid_write<HostOwner>(pointer = pointer, count = 1),
            trusted core.memory.aligned_for<HostOwner>(pointer = pointer),
            trusted core.memory.initialized_as<HostOwner>(pointer = pointer),
            trusted core.memory.exclusive_alias_valid<HostOwner>(pointer = pointer),
            trusted core.memory.epoch_current<HostOwner>(pointer = pointer),
            trusted core.memory.synchronized_access<HostOwner>(pointer = pointer),
            trusted core.memory.movement_stable<HostOwner>(pointer = pointer),
            trusted core.memory.finalization_pending<HostOwner>(pointer = pointer),
        )
        executes(pure, total) {};

    trusted authorize(lease, pointer);

    return trusted std.memory.borrow_mut_from<HostOwner, HostAnchor>(anchor, pointer);
}

// The acquisition lease names the actual host storage and lock. Payload mutation
// through the separate anchor cannot manufacture, copy, or mutate this lease.
internal struct HostLease
{
    acquisition: Acquisition;
    synchronization: &Uninit<Synchronization>;
    owner: &Uninit<HostOwner>;
    active: bool;

    trusted destruct()
        requires(trusted host_access_live(owner = &self.acquisition))
        executes(total)
        when(!self.active)
        {
            executes(pure)
        }
    {
        if self.active
        {
            let synchronization = trusted bray.runtime.bootstrap.host.lease_synchronization(&self);

            core.atomic.store<u64, 2>(&synchronization.lock, 0);
        }
    }
}

trusted internal func host_access() -> HostLease
    ensures(trusted host_access_live(owner = &result.acquisition))
    uses(intrinsic, raw_memory, unchecked_alias)
{
    let synchronization = trusted std.memory.borrow_from<Synchronization, Uninit<Synchronization>>(
        trusted bray.runtime.bootstrap.domain.synchronization_storage(),
        trusted synchronization_pointer()
    );

    let native_thread: u64 = trusted std.thread.current_platform_identity();

    if native_thread == 0
    {
        return
        {
            acquisition = Acquisition
            {
            },
            synchronization = trusted bray.runtime.bootstrap.domain.synchronization_storage(),
            owner = trusted bray.runtime.bootstrap.domain.host_storage(),
            active = false
        };
    }

    while true
    {
        let (previous, acquired): (u64, bool) = core.atomic.compare_exchange<u64, 3, 1>(
            &synchronization.lock,
            expected = 0,
            desired = native_thread
        );

        if acquired
        {
            return
            {
                acquisition = Acquisition
                {
                },
                synchronization = trusted bray.runtime.bootstrap.domain.synchronization_storage(),
                owner = trusted bray.runtime.bootstrap.domain.host_storage(),
                active = true
            };
        }

        // Contending threads serialize. Same-thread formation must reject instead
        // of waiting for its own unfinished acquisition.
        if previous == native_thread
        {
            return
            {
                acquisition = Acquisition
                {
                },
                synchronization = trusted bray.runtime.bootstrap.domain.synchronization_storage(),
                owner = trusted bray.runtime.bootstrap.domain.host_storage(),
                active = false
            };
        }

        trusted core.target.spin_loop_hint();
    }
}

// Acquiring the lock neither exposes nor changes this separately owned storage.
// Preserve this owner's contract without carrying arbitrary caller witnesses.
trusted internal func access_prepared_host(pos storage: &(HostStorage?)) -> HostLease
    requires(trusted prepared_host_storage(owner = storage))
    ensures(
        result.active,
        trusted prepared_host_storage(owner = storage),
        trusted host_access_live(owner = &result.acquisition),
        )
{
    while true
    {
        let lease: HostLease = trusted host_access();

        if lease.active
        {
            return lease;
        }
    }
}
